// teko_prefix.tk -- `.`/`[` bind tighter than a core-native prefix (delivery 5,
// crumb "os prefixos veem os pos-fixos"): `!b[1]`, `-a.x`, `~g[2]` mean
// `!(b[1])`, `-(a.x)`, `~(g[2])`, matching C#.
//
// `+` already gets this for free (M45's `tk_unary_plus`, teko_ops.tk): it is
// not in the mc core's own prefix table, so it reaches `parse_primary` through
// `syntax_expr` and reads its operand with `parse_expr(11)`, which loops
// through `.`/`[` (precedence 12) before returning. `-`, `!` and `~` cannot
// take that route -- they ARE in the core's own table (`ops_init`, mc
// src/parse.mc), so `parse_unary()` finds them there first and reads their
// operand with a bare `parse_unary()` recursion that never reaches
// `parse_primary` at all. Registering `syntax_expr("-", ...)` for one of them
// is unreachable code: measured with a handler forced to answer a distinct
// value, it never fired for a plain `-x`.
//
// So `.`/`[`'s own handlers sink through the chain instead: a receiver shaped
// `N_UNARY(op, x)` with `op` one of `- ! ~` is not the member's/index's own
// target, `x` is, and the same chain is rebuilt around the result once the
// real receiver answers.
i64 tk_unary_op_ok(i64 op) {
    if (op == K_SUB) return 1;
    if (op == K_BANG) return 1;
    if (op == K_TILDE) return 1;
    return 0;
}

// the innermost operand of a chain of `- ! ~`, or `n` itself when it carries
// none: `- -a` and `!!a` both answer `a`, one ply at a time.
i64 tk_unary_base(i64 n) {
    if (nd_kind(n) != N_UNARY) return n;
    if (!tk_unary_op_ok(nd_op(n))) return n;
    return tk_unary_base(nd_a(n));
}

// rebuilds the chain `n` carried, now around `inner` instead of the base it
// used to wrap: same ops, same order, fresh nodes.
i64 tk_unary_rewrap(i64 n, i64 inner) {
    if (nd_kind(n) != N_UNARY) return inner;
    if (!tk_unary_op_ok(nd_op(n))) return inner;
    i64 below = tk_unary_rewrap(nd_a(n), inner);
    i64 u = node_new(N_UNARY, nd_line(n), nd_file(n));
    set_nd_op(u, nd_op(n));
    set_nd_a(u, below);
    return u;
}

// set while a recursive `tk_bracket` call (teko_params.tk) is resolving the
// base of a `- ! ~` chain: the base is never itself the WRITE target the
// source named -- `-arr[i]` is a value, never an lvalue, in C# as much as
// here -- so every write form `[`'s own handlers read (`=`, `+=`/`-=`,
// `++`/`--`) stays off for it, exactly as it already is for any other
// non-bare-identifier receiver.
i64 tk_bracket_no_write = 0;

// D80: the sink above is WRONG when the `- ! ~` chain stood inside a SOURCE
// `(...)` group: `(-t).Duration().Hours` is `(-t)` first, THEN `.Duration()`
// -- C#'s own reading, the postfix binding to the parenthesized group's own
// result -- not `-(t.Duration().Hours)`, what the unconditional sink used to
// answer. Parens are invisible to the AST: mc's core returns `(expr)` as
// `expr` itself, no `N_PAREN`, no flag (src/parse.mc) -- so the one surviving
// signal is lexical, read as raw bytes.
//
// How far back the probe reads before it gives up and falls back to the
// ordinary sink: generous headroom, not a real limit -- no fixture or
// library file needs a parenthesized unary receiver anywhere near this wide.
#define TK_UNARY_PAREN_MAX 4096

// 1 when the postfix token now at `p_start()` -- the position of whatever
// `cur` is when a `syntax_infix` handler runs, since mc's own `parse_expr`
// (M21, src/parse.mc) already consumed the operator before calling the
// handler, so there is no token left to ask "was this parenthesized" -- was
// immediately preceded, source bytes read backward with whitespace skipped,
// by a `)` whose MATCHING `(` (parens counted, comments and string literals
// NOT recognized as such -- ceiling 1 below) is itself immediately followed
// by one of `- ! ~`, possibly through more redundant `(`s
// (`((-t)).Duration()` peels both): the chain sunk through `tk_unary_base`
// stood inside that group, so the postfix binds to the GROUP's own result
// and the caller must not sink. `oplen` is the postfix token's own width (1
// for `.` and `[`, 2 for `?.`), walked back first so the scan starts on
// whatever came before the operator itself.
//
// Ceiling 1: a `(` or `)` inside a string literal or a comment, between the
// group and the operator, is counted as a real paren -- a byte scan, no
// lexical awareness. Nothing in this repository's fixtures or library files
// puts one there.
// Ceiling 2: the backward scan gives up -- answers 0, the ordinary sink --
// after TK_UNARY_PAREN_MAX bytes without closing a paren at depth 0.
i64 tk_unary_ws(i64 c) {
    return c == ' ' || c == 9 || c == 10 || c == 13;   // space, tab, LF, CR
}

i64 tk_unary_parened(i64 oplen) {
    uptr lo = p_start() - TK_UNARY_PAREN_MAX;
    uptr p = p_start();
    i64 skipped = 0;
    loop {                                    // past the operator itself
        if (p <= lo) return 0;
        p = p - 1;
        i64 c = ld8(p);
        if (tk_unary_ws(c)) continue;
        skipped = skipped + 1;
        if (skipped == oplen) break;
    }
    loop {                                    // past the space before it
        if (p <= lo) return 0;
        p = p - 1;
        if (!tk_unary_ws(ld8(p))) break;
    }
    if (ld8(p) != ')') return 0;
    i64 depth = 1;
    uptr open = 0;
    loop {                                     // to the OUTERMOST matching `(`
        if (p <= lo) return 0;
        p = p - 1;
        i64 c = ld8(p);
        if (c == ')') depth = depth + 1;
        else if (c == '(') {
            depth = depth - 1;
            if (depth == 0) { open = p; break; }
        }
    }
    // peel every redundant `(` right after `open`: `left` is already known
    // (by the caller) to be a pure `- ! ~` chain, and mc's own `(expr)`
    // unwraps invisibly (src/parse.mc), so a leading `(` found here can only
    // be one more such layer -- the grammar leaves no other way for the text
    // between `open` and the matched `)` to still parse as one.
    uptr r = open + 1;
    loop {
        loop {
            if (r >= p_src_end()) return 0;
            if (!tk_unary_ws(ld8(r))) break;
            r = r + 1;
        }
        i64 c = ld8(r);
        if (c == '-' || c == '!' || c == '~') return 1;
        if (c != '(') return 0;
        r = r + 1;
    }
}
