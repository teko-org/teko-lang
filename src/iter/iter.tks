/** Lazy iteration protocol: `next` yields the next element, or `null` at exhaustion. */
exp type Iterator<T> = interface { fn next(): T | null }

/** Monomorphic i64 iterator: a closure yielding the next value or `null` at exhaustion. */
exp type IntIter = func<i64 | null>

/** Monomorphic byte iterator. */
exp type ByteIter = func<byte | null>

/** Monomorphic str iterator. */
exp type StrIter = func<str | null>

/** i64 iterator yielding `(index, value)` pairs, as produced by `enumerate`. */
exp type IntIndexedIter = func<IntIndexed | null>

/** i64 iterator yielding element pairs, as produced by `zip`. */
exp type IntPairIter = func<IntPair | null>

/** An (index, value) pair, the element type `enumerate` yields. */
exp type IntIndexed = struct { index: i64; value: i64 }

/** A pair of i64 elements, the element type `zip` yields. */
exp type IntPair = struct { first: i64; second: i64 }
