/** Left fold: applies `step(acc, element)` over `src`, starting from `init`. */
exp fn fold(src: IntIter, init: i64, step: func<i64, i64, i64>): i64 {
    var acc = init
    loop {
        var nx = src()
        match nx {
            i64 as v => acc = step(acc, v)
            null => break
        }
    }
    acc
}

/** Fold without a seed, using the first element as the initial accumulator; `null` if empty. */
exp fn reduce(src: IntIter, step: func<i64, i64, i64>): i64 | null {
    var head = src()
    var acc = match head {
        i64 as v => v
        null => return null
    }
    loop {
        var nx = src()
        match nx {
            i64 as v => acc = step(acc, v)
            null => break
        }
    }
    acc
}

/** Counts the elements `src` yields, draining it completely. */
exp fn count(src: IntIter): i64 {
    var n: i64 = 0
    loop {
        var nx = src()
        match nx {
            i64 => n = n + 1
            null => break
        }
    }
    n
}

/** Sums the elements `src` yields, draining it completely (0 if empty). */
exp fn sum(src: IntIter): i64 {
    var total: i64 = 0
    loop {
        var nx = src()
        match nx {
            i64 as v => total = total + v
            null => break
        }
    }
    total
}

/** True as soon as any element of `src` satisfies `pred`; false if none do. */
exp fn any(src: IntIter, pred: func<i64, bool>): bool {
    loop {
        var nx = src()
        match nx {
            i64 as v => { if pred(v) { return true } }
            null => break
        }
    }
    false
}

/** True iff every element of `src` satisfies `pred` (vacuously true if empty). */
exp fn all(src: IntIter, pred: func<i64, bool>): bool {
    loop {
        var nx = src()
        match nx {
            i64 as v => { if pred(v) == false { return false } }
            null => break
        }
    }
    true
}

/** Returns the first element of `src` satisfying `pred`, or `null` if none does. */
exp fn find(src: IntIter, pred: func<i64, bool>): i64 | null {
    loop {
        var nx = src()
        match nx {
            i64 as v => { if pred(v) { return v } }
            null => break
        }
    }
    null
}

/** Materializes `src` into an `[]i64`, preserving order. Drains the source. */
exp fn collect(src: IntIter): []i64 {
    var out: []i64 = []
    loop {
        var nx = src()
        match nx {
            i64 as v => out = [..out, v]
            null => break
        }
    }
    out
}
