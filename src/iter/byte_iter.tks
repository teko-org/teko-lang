pub type ByteCursor = struct { pos: u64 }

/** Iterates a byte slice front-to-back. */
exp fn over_bytes(bytes: []byte, ref cur: ByteCursor): ByteIter {
    var it: ByteIter = () => {
        if cur.pos >= bytes.len { return null }
        var v = bytes[cur.pos]
        cur.value = ByteCursor { pos = cur.pos + 1 }
        v
    }
    it
}

/** Lazily maps each byte of `src` through `f`. */
exp fn map_bytes(src: ByteIter, f: func<byte, byte>): ByteIter {
    var mapped: ByteIter = () => {
        var nx = src()
        match nx {
            byte as v => f(v)
            null => null
        }
    }
    mapped
}

/** Lazily keeps only the bytes of `src` for which `keep` holds. */
exp fn filter_bytes(src: ByteIter, keep: func<byte, bool>): ByteIter {
    var filtered: ByteIter = () => {
        var result: byte | null = null
        loop {
            var nx = src()
            match nx {
                byte as v => {
                    if keep(v) { result = v; break }
                }
                null => break
            }
        }
        result
    }
    filtered
}

pub type TakeByteCursor = struct { left: i64 }

/** Yields at most `cur.left` bytes from `src`, then reports exhaustion. */
exp fn take_bytes(src: ByteIter, ref cur: TakeByteCursor): ByteIter {
    var taken: ByteIter = () => {
        if cur.left <= 0 { return null }
        var nx = src()
        match nx {
            byte as v => { cur.value = TakeByteCursor { left = cur.left - 1 }; v }
            null => null
        }
    }
    taken
}

/** Materializes `src` into a `[]byte`, preserving order. Drains the source. */
exp fn collect_bytes(src: ByteIter): []byte {
    var out: []byte = []
    loop {
        var nx = src()
        match nx {
            byte as v => out = [..out, v]
            null => break
        }
    }
    out
}

/** Counts the bytes `src` yields, draining it completely. */
exp fn count_bytes(src: ByteIter): i64 {
    var n: i64 = 0
    loop {
        var nx = src()
        match nx {
            byte => n = n + 1
            null => break
        }
    }
    n
}
