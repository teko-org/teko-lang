pub type ArrayCursor = struct { pos: u64 }

/** Iterates an i64 slice front-to-back. */
exp fn over_array(xs: []i64, ref cur: ArrayCursor): IntIter {
    var it: IntIter = () => {
        if cur.pos >= xs.len { return null }
        var v = xs[cur.pos]
        cur.value = ArrayCursor { pos = cur.pos + 1 }
        v
    }
    it
}

pub type RangeCursor = struct { next: i64; hi: i64 }

/** Iterates the half-open integer range `[cur.next, cur.hi)`. */
exp fn range(ref cur: RangeCursor): IntIter {
    var it: IntIter = () => {
        if cur.next >= cur.hi { return null }
        var v = cur.next
        cur.value = RangeCursor { next = v + 1; hi = cur.hi }
        v
    }
    it
}

/** Single-element iterator: yields `v` once, then `null` forever. */
exp fn once(v: i64, ref cur: OnceCursor): IntIter {
    var it: IntIter = () => {
        if cur.emitted { return null }
        cur.value = OnceCursor { emitted = true }
        v
    }
    it
}

pub type OnceCursor = struct { emitted: bool }

/** The empty iterator: yields `null` immediately and forever. */
exp fn empty(): IntIter {
    var it: IntIter = () => null
    it
}

/** Lazily maps each element of `src` through `f`. */
exp fn map(src: IntIter, f: func<i64, i64>): IntIter {
    var mapped: IntIter = () => {
        var nx = src()
        match nx {
            i64 as v => f(v)
            null => null
        }
    }
    mapped
}

/** Lazily keeps only the elements of `src` for which `keep` holds. */
exp fn filter(src: IntIter, keep: func<i64, bool>): IntIter {
    var filtered: IntIter = () => {
        var result: i64 | null = null
        loop {
            var nx = src()
            match nx {
                i64 as v => {
                    if keep(v) { result = v; break }
                }
                null => break
            }
        }
        result
    }
    filtered
}

pub type TakeCursor = struct { left: i64 }

/** Yields at most `cur.left` elements from `src`, then reports exhaustion. */
exp fn take(src: IntIter, ref cur: TakeCursor): IntIter {
    var taken: IntIter = () => {
        if cur.left <= 0 { return null }
        var nx = src()
        match nx {
            i64 as v => { cur.value = TakeCursor { left = cur.left - 1 }; v }
            null => null
        }
    }
    taken
}

pub type SkipCursor = struct { left: i64 }

/** Discards the first `cur.left` elements of `src`, then yields the rest unchanged. */
exp fn skip(src: IntIter, ref cur: SkipCursor): IntIter {
    var skipped: IntIter = () => {
        loop {
            if cur.left <= 0 { break }
            var dropped = src()
            match dropped {
                i64 => cur.value = SkipCursor { left = cur.left - 1 }
                null => { cur.value = SkipCursor { left = 0 }; return null }
            }
        }
        src()
    }
    skipped
}

pub type EnumCursor = struct { index: i64 }

/** Pairs each element of `src` with its 0-based index. */
exp fn enumerate(src: IntIter, ref cur: EnumCursor): IntIndexedIter {
    var en: IntIndexedIter = () => {
        var nx = src()
        match nx {
            i64 as v => {
                var out = IntIndexed { index = cur.index; value = v }
                cur.value = EnumCursor { index = cur.index + 1 }
                out
            }
            null => null
        }
    }
    en
}

/** Pairs elements from `a` and `b`, stopping at the shorter of the two. */
exp fn zip(a: IntIter, b: IntIter): IntPairIter {
    var z: IntPairIter = () => {
        var na = a()
        match na {
            i64 as x => {
                var nb = b()
                match nb {
                    i64 as y => IntPair { first = x; second = y }
                    null => null
                }
            }
            null => null
        }
    }
    z
}

pub type ChainCursor = struct { first_done: bool }

/** Concatenates `a` and `b`: yields every element of `a`, then every element of `b`. */
exp fn chain(a: IntIter, b: IntIter, ref cur: ChainCursor): IntIter {
    var ch: IntIter = () => {
        if cur.first_done == false {
            var na = a()
            match na {
                i64 as x => return x
                null => cur.value = ChainCursor { first_done = true }
            }
        }
        b()
    }
    ch
}
