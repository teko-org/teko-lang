pub type StrCursor = struct { pos: u64 }

/** Iterates a `[]str` front-to-back. */
exp fn over_strs(xs: []str, ref cur: StrCursor): StrIter {
    var it: StrIter = () => {
        if cur.pos >= xs.len { return null }
        var v = xs[cur.pos]
        cur.value = StrCursor { pos = cur.pos + 1 }
        v
    }
    it
}

/** Splits text into lines on `\n`; a trailing non-newline segment is still a line. */
exp fn split_lines(text: str): []str {
    var bytes = text.bytes()
    var lines: []str = []
    var cur: []byte = []
    var i: u64 = 0
    loop {
        if i >= bytes.len { break }
        var b = bytes[i]
        if b == b'\n' {
            lines = [..lines, decode_line(cur)]
            cur = []
        } else {
            cur = [..cur, b]
        }
        i++
    }
    if cur.len > 0 {
        lines = [..lines, decode_line(cur)]
    }
    lines
}

fn decode_line(bytes: []byte): str {
    match str_from_utf8(bytes) {
        str as s => s
        error => ""
    }
}

/** Lazily maps each string of `src` through `f`. */
exp fn map_strs(src: StrIter, f: func<str, str>): StrIter {
    var mapped: StrIter = () => {
        var nx = src()
        match nx {
            str as v => f(v)
            null => null
        }
    }
    mapped
}

/** Lazily keeps only the strings of `src` for which `keep` holds. */
exp fn filter_strs(src: StrIter, keep: func<str, bool>): StrIter {
    var filtered: StrIter = () => {
        var result: str | null = null
        loop {
            var nx = src()
            match nx {
                str as v => {
                    if keep(v) { result = v; break }
                }
                null => break
            }
        }
        result
    }
    filtered
}

/** Materializes `src` into a `[]str`, preserving order. Drains the source. */
exp fn collect_strs(src: StrIter): []str {
    var out: []str = []
    loop {
        var nx = src()
        match nx {
            str as v => out = [..out, v]
            null => break
        }
    }
    out
}
