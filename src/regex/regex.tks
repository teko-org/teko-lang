pub type RChar = struct { cp: u32 }
pub type RAny = struct { }
pub type RRange = struct { lo: u32; hi: u32 }
pub type RClass = struct { negate: bool; ranges: []RRange }
pub type RConcat = struct { parts: []@RegexNode() }
pub type RAlt = struct { branches: []@RegexNode() }
pub type RStar = struct { inner: []@RegexNode() }
pub type RPlus = struct { inner: []@RegexNode() }
pub type ROpt = struct { inner: []@RegexNode() }
pub type RGroup = struct { inner: []@RegexNode() }
pub type RStart = struct { }
pub type REnd = struct { }
pub type REmpty = struct { }

macro RegexNode() { lowering { RChar | RAny | RClass | RConcat | RAlt | RStar | RPlus | ROpt | RGroup | RStart | REnd | REmpty } }

/** Regex — a compiled pattern: the source text plus its parsed AST. */
exp type Regex = struct { pattern: str; ast: @RegexNode() }

fn one(node: @RegexNode()): []@RegexNode() { [node] }
fn one_of(wrapped: []@RegexNode()): @RegexNode() { wrapped[0] }

pub type CPScan = struct {
    cp: u32
    width: u64
}

fn utf8_width(b0: byte): u64 {
    if b0 <= 0x7F { return 1 }
    if b0 <= 0xDF { return 2 }
    if b0 <= 0xEF { return 3 }
    4
}

fn decode_codepoint(p: []byte, pos: u64): CPScan {
    var width = utf8_width(p[pos])
    if width == 1 { return CPScan { cp = p[pos] to u32; width = width } }
    if width == 2 {
        var b0 = p[pos] to u32
        var b1 = p[pos + 1] to u32
        return CPScan { cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F); width = width }
    }
    if width == 3 {
        var b0 = p[pos] to u32
        var b1 = p[pos + 1] to u32
        var b2 = p[pos + 2] to u32
        return CPScan { cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F); width = width }
    }
    var b0 = p[pos] to u32
    var b1 = p[pos + 1] to u32
    var b2 = p[pos + 2] to u32
    var b3 = p[pos + 3] to u32
    CPScan { cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F); width = width }
}

fn codepoints_of(input: str): []u32 {
    var bytes = input.bytes()
    var out: []u32 = []
    var pos: u64 = 0
    loop {
        if pos >= bytes.len { break }
        var scan = decode_codepoint(bytes, pos)
        out = [..out, scan.cp]
        pos = pos + scan.width
    }
    out
}

pub type PState = struct { pos: u64; node: @RegexNode() }

fn parse_alt(p: []byte, pos: u64): PState | error {
    var first = match parse_concat(p, pos) { PState as s => s; error as e => return e }
    var branches: []@RegexNode() = [first.node]
    var at = first.pos
    loop {
        if at >= p.len || p[at] != b'|' { break }
        var next = match parse_concat(p, at + 1) { PState as s => s; error as e => return e }
        branches = [..branches, next.node]
        at = next.pos
    }
    if branches.len == 1 { return PState { pos = at; node = first.node } }
    PState { pos = at; node = RAlt { branches = branches } }
}

fn parse_concat(p: []byte, pos: u64): PState | error {
    var parts: []@RegexNode() = []
    var at = pos
    loop {
        if at >= p.len || p[at] == b'|' || p[at] == b')' { break }
        var step = match parse_repeat(p, at) { PState as s => s; error as e => return e }
        parts = [..parts, step.node]
        at = step.pos
    }
    if parts.len == 0 { return PState { pos = at; node = REmpty { } } }
    if parts.len == 1 { return PState { pos = at; node = parts[0] } }
    PState { pos = at; node = RConcat { parts = parts } }
}

fn parse_repeat(p: []byte, pos: u64): PState | error {
    var atom = match parse_atom(p, pos) { PState as s => s; error as e => return e }
    if atom.pos < p.len && p[atom.pos] == b'*' {
        return PState { pos = atom.pos + 1; node = RStar { inner = one(atom.node) } }
    }
    if atom.pos < p.len && p[atom.pos] == b'+' {
        return PState { pos = atom.pos + 1; node = RPlus { inner = one(atom.node) } }
    }
    if atom.pos < p.len && p[atom.pos] == b'?' {
        return PState { pos = atom.pos + 1; node = ROpt { inner = one(atom.node) } }
    }
    atom
}

fn parse_atom(p: []byte, pos: u64): PState | error {
    if pos >= p.len { return error { message = "regex: unexpected end of pattern" } }
    var b = p[pos]
    if b == b'.' { return PState { pos = pos + 1; node = RAny { } } }
    if b == b'^' { return PState { pos = pos + 1; node = RStart { } } }
    if b == b'$' { return PState { pos = pos + 1; node = REnd { } } }
    if b == b'(' {
        var inner = match parse_alt(p, pos + 1) { PState as s => s; error as e => return e }
        if inner.pos >= p.len || p[inner.pos] != b')' {
            return error { message = "regex: unterminated group — expected ')'" }
        }
        return PState { pos = inner.pos + 1; node = RGroup { inner = one(inner.node) } }
    }
    if b == b'[' { return parse_class(p, pos + 1) }
    if b == b'\\' {
        return error { message = "regex: escape sequences are not supported yet" }
    }
    if b == b')' { return error { message = "regex: unexpected ')'" } }
    if b == b'*' || b == b'+' || b == b'?' {
        return error { message = "regex: quantifier with nothing to repeat" }
    }
    var scan = decode_codepoint(p, pos)
    PState { pos = pos + scan.width; node = RChar { cp = scan.cp } }
}

fn parse_class(p: []byte, pos: u64): PState | error {
    var at = pos
    var negate = false
    if at < p.len && p[at] == b'^' { negate = true; at = at + 1 }
    var ranges: []RRange = []
    var first = true
    loop {
        if at >= p.len { return error { message = "regex: unterminated character class — expected ']'" } }
        if p[at] == b']' && !first { break }
        first = false
        var lo = decode_codepoint(p, at)
        var after_lo = at + lo.width
        if after_lo + 1 < p.len && p[after_lo] == b'-' && p[after_lo + 1] != b']' {
            var hi = decode_codepoint(p, after_lo + 1)
            if hi.cp < lo.cp { return error { message = "regex: character class range out of order" } }
            ranges = [..ranges, RRange { lo = lo.cp; hi = hi.cp }]
            at = after_lo + 1 + hi.width
        } else {
            ranges = [..ranges, RRange { lo = lo.cp; hi = lo.cp }]
            at = after_lo
        }
    }
    if ranges.len == 0 { return error { message = "regex: empty character class" } }
    PState { pos = at + 1; node = RClass { negate = negate; ranges = ranges } }
}

/** teko::regex::compile — parse `pattern` into a `Regex`.
 * @return the compiled pattern, or a compile error on a malformed pattern. */
exp fn compile(pattern: str): Regex | error {
    var bytes = pattern.bytes()
    var parsed = match parse_alt(bytes, 0) { PState as s => s; error as e => return e }
    if parsed.pos != bytes.len {
        return error { message = "regex: unexpected trailing input in pattern" }
    }
    Regex { pattern = pattern; ast = parsed.node }
}

type MCont = struct {
    head: @RegexNode()
    tail: []MCont
}

fn mc_end(): []MCont { [] }

fn mc_push(node: @RegexNode(), cont: []MCont): []MCont {
    [MCont { head = node; tail = cont }]
}

fn mc_push_all(parts: []@RegexNode(), cont: []MCont): []MCont {
    var out = cont
    var j = parts.len
    loop {
        if j == 0 { break }
        j = j - 1
        out = mc_push(parts[j], out)
    }
    out
}

fn mc_of_node(node: @RegexNode(), cont: []MCont): []MCont {
    match node {
        RConcat as c => mc_push_all(c.parts, cont)
        _ => mc_push(node, cont)
    }
}

fn class_matches(cls: RClass, cp: u32): bool {
    var i: u64 = 0
    var hit = false
    loop {
        if i >= cls.ranges.len { break }
        var r = cls.ranges[i]
        if cp >= r.lo && cp <= r.hi { hit = true; break }
        i++
    }
    if cls.negate { !hit } else { hit }
}

fn m_cont(cont: []MCont, input: []u32, i: u64): bool {
    if cont.len == 0 { return true }
    m_node(cont[0].head, input, i, cont[0].tail)
}

fn m_node(node: @RegexNode(), input: []u32, i: u64, cont: []MCont): bool {
    match node {
        REmpty => m_cont(cont, input, i)
        RChar as c => m_one(i < input.len && input[i] == c.cp, input, i, cont)
        RAny => m_one(i < input.len, input, i, cont)
        RClass as cls => m_one(i < input.len && class_matches(cls, input[i]), input, i, cont)
        RStart => i == 0 && m_cont(cont, input, i)
        REnd => i == input.len && m_cont(cont, input, i)
        RGroup as g => m_node(one_of(g.inner), input, i, cont)
        RConcat as c => m_cont(mc_push_all(c.parts, cont), input, i)
        RAlt as a => m_alt(a.branches, 0, input, i, cont)
        RStar as s => m_star(one_of(s.inner), input, i, cont)
        RPlus as pl => m_plus(one_of(pl.inner), input, i, cont)
        ROpt as o => m_opt(one_of(o.inner), input, i, cont)
    }
}

fn m_one(accepted: bool, input: []u32, i: u64, cont: []MCont): bool {
    accepted && m_cont(cont, input, i + 1)
}

fn m_alt(branches: []@RegexNode(), idx: u64, input: []u32, i: u64, cont: []MCont): bool {
    if idx >= branches.len { return false }
    if m_node(branches[idx], input, i, cont) { return true }
    m_alt(branches, idx + 1, input, i, cont)
}

fn m_star(inner: @RegexNode(), input: []u32, i: u64, cont: []MCont): bool {
    if m_node(inner, input, i, mc_push(RStar { inner = one(inner) }, cont)) { return true }
    m_cont(cont, input, i)
}

fn m_plus(inner: @RegexNode(), input: []u32, i: u64, cont: []MCont): bool {
    m_node(inner, input, i, mc_push(RStar { inner = one(inner) }, cont))
}

fn m_opt(inner: @RegexNode(), input: []u32, i: u64, cont: []MCont): bool {
    if m_node(inner, input, i, cont) { return true }
    m_cont(cont, input, i)
}

/** teko::regex::is_match — whether `re`'s pattern matches somewhere in `input` (a search, not
 * a full match); `^`/`$` still anchor to the true start/end of `input`. */
exp fn is_match(re: Regex, input: str): bool {
    var cps = codepoints_of(input)
    var cont = mc_of_node(re.ast, mc_end())
    var start: u64 = 0
    loop {
        if m_cont(cont, cps, start) { return true }
        if start >= cps.len { break }
        start++
    }
    false
}

/** teko::regex::is_match_pattern — compile `pattern` and search `input` with it.
 * @throws the compile error on a malformed pattern. */
exp fn is_match_pattern(pattern: str, input: str): bool | error {
    var re = match compile(pattern) { Regex as r => r; error as e => return e }
    is_match(re, input)
}

/** teko::regex::full_match — whether the entire `input` matches `re`, start to end (implicitly
 * anchored regardless of any literal `^`/`$` in the pattern). */
exp fn full_match(re: Regex, input: str): bool {
    var cps = codepoints_of(input)
    m_cont(mc_of_node(re.ast, mc_push(REnd { }, mc_end())), cps, 0)
}
