pub type DocSpan = struct {
    file_id: str
    byte_offset: u64
    byte_len: u64

    pub fn read(): str {
        if self.file_id.len == (0 to u64) { return "" }
        match teko::io::read_file(self.file_id) {
            str as source => docspan_slice_text(source, self.byte_offset, self.byte_len)
            error => ""
        }
    }
}

pub fn docspan_none(): DocSpan {
    DocSpan { file_id = ""; byte_offset = 0 to u64; byte_len = 0 to u64 }
}

pub fn docspan_of(file: str, off: u64, len: u64): DocSpan {
    DocSpan { file_id = file; byte_offset = off; byte_len = len }
}

fn docspan_slice_text(source: str, off: u64, len: u64): str {
    if off >= source.len { return "" }
    var end = off + len
    if end > source.len { end = source.len }
    source.slice(off, end)
}
