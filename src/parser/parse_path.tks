use teko::lexer
fn parse_path(tokens: []lexer::Token, pos: u64): Parsed<Path> | error {
    if !is_name_at(tokens, pos) {
        return err_at(tokens, pos, "expected a name")
    }
    var segs: []Segment = []
    segs = [..segs, Segment { name = tokens[pos].text }]
    var p = pos + 1
    loop {
        if !is_kind_at(tokens, p, lexer::TokenKind::ColonColon) { break }
        if !is_kind_at(tokens, p + 1, lexer::TokenKind::Ident) {
            return err_at(tokens, p + 1, "expected a name after '::'")
        }
        segs = [..segs, Segment { name = tokens[p + 1].text }]
        p = p + 2
    }
    Parsed<Path> { node = Path { segments = segs }; next = p }
}

fn path_concat(lead: Path, tail: Path): Path {
    var segs: []Segment = []
    var i: u64 = 0
    loop { if i >= lead.segments.len { break }; segs = [..segs, lead.segments[i]]; i++ }
    var j: u64 = 0
    loop { if j >= tail.segments.len { break }; segs = [..segs, tail.segments[j]]; j++ }
    Path { segments = segs }
}
