
use teko::lexer

fn is_lowering_head(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Ident) && tokens[pos].text == "lowering" && is_kind_at(tokens, pos + 1, lexer::TokenKind::LBrace)
}

fn parse_lowering_frag(tokens: []lexer::Token, pos: u64): Parsed<@Statement()> | error {
    var lb = pos + 1
    if !is_kind_at(tokens, lb, lexer::TokenKind::LBrace) {
        return err_at(tokens, lb, "expected '{' after `lowering`")
    }
    var p = lb + 1
    var depth: u64 = 1
    var frag: []lexer::Token = []
    loop {
        if !has_token(tokens, p) {
            return err_at(tokens, p, "unterminated `lowering { … }` fragment — missing '}'")
        }
        if is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
            depth = depth + 1
        } else if is_kind_at(tokens, p, lexer::TokenKind::RBrace) {
            depth = depth - 1
            if depth == 0 { break }
        }
        frag = [..frag, tokens[p]]
        p = p + 1
    }
    Parsed<@Statement()> { node = LoweringFrag { tokens = frag }; next = p + 1 }
}

fn parse_statement(tokens: []lexer::Token, pos: u64): Parsed<@Statement()> | error {
    if !has_token(tokens, pos) { return err_at(tokens, pos, "expected a statement") }
    if is_kind_at(tokens, pos, lexer::TokenKind::Hash) {
        return parse_attributed_binding(tokens, pos)
    }
    if is_lowering_head(tokens, pos) {
        return parse_lowering_frag(tokens, pos)
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Return) {
        var after = pos + 1
        if !has_token(tokens, after) || is_sep(tokens, after) || is_kind_at(tokens, after, lexer::TokenKind::RBrace) {
            return Parsed<@Statement()> { node = Return { has_value = false; value = Expr { kind = Number { is_float = false; value = numint_of_u64(0); fval = 0.0 }; line = 0; col = 0 }; values = [] }; next = after }
        }
        if is_kind_at(tokens, after, lexer::TokenKind::LParen) && paren_has_top_comma(tokens, after) {
            var vals = match parse_return_value_list(tokens, after) { ParsedList<Expr> as x => x; error as e => return e }
            return Parsed<@Statement()> { node = Return { has_value = true; value = vals.items[0]; values = vals.items }; next = vals.next }
        }
        var v = match parse_expr(tokens, after) { Parsed<Expr> as x => x; error as e => return e }
        return Parsed<@Statement()> { node = Return { has_value = true; value = v.node; values = [] }; next = v.next }
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Ident) && is_kind_at(tokens, pos + 1, lexer::TokenKind::Colon) && is_kind_at(tokens, pos + 2, lexer::TokenKind::Loop) {
        return parse_loop(tokens, pos + 2, tokens[pos].text)
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Loop) {
        return parse_loop(tokens, pos, "")
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Break) {
        var label = ""
        var next = pos + 1
        if is_kind_at(tokens, pos + 1, lexer::TokenKind::Ident) { label = tokens[pos + 1].text; next = pos + 2 }
        return Parsed<@Statement()> { node = BreakStmt { label = label }; next = next }
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Continue) {
        var label = ""
        var next = pos + 1
        if is_kind_at(tokens, pos + 1, lexer::TokenKind::Ident) { label = tokens[pos + 1].text; next = pos + 2 }
        return Parsed<@Statement()> { node = ContinueStmt { label = label }; next = next }
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Defer) {
        var lbrace = pos + 1
        if !is_kind_at(tokens, lbrace, lexer::TokenKind::LBrace) {
            return err_at(tokens, lbrace, "expected '{' after `defer`")
        }
        var blk = match parse_block(tokens, lbrace) { ParsedList<@Statement()> as x => x; error as e => return e }
        return Parsed<@Statement()> { node = DeferStmt { body = blk.items }; next = blk.next }
    }
    if is_spawn_head(tokens, pos) {
        return parse_spawn(tokens, pos)
    }
    if is_adopt_head(tokens, pos) {
        return parse_adopt(tokens, pos)
    }
    if is_ref_binding_head(tokens, pos) {
        return parse_ref_binding(tokens, pos)
    }
    if is_binding_head(tokens, pos) {
        return parse_binding(tokens, pos)
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Underscore) && is_kind_at(tokens, pos + 1, lexer::TokenKind::Assign) {
        return parse_discard_assign(tokens, pos)
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Ident) && is_assign_op(tokens, pos + 1) {
        return parse_assign(tokens, pos)
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Ident) &&
    (is_kind_at(tokens, pos + 1, lexer::TokenKind::PlusPlus) || is_kind_at(tokens, pos + 1, lexer::TokenKind::MinusMinus)) {
        var op = if is_kind_at(tokens, pos + 1, lexer::TokenKind::PlusPlus) { lexer::TokenKind::PlusEq } else { lexer::TokenKind::MinusEq }
        return Parsed<@Statement()> { node = Assign { kind = AssignKind::Simple; name = tokens[pos].text; op = op; value = Expr { kind = Number { is_float = false; value = numint_of_u64(1); fval = 0.0 }; line = 0; col = 0 }; deref = false; target = no_expr() }; next = pos + 2 }
    }
    if is_block_stmt_head(tokens, pos) {
        var blk = match parse_block(tokens, pos) { ParsedList<@Statement()> as x => x; error as e => return e }
        return Parsed<@Statement()> { node = BlockStmt { body = blk.items }; next = blk.next }
    }
    var e = match parse_expr(tokens, pos) { Parsed<Expr> as x => x; error as e => return e }
    var is_field = match e.node.kind { FieldAccess as _fa => true; _ => false }
    if is_field && is_assign_op(tokens, e.next) {
        var op = kind_at(tokens, e.next)
        var v = match parse_expr(tokens, e.next + 1) { Parsed<Expr> as x => x; error as er => return er }
        return Parsed<@Statement()> { node = Assign { kind = AssignKind::Field; name = ""; op = op; value = v.node; deref = false; target = e.node }; next = v.next }
    }
    var is_index = match e.node.kind { Index as _ix => true; _ => false }
    if is_index && is_assign_op(tokens, e.next) {
        var iop = kind_at(tokens, e.next)
        var iv = match parse_expr(tokens, e.next + 1) { Parsed<Expr> as x => x; error as er => return er }
        return Parsed<@Statement()> { node = Assign { kind = AssignKind::Index; name = ""; op = iop; value = iv.node; deref = false; target = e.node }; next = iv.next }
    }
    Parsed<@Statement()> { node = ExprStmt { expr = e.node }; next = e.next }
}

fn is_block_stmt_head(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::LBrace)
}

fn is_adopt_head(tokens: []lexer::Token, pos: u64): bool {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Ident) { return false }
    if tokens[pos].text != "adopt" { return false }
    if is_kind_at(tokens, pos + 1, lexer::TokenKind::LBrace) { return true }
    is_kind_at(tokens, pos + 1, lexer::TokenKind::Ident) && is_kind_at(tokens, pos + 2, lexer::TokenKind::LBrace)
}

fn is_spawn_head(tokens: []lexer::Token, pos: u64): bool {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Ident) { return false }
    if tokens[pos].text != "spawn" { return false }
    is_kind_at(tokens, pos + 1, lexer::TokenKind::Ident)
}

fn parse_spawn(tokens: []lexer::Token, pos: u64): Parsed<@Statement()> | error {
    var e = match parse_expr(tokens, pos + 1) { Parsed<Expr> as x => x; error as err => return err }
    var ok = match e.node.kind { Call as _c => true; MethodCall as _m => true; _ => false }
    if !ok { return err_at(tokens, pos + 1, "`spawn` must be followed by a call, e.g. `spawn worker(n, msg)`") }
    Parsed<@Statement()> { node = Spawn { call = e.node }; next = e.next }
}

fn parse_adopt(tokens: []lexer::Token, pos: u64): Parsed<@Statement()> | error {
    var name = ""
    var lbrace = pos + 1
    if is_kind_at(tokens, pos + 1, lexer::TokenKind::Ident) { name = tokens[pos + 1].text; lbrace = pos + 2 }
    if !is_kind_at(tokens, lbrace, lexer::TokenKind::LBrace) {
        return err_at(tokens, lbrace, "expected '{' after `adopt`")
    }
    var blk = match parse_block(tokens, lbrace) { ParsedList<@Statement()> as x => x; error as e => return e }
    Parsed<@Statement()> { node = AdoptStmt { name = name; body = blk.items }; next = blk.next }
}

/**
 * Parse a brace-delimited statement block into an exact-sized statement array.
 *
 * @param tokens  the token stream being parsed
 * @param pos     index of the opening '{'
 * @return        the parsed statements and the index past the closing '}'
 * @throws        when a statement is not followed by ';', a newline, or '}'
 */
fn parse_block(tokens: []lexer::Token, pos: u64): ParsedList<@Statement()> | error {
    fill_block_stmts(tokens, skip_seps(tokens, pos + 1), 0)
}

/**
 * Parse the remaining statements of a block, allocating the exact-sized array
 * at the closing brace and writing each statement into its slot as the
 * recursion unwinds — one parse pass, no per-iteration spread reallocation.
 *
 * @param tokens  the token stream being parsed
 * @param p       index of the next statement, or of the closing '}'
 * @param filled  count of statements already parsed by outer frames
 * @return        the exact-sized statement array and the index past '}'
 * @throws        when a statement is not followed by ';', a newline, or '}'
 */
fn fill_block_stmts(tokens: []lexer::Token, p: u64, filled: u64): ParsedList<@Statement()> | error {
    if is_kind_at(tokens, p, lexer::TokenKind::RBrace) {
        var empty: [filled]@Statement() = []
        return ParsedList<@Statement()> { items = empty; next = p + 1 }
    }
    var s = match parse_statement(tokens, p) { Parsed<@Statement()> as x => x; error as e => return e }
    var q = s.next
    if is_kind_at(tokens, q, lexer::TokenKind::RBrace) {
        var last: [filled + 1]@Statement() = []
        last[filled] = s.node
        return ParsedList<@Statement()> { items = last; next = q + 1 }
    }
    if !is_sep(tokens, q) {
        return err_at(tokens, q, "expected ';', a newline, or '}' after a statement")
    }
    var rest = match fill_block_stmts(tokens, skip_seps(tokens, q), filled + 1) { ParsedList<@Statement()> as x => x; error as e => return e }
    var items = rest.items
    items[filled] = s.node
    ParsedList<@Statement()> { items = items; next = rest.next }
}

fn no_type(): @TypeExpr() {
    NamedType { path = Path { segments = [] }; args = [] }
}

pub fn no_expr(): Expr {
    Expr { kind = NullLit { }; line = 0; col = 0 }
}

fn parse_annotation(tokens: []lexer::Token, pos: u64): Annotation | error {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Colon) {
        return Annotation { has_type = false; type_ann = no_type(); next = pos }
    }
    var ty = match parse_type(tokens, pos + 1) { ParsedType as x => x; error as e => return e }
    Annotation { has_type = true; type_ann = ty.node; next = ty.next }
}

fn parse_inline_binding(tokens: []lexer::Token, pos: u64): Parsed<@Statement()> | error {
    if !is_kind_at(tokens, pos + 1, lexer::TokenKind::Ident) || tokens[pos + 1].text != "inline" {
        return err_at(tokens, pos + 1, "expected `inline` after `#` — only `#inline` attaches to a local binding")
    }
    var after = skip_seps(tokens, pos + 2)
    if !is_binding_head(tokens, after) {
        return err_at(tokens, after, "`#inline` attaches only to a `var`/`const` binding")
    }
    parse_binding(tokens, after)
}

fn parse_attributed_binding(tokens: []lexer::Token, pos: u64): Parsed<@Statement()> | error {
    if !is_kind_at(tokens, pos + 1, lexer::TokenKind::Ident) {
        return err_at(tokens, pos + 1, "expected an attribute name after `#` (only `#inline` attaches to a local binding)")
    }
    var attr = tokens[pos + 1].text
    if attr == "inline" { return parse_inline_binding(tokens, pos) }
    err_at(tokens, pos + 1, "unknown binding attribute — only `#inline` (layout) attaches to a local binding")
}

fn parse_binding(tokens: []lexer::Token, pos: u64): Parsed<@Statement()> | error {
    var kind = bind_kind_at(tokens, pos)
    if is_multibind_shape(tokens, pos + 1) {
        return parse_multibind(tokens, pos + 1, kind)
    }
    var tgt = match parse_bind_target(tokens, pos + 1) { Parsed<@BindTarget()> as x => x; error as e => return e }
    var ann = match parse_annotation(tokens, tgt.next) { Annotation as x => x; error as e => return e }
    if ann.has_type && is_ref_grafia_annotation(ann.type_ann) {
        return err_at(tokens, tgt.next, "a reference binding is written `ref x: T = e` — a `var`/`const` annotation may not be a bare `ref T` (the `ref` is the binding modifier, not part of the bound value's type; a `ref T | null` union member is still fine)")
    }
    if !is_kind_at(tokens, ann.next, lexer::TokenKind::Assign) {
        return err_at(tokens, ann.next, "expected '=' in a binding")
    }
    var v = match parse_expr(tokens, ann.next + 1) { Parsed<Expr> as x => x; error as e => return e }
    Parsed<@Statement()> { node = Binding { kind = kind; target = tgt.node; has_type = ann.has_type; type_ann = ann.type_ann; is_ref = false; value = v.node }; next = v.next }
}

fn parse_multibind(tokens: []lexer::Token, tpos: u64, kind: BindKind): Parsed<@Statement()> | error {
    var line = tokens[tpos].line
    var col = tokens[tpos].col
    var is_array = is_kind_at(tokens, tpos, lexer::TokenKind::LBracket)
    var shape = if is_array { MultiTargetKind::ArrayDecomp } else { MultiTargetKind::Parallel }
    var tl = if is_array {
        match parse_array_bind_targets(tokens, tpos) { ParsedList<@BindElem()> as x => x; error as e => return e }
    } else {
        match parse_parallel_bind_targets(tokens, tpos) { ParsedList<@BindElem()> as x => x; error as e => return e }
    }
    var ann = match parse_annotation(tokens, tl.next) { Annotation as x => x; error as e => return e }
    if !is_kind_at(tokens, ann.next, lexer::TokenKind::Assign) {
        return err_at(tokens, ann.next, "expected '=' in a multiple binding")
    }
    var vals = match parse_multibind_values(tokens, ann.next + 1) { ParsedList<Expr> as x => x; error as e => return e }
    Parsed<@Statement()> { node = MultiBind { kind = kind; shape = shape; targets = tl.items; has_type = ann.has_type; type_ann = ann.type_ann; values = vals.items; line = line; col = col }; next = vals.next }
}

fn parse_parallel_bind_targets(tokens: []lexer::Token, pos: u64): ParsedList<@BindElem()> | error {
    var p = pos
    var elems: []@BindElem() = []
    loop {
        if is_kind_at(tokens, p, lexer::TokenKind::Underscore) {
            elems = [..elems, BindSkip { }]
            p = p + 1
        } else if is_name_at(tokens, p) {
            elems = [..elems, BindName { name = tokens[p].text }]
            p = p + 1
        } else if is_kind_at(tokens, p, lexer::TokenKind::DotDot) {
            return err_at(tokens, p, "`..` skip-range is legal only inside an array decomposition `var [a, .., b] = …`, not in a parallel binding")
        } else {
            return err_at(tokens, p, "expected a name or `_` in a multiple binding target list")
        }
        if !is_kind_at(tokens, p, lexer::TokenKind::Comma) { break }
        p = p + 1
    }
    ParsedList<@BindElem()> { items = elems; next = p }
}

fn parse_array_bind_targets(tokens: []lexer::Token, pos: u64): ParsedList<@BindElem()> | error {
    var p = skip_seps(tokens, pos + 1)
    if is_kind_at(tokens, p, lexer::TokenKind::RBracket) {
        return err_at(tokens, p, "an array decomposition `var [ … ] = …` needs at least one target")
    }
    var elems: []@BindElem() = []
    var seen_rest = false
    loop {
        if is_kind_at(tokens, p, lexer::TokenKind::DotDot) {
            if seen_rest {
                return err_at(tokens, p, "at most one `..` skip-range in an array decomposition")
            }
            seen_rest = true
            elems = [..elems, BindRest { }]
            p = p + 1
        } else if is_kind_at(tokens, p, lexer::TokenKind::Underscore) {
            elems = [..elems, BindSkip { }]
            p = p + 1
        } else if is_name_at(tokens, p) {
            elems = [..elems, BindName { name = tokens[p].text }]
            p = p + 1
        } else {
            return err_at(tokens, p, "expected a name, `_`, or `..` in an array decomposition `[ … ]`")
        }
        p = skip_seps(tokens, p)
        if !is_kind_at(tokens, p, lexer::TokenKind::Comma) { break }
        p = skip_seps(tokens, p + 1)
        if is_kind_at(tokens, p, lexer::TokenKind::RBracket) { break }
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::RBracket) {
        return err_at(tokens, p, "expected ']' to close an array decomposition")
    }
    ParsedList<@BindElem()> { items = elems; next = p + 1 }
}

fn paren_has_top_comma(tokens: []lexer::Token, lpos: u64): bool {
    var depth: i64 = 0
    var p = lpos
    loop {
        if !has_token(tokens, p) { break }
        var k = kind_at(tokens, p)
        if k == lexer::TokenKind::LParen || k == lexer::TokenKind::LBracket || k == lexer::TokenKind::LBrace {
            depth = depth + 1
        } else if k == lexer::TokenKind::RParen || k == lexer::TokenKind::RBracket || k == lexer::TokenKind::RBrace {
            depth = depth - 1
            if depth == 0 { break }
        } else if k == lexer::TokenKind::Comma && depth == 1 {
            return true
        }
        p = p + 1
    }
    false
}

fn parse_return_value_list(tokens: []lexer::Token, pos: u64): ParsedList<Expr> | error {
    var p = skip_seps(tokens, pos + 1)
    var vals: []Expr = []
    loop {
        var v = match parse_expr(tokens, p) { Parsed<Expr> as x => x; error as e => return e }
        vals = [..vals, v.node]
        p = skip_seps(tokens, v.next)
        if !is_kind_at(tokens, p, lexer::TokenKind::Comma) { break }
        p = skip_seps(tokens, p + 1)
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::RParen) {
        return err_at(tokens, p, "expected ')' to close a multiple return `return ( … )`")
    }
    ParsedList<Expr> { items = vals; next = p + 1 }
}

fn parse_multibind_values(tokens: []lexer::Token, pos: u64): ParsedList<Expr> | error {
    var p = pos
    var vals: []Expr = []
    loop {
        var v = match parse_expr(tokens, p) { Parsed<Expr> as x => x; error as e => return e }
        vals = [..vals, v.node]
        p = v.next
        if !is_kind_at(tokens, p, lexer::TokenKind::Comma) { break }
        p = skip_seps(tokens, p + 1)
    }
    ParsedList<Expr> { items = vals; next = p }
}

fn bind_kind_at(tokens: []lexer::Token, pos: u64): BindKind {
    if kind_at(tokens, pos) == lexer::TokenKind::Const { return BindKind::Const }
    BindKind::Var
}

fn is_ref_binding_head(tokens: []lexer::Token, pos: u64): bool {
    if !(is_kind_at(tokens, pos, lexer::TokenKind::Ident) && tokens[pos].text == "ref") { return false }
    if !is_name_at(tokens, pos + 1) { return false }
    is_kind_at(tokens, pos + 2, lexer::TokenKind::Colon) || is_kind_at(tokens, pos + 2, lexer::TokenKind::Assign)
}

fn is_var_binding_head(tokens: []lexer::Token, pos: u64): bool {
    if !(is_kind_at(tokens, pos, lexer::TokenKind::Ident) && tokens[pos].text == "var") { return false }
    if is_kind_at(tokens, pos + 1, lexer::TokenKind::LBrace) { return true }
    if is_multibind_shape(tokens, pos + 1) { return true }
    if !is_name_at(tokens, pos + 1) { return false }
    is_kind_at(tokens, pos + 2, lexer::TokenKind::Colon) || is_kind_at(tokens, pos + 2, lexer::TokenKind::Assign)
}

fn is_multibind_shape(tokens: []lexer::Token, tpos: u64): bool {
    if is_kind_at(tokens, tpos, lexer::TokenKind::LBracket) { return true }
    is_name_at(tokens, tpos) && is_kind_at(tokens, tpos + 1, lexer::TokenKind::Comma)
}

fn is_binding_head(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Const) || is_var_binding_head(tokens, pos)
}

fn parse_ref_binding(tokens: []lexer::Token, pos: u64): Parsed<@Statement()> | error {
    var tgt = match parse_bind_target(tokens, pos + 1) { Parsed<@BindTarget()> as x => x; error as e => return e }
    var ann = match parse_annotation(tokens, tgt.next) { Annotation as x => x; error as e => return e }
    if !is_kind_at(tokens, ann.next, lexer::TokenKind::Assign) {
        return err_at(tokens, ann.next, "a `ref` binding requires an initializer (`ref x: T = e`) — a reference is write-through and can never be left unbound (definite-assignment)")
    }
    var v = match parse_expr(tokens, ann.next + 1) { Parsed<Expr> as x => x; error as e => return e }
    var ann_ty = if ann.has_type { wrap_ref_type(ann.type_ann) } else { ann.type_ann }
    Parsed<@Statement()> { node = Binding { kind = BindKind::Var; target = tgt.node; has_type = ann.has_type; type_ann = ann_ty; is_ref = true; value = v.node }; next = v.next }
}

fn parse_bind_target(tokens: []lexer::Token, pos: u64): Parsed<@BindTarget()> | error {
    if is_kind_at(tokens, pos, lexer::TokenKind::LBrace) {
        var names = match parse_field_names(tokens, pos) { ParsedList<str> as x => x; error as e => return e }
        return Parsed<@BindTarget()> { node = DestructurePattern { names = names.items }; next = names.next }
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Underscore) {
        return err_at(tokens, pos, "`_` is the write-only discard and cannot be a `var`/`const` target — drop the keyword and write `_ = expr` to evaluate an expression and discard its result")
    }
    if !is_name_at(tokens, pos) {
        return err_at(tokens, pos, "expected a name or `{ … }` after `var`/`const`")
    }
    Parsed<@BindTarget()> { node = SimpleName { name = tokens[pos].text }; next = pos + 1 }
}

fn parse_discard_assign(tokens: []lexer::Token, pos: u64): Parsed<@Statement()> | error {
    var dv = match parse_expr(tokens, pos + 2) { Parsed<Expr> as x => x; error as e => return e }
    Parsed<@Statement()> { node = Binding { kind = BindKind::Var; target = SimpleName { name = "_" }; has_type = false; type_ann = no_type(); is_ref = false; value = dv.node }; next = dv.next }
}

fn parse_assign(tokens: []lexer::Token, pos: u64): Parsed<@Statement()> | error {
    var name = tokens[pos].text
    var op = kind_at(tokens, pos + 1)
    var v = match parse_expr(tokens, pos + 2) { Parsed<Expr> as x => x; error as e => return e }
    Parsed<@Statement()> { node = Assign { kind = AssignKind::Simple; name = name; op = op; value = v.node; deref = false; target = no_expr() }; next = v.next }
}

