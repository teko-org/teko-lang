pub type Segment = struct { name: str }
pub type Path = struct { segments: []Segment }

pub type NamedType = struct { path: Path; args: []@TypeExpr() }
pub type SliceType = struct { element: @TypeExpr() }
pub type SizedArrayType = struct { size: Expr; element: @TypeExpr() }
pub type UnionType = struct { members: []@TypeExpr() }
pub type FunctionType = struct { params: []@TypeExpr(); ret: @TypeExpr() }

pub type MacroType = struct { callee: Path; args: []Expr; callee_type_args: []@TypeExpr() }

macro TypeExpr() { lowering { parser::NamedType | parser::SliceType | parser::SizedArrayType | parser::UnionType | parser::FunctionType | parser::MacroType } }
