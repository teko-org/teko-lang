
use teko::lexer

fn parse_discard_param(tokens: []lexer::Token, pos: u64, params: []Param): ParsedList<Param> | error {
    if is_kind_at(tokens, pos + 1, lexer::TokenKind::Colon) {
        return err_at(tokens, pos + 1, "a `_` discard parameter takes no type annotation — its type is fixed by position from the interface/base signature being implemented or overridden")
    }
    var out = [..params, Param { name = "_"; has_type = false; type_ann = no_type(); is_params = false; has_default = false; default_expr = no_expr() }]
    ParsedList<Param> { items = out; next = pos + 1 }
}

fn parse_params(tokens: []lexer::Token, pos: u64): ParsedList<Param> | error {
    var p = pos + 1
    var params: []Param = []
    var seen_default = false
    if is_kind_at(tokens, p, lexer::TokenKind::RParen) {
        return ParsedList<Param> { items = params; next = p + 1 }
    }
    loop {
        if is_kind_at(tokens, p, lexer::TokenKind::Underscore) {
            var dp = match parse_discard_param(tokens, p, params) { ParsedList<Param> as x => x; error as e => return e }
            params = dp.items
            p = dp.next
            if !is_kind_at(tokens, p, lexer::TokenKind::Comma) { break }
            p = p + 1
            continue
        }
        var has_params_kw = is_kind_at(tokens, p, lexer::TokenKind::Ident) && tokens[p].text == "params" &&
        is_name_at(tokens, p + 1) && is_kind_at(tokens, p + 2, lexer::TokenKind::Colon)
        if has_params_kw { p = p + 1 }
        var has_ref_kw = is_kind_at(tokens, p, lexer::TokenKind::Ident) && tokens[p].text == "ref" &&
        is_name_at(tokens, p + 1) && is_kind_at(tokens, p + 2, lexer::TokenKind::Colon)
        if has_ref_kw { p = p + 1 }
        if is_kind_at(tokens, p, lexer::TokenKind::SelfKw) {
            return err_at(tokens, p, "`self` is the synthetic receiver; it cannot name a parameter")
        }
        if !is_name_at(tokens, p) {
            return err_at(tokens, p, "expected a parameter name")
        }
        var name = tokens[p].text
        if !is_kind_at(tokens, p + 1, lexer::TokenKind::Colon) {
            return err_at(tokens, p + 1, "expected ':' after a parameter name")
        }
        var ty = match parse_type(tokens, p + 2) { ParsedType as x => x; error as e => return e }
        if has_params_kw {
            match ty.node { SliceType => { }; _ => return err_at(tokens, p + 2, "'params' parameter must have a slice type ([]T)") }
        }
        var param_ty = if has_ref_kw { wrap_ref_type(ty.node) } else { ty.node }
        var ppos = ty.next
        var has_default = false
        var default_expr = no_expr()
        if is_kind_at(tokens, ppos, lexer::TokenKind::Assign) {
            var dv = match parse_expr(tokens, ppos + 1) { Parsed<Expr> as x => x; error as e => return e }
            has_default = true
            default_expr = dv.node
            ppos = dv.next
        } else if seen_default && !has_params_kw {
            return err_at(tokens, ppos, "a default-valued parameter must be followed only by other defaulted parameters (defaults are trailing-only)")
        }
        if has_default { seen_default = true }
        params = [..params, Param { name = name; has_type = true; type_ann = param_ty; is_params = has_params_kw; has_default = has_default; default_expr = default_expr }]
        p = ppos
        if has_params_kw && is_kind_at(tokens, p, lexer::TokenKind::Comma) {
            return err_at(tokens, p, "'params' must be the last parameter")
        }
        if !is_kind_at(tokens, p, lexer::TokenKind::Comma) { break }
        p = p + 1
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::RParen) {
        return err_at(tokens, p, "expected ')' to close the parameter list")
    }
    ParsedList<Param> { items = params; next = p + 1 }
}

fn is_service_lifetime_at(tokens: []lexer::Token, pos: u64): bool {
    if !is_name_at(tokens, pos) { return false }
    var w = tokens[pos].text
    w == "singleton" || w == "scoped" || w == "transient"
}
fn is_bare_constraint_name_at(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Ident) &&
    !is_kind_at(tokens, pos + 1, lexer::TokenKind::Lt) &&
    !is_kind_at(tokens, pos + 1, lexer::TokenKind::ColonColon)
}
fn can_start_constraint_type_at(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Ident) ||
    is_kind_at(tokens, pos, lexer::TokenKind::LBracket) ||
    is_kind_at(tokens, pos, lexer::TokenKind::LParen)
}
fn parse_constraint_atom(tokens: []lexer::Token, pos: u64): ParsedConstraintTerm | error {
    if is_kind_at(tokens, pos, lexer::TokenKind::Class) {
        return ParsedConstraintTerm { node = ConstraintForm { form = "class"; has_lifetime = false; lifetime = ServiceLifetime::Singleton }; next = pos + 1; pending_gt = 0 }
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Struct) {
        return ParsedConstraintTerm { node = ConstraintForm { form = "struct"; has_lifetime = false; lifetime = ServiceLifetime::Singleton }; next = pos + 1; pending_gt = 0 }
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Service) {
        if is_service_lifetime_at(tokens, pos + 1) {
            var lt = match parse_service_lifetime(tokens, pos + 1) { Parsed<ServiceLifetime> as x => x; error as e => return e }
            return ParsedConstraintTerm { node = ConstraintForm { form = "service"; has_lifetime = true; lifetime = lt.node }; next = lt.next; pending_gt = 0 }
        }
        return ParsedConstraintTerm { node = ConstraintForm { form = "service"; has_lifetime = false; lifetime = ServiceLifetime::Singleton }; next = pos + 1; pending_gt = 0 }
    }
    if is_bare_constraint_name_at(tokens, pos) {
        var name = tokens[pos].text
        if name == "notnull" { return ParsedConstraintTerm { node = ConstraintNotNull { }; next = pos + 1; pending_gt = 0 } }
        return ParsedConstraintTerm { node = ConstraintAtom { name = name }; next = pos + 1; pending_gt = 0 }
    }
    if !can_start_constraint_type_at(tokens, pos) {
        return err_at(tokens, pos, "expected a constraint term (a form word, a service lifetime, an interface/type/slice/`error`, a disjunction, or `notnull`) in a type-parameter constraint")
    }
    var t = match parse_type_primary(tokens, pos) { ParsedType as x => x; error as e => return e }
    ParsedConstraintTerm { node = ConstraintType { ty = t.node }; next = t.next; pending_gt = t.pending_gt }
}
fn is_notnull_constraint(c: @ConstraintExpr()): bool {
    match c { parser::ConstraintNotNull => true; _ => false }
}
fn parse_constraint_and(tokens: []lexer::Token, pos: u64): ParsedConstraintTerm | error {
    var left = match parse_constraint_atom(tokens, pos) { ParsedConstraintTerm as x => x; error as e => return e }
    loop {
        if left.pending_gt > 0 { break }
        if !is_kind_at(tokens, left.next, lexer::TokenKind::Amp) { break }
        var right = match parse_constraint_atom(tokens, left.next + 1) { ParsedConstraintTerm as x => x; error as e => return e }
        left = ParsedConstraintTerm { node = ConstraintAnd { left = left.node; right = right.node }; next = right.next; pending_gt = right.pending_gt }
    }
    left
}
fn parse_constraint_expr(tokens: []lexer::Token, pos: u64): ParsedConstraintTerm | error {
    var left = match parse_constraint_and(tokens, pos) { ParsedConstraintTerm as x => x; error as e => return e }
    loop {
        if left.pending_gt > 0 { break }
        if !is_kind_at(tokens, left.next, lexer::TokenKind::Pipe) { break }
        if is_notnull_constraint(left.node) { return err_at(tokens, pos, "`notnull` may not be a `|` alternative — it is a non-null modifier, use it with `&` (e.g. `class & notnull`) (§9.2b)") }
        var right = match parse_constraint_and(tokens, left.next + 1) { ParsedConstraintTerm as x => x; error as e => return e }
        if is_notnull_constraint(right.node) { return err_at(tokens, left.next + 1, "`notnull` may not be a `|` alternative — it is a non-null modifier, use it with `&` (e.g. `class & notnull`) (§9.2b)") }
        left = ParsedConstraintTerm { node = ConstraintOr { left = left.node; right = right.node }; next = right.next; pending_gt = right.pending_gt }
    }
    left
}

fn parse_type_params(tokens: []lexer::Token, pos: u64): ParsedTypeParams | error {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Lt) {
        return ParsedTypeParams { names = []; constraints = []; next = pos }
    }
    var p = pos + 1
    var names: []str = []
    var constraints: []@ConstraintExpr() = []
    loop {
        if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
            return err_at(tokens, p, "expected a type-parameter name in '<…>'")
        }
        names = [..names, tokens[p].text]
        p = p + 1
        var closed_by_pending = false
        if is_kind_at(tokens, p, lexer::TokenKind::Colon) {
            var c = match parse_constraint_expr(tokens, p + 1) { ParsedConstraintTerm as x => x; error as e => return e }
            constraints = [..constraints, c.node]
            p = c.next
            closed_by_pending = c.pending_gt > 0
        } else {
            constraints = [..constraints, NoConstraint { }]
        }
        if closed_by_pending { break }
        if is_kind_at(tokens, p, lexer::TokenKind::Comma) { p = p + 1 }
        else if is_kind_at(tokens, p, lexer::TokenKind::Gt) { p = p + 1; break }
        else { return err_at(tokens, p, "expected ',' or '>' in a type-parameter list") }
    }
    ParsedTypeParams { names = names; constraints = constraints; next = p }
}

fn consume_static_modifier(tokens: []lexer::Token, pos: u64): Parsed<bool> {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Static) { return Parsed<bool> { node = false; next = pos } }
    Parsed<bool> { node = true; next = pos + 1 }
}

fn consume_global_modifier(tokens: []lexer::Token, pos: u64): Parsed<bool> {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Global) { return Parsed<bool> { node = false; next = pos } }
    Parsed<bool> { node = true; next = pos + 1 }
}

fn is_variable_binding_head(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Ident) && tokens[pos].text == "var"
}

fn inject_synthetic_receiver(params: []Param): []Param {
    var out: []Param = []
    out = [..out, Param { name = "self"; has_type = false; type_ann = no_type(); is_params = false; has_default = false; default_expr = no_expr() }]
    var i = 0 to u64
    loop {
        if i >= params.len { break }
        out = [..out, params[i]]
        i = i + 1
    }
    out
}

fn parse_export_override(tokens: []lexer::Token, pos: u64): Parsed<str> | error {
    if !is_kind_at(tokens, pos, lexer::TokenKind::LParen) { return Parsed<str> { node = ""; next = pos } }
    var p = pos + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Str) {
        return err_at(tokens, p, "expected a quoted C symbol inside `exp(\"…\")`")
    }
    var sym = tokens[p].text
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::RParen) {
        return err_at(tokens, p, "expected `)` to close the `exp(\"…\")` export-symbol override")
    }
    Parsed<str> { node = sym; next = p + 1 }
}

fn skip_export_override_peek(tokens: []lexer::Token, pos: u64): u64 {
    if !is_kind_at(tokens, pos, lexer::TokenKind::LParen) { return pos }
    var k = pos + 1
    if is_kind_at(tokens, k, lexer::TokenKind::Str) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::RParen) { k = k + 1 }
    k
}

fn is_return_type_intro_at(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Colon)
}

fn parse_multi_return_types(tokens: []lexer::Token, pos: u64): ParsedList<@TypeExpr()> | error {
    var p = skip_seps(tokens, pos + 1)
    if is_kind_at(tokens, p, lexer::TokenKind::RParen) {
        return err_at(tokens, p, "a multiple-return signature `( A, B )` needs at least two types")
    }
    var types: []@TypeExpr() = []
    loop {
        var t = match parse_type(tokens, p) { ParsedType as x => x; error as e => return e }
        types = [..types, t.node]
        p = skip_seps(tokens, t.next)
        if !is_kind_at(tokens, p, lexer::TokenKind::Comma) { break }
        p = skip_seps(tokens, p + 1)
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::RParen) {
        return err_at(tokens, p, "expected ')' to close a multiple-return signature")
    }
    if types.len < 2 {
        return err_at(tokens, pos, "a multiple-return signature `( A, B )` needs at least two types — for a single return type write `A`, not `( A )`")
    }
    ParsedList<@TypeExpr()> { items = types; next = p + 1 }
}

fn parse_function(tokens: []lexer::Token, pos: u64, is_test: bool, os_guard: str, is_type_method: bool, allow_bodyless: bool): Parsed<@Decl()> | error {
    var p = pos
    var has_doc = false
    var doc = docspan_none()
    if is_kind_at(tokens, p, lexer::TokenKind::Doc) {
        has_doc = true
        doc = docspan_of(tokens[p].file, tokens[p].byte_off, tokens[p].text.len)
        p = skip_seps(tokens, p + 1)
    }
    var vis = Visibility::Private
    var export_c_symbol = ""
    if is_kind_at(tokens, p, lexer::TokenKind::Pub) {
        vis = Visibility::Pub
        p = p + 1
    } else if is_kind_at(tokens, p, lexer::TokenKind::Exp) {
        vis = Visibility::Exp
        p = p + 1
        var ov = match parse_export_override(tokens, p) { Parsed<str> as x => x; error as e => return e }
        export_c_symbol = ov.node
        p = ov.next
    }
    var global_mod = consume_global_modifier(tokens, p)
    var is_global = global_mod.node
    p = global_mod.next
    var is_intern = false
    if is_kind_at(tokens, p, lexer::TokenKind::Intern) {
        is_intern = true
        p = p + 1
    }
    var is_abstract = false
    var is_virtual = false
    var is_override = false
    if is_kind_at(tokens, p, lexer::TokenKind::Abstract) { is_abstract = true; p = p + 1 }
    else if is_kind_at(tokens, p, lexer::TokenKind::Virtual) { is_virtual = true; p = p + 1 }
    else if is_kind_at(tokens, p, lexer::TokenKind::Override) { is_override = true; p = p + 1 }
    var static_mod = consume_static_modifier(tokens, p)
    var is_static = static_mod.node
    p = static_mod.next
    var is_extern = false
    if is_kind_at(tokens, p, lexer::TokenKind::Extern) {
        is_extern = true
        p = p + 1
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::Fn) {
        return err_at(tokens, p, "expected `fn`")
    }
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
        return err_at(tokens, p, "expected a function name")
    }
    var name = tokens[p].text
    var name_line: u32 = tokens[p].line
    var name_col: u32 = tokens[p].col
    p = p + 1
    var tps = match parse_type_params(tokens, p) { ParsedTypeParams as x => x; error as e => return e }
    p = tps.next
    if !is_kind_at(tokens, p, lexer::TokenKind::LParen) {
        return err_at(tokens, p, "expected '(' for the parameter list")
    }
    var params = match parse_params(tokens, p) { ParsedList<Param> as x => x; error as e => return e }
    p = params.next
    if is_type_method && !is_static {
        params = ParsedList<Param> { items = inject_synthetic_receiver(params.items); next = params.next }
    }
    var has_return = false
    var return_type = no_type()
    var ret_types: []@TypeExpr() = []
    if is_return_type_intro_at(tokens, p) {
        if is_kind_at(tokens, p + 1, lexer::TokenKind::LParen) {
            var mr = match parse_multi_return_types(tokens, p + 1) { ParsedList<@TypeExpr()> as x => x; error as e => return e }
            ret_types = mr.items
            has_return = true
            return_type = ret_types[0]
            p = mr.next
        } else {
            var ret = match parse_type(tokens, p + 1) { ParsedType as x => x; error as e => return e }
            has_return = true
            return_type = ret.node
            p = ret.next
        }
    }
    if is_extern {
        if ret_types.len > 0 { return err_at(tokens, p, "an `extern` function may not declare a multiple-return `( A, B )` signature") }
        if is_test { return err_at(tokens, p, "`#test` may not precede `extern`") }
        if export_c_symbol != "" { return err_at(tokens, p, "an `extern` (imported) function may not carry an `exp(\"…\")` export override") }
        if !is_kind_at(tokens, p, lexer::TokenKind::Assign) {
            return err_at(tokens, p, "expected `= \"symbol\"` to bind the C symbol of an `extern` function")
        }
        p = p + 1
        if !is_kind_at(tokens, p, lexer::TokenKind::Str) {
            return err_at(tokens, p, "expected a quoted C symbol after `=` in an `extern` function")
        }
        var c_symbol = tokens[p].text
        p = p + 1
        var from_lib = ""
        if is_kind_at(tokens, p, lexer::TokenKind::Ident) && tokens[p].text == "from" {
            p = p + 1
            if !is_kind_at(tokens, p, lexer::TokenKind::Str) {
                return err_at(tokens, p, "expected a quoted library name after `from`")
            }
            from_lib = tokens[p].text
            p = p + 1
        }
        var no_body: []@Statement() = []
        return Parsed<@Decl()> { node = Function { name = name; type_params = tps.names; type_constraints = tps.constraints; params = params.items; has_return = has_return; return_type = return_type; body = no_body; vis = vis; has_doc = has_doc; doc = doc; line = name_line; col = name_col; is_test = is_test; is_extern = true; c_symbol = c_symbol; from_lib = from_lib; os_guard = os_guard; is_intern = is_intern; is_abstract = is_abstract; is_virtual = is_virtual; is_override = is_override; is_static = is_static; is_getter = false; is_setter = false; accessor_prop = ""; ret_types = []; is_operator = false; is_global = is_global }; next = p }
    }
    if (is_abstract || allow_bodyless) && !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        if ret_types.len > 0 { return err_at(tokens, p, "a bodyless (`abstract`/interface) function may not declare a multiple-return `( A, B )` signature yet") }
        var no_body: []@Statement() = []
        return Parsed<@Decl()> { node = Function { name = name; type_params = tps.names; type_constraints = tps.constraints; params = params.items; has_return = has_return; return_type = return_type; body = no_body; vis = vis; has_doc = has_doc; doc = doc; line = name_line; col = name_col; is_test = is_test; is_extern = false; c_symbol = export_c_symbol; from_lib = ""; os_guard = os_guard; is_intern = is_intern; is_abstract = is_abstract; is_virtual = is_virtual; is_override = is_override; is_static = is_static; is_getter = false; is_setter = false; accessor_prop = ""; ret_types = []; is_operator = false; is_global = is_global }; next = p }
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' for the function body")
    }
    var blk = match parse_block(tokens, p) { ParsedList<@Statement()> as x => x; error as e => return e }
    Parsed<@Decl()> { node = Function { name = name; type_params = tps.names; type_constraints = tps.constraints; params = params.items; has_return = has_return; return_type = return_type; body = blk.items; vis = vis; has_doc = has_doc; doc = doc; line = name_line; col = name_col; is_test = is_test; is_extern = false; c_symbol = export_c_symbol; from_lib = ""; os_guard = os_guard; is_intern = is_intern; is_abstract = is_abstract; is_virtual = is_virtual; is_override = is_override; is_static = is_static; is_getter = false; is_setter = false; accessor_prop = ""; ret_types = ret_types; is_operator = false; is_global = is_global }; next = blk.next }
}

fn accessor_kind_at(tokens: []lexer::Token, pos: u64): u64 {
    var k = pos
    if is_kind_at(tokens, k, lexer::TokenKind::Doc) { k = skip_seps(tokens, k + 1) }
    if is_kind_at(tokens, k, lexer::TokenKind::Pub) { k = k + 1 }
    else if is_kind_at(tokens, k, lexer::TokenKind::Exp) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Intern) { k = k + 1 }
    if !is_kind_at(tokens, k, lexer::TokenKind::Ident) { return 0 to u64 }
    var word = tokens[k].text
    if word != "get" && word != "set" { return 0 to u64 }
    if !is_name_at(tokens, k + 1) { return 0 to u64 }
    if !is_kind_at(tokens, k + 2, lexer::TokenKind::LParen) { return 0 to u64 }
    if word == "get" { return 1 to u64 }
    2 to u64
}

fn parse_accessor(tokens: []lexer::Token, pos: u64, allow_bodyless: bool): Parsed<@Decl()> | error {
    var p = pos
    var has_doc = false
    var doc = docspan_none()
    if is_kind_at(tokens, p, lexer::TokenKind::Doc) {
        has_doc = true
        doc = docspan_of(tokens[p].file, tokens[p].byte_off, tokens[p].text.len)
        p = skip_seps(tokens, p + 1)
    }
    var vis = Visibility::Private
    if is_kind_at(tokens, p, lexer::TokenKind::Pub) { vis = Visibility::Pub; p = p + 1 }
    else if is_kind_at(tokens, p, lexer::TokenKind::Exp) { vis = Visibility::Exp; p = p + 1 }
    var is_intern = false
    if is_kind_at(tokens, p, lexer::TokenKind::Intern) { is_intern = true; p = p + 1 }
    if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
        return err_at(tokens, p, "expected `get` or `set` to open a property accessor")
    }
    var word = tokens[p].text
    var is_getter = word == "get"
    var is_setter = word == "set"
    if !is_getter && !is_setter {
        return err_at(tokens, p, "expected `get` or `set` to open a property accessor")
    }
    p = p + 1
    if !is_name_at(tokens, p) {
        return err_at(tokens, p, "expected a property name after `get`/`set`")
    }
    var prop = tokens[p].text
    var name_line: u32 = tokens[p].line
    var name_col: u32 = tokens[p].col
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::LParen) {
        return err_at(tokens, p, "expected '(' for the accessor parameter list")
    }
    var params = match parse_params(tokens, p) { ParsedList<Param> as x => x; error as e => return e }
    p = params.next
    if is_getter && params.items.len != 0 {
        return err_at(tokens, p, "a getter takes no parameters — write `get " ~ prop ~ "(): T`")
    }
    if is_setter && params.items.len != 1 {
        return err_at(tokens, p, "a setter takes exactly one value parameter — write `set " ~ prop ~ "(value: T)`")
    }
    if is_setter && !params.items[0].has_type {
        return err_at(tokens, p, "a setter's value parameter must declare a type — write `set " ~ prop ~ "(value: T)`")
    }
    var injected = inject_synthetic_receiver(params.items)
    var has_return = false
    var return_type = no_type()
    if is_return_type_intro_at(tokens, p) {
        var ret = match parse_type(tokens, p + 1) { ParsedType as x => x; error as e => return e }
        has_return = true
        return_type = ret.node
        p = ret.next
    }
    if is_getter && !has_return {
        return err_at(tokens, p, "a getter must declare a return type — write `get " ~ prop ~ "(): T`")
    }
    if is_setter && has_return {
        return err_at(tokens, p, "a setter returns nothing — drop the `: T` after `set " ~ prop ~ "(value: T)`")
    }
    var sym = (if is_getter { "__get_" } else { "__set_" }) ~ prop
    var body: []@Statement() = []
    if allow_bodyless && !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return Parsed<@Decl()> { node = accessor_function(sym, injected, has_return, return_type, body, vis, has_doc, doc, name_line, name_col, is_intern, is_getter, is_setter, prop); next = p }
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' for the accessor body")
    }
    var blk = match parse_block(tokens, p) { ParsedList<@Statement()> as x => x; error as e => return e }
    Parsed<@Decl()> { node = accessor_function(sym, injected, has_return, return_type, blk.items, vis, has_doc, doc, name_line, name_col, is_intern, is_getter, is_setter, prop); next = blk.next }
}

fn accessor_function(sym: str, params: []Param, has_return: bool, return_type: @TypeExpr(), body: []@Statement(), vis: Visibility, has_doc: bool, doc: DocSpan, line: u32, col: u32, is_intern: bool, is_getter: bool, is_setter: bool, prop: str): Function {
    Function {
        name = sym; type_params = []; type_constraints = []
        params = params; has_return = has_return; return_type = return_type; body = body
        vis = vis; has_doc = has_doc; doc = doc; line = line; col = col
        is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""
        is_intern = is_intern; is_abstract = false; is_virtual = false; is_override = false; is_static = false
        is_getter = is_getter; is_setter = is_setter; accessor_prop = prop; ret_types = []
        is_operator = false
   ; is_global = false }
}

fn parse_member_fn_or_accessor(tokens: []lexer::Token, pos: u64, allow_bodyless: bool): Parsed<@Decl()> | error {
    if accessor_kind_at(tokens, pos) != 0 to u64 {
        return parse_accessor(tokens, pos, allow_bodyless)
    }
    parse_function(tokens, pos, false, "", true, allow_bodyless)
}

fn value_member_prefix_end(tokens: []lexer::Token, pos: u64): u64 {
    var k = pos
    if is_kind_at(tokens, k, lexer::TokenKind::Doc) { k = skip_seps(tokens, k + 1) }
    if is_kind_at(tokens, k, lexer::TokenKind::Pub) { k = k + 1 }
    else if is_kind_at(tokens, k, lexer::TokenKind::Exp) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Intern) { k = k + 1 }
    k
}

fn value_member_is_operator(tokens: []lexer::Token, pos: u64): bool {
    var k = value_member_prefix_end(tokens, pos)
    if !is_kind_at(tokens, k, lexer::TokenKind::Ident) { return false }
    if tokens[k].text != "operator" { return false }
    is_kind_at(tokens, k + 1, lexer::TokenKind::Ident)
}

fn parse_operator_member(tokens: []lexer::Token, pos: u64, allow_bodyless: bool): Parsed<Function> | error {
    var p = pos
    var has_doc = false
    var doc = docspan_none()
    if is_kind_at(tokens, p, lexer::TokenKind::Doc) {
        has_doc = true
        doc = docspan_of(tokens[p].file, tokens[p].byte_off, tokens[p].text.len)
        p = skip_seps(tokens, p + 1)
    }
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
        return err_at(tokens, p, "expected a dunder operator name (`__add`, `__eq`, `__index`, …) after `operator`")
    }
    var name = tokens[p].text
    var name_line: u32 = tokens[p].line
    var name_col: u32 = tokens[p].col
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::LParen) {
        return err_at(tokens, p, "expected '(' for the operator's operand list")
    }
    var params = match parse_params(tokens, p) { ParsedList<Param> as x => x; error as e => return e }
    p = params.next
    var has_return = false
    var return_type = no_type()
    if is_return_type_intro_at(tokens, p) {
        var ret = match parse_type(tokens, p + 1) { ParsedType as x => x; error as e => return e }
        has_return = true
        return_type = ret.node
        p = ret.next
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        if allow_bodyless {
            return Parsed<Function> { node = Function { name = name; type_params = []; type_constraints = []; params = params.items; has_return = has_return; return_type = return_type; body = []; vis = Visibility::Pub; has_doc = has_doc; doc = doc; line = name_line; col = name_col; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""; is_intern = false; is_abstract = false; is_virtual = false; is_override = false; is_static = true; is_getter = false; is_setter = false; accessor_prop = ""; ret_types = []; is_operator = true; is_global = false }; next = p }
        }
        return err_at(tokens, p, "expected '{' for the operator body")
    }
    var blk = match parse_block(tokens, p) { ParsedList<@Statement()> as x => x; error as e => return e }
    Parsed<Function> { node = Function { name = name; type_params = []; type_constraints = []; params = params.items; has_return = has_return; return_type = return_type; body = blk.items; vis = Visibility::Pub; has_doc = has_doc; doc = doc; line = name_line; col = name_col; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""; is_intern = false; is_abstract = false; is_virtual = false; is_override = false; is_static = true; is_getter = false; is_setter = false; accessor_prop = ""; ret_types = []; is_operator = true; is_global = false }; next = blk.next }
}

fn parse_value_type_members(tokens: []lexer::Token, pos: u64): ParsedStructBody | error {
    var p = skip_seps(tokens, pos + 1)
    var methods: []Function = []
    var consts: []ConstDecl = []
    if is_kind_at(tokens, p, lexer::TokenKind::RBrace) {
        return ParsedStructBody { fields = []; methods = methods; consts = consts; next = p + 1 }
    }
    loop {
        if value_member_is_operator(tokens, p) {
            var op = match parse_operator_member(tokens, p, false) { Parsed<Function> as x => x; error as e => return e }
            methods = [..methods, op.node]
            p = op.next
        } else {
            var fdoc = peel_leading_doc(tokens, p)
            var mcs = match try_parse_member_const(tokens, fdoc.next, fdoc.has_doc, fdoc.doc, consts) { MemberConstStep as x => x; error as e => return e }
            if mcs.handled {
                consts = mcs.consts
                p = mcs.next
            } else {
                var k = value_member_prefix_end(tokens, p)
                if is_kind_at(tokens, k, lexer::TokenKind::Static) {
                    return err_at(tokens, k, "a value-type body may not declare a `static` method — write a separate free function instead")
                }
                if is_name_at(tokens, k) && is_kind_at(tokens, k + 1, lexer::TokenKind::Colon) {
                    return err_at(tokens, k, "a value-type body may not declare fields")
                }
                if !is_kind_at(tokens, k, lexer::TokenKind::Fn) {
                    return err_at(tokens, k, "a value-type body may contain only readonly methods (`fn …`), `operator …`, and `const` declarations")
                }
                var m = match parse_function(tokens, p, false, "", true, false) { Parsed<@Decl()> as x => x; error as e => return e }
                var mf = match m.node { Function as f => f; _ => return err_at(tokens, p, "internal: a value-type method must parse to a Function") }
                methods = [..methods, mf]
                p = m.next
            }
        }
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
        if !is_sep(tokens, p) {
            return err_at(tokens, p, "expected ';', a newline, or '}' after a value-type member")
        }
        p = skip_seps(tokens, p)
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
    }
    ParsedStructBody { fields = []; methods = methods; consts = consts; next = p + 1 }
}

fn struct_item_is_method(tokens: []lexer::Token, pos: u64): bool {
    var k = pos
    if is_kind_at(tokens, k, lexer::TokenKind::Doc) { k = skip_seps(tokens, k + 1) }
    if is_kind_at(tokens, k, lexer::TokenKind::Pub) { k = k + 1 }
    else if is_kind_at(tokens, k, lexer::TokenKind::Exp) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Global) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Static) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Fn) { return true }
    accessor_kind_at(tokens, pos) != 0 to u64
}
fn skip_field_inline_attr(tokens: []lexer::Token, pos: u64): u64 | error {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Hash) { return pos }
    if !is_kind_at(tokens, pos + 1, lexer::TokenKind::Ident) || tokens[pos + 1].text != "inline" {
        return err_at(tokens, pos + 1, "the only field attribute is `#inline`")
    }
    skip_seps(tokens, pos + 2)
}

fn parse_readonly_marker(tokens: []lexer::Token, pos: u64): ReadonlyMarker {
    if is_kind_at(tokens, pos, lexer::TokenKind::Ident) && tokens[pos].text == "readonly" {
        return ReadonlyMarker { present = true; next = pos + 1 }
    }
    ReadonlyMarker { present = false; next = pos }
}

fn parse_fields(tokens: []lexer::Token, pos: u64): ParsedStructBody | error {
    var p = skip_seps(tokens, pos + 1)
    var fields: []Field = []
    var methods: []Function = []
    var consts: []ConstDecl = []
    if is_kind_at(tokens, p, lexer::TokenKind::RBrace) {
        return ParsedStructBody { fields = fields; methods = methods; consts = consts; next = p + 1 }
    }
    loop {
        if value_member_is_operator(tokens, p) {
            var op = match parse_operator_member(tokens, p, false) { Parsed<Function> as x => x; error as e => return e }
            methods = [..methods, op.node]
            p = op.next
        } else if struct_item_is_method(tokens, p) {
            var m = match parse_member_fn_or_accessor(tokens, p, false) { Parsed<@Decl()> as x => x; error as e => return e }
            var mf = match m.node { Function as f => f; _ => return err_at(tokens, p, "internal: a struct method must parse to a Function") }
            methods = [..methods, mf]
            p = m.next
        } else {
            var fdoc = peel_leading_doc(tokens, p)
            var mcs = match try_parse_member_const(tokens, fdoc.next, fdoc.has_doc, fdoc.doc, consts) { MemberConstStep as x => x; error as e => return e }
            if mcs.handled {
                consts = mcs.consts
                p = mcs.next
            } else {
                var iattr = match skip_field_inline_attr(tokens, fdoc.next) { u64 as x => x; error as e => return e }
                var ro = parse_readonly_marker(tokens, iattr)
                var fstart = ro.next
                if !is_name_at(tokens, fstart) {
                    return err_at(tokens, fstart, "expected a field name, a method (`fn …`), or a `const` member")
                }
                var name = tokens[fstart].text
                if !is_kind_at(tokens, fstart + 1, lexer::TokenKind::Colon) {
                    return err_at(tokens, fstart + 1, "expected ':' after a field name")
                }
                var ty = match parse_type(tokens, fstart + 2) { ParsedType as x => x; error as e => return e }
                fields = [..fields, Field { name = name; type_ann = ty.node; vis = Visibility::Pub; is_intern = false; has_doc = fdoc.has_doc; doc = fdoc.doc; is_readonly = ro.present }]
                p = ty.next
            }
        }
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
        if !is_sep(tokens, p) {
            return err_at(tokens, p, "expected ';', a newline, or '}' after a struct member")
        }
        p = skip_seps(tokens, p)
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
    }
    ParsedStructBody { fields = fields; methods = methods; consts = consts; next = p + 1 }
}

fn class_item_is_method(tokens: []lexer::Token, pos: u64): bool {
    var k = pos
    if is_kind_at(tokens, k, lexer::TokenKind::Doc) { k = skip_seps(tokens, k + 1) }
    if is_kind_at(tokens, k, lexer::TokenKind::Pub) { k = k + 1 }
    else if is_kind_at(tokens, k, lexer::TokenKind::Exp) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Global) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Intern) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Abstract) { k = k + 1 }
    else if is_kind_at(tokens, k, lexer::TokenKind::Virtual) { k = k + 1 }
    else if is_kind_at(tokens, k, lexer::TokenKind::Override) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Static) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Fn) { return true }
    accessor_kind_at(tokens, pos) != 0 to u64
}

fn parse_class_fields(tokens: []lexer::Token, pos: u64): ParsedStructBody | error {
    var p = skip_seps(tokens, pos + 1)
    var fields: []Field = []
    var methods: []Function = []
    var consts: []ConstDecl = []
    if is_kind_at(tokens, p, lexer::TokenKind::RBrace) {
        return ParsedStructBody { fields = fields; methods = methods; consts = consts; next = p + 1 }
    }
    loop {
        if value_member_is_operator(tokens, p) {
            var op = match parse_operator_member(tokens, p, false) { Parsed<Function> as x => x; error as e => return e }
            methods = [..methods, op.node]
            p = op.next
        } else if class_item_is_method(tokens, p) {
            var m = match parse_member_fn_or_accessor(tokens, p, false) { Parsed<@Decl()> as x => x; error as e => return e }
            var mf = match m.node { Function as f => f; _ => return err_at(tokens, p, "internal: a class method must parse to a Function") }
            methods = [..methods, mf]
            p = m.next
        } else {
            var fdoc = peel_leading_doc(tokens, p)
            var mcs = match try_parse_member_const(tokens, fdoc.next, fdoc.has_doc, fdoc.doc, consts) { MemberConstStep as x => x; error as e => return e }
            if mcs.handled {
                consts = mcs.consts
                p = mcs.next
            } else {
                var fp = match skip_field_inline_attr(tokens, fdoc.next) { u64 as x => x; error as e => return e }
                var fvis = Visibility::Private
                if is_kind_at(tokens, fp, lexer::TokenKind::Pub) { fvis = Visibility::Pub; fp = fp + 1 }
                else if is_kind_at(tokens, fp, lexer::TokenKind::Exp) { fvis = Visibility::Exp; fp = fp + 1 }
                var fintern = false
                if is_kind_at(tokens, fp, lexer::TokenKind::Intern) { fintern = true; fp = fp + 1 }
                if !is_name_at(tokens, fp) {
                    return err_at(tokens, fp, "expected a field name, a method (`fn …`), or a `const` member")
                }
                var name = tokens[fp].text
                if !is_kind_at(tokens, fp + 1, lexer::TokenKind::Colon) {
                    return err_at(tokens, fp + 1, "expected ':' after a field name")
                }
                var ty = match parse_type(tokens, fp + 2) { ParsedType as x => x; error as e => return e }
                fields = [..fields, Field { name = name; type_ann = ty.node; vis = fvis; is_intern = fintern; has_doc = fdoc.has_doc; doc = fdoc.doc; is_readonly = false }]
                p = ty.next
            }
        }
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
        if !is_sep(tokens, p) {
            return err_at(tokens, p, "expected ';', a newline, or '}' after a class member")
        }
        p = skip_seps(tokens, p)
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
    }
    ParsedStructBody { fields = fields; methods = methods; consts = consts; next = p + 1 }
}

fn parse_class_body(tokens: []lexer::Token, pos: u64): Parsed<@TypeBody()> | error {
    var p = pos
    var kind = ClassKind::Sealed
    if is_kind_at(tokens, p, lexer::TokenKind::Abstract) { kind = ClassKind::Abstract; p = p + 1 }
    else if is_kind_at(tokens, p, lexer::TokenKind::Virtual) { kind = ClassKind::Virtual; p = p + 1 }
    if is_kind_at(tokens, p, lexer::TokenKind::Service) {
        return err_at(tokens, p, "a service is always sealed; write 'type N = service <lifetime> { … }' (no 'virtual'/'abstract')")
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::Class) {
        return err_at(tokens, p, "expected `class`")
    }
    p = p + 1
    var has_base = false
    var base_name = ""
    var has_base_binding = false
    var base_binding_name = ""
    if is_name_at(tokens, p) {
        has_base = true
        base_name = tokens[p].text
        p = p + 1
        if is_kind_at(tokens, p, lexer::TokenKind::LParen) {
            return err_at(tokens, p, "super is accessed via `base`, not a named binding — write `class Base { … }`, not `class Base(name)`")
        }
    }
    var implements: []str = []
    loop {
        if !is_kind_at(tokens, p, lexer::TokenKind::Amp) { break }
        if !is_name_at(tokens, p + 1) {
            return err_at(tokens, p + 1, "expected an interface name after '&'")
        }
        implements = [..implements, tokens[p + 1].text]
        p = p + 2
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' for the class body")
    }
    var fs = match parse_class_fields(tokens, p) { ParsedStructBody as x => x; error as e => return e }
    Parsed<@TypeBody()> { node = ClassBody {
            kind = kind; has_base = has_base; base_name = base_name
            has_base_binding = has_base_binding; base_binding_name = base_binding_name
            implements = implements; fields = fs.fields; methods = fs.methods; consts = fs.consts
            is_service = false; service_lifetime = ServiceLifetime::Singleton
        }; next = fs.next }
}

fn parse_service_lifetime(tokens: []lexer::Token, pos: u64): Parsed<ServiceLifetime> | error {
    if is_name_at(tokens, pos) && tokens[pos].text == "singleton" {
        return Parsed<ServiceLifetime> { node = ServiceLifetime::Singleton; next = pos + 1 }
    }
    if is_name_at(tokens, pos) && tokens[pos].text == "scoped" {
        return Parsed<ServiceLifetime> { node = ServiceLifetime::Scoped; next = pos + 1 }
    }
    if is_name_at(tokens, pos) && tokens[pos].text == "transient" {
        return Parsed<ServiceLifetime> { node = ServiceLifetime::Transient; next = pos + 1 }
    }
    err_at(tokens, pos, "expected a service lifetime `singleton`/`scoped`/`transient` after `service`")
}

fn parse_service_body(tokens: []lexer::Token, pos: u64): Parsed<@TypeBody()> | error {
    var lt = match parse_service_lifetime(tokens, pos + 1) { Parsed<ServiceLifetime> as x => x; error as e => return e }
    var p = lt.next
    var implements: []str = []
    loop {
        if !is_kind_at(tokens, p, lexer::TokenKind::Amp) { break }
        if !is_name_at(tokens, p + 1) {
            return err_at(tokens, p + 1, "expected an interface name after '&'")
        }
        implements = [..implements, tokens[p + 1].text]
        p = p + 2
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' for the service body")
    }
    var fs = match parse_class_fields(tokens, p) { ParsedStructBody as x => x; error as e => return e }
    Parsed<@TypeBody()> { node = ClassBody {
            kind = ClassKind::Sealed; has_base = false; base_name = ""
            has_base_binding = false; base_binding_name = ""
            implements = implements; fields = fs.fields; methods = fs.methods; consts = fs.consts
            is_service = true; service_lifetime = lt.node
        }; next = fs.next }
}

fn parse_amp_name_list(tokens: []lexer::Token, pos: u64): ParsedList<str> | error {
    var p = pos
    var names: []str = []
    if is_name_at(tokens, p) {
        names = [..names, tokens[p].text]
        p = p + 1
        loop {
            if !is_kind_at(tokens, p, lexer::TokenKind::Amp) { break }
            if !is_name_at(tokens, p + 1) { return err_at(tokens, p + 1, "expected an interface name after '&'") }
            names = [..names, tokens[p + 1].text]
            p = p + 2
        }
    }
    ParsedList<str> { items = names; next = p }
}

fn parse_interface_body(tokens: []lexer::Token, pos: u64): Parsed<@TypeBody()> | error {
    var ext_start = pos + 1
    if is_kind_at(tokens, ext_start, lexer::TokenKind::Amp) { ext_start = ext_start + 1 }
    var ext = match parse_amp_name_list(tokens, ext_start) { ParsedList<str> as x => x; error as e => return e }
    var p = ext.next
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' for the interface body")
    }
    p = skip_seps(tokens, p + 1)
    var methods: []Function = []
    if is_kind_at(tokens, p, lexer::TokenKind::RBrace) {
        return Parsed<@TypeBody()> { node = InterfaceBody { extends = ext.items; methods = methods }; next = p + 1 }
    }
    loop {
        if value_member_is_operator(tokens, p) {
            var op = match parse_operator_member(tokens, p, true) { Parsed<Function> as x => x; error as e => return e }
            methods = [..methods, op.node]
            p = op.next
        } else {
            var idoc = peel_leading_doc(tokens, p)
            var imc = peek_member_const(tokens, idoc.next)
            if imc.is_const || imc.bad_override { return reject_const_member(tokens, imc.kw_pos) }
            var m = match parse_member_fn_or_accessor(tokens, p, true) { Parsed<@Decl()> as x => x; error as e => return e }
            var mf = match m.node { Function as f => f; _ => return err_at(tokens, p, "an interface member must be a method signature (`fn …`)") }
            methods = [..methods, mf]
            p = m.next
        }
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
        if !is_sep(tokens, p) { return err_at(tokens, p, "expected ';', a newline, or '}' after an interface method") }
        p = skip_seps(tokens, p)
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
    }
    Parsed<@TypeBody()> { node = InterfaceBody { extends = ext.items; methods = methods }; next = p + 1 }
}

fn parse_trait_composition(tokens: []lexer::Token, pos: u64): ParsedList<str> | error {
    var p = pos
    var names: []str = []
    loop {
        if !is_kind_at(tokens, p, lexer::TokenKind::Amp) { break }
        if !is_name_at(tokens, p + 1) { return err_at(tokens, p + 1, "expected a trait or interface name after '&'") }
        names = [..names, tokens[p + 1].text]
        p = p + 2
    }
    ParsedList<str> { items = names; next = p }
}

fn parse_trait_members(tokens: []lexer::Token, pos: u64): ParsedStructBody | error {
    var p = skip_seps(tokens, pos + 1)
    var fields: []Field = []
    var methods: []Function = []
    var consts: []ConstDecl = []
    if is_kind_at(tokens, p, lexer::TokenKind::RBrace) {
        return ParsedStructBody { fields = fields; methods = methods; consts = consts; next = p + 1 }
    }
    loop {
        if value_member_is_operator(tokens, p) {
            var op = match parse_operator_member(tokens, p, false) { Parsed<Function> as x => x; error as e => return e }
            methods = [..methods, op.node]
            p = op.next
        } else if struct_item_is_method(tokens, p) {
            var m = match parse_member_fn_or_accessor(tokens, p, true) { Parsed<@Decl()> as x => x; error as e => return e }
            var mf = match m.node { Function as f => f; _ => return err_at(tokens, p, "internal: a trait method must parse to a Function") }
            if mf.body.len == 0 {
                return err_at(tokens, p, "a trait method must have a body — a bodyless member belongs on an interface")
            }
            methods = [..methods, mf]
            p = m.next
        } else {
            var fdoc = peel_leading_doc(tokens, p)
            var mcs = match try_parse_member_const(tokens, fdoc.next, fdoc.has_doc, fdoc.doc, consts) { MemberConstStep as x => x; error as e => return e }
            if mcs.handled {
                consts = mcs.consts
                p = mcs.next
            } else {
                if !is_name_at(tokens, fdoc.next) {
                    return err_at(tokens, fdoc.next, "expected a field name, a method (`fn …`), or a `const` member in the trait body")
                }
                var name = tokens[fdoc.next].text
                if !is_kind_at(tokens, fdoc.next + 1, lexer::TokenKind::Colon) {
                    return err_at(tokens, fdoc.next + 1, "expected ':' after a field name")
                }
                var ty = match parse_type(tokens, fdoc.next + 2) { ParsedType as x => x; error as e => return e }
                fields = [..fields, Field { name = name; type_ann = ty.node; vis = Visibility::Pub; is_intern = false; has_doc = fdoc.has_doc; doc = fdoc.doc; is_readonly = false }]
                p = ty.next
            }
        }
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
        if !is_sep(tokens, p) {
            return err_at(tokens, p, "expected ';', a newline, or '}' after a trait member")
        }
        p = skip_seps(tokens, p)
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
    }
    ParsedStructBody { fields = fields; methods = methods; consts = consts; next = p + 1 }
}

fn freeze_all_fields(fields: []Field): []Field {
    var out: []Field = []
    var i = 0 to u64
    loop {
        if i >= fields.len { break }
        var f = fields[i]
        out = [..out, Field { name = f.name; type_ann = f.type_ann; vis = f.vis; is_intern = f.is_intern; has_doc = f.has_doc; doc = f.doc; is_readonly = true }]
        i++
    }
    out
}

fn is_readonly_struct_head(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Ident) && tokens[pos].text == "readonly" && is_kind_at(tokens, pos + 1, lexer::TokenKind::Struct)
}

fn parse_struct_body(tokens: []lexer::Token, pos: u64, is_readonly: bool): Parsed<@TypeBody()> | error {
    var impls = match parse_amp_name_list(tokens, pos + 1) { ParsedList<str> as x => x; error as e => return e }
    if !is_kind_at(tokens, impls.next, lexer::TokenKind::LBrace) {
        return err_at(tokens, impls.next, "expected '{' after `struct` (or its interface list)")
    }
    var fs = match parse_fields(tokens, impls.next) { ParsedStructBody as x => x; error as e => return e }
    var flds = fs.fields
    if is_readonly { flds = freeze_all_fields(fs.fields) }
    Parsed<@TypeBody()> { node = StructBody { fields = flds; methods = fs.methods; implements = impls.items; consts = fs.consts; is_readonly = is_readonly }; next = fs.next }
}

fn is_trait_decl_head(tokens: []lexer::Token, pos: u64): bool {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Ident) { return false }
    if tokens[pos].text != "trait" { return false }
    is_kind_at(tokens, pos + 1, lexer::TokenKind::LBrace) || is_kind_at(tokens, pos + 1, lexer::TokenKind::Amp)
}

fn parse_type_body(tokens: []lexer::Token, pos: u64): Parsed<@TypeBody()> | error {
    if is_kind_at(tokens, pos, lexer::TokenKind::Class) || is_kind_at(tokens, pos, lexer::TokenKind::Abstract) || is_kind_at(tokens, pos, lexer::TokenKind::Virtual) {
        return parse_class_body(tokens, pos)
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Interface) {
        return parse_interface_body(tokens, pos)
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Service) {
        return parse_service_body(tokens, pos)
    }
    if is_trait_decl_head(tokens, pos) {
        var impls = match parse_trait_composition(tokens, pos + 1) { ParsedList<str> as x => x; error as e => return e }
        if !is_kind_at(tokens, impls.next, lexer::TokenKind::LBrace) {
            return err_at(tokens, impls.next, "expected '{' after `trait` (or its `& …` composition list)")
        }
        var fs = match parse_trait_members(tokens, impls.next) { ParsedStructBody as x => x; error as e => return e }
        return Parsed<@TypeBody()> { node = TraitBody { fields = fs.fields; methods = fs.methods; consts = fs.consts; implements = impls.items }; next = fs.next }
    }
    if is_readonly_struct_head(tokens, pos) {
        return parse_struct_body(tokens, pos + 1, true)
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Struct) {
        return parse_struct_body(tokens, pos, false)
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Enum) {
        if !is_kind_at(tokens, pos + 1, lexer::TokenKind::LBrace) {
            return err_at(tokens, pos + 1, "expected '{' after `enum`")
        }
        match reject_const_body_member(tokens, pos + 1) { error as e => return e; null => { } }
        var ms = match parse_field_names(tokens, pos + 1) { ParsedList<str> as x => x; error as e => return e }
        if is_kind_at(tokens, ms.next, lexer::TokenKind::LBrace) {
            var mb = match parse_value_type_members(tokens, ms.next) { ParsedStructBody as x => x; error as e => return e }
            return Parsed<@TypeBody()> { node = EnumBody { members = ms.items; methods = mb.methods; consts = mb.consts }; next = mb.next }
        }
        return Parsed<@TypeBody()> { node = EnumBody { members = ms.items; methods = []; consts = [] }; next = ms.next }
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Flags) {
        if !is_kind_at(tokens, pos + 1, lexer::TokenKind::LBrace) {
            return err_at(tokens, pos + 1, "expected '{' after `flags`")
        }
        match reject_const_body_member(tokens, pos + 1) { error as e => return e; null => { } }
        var ms = match parse_field_names(tokens, pos + 1) { ParsedList<str> as x => x; error as e => return e }
        if is_kind_at(tokens, ms.next, lexer::TokenKind::LBrace) {
            var mb = match parse_value_type_members(tokens, ms.next) { ParsedStructBody as x => x; error as e => return e }
            return Parsed<@TypeBody()> { node = FlagsBody { members = ms.items; values = []; methods = mb.methods; consts = mb.consts }; next = mb.next }
        }
        return Parsed<@TypeBody()> { node = FlagsBody { members = ms.items; values = []; methods = []; consts = [] }; next = ms.next }
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Variant) {
        var ty = match parse_type(tokens, pos + 1) { ParsedType as x => x; error as e => return e }
        return Parsed<@TypeBody()> { node = VariantBody { type_expr = ty.node }; next = ty.next }
    }
    var al = match parse_type(tokens, pos) { ParsedType as x => x; error as e => return e }
    if is_kind_at(tokens, al.next, lexer::TokenKind::LBrace) {
        var mb = match parse_value_type_members(tokens, al.next) { ParsedStructBody as x => x; error as e => return e }
        return Parsed<@TypeBody()> { node = NewtypeBody { backing = al.node; methods = mb.methods; consts = mb.consts }; next = mb.next }
    }
    Parsed<@TypeBody()> { node = AliasBody { alias = al.node }; next = al.next }
}

fn parse_flags_decl(tokens: []lexer::Token, pos: u64): Parsed<@Decl()> | error {
    var p = pos
    var has_doc = false
    var doc = docspan_none()
    if is_kind_at(tokens, p, lexer::TokenKind::Doc) {
        has_doc = true
        doc = docspan_of(tokens[p].file, tokens[p].byte_off, tokens[p].text.len)
        p = skip_seps(tokens, p + 1)
    }
    var vis = Visibility::Private
    if is_kind_at(tokens, p, lexer::TokenKind::Pub) {
        vis = Visibility::Pub
        p = p + 1
    } else if is_kind_at(tokens, p, lexer::TokenKind::Exp) {
        vis = Visibility::Exp
        p = p + 1
    }
    var global_mod = consume_global_modifier(tokens, p)
    var is_global = global_mod.node
    p = global_mod.next
    if !is_kind_at(tokens, p, lexer::TokenKind::Flags) {
        return err_at(tokens, p, "expected `flags`")
    }
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
        return err_at(tokens, p, "expected a type name after `flags`")
    }
    var name = tokens[p].text
    var name_line: u32 = tokens[p].line
    var name_col: u32 = tokens[p].col
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' after the flags type name")
    }
    var ms = match parse_field_names(tokens, p) { ParsedList<str> as x => x; error as e => return e }
    var methods: []Function = []
    var consts: []ConstDecl = []
    var body_next = ms.next
    if is_kind_at(tokens, ms.next, lexer::TokenKind::LBrace) {
        var mb = match parse_value_type_members(tokens, ms.next) { ParsedStructBody as x => x; error as e => return e }
        methods = mb.methods
        consts = mb.consts
        body_next = mb.next
    }
    Parsed<@Decl()> { node = TypeDecl { name = name; type_params = []; type_constraints = []; body = FlagsBody { members = ms.items; values = []; methods = methods; consts = consts }; vis = vis; has_doc = has_doc; doc = doc; line = name_line; col = name_col; is_global = is_global }; next = body_next }
}

fn parse_extern_type_body(tokens: []lexer::Token, pos: u64): Parsed<@TypeBody()> | error {
    var p = pos
    if !is_kind_at(tokens, p, lexer::TokenKind::Assign) {
        return Parsed<@TypeBody()> { node = ExternBody { }; next = p }
    }
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Struct) {
        return err_at(tokens, p, "an `extern type` is either opaque (`extern type Name`) or a C-ABI struct (`extern type Name = struct { … }`)")
    }
    if !is_kind_at(tokens, p + 1, lexer::TokenKind::LBrace) {
        return err_at(tokens, p + 1, "expected '{' after `struct` in an `extern type`")
    }
    var fs = match parse_fields(tokens, p + 1) { ParsedStructBody as x => x; error as e => return e }
    if fs.methods.len > 0 || fs.consts.len > 0 {
        return err_at(tokens, p, "an extern struct declares only fields (no methods, consts, or interfaces)")
    }
    var q = fs.next
    var c_tag = ""
    if is_kind_at(tokens, q, lexer::TokenKind::Ident) && tokens[q].text == "from" {
        q = q + 1
        if !is_kind_at(tokens, q, lexer::TokenKind::Str) {
            return err_at(tokens, q, "expected a quoted C struct tag after `from`")
        }
        c_tag = tokens[q].text
        q = q + 1
    }
    Parsed<@TypeBody()> { node = ExternStructBody { fields = fs.fields; c_tag = c_tag }; next = q }
}

fn parse_type_decl(tokens: []lexer::Token, pos: u64): Parsed<@Decl()> | error {
    var p = pos
    var has_doc = false
    var doc = docspan_none()
    if is_kind_at(tokens, p, lexer::TokenKind::Doc) {
        has_doc = true
        doc = docspan_of(tokens[p].file, tokens[p].byte_off, tokens[p].text.len)
        p = skip_seps(tokens, p + 1)
    }
    var vis = Visibility::Private
    if is_kind_at(tokens, p, lexer::TokenKind::Pub) {
        vis = Visibility::Pub
        p = p + 1
    } else if is_kind_at(tokens, p, lexer::TokenKind::Exp) {
        vis = Visibility::Exp
        p = p + 1
    }
    var global_mod = consume_global_modifier(tokens, p)
    var is_global = global_mod.node
    p = global_mod.next
    var is_extern = false
    if is_kind_at(tokens, p, lexer::TokenKind::Extern) {
        is_extern = true
        p = p + 1
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::Type) {
        return err_at(tokens, p, "expected `type`")
    }
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
        return err_at(tokens, p, "expected a type name")
    }
    var name = tokens[p].text
    if is_reserved_type_name(name) {
        return err_at(tokens, p, "`Ref` is a reserved type name — it is the compiler-internal safe reference the `ref` keyword desugars to, so no user type may take it (write `ref T` in a type position, `ref x: T` to bind)")
    }
    var name_line: u32 = tokens[p].line
    var name_col: u32 = tokens[p].col
    p = p + 1
    var tps = match parse_type_params(tokens, p) { ParsedTypeParams as x => x; error as e => return e }
    p = tps.next
    if is_extern {
        var eb = match parse_extern_type_body(tokens, p) { Parsed<@TypeBody()> as x => x; error as e => return e }
        return Parsed<@Decl()> { node = TypeDecl { name = name; type_params = tps.names; type_constraints = tps.constraints; body = eb.node; vis = vis; has_doc = has_doc; doc = doc; line = name_line; col = name_col; is_global = is_global }; next = eb.next }
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::Assign) {
        return err_at(tokens, p, "expected '=' in a type declaration")
    }
    var body = match parse_type_body(tokens, p + 1) { Parsed<@TypeBody()> as x => x; error as e => return e }
    Parsed<@Decl()> { node = TypeDecl { name = name; type_params = tps.names; type_constraints = tps.constraints; body = body.node; vis = vis; has_doc = has_doc; doc = doc; line = name_line; col = name_col; is_global = is_global }; next = body.next }
}


fn parse_decl_attributes(tokens: []lexer::Token, pos: u64): ParsedAttributes | error {
    var start = pos
    var is_test = false
    var os_guard = ""
    var guard = pred_true()
    loop {
        if !is_kind_at(tokens, start, lexer::TokenKind::Hash) { break }
        if !is_kind_at(tokens, start + 1, lexer::TokenKind::Ident) {
            return err_at(tokens, start + 1, "expected an attribute name after `#`")
        }
        var attr = tokens[start + 1].text
        if attr == "test" {
            is_test = true
            start = skip_seps(tokens, start + 2)
        } else if attr == "os" {
            if !is_kind_at(tokens, start + 2, lexer::TokenKind::LParen) { return err_at(tokens, start + 2, "expected '(' after `#os`") }
            if !is_kind_at(tokens, start + 3, lexer::TokenKind::Str) { return err_at(tokens, start + 3, "expected a quoted OS name in `#os(\"…\")`") }
            match cc_axis_value_diag("os", tokens[start + 3].text, tokens[start + 3].line, tokens[start + 3].col) { error as e => return e; null => { } }
            os_guard = tokens[start + 3].text
            if !is_kind_at(tokens, start + 4, lexer::TokenKind::RParen) { return err_at(tokens, start + 4, "expected ')' to close `#os(…)`") }
            guard = attr_guard_and(guard, pred_os(tokens[start + 3].text))
            start = skip_seps(tokens, start + 5)
        } else if attr == "arch" {
            if !is_kind_at(tokens, start + 2, lexer::TokenKind::LParen) { return err_at(tokens, start + 2, "expected '(' after `#arch`") }
            if !is_kind_at(tokens, start + 3, lexer::TokenKind::Str) { return err_at(tokens, start + 3, "expected a quoted arch name in `#arch(\"…\")`") }
            match cc_axis_value_diag("arch", tokens[start + 3].text, tokens[start + 3].line, tokens[start + 3].col) { error as e => return e; null => { } }
            if !is_kind_at(tokens, start + 4, lexer::TokenKind::RParen) { return err_at(tokens, start + 4, "expected ')' to close `#arch(…)`") }
            guard = attr_guard_and(guard, pred_arch(tokens[start + 3].text))
            start = skip_seps(tokens, start + 5)
        } else if attr == "inline" {
            return err_at(tokens, start + 1, "`#inline` attaches to a local binding (`#inline var …`) or a struct field (`#inline name: T`), not a declaration")
        } else {
            return err_at(tokens, start + 1, "unknown attribute (only `#test`, `#os(\"…\")`, `#arch(\"…\")`, and the binding/field `#inline` are recognized)")
        }
    }
    ParsedAttributes { is_test = is_test; os_guard = os_guard; guard = guard; next = start }
}

fn attr_guard_and(acc: Pred, add: Pred): Pred {
    match acc.kind {
        PTrue => add
        _ => pred_and(acc, add)
    }
}

fn peel_leading_doc(tokens: []lexer::Token, pos: u64): ParsedLeadingDoc {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Doc) {
        return ParsedLeadingDoc { has_doc = false; doc = docspan_none(); next = pos }
    }
    ParsedLeadingDoc { has_doc = true; doc = docspan_of(tokens[pos].file, tokens[pos].byte_off, tokens[pos].text.len); next = skip_seps(tokens, pos + 1) }
}

fn with_outer_doc(node: @Decl(), has_doc: bool, doc: DocSpan): @Decl() {
    if !has_doc { return node }
    match node {
        Function as f => Function { name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; has_return = f.has_return; return_type = f.return_type; body = f.body; vis = f.vis; has_doc = true; doc = doc; line = f.line; col = f.col; is_test = f.is_test; is_extern = f.is_extern; c_symbol = f.c_symbol; from_lib = f.from_lib; os_guard = f.os_guard; is_intern = f.is_intern; is_abstract = f.is_abstract; is_virtual = f.is_virtual; is_override = f.is_override; is_static = f.is_static; is_getter = f.is_getter; is_setter = f.is_setter; accessor_prop = f.accessor_prop; ret_types = f.ret_types; is_operator = f.is_operator; is_global = f.is_global }
        TypeDecl as td => TypeDecl { name = td.name; type_params = td.type_params; type_constraints = td.type_constraints; body = td.body; vis = td.vis; has_doc = true; doc = doc; line = td.line; col = td.col; is_global = td.is_global }
        ConstDecl as cd => ConstDecl { name = cd.name; ty = cd.ty; init = cd.init; vis = cd.vis; has_doc = true; doc = doc; line = cd.line; col = cd.col; is_global = cd.is_global }
        _ => node
    }
}

fn parse_macro_params(tokens: []lexer::Token, pos: u64): ParsedList<Param> | error {
    var p = pos + 1
    var params: []Param = []
    if is_kind_at(tokens, p, lexer::TokenKind::RParen) {
        return ParsedList<Param> { items = params; next = p + 1 }
    }
    loop {
        var is_pack = is_kind_at(tokens, p, lexer::TokenKind::Ident) && tokens[p].text == "params" && is_name_at(tokens, p + 1)
        if is_pack { p = p + 1 }
        if !is_name_at(tokens, p) {
            return err_at(tokens, p, "expected a macro parameter name")
        }
        var name = tokens[p].text
        p = p + 1
        var has_type = false
        var type_ann = no_type()
        if is_kind_at(tokens, p, lexer::TokenKind::Colon) {
            var pt = match parse_type(tokens, p + 1) { ParsedType as x => x; error as e => return e }
            has_type = true
            type_ann = pt.node
            p = pt.next
        }
        var has_default = false
        var default_expr = no_expr()
        if is_kind_at(tokens, p, lexer::TokenKind::Assign) {
            var de = match parse_expr(tokens, p + 1) { Parsed<Expr> as x => x; error as e => return e }
            has_default = true
            default_expr = de.node
            p = de.next
        }
        params = [..params, Param { name = name; has_type = has_type; type_ann = type_ann; is_params = is_pack; has_default = has_default; default_expr = default_expr }]
        if is_pack && is_kind_at(tokens, p, lexer::TokenKind::Comma) {
            return err_at(tokens, p, "a `params` pack must be the last macro parameter")
        }
        if !is_kind_at(tokens, p, lexer::TokenKind::Comma) { break }
        p = p + 1
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::RParen) {
        return err_at(tokens, p, "expected ')' to close the macro parameter list")
    }
    ParsedList<Param> { items = params; next = p + 1 }
}

fn parse_macro_decl(tokens: []lexer::Token, pos: u64, vis: Visibility): Parsed<@Decl()> | error {
    var p = pos + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
        return err_at(tokens, p, "expected a macro name after `macro`")
    }
    var name = tokens[p].text
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::LParen) {
        return err_at(tokens, p, "expected '(' for the macro's parameter list")
    }
    var params = match parse_macro_params(tokens, p) { ParsedList<Param> as x => x; error as e => return e }
    p = params.next
    if is_return_type_intro_at(tokens, p) {
        return err_at(tokens, p, "a `macro` has no return type — use `comptime` for a value")
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' for the macro body")
    }
    var blk = match parse_block(tokens, p) { ParsedList<@Statement()> as x => x; error as e => return e }
    Parsed<@Decl()> { node = MacroDecl { name = name; params = params.items; body = blk.items; vis = vis }; next = blk.next }
}

fn parse_comptime_decl(tokens: []lexer::Token, pos: u64, vis: Visibility, is_global: bool): Parsed<@Decl()> | error {
    var p = pos + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
        return err_at(tokens, p, "expected a comptime name after `comptime`")
    }
    var name = tokens[p].text
    p = p + 1
    var tps = match parse_type_params(tokens, p) { ParsedTypeParams as x => x; error as e => return e }
    p = tps.next
    if !is_kind_at(tokens, p, lexer::TokenKind::LParen) {
        return err_at(tokens, p, "expected '(' for the comptime's parameter list")
    }
    var params = match parse_params(tokens, p) { ParsedList<Param> as x => x; error as e => return e }
    p = params.next
    if !is_return_type_intro_at(tokens, p) {
        return err_at(tokens, p, "a `comptime` must declare a return type")
    }
    var ret = match parse_type(tokens, p + 1) { ParsedType as x => x; error as e => return e }
    p = ret.next
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' for the comptime body")
    }
    var blk = match parse_block(tokens, p) { ParsedList<@Statement()> as x => x; error as e => return e }
    Parsed<@Decl()> { node = ComptimeDecl { name = name; type_params = tps.names; params = params.items; ret = ret.node; body = blk.items; vis = vis; is_global = is_global }; next = blk.next }
}

fn parse_const_decl(tokens: []lexer::Token, start: u64, vis: Visibility, is_global: bool): Parsed<@Decl()> | error {
    var kw_line: u32 = tokens[start].line
    var kw_col: u32 = tokens[start].col
    var p = start + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
        return err_at(tokens, p, "expected a constant name after `const`")
    }
    var name = tokens[p].text
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Colon) {
        return err_at(tokens, p, "expected ':' and a type — a module-level `const` must declare its type")
    }
    var ty = match parse_type(tokens, p + 1) { ParsedType as x => x; error as e => return e }
    p = ty.next
    if !is_kind_at(tokens, p, lexer::TokenKind::Assign) {
        return err_at(tokens, p, "expected `=` and an initializer for a `const`")
    }
    var init = match parse_expr(tokens, p + 1) { Parsed<Expr> as x => x; error as e => return e }
    var cd = ConstDecl { name = name; ty = ty.node; init = init.node; vis = vis; has_doc = false; doc = docspan_none(); line = kw_line; col = kw_col; is_global = is_global }
    Parsed<@Decl()> { node = cd; next = init.next }
}

type MemberConstPeek = struct { is_const: bool; vis: Visibility; kw_pos: u64; bad_override: bool }

fn peek_member_const(tokens: []lexer::Token, pos: u64): MemberConstPeek {
    var k = pos
    var vis = Visibility::Private
    if is_kind_at(tokens, k, lexer::TokenKind::Pub) { vis = Visibility::Pub; k = k + 1 }
    else if is_kind_at(tokens, k, lexer::TokenKind::Exp) { vis = Visibility::Exp; k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Override) && is_kind_at(tokens, k + 1, lexer::TokenKind::Const) {
        return MemberConstPeek { is_const = false; vis = vis; kw_pos = k; bad_override = true }
    }
    if is_kind_at(tokens, k, lexer::TokenKind::Const) {
        return MemberConstPeek { is_const = true; vis = vis; kw_pos = k; bad_override = false }
    }
    MemberConstPeek { is_const = false; vis = vis; kw_pos = k; bad_override = false }
}

type MemberConstStep = struct { handled: bool; consts: []ConstDecl; next: u64 }

fn try_parse_member_const(tokens: []lexer::Token, pos: u64, has_doc: bool, doc: DocSpan, consts: []ConstDecl): MemberConstStep | error {
    var mc = peek_member_const(tokens, pos)
    if mc.bad_override { return err_at(tokens, mc.kw_pos, "a `const` member may not carry `override` — `override` is method-only") }
    if mc.is_const {
        var cd = match parse_type_member_const(tokens, mc.kw_pos, mc.vis, has_doc, doc) { Parsed<ConstDecl> as x => x; error as e => return e }
        return MemberConstStep { handled = true; consts = [..consts, cd.node]; next = cd.next }
    }
    MemberConstStep { handled = false; consts = consts; next = pos }
}

fn reject_const_member(tokens: []lexer::Token, pos: u64): error {
    err_at(tokens, pos, "a `const` member is only allowed in a struct, class, or trait body")
}

fn reject_const_body_member(tokens: []lexer::Token, brace_pos: u64): error | null {
    var fp = skip_seps(tokens, brace_pos + 1)
    if is_kind_at(tokens, fp, lexer::TokenKind::Const) { return reject_const_member(tokens, fp) }
    null
}

fn parse_type_member_const(tokens: []lexer::Token, pos: u64, vis: Visibility, has_doc: bool, doc: DocSpan): Parsed<ConstDecl> | error {
    var d = match parse_const_decl(tokens, pos, vis, false) { Parsed<@Decl()> as x => x; error as e => return e }
    var parsed_const = match d.node { ConstDecl as c => c; _ => return err_at(tokens, pos, "internal: a member const must parse to a ConstDecl") }
    var cd = ConstDecl { name = parsed_const.name; ty = parsed_const.ty; init = parsed_const.init; vis = parsed_const.vis; has_doc = has_doc; doc = doc; line = parsed_const.line; col = parsed_const.col; is_global = parsed_const.is_global }
    Parsed<ConstDecl> { node = cd; next = d.next }
}

fn embed_compression_atom(name: str): teko::embed::EmbedCompress | error {
    if name == "None" { return teko::embed::EmbedCompress::None }
    if name == "Deflate" { return teko::embed::EmbedCompress::Deflate }
    if name == "Gzip" { return teko::embed::EmbedCompress::Gzip }
    error { message = "#embed compression type must be one of None, Deflate, Gzip" }
}

/**
 * parse_embed — parse a top-level `#embed(...)` at `pos` (the `#`), mirroring the `#os("…")` payload
 * shape. Accepts form A `("pattern")` and form B `("pattern", TYPE, LEVEL)` (TYPE a bare None/Deflate/
 * Gzip atom, LEVEL an Int). Purely syntactic — path/range validity are resolve-time concerns. Stamps the
 * containing source-file path for later file-relative anchoring.
 *
 * @param tokens  the token stream
 * @param pos     the index of the `#` beginning the directive
 * @return        the parsed EmbedDecl and the index past the closing `)`
 * @throws        a located error on a missing `(`, a non-string pattern, a malformed `, TYPE, LEVEL`
 *                tail, or an unknown compression type
 * @since 0.3.1
 */
fn parse_embed(tokens: []lexer::Token, pos: u64): Parsed<@Decl()> | error {
    var line = tokens[pos].line
    var col = tokens[pos].col
    var src_path = tokens[pos].file
    if !is_kind_at(tokens, pos + 2, lexer::TokenKind::LParen) { return err_at(tokens, pos + 2, "expected '(' after `#embed`") }
    if !is_kind_at(tokens, pos + 3, lexer::TokenKind::Str) { return err_at(tokens, pos + 3, "expected a quoted pattern in `#embed(\"…\")`") }
    var pattern = tokens[pos + 3].text
    if is_kind_at(tokens, pos + 4, lexer::TokenKind::RParen) {
        var node = EmbedDecl { pattern = pattern; has_compression = false; comp = teko::embed::EmbedCompress::None; level = 0; src_path = src_path; line = line; col = col }
        return Parsed<@Decl()> { node = node; next = pos + 5 }
    }
    if !is_kind_at(tokens, pos + 4, lexer::TokenKind::Comma) { return err_at(tokens, pos + 4, "expected ',' or ')' after the `#embed` pattern") }
    if !is_name_at(tokens, pos + 5) { return err_at(tokens, pos + 5, "expected a compression type (None, Deflate, Gzip) after the `#embed` pattern") }
    var comp = match embed_compression_atom(tokens[pos + 5].text) { teko::embed::EmbedCompress as c => c; error as e => return err_at(tokens, pos + 5, e.message) }
    if !is_kind_at(tokens, pos + 6, lexer::TokenKind::Comma) { return err_at(tokens, pos + 6, "expected ',' then a compression level in `#embed(\"…\", TYPE, LEVEL)`") }
    if !is_kind_at(tokens, pos + 7, lexer::TokenKind::Number) { return err_at(tokens, pos + 7, "expected an integer compression level in `#embed(\"…\", TYPE, LEVEL)`") }
    var lv = match lit_int(tokens[pos + 7].text) { NumInt as v => v; error as e => return err_at(tokens, pos + 7, e.message) }
    if lv.neg { return err_at(tokens, pos + 7, "the `#embed` compression level must not be negative") }
    if !is_kind_at(tokens, pos + 8, lexer::TokenKind::RParen) { return err_at(tokens, pos + 8, "expected ')' to close `#embed(…)`") }
    var noded = EmbedDecl { pattern = pattern; has_compression = true; comp = comp; level = numint_to_i64(lv); src_path = src_path; line = line; col = col }
    Parsed<@Decl()> { node = noded; next = pos + 9 }
}

fn is_embed_directive_at(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Hash) && is_kind_at(tokens, pos + 1, lexer::TokenKind::Ident) && tokens[pos + 1].text == "embed"
}

fn parse_decl(tokens: []lexer::Token, pos: u64): ParsedDecl | error {
    if is_embed_directive_at(tokens, pos) {
        var ed = match parse_embed(tokens, pos) { Parsed<@Decl()> as x => x; error as e => return e }
        return ParsedDecl { node = ed.node; guard = pred_true(); next = ed.next }
    }
    var outer_doc = peel_leading_doc(tokens, pos)
    var attrs = match parse_decl_attributes(tokens, outer_doc.next) { ParsedAttributes as x => x; error as e => return e }
    var start = attrs.next
    var k = start
    if is_kind_at(tokens, k, lexer::TokenKind::Doc) { k = skip_seps(tokens, k + 1) }
    var vis = Visibility::Private
    if is_kind_at(tokens, k, lexer::TokenKind::Pub) {
        vis = Visibility::Pub
        k = k + 1
    } else if is_kind_at(tokens, k, lexer::TokenKind::Exp) {
        vis = Visibility::Exp
        k = skip_export_override_peek(tokens, k + 1)
    }
    var global_peek = consume_global_modifier(tokens, k)
    var is_global = global_peek.node
    k = global_peek.next
    if is_global && is_variable_binding_head(tokens, k) {
        return err_at(tokens, k, "`global` is not allowed on a variable — only on a namespace-level fn, type, or const")
    }
    var saw_extern = false
    if is_kind_at(tokens, k, lexer::TokenKind::Extern) {
        saw_extern = true
        k = k + 1
    }
    if is_kind_at(tokens, k, lexer::TokenKind::Fn) {
        var d = match parse_fn_decl_with_attrs(tokens, start, attrs) { Parsed<@Decl()> as x => x; error as e => return e }
        return ParsedDecl { node = with_outer_doc(d.node, outer_doc.has_doc, outer_doc.doc); guard = attrs.guard; next = d.next }
    }
    if is_kind_at(tokens, k, lexer::TokenKind::Type) {
        var d = match parse_type_decl_with_attrs(tokens, start, k, attrs) { Parsed<@Decl()> as x => x; error as e => return e }
        return ParsedDecl { node = with_outer_doc(d.node, outer_doc.has_doc, outer_doc.doc); guard = attrs.guard; next = d.next }
    }
    if is_kind_at(tokens, k, lexer::TokenKind::Flags) {
        var d = match parse_flags_decl_with_attrs(tokens, start, k, attrs) { Parsed<@Decl()> as x => x; error as e => return e }
        return ParsedDecl { node = with_outer_doc(d.node, outer_doc.has_doc, outer_doc.doc); guard = attrs.guard; next = d.next }
    }
    if is_kind_at(tokens, k, lexer::TokenKind::Const) {
        if saw_extern { return err_at(tokens, k, "expected `fn` or `type` after `extern`") }
        match reject_fn_only_attrs_on_type(tokens, k, attrs) { error as e => return e; null => { } }
        var d = match parse_const_decl(tokens, k, vis, is_global) { Parsed<@Decl()> as x => x; error as e => return e }
        return ParsedDecl { node = with_outer_doc(d.node, outer_doc.has_doc, outer_doc.doc); guard = attrs.guard; next = d.next }
    }
    if is_kind_at(tokens, k, lexer::TokenKind::Macro) {
        if saw_extern { return err_at(tokens, k, "there is no `extern macro` — a macro is native-only") }
        if is_global { return err_at(tokens, k, "`global` is not allowed on a macro — only on a fn, type, const, or comptime") }
        var d = match parse_macro_decl(tokens, k, vis) { Parsed<@Decl()> as x => x; error as e => return e }
        return ParsedDecl { node = with_outer_doc(d.node, outer_doc.has_doc, outer_doc.doc); guard = attrs.guard; next = d.next }
    }
    if is_kind_at(tokens, k, lexer::TokenKind::Comptime) {
        if saw_extern { return err_at(tokens, k, "there is no `extern comptime` — a comptime is native-only") }
        var d = match parse_comptime_decl(tokens, k, vis, is_global) { Parsed<@Decl()> as x => x; error as e => return e }
        return ParsedDecl { node = with_outer_doc(d.node, outer_doc.has_doc, outer_doc.doc); guard = attrs.guard; next = d.next }
    }
    if saw_extern {
        return err_at(tokens, k, "expected `fn` or `type` after `extern`")
    }
    err_at(tokens, k, "expected a declaration (`fn`/`type`/`flags`, optionally `pub`/`exp`/doc); loose statements belong in main.tks")
}

fn parse_fn_decl_with_attrs(tokens: []lexer::Token, start: u64, attrs: ParsedAttributes): Parsed<@Decl()> | error {
    parse_function(tokens, start, attrs.is_test, attrs.os_guard, false, false)
}

fn parse_type_decl_with_attrs(tokens: []lexer::Token, start: u64, k: u64, attrs: ParsedAttributes): Parsed<@Decl()> | error {
    match reject_fn_only_attrs_on_type(tokens, k, attrs) { error as e => return e; null => { } }
    parse_type_decl(tokens, start)
}

fn parse_flags_decl_with_attrs(tokens: []lexer::Token, start: u64, k: u64, attrs: ParsedAttributes): Parsed<@Decl()> | error {
    match reject_fn_only_attrs_on_type(tokens, k, attrs) { error as e => return e; null => { } }
    parse_flags_decl(tokens, start)
}

fn reject_fn_only_attrs_on_type(tokens: []lexer::Token, k: u64, attrs: ParsedAttributes): error | null {
    if attrs.is_test { return err_at(tokens, k, "`#test` may only precede a function") }
    null
}


fn is_decl_head_token(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Hash) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Pub) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Exp) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Global) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Extern) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Fn) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Type) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Flags) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Const) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Macro) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Comptime)
}

fn doc_classifies(tokens: []lexer::Token, docpos: u64): bool {
    if !is_kind_at(tokens, docpos, lexer::TokenKind::Doc) { return false }
    var p = docpos + 1
    if is_kind_at(tokens, p, lexer::TokenKind::Semicolon) { return false }
    if is_kind_at(tokens, p, lexer::TokenKind::Newline) {
        p = p + 1
        if is_sep(tokens, p) { return false }
    }
    is_decl_head_token(tokens, p)
}

fn skip_trivia(tokens: []lexer::Token, pos: u64): u64 {
    var p = pos
    loop {
        if is_sep(tokens, p) { p = p + 1; continue }
        if is_kind_at(tokens, p, lexer::TokenKind::Doc) && !doc_classifies(tokens, p) { p = p + 1; continue }
        break
    }
    p
}

fn is_cc_region_marker_at(tokens: []lexer::Token, pos: u64): bool {
    is_cc_if_start(tokens, pos) ||
    is_cc_marker(tokens, pos, "elseif") ||
    is_cc_marker(tokens, pos, "endif") ||
    is_cc_else(tokens, pos)
}

fn is_core_decl_keyword_at(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Fn) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Type) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Flags) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Const) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Macro) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Comptime) ||
    is_embed_directive_at(tokens, pos)
}

fn count_module_decls(tokens: []lexer::Token, start: u64): u64 {
    var p = start
    var depth: u64 = 0
    var pending = true
    var count: u64 = 0
    loop {
        if !has_token(tokens, p) { break }
        var k = tokens[p].kind
        if k == lexer::TokenKind::LParen || k == lexer::TokenKind::LBrace || k == lexer::TokenKind::LBracket {
            depth = depth + 1
            p = p + 1
            continue
        }
        if k == lexer::TokenKind::RParen || k == lexer::TokenKind::RBrace || k == lexer::TokenKind::RBracket {
            if depth > 0 { depth = depth - 1 }
            p = p + 1
            continue
        }
        if depth != 0 { p = p + 1; continue }
        if k == lexer::TokenKind::Semicolon || k == lexer::TokenKind::Newline {
            pending = true
            p = p + 1
            continue
        }
        if k == lexer::TokenKind::Hash && is_cc_region_marker_at(tokens, p) {
            pending = true
            p = p + 1
            continue
        }
        if pending && is_core_decl_keyword_at(tokens, p) {
            count = count + 1
            pending = false
        }
        p = p + 1
    }
    count
}

pub fn parse_module(tokens: []lexer::Token, pos: u64): Parsed<Module> | error {
    var hdr = match parse_use_header(tokens, pos) { ParsedList<UseDecl> as x => x; error as e => return e }
    var p = skip_trivia(tokens, hdr.next)
    var ndecls = count_module_decls(tokens, p)
    var decls: [ndecls]@Decl() = []
    var decl_guards: [ndecls]Pred = []
    var count: u64 = 0
    loop {
        if !has_token(tokens, p) { break }
        if is_cc_if_start(tokens, p) {
            var region = match parse_cc_region(tokens, p, pred_true()) { ParsedRegion as x => x; error as e => return e }
            var r: u64 = 0
            loop {
                if r >= region.decls.len { break }
                decls[count] = region.decls[r]
                decl_guards[count] = region.guards[r]
                count++
                r++
            }
            p = region.next
            if !has_token(tokens, p) { break }
            if !is_sep(tokens, p) {
                return err_at(tokens, p, "expected ';' or a newline after a `#endif`")
            }
            p = skip_trivia(tokens, p)
            continue
        }
        var d = match parse_decl(tokens, p) { ParsedDecl as x => x; error as e => return e }
        decls[count] = d.node
        decl_guards[count] = d.guard
        count++
        p = d.next
        if !has_token(tokens, p) { break }
        if !is_sep(tokens, p) {
            return err_at(tokens, p, "expected ';' or a newline after a declaration")
        }
        p = skip_trivia(tokens, p)
    }
    if count == ndecls {
        return Parsed<Module> { node = Module { uses = hdr.items; decls = decls; decl_guards = decl_guards }; next = p }
    }
    var out_decls: [count]@Decl() = []
    var out_guards: [count]Pred = []
    var t: u64 = 0
    loop {
        if t >= count { break }
        out_decls[t] = decls[t]
        out_guards[t] = decl_guards[t]
        t++
    }
    Parsed<Module> { node = Module { uses = hdr.items; decls = out_decls; decl_guards = out_guards }; next = p }
}
