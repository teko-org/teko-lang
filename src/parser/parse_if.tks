

use teko::lexer

fn parse_if_body(tokens: []lexer::Token, pos: u64, ctx: str): ParsedList<@Statement()> | error {
    if is_kind_at(tokens, pos, lexer::TokenKind::LBrace) {
        var blk = match parse_block(tokens, pos) { ParsedList<@Statement()> as x => x; error as e => return e }
        return blk
    }
    if !is_sep(tokens, pos) {
        return err_at(tokens, pos, ctx)
    }
    var p = skip_seps(tokens, pos)
    var s = match parse_statement(tokens, p) { Parsed<@Statement()> as x => x; error as e => return e }
    var one = [s.node]
    ParsedList<@Statement()> { items = one; next = s.next }
}

fn parse_if(tokens: []lexer::Token, pos: u64): Parsed<Expr> | error {
    var cond = match parse_expr_no_struct(tokens, pos + 1) { Parsed<Expr> as x => x; error as e => return e }
    var then_blk = match parse_if_body(tokens, cond.next, "expected '{' or a newline after the `if` condition") { ParsedList<@Statement()> as x => x; error as e => return e }
    var then_next = then_blk.next

    var q = skip_seps(tokens, then_next)
    if !is_kind_at(tokens, q, lexer::TokenKind::Else) {
        return Parsed<Expr> { node = Expr { kind = IfExpr { cond = cond.node; then_blk = then_blk.items; has_else = false; else_blk = [] }; line = tokens[pos].line; col = tokens[pos].col }; next = then_next }
    }
    if is_kind_at(tokens, q + 1, lexer::TokenKind::If) {
        var elif = match parse_if(tokens, q + 1) { Parsed<Expr> as x => x; error as e => return e }
        var eb: []@Statement() = [ExprStmt { expr = elif.node }]
        return Parsed<Expr> { node = Expr { kind = IfExpr { cond = cond.node; then_blk = then_blk.items; has_else = true; else_blk = eb }; line = tokens[pos].line; col = tokens[pos].col }; next = elif.next }
    }
    var else_blk = match parse_if_body(tokens, q + 1, "expected '{', `if`, or a newline after `else`") { ParsedList<@Statement()> as x => x; error as e => return e }
    Parsed<Expr> { node = Expr { kind = IfExpr { cond = cond.node; then_blk = then_blk.items; has_else = true; else_blk = else_blk.items }; line = tokens[pos].line; col = tokens[pos].col }; next = else_blk.next }
}
