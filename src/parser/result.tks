type Parsed<T> = struct { node: T; next: u64 }
type ParsedList<T> = struct { items: []T; next: u64 }

type ParsedType = struct { node: @TypeExpr(); next: u64; pending_gt: u64 }
type ParsedTypeArgs = struct { args: []@TypeExpr(); next: u64; pending_gt: u64 }
type ParsedConstraintTerm = struct { node: @ConstraintExpr(); next: u64; pending_gt: u64 }
type ParsedTypeParams = struct { names: []str; constraints: []@ConstraintExpr(); next: u64 }
type Guard = struct { has_when: bool; guard: Expr; next: u64 }
type Annotation = struct { has_type: bool; type_ann: @TypeExpr(); next: u64 }
type ParsedCallArgs = struct { args: []Expr; arg_names: []str; next: u64 }
type ParsedStructBody = struct { fields: []Field; methods: []Function; consts: []ConstDecl; next: u64 }

type ReadonlyMarker = struct { present: bool; next: u64 }

type ParsedAttributes = struct { is_test: bool; os_guard: str; guard: Pred; next: u64 }

type ParsedDecl = struct { node: @Decl(); guard: Pred; next: u64 }

type ParsedLeadingDoc = struct { has_doc: bool; doc: DocSpan; next: u64 }
