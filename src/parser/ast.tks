
use teko::lexer

pub type NumInt = struct { neg: bool; mag: u64 }

pub fn numint_of_u64(m: u64): NumInt { NumInt { neg = false; mag = m } }

pub fn numint_of_i64(v: i64): NumInt {
    if v >= 0 { return numint_of_u64(v to u64) }
    NumInt { neg = true; mag = ((0 - (v + 1)) to u64) + 1 }
}

pub fn numint_negate(v: NumInt): NumInt {
    if v.mag == 0 { v } else { NumInt { neg = !v.neg; mag = v.mag } }
}

pub fn numint_is_zero(v: NumInt): bool { v.mag == 0 }

const U64_ALL_ONES: u64 = 0xFFFFFFFFFFFFFFFF

const I64_SIGN_BIT_U: u64 = 9223372036854775808

const I64_MIN: i64 = -9223372036854775807 - 1

pub fn numint_to_i64(v: NumInt): i64 {
    i64_of_u64_bits(numint_bits(v))
}

fn numint_bits(v: NumInt): u64 {
    if !v.neg { return v.mag }
    if v.mag == 0 { return 0 }
    (U64_ALL_ONES - v.mag) + 1
}

fn i64_of_u64_bits(bits: u64): i64 {
    if bits < I64_SIGN_BIT_U { return bits to i64 }
    ((bits - I64_SIGN_BIT_U) to i64) + I64_MIN
}

pub type Number = struct { is_float: bool; value: NumInt; fval: f64 }
pub type Var = struct { name: str }
pub type StrLit = struct { text: str }
pub type ByteStrLit = struct { text: str }
pub type ByteLit = struct { value: byte }
pub type CharLit = struct { bytes: str }
pub type BoolLit = struct { value: bool }
pub type NullLit = struct { }
pub type Binary = struct { op: lexer::TokenKind; left: Expr; right: Expr }
pub type Unary = struct { op: lexer::TokenKind; operand: Expr }
pub type CmpTerm = struct { op: lexer::TokenKind; operand: Expr }
pub type Compare = struct { first: Expr; rest: []CmpTerm }
pub type Call = struct { callee: Path; args: []Expr; arg_names: []str; owner_type_args: []@TypeExpr(); callee_type_args: []@TypeExpr() }

pub type MacroCall = struct { callee: Path; args: []Expr; callee_type_args: []@TypeExpr() }
pub type IfExpr = struct {
    cond: Expr
    then_blk: []@Statement()
    has_else: bool
    else_blk: []@Statement()
}
pub type MatchExpr = struct { subject: Expr; arms: []Arm }

pub type FieldAccess = struct { receiver: Expr; field: str }
pub type MethodCall = struct {
    receiver: Expr
    method: str
    args: []Expr
    arg_names: []str
    type_args: []@TypeExpr()
}
pub type Cast = struct { expr: Expr; target: @TypeExpr() }
pub type Borrow = struct { operand: Expr }
pub type PathExpr = struct { path: Path }
pub type StructLit = struct { type_path: Path; type_args: []@TypeExpr(); field_names: []str; field_vals: []Expr }
pub type Index = struct { receiver: Expr; index: Expr }
pub type FSpecNone = struct { }
pub type FSpecStatic = struct { s: str }
pub type FSpecDynamic = struct { args: []Expr }
pub type FSpec = struct { kind: FSpecNone | FSpecStatic | FSpecDynamic }
pub type Interp = struct { pieces: []str; holes: []Expr; specs: []FSpec }
pub type InExpr = struct { lhs: Expr; elems: []Expr }
pub type ArrayElem = struct { is_spread: bool; expr: Expr }
pub type ArrayLit = struct { elements: []ArrayElem }
pub type LambdaParam = struct { name: str; has_type: bool; type_ann: @TypeExpr() }
pub type Lambda = struct { params: []LambdaParam; body: []@Statement() }

pub type Block = struct { body: []@Statement() }

macro ExprKind() { lowering { parser::Number | parser::Var | parser::Call | parser::IfExpr | parser::MatchExpr | parser::StrLit | parser::ByteStrLit | parser::ByteLit | parser::CharLit | parser::BoolLit | parser::NullLit | parser::Binary | parser::Unary | parser::Compare | parser::FieldAccess | parser::MethodCall | parser::Cast | parser::PathExpr | parser::StructLit | parser::Index | parser::Interp | parser::InExpr | parser::ArrayLit | parser::Lambda | parser::Borrow | parser::Block | parser::MacroCall } }
pub type Expr = struct { kind: @ExprKind(); line: u32; col: u32 }

pub type BindKind = enum { Var; Const }
pub type SimpleName = struct { name: str }
pub type DestructurePattern = struct { names: []str }
macro BindTarget(local: bool = false) {
    if local { lowering { SimpleName | DestructurePattern } }
    else     { lowering { parser::SimpleName | parser::DestructurePattern } }
}

pub type Binding = struct {
    kind: BindKind
    target: @BindTarget()
    has_type: bool
    type_ann: @TypeExpr()
    is_ref: bool
    value: Expr
}
pub type AssignKind = enum { Simple; RefDeref; Field; Index }
pub type Assign = struct { kind: AssignKind; name: str; op: lexer::TokenKind; value: Expr; deref: bool; target: Expr }

pub fn assign_has_target(kind: AssignKind): bool {
    match kind {
        AssignKind::Field => true
        AssignKind::Index => true
        _ => false
    }
}
pub type Return = struct { has_value: bool; value: Expr; values: []Expr }
pub type LoopStmt = struct { label: str; init: []@Statement(); body: []@Statement() }
pub type BreakStmt = struct { label: str }
pub type ContinueStmt = struct { label: str }
pub type ExprStmt = struct { expr: Expr }
pub type DeferStmt = struct { body: []@Statement() }

pub type AdoptStmt = struct { name: str; body: []@Statement() }

pub type Spawn = struct { call: Expr }

pub type BlockStmt = struct { body: []@Statement() }

pub type BindName = struct { name: str }
pub type BindSkip = struct { }
pub type BindRest = struct { }
macro BindElem(local: bool = false) {
    if local { lowering { BindName | BindSkip | BindRest } }
    else     { lowering { parser::BindName | parser::BindSkip | parser::BindRest } }
}

pub type MultiTargetKind = enum { Parallel; ArrayDecomp }

pub type MultiBind = struct {
    kind: BindKind
    shape: MultiTargetKind
    targets: []@BindElem()
    has_type: bool
    type_ann: @TypeExpr()
    values: []Expr
    line: u32
    col: u32
}

pub type LoweringFrag = struct { tokens: []lexer::Token }

macro Statement() { lowering { parser::Binding | parser::Assign | parser::Return | parser::LoopStmt | parser::BreakStmt | parser::ContinueStmt | parser::ExprStmt | parser::DeferStmt | parser::AdoptStmt | parser::BlockStmt | parser::MultiBind | parser::LoweringFrag | parser::Spawn } }

pub type ConstraintAtom = struct { name: str }
pub type ConstraintAnd = struct { left: @ConstraintExpr(); right: @ConstraintExpr() }
pub type ConstraintOr = struct { left: @ConstraintExpr(); right: @ConstraintExpr() }
pub type NoConstraint = struct { }
pub type ConstraintNotNull = struct { }
pub type ConstraintForm = struct { form: str; has_lifetime: bool; lifetime: ServiceLifetime }
pub type ConstraintType = struct { ty: @TypeExpr() }
macro ConstraintExpr() { lowering { parser::ConstraintAtom | parser::ConstraintForm | parser::ConstraintNotNull | parser::ConstraintAnd | parser::ConstraintOr | parser::ConstraintType | parser::NoConstraint } }

pub type Param = struct { name: str; has_type: bool; type_ann: @TypeExpr(); is_params: bool; has_default: bool; default_expr: Expr }

/** A declaration's reach: `Private` (own namespace) < `Pub` (cross-namespace) < `Exp` (exported ABI). */
exp type Visibility = enum { Private; Pub; Exp }

pub type Function = struct {
    name: str
    type_params: []str
    type_constraints: []@ConstraintExpr()
    params: []Param
    has_return: bool
    return_type: @TypeExpr()
    body: []@Statement()
    vis: Visibility
    has_doc: bool
    doc: DocSpan
    line: u32
    col: u32
    is_test: bool
    is_extern: bool
    c_symbol: str
    from_lib: str
    os_guard: str
    is_intern: bool
    is_abstract: bool
    is_virtual: bool
    is_override: bool
    is_static: bool
    is_getter: bool
    is_setter: bool
    accessor_prop: str
    ret_types: []@TypeExpr()
    is_operator: bool
    is_global: bool
}
pub type StructBody = struct { fields: []Field; methods: []Function; implements: []str; consts: []ConstDecl; is_readonly: bool }
pub type Field = struct { name: str; type_ann: @TypeExpr(); vis: Visibility; is_intern: bool; has_doc: bool; doc: DocSpan; is_readonly: bool }
pub type EnumBody = struct { members: []str; methods: []Function; consts: []ConstDecl }
pub type FlagsBody = struct { members: []str; values: []u64; methods: []Function; consts: []ConstDecl }
pub type VariantBody = struct { type_expr: @TypeExpr() }
pub type AliasBody = struct { alias: @TypeExpr() }
pub type NewtypeBody = struct { backing: @TypeExpr(); methods: []Function; consts: []ConstDecl }
pub type ExternBody = struct { }
pub type ExternStructBody = struct { fields: []Field; c_tag: str }
pub type ClassKind = enum { Sealed; Abstract; Virtual }
pub type ServiceLifetime = enum { Singleton; Scoped; Transient }
pub type ClassBody = struct {
    kind: ClassKind
    has_base: bool
    base_name: str
    has_base_binding: bool
    base_binding_name: str
    implements: []str
    fields: []Field
    methods: []Function
    consts: []ConstDecl
    is_service: bool
    service_lifetime: ServiceLifetime
}
pub type InterfaceBody = struct { extends: []str; methods: []Function }
pub type TraitBody = struct { fields: []Field; methods: []Function; consts: []ConstDecl; implements: []str }
macro TypeBody() { lowering { parser::StructBody | parser::EnumBody | parser::FlagsBody | parser::VariantBody | parser::AliasBody | parser::NewtypeBody | parser::ExternBody | parser::ExternStructBody | parser::ClassBody | parser::InterfaceBody | parser::TraitBody } }
pub type TypeDecl = struct {
    name: str
    type_params: []str
    type_constraints: []@ConstraintExpr()
    body: @TypeBody()
    vis: Visibility
    has_doc: bool
    doc: DocSpan
    line: u32
    col: u32
    is_global: bool
}
pub type UseDecl = struct {
    path: Path
    has_alias: bool
    alias: str
    names: []str
}

pub type ConstDecl = struct { name: str; ty: @TypeExpr(); init: Expr; vis: Visibility; has_doc: bool; doc: DocSpan; line: u32; col: u32; is_global: bool }

pub type MacroDecl = struct { name: str; params: []Param; body: []@Statement(); vis: Visibility }

pub type ComptimeDecl = struct { name: str; type_params: []str; params: []Param; ret: @TypeExpr(); body: []@Statement(); vis: Visibility; is_global: bool }

pub type EmbedDecl = struct { pattern: str; has_compression: bool; comp: teko::embed::EmbedCompress; level: i64; src_path: str; line: u32; col: u32 }

macro Decl() { lowering { parser::Function | parser::TypeDecl | parser::ConstDecl | parser::MacroDecl | parser::ComptimeDecl | parser::EmbedDecl } }
pub type MainFile = struct { uses: []UseDecl; body: []@Statement() }
pub type Module = struct { uses: []UseDecl; decls: []@Decl(); decl_guards: []Pred }

macro ItemKind() { lowering { UseDecl | @Statement() | Function | TypeDecl | ConstDecl | MacroDecl | ComptimeDecl } }

pub type Item = struct { content: @ItemKind(); namespace: str; file: str; guard: Pred }
pub type Program = struct { items: []Item }

macro PredKind() { lowering { parser::PTrue | parser::PEq | parser::PFlag | parser::PNot | parser::PAnd | parser::POr } }

pub type PTrue = struct { }

pub type PEq = struct {
    axis: str
    value: str
}

pub type PFlag = struct {
    name: str
}

pub type PNot = struct {
    inner: Pred
}

pub type PAnd = struct {
    left: Pred
    right: Pred
}

pub type POr = struct {
    left: Pred
    right: Pred
}

pub type Pred = struct {
    kind: @PredKind()
}

pub fn pred_true(): Pred {
    Pred { kind = PTrue { } }
}

pub fn pred_os(value: str): Pred {
    Pred { kind = PEq { axis = "os"; value = value } }
}

pub fn pred_arch(value: str): Pred {
    Pred { kind = PEq { axis = "arch"; value = value } }
}

pub fn pred_and(a: Pred, b: Pred): Pred {
    Pred { kind = PAnd { left = a; right = b } }
}

pub fn pred_or(a: Pred, b: Pred): Pred {
    Pred { kind = POr { left = a; right = b } }
}

pub fn pred_not(a: Pred): Pred {
    Pred { kind = PNot { inner = a } }
}
