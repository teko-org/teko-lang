
use teko::lexer

fn parse_group_bind_pattern(tokens: []lexer::Token, pos: u64): Parsed<@Pattern()> | error {
    var opts: []@Pattern() = []
    var first = match parse_pattern_primary(tokens, pos + 1) { Parsed<@Pattern()> as x => x; error as e => return e }
    opts = [..opts, first.node]
    var gp = first.next
    loop {
        if !is_kind_at(tokens, gp, lexer::TokenKind::Pipe) { break }
        var opt = match parse_pattern_primary(tokens, gp + 1) { Parsed<@Pattern()> as x => x; error as e => return e }
        opts = [..opts, opt.node]
        gp = opt.next
    }
    if !is_kind_at(tokens, gp, lexer::TokenKind::RParen) {
        return err_at(tokens, gp, "expected ')' to close a grouped bind pattern '(B | C) as v'")
    }
    gp = gp + 1
    if !is_kind_at(tokens, gp, lexer::TokenKind::As) {
        return err_at(tokens, gp, "a parenthesized group must bind: write '(B | C) as v'")
    }
    if !is_name_at(tokens, gp + 1) {
        return err_at(tokens, gp + 1, "expected a name after `as` in a grouped bind pattern '(B | C) as v'")
    }
    Parsed<@Pattern()> { node = GroupBindPattern { options = opts; binding = tokens[gp + 1].text }; next = gp + 2 }
}

fn parse_pattern_primary(tokens: []lexer::Token, pos: u64): Parsed<@Pattern()> | error {
    if !has_token(tokens, pos) { return err_at(tokens, pos, "expected a pattern") }
    var k = kind_at(tokens, pos)
    if k == lexer::TokenKind::Underscore {
        if is_kind_at(tokens, pos + 1, lexer::TokenKind::As) {
            if is_kind_at(tokens, pos + 2, lexer::TokenKind::Underscore) {
                return Parsed<@Pattern()> { node = WildcardPattern { }; next = pos + 3 }
            }
            return err_at(tokens, pos, "`_` is a discard and cannot be bound to a name (`_ as x`) — use `_ as _` to discard, or name the case/type being matched")
        }
        return Parsed<@Pattern()> { node = WildcardPattern { }; next = pos + 1 }
    }
    if k == lexer::TokenKind::Null {
        return Parsed<@Pattern()> { node = NullPattern { }; next = pos + 1 }
    }
    if k == lexer::TokenKind::Number {
        var txt = tokens[pos].text
        var num = if lit_is_float(txt) { Number { is_float = true; value = numint_of_u64(0); fval = lit_float(txt) } }
        else {
            match lit_int(txt) {
                NumInt as v => Number { is_float = false; value = v; fval = 0.0 }
                error as e => return err_at(tokens, pos, e.message)
            }
        }
        return Parsed<@Pattern()> { node = LiteralPattern { value = Expr { kind = num; line = 0; col = 0 } }; next = pos + 1 }
    }
    if k == lexer::TokenKind::Str {
        return Parsed<@Pattern()> { node = LiteralPattern { value = Expr { kind = StrLit { text = tokens[pos].text }; line = 0; col = 0 } }; next = pos + 1 }
    }
    if k == lexer::TokenKind::Byte {
        return Parsed<@Pattern()> { node = LiteralPattern { value = Expr { kind = ByteLit { value = lit_byte(tokens[pos].text) }; line = 0; col = 0 } }; next = pos + 1 }
    }
    if k == lexer::TokenKind::LBracket {
        var ty = match parse_type_primary(tokens, pos) { ParsedType as x => x; error as e => return e }
        if !is_kind_at(tokens, ty.next, lexer::TokenKind::As) {
            return Parsed<@Pattern()> { node = BindPattern { type_name = Path { segments = [] }; has_binding = false; binding = ""; is_slice = true; slice_type = ty.node; type_args = [] }; next = ty.next }
        }
        if is_kind_at(tokens, ty.next + 1, lexer::TokenKind::Underscore) {
            return Parsed<@Pattern()> { node = BindPattern { type_name = Path { segments = [] }; has_binding = false; binding = ""; is_slice = true; slice_type = ty.node; type_args = [] }; next = ty.next + 2 }
        }
        if !is_name_at(tokens, ty.next + 1) {
            return err_at(tokens, ty.next + 1, "expected a name (or `_`) after `as` in a slice pattern")
        }
        return Parsed<@Pattern()> { node = BindPattern { type_name = Path { segments = [] }; has_binding = true; binding = tokens[ty.next + 1].text; is_slice = true; slice_type = ty.node; type_args = [] }; next = ty.next + 2 }
    }
    if k == lexer::TokenKind::LParen {
        return parse_group_bind_pattern(tokens, pos)
    }
    if k == lexer::TokenKind::At {
        var mt = match parse_macro_type(tokens, pos) { ParsedType as x => x; error as e => return e }
        return Parsed<@Pattern()> { node = MacroPattern { macro_call = mt.node }; next = mt.next }
    }
    if k == lexer::TokenKind::Ident {
        var pp = match parse_path(tokens, pos) { Parsed<Path> as x => x; error as e => return e }
        var after = pp.next
        var type_args: []@TypeExpr() = []
        if is_kind_at(tokens, after, lexer::TokenKind::Lt) {
            match parse_type_args(tokens, after) {
                ParsedTypeArgs as ta => {
                    if ta.pending_gt == 0 { type_args = ta.args; after = ta.next }
                }
                error => { }
            }
        }
        if is_kind_at(tokens, after, lexer::TokenKind::As) {
            if is_kind_at(tokens, after + 1, lexer::TokenKind::Underscore) {
                return Parsed<@Pattern()> { node = BindPattern { type_name = pp.node; has_binding = false; binding = ""; is_slice = false; slice_type = null; type_args = type_args }; next = after + 2 }
            }
            if !is_name_at(tokens, after + 1) {
                return err_at(tokens, after + 1, "expected a name (or `_`) after `as` in a pattern")
            }
            return Parsed<@Pattern()> { node = BindPattern { type_name = pp.node; has_binding = true; binding = tokens[after + 1].text; is_slice = false; slice_type = null; type_args = type_args }; next = after + 2 }
        }
        if type_args.len == 0 && is_kind_at(tokens, after, lexer::TokenKind::LBrace) {
            var fns = match parse_field_names(tokens, after) { ParsedList<str> as x => x; error as e => return e }
            return Parsed<@Pattern()> { node = FieldPattern { type_name = pp.node; fields = fns.items }; next = fns.next }
        }
        return Parsed<@Pattern()> { node = BindPattern { type_name = pp.node; has_binding = false; binding = ""; is_slice = false; slice_type = null; type_args = type_args }; next = after }
    }
    err_at(tokens, pos, "expected a pattern")
}

fn parse_pattern_range(tokens: []lexer::Token, pos: u64): Parsed<@Pattern()> | error {
    var lo_pat = match parse_pattern_primary(tokens, pos) { Parsed<@Pattern()> as x => x; error as e => return e }
    if !is_kind_at(tokens, lo_pat.next, lexer::TokenKind::DotDotEq) {
        return lo_pat
    }
    var lo = match lo_pat.node { LiteralPattern as lp => lp.value; _ => return err_at(tokens, pos, "a range bound must be a literal") }
    var hi_pat = match parse_pattern_primary(tokens, lo_pat.next + 1) { Parsed<@Pattern()> as x => x; error as e => return e }
    var hi = match hi_pat.node { LiteralPattern as lp => lp.value; _ => return err_at(tokens, lo_pat.next + 1, "a range bound must be a literal") }
    Parsed<@Pattern()> { node = RangePattern { lo = lo; hi = hi }; next = hi_pat.next }
}

fn parse_pattern(tokens: []lexer::Token, pos: u64): Parsed<@Pattern()> | error {
    var first = match parse_pattern_range(tokens, pos) { Parsed<@Pattern()> as x => x; error as e => return e }
    var options: []@Pattern() = []
    options = [..options, first.node]
    var p = first.next
    loop {
        if !is_kind_at(tokens, p, lexer::TokenKind::Pipe) { break }
        var opt = match parse_pattern_range(tokens, p + 1) { Parsed<@Pattern()> as x => x; error as e => return e }
        options = [..options, opt.node]
        p = opt.next
    }
    if options.len == 1 { return Parsed<@Pattern()> { node = first.node; next = p } }
    Parsed<@Pattern()> { node = AltPattern { options = options }; next = p }
}

fn parse_field_names(tokens: []lexer::Token, pos: u64): ParsedList<str> | error {
    var p = skip_seps(tokens, pos + 1)
    var names: []str = []
    if is_kind_at(tokens, p, lexer::TokenKind::RBrace) {
        return ParsedList<str> { items = names; next = p + 1 }
    }
    loop {
        if !is_name_at(tokens, p) {
            return err_at(tokens, p, "expected a field name in `Type { … }`")
        }
        names = [..names, tokens[p].text]
        p = p + 1
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
        if !is_sep(tokens, p) {
            return err_at(tokens, p, "expected ';', a newline, or '}' after a field name")
        }
        p = skip_seps(tokens, p)
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
    }
    ParsedList<str> { items = names; next = p + 1 }
}
