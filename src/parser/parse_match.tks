
use teko::lexer

fn parse_arms(tokens: []lexer::Token, pos: u64): ParsedList<Arm> | error {
    var p = skip_seps(tokens, pos + 1)
    var arms: []Arm = []
    loop {
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
        var a = match parse_arm(tokens, p) { Parsed<Arm> as x => x; error as e => return e }
        arms = [..arms, a.node]
        p = a.next
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
        if !is_sep(tokens, p) {
            return err_at(tokens, p, "expected ';', a newline, or '}' after a match arm")
        }
        p = skip_seps(tokens, p)
    }
    if arms.len == 0 {
        return err_at(tokens, p, "a `match` needs at least one arm")
    }
    ParsedList<Arm> { items = arms; next = p + 1 }
}

fn parse_match(tokens: []lexer::Token, pos: u64): Parsed<Expr> | error {
    var subj = match parse_expr_no_struct(tokens, pos + 1) { Parsed<Expr> as x => x; error as e => return e }
    if !is_kind_at(tokens, subj.next, lexer::TokenKind::LBrace) {
        return err_at(tokens, subj.next, "expected '{' after the `match` subject")
    }
    var arms = match parse_arms(tokens, subj.next) { ParsedList<Arm> as x => x; error as e => return e }
    Parsed<Expr> { node = Expr { kind = MatchExpr { subject = subj.node; arms = arms.items }; line = tokens[pos].line; col = tokens[pos].col }; next = arms.next }
}
