
use teko::lexer

fn parse_guard(tokens: []lexer::Token, pos: u64): Guard | error {
    if !is_kind_at(tokens, pos, lexer::TokenKind::When) {
        return Guard { has_when = false; guard = Expr { kind = Number { is_float = false; value = numint_of_u64(0); fval = 0.0 }; line = 0; col = 0 }; next = pos }
    }
    var g = match parse_expr(tokens, pos + 1) { Parsed<Expr> as x => x; error as e => return e }
    Guard { has_when = true; guard = g.node; next = g.next }
}

fn parse_arm(tokens: []lexer::Token, pos: u64): Parsed<Arm> | error {
    var pat = match parse_pattern(tokens, pos) { Parsed<@Pattern()> as x => x; error as e => return e }
    var g = match parse_guard(tokens, pat.next) { Guard as x => x; error as e => return e }
    if !is_kind_at(tokens, g.next, lexer::TokenKind::FatArrow) {
        return err_at(tokens, g.next, "expected '=>' after a match pattern")
    }
    var bpos = g.next + 1
    var body = if is_kind_at(tokens, bpos, lexer::TokenKind::LBrace) || is_sep(tokens, bpos) {
        match parse_if_body(tokens, bpos, "expected '{' or a body after '=>'") { ParsedList<@Statement()> as x => x; error as e => return e }
    } else {
        var s = match parse_statement(tokens, bpos) { Parsed<@Statement()> as x => x; error as e => return e }
        ParsedList<@Statement()> { items = [s.node]; next = s.next }
    }
    Parsed<Arm> { node = Arm { pattern = pat.node; has_when = g.has_when; guard = g.guard; body = body.items }; next = body.next }
}
