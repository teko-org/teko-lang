
pub type LiteralPattern = struct { value: Expr }
pub type RangePattern = struct { lo: Expr; hi: Expr }
pub type AltPattern = struct { options: []@Pattern() }
pub type BindPattern = struct {
    type_name: Path
    has_binding: bool
    binding: str
    is_slice: bool
    slice_type: @TypeExpr() | null
    type_args: []@TypeExpr()
}
pub type FieldPattern = struct { type_name: Path; fields: []str }
pub type WildcardPattern = struct { }
pub type NullPattern = struct { }

pub type GroupBindPattern = struct { options: []@Pattern(); binding: str }

pub type MacroPattern = struct { macro_call: @TypeExpr() }

macro Pattern() { lowering { parser::LiteralPattern | parser::RangePattern | parser::AltPattern | parser::GroupBindPattern | parser::BindPattern | parser::FieldPattern | parser::WildcardPattern | parser::NullPattern | parser::MacroPattern } }

pub type Arm = struct {
    pattern: @Pattern()
    has_when: bool
    guard: Expr
    body: []@Statement()
}
