use teko::lexer

fn is_decl_start(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Fn) || is_kind_at(tokens, pos, lexer::TokenKind::Type) || is_kind_at(tokens, pos, lexer::TokenKind::Extern)
}

fn parse_use_path(tokens: []lexer::Token, pos: u64): Parsed<Path> | error {
    if !is_name_at(tokens, pos) { return err_at(tokens, pos, "expected a name") }
    var segs: []Segment = []
    segs = [..segs, Segment { name = tokens[pos].text }]
    var p = pos + 1
    loop {
        if !is_kind_at(tokens, p, lexer::TokenKind::ColonColon) { break }
        if is_kind_at(tokens, p + 1, lexer::TokenKind::LBracket) { break }
        if !is_kind_at(tokens, p + 1, lexer::TokenKind::Ident) {
            return err_at(tokens, p + 1, "expected a name after '::'")
        }
        segs = [..segs, Segment { name = tokens[p + 1].text }]
        p = p + 2
    }
    Parsed<Path> { node = Path { segments = segs }; next = p }
}

fn parse_use_name_list(tokens: []lexer::Token, pos: u64): ParsedList<str> | error {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Ident) {
        return err_at(tokens, pos, "expected a name in a grouped `use` import")
    }
    var names: []str = []
    var p = pos
    loop {
        names = [..names, tokens[p].text]
        p = p + 1
        if is_kind_at(tokens, p, lexer::TokenKind::RBracket) { break }
        if !is_kind_at(tokens, p, lexer::TokenKind::Comma) {
            return err_at(tokens, p, "expected ',' or ']' in a grouped `use` import")
        }
        p = p + 1
        if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
            return err_at(tokens, p, "expected a name in a grouped `use` import")
        }
    }
    ParsedList<str> { items = names; next = p + 1 }
}

fn parse_use(tokens: []lexer::Token, pos: u64): Parsed<UseDecl> | error {
    var pp = match parse_use_path(tokens, pos + 1) { Parsed<Path> as x => x; error as e => return e }
    if is_kind_at(tokens, pp.next, lexer::TokenKind::ColonColon) && is_kind_at(tokens, pp.next + 1, lexer::TokenKind::LBracket) {
        var nl = match parse_use_name_list(tokens, pp.next + 2) { ParsedList<str> as x => x; error as e => return e }
        if is_kind_at(tokens, nl.next, lexer::TokenKind::As) {
            return err_at(tokens, nl.next, "a grouped `use` import takes no alias")
        }
        return Parsed<UseDecl> { node = UseDecl { path = pp.node; has_alias = false; alias = ""; names = nl.items }; next = nl.next }
    }
    var has_alias = false
    var alias = ""
    var p = pp.next
    if is_kind_at(tokens, p, lexer::TokenKind::As) {
        if !is_kind_at(tokens, p + 1, lexer::TokenKind::Ident) {
            return err_at(tokens, p + 1, "expected a name after `as` in a `use`")
        }
        has_alias = true
        alias = tokens[p + 1].text
        p = p + 2
    }
    Parsed<UseDecl> { node = UseDecl { path = pp.node; has_alias = has_alias; alias = alias; names = [] }; next = p }
}

fn parse_use_header(tokens: []lexer::Token, pos: u64): ParsedList<UseDecl> | error {
    var p = skip_trivia(tokens, pos)
    var uses: []UseDecl = []
    loop {
        if !is_kind_at(tokens, p, lexer::TokenKind::Use) { break }
        var u = match parse_use(tokens, p) { Parsed<UseDecl> as x => x; error as e => return e }
        uses = [..uses, u.node]
        p = u.next
        if !has_token(tokens, p) { break }
        if !is_sep(tokens, p) {
            return err_at(tokens, p, "expected ';' or a newline after a `use`")
        }
        p = skip_trivia(tokens, p)
    }
    ParsedList<UseDecl> { items = uses; next = p }
}

pub fn parse_main_file(tokens: []lexer::Token, pos: u64): Parsed<MainFile> | error {
    var hdr = match parse_use_header(tokens, pos) { ParsedList<UseDecl> as x => x; error as e => return e }
    var body = match fill_main_body(tokens, skip_trivia(tokens, hdr.next), 0) { ParsedList<@Statement()> as x => x; error as e => return e }
    Parsed<MainFile> { node = MainFile { uses = hdr.items; body = body.items }; next = body.next }
}

/**
 * Parse the remaining top-level statements of a virtual main, allocating the
 * exact-sized array at end-of-input and writing each statement into its slot as
 * the recursion unwinds — one parse pass, no per-iteration spread reallocation.
 *
 * @param tokens  the token stream being parsed
 * @param p       index of the next statement, or of end-of-input
 * @param filled  count of statements already parsed by outer frames
 * @return        the exact-sized statement array and the index past the body
 * @throws        when main.tks declares a type/function, or a statement is not
 *                followed by ';' or a newline
 */
fn fill_main_body(tokens: []lexer::Token, p: u64, filled: u64): ParsedList<@Statement()> | error {
    if !has_token(tokens, p) {
        var empty: [filled]@Statement() = []
        return ParsedList<@Statement()> { items = empty; next = p }
    }
    if is_decl_start(tokens, p) {
        return err_at(tokens, p, "main.tks is a virtual main: it may not declare types or functions (only `use` + statements)")
    }
    var s = match parse_statement(tokens, p) { Parsed<@Statement()> as x => x; error as e => return e }
    var q = s.next
    if !has_token(tokens, q) {
        var last: [filled + 1]@Statement() = []
        last[filled] = s.node
        return ParsedList<@Statement()> { items = last; next = q }
    }
    if !is_sep(tokens, q) {
        return err_at(tokens, q, "expected ';' or a newline after a statement")
    }
    var rest = match fill_main_body(tokens, skip_trivia(tokens, q), filled + 1) { ParsedList<@Statement()> as x => x; error as e => return e }
    var items = rest.items
    items[filled] = s.node
    ParsedList<@Statement()> { items = items; next = rest.next }
}
