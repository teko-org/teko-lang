
use teko::checker
use teko::parser

fn build_fnsig(f: checker::TFunction, table: checker::TypeTable): FnSig | error {
    var params: []SigParam = []
    var i = 0
    loop {
        if i >= f.params.len { break }
        var pt = match checker::resolve_type(f.params[i].type_ann, table, f.namespace) {
            (@Type()) as t => t
            error as e => return e
        }
        params = [..params, SigParam { name = f.params[i].name; type = pt }]
        i++
    }
    FnSig { name = f.name; params = params; ret = f.return_type; has_doc = f.has_doc; doc = f.doc.read() }
}

fn build_sigfields(fields: []parser::Field, table: checker::TypeTable): []SigField | error {
    var out: []SigField = []
    var i = 0
    loop {
        if i >= fields.len { break }
        var ft = match checker::resolve_type(fields[i].type_ann, table, "") {
            (@Type()) as t => t
            error as e => return e
        }
        out = [..out, SigField { name = fields[i].name; type = ft }]
        i++
    }
    out
}

fn build_tyexport(d: parser::TypeDecl, table: checker::TypeTable): TyExport | error {
    match d.body {
        parser::StructBody as sb => {
            var fields = match build_sigfields(sb.fields, table) {
                []SigField as fs => fs
                error as e => return e
            }
            TyExport {
                name = d.name; shape = TyShape::Struct
                fields = fields; members = []; cases = []
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::EnumBody as eb => {
            TyExport {
                name = d.name; shape = TyShape::Enum
                fields = []; members = eb.members; cases = []
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::VariantBody as vb => {
            var rt = match checker::resolve_type(vb.type_expr, table, "") {
                (@Type()) as t => t
                error as e => return e
            }
            var cases = match rt {
                checker::Variant as v => v.members
                _ => return error { message = "an exported variant's body did not resolve to a union" }
            }
            TyExport {
                name = d.name; shape = TyShape::Variant
                fields = []; members = []; cases = cases
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::AliasBody => {
            error { message = "exporting a type alias in the header is not yet supported" }
        }
        parser::NewtypeBody as nb => {
            var backing = match checker::resolve_type(nb.backing, table, "") {
                (@Type()) as t => t
                error as e => return e
            }
            var backing_cases: []@Type() = [backing]
            TyExport {
                name = d.name; shape = TyShape::Newtype
                fields = []; members = []; cases = backing_cases
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::ExternBody => {
            error { message = "exporting an extern type in the header is not yet supported" }
        }
        parser::ExternStructBody => {
            error { message = "exporting an extern struct type in the header is not yet supported" }
        }
        parser::FlagsBody => {
            error { message = "exporting a flags type in the header is not yet supported" }
        }
        parser::ClassBody as cb => {
            var fields = match build_sigfields(cb.fields, table) {
                []SigField as fs => fs
                error as e => return e
            }
            TyExport {
                name = d.name; shape = TyShape::Struct
                fields = fields; members = []; cases = []
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::InterfaceBody => {
            error { message = "exporting an interface in the header is not yet supported" }
        }
        parser::TraitBody => {
            error { message = "exporting a trait in the header is not yet supported" }
        }
    }
}

fn build_header(prog: checker::TProgram, table: checker::TypeTable): Header | error {
    var types: []TyExport = []
    var fns: []FnSig = []
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.vis == parser::Visibility::Exp {
                    var sig = match build_fnsig(f, table) {
                        FnSig as s => s
                        error as e => return e
                    }
                    fns = [..fns, sig]
                }
            }
            parser::TypeDecl as d => {
                if d.vis == parser::Visibility::Exp {
                    var te = match build_tyexport(d, table) {
                        TyExport as t => t
                        error as e => return e
                    }
                    types = [..types, te]
                }
            }
            parser::UseDecl => { }
            (@TStatement()) as _gb2 => { }
            checker::TConstDecl => { }
        }
        i++
    }
    Header { types = types; fns = fns }
}

fn emit_tkh_file(prog: checker::TProgram, table: checker::TypeTable, path: str): error | null {
    var header = match build_header(prog, table) {
        Header as h => h
        error as e => return e
    }
    emit_tkh(header, path)
    null
}
