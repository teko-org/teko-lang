
use teko::checker


type SigParam = struct { name: str; type: @Type() }

type FnSig = struct {
    name: str
    params: []SigParam
    ret: @Type()
    has_doc: bool
    doc: str
}

type SigField = struct { name: str; type: @Type() }

type TyShape = enum { Struct; Enum; Variant; Newtype }

type TyExport = struct {
    name: str
    shape: TyShape
    fields: []SigField
    members: []str
    cases: []@Type()
    has_doc: bool
    doc: str
}

type Header = struct { types: []TyExport; fns: []FnSig }


const FNV_PRIME: u64 = 0x100000001B3

fn fnv1a_fold(data: []byte, ref hash: u64) {
    var i: u64 = 0
    loop {
        if i >= data.len { break }
        hash.value = hash.value ^ (data[i] to u64)
        hash.value = hash.value * FNV_PRIME
        i = i + 1
    }
}

fn stream_byte(fs: teko::io::FileStream, ref hash: u64, x: byte) {
    fs.write_byte(x)
    hash.value = hash.value ^ (x to u64)
    hash.value = hash.value * FNV_PRIME
}

fn stream_bytes(fs: teko::io::FileStream, ref hash: u64, data: []byte) {
    fs.write_bytes(data)
    fnv1a_fold(data, hash)
}

fn stream_u32(fs: teko::io::FileStream, ref hash: u64, x: u32) {
    stream_byte(fs, hash, lo8(x))
    stream_byte(fs, hash, lo8(x >> 8))
    stream_byte(fs, hash, lo8(x >> 16))
    stream_byte(fs, hash, lo8(x >> 24))
}

fn stream_doc(fs: teko::io::FileStream, ref hash: u64, t: StrTable, has_doc: bool, doc: str) {
    if !has_doc {
        stream_byte(fs, hash, 0)
        return
    }
    stream_byte(fs, hash, 1)
    stream_u32(fs, hash, st_find(t, doc))
}

fn stream_sigparam(fs: teko::io::FileStream, ref hash: u64, t: StrTable, p: SigParam) {
    stream_u32(fs, hash, st_find(t, p.name))
    stream_bytes(fs, hash, wb_flat(write_type(wb_new(), t, p.type)))
}

fn stream_sigparams(fs: teko::io::FileStream, ref hash: u64, t: StrTable, xs: []SigParam) {
    stream_u32(fs, hash, xs.len to u32)
    var i = 0
    loop {
        if i >= xs.len { break }
        stream_sigparam(fs, hash, t, xs[i])
        i++
    }
}

fn stream_fnsig(fs: teko::io::FileStream, ref hash: u64, t: StrTable, f: FnSig) {
    stream_u32(fs, hash, st_find(t, f.name))
    stream_sigparams(fs, hash, t, f.params)
    stream_bytes(fs, hash, wb_flat(write_type(wb_new(), t, f.ret)))
    stream_doc(fs, hash, t, f.has_doc, f.doc)
}

fn stream_fnsigs(fs: teko::io::FileStream, ref hash: u64, t: StrTable, xs: []FnSig) {
    stream_u32(fs, hash, xs.len to u32)
    var i = 0
    loop {
        if i >= xs.len { break }
        stream_fnsig(fs, hash, t, xs[i])
        i++
    }
}

fn stream_sigfield(fs: teko::io::FileStream, ref hash: u64, t: StrTable, f: SigField) {
    stream_u32(fs, hash, st_find(t, f.name))
    stream_bytes(fs, hash, wb_flat(write_type(wb_new(), t, f.type)))
}

fn stream_sigfields(fs: teko::io::FileStream, ref hash: u64, t: StrTable, xs: []SigField) {
    stream_u32(fs, hash, xs.len to u32)
    var i = 0
    loop {
        if i >= xs.len { break }
        stream_sigfield(fs, hash, t, xs[i])
        i++
    }
}

fn stream_members(fs: teko::io::FileStream, ref hash: u64, t: StrTable, xs: []str) {
    stream_u32(fs, hash, xs.len to u32)
    var i = 0
    loop {
        if i >= xs.len { break }
        stream_u32(fs, hash, st_find(t, xs[i]))
        i++
    }
}

fn shape_byte(s: TyShape): byte {
    if s == TyShape::Struct { return 0 }
    if s == TyShape::Enum { return 1 }
    if s == TyShape::Variant { return 2 }
    3
}

fn stream_tyexport(fs: teko::io::FileStream, ref hash: u64, t: StrTable, e: TyExport) {
    stream_u32(fs, hash, st_find(t, e.name))
    stream_byte(fs, hash, shape_byte(e.shape))
    stream_sigfields(fs, hash, t, e.fields)
    stream_members(fs, hash, t, e.members)
    stream_bytes(fs, hash, wb_flat(write_types(wb_new(), t, e.cases)))
    stream_doc(fs, hash, t, e.has_doc, e.doc)
}

fn stream_tyexports(fs: teko::io::FileStream, ref hash: u64, t: StrTable, xs: []TyExport) {
    stream_u32(fs, hash, xs.len to u32)
    var i = 0
    loop {
        if i >= xs.len { break }
        stream_tyexport(fs, hash, t, xs[i])
        i++
    }
}

fn stream_strtable(fs: teko::io::FileStream, ref hash: u64, t: StrTable) {
    stream_u32(fs, hash, t.strings.len to u32)
    var i = 0
    loop {
        if i >= t.strings.len { break }
        stream_bytes(fs, hash, wb_flat(write_bytes(wb_new(), t.strings[i])))
        i++
    }
}

fn stream_header(fs: teko::io::FileStream, ref hash: u64, t: StrTable, h: Header) {
    stream_strtable(fs, hash, t)
    stream_tyexports(fs, hash, t, h.types)
    stream_fnsigs(fs, hash, t, h.fns)
}


fn collect_doc(t: StrTable, has_doc: bool, doc: str): StrTable {
    if !has_doc { return t }
    st_intern(t, doc).table
}

fn collect_sigparam(t: StrTable, p: SigParam): StrTable {
    collect_type_strings(st_intern(t, p.name).table, p.type)
}

fn collect_sigparams(t: StrTable, xs: []SigParam): StrTable {
    var tab = t
    var i = 0
    loop {
        if i >= xs.len { break }
        tab = collect_sigparam(tab, xs[i])
        i++
    }
    tab
}

fn collect_fnsig(t: StrTable, f: FnSig): StrTable {
    var t1 = st_intern(t, f.name).table
    var t2 = collect_sigparams(t1, f.params)
    var t3 = collect_type_strings(t2, f.ret)
    collect_doc(t3, f.has_doc, f.doc)
}

fn collect_fnsigs(t: StrTable, xs: []FnSig): StrTable {
    var tab = t
    var i = 0
    loop {
        if i >= xs.len { break }
        tab = collect_fnsig(tab, xs[i])
        i++
    }
    tab
}

fn collect_sigfield(t: StrTable, f: SigField): StrTable {
    collect_type_strings(st_intern(t, f.name).table, f.type)
}

fn collect_sigfields(t: StrTable, xs: []SigField): StrTable {
    var tab = t
    var i = 0
    loop {
        if i >= xs.len { break }
        tab = collect_sigfield(tab, xs[i])
        i++
    }
    tab
}

fn collect_members(t: StrTable, xs: []str): StrTable {
    var tab = t
    var i = 0
    loop {
        if i >= xs.len { break }
        tab = st_intern(tab, xs[i]).table
        i++
    }
    tab
}

fn collect_tyexport(t: StrTable, e: TyExport): StrTable {
    var t1 = st_intern(t, e.name).table
    var t2 = collect_sigfields(t1, e.fields)
    var t3 = collect_members(t2, e.members)
    var t4 = collect_type_list(t3, e.cases)
    collect_doc(t4, e.has_doc, e.doc)
}

fn collect_tyexports(t: StrTable, xs: []TyExport): StrTable {
    var tab = t
    var i = 0
    loop {
        if i >= xs.len { break }
        tab = collect_tyexport(tab, xs[i])
        i++
    }
    tab
}

fn collect_header(t: StrTable, h: Header): StrTable {
    collect_fnsigs(collect_tyexports(t, h.types), h.fns)
}


const TKH_VERSION: u32 = 2

const TKH_HASH_FIELD_OFFSET: i64 = 8

fn tkh_stub_header(): []byte {
    var b = wb_new()
    b = write_u8(b, b'T')
    b = write_u8(b, b'K')
    b = write_u8(b, b'H')
    b = write_u8(b, 0)
    b = write_u32(b, TKH_VERSION)
    wb_flat(write_u64(b, 0))
}

fn patch_tkh_hash(fs: teko::io::FileStream, hash: u64) {
    fs.flush()
    match teko::io::stream_seek(fs, TKH_HASH_FIELD_OFFSET, teko::io::Whence::Start) {
        u64 => { }
        error as e => panic(e.message)
    }
    match teko::io::stream_write(fs, wb_flat(write_u64(wb_new(), hash))) {
        u64 => { }
        error as e => panic(e.message)
    }
}

fn emit_tkh(h: Header, path: str) {
    var fs = match teko::io::FileStream::open(path) {
        teko::io::FileStream as f => f
        error as e => panic(e.message)
    }
    defer { fs.flush(); fs.close() }
    fs.write_bytes(tkh_stub_header())
    var table = collect_header(st_empty(), h)
    var hash: u64 = 0xCBF29CE484222325
    stream_header(fs, hash, table, h)
    patch_tkh_hash(fs, hash)
}


type RDoc = struct { r: Reader; has_doc: bool; doc: str }
type RSigParam = struct { r: Reader; value: SigParam }
type RSigParams = struct { r: Reader; value: []SigParam }
type RFnSig = struct { r: Reader; value: FnSig }
type RFnSigs = struct { r: Reader; value: []FnSig }
type RSigField = struct { r: Reader; value: SigField }
type RSigFields = struct { r: Reader; value: []SigField }
type RMembers = struct { r: Reader; value: []str }
type RTyExport = struct { r: Reader; value: TyExport }
type RTyExports = struct { r: Reader; value: []TyExport }
type RHeader = struct { r: Reader; value: Header }

fn read_doc(r: Reader, table: []str): RDoc | error {
    var p = match read_u8(r) { RByte as x => x; error as e => return e }
    if p.value == 0 { return RDoc { r = p.r; has_doc = false; doc = "" } }
    var d = match tkb_read_str(p.r, table) { RStr as x => x; error as e => return e }
    RDoc { r = d.r; has_doc = true; doc = d.value }
}

fn read_sigparam(r: Reader, table: []str): RSigParam | error {
    var nm = match tkb_read_str(r, table) { RStr as x => x; error as e => return e }
    var ty = match read_type(nm.r, table) { RType as x => x; error as e => return e }
    RSigParam { r = ty.r; value = SigParam { name = nm.value; type = ty.value } }
}

fn read_sigparams(r: Reader, table: []str): RSigParams | error {
    var n = match read_u32(r) { RU32 as x => x; error as e => return e }
    var rr = n.r
    var xs: []SigParam = []
    var i = 0
    loop {
        if i >= n.value { break }
        var p = match read_sigparam(rr, table) { RSigParam as x => x; error as e => return e }
        xs = [..xs, p.value]
        rr = p.r
        i++
    }
    RSigParams { r = rr; value = xs }
}

fn read_fnsig(r: Reader, table: []str): RFnSig | error {
    var nm = match tkb_read_str(r, table) { RStr as x => x; error as e => return e }
    var ps = match read_sigparams(nm.r, table) { RSigParams as x => x; error as e => return e }
    var rt = match read_type(ps.r, table) { RType as x => x; error as e => return e }
    var dc = match read_doc(rt.r, table) { RDoc as x => x; error as e => return e }
    RFnSig { r = dc.r; value = FnSig {
            name = nm.value; params = ps.value; ret = rt.value
            has_doc = dc.has_doc; doc = dc.doc
    } }
}

fn read_fnsigs(r: Reader, table: []str): RFnSigs | error {
    var n = match read_u32(r) { RU32 as x => x; error as e => return e }
    var rr = n.r
    var xs: []FnSig = []
    var i = 0
    loop {
        if i >= n.value { break }
        var f = match read_fnsig(rr, table) { RFnSig as x => x; error as e => return e }
        xs = [..xs, f.value]
        rr = f.r
        i++
    }
    RFnSigs { r = rr; value = xs }
}

fn read_sigfield(r: Reader, table: []str): RSigField | error {
    var nm = match tkb_read_str(r, table) { RStr as x => x; error as e => return e }
    var ty = match read_type(nm.r, table) { RType as x => x; error as e => return e }
    RSigField { r = ty.r; value = SigField { name = nm.value; type = ty.value } }
}

fn read_sigfields(r: Reader, table: []str): RSigFields | error {
    var n = match read_u32(r) { RU32 as x => x; error as e => return e }
    var rr = n.r
    var xs: []SigField = []
    var i = 0
    loop {
        if i >= n.value { break }
        var f = match read_sigfield(rr, table) { RSigField as x => x; error as e => return e }
        xs = [..xs, f.value]
        rr = f.r
        i++
    }
    RSigFields { r = rr; value = xs }
}

fn read_members(r: Reader, table: []str): RMembers | error {
    var n = match read_u32(r) { RU32 as x => x; error as e => return e }
    var rr = n.r
    var xs: []str = []
    var i = 0
    loop {
        if i >= n.value { break }
        var s = match tkb_read_str(rr, table) { RStr as x => x; error as e => return e }
        xs = [..xs, s.value]
        rr = s.r
        i++
    }
    RMembers { r = rr; value = xs }
}

fn shape_of(b: byte): TyShape {
    if b == 0 { return TyShape::Struct }
    if b == 1 { return TyShape::Enum }
    if b == 2 { return TyShape::Variant }
    TyShape::Newtype
}

fn read_tyexport(r: Reader, table: []str): RTyExport | error {
    var nm = match tkb_read_str(r, table) { RStr as x => x; error as e => return e }
    var sh = match read_u8(nm.r) { RByte as x => x; error as e => return e }
    var fs = match read_sigfields(sh.r, table) { RSigFields as x => x; error as e => return e }
    var ms = match read_members(fs.r, table) { RMembers as x => x; error as e => return e }
    var cs = match read_types(ms.r, table) { RTypes as x => x; error as e => return e }
    var dc = match read_doc(cs.r, table) { RDoc as x => x; error as e => return e }
    RTyExport { r = dc.r; value = TyExport {
            name = nm.value; shape = shape_of(sh.value)
            fields = fs.value; members = ms.value; cases = cs.value
            has_doc = dc.has_doc; doc = dc.doc
    } }
}

fn read_tyexports(r: Reader, table: []str): RTyExports | error {
    var n = match read_u32(r) { RU32 as x => x; error as e => return e }
    var rr = n.r
    var xs: []TyExport = []
    var i = 0
    loop {
        if i >= n.value { break }
        var e = match read_tyexport(rr, table) { RTyExport as x => x; error as e => return e }
        xs = [..xs, e.value]
        rr = e.r
        i++
    }
    RTyExports { r = rr; value = xs }
}

fn read_header(r: Reader, table: []str): RHeader | error {
    var ts = match read_tyexports(r, table) { RTyExports as x => x; error as e => return e }
    var fs = match read_fnsigs(ts.r, table) { RFnSigs as x => x; error as e => return e }
    RHeader { r = fs.r; value = Header { types = ts.value; fns = fs.value } }
}

fn read_tkh(data: []byte): Header | error {
    var r0 = Reader { data = data; pos = 0 }
    var m0 = match read_u8(r0) { RByte as x => x; error as e => return e }
    var m1 = match read_u8(m0.r) { RByte as x => x; error as e => return e }
    var m2 = match read_u8(m1.r) { RByte as x => x; error as e => return e }
    var m3 = match read_u8(m2.r) { RByte as x => x; error as e => return e }
    if m0.value != b'T' || m1.value != b'K' || m2.value != b'H' || m3.value != 0 {
        return error { message = "not a .tkh (bad magic)" }
    }
    var ver = match read_u32(m3.r) { RU32 as x => x; error as e => return e }
    if ver.value != TKH_VERSION {
        return error { message = "unsupported .tkh version (this compiler reads version 2; pre-0.3.1 artifacts use retired PrimKind ordinals and must be rebuilt with the current compiler)" }
    }
    var stored = match read_u64(ver.r) { RU64 as x => x; error as e => return e }
    if data.len < 16 { return error { message = "truncated .tkh header" } }
    if fnv1a(data, 16) != stored.value {
        return error { message = ".tkh altered or corrupt (hash mismatch)" }
    }
    var table = match read_strtable(stored.r) { RTable as x => x; error as e => return e }
    var h = match read_header(table.r, table.value) { RHeader as x => x; error as e => return e }
    h.value
}
