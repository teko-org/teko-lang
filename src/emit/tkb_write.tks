
use teko::checker
use teko::parser
use teko::lexer

fn prim_byte(k: checker::PrimKind): byte { k to byte }
fn kind_byte(k: lexer::TokenKind): byte { k to byte }

fn numint_hi(v: parser::NumInt): u64 { if v.neg { 0xFFFFFFFFFFFFFFFF } else { 0 } }
fn numint_lo(v: parser::NumInt): u64 { if v.neg { 0 - v.mag } else { v.mag } }
fn bindkind_byte(k: parser::BindKind): byte { k to byte }
fn assign_kind_byte(k: parser::AssignKind): byte { k to byte }
fn vis_byte(v: parser::Visibility): byte { v to byte }

fn write_type(buf: Wb, t: StrTable, ty: @Type()): Wb {
    match ty {
        checker::Prim as p => write_u8(write_u8(buf, 0), prim_byte(p.kind))
        checker::Byte => write_u8(buf, 1)
        checker::Error => write_u8(buf, 3)
        checker::Void => write_u8(buf, 4)
        checker::Slice as s => write_type(write_u8(buf, 5), t, s.element)
        checker::Named as n => write_u32(write_u8(buf, 6), st_find(t, n.name))
        checker::Variant as v => write_types(write_u8(buf, 7), t, v.members)
        checker::Func as f => write_type(write_types(write_u8(buf, 8), t, f.params), t, f.ret)
        checker::Ptr => write_u8(buf, 10)
        checker::Uptr => write_u8(buf, 11)
        checker::Reference as r => write_type(write_u8(buf, 13), t, r.inner)
        checker::Char => write_u8(buf, 14)
        checker::Null => write_u8(buf, 15)
    }
}

fn write_types(buf: Wb, t: StrTable, xs: []@Type()): Wb {
    var b = write_u32(buf, xs.len to u32)
    var i = 0
    loop {
        if i >= xs.len { break }
        b = write_type(b, t, xs[i])
        i++
    }
    b
}

fn write_path(buf: Wb, t: StrTable, p: parser::Path): Wb {
    var b = write_u32(buf, p.segments.len to u32)
    var i = 0
    loop {
        if i >= p.segments.len { break }
        b = write_u32(b, st_find(t, p.segments[i].name))
        i++
    }
    b
}

fn write_texprs(buf: Wb, t: StrTable, xs: []checker::TExpr): Wb {
    var b = write_u32(buf, xs.len to u32)
    var i = 0
    loop {
        if i >= xs.len { break }
        b = write_texpr(b, t, xs[i])
        i++
    }
    b
}

fn write_terms(buf: Wb, t: StrTable, ts: []checker::TCmpTerm): Wb {
    var b = write_u32(buf, ts.len to u32)
    var i = 0
    loop {
        if i >= ts.len { break }
        b = write_texpr(write_u8(b, kind_byte(ts[i].op)), t, ts[i].operand)
        i++
    }
    b
}

fn write_call_tail(buf: Wb, t: StrTable, cl: checker::TCall): Wb {
    write_u8(write_u32(buf, st_find(t, cl.call_ns)), (if cl.is_closure_call { 1 } else { 0 }) to byte)
}

fn write_texpr(buf: Wb, t: StrTable, te: checker::TExpr): Wb {
    var b = write_type(buf, t, te.type)
    match te.kind {
        checker::TNumber as n => write_u64(
            write_u64(
                write_u64(
                    write_u8(write_u8(b, 0), (if n.is_float { 1 } else { 0 }) to byte),
                    numint_hi(n.value)),
                numint_lo(n.value)),
            teko::f64_bits(n.fval))
        checker::TVar as v => write_u32(write_u8(write_u32(write_u8(b, 1), st_find(t, v.name)), (if v.is_func { 1 } else { 0 }) to byte), st_find(t, v.func_ns))
        checker::TStrLit as s => write_u32(write_u8(b, 2), st_find(t, s.text))
        checker::TByteStrLit as bs => write_u32(write_u8(b, 27), st_find(t, bs.text))
        checker::TByteLit as bl => write_u8(write_u8(b, 3), bl.value)
        checker::TBinary as bn => write_texpr(write_texpr(write_u8(write_u8(b, 4), kind_byte(bn.op)), t, bn.left), t, bn.right)
        checker::TUnary as u => write_texpr(write_u8(write_u8(b, 5), kind_byte(u.op)), t, u.operand)
        checker::TCompare as c => write_terms(write_texpr(write_u8(b, 6), t, c.first), t, c.rest)
        checker::TCall as cl => {
            if cl.is_iface_dispatch {
                var ib = write_path(write_u8(b, 24), t, cl.callee)
                ib = write_type(ib, t, cl.callee_type)
                ib = write_u32(ib, cl.iface_slot)
                ib = write_texprs(ib, t, cl.args)
                write_call_tail(ib, t, cl)
            } else {
                var pb = write_texprs(write_path(write_u8(b, 7), t, cl.callee), t, cl.args)
                pb = write_call_tail(pb, t, cl)
                write_types(pb, t, cl.type_args)
            }
        }
        checker::TIfExpr as iff => {
            var sb = write_texpr(write_u8(b, 8), t, iff.cond)
            sb = write_tstatements(sb, t, iff.then_blk)
            sb = write_u8(sb, (if iff.has_else { 1 } else { 0 }) to byte)
            write_tstatements(sb, t, iff.else_blk)
        }
        checker::TMatchExpr as m => write_tarms(write_texpr(write_u8(b, 9), t, m.subject), t, m.arms)
        checker::TCast as c => write_texpr(write_u8(b, 10), t, c.expr)
        checker::TFieldAccess as f => write_u32(write_texpr(write_u8(b, 11), t, f.receiver), st_find(t, f.field))
        checker::TBoolLit as bo => write_u8(write_u8(b, 12), (if bo.value { 1 } else { 0 }) to byte)
        checker::TNullLit => write_u8(b, 13)
        checker::TStructInit as si => {
            var sb = write_u32(write_u8(b, 16), si.field_names.len to u32)
            var i = 0
            loop {
                if i >= si.field_names.len { break }
                sb = write_texpr(write_u32(sb, st_find(t, si.field_names[i])), t, si.field_vals[i])
                i++
            }
            sb
        }
        checker::TIndex as ix => write_texpr(write_texpr(write_u8(b, 17), t, ix.receiver), t, ix.index)
        checker::TInterp as in => {
            var sb = write_u32(write_u8(b, 18), in.pieces.len to u32)
            var i = 0
            loop {
                if i >= in.pieces.len { break }
                sb = write_u32(sb, st_find(t, in.pieces[i]))
                i++
            }
            sb = write_u32(sb, in.holes.len to u32)
            var j = 0
            loop {
                if j >= in.holes.len { break }
                sb = write_texpr(sb, t, in.holes[j])
                j++
            }
            sb
        }
        checker::TPathExpr as pe => write_u64(write_u64(write_u64(write_u32(write_u32(write_u8(b, 19), st_find(t, pe.enum_name)), st_find(t, pe.member)), pe.ordinal), 0), pe.value)
        checker::TInExpr as ie => {
            var sb = write_texpr(write_u8(b, 20), t, ie.lhs)
            sb = write_u64(sb, ie.elems.len)
            var i = 0
            loop {
                if i >= ie.elems.len { break }
                sb = write_texpr(sb, t, ie.elems[i])
                i++
            }
            sb
        }
        checker::TArrayLit as a => {
            var sb = write_u64(write_u8(b, 21), a.elements.len)
            var i = 0
            loop {
                if i >= a.elements.len { break }
                sb = write_texpr(write_u8(sb, (if a.elements[i].is_spread { 1 } else { 0 }) to byte), t, a.elements[i].expr)
                i++
            }
            sb
        }
        checker::TSliceOfLen as s => write_type(write_texpr(write_u8(b, 28), t, s.size), t, s.element)
        checker::TZeroOf as z => write_type(write_u8(b, 29), t, z.element)
        checker::TLambda as lam => write_u64(write_u8(b, 22), lam.lift_id)
        checker::TCharLit as ch => write_u32(write_u8(b, 23), st_find(t, ch.bytes))
        checker::TBorrow as bw => write_texpr(write_u8(b, 25), t, bw.operand)
        checker::TBlockExpr as blk => write_tstatements(write_u8(b, 26), t, blk.body)
    }
}

fn write_bindtarget(buf: Wb, t: StrTable, bt: @BindTarget()): Wb {
    match bt {
        parser::SimpleName as s => write_u32(write_u8(buf, 0), st_find(t, s.name))
        parser::DestructurePattern as d => {
            var b = write_u32(write_u8(buf, 1), d.names.len to u32)
            var i = 0
            loop {
                if i >= d.names.len { break }
                b = write_u32(b, st_find(t, d.names[i]))
                i++
            }
            b
        }
    }
}

fn write_tstatements(buf: Wb, t: StrTable, xs: []@TStatement()): Wb {
    var b = write_u64(buf, xs.len)
    var i = 0
    loop {
        if i >= xs.len { break }
        b = write_tstatement(b, t, xs[i])
        i++
    }
    b
}

fn write_tstatement(buf: Wb, t: StrTable, s: @TStatement()): Wb {
    match s {
        checker::TBinding as bd => {
            var b = write_u8(write_u8(buf, 0), bindkind_byte(bd.kind))
            b = write_bindtarget(b, t, bd.target)
            b = write_type(b, t, bd.bound)
            write_texpr(b, t, bd.value)
        }
        checker::TAssign as a => {
            var b = write_u8(buf, 1)
            b = write_u8(b, assign_kind_byte(a.kind))
            b = write_u32(b, st_find(t, a.name))
            b = write_u8(b, kind_byte(a.op))
            b = write_type(b, t, a.bound)
            b = write_texpr(b, t, a.value)
            b = write_u8(b, (if a.deref { 1 } else { 0 }) to byte)
            if parser::assign_has_target(a.kind) { write_texpr(b, t, a.target) } else { b }
        }
        checker::TReturn as r => write_texpr(write_u8(write_u8(buf, 2), (if r.has_value { 1 } else { 0 }) to byte), t, r.value)
        checker::TLoopStmt as l => write_tstatements(write_tstatements(write_u32(write_u8(buf, 3), st_find(t, l.label)), t, l.init), t, l.body)
        checker::TBreakStmt as br => write_u32(write_u8(buf, 4), st_find(t, br.label))
        checker::TContinueStmt as c => write_u32(write_u8(buf, 5), st_find(t, c.label))
        checker::TExprStmt as e => write_texpr(write_u8(buf, 6), t, e.expr)
        checker::TDeferStmt as d => write_tstatements(write_u8(buf, 7), t, d.body)
        checker::TAdoptStmt as a => write_tstatements(write_u32(write_u8(buf, 8), st_find(t, a.name)), t, a.body)
        checker::TBlockStmt as b => write_tstatements(write_u8(buf, 9), t, b.body)
        checker::TSpawn as sp => write_texpr(write_u8(buf, 10), t, sp.call)
    }
}


fn write_typeexprs(buf: Wb, t: StrTable, xs: []@TypeExpr()): Wb {
    var b = write_u64(buf, xs.len)
    var i = 0
    loop { if i >= xs.len { break }; b = write_typeexpr(b, t, xs[i]); i++ }
    b
}

fn write_typeexpr(buf: Wb, t: StrTable, te: @TypeExpr()): Wb {
    match te {
        parser::NamedType as n => write_path(write_u8(buf, 0), t, n.path)
        parser::SliceType as s => write_typeexpr(write_u8(buf, 1), t, s.element)
        parser::SizedArrayType as sa => write_typeexpr(write_u8(buf, 1), t, sa.element)
        parser::UnionType as u => write_typeexprs(write_u8(buf, 2), t, u.members)
        parser::FunctionType as f => write_typeexpr(write_typeexprs(write_u8(buf, 4), t, f.params), t, f.ret)
        parser::MacroType => buf
    }
}

fn write_constraint(buf: Wb, t: StrTable, c: @ConstraintExpr()): Wb {
    match c {
        parser::ConstraintAtom as a => write_u32(write_u8(buf, 0), st_find(t, a.name))
        parser::ConstraintType as ct => write_typeexpr(write_u8(buf, 6), t, ct.ty)
        parser::ConstraintAnd as an => write_constraint(write_constraint(write_u8(buf, 1), t, an.left), t, an.right)
        parser::ConstraintOr as o => write_constraint(write_constraint(write_u8(buf, 2), t, o.left), t, o.right)
        parser::ConstraintNotNull => write_u8(buf, 4)
        parser::ConstraintForm as f => write_u8(write_u8(write_u32(write_u8(buf, 5), st_find(t, f.form)), (if f.has_lifetime { 1 } else { 0 }) to byte), service_lifetime_byte(f.lifetime))
        parser::NoConstraint => write_u8(buf, 3)
    }
}

fn write_constraints(buf: Wb, t: StrTable, xs: []@ConstraintExpr()): Wb {
    var b = write_u64(buf, xs.len)
    var i = 0
    loop { if i >= xs.len { break }; b = write_constraint(b, t, xs[i]); i++ }
    b
}

fn write_strs(buf: Wb, t: StrTable, xs: []str): Wb {
    var b = write_u64(buf, xs.len)
    var i = 0
    loop { if i >= xs.len { break }; b = write_u32(b, st_find(t, xs[i])); i++ }
    b
}

fn write_params(buf: Wb, t: StrTable, xs: []parser::Param): Wb {
    var b = write_u64(buf, xs.len)
    var i = 0
    loop {
        if i >= xs.len { break }
        b = write_u32(b, st_find(t, xs[i].name))
        b = write_u8(b, (if xs[i].has_type { 1 } else { 0 }) to byte)
        b = write_typeexpr(b, t, xs[i].type_ann)
        i++
    }
    b
}

fn write_fields(buf: Wb, t: StrTable, xs: []parser::Field): Wb {
    var b = write_u64(buf, xs.len)
    var i = 0
    loop {
        if i >= xs.len { break }
        b = write_typeexpr(write_u32(b, st_find(t, xs[i].name)), t, xs[i].type_ann)
        b = write_u8(b, vis_byte(xs[i].vis))
        b = write_u8(b, (if xs[i].is_intern { 1 } else { 0 }) to byte)
        b = write_u8(b, (if xs[i].has_doc { 1 } else { 0 }) to byte)
        b = write_u8(b, (if xs[i].is_readonly { 1 } else { 0 }) to byte)
        i++
    }
    b
}

fn class_kind_byte(k: parser::ClassKind): byte { k to byte }

fn write_constdecl(buf: Wb, t: StrTable, cd: parser::ConstDecl): Wb {
    var b = write_typeexpr(write_u32(buf, st_find(t, cd.name)), t, cd.ty)
    b = write_u8(b, vis_byte(cd.vis))
    b = write_u8(b, (if cd.has_doc { 1 } else { 0 }) to byte)
    b = write_u32(b, cd.line)
    write_u32(b, cd.col)
}

fn write_constdecls(buf: Wb, t: StrTable, xs: []parser::ConstDecl): Wb {
    var b = write_u64(buf, xs.len)
    var i = 0
    loop { if i >= xs.len { break }; b = write_constdecl(b, t, xs[i]); i++ }
    b
}

fn write_struct_body(buf: Wb, t: StrTable, s: parser::StructBody): Wb {
    var b = write_constdecls(write_strs(write_functions(write_fields(write_u8(buf, 0), t, s.fields), t, s.methods), t, s.implements), t, s.consts)
    write_u8(b, (if s.is_readonly { 1 } else { 0 }) to byte)
}

fn service_lifetime_byte(lt: parser::ServiceLifetime): byte { lt to byte }

fn write_class_body(buf: Wb, t: StrTable, c: parser::ClassBody): Wb {
    var b = write_u8(write_u8(buf, 6), class_kind_byte(c.kind))
    b = write_u8(b, (if c.has_base { 1 } else { 0 }) to byte)
    b = write_u32(b, st_find(t, c.base_name))
    b = write_u8(b, (if c.has_base_binding { 1 } else { 0 }) to byte)
    b = write_u32(b, st_find(t, c.base_binding_name))
    b = write_strs(b, t, c.implements)
    b = write_fields(b, t, c.fields)
    b = write_functions(b, t, c.methods)
    b = write_constdecls(b, t, c.consts)
    b = write_u8(b, (if c.is_service { 1 } else { 0 }) to byte)
    write_u8(b, service_lifetime_byte(c.service_lifetime))
}

fn write_typebody(buf: Wb, t: StrTable, tb: @TypeBody()): Wb {
    match tb {
        parser::StructBody as s => write_struct_body(buf, t, s)
        parser::EnumBody as e => write_constdecls(write_functions(write_strs(write_u8(buf, 1), t, e.members), t, e.methods), t, e.consts)
        parser::VariantBody as v => write_typeexpr(write_u8(buf, 2), t, v.type_expr)
        parser::AliasBody as a => write_typeexpr(write_u8(buf, 3), t, a.alias)
        parser::NewtypeBody as nb => write_constdecls(write_functions(write_typeexpr(write_u8(buf, 9), t, nb.backing), t, nb.methods), t, nb.consts)
        parser::ExternBody => write_u8(buf, 4)
        parser::ExternStructBody as esb => write_u32(write_fields(write_u8(buf, 10), t, esb.fields), st_find(t, esb.c_tag))
        parser::FlagsBody as f => write_flags_body(buf, t, f)
        parser::ClassBody as c => write_class_body(buf, t, c)
        parser::InterfaceBody as ib => write_functions(write_strs(write_u8(buf, 7), t, ib.extends), t, ib.methods)
        parser::TraitBody as trb => write_strs(write_constdecls(write_functions(write_fields(write_u8(buf, 8), t, trb.fields), t, trb.methods), t, trb.consts), t, trb.implements)
    }
}

fn write_flags_body(buf: Wb, t: StrTable, f: parser::FlagsBody): Wb {
    var sb = write_u64(write_u8(buf, 5), f.members.len)
    var i = 0
    loop {
        if i >= f.members.len { break }
        sb = write_u32(sb, st_find(t, f.members[i]))
        sb = write_u64(sb, 0)
        sb = write_u64(sb, f.values[i])
        i++
    }
    write_constdecls(write_functions(sb, t, f.methods), t, f.consts)
}

fn write_typedecl(buf: Wb, t: StrTable, d: parser::TypeDecl): Wb {
    var b = write_u32(buf, st_find(t, d.name))
    b = write_strs(b, t, d.type_params)
    b = write_constraints(b, t, d.type_constraints)
    b = write_typebody(b, t, d.body)
    b = write_u8(b, vis_byte(d.vis))
    b = write_u8(b, (if d.has_doc { 1 } else { 0 }) to byte)
    b = write_u32(b, d.line)
    write_u32(b, d.col)
}

fn write_usedecl(buf: Wb, t: StrTable, u: parser::UseDecl): Wb {
    var b = write_path(buf, t, u.path)
    b = write_u8(b, (if u.has_alias { 1 } else { 0 }) to byte)
    b = write_u32(b, st_find(t, u.alias))
    write_strs(b, t, u.names)
}

fn write_function(buf: Wb, t: StrTable, f: parser::Function): Wb {
    var b = write_u32(buf, st_find(t, f.name))
    b = write_strs(b, t, f.type_params)
    b = write_constraints(b, t, f.type_constraints)
    b = write_params(b, t, f.params)
    b = write_u8(b, (if f.has_return { 1 } else { 0 }) to byte)
    b = write_typeexpr(b, t, f.return_type)
    b = write_u8(b, 0)
    b = write_u8(b, vis_byte(f.vis))
    b = write_u8(b, (if f.has_doc { 1 } else { 0 }) to byte)
    b = write_u32(b, f.line)
    b = write_u32(b, f.col)
    b = write_u8(b, (if f.is_test { 1 } else { 0 }) to byte)
    b = write_u8(b, (if f.is_extern { 1 } else { 0 }) to byte)
    b = write_u32(b, st_find(t, f.c_symbol))
    b = write_u32(b, st_find(t, f.from_lib))
    b = write_u32(b, st_find(t, f.os_guard))
    b = write_u8(b, (if f.is_intern { 1 } else { 0 }) to byte)
    b = write_u8(b, (if f.is_abstract { 1 } else { 0 }) to byte)
    b = write_u8(b, (if f.is_virtual { 1 } else { 0 }) to byte)
    write_u8(b, (if f.is_override { 1 } else { 0 }) to byte)
}

fn write_functions(buf: Wb, t: StrTable, xs: []parser::Function): Wb {
    var b = write_u64(buf, xs.len)
    var i = 0
    loop { if i >= xs.len { break }; b = write_function(b, t, xs[i]); i++ }
    b
}

fn write_tfunction(buf: Wb, t: StrTable, f: checker::TFunction): Wb | error {
    match f.guard.kind {
        parser::PTrue => { }
        _ => return error { message = $"{f.namespace}::{f.name}: target-guarded fn cannot cross a module boundary yet" }
    }
    var b = write_u32(buf, st_find(t, f.name))
    b = write_strs(b, t, f.type_params)
    b = write_constraints(b, t, f.type_constraints)
    b = write_params(b, t, f.params)
    b = write_type(b, t, f.return_type)
    b = write_tstatements(b, t, f.body)
    b = write_u8(b, vis_byte(f.vis))
    b = write_u8(b, (if f.has_doc { 1 } else { 0 }) to byte)
    b = write_u32(b, st_find(t, f.namespace))
    b = write_u32(b, st_find(t, f.file))
    b = write_u32(b, f.line)
    b = write_u32(b, f.col)
    b = write_u8(b, (if f.is_test { 1 } else { 0 }) to byte)
    b = write_u8(b, (if f.is_extern { 1 } else { 0 }) to byte)
    b = write_u32(b, st_find(t, f.c_symbol))
    write_u32(b, st_find(t, f.from_lib))
}

fn write_tconstdecl(buf: Wb, t: StrTable, c: checker::TConstDecl): Wb | error {
    match c.guard.kind {
        parser::PTrue => { }
        _ => return error { message = $"a target-conditional const ('{c.namespace}::{c.name}') cannot cross a module boundary yet" }
    }
    var b = write_u32(write_u32(buf, st_find(t, c.name)), st_find(t, c.namespace))
    b = write_type(b, t, c.ty)
    b = write_texpr(b, t, c.init)
    b = write_u8(b, vis_byte(c.vis))
    b = write_u8(b, (if c.has_doc { 1 } else { 0 }) to byte)
    b = write_u32(b, c.line)
    write_u32(b, c.col)
}

fn write_titem(buf: Wb, t: StrTable, it: @TItem()): Wb | error {
    match it {
        checker::TFunction as f => write_tfunction(write_u8(buf, 0), t, f)
        parser::TypeDecl as d => write_typedecl(write_u8(buf, 1), t, d)
        parser::UseDecl as u => write_usedecl(write_u8(buf, 2), t, u)
        (@TStatement()) as s => write_tstatement(write_u8(buf, 3), t, s)
        checker::TConstDecl as c => write_tconstdecl(write_u8(buf, 4), t, c)
    }
}

fn write_program(buf: Wb, t: StrTable, prog: checker::TProgram): Wb | error {
    var b = write_u64(buf, prog.items.len)
    var i = 0
    loop {
        if i >= prog.items.len { break }
        b = match write_titem(b, t, prog.items[i]) { Wb as o => o; error as e => return e }
        i++
    }
    b
}


fn write_pexpr(buf: Wb, t: StrTable, e: parser::Expr): Wb {
    match e.kind {
        parser::Number as n => write_u64(write_u64(write_u64(write_u8(write_u8(buf, 0), (if n.is_float { 1 } else { 0 }) to byte), numint_hi(n.value)), numint_lo(n.value)), teko::f64_bits(n.fval))
        parser::StrLit as s => write_u32(write_u8(buf, 1), st_find(t, s.text))
        parser::ByteLit as bl => write_u8(write_u8(buf, 2), bl.value)
        parser::ByteStrLit as bs => write_u32(write_u8(buf, 3), st_find(t, bs.text))
        _ => write_u8(buf, 255)
    }
}

fn write_patterns(buf: Wb, t: StrTable, xs: []@Pattern()): Wb {
    var b = write_u64(buf, xs.len)
    var i = 0
    loop { if i >= xs.len { break }; b = write_pattern(b, t, xs[i]); i++ }
    b
}

fn write_pattern(buf: Wb, t: StrTable, p: @Pattern()): Wb {
    match p {
        parser::LiteralPattern as l => write_pexpr(write_u8(buf, 0), t, l.value)
        parser::RangePattern as r => write_pexpr(write_pexpr(write_u8(buf, 1), t, r.lo), t, r.hi)
        parser::AltPattern as a => write_patterns(write_u8(buf, 2), t, a.options)
        parser::BindPattern as bp => {
            var b = write_path(write_u8(buf, 3), t, bp.type_name)
            b = write_u8(b, (if bp.has_binding { 1 } else { 0 }) to byte)
            b = write_u32(b, st_find(t, bp.binding))
            b = write_u8(b, (if bp.is_slice { 1 } else { 0 }) to byte)
            match bp.slice_type {
                (@TypeExpr()) as st => write_typeexpr(write_u8(b, 1), t, st)
                null => write_u8(b, 0)
            }
        }
        parser::FieldPattern as f => write_strs(write_path(write_u8(buf, 4), t, f.type_name), t, f.fields)
        parser::WildcardPattern => write_u8(buf, 5)
        parser::NullPattern => write_u8(buf, 6)
        parser::GroupBindPattern as gp => write_u32(write_patterns(write_u8(buf, 7), t, gp.options), st_find(t, gp.binding))
        parser::MacroPattern => buf
    }
}

fn write_tarms(buf: Wb, t: StrTable, xs: []checker::TArm): Wb {
    var b = write_u64(buf, xs.len)
    var i = 0
    loop { if i >= xs.len { break }; b = write_tarm(b, t, xs[i]); i++ }
    b
}

fn write_tarm(buf: Wb, t: StrTable, a: checker::TArm): Wb {
    var b = write_pattern(buf, t, a.pattern)
    b = write_u8(b, (if a.has_when { 1 } else { 0 }) to byte)
    if a.has_when { b = write_texpr(b, t, a.guard) }
    write_tstatements(b, t, a.body)
}
