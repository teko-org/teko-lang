
fn lo8(x: u32): byte { (x & 0xFF) to byte }

type Wb = struct { data: []byte; len: u64 }

fn wb_new(): Wb { Wb { data = []; len = 0 } }

fn wb_grow(b: Wb, need: u64): Wb {
    if b.len + need <= b.data.len { return b }
    var cap = if b.data.len == 0 { 256 } else { b.data.len }
    loop { if cap >= b.len + need { break }; cap = cap * 2 }
    var nd: [cap]byte = []
    var i: u64 = 0
    loop { if i >= b.len { break }; nd[i] = b.data[i]; i++ }
    Wb { data = nd; len = b.len }
}

fn wb_flat(b: Wb): []byte {
    var out: [b.len]byte = []
    var i: u64 = 0
    loop { if i >= b.len { break }; out[i] = b.data[i]; i++ }
    out
}

fn write_u8(buf: Wb, x: byte): Wb {
    var b = wb_grow(buf, 1)
    b.data[b.len] = x
    Wb { data = b.data; len = b.len + 1 }
}

fn wb_append(buf: Wb, src: []byte): Wb {
    var b = wb_grow(buf, src.len)
    var i: u64 = 0
    loop { if i >= src.len { break }; b.data[b.len + i] = src[i]; i++ }
    Wb { data = b.data; len = b.len + src.len }
}

fn write_u32(buf: Wb, x: u32): Wb {
    var b = write_u8(buf, lo8(x))
    b = write_u8(b, lo8(x >> 8))
    b = write_u8(b, lo8(x >> 16))
    b = write_u8(b, lo8(x >> 24))
    b
}

fn write_u64(buf: Wb, x: u64): Wb {
    var b = write_u32(buf, (x & 0xFFFFFFFF) to u32)
    b = write_u32(b, (x >> 32) to u32)
    b
}

fn write_i64(buf: Wb, x: i64): Wb {
    var b = buf
    var bits = x to u64
    var k = 0
    loop {
        if k >= 8 { break }
        b = write_u8(b, lo8((bits & 0xFF) to u32))
        bits = bits >> 8
        k++
    }
    b
}

fn write_bytes(buf: Wb, s: str): Wb {
    var b = write_u32(buf, s.len to u32)
    var i = 0
    loop {
        if i >= s.len { break }
        b = write_u8(b, s[i])
        i++
    }
    b
}


type StrTable = struct { strings: []str }
type Interned = struct { table: StrTable; index: u32 }

fn st_empty(): StrTable { StrTable { strings = [] } }

fn st_find(t: StrTable, s: str): u32 {
    var i = 0
    loop {
        if i >= t.strings.len { break }
        if t.strings[i] == s { return i to u32 }
        i++
    }
    0xFFFFFFFF
}

fn st_intern(t: StrTable, s: str): Interned {
    var found = st_find(t, s)
    if found != 0xFFFFFFFF { return Interned { table = t; index = found } }
    var idx = t.strings.len to u32
    Interned { table = StrTable { strings = [..t.strings, s] }; index = idx }
}

fn write_strtable(buf: Wb, t: StrTable): Wb {
    var b = write_u32(buf, t.strings.len to u32)
    var i = 0
    loop {
        if i >= t.strings.len { break }
        b = write_bytes(b, t.strings[i])
        i++
    }
    b
}


fn fnv1a(data: []byte, start: u64): u64 {
    var h: u64 = 0xCBF29CE484222325
    var i = start
    loop {
        if i >= data.len { break }
        h = h ^ (data[i] to u64)
        h = h * 0x100000001B3
        i++
    }
    h
}
