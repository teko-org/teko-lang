fn merge_ord<T: IOrd>(left: []T, right: []T): []T {
    var n = left.len + right.len
    var out: [n]T = []
    var i: u64 = 0
    var j: u64 = 0
    var k: u64 = 0
    loop {
        if i >= left.len { break }
        if j >= right.len { break }
        if left[i] <= right[j] {
            out[k] = left[i]
            i++
            k++
            continue
        }
        out[k] = right[j]
        j++
        k++
    }
    loop { if i >= left.len { break }; out[k] = left[i]; i++; k++ }
    loop { if j >= right.len { break }; out[k] = right[j]; j++; k++ }
    out
}

fn msort_ord<T: IOrd>(xs: []T, lo: u64, hi: u64): []T {
    var out: []T = []
    if hi - lo <= 1 {
        if hi - lo == 1 { out = [xs[lo]] }
        return out
    }
    var mid = lo + (hi - lo) / 2
    var left = msort_ord(xs, lo, mid)
    var right = msort_ord(xs, mid, hi)
    merge_ord(left, right)
}

/** Sorts `xs` ascending, stably, ordering any `IOrd`-conforming element type `T`. */
exp fn sort<T: IOrd>(xs: []T): []T {
    msort_ord(xs, 0, xs.len)
}
