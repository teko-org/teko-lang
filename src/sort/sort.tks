fn cmp_str_mode(a: str, b: str, natural: bool): i32 {
    if natural { return teko::sort::cmp_natural(a, b) }
    teko::sort::cmp(a, b)
}

fn merge_str(left: []str, right: []str, natural: bool): []str {
    var n = left.len + right.len
    var out: [n]str = []
    var i: u64 = 0
    var j: u64 = 0
    var k: u64 = 0
    loop {
        if i >= left.len { break }
        if j >= right.len { break }
        if cmp_str_mode(left[i], right[j], natural) <= 0 {
            out[k] = left[i]
            i++
            k++
            continue
        }
        out[k] = right[j]
        j++
        k++
    }
    loop { if i >= left.len { break }; out[k] = left[i]; i++; k++ }
    loop { if j >= right.len { break }; out[k] = right[j]; j++; k++ }
    out
}

fn msort_str(xs: []str, lo: u64, hi: u64, natural: bool): []str {
    var out: []str = []
    if hi - lo <= 1 {
        if hi - lo == 1 { out = [xs[lo]] }
        return out
    }
    var mid = lo + (hi - lo) / 2
    var left = msort_str(xs, lo, mid, natural)
    var right = msort_str(xs, mid, hi, natural)
    merge_str(left, right, natural)
}

/** Sorts `xs` ascending, stably, under lexicographic byte order. */
exp fn sort_str(xs: []str): []str {
    msort_str(xs, 0, xs.len, false)
}

/** Sorts `xs` ascending, stably, under natural/ordinal order (`"file2"` before `"file10"`). */
exp fn sort_str_natural(xs: []str): []str {
    msort_str(xs, 0, xs.len, true)
}

fn merge_i64(left: []i64, right: []i64): []i64 {
    var n = left.len + right.len
    var out: [n]i64 = []
    var i: u64 = 0
    var j: u64 = 0
    var k: u64 = 0
    loop {
        if i >= left.len { break }
        if j >= right.len { break }
        if left[i] <= right[j] {
            out[k] = left[i]
            i++
            k++
            continue
        }
        out[k] = right[j]
        j++
        k++
    }
    loop { if i >= left.len { break }; out[k] = left[i]; i++; k++ }
    loop { if j >= right.len { break }; out[k] = right[j]; j++; k++ }
    out
}

fn msort_i64(xs: []i64, lo: u64, hi: u64): []i64 {
    var out: []i64 = []
    if hi - lo <= 1 {
        if hi - lo == 1 { out = [xs[lo]] }
        return out
    }
    var mid = lo + (hi - lo) / 2
    var left = msort_i64(xs, lo, mid)
    var right = msort_i64(xs, mid, hi)
    merge_i64(left, right)
}

/** Sorts `xs` ascending, stably, under the native signed order. */
exp fn sort_i64(xs: []i64): []i64 {
    msort_i64(xs, 0, xs.len)
}

