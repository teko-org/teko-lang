fn merge_f64(left: []f64, right: []f64): []f64 {
    var n = left.len + right.len
    var out: [n]f64 = []
    var i: u64 = 0
    var j: u64 = 0
    var k: u64 = 0
    loop {
        if i >= left.len { break }
        if j >= right.len { break }
        if teko::sort::cmp_f64(left[i], right[j]) <= 0 {
            out[k] = left[i]
            i++
            k++
            continue
        }
        out[k] = right[j]
        j++
        k++
    }
    loop { if i >= left.len { break }; out[k] = left[i]; i++; k++ }
    loop { if j >= right.len { break }; out[k] = right[j]; j++; k++ }
    out
}

fn msort_f64(xs: []f64, lo: u64, hi: u64): []f64 {
    var out: []f64 = []
    if hi - lo <= 1 {
        if hi - lo == 1 { out = [xs[lo]] }
        return out
    }
    var mid = lo + (hi - lo) / 2
    var left = msort_f64(xs, lo, mid)
    var right = msort_f64(xs, mid, hi)
    merge_f64(left, right)
}

/** Sorts `xs` ascending, stably, under `cmp_f64`'s NaN-last total order. */
exp fn sort_f64(xs: []f64): []f64 {
    msort_f64(xs, 0, xs.len)
}

fn merge_bytes(left: []byte, right: []byte): []byte {
    var n = left.len + right.len
    var out: [n]byte = []
    var i: u64 = 0
    var j: u64 = 0
    var k: u64 = 0
    loop {
        if i >= left.len { break }
        if j >= right.len { break }
        if left[i] <= right[j] {
            out[k] = left[i]
            i++
            k++
            continue
        }
        out[k] = right[j]
        j++
        k++
