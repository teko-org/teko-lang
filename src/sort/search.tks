    lo
}

/** True iff `xs` is sorted ascending under `cmp_f64`'s NaN-last total order. */
exp fn is_sorted_f64(xs: []f64): bool {
    var i: u64 = 0
    loop {
        if i + 1 >= xs.len { break }
        if teko::sort::cmp_f64(xs[i], xs[i + 1]) > 0 { return false }
        i++
    }
    true
}

/** Binary search for `key` in `xs` under `cmp_f64`'s NaN-last total order; `xs` must already be sorted. */
exp fn bsearch_f64(xs: []f64, key: f64): u64 | null {
    var lo: u64 = 0
    var hi: u64 = xs.len
    loop {
        if lo >= hi { break }
        var mid = lo + (hi - lo) / 2
        var c = teko::sort::cmp_f64(xs[mid], key)
        if c < 0 { lo = mid + 1; continue }
        if c > 0 { hi = mid; continue }
        return mid
    }
    null
}

/** Smallest index `i` in `xs` (partitioned by `pred`) where `pred(xs[i])` is false; `xs.len` if none. */
exp fn partition_point_f64(xs: []f64, pred: func<f64, bool>): u64 {
    var lo: u64 = 0
    var hi: u64 = xs.len
    loop {
        if lo >= hi { break }
        var mid = lo + (hi - lo) / 2
        if pred(xs[mid]) { lo = mid + 1; continue }
        hi = mid
    }
    lo
}

/** True iff `xs` is sorted ascending under `cmp`'s lexicographic byte order. */
exp fn is_sorted_str(xs: []str): bool {
    var i: u64 = 0
    loop {
        if i + 1 >= xs.len { break }
        if teko::sort::cmp(xs[i], xs[i + 1]) > 0 { return false }
        i++
    }
    true
}

/** Binary search for `key` in `xs` under `cmp`'s lexicographic byte order; `xs` must already be sorted. */
exp fn bsearch_str(xs: []str, key: str): u64 | null {
    var lo: u64 = 0
    var hi: u64 = xs.len
    loop {
        if lo >= hi { break }
        var mid = lo + (hi - lo) / 2
        var c = teko::sort::cmp(xs[mid], key)
        if c < 0 { lo = mid + 1; continue }
        if c > 0 { hi = mid; continue }
        return mid
    }
    null
}

/** Smallest index `i` in `xs` (partitioned by `pred`) where `pred(xs[i])` is false; `xs.len` if none. */
exp fn partition_point_str(xs: []str, pred: func<str, bool>): u64 {
    var lo: u64 = 0
    var hi: u64 = xs.len
    loop {
        if lo >= hi { break }
        var mid = lo + (hi - lo) / 2
        if pred(xs[mid]) { lo = mid + 1; continue }
        hi = mid
    }
    lo
}

/** True iff `xs` is sorted ascending as unsigned octets. */
exp fn is_sorted_bytes(xs: []byte): bool {
    var i: u64 = 0
    loop {
        if i + 1 >= xs.len { break }
        if xs[i] > xs[i + 1] { return false }
        i++
    }
    true
}

/** Binary search for `key` in `xs`, which must already be sorted ascending. */
exp fn bsearch_bytes(xs: []byte, key: byte): u64 | null {
    var lo: u64 = 0
    var hi: u64 = xs.len
    loop {
        if lo >= hi { break }
        var mid = lo + (hi - lo) / 2
        if xs[mid] < key { lo = mid + 1; continue }
        if xs[mid] > key { hi = mid; continue }
        return mid
