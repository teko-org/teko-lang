/** True iff `xs` is sorted ascending under the native signed order. */
exp fn is_sorted_i64(xs: []i64): bool {
    var i: u64 = 0
    loop {
        if i + 1 >= xs.len { break }
        if xs[i] > xs[i + 1] { return false }
        i++
    }
    true
}

/** Binary search for `key` in `xs`, which must already be sorted ascending. */
exp fn bsearch_i64(xs: []i64, key: i64): u64 | null {
    var lo: u64 = 0
    var hi: u64 = xs.len
    loop {
        if lo >= hi { break }
        var mid = lo + (hi - lo) / 2
        if xs[mid] < key { lo = mid + 1; continue }
        if xs[mid] > key { hi = mid; continue }
        return mid
    }
    null
}

/** Smallest index `i` in `xs` (partitioned by `pred`) where `pred(xs[i])` is false; `xs.len` if none. */
exp fn partition_point_i64(xs: []i64, pred: func<i64, bool>): u64 {
    var lo: u64 = 0
    var hi: u64 = xs.len
    loop {
        if lo >= hi { break }
        var mid = lo + (hi - lo) / 2
        if pred(xs[mid]) { lo = mid + 1; continue }
        hi = mid
    }
    lo
}

/** True iff `xs` is sorted ascending under the native unsigned order. */
exp fn is_sorted_u64(xs: []u64): bool {
    var i: u64 = 0
    loop {
        if i + 1 >= xs.len { break }
        if xs[i] > xs[i + 1] { return false }
        i++
    }
    true
}

/** Binary search for `key` in `xs`, which must already be sorted ascending. */
exp fn bsearch_u64(xs: []u64, key: u64): u64 | null {
