}

/** Smallest index `i` in `xs` (partitioned by `pred`) where `pred(xs[i])` is false; `xs.len` if none. */
exp fn partition_point_u64(xs: []u64, pred: func<u64, bool>): u64 {
    var lo: u64 = 0
    var hi: u64 = xs.len
    loop {
