    null
}

/** Smallest index `i` in `xs` (partitioned by `pred`) where `pred(xs[i])` is false; `xs.len` if none. */
exp fn partition_point_bytes(xs: []byte, pred: func<byte, bool>): u64 {
    var lo: u64 = 0
    var hi: u64 = xs.len
    loop {
        if lo >= hi { break }
        var mid = lo + (hi - lo) / 2
        if pred(xs[mid]) { lo = mid + 1; continue }
        hi = mid
