fn quickselect_i64(xs: []i64, k: u64): i64 {
    if xs.len == 1 { return xs[0] }
    var pivot = xs[xs.len / 2]
    var less: [xs.len]i64 = []
    var equal: [xs.len]i64 = []
    var greater: [xs.len]i64 = []
    var nl: u64 = 0
    var ne: u64 = 0
    var ng: u64 = 0
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] < pivot { less[nl] = xs[i]; nl++; i++; continue }
        if xs[i] > pivot { greater[ng] = xs[i]; ng++; i++; continue }
        equal[ne] = xs[i]
        ne++
        i++
    }
    if k < nl { return quickselect_i64(teko::collections::arr_slice(less, 0, nl), k) }
    if k < nl + ne { return pivot }
    quickselect_i64(teko::collections::arr_slice(greater, 0, ng), k - nl - ne)
}

/** The k-th smallest element (0-indexed) of `xs` under the native signed order. */
exp fn nth_i64(xs: []i64, k: u64): i64 {
    if k >= xs.len { panic("teko::sort::nth_i64: k is out of range") }
    quickselect_i64(xs, k)
}

fn quickselect_u64(xs: []u64, k: u64): u64 {
    if xs.len == 1 { return xs[0] }
    var pivot = xs[xs.len / 2]
    var less: [xs.len]u64 = []
    var equal: [xs.len]u64 = []
    var greater: [xs.len]u64 = []
    var nl: u64 = 0
    var ne: u64 = 0
    var ng: u64 = 0
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] < pivot { less[nl] = xs[i]; nl++; i++; continue }
        if xs[i] > pivot { greater[ng] = xs[i]; ng++; i++; continue }
        equal[ne] = xs[i]
        ne++
        i++
    }
    if k < nl { return quickselect_u64(teko::collections::arr_slice(less, 0, nl), k) }
    if k < nl + ne { return pivot }
    quickselect_u64(teko::collections::arr_slice(greater, 0, ng), k - nl - ne)
}

/** The k-th smallest element (0-indexed) of `xs` under the native unsigned order. */
exp fn nth_u64(xs: []u64, k: u64): u64 {
    if k >= xs.len { panic("teko::sort::nth_u64: k is out of range") }
    quickselect_u64(xs, k)
}

fn quickselect_f64(xs: []f64, k: u64): f64 {
    if xs.len == 1 { return xs[0] }
    var pivot = xs[xs.len / 2]
    var less: [xs.len]f64 = []
    var equal: [xs.len]f64 = []
    var greater: [xs.len]f64 = []
    var nl: u64 = 0
    var ne: u64 = 0
    var ng: u64 = 0
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        var c = teko::sort::cmp_f64(xs[i], pivot)
        if c < 0 { less[nl] = xs[i]; nl++; i++; continue }
        if c > 0 { greater[ng] = xs[i]; ng++; i++; continue }
        equal[ne] = xs[i]
        ne++
        i++
    }
    if k < nl { return quickselect_f64(teko::collections::arr_slice(less, 0, nl), k) }
    if k < nl + ne { return pivot }
    quickselect_f64(teko::collections::arr_slice(greater, 0, ng), k - nl - ne)
}

/** The k-th smallest element (0-indexed) of `xs` under `cmp_f64`'s NaN-last total order. */
exp fn nth_f64(xs: []f64, k: u64): f64 {
    if k >= xs.len { panic("teko::sort::nth_f64: k is out of range") }
    quickselect_f64(xs, k)
}

fn quickselect_str(xs: []str, k: u64): str {
    if xs.len == 1 { return xs[0] }
    var pivot = xs[xs.len / 2]
    var less: [xs.len]str = []
    var equal: [xs.len]str = []
    var greater: [xs.len]str = []
    var nl: u64 = 0
    var ne: u64 = 0
    var ng: u64 = 0
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        var c = teko::sort::cmp(xs[i], pivot)
        if c < 0 { less[nl] = xs[i]; nl++; i++; continue }
        if c > 0 { greater[ng] = xs[i]; ng++; i++; continue }
        equal[ne] = xs[i]
        ne++
        i++
    }
    if k < nl { return quickselect_str(teko::collections::arr_slice(less, 0, nl), k) }
    if k < nl + ne { return pivot }
    quickselect_str(teko::collections::arr_slice(greater, 0, ng), k - nl - ne)
}

/** The k-th smallest string (0-indexed) of `xs` under `cmp`'s lexicographic byte order. */
exp fn nth_str(xs: []str, k: u64): str {
    if k >= xs.len { panic("teko::sort::nth_str: k is out of range") }
    quickselect_str(xs, k)
}

fn quickselect_bytes(xs: []byte, k: u64): byte {
    if xs.len == 1 { return xs[0] }
    var pivot = xs[xs.len / 2]
    var less: [xs.len]byte = []
    var equal: [xs.len]byte = []
    var greater: [xs.len]byte = []
    var nl: u64 = 0
    var ne: u64 = 0
    var ng: u64 = 0
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] < pivot { less[nl] = xs[i]; nl++; i++; continue }
        if xs[i] > pivot { greater[ng] = xs[i]; ng++; i++; continue }
        equal[ne] = xs[i]
        ne++
        i++
    }
    if k < nl { return quickselect_bytes(teko::collections::arr_slice(less, 0, nl), k) }
    if k < nl + ne { return pivot }
    quickselect_bytes(teko::collections::arr_slice(greater, 0, ng), k - nl - ne)
}

/** The k-th smallest byte (0-indexed) of `xs` under the native unsigned octet order. */
exp fn nth_bytes(xs: []byte, k: u64): byte {
    if k >= xs.len { panic("teko::sort::nth_bytes: k is out of range") }
    quickselect_bytes(xs, k)
}
