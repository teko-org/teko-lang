use teko::numeric::bigint

/**
 * A point on the Ed25519 twisted Edwards curve, in affine coordinates. Unlike the short
 * Weierstrass curves, this curve is complete — its group identity `(0, 1)` is an ordinary point,
 * so no separate "point at infinity" flag is needed.
 */
exp type Ed25519Point = struct {
    /** the affine X coordinate, in `[0, p)` */
    x: bigint::BigInt
    /** the affine Y coordinate, in `[0, p)` */
    y: bigint::BigInt
}

fn ed25519_const_of_dec(dec: str): bigint::BigInt {
    match bigint::from_dec_str(dec) {
        bigint::BigInt as b => b
        error as e => panic(e.message)
    }
}

fn ed25519_prime(): bigint::BigInt {
    bigint::sub(bigint::shl(bigint::one(), 255), bigint::of(19))
}

fn ed25519_order(): bigint::BigInt {
    bigint::add(bigint::shl(bigint::one(), 252), ed25519_const_of_dec("27742317777372353535851937790883648493"))
}

fn ed25519_reduce_p(x: bigint::BigInt): bigint::BigInt {
    match bigint::modulo(x, ed25519_prime()) {
        bigint::BigInt as b => b
        error as e => panic(e.message)
    }
}

fn ed25519_reduce_l(x: bigint::BigInt): bigint::BigInt {
    match bigint::modulo(x, ed25519_order()) {
        bigint::BigInt as b => b
        error as e => panic(e.message)
    }
}

fn ed25519_fadd(x: bigint::BigInt, y: bigint::BigInt): bigint::BigInt {
    ed25519_reduce_p(bigint::add(x, y))
}

fn ed25519_fsub(x: bigint::BigInt, y: bigint::BigInt): bigint::BigInt {
    ed25519_reduce_p(bigint::sub(x, y))
}

fn ed25519_fmul(x: bigint::BigInt, y: bigint::BigInt): bigint::BigInt {
    ed25519_reduce_p(bigint::mul(x, y))
}

fn ed25519_finv(x: bigint::BigInt): bigint::BigInt {
    match bigint::mod_inverse(x, ed25519_prime()) {
        bigint::BigInt as b => b
        error as e => panic(e.message)
    }
}

fn ed25519_fpow(ground: bigint::BigInt, exponent: bigint::BigInt): bigint::BigInt {
    match bigint::mod_pow(ground, exponent, ed25519_prime()) {
        bigint::BigInt as b => b
        error as e => panic(e.message)
    }
}

fn ed25519_d(): bigint::BigInt {
    var numerator = ed25519_reduce_p(bigint::neg(bigint::of(121665)))
    ed25519_fmul(numerator, ed25519_finv(bigint::of(121666)))
}

fn ed25519_sqrt_m1(): bigint::BigInt {
    var exponent = bigint::shr(bigint::sub(ed25519_prime(), bigint::one()), 2)
    ed25519_fpow(bigint::of(2), exponent)
}

fn ed25519_recover_x(y: bigint::BigInt, sign: u64): bigint::BigInt | CryptoError {
    var y2 = ed25519_fmul(y, y)
    var u = ed25519_fsub(y2, bigint::one())
    var v = ed25519_fadd(ed25519_fmul(ed25519_d(), y2), bigint::one())
    var v3 = ed25519_fpow(v, bigint::of(3))
    var v7 = ed25519_fpow(v, bigint::of(7))
    var uv7_exp = bigint::shr(bigint::sub(ed25519_prime(), bigint::of(5)), 3)
    var candidate = ed25519_fmul(ed25519_fmul(u, v3), ed25519_fpow(ed25519_fmul(u, v7), uv7_exp))
    var check = ed25519_fmul(v, ed25519_fmul(candidate, candidate))
    if !bigint::eq(check, u) {
        candidate = ed25519_fmul(candidate, ed25519_sqrt_m1())
        var check2 = ed25519_fmul(v, ed25519_fmul(candidate, candidate))
        if !bigint::eq(check2, u) {
            return crypto_error("ed25519_recover_x: no square root exists for this Y coordinate")
        }
    }
    var is_zero_x = bigint::is_zero(candidate)
    if is_zero_x && sign == 1 {
        return crypto_error("ed25519_recover_x: zero X coordinate cannot carry the odd sign bit")
    }
    var candidate_is_odd = !bigint::is_even(candidate)
    var candidate_sign = if candidate_is_odd { 1 to u64 } else { 0 to u64 }
    if candidate_sign != sign { return ed25519_fsub(bigint::zero(), candidate) }
    candidate
}

fn ed25519_base_point(): Ed25519Point {
    var by = ed25519_fmul(bigint::of(4), ed25519_finv(bigint::of(5)))
    var bx = match ed25519_recover_x(by, 0) {
        bigint::BigInt as x => x
        CryptoError as e => panic(e.message)
    }
    Ed25519Point { x = bx; y = by }
}

fn ed25519_identity(): Ed25519Point {
    Ed25519Point { x = bigint::zero(); y = bigint::one() }
}

fn ed25519_point_add(p: Ed25519Point, q: Ed25519Point): Ed25519Point {
    var d = ed25519_d()
    var cross = ed25519_fmul(ed25519_fmul(d, p.x), ed25519_fmul(p.y, ed25519_fmul(q.x, q.y)))
    var x_numerator = ed25519_fadd(ed25519_fmul(p.x, q.y), ed25519_fmul(p.y, q.x))
    var y_numerator = ed25519_fadd(ed25519_fmul(p.y, q.y), ed25519_fmul(p.x, q.x))
    var x3 = ed25519_fmul(x_numerator, ed25519_finv(ed25519_fadd(bigint::one(), cross)))
    var y3 = ed25519_fmul(y_numerator, ed25519_finv(ed25519_fsub(bigint::one(), cross)))
    Ed25519Point { x = x3; y = y3 }
}

fn ed25519_scalar_mul(k: bigint::BigInt, p: Ed25519Point): Ed25519Point {
    var result = ed25519_identity()
    var addend = p
    var exponent = k
    loop {
        if bigint::is_zero(exponent) { break }
        if !bigint::is_even(exponent) { result = ed25519_point_add(result, addend) }
        addend = ed25519_point_add(addend, addend)
        exponent = bigint::shr(exponent, 1)
    }
    result
}

fn ed25519_bytes_concat(a: []byte, b: []byte): []byte {
    [..a, ..b]
}

fn ed25519_bytes_slice(data: []byte, from: u64, to: u64): []byte {
    var n = to - from
    var out: [n]byte = []
    var i: u64 = 0
    loop {
        if i >= n { break }
        out[i] = data[from + i]
        i++
    }
    out
}

fn ed25519_bytes_reverse(data: []byte): []byte {
    var out: [data.len]byte = []
    var i: u64 = 0
    loop {
        if i >= data.len { break }
        out[i] = data[data.len - 1 - i]
        i++
    }
    out
}

fn ed25519_from_bytes_le(data: []byte): bigint::BigInt {
    bigint::from_bytes_be(ed25519_bytes_reverse(data))
}

fn ed25519_to_bytes_le_32(x: bigint::BigInt): []byte {
    var be = match bigint::to_bytes_be_padded(x, 32) {
        []byte as b => b
        error as e => panic(e.message)
    }
    ed25519_bytes_reverse(be)
}

fn ed25519_compress(p: Ed25519Point): []byte {
    var y_bytes = ed25519_to_bytes_le_32(p.y)
    var sign_bit: u32 = if bigint::is_even(p.x) { 0 } else { 1 }
    var out: [32]byte = []
    var i: u64 = 0
    loop {
        if i >= 31 { break }
        out[i] = y_bytes[i]
        i++
    }
    out[31] = ((y_bytes[31] to u32) | (sign_bit << 7)) to byte
    out
}

fn ed25519_decompress(bytes: []byte): Ed25519Point | CryptoError {
    if bytes.len != 32 {
        return crypto_error("ed25519_decompress: expected a 32-byte compressed point")
    }
    var sign = ((bytes[31] to u32) >> 7) & 1
    var y_bytes = ed25519_bytes_concat(ed25519_bytes_slice(bytes, 0, 31), [((bytes[31] to u32) & 0x7f) to byte])
    var y = ed25519_from_bytes_le(y_bytes)
    var x = match ed25519_recover_x(y, sign to u64) {
        bigint::BigInt as v => v
        CryptoError as e => return e
    }
    Ed25519Point { x = x; y = y }
}

fn ed25519_clamp(seed_bytes: []byte): []byte {
    var out: [32]byte = []
    var i: u64 = 0
    loop {
        if i >= 32 { break }
        var v = seed_bytes[i] to u32
        if i == 0 { v = v & 0xf8 }
        if i == 31 { v = (v & 0x7f) | 0x40 }
        out[i] = v to byte
        i++
    }
    out
}

/**
 * Derives the Ed25519 public key from a 32-byte secret key seed (RFC 8032 §5.1.5): hashes the
 * seed with SHA-512, clamps the low half into the private scalar `a`, and compresses `a*B`.
 */
exp fn ed25519_public_key_from_secret(secret_key_32: []byte): []byte | CryptoError {
    if secret_key_32.len != 32 {
        return crypto_error("ed25519_public_key_from_secret: secret key must be 32 bytes")
    }
    var h = sha512_of(secret_key_32)
    var a = ed25519_from_bytes_le(ed25519_clamp(ed25519_bytes_slice(h, 0, 32)))
    ed25519_compress(ed25519_scalar_mul(a, ed25519_base_point()))
}

/**
 * Ed25519 signature generation (RFC 8032 §5.1.6, PureEdDSA — the message is signed directly, with
 * no pre-hashing/context beyond the algorithm's own internal SHA-512 uses): derives the private
 * scalar `a` and public key `A` from the secret key seed, derives the deterministic nonce
 * `r = SHA-512(prefix || message) mod L`, and assembles `R || S` where `R = compress(r*B)` and
 * `S = (r + SHA-512(R||A||message)*a) mod L`.
 */
exp fn ed25519_sign(secret_key_32: []byte, message: []byte): []byte | CryptoError {
    if secret_key_32.len != 32 {
        return crypto_error("ed25519_sign: secret key must be 32 bytes")
    }
    var h = sha512_of(secret_key_32)
    var a_bytes = ed25519_clamp(ed25519_bytes_slice(h, 0, 32))
    var a = ed25519_from_bytes_le(a_bytes)
    var prefix = ed25519_bytes_slice(h, 32, 64)
    var a_point_enc = ed25519_compress(ed25519_scalar_mul(a, ed25519_base_point()))
    var r = ed25519_reduce_l(ed25519_from_bytes_le(sha512_of(ed25519_bytes_concat(prefix, message))))
    var r_point_enc = ed25519_compress(ed25519_scalar_mul(r, ed25519_base_point()))
    var k = ed25519_reduce_l(ed25519_from_bytes_le(sha512_of(ed25519_bytes_concat(ed25519_bytes_concat(r_point_enc, a_point_enc), message))))
    var s = ed25519_reduce_l(bigint::add(r, ed25519_reduce_l(bigint::mul(k, a))))
    ed25519_bytes_concat(r_point_enc, ed25519_to_bytes_le_32(s))
}

/**
 * Ed25519 signature verification (RFC 8032 §5.1.7): decodes the public key and the signature's
 * `R` component (rejecting either if it fails point decompression), rejects `S` outside
 * `[0, L)`, recomputes `k = SHA-512(R||A||message) mod L`, and checks `S*B == R + k*A`. Never
 * panics — every structural failure simply yields `false`.
 */
exp fn ed25519_verify(public_key_32: []byte, message: []byte, sig_64: []byte): bool {
    if public_key_32.len != 32 || sig_64.len != 64 { return false }
    var a_point = match ed25519_decompress(public_key_32) {
        Ed25519Point as p => p
        CryptoError => return false
    }
    var r_enc = ed25519_bytes_slice(sig_64, 0, 32)
    var r_point = match ed25519_decompress(r_enc) {
        Ed25519Point as p => p
        CryptoError => return false
    }
    var s = ed25519_from_bytes_le(ed25519_bytes_slice(sig_64, 32, 64))
    if bigint::is_neg(s) || bigint::cmp(s, ed25519_order()) >= 0 { return false }
    var k = ed25519_reduce_l(ed25519_from_bytes_le(sha512_of(ed25519_bytes_concat(ed25519_bytes_concat(r_enc, public_key_32), message))))
    var lhs = ed25519_scalar_mul(s, ed25519_base_point())
    var rhs = ed25519_point_add(r_point, ed25519_scalar_mul(k, a_point))
    bigint::eq(lhs.x, rhs.x) && bigint::eq(lhs.y, rhs.y)
}
