
pub fn flatten_canonical(namespace: str, name: str): str {
    if namespace.len == 0 { return name }
    teko::str::concat(ffi_flatten_seps(namespace), "_", name)
}

fn ffi_flatten_seps(s: str): str {
    var outlen: u64 = 0
    var i: u64 = 0
    loop {
        if i >= s.len { break }
        if i + 1 < s.len && s[i] == b':' && s[i + 1] == b':' { outlen = outlen + 1; i = i + 2 } else { outlen = outlen + 1; i++ }
    }
    var out: [outlen]byte = []
    i = 0
    var k: u64 = 0
    loop {
        if i >= s.len { break }
        if i + 1 < s.len && s[i] == b':' && s[i + 1] == b':' {
            out[k] = b'_'; k++
            i = i + 2
        } else {
            out[k] = s[i]; k++
            i++
        }
    }
    str_of_bytes(out)
}

pub fn cg_c_export_symbol(f: checker::TFunction): str {
    if f.c_symbol != "" { return f.c_symbol }
    flatten_canonical(f.namespace, f.name)
}

fn ffi_ctype_of_type(t: @Type()): str | error {
    match t {
        checker::Void => "void"
        checker::Prim as p => ffi_c_scalar(ffi_prim_name(p.kind))
        checker::Byte => "uint8_t"
        _ => error { message = "return type is not FFI-safe for export (only fixed-width scalars and `void` cross the C ABI)" }
    }
}

fn ffi_ctype_of_typeexpr(te: @TypeExpr()): str | error {
    match te {
        parser::NamedType as nt => ffi_c_scalar(cg_path_last(nt.path))
        _ => error { message = "parameter type is not FFI-safe for export (only fixed-width scalars cross the C ABI in the base slice)" }
    }
}

fn ffi_prim_name(k: checker::PrimKind): str {
    match k {
        U8 => "u8"; U16 => "u16"; U32 => "u32"; U64 => "u64"
        I8 => "i8"; I16 => "i16"; I32 => "i32"; I64 => "i64"
        F32 => "f32"; F64 => "f64"
        Bool => "bool"
        Isize => "isize"; Usize => "usize"
    }
}

fn ffi_c_scalar(nm: str): str | error {
    if nm == "i8" { return "int8_t" }
    if nm == "i16" { return "int16_t" }
    if nm == "i32" { return "int32_t" }
    if nm == "i64" { return "int64_t" }
    if nm == "u8" { return "uint8_t" }
    if nm == "u16" { return "uint16_t" }
    if nm == "u32" { return "uint32_t" }
    if nm == "u64" { return "uint64_t" }
    if nm == "byte" { return "uint8_t" }
    if nm == "f32" { return "float" }
    if nm == "f64" { return "double" }
    if nm == "bool" { return "bool" }
    if nm == "usize" { return "uint64_t" }
    if nm == "isize" { return "int64_t" }
    error { message = teko::str::concat("type `", nm, "` is not an FFI-safe scalar (i8..i64/u8..u64/size/usize/byte/f32/f64/bool)") }
}

pub fn check_ffi_export(prog: checker::TProgram): error | null {
    var seen_syms: []str = []
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.vis == parser::Visibility::Exp {
                    match check_ffi_export_fn(f) { null => { }; error as e => return e }
                    var sym = cg_c_export_symbol(f)
                    if ffi_str_in(seen_syms, sym) {
                        return error { message = teko::str::concat("reverse-FFI export collision: two exported functions resolve to the C symbol `", sym, "` — give one an explicit `exp(\"other_name\")`") }
                    }
                    seen_syms = [..seen_syms, sym]
                }
            }
            parser::TypeDecl as d => {
                match check_ffi_export_type(d) { null => { }; error as e => return e }
            }
            _ => { }
        }
        i++
    }
    null
}

fn check_ffi_export_type(d: parser::TypeDecl): error | null {
    if d.vis != parser::Visibility::Exp { return null }
    match d.body {
        parser::ClassBody => error { message = teko::str::concat("cannot export class `", d.name, "` across the C ABI (`abi=\"c\"`): a Teko class has no stable C layout — expose a `#repr(\"c\")` struct + free functions instead") }
        parser::InterfaceBody => error { message = teko::str::concat("cannot export interface `", d.name, "` across the C ABI (`abi=\"c\"`): a Teko interface vtable has no stable C layout — expose free functions instead") }
        _ => null
    }
}

fn check_ffi_export_fn(f: checker::TFunction): error | null {
    if f.type_params.len != 0 {
        return error { message = teko::str::concat("cannot export generic function `", f.name, "` across the C ABI: only a monomorphic instance has a C signature") }
    }
    match ffi_ctype_of_type(f.return_type) {
        str => { }
        error as e => return error { message = teko::str::concat("exported function `", f.name, "`: ", e.message) }
    }
    var i: u64 = 0
    loop {
        if i >= f.params.len { break }
        var p = f.params[i]
        if p.is_params {
            return error { message = teko::str::concat("cannot export function `", f.name, "` with a Teko `params` variadic across the C ABI — declare a fixed C signature instead") }
        }
        match ffi_ctype_of_typeexpr(p.type_ann) {
            str => { }
            error as e => return error { message = teko::str::concat("exported function `", f.name, "`, parameter `", p.name, "`: ", e.message) }
        }
        i++
    }
    null
}

pub fn emit_c_header(prog: checker::TProgram): str | error {
    var out = "/* generated by teko — reverse-FFI C header (abi=\"c\"); do not edit */\n"
    out = teko::str::concat(out, "#ifndef TEKO_EXPORT_H\n#define TEKO_EXPORT_H\n#include <stdint.h>\n#include <stdbool.h>\n\n")
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.vis == parser::Visibility::Exp {
                    var proto = match emit_c_header_proto(f) { str as s => s; error as e => return e }
                    out = teko::str::concat(out, proto)
                }
            }
            _ => { }
        }
        i++
    }
    teko::str::concat(out, "\n#endif\n")
}

fn emit_c_header_proto(f: checker::TFunction): str | error {
    var ret = match ffi_ctype_of_type(f.return_type) { str as s => s; error as e => return e }
    var params = match emit_c_header_params(f) { str as s => s; error as e => return e }
    teko::str::concat(ret, teko::str::concat(" ", teko::str::concat(cg_c_export_symbol(f), teko::str::concat("(", teko::str::concat(params, ");\n")))))
}

fn emit_c_header_params(f: checker::TFunction): str | error {
    if f.params.len == 0 { return "void" }
    var out = ""
    var i: u64 = 0
    loop {
        if i >= f.params.len { break }
        if i > 0 { out = teko::str::concat(out, ", ") }
        var ct = match ffi_ctype_of_typeexpr(f.params[i].type_ann) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat(ct, teko::str::concat(" ", cb_ident_str(f.params[i].name))))
        i++
    }
    out
}

pub fn cg_c_export_wrappers_text(prog: checker::TProgram): str | error {
    var out = "\n/* reverse-FFI C-ABI export wrappers (abi=\"c\") */\n"
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.vis == parser::Visibility::Exp && !f.is_extern {
                    var one = match cg_c_export_wrapper_one(f) { str as s => s; error as e => return e }
                    out = teko::str::concat(out, one)
                }
            }
            _ => { }
        }
        i++
    }
    out
}

fn cg_c_export_wrapper_one(f: checker::TFunction): str | error {
    var ret = match ffi_ctype_of_type(f.return_type) { str as s => s; error as e => return e }
    var params = match emit_c_header_params(f) { str as s => s; error as e => return e }
    var head = teko::str::concat(ret, teko::str::concat(" ", teko::str::concat(cg_c_export_symbol(f), teko::str::concat("(", teko::str::concat(params, ") { ")))))
    var ret_kw = if ret != "void" { "return " } else { "" }
    var call = teko::str::concat(cb_fn_name_str(f.namespace, f.name), teko::str::concat("(", teko::str::concat(cg_c_export_wrapper_args(f), "); }\n")))
    teko::str::concat(head, teko::str::concat(ret_kw, call))
}

fn cg_c_export_wrapper_args(f: checker::TFunction): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= f.params.len { break }
        if i > 0 { out = teko::str::concat(out, ", ") }
        out = teko::str::concat(out, cb_ident_str(f.params[i].name))
        i++
    }
    out
}

fn ffi_str_in(xs: []str, needle: str): bool {
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == needle { return true }
        i++
    }
    false
}
