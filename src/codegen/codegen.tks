
use teko::checker
use teko::lexer
use teko::parser

type CgMode = enum { Program; TestPlain; TestCov; TestAnalyze; ProgramCov }

type CovCtx = struct {
    on: bool
    fn_idx: u64
}

type TThunkEmit = struct {
    emitted: []str
}

fn cov_off(): CovCtx { CovCtx { on = false; fn_idx = 0 } }

fn emit_cov_line(buf: teko::io::FileStream, ctx: CovCtx, line: u32, indent: str) {
    if !ctx.on { return }
    if line == 0 { return }
    buf.write(indent)
    cb_fn_name(buf, "teko::runtime", "cov_line_at")
    buf.write("(")
    cb_u64_digits(buf, ctx.fn_idx)
    buf.write("ULL, ")
    cb_u64_digits(buf, line to u64)
    buf.write(");\n")
}

fn emit_cov_branch(buf: teko::io::FileStream, ctx: CovCtx, line: u32, col: u32, outcome: u64, indent: str) {
    if !ctx.on { return }
    buf.write(indent)
    cb_fn_name(buf, "teko::runtime", "cov_branch_at")
    buf.write("(")
    cb_u64_digits(buf, ctx.fn_idx)
    buf.write("ULL, ")
    cb_u64_digits(buf, line to u64)
    buf.write(", ")
    cb_u64_digits(buf, col to u64)
    buf.write(", ")
    cb_u64_digits(buf, outcome)
    buf.write(");\n")
}

fn cb_cov_call0(buf: teko::io::FileStream, name: str) {
    buf.write("    ")
    cb_fn_name(buf, "teko::runtime", name)
    buf.write("();\n")
}

fn cb_cov_call_idx(buf: teko::io::FileStream, name: str, idx: u64) {
    buf.write("    ")
    cb_fn_name(buf, "teko::runtime", name)
    buf.write("(")
    cb_u64_digits(buf, idx)
    buf.write("ULL);\n")
}

fn cb_i64(buf: teko::io::FileStream, v: i64) {
    if v == 0 { buf.write_byte(b'0'); return }
    var n = v
    if n < 0 { buf.write_byte(b'-'); n = -n }
    var digits: [24]byte = []
    var c: u64 = 0
    loop {
        if n == 0 { break }
        digits[c] = (b'0' to i64 + (n % 10)) to byte
        n = n / 10
        c = c + 1
    }
    var i = c
    loop {
        if i == 0 { break }
        buf.write_byte(digits[i - 1])
        i--
    }
}

fn cb_u64_digits(buf: teko::io::FileStream, v: u64) {
    if v == 0 { buf.write_byte(b'0'); return }
    var n = v
    var digits: [24]byte = []
    var c: u64 = 0
    loop {
        if n == 0 { break }
        digits[c] = (b'0' to u64 + (n % 10)) to byte
        n = n / 10
        c = c + 1
    }
    var i = c
    loop {
        if i == 0 { break }
        buf.write_byte(digits[i - 1])
        i--
    }
}

fn cb_u64_c_expr(buf: teko::io::FileStream, v: u64) {
    cb_u64_digits(buf, v)
    buf.write("ULL")
}

fn cb_numint(buf: teko::io::FileStream, v: parser::NumInt) {
    if v.neg {
        buf.write("-(")
        cb_u64_c_expr(buf, v.mag)
        buf.write(")")
        return
    }
    cb_u64_c_expr(buf, v.mag)
}

fn cb_numint_str(v: parser::NumInt): str {
    var mag = teko::str::concat(teko::u64_to_str(v.mag), "ULL")
    if v.neg { teko::str::concat(teko::str::concat("-(", mag), ")") } else { mag }
}

type CgArenaSym = enum {
    RegionAlloc; RegionNew; RegionNewSized; RegionDrop; RegionDropSubtree; RegionRoot; RegionCurrent;
    RegionEnter; RegionLeave; ArenaPush; ArenaPop; ArenaCommit; RegionRegister; RegionLookup; Alloc;
    RetDestSet; RetDestGet; FreeBlock
}

fn cg_arena_sym(kind: CgArenaSym): str {
    teko::str::concat("TK_ARENA_", cg_arena_kind_suffix(kind))
}

fn cb_arena_sym(buf: teko::io::FileStream, kind: CgArenaSym) {
    buf.write("TK_ARENA_")
    buf.write(cg_arena_kind_suffix(kind))
}

fn cg_arena_kind_suffix(kind: CgArenaSym): str {
    match kind {
        CgArenaSym::RegionAlloc => "region_alloc"
        CgArenaSym::RegionNew => "region_new"
        CgArenaSym::RegionNewSized => "region_new_sized"
        CgArenaSym::RegionDrop => "region_drop"
        CgArenaSym::RegionDropSubtree => "region_drop_subtree"
        CgArenaSym::RegionRoot => "region_root"
        CgArenaSym::RegionCurrent => "region_current"
        CgArenaSym::RegionEnter => "region_enter"
        CgArenaSym::RegionLeave => "region_leave"
        CgArenaSym::ArenaPush => "arena_push"
        CgArenaSym::ArenaPop => "arena_pop"
        CgArenaSym::ArenaCommit => "arena_commit"
        CgArenaSym::RegionRegister => "region_register"
        CgArenaSym::RegionLookup => "region_lookup"
        CgArenaSym::Alloc => "alloc"
        CgArenaSym::RetDestSet => "set_ret_dest"
        CgArenaSym::RetDestGet => "ret_dest"
        CgArenaSym::FreeBlock => "free_block"
    }
}

fn cg_arena_teko_sym(kind: CgArenaSym): str {
    teko::str::concat("teko_teko__runtime__", cg_arena_kind_suffix(kind))
}

fn cg_arena_all_kinds(): []CgArenaSym {
    [
        CgArenaSym::RegionAlloc, CgArenaSym::RegionNew, CgArenaSym::RegionNewSized, CgArenaSym::RegionDrop,
        CgArenaSym::RegionDropSubtree, CgArenaSym::RegionRoot, CgArenaSym::RegionCurrent,
        CgArenaSym::RegionEnter, CgArenaSym::RegionLeave, CgArenaSym::ArenaPush,
        CgArenaSym::ArenaPop, CgArenaSym::ArenaCommit, CgArenaSym::RegionRegister,
        CgArenaSym::RegionLookup, CgArenaSym::Alloc,
        CgArenaSym::RetDestSet, CgArenaSym::RetDestGet, CgArenaSym::FreeBlock
    ]
}

fn cg_emit_arena_provider_ladder(buf: teko::io::FileStream) {
    var kinds = cg_arena_all_kinds()
    var i = 0
    loop {
        if i >= kinds.len { break }
        var kind = kinds[i]
        buf.write("#define TK_ARENA_")
        buf.write(cg_arena_kind_suffix(kind))
        buf.write(" ")
        buf.write(cg_arena_teko_sym(kind))
        buf.write("\n")
        i = i + 1
    }
    buf.write("\n")
}

const F64_EXPONENT_SHIFT: u64 = 52 to u64
const F64_EXPONENT_MASK: u64 = 2047 to u64
const F64_SIGNIFICAND_MASK: u64 = 4503599627370495 to u64
const F64_SIGN_SHIFT: u64 = 63 to u64

fn cb_f64_literal(buf: teko::io::FileStream, v: f64) {
    var bits = teko::f64_bits(v)
    if f64_bits_are_finite(bits) { buf.write(c_double_spelling(teko::runtime::ftoa(v))); return }
    if f64_bits_are_nan(bits) { buf.write("__builtin_nan(\"\")"); return }
    if f64_bits_are_negative(bits) { buf.write("(-__builtin_inf())"); return }
    buf.write("__builtin_inf()")
}

fn f64_bits_are_finite(bits: u64): bool {
    ((bits >> F64_EXPONENT_SHIFT) & F64_EXPONENT_MASK) != F64_EXPONENT_MASK
}

fn f64_bits_are_nan(bits: u64): bool {
    !f64_bits_are_finite(bits) && (bits & F64_SIGNIFICAND_MASK) != 0 to u64
}

fn f64_bits_are_negative(bits: u64): bool {
    (bits >> F64_SIGN_SHIFT) != 0 to u64
}

fn c_double_spelling(text: str): str {
    if has_c_float_marker(text) { return text }
    teko::str::concat(text, ".0")
}

fn has_c_float_marker(text: str): bool {
    var i: u64 = 0 to u64
    loop {
        if i >= text.len { break }
        var ch = text[i]
        if ch == b'.' || ch == b'e' || ch == b'E' { return true }
        i++
    }
    false
}

fn cg_rt_fmt_open(buf: teko::io::FileStream, name: str, cast: str) {
    cb_fn_name(buf, "teko::runtime", name)
    buf.write("((")
    buf.write(cast)
    buf.write(")(")
}

fn cb_cstr_escaped(buf: teko::io::FileStream, s: str) {
    var i = 0
    loop {
        if i >= s.len { break }
        var c = s[i]
        if c == b'\\' { buf.write("\\\\") }
        else if c == b'"' { buf.write("\\\"") }
        else if c == b'\n' { buf.write("\\n") }
        else if c == b'\t' { buf.write("\\t") }
        else if c == b'\r' { buf.write("\\r") }
        else if c < 0x20 || c >= 0x7F {
            buf.write_byte(b'\\')
            buf.write_byte((b'0' to i64 + ((c to i64 / 64) % 8)) to byte)
            buf.write_byte((b'0' to i64 + ((c to i64 / 8) % 8)) to byte)
            buf.write_byte((b'0' to i64 + (c to i64 % 8)) to byte)
        }
        else { buf.write_byte(c) }
        i++
    }
}

fn cb_cstr_escaped_len(c: byte): u64 {
    if c == b'\\' || c == b'"' || c == b'\n' || c == b'\t' || c == b'\r' { return 2 }
    if c < 0x20 || c >= 0x7F { return 4 }
    1
}

fn cb_cstr_escaped_fill(ref out: []byte, k: u64, c: byte): u64 {
    if c == b'\\' { out[k] = b'\\'; out[k + 1] = b'\\'; return k + 2 }
    if c == b'"' { out[k] = b'\\'; out[k + 1] = b'"'; return k + 2 }
    if c == b'\n' { out[k] = b'\\'; out[k + 1] = b'n'; return k + 2 }
    if c == b'\t' { out[k] = b'\\'; out[k + 1] = b't'; return k + 2 }
    if c == b'\r' { out[k] = b'\\'; out[k + 1] = b'r'; return k + 2 }
    if c < 0x20 || c >= 0x7F {
        out[k] = b'\\'
        out[k + 1] = (b'0' to i64 + ((c to i64 / 64) % 8)) to byte
        out[k + 2] = (b'0' to i64 + ((c to i64 / 8) % 8)) to byte
        out[k + 3] = (b'0' to i64 + (c to i64 % 8)) to byte
        return k + 4
    }
    out[k] = c
    k + 1
}

fn cb_cstr_escaped_str(s: str): str {
    var outlen: u64 = 0
    var i: u64 = 0
    loop {
        if i >= s.len { break }
        outlen = outlen + cb_cstr_escaped_len(s[i])
        i++
    }
    var out: [outlen]byte = []
    i = 0
    var k: u64 = 0
    loop {
        if i >= s.len { break }
        k = cb_cstr_escaped_fill(out, k, s[i])
        i++
    }
    str_of_bytes(out)
}

pub fn tk_emit_meta(name: str, version: str, suffix: str, description: str): str {
    var out = "\n/* build metadata (teko C7.1k) — what(1)/strings-readable */\n"
    out = teko::str::concat(out, "__attribute__((used)) static const char tk_build_meta[] = \"@(#)")
    out = teko::str::concat(out, cb_cstr_escaped_str(name))
    out = teko::str::concat(out, " ")
    out = teko::str::concat(out, cb_cstr_escaped_str(version))
    if suffix != "" { out = teko::str::concat(out, teko::str::concat("-", cb_cstr_escaped_str(suffix))) }
    if description != "" { out = teko::str::concat(out, teko::str::concat(" | ", cb_cstr_escaped_str(description))) }
    teko::str::concat(out, "\";\n")
}

fn emit_prim(buf: teko::io::FileStream, k: checker::PrimKind) {
    match k {
        checker::PrimKind::U8 => buf.write("uint8_t")
        checker::PrimKind::U16 => buf.write("uint16_t")
        checker::PrimKind::U32 => buf.write("uint32_t")
        checker::PrimKind::U64 => buf.write("uint64_t")
        checker::PrimKind::I8 => buf.write("int8_t")
        checker::PrimKind::I16 => buf.write("int16_t")
        checker::PrimKind::I32 => buf.write("int32_t")
        checker::PrimKind::I64 => buf.write("int64_t")
        checker::PrimKind::F32 => buf.write("float")
        checker::PrimKind::F64 => buf.write("double")
        checker::PrimKind::Bool => buf.write("bool")
        checker::PrimKind::Usize => buf.write("uint64_t")
        checker::PrimKind::Isize => buf.write("int64_t")
    }
}

fn emit_prim_str(k: checker::PrimKind): str {
    match k {
        checker::PrimKind::U8 => "uint8_t"
        checker::PrimKind::U16 => "uint16_t"
        checker::PrimKind::U32 => "uint32_t"
        checker::PrimKind::U64 => "uint64_t"
        checker::PrimKind::I8 => "int8_t"
        checker::PrimKind::I16 => "int16_t"
        checker::PrimKind::I32 => "int32_t"
        checker::PrimKind::I64 => "int64_t"
        checker::PrimKind::F32 => "float"
        checker::PrimKind::F64 => "double"
        checker::PrimKind::Bool => "bool"
        checker::PrimKind::Usize => "uint64_t"
        checker::PrimKind::Isize => "int64_t"
    }
}

fn cb_tysym(buf: teko::io::FileStream, name: str) {
    var i = 0
    loop {
        if i >= name.len { break }
        if i + 1 < name.len && name[i] == b':' && name[i + 1] == b':' {
            buf.write("__")
            i = i + 2
        } else {
            buf.write_byte(name[i])
            i++
        }
    }
}

fn cb_tysym_str(name: str): str {
    var outlen: u64 = 0
    var i: u64 = 0
    loop {
        if i >= name.len { break }
        if i + 1 < name.len && name[i] == b':' && name[i + 1] == b':' { outlen = outlen + 2; i = i + 2 }
        else { outlen = outlen + 1; i++ }
    }
    var out: [outlen]byte = []
    i = 0
    var k: u64 = 0
    loop {
        if i >= name.len { break }
        if i + 1 < name.len && name[i] == b':' && name[i + 1] == b':' {
            out[k] = b'_'; k++
            out[k] = b'_'; k++
            i = i + 2
        } else {
            out[k] = name[i]; k++
            i++
        }
    }
    str_of_bytes(out)
}

fn cg_ns_c_key(name: str): str { cb_tysym_str(name) }

const TEKO_USER_PREFIX: str = "teko_"

fn mangle_type_name(buf: teko::io::FileStream, namespace: str, name: str) {
    buf.write("tk_t_")
    if namespace.len > 0 {
        cb_tysym(buf, namespace)
        buf.write("__")
    }
    cb_tysym(buf, name)
}

fn mangle_type_name_str(namespace: str, name: str): str {
    var out = "tk_t_"
    if namespace.len > 0 { out = teko::str::concat(out, teko::str::concat(cb_tysym_str(namespace), "__")) }
    teko::str::concat(out, cb_tysym_str(name))
}

fn cb_fn_name(buf: teko::io::FileStream, ns: str, name: str, suffix: str = "") {
    buf.write(TEKO_USER_PREFIX)
    if ns.len != 0 {
        var i = 0
        loop {
            if i >= ns.len { break }
            if ns[i] == b':' { buf.write_byte(b'_') } else { buf.write_byte(ns[i]) }
            i++
        }
        buf.write("__")
    }
    cb_ident(buf, name)
    if suffix.len != 0 { buf.write(suffix) }
}

fn cb_fn_name_str(ns: str, name: str, suffix: str = ""): str {
    var out = TEKO_USER_PREFIX
    if ns.len != 0 {
        var nsm: [ns.len]byte = []
        var i: u64 = 0
        loop {
            if i >= ns.len { break }
            nsm[i] = if ns[i] == b':' { b'_' } else { ns[i] }
            i++
        }
        out = teko::str::concat(out, teko::str::concat(str_of_bytes(nsm), "__"))
    }
    out = teko::str::concat(out, cb_ident_str(name))
    if suffix.len != 0 { out = teko::str::concat(out, suffix) }
    out
}

const CG_TABLE_MIN_CAP: u64 = 16

const CG_TABLE_LOAD_NUMERATOR: u64 = 2

const CG_MAIN_RETURN_OPEN: str = "return (int)(("

const CG_MAIN_RETURN_CLOSE: str = ") & 0xFF);\n"

type CgNameTable = struct {
    mask: u64
    hashes: []u64
    keys: []str
    slots: []u64
}

type CgIndex = struct {
    exact: CgNameTable
    last: CgNameTable
    fns: CgNameTable
    same_last_next: []u64
}

type CgProg = struct {
    items: []@TItem()
    ix: CgIndex
    cond_consts: []checker::ConstQName
    uses_capture: bool
    maypanic: CgNameTable
    needs_region: CgNameTable
    table: checker::TypeTable
}

fn cg_prog_uses_capture(items: []@TItem()): bool {
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        match items[i] {
            checker::TFunction as f => if !f.is_extern && cg_block_calls_self(f.body, "", "capture_panic") { return true }
            _ => { }
        }
        i++
    }
    false
}

fn cg_expr_collect_keys(e: checker::TExpr, acc: []str): []str {
    match e.kind {
        checker::TCall as c => {
            var a = acc
            if !c.is_closure_call && !c.is_iface_dispatch {
                var last = cg_path_last(c.callee)
                if last.len > 0 { a = [..a, cg_fn_key(c.call_ns, last)] }
            }
            var i = 0
            loop { if i >= c.args.len { break }; a = cg_expr_collect_keys(c.args[i], a); i++ }
            a
        }
        checker::TBinary as b => cg_expr_collect_keys(b.right, cg_expr_collect_keys(b.left, acc))
        checker::TUnary as u => cg_expr_collect_keys(u.operand, acc)
        checker::TCompare as c => {
            var a = cg_expr_collect_keys(c.first, acc)
            var i = 0
            loop { if i >= c.rest.len { break }; a = cg_expr_collect_keys(c.rest[i].operand, a); i++ }
            a
        }
        checker::TIfExpr as f => cg_block_collect_keys(f.else_blk, cg_block_collect_keys(f.then_blk, cg_expr_collect_keys(f.cond, acc)))
        checker::TMatchExpr as m => {
            var a = cg_expr_collect_keys(m.subject, acc)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { a = cg_expr_collect_keys(m.arms[i].guard, a) }
                a = cg_block_collect_keys(m.arms[i].body, a)
                i++
            }
            a
        }
        checker::TCast as c => cg_expr_collect_keys(c.expr, acc)
        checker::TFieldAccess as fa => cg_expr_collect_keys(fa.receiver, acc)
        checker::TStructInit as si => {
            var a = acc
            var i = 0
            loop { if i >= si.field_vals.len { break }; a = cg_expr_collect_keys(si.field_vals[i], a); i++ }
            a
        }
        checker::TIndex as ix => cg_expr_collect_keys(ix.index, cg_expr_collect_keys(ix.receiver, acc))
        checker::TInterp as ip => {
            var a = acc
            var i = 0
            loop {
                if i >= ip.holes.len { break }
                a = cg_expr_collect_keys(ip.holes[i], a)
                if i < ip.specs.len {
                    match ip.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; a = cg_expr_collect_keys(fd.args[k], a); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            a
        }
        checker::TInExpr as ie => {
            var a = cg_expr_collect_keys(ie.lhs, acc)
            var i = 0
            loop { if i >= ie.elems.len { break }; a = cg_expr_collect_keys(ie.elems[i], a); i++ }
            a
        }
        checker::TArrayLit as al => {
            var a = acc
            var i = 0
            loop { if i >= al.elements.len { break }; a = cg_expr_collect_keys(al.elements[i].expr, a); i++ }
            a
        }
        checker::TLambda as lam => cg_block_collect_keys(lam.body, acc)
        checker::TBlockExpr as blk => cg_block_collect_keys(blk.body, acc)
        _ => acc
    }
}

fn cg_block_collect_keys(stmts: []@TStatement(), acc: []str): []str {
    var a = acc
    var i = 0
    loop {
        if i >= stmts.len { break }
        match stmts[i] {
            checker::TBinding as b => a = cg_expr_collect_keys(b.value, a)
            checker::TAssign as asg => {
                a = cg_expr_collect_keys(asg.value, a)
                if parser::assign_has_target(asg.kind) { a = cg_expr_collect_keys(asg.target, a) }
            }
            checker::TReturn as r => if r.has_value { a = cg_expr_collect_keys(r.value, a) }
            checker::TLoopStmt as l => { a = cg_block_collect_keys(l.init, a); a = cg_block_collect_keys(l.body, a) }
            checker::TExprStmt as es => a = cg_expr_collect_keys(es.expr, a)
            checker::TDeferStmt as d => a = cg_block_collect_keys(d.body, a)
            checker::TAdoptStmt as ad => a = cg_block_collect_keys(ad.body, a)
            checker::TBlockStmt as bs => a = cg_block_collect_keys(bs.body, a)
            _ => { }
        }
        i++
    }
    a
}

/**
 * cg_expr_collect_funcvals — collect the keys of every function REFERENCED AS A VALUE (a bare function
 * name in non-call position, which lowers to a `tk_closure` with a null environment). These flow
 * through the uniform indirect-call ABI, so their targets must carry the region parameter.
 *
 * @param e    the typed expression
 * @param acc  the accumulated keys
 * @return     `acc` plus every function-value key found in `e`
 */
fn cg_expr_collect_funcvals(e: checker::TExpr, acc: []str): []str {
    match e.kind {
        checker::TVar as v => if v.is_func { [..acc, cg_fn_key(v.func_ns, v.name)] } else { acc }
        checker::TCall as c => {
            var a = acc
            var i = 0
            loop { if i >= c.args.len { break }; a = cg_expr_collect_funcvals(c.args[i], a); i++ }
            a
        }
        checker::TBinary as b => cg_expr_collect_funcvals(b.right, cg_expr_collect_funcvals(b.left, acc))
        checker::TUnary as u => cg_expr_collect_funcvals(u.operand, acc)
        checker::TCompare as cp => {
            var a = cg_expr_collect_funcvals(cp.first, acc)
            var i = 0
            loop { if i >= cp.rest.len { break }; a = cg_expr_collect_funcvals(cp.rest[i].operand, a); i++ }
            a
        }
        checker::TCast as c => cg_expr_collect_funcvals(c.expr, acc)
        checker::TFieldAccess as fa => cg_expr_collect_funcvals(fa.receiver, acc)
        checker::TStructInit as si => {
            var a = acc
            var i = 0
            loop { if i >= si.field_vals.len { break }; a = cg_expr_collect_funcvals(si.field_vals[i], a); i++ }
            a
        }
        checker::TIndex as ix => cg_expr_collect_funcvals(ix.index, cg_expr_collect_funcvals(ix.receiver, acc))
        checker::TIfExpr as f => cg_block_collect_funcvals(f.else_blk, cg_block_collect_funcvals(f.then_blk, cg_expr_collect_funcvals(f.cond, acc)))
        checker::TMatchExpr as m => {
            var a = cg_expr_collect_funcvals(m.subject, acc)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { a = cg_expr_collect_funcvals(m.arms[i].guard, a) }
                a = cg_block_collect_funcvals(m.arms[i].body, a)
                i++
            }
            a
        }
        checker::TInExpr as ie => {
            var a = cg_expr_collect_funcvals(ie.lhs, acc)
            var i = 0
            loop { if i >= ie.elems.len { break }; a = cg_expr_collect_funcvals(ie.elems[i], a); i++ }
            a
        }
        checker::TArrayLit as al => {
            var a = acc
            var i = 0
            loop { if i >= al.elements.len { break }; a = cg_expr_collect_funcvals(al.elements[i].expr, a); i++ }
            a
        }
        checker::TLambda as lam => cg_block_collect_funcvals(lam.body, acc)
        checker::TBlockExpr as blk => cg_block_collect_funcvals(blk.body, acc)
        _ => acc
    }
}

/**
 * cg_block_collect_funcvals — collect function-value keys across a statement list, recursing into
 * nested blocks and control flow.
 *
 * @param stmts  the statement list
 * @param acc    the accumulated keys
 * @return       `acc` plus every function-value key found in the block
 */
fn cg_block_collect_funcvals(stmts: []@TStatement(), acc: []str): []str {
    var a = acc
    var i = 0
    loop {
        if i >= stmts.len { break }
        match stmts[i] {
            checker::TBinding as b => a = cg_expr_collect_funcvals(b.value, a)
            checker::TAssign as asg => {
                a = cg_expr_collect_funcvals(asg.value, a)
                if parser::assign_has_target(asg.kind) { a = cg_expr_collect_funcvals(asg.target, a) }
            }
            checker::TReturn as r => if r.has_value { a = cg_expr_collect_funcvals(r.value, a) }
            checker::TLoopStmt as l => { a = cg_block_collect_funcvals(l.init, a); a = cg_block_collect_funcvals(l.body, a) }
            checker::TExprStmt as es => a = cg_expr_collect_funcvals(es.expr, a)
            checker::TDeferStmt as d => a = cg_block_collect_funcvals(d.body, a)
            checker::TAdoptStmt as ad => a = cg_block_collect_funcvals(ad.body, a)
            checker::TBlockStmt as bs => a = cg_block_collect_funcvals(bs.body, a)
            _ => { }
        }
        i++
    }
    a
}

fn cg_prog_maypanic(items: []@TItem(), uses_capture: bool): CgNameTable {
    var empty: CgNameTable = CgNameTable { mask = 0 to u64; hashes = []; keys = []; slots = [] }
    if !uses_capture { return empty }
    var nfn: u64 = 0
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        match items[i] { checker::TFunction as f => if !f.is_extern { nfn++ }; _ => { } }
        i++
    }
    var keys: [nfn]str = []
    var callees: [nfn][]str = []
    var flag: [nfn]bool = []
    var k: u64 = 0
    i = 0
    loop {
        if i >= items.len { break }
        match items[i] {
            checker::TFunction as f => {
                if !f.is_extern {
                    keys[k] = cg_fn_key(f.namespace, f.name)
                    callees[k] = cg_block_collect_keys(f.body, [])
                    flag[k] = cg_fn_seeds_maypanic(f.body)
                    k++
                }
            }
            _ => { }
        }
        i++
    }
    var index = cg_table_build(keys, cg_fn_index_slots(nfn))
    var changed = true
    loop {
        if !changed { break }
        changed = false
        var f2: u64 = 0
        loop {
            if f2 >= nfn { break }
            if !flag[f2] && cg_callees_hit_flag(callees[f2], index, flag) { flag[f2] = true; changed = true }
            f2++
        }
    }
    var nflag: u64 = 0
    var c: u64 = 0
    loop { if c >= nfn { break }; if flag[c] { nflag++ }; c++ }
    var fkeys: [nflag]str = []
    var fslots: [nflag]u64 = []
    var w: u64 = 0
    c = 0
    loop {
        if c >= nfn { break }
        if flag[c] { fkeys[w] = keys[c]; fslots[w] = 1; w++ }
        c++
    }
    cg_table_build(fkeys, fslots)
}

fn cg_fn_seeds_maypanic(body: []@TStatement()): bool {
    if cg_block_calls_self(body, "teko::runtime", "panic") { return true }
    if cg_block_calls_self(body, "teko::runtime", "exit") { return true }
    if cg_block_calls_self(body, "", "panic") { return true }
    cg_block_calls_self(body, "", "exit")
}

/**
 * cg_str_has_prefix — true when `s` begins with `prefix`, compared byte for byte.
 *
 * @param s       the string tested
 * @param prefix  the candidate leading substring
 * @return        true iff the first `prefix.len` bytes of `s` equal `prefix`
 */
fn cg_str_has_prefix(s: str, prefix: str): bool {
    if s.len < prefix.len { return false }
    var i: u64 = 0
    loop {
        if i >= prefix.len { break }
        if s[i] != prefix[i] { return false }
        i++
    }
    true
}

/**
 * cg_fn_recv_is — true when `f` is a method whose `self` receiver has the named type `tyname`.
 *
 * @param f       the typed function
 * @param tyname  the receiver type name to match (e.g. "Region")
 * @return        true iff `f.params[0]` is `self` annotated with a named type ending in `tyname`
 */
fn cg_fn_recv_is(f: checker::TFunction, tyname: str): bool {
    if f.params.len == 0 { return false }
    if !teko::runtime::str_eq(f.params[0].name, "self") { return false }
    match f.params[0].type_ann {
        parser::NamedType as nt => {
            if nt.path.segments.len == 0 { return false }
            teko::runtime::str_eq(nt.path.segments[nt.path.segments.len - 1].name, tyname)
        }
        _ => false
    }
}

/**
 * cg_name_is_arena_backing — true for the loose region/arena backing helpers of `teko::runtime`
 * that the arena methods delegate to; these PROVIDE regions and never receive one.
 *
 * @param name  the bare function name
 * @return      true iff `name` is a backing-allocator helper
 */
fn cg_name_is_arena_backing(name: str): bool {
    if cg_str_has_prefix(name, "region_") { return true }
    if cg_str_has_prefix(name, "arena_") { return true }
    if cg_str_has_prefix(name, "ar_") { return true }
    if cg_str_has_prefix(name, "chunk_") { return true }
    if teko::runtime::str_eq(name, "free_block") { return true }
    if teko::runtime::str_eq(name, "alloc") { return true }
    if teko::runtime::str_eq(name, "intern_get") { return true }
    if teko::runtime::str_eq(name, "intern_put") { return true }
    teko::runtime::str_eq(name, "intern_reset")
}

/**
 * cg_fn_below_line_a — the structural below-the-line predicate (D158): a function that PROVIDES
 * memory rather than consuming a region. Such a function never takes the implicit region parameter.
 *
 * @param f  the typed function
 * @return   true iff `f` is a `Region`/`Arena` method, an `abi`/`mem` floor primitive, or a
 *           `teko::runtime` arena-backing helper
 */
fn cg_fn_below_line_a(f: checker::TFunction): bool {
    if cg_fn_recv_is(f, "Region") { return true }
    if cg_fn_recv_is(f, "Arena") { return true }
    if teko::runtime::str_eq(f.namespace, "teko::sys::abi") { return true }
    if teko::runtime::str_eq(f.namespace, "teko::mem") { return true }
    if teko::runtime::str_eq(f.namespace, "teko::sys") { return true }
    teko::runtime::str_eq(f.namespace, "teko::runtime") && cg_name_is_arena_backing(f.name)
}

/**
 * cg_type_is_heap — conservative test for a return type that may carry region-owned storage. Value
 * types (numbers, byte, char, void, opaque pointers) are non-heap; everything else is treated as heap
 * so that its producer receives a region (leak/UAF-safe by construction).
 *
 * @param t  the return type
 * @return   true unless `t` is a plainly non-allocating value type
 */
fn cg_type_is_heap(t: @Type()): bool {
    match t {
        checker::Prim => false
        checker::Byte => false
        checker::Char => false
        checker::Void => false
        checker::Ptr => false
        checker::Uptr => false
        _ => true
    }
}

/**
 * cg_expr_allocs — true when evaluating `e` directly constructs region-owned storage (a sized array,
 * array literal, string interpolation, lambda environment, or struct initialiser), recursing through
 * sub-expressions and nested blocks.
 *
 * @param e  the typed expression
 * @return   true iff `e`'s evaluation allocates in the enclosing region
 */
fn cg_expr_allocs(e: checker::TExpr): bool {
    match e.kind {
        checker::TSliceOfLen => true
        checker::TZeroOf => true
        checker::TArrayLit => true
        checker::TInterp => true
        checker::TLambda => true
        checker::TStructInit => true
        checker::TCall as c => {
            var i = 0
            loop { if i >= c.args.len { break }; if cg_expr_allocs(c.args[i]) { return true }; i++ }
            false
        }
        checker::TBinary as b => cg_expr_allocs(b.left) || cg_expr_allocs(b.right)
        checker::TUnary as u => cg_expr_allocs(u.operand)
        checker::TCompare as cp => {
            if cg_expr_allocs(cp.first) { return true }
            var i = 0
            loop { if i >= cp.rest.len { break }; if cg_expr_allocs(cp.rest[i].operand) { return true }; i++ }
            false
        }
        checker::TCast as c => cg_expr_allocs(c.expr)
        checker::TFieldAccess as fa => cg_expr_allocs(fa.receiver)
        checker::TIndex as ix => cg_expr_allocs(ix.receiver) || cg_expr_allocs(ix.index)
        checker::TIfExpr as f => cg_expr_allocs(f.cond) || cg_block_allocs(f.then_blk) || cg_block_allocs(f.else_blk)
        checker::TMatchExpr as m => {
            if cg_expr_allocs(m.subject) { return true }
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when && cg_expr_allocs(m.arms[i].guard) { return true }
                if cg_block_allocs(m.arms[i].body) { return true }
                i++
            }
            false
        }
        checker::TBlockExpr as blk => cg_block_allocs(blk.body)
        checker::TInExpr as ie => {
            if cg_expr_allocs(ie.lhs) { return true }
            var i = 0
            loop { if i >= ie.elems.len { break }; if cg_expr_allocs(ie.elems[i]) { return true }; i++ }
            false
        }
        _ => false
    }
}

/**
 * cg_block_allocs — true when any statement in `body` allocates region-owned storage or is an
 * indirect (closure/interface) call, recursing into nested blocks and control flow.
 *
 * @param body  the statement list
 * @return      true iff the block may allocate in the enclosing region or dispatch indirectly
 */
fn cg_block_allocs(body: []@TStatement()): bool {
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding as b => { if cg_expr_allocs(b.value) { return true } }
            checker::TAssign as a => {
                if cg_expr_allocs(a.value) { return true }
                if parser::assign_has_target(a.kind) && cg_expr_allocs(a.target) { return true }
            }
            checker::TReturn as r => { if r.has_value && cg_expr_allocs(r.value) { return true } }
            checker::TExprStmt as es => { if cg_expr_allocs(es.expr) { return true } }
            checker::TLoopStmt as l => { if cg_block_allocs(l.init) || cg_block_allocs(l.body) { return true } }
            checker::TDeferStmt as d => { if cg_block_allocs(d.body) { return true } }
            checker::TAdoptStmt as ad => { if cg_block_allocs(ad.body) { return true } }
            checker::TBlockStmt as bs => { if cg_block_allocs(bs.body) { return true } }
            _ => { }
        }
        i++
    }
    false
}

/**
 * cg_expr_indirect — true when `e` performs (or nests) a closure or interface-dispatch call, which
 * carries the region through the uniform indirect-call ABI and so forces its enclosing function above
 * the line.
 *
 * @param e  the typed expression
 * @return   true iff `e` contains an indirect call
 */
fn cg_expr_indirect(e: checker::TExpr): bool {
    match e.kind {
        checker::TCall as c => {
            if c.is_closure_call || c.is_iface_dispatch { return true }
            var i = 0
            loop { if i >= c.args.len { break }; if cg_expr_indirect(c.args[i]) { return true }; i++ }
            false
        }
        checker::TBinary as b => cg_expr_indirect(b.left) || cg_expr_indirect(b.right)
        checker::TUnary as u => cg_expr_indirect(u.operand)
        checker::TCast as c => cg_expr_indirect(c.expr)
        checker::TFieldAccess as fa => cg_expr_indirect(fa.receiver)
        checker::TIndex as ix => cg_expr_indirect(ix.receiver) || cg_expr_indirect(ix.index)
        checker::TIfExpr as f => cg_expr_indirect(f.cond) || cg_block_indirect(f.then_blk) || cg_block_indirect(f.else_blk)
        checker::TMatchExpr as m => {
            if cg_expr_indirect(m.subject) { return true }
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if cg_block_indirect(m.arms[i].body) { return true }
                i++
            }
            false
        }
        checker::TBlockExpr as blk => cg_block_indirect(blk.body)
        _ => false
    }
}

/**
 * cg_block_indirect — true when any statement in `body` contains an indirect call, recursing into
 * nested blocks and control flow.
 *
 * @param body  the statement list
 * @return      true iff the block contains a closure or interface-dispatch call
 */
fn cg_block_indirect(body: []@TStatement()): bool {
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding as b => { if cg_expr_indirect(b.value) { return true } }
            checker::TAssign as a => {
                if cg_expr_indirect(a.value) { return true }
                if parser::assign_has_target(a.kind) && cg_expr_indirect(a.target) { return true }
            }
            checker::TReturn as r => { if r.has_value && cg_expr_indirect(r.value) { return true } }
            checker::TExprStmt as es => { if cg_expr_indirect(es.expr) { return true } }
            checker::TLoopStmt as l => { if cg_block_indirect(l.init) || cg_block_indirect(l.body) { return true } }
            checker::TDeferStmt as d => { if cg_block_indirect(d.body) { return true } }
            checker::TAdoptStmt as ad => { if cg_block_indirect(ad.body) { return true } }
            checker::TBlockStmt as bs => { if cg_block_indirect(bs.body) { return true } }
            _ => { }
        }
        i++
    }
    false
}

/**
 * cg_fn_tail_call_key — the callee key of `f`'s tail call when its body ends in a direct (non-indirect)
 * call statement, else the empty string; used to seed the diverges/noreturn fixpoint.
 *
 * @param f  the typed function
 * @return   `cg_fn_key(ns, name)` of the final tail call, or "" when the body has no such tail
 */
fn cg_fn_tail_call_key(f: checker::TFunction): str {
    if f.body.len == 0 { return "" }
    match f.body[f.body.len - 1] {
        checker::TExprStmt as es => match es.expr.kind {
            checker::TCall as c => {
                if c.is_closure_call || c.is_iface_dispatch { return "" }
                if c.callee.segments.len == 0 { return "" }
                cg_fn_key(c.call_ns, c.callee.segments[c.callee.segments.len - 1].name)
            }
            _ => ""
        }
        _ => ""
    }
}

/**
 * cg_fn_tail_name — the bare name of `f`'s tail call, or "" — used so the noreturn seed recognises the
 * divergent primitives (`panic`/`exit`) regardless of how their namespace resolved at the call site.
 *
 * @param f  the typed function
 * @return   the last-segment name of the tail call, or ""
 */
fn cg_fn_tail_name(f: checker::TFunction): str {
    if f.body.len == 0 { return "" }
    match f.body[f.body.len - 1] {
        checker::TExprStmt as es => match es.expr.kind {
            checker::TCall as c => {
                if c.callee.segments.len == 0 { return "" }
                c.callee.segments[c.callee.segments.len - 1].name
            }
            _ => ""
        }
        _ => ""
    }
}

/**
 * cg_prog_noreturn — the ascending fixpoint of functions that always diverge: seeded by the divergent
 * primitives `panic`/`exit` (and any function whose tail is a bare `panic`/`exit`), then propagated to
 * every function whose tail call reaches a divergent function. Such functions never return a
 * region-bearing value, so they stay below the line even when they allocate a throwaway message.
 *
 * @param items  the whole-program items
 * @return       a name table whose non-zero slots are the diverging function keys
 */
fn cg_prog_noreturn(items: []@TItem()): CgNameTable {
    var nfn: u64 = 0
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        match items[i] { checker::TFunction as f => if !f.is_extern { nfn++ }; _ => { } }
        i++
    }
    var keys: [nfn]str = []
    var flag: [nfn]bool = []
    var k: u64 = 0
    i = 0
    loop {
        if i >= items.len { break }
        match items[i] {
            checker::TFunction as f => {
                if !f.is_extern {
                    keys[k] = cg_fn_key(f.namespace, f.name)
                    var tn = cg_fn_tail_name(f)
                    flag[k] = teko::runtime::str_eq(tn, "panic") || teko::runtime::str_eq(tn, "exit") || teko::runtime::str_eq(f.name, "panic") || teko::runtime::str_eq(f.name, "exit")
                    k++
                }
            }
            _ => { }
        }
        i++
    }
    var scratch = cg_scope_begin()
    var tails: [nfn]str = []
    var kk: u64 = 0
    i = 0
    loop {
        if i >= items.len { break }
        match items[i] { checker::TFunction as f => if !f.is_extern { tails[kk] = cg_fn_tail_call_key(f); kk++ }; _ => { } }
        i++
    }
    var index = cg_table_build(keys, cg_fn_index_slots(nfn))
    var changed = true
    loop {
        if !changed { break }
        changed = false
        var f2: u64 = 0
        loop {
            if f2 >= nfn { break }
            if !flag[f2] && tails[f2].len > 0 {
                var slot = cg_table_get(index, tails[f2])
                if slot != 0 && flag[slot - 1] { flag[f2] = true; changed = true }
            }
            f2++
        }
    }
    cg_scope_end(scratch)
    cg_flag_table(keys, flag, nfn)
}

/**
 * cg_flag_table — build a name table holding exactly the keys whose `flag` is set (slot value 1).
 *
 * @param keys  the per-function keys, index-aligned with `flag`
 * @param flag  the per-function membership bits
 * @param nfn   the number of functions
 * @return      a table mapping each flagged key to slot 1
 */
fn cg_flag_table(keys: []str, flag: []bool, nfn: u64): CgNameTable {
    var nflag: u64 = 0
    var c: u64 = 0
    loop { if c >= nfn { break }; if flag[c] { nflag++ }; c++ }
    var fkeys: [nflag]str = []
    var fslots: [nflag]u64 = []
    var w: u64 = 0
    c = 0
    loop {
        if c >= nfn { break }
        if flag[c] { fkeys[w] = keys[c]; fslots[w] = 1; w++ }
        c++
    }
    cg_table_build(fkeys, fslots)
}

/**
 * cg_prog_needs_region — the conservative ascending fixpoint marking every function that must receive
 * the implicit region parameter. A function is above the line unless it is structurally a memory
 * provider (D158) or a divergent primitive (D159). Seeds are the functions that produce escaping
 * storage (heap return, direct allocation) or dispatch indirectly; the mark then propagates to any
 * caller of an above-the-line function, since it must thread its own region down.
 *
 * @param items     the whole-program items
 * @param noreturn  the diverging-function table from `cg_prog_noreturn`
 * @return          a name table whose non-zero slots are the above-the-line (region-receiving) keys
 */
fn cg_prog_needs_region(items: []@TItem(), noreturn: CgNameTable): CgNameTable {
    var nfn: u64 = 0
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        match items[i] { checker::TFunction as f => if !f.is_extern { nfn++ }; _ => { } }
        i++
    }
    var keys: [nfn]str = []
    var below: [nfn]bool = []
    var flag: [nfn]bool = []
    var k: u64 = 0
    i = 0
    loop {
        if i >= items.len { break }
        match items[i] {
            checker::TFunction as f => {
                if !f.is_extern {
                    var key = cg_fn_key(f.namespace, f.name)
                    keys[k] = key
                    below[k] = cg_fn_below_line_a(f) || cg_table_get(noreturn, key) != 0
                    flag[k] = !below[k] && (cg_type_is_heap(f.return_type) || cg_block_allocs(f.body) || cg_block_indirect(f.body))
                    k++
                }
            }
            _ => { }
        }
        i++
    }
    var scratch = cg_scope_begin()
    var fvset: []str = []
    i = 0
    loop {
        if i >= items.len { break }
        match items[i] { checker::TFunction as f => if !f.is_extern { fvset = cg_block_collect_funcvals(f.body, fvset) }; _ => { } }
        i++
    }
    k = 0
    loop {
        if k >= nfn { break }
        if str_list_has(fvset, keys[k]) { flag[k] = true; below[k] = false }
        k++
    }
    var callees: [nfn][]str = []
    var kk: u64 = 0
    i = 0
    loop {
        if i >= items.len { break }
        match items[i] { checker::TFunction as f => if !f.is_extern { callees[kk] = cg_block_collect_keys(f.body, []); kk++ }; _ => { } }
        i++
    }
    var index = cg_table_build(keys, cg_fn_index_slots(nfn))
    var changed = true
    loop {
        if !changed { break }
        changed = false
        var f2: u64 = 0
        loop {
            if f2 >= nfn { break }
            if !flag[f2] && !below[f2] && cg_callees_hit_flag(callees[f2], index, flag) { flag[f2] = true; changed = true }
            f2++
        }
    }
    cg_scope_end(scratch)
    cg_flag_table(keys, flag, nfn)
}

fn cg_fn_index_slots(n: u64): []u64 {
    var out: [n]u64 = []
    var i: u64 = 0
    loop { if i >= n { break }; out[i] = i + 1; i++ }
    out
}

fn cg_callees_hit_flag(callees: []str, index: CgNameTable, flag: []bool): bool {
    var i: u64 = 0
    loop {
        if i >= callees.len { break }
        var slot = cg_table_get(index, callees[i])
        if slot != 0 && flag[slot - 1] { return true }
        i++
    }
    false
}

fn cg_key_is_terminator(k: str): bool {
    teko::runtime::str_eq(k, "teko::runtime::panic") || teko::runtime::str_eq(k, "teko::runtime::exit") || teko::runtime::str_eq(k, "::panic") || teko::runtime::str_eq(k, "::exit")
}

fn cg_stmt_calls_maypanic(prog: CgProg, s: @TStatement()): bool {
    if prog.maypanic.slots.len == 0 { return false }
    var keys = cg_block_collect_keys([s], [])
    var i: u64 = 0
    loop {
        if i >= keys.len { break }
        if cg_key_is_terminator(keys[i]) { return true }
        if cg_table_get(prog.maypanic, keys[i]) != 0 { return true }
        i++
    }
    false
}

fn cg_table_cap(entries: u64): u64 {
    var want = entries * CG_TABLE_LOAD_NUMERATOR
    var cap = CG_TABLE_MIN_CAP
    loop {
        if cap >= want { break }
        cap = cap * 2
    }
    cap
}

fn cg_zeros(n: u64): []u64 {
    var out: [n]u64 = []
    out
}

fn cg_blanks(n: u64): []str {
    var out: [n]str = []
    out
}

fn cg_table_build(keys_in: []str, slots_in: []u64): CgNameTable {
    var cap = cg_table_cap(keys_in.len)
    var mask = cap - 1
    var hashes = cg_zeros(cap)
    var keys = cg_blanks(cap)
    var slots = cg_zeros(cap)
    var n: u64 = 0
    loop {
        if n >= keys_in.len { break }
        var key = keys_in[n]
        var h = teko::runtime::str_hash(key)
        var at = h & mask
        loop {
            if slots[at] == 0 {
                hashes[at] = h
                keys[at] = key
                slots[at] = slots_in[n]
                break
            }
            if hashes[at] == h && keys[at] == key { break }
            at = (at + 1) & mask
        }
        n++
    }
    CgNameTable { mask = mask; hashes = hashes; keys = keys; slots = slots }
}

fn cg_table_bucket_of(t: CgNameTable, key: str): u64 {
    var miss = t.mask + 1
    if t.slots.len == 0 { return miss }
    var h = teko::runtime::str_hash(key)
    var at = h & t.mask
    loop {
        if t.slots[at] == 0 { return miss }
        if t.hashes[at] == h && t.keys[at] == key { return at }
        at = (at + 1) & t.mask
    }
    miss
}

fn cg_table_get(t: CgNameTable, key: str): u64 {
    if t.slots.len == 0 { return 0 to u64 }
    var h = teko::runtime::str_hash(key)
    var at = h & t.mask
    loop {
        if t.slots[at] == 0 { return 0 to u64 }
        if t.hashes[at] == h && t.keys[at] == key { return t.slots[at] }
        at = (at + 1) & t.mask
    }
    0 to u64
}

fn cg_index_of(items: []@TItem()): CgIndex {
    var exact_kb: [items.len]str = []
    var exact_vb: [items.len]u64 = []
    var last_kb: [items.len]str = []
    var last_vb: [items.len]u64 = []
    var fn_kb: [items.len]str = []
    var fn_vb: [items.len]u64 = []
    var tc: u64 = 0
    var fc: u64 = 0
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        match items[i] {
            parser::TypeDecl as d => {
                exact_kb[tc] = d.name
                exact_vb[tc] = i + 1
                last_kb[tc] = checker::name_last_segment(d.name)
                last_vb[tc] = i + 1
                tc++
            }
            checker::TFunction as f => {
                fn_kb[fc] = cg_fn_key(f.namespace, f.name)
                fn_vb[fc] = i + 1
                fc++
            }
            _ => { }
        }
        i++
    }
    var exact_k = teko::collections::arr_slice(exact_kb, 0, tc)
    var exact_v = teko::collections::arr_slice(exact_vb, 0, tc)
    var last_k = teko::collections::arr_slice(last_kb, 0, tc)
    var last_v = teko::collections::arr_slice(last_vb, 0, tc)
    var fn_k = teko::collections::arr_slice(fn_kb, 0, fc)
    var fn_v = teko::collections::arr_slice(fn_vb, 0, fc)
    var last_table = cg_table_build(last_k, last_v)
    CgIndex {
        exact = cg_table_build(exact_k, exact_v)
        last = last_table
        fns = cg_table_build(fn_k, fn_v)
        same_last_next = cg_same_last_chain(items.len, last_table, last_k, last_v)
    }
}

fn cg_same_last_chain(items_len: u64, last_table: CgNameTable, last_k: []str, last_v: []u64): []u64 {
    var chain = cg_zeros(items_len)
    var tail = cg_zeros(last_table.mask + 2)
    var n: u64 = 0
    loop {
        if n >= last_k.len { break }
        var bucket = cg_table_bucket_of(last_table, last_k[n])
        if tail[bucket] != 0 { chain[tail[bucket] - 1] = last_v[n] }
        tail[bucket] = last_v[n]
        n++
    }
    chain
}

fn cg_fn_key(ns: str, name: str): str { teko::str::concat(ns, "::", name) }

/**
 * cg_fn_needs_region — true when `f` receives the implicit region parameter (`_tkrgn`), i.e. it is
 * above the line per the region oracle. Extern functions never do.
 *
 * @param prog  the codegen program (carrying the region oracle table)
 * @param f     the typed function
 * @return      true iff `f`'s signature carries `tk_region *_tkrgn`
 */
fn cg_fn_needs_region(prog: CgProg, f: checker::TFunction): bool {
    if f.is_extern { return false }
    cg_table_get(prog.needs_region, cg_fn_key(f.namespace, f.name)) != 0
}

/**
 * cg_call_needs_region — true when a direct call to `ns::name` must pass a region argument.
 *
 * @param prog  the codegen program (carrying the region oracle table)
 * @param ns    the resolved callee namespace
 * @param name  the callee's bare name
 * @return      true iff the callee is above the line
 */
fn cg_call_needs_region(prog: CgProg, ns: str, name: str): bool {
    if ns.len == 0 { return false }
    cg_table_get(prog.needs_region, cg_fn_key(ns, name)) != 0
}

/**
 * cg_prog_needs_region_of — build the region oracle table for `items`: the noreturn fixpoint feeds the
 * needs-region fixpoint.
 *
 * @param items  the whole-program items
 * @return       the above-the-line (region-receiving) name table
 */
fn cg_prog_needs_region_of(items: []@TItem()): CgNameTable {
    cg_prog_needs_region(items, cg_prog_noreturn(items))
}

fn cg_prog_of(p: checker::TProgram): CgProg {
    var uc = cg_prog_uses_capture(p.items)
    CgProg { items = p.items; ix = cg_index_of(p.items); cond_consts = checker::cond_const_names(p.items); uses_capture = uc; maypanic = cg_prog_maypanic(p.items, uc); needs_region = cg_prog_needs_region_of(p.items); table = checker::type_table_of(p) }
}

fn cg_mode_is_test(mode: CgMode): bool {
    match mode {
        CgMode::TestPlain => true
        CgMode::TestCov => true
        CgMode::TestAnalyze => true
        _ => false
    }
}

fn cg_prog_maybe_force_capture(prog: CgProg, mode: CgMode): CgProg {
    if !cg_mode_is_test(mode) { return prog }
    if prog.uses_capture { return prog }
    CgProg { items = prog.items; ix = prog.ix; cond_consts = prog.cond_consts; uses_capture = true; maypanic = cg_prog_maypanic(prog.items, true); needs_region = prog.needs_region; table = prog.table }
}

fn cg_prog_bare(p: checker::TProgram): CgProg {
    var empty: CgNameTable = CgNameTable {
        mask = 0 to u64
        hashes = []
        keys = []
        slots = []
    }
    var ix = CgIndex { exact = empty; last = empty; fns = empty; same_last_next = [] }
    var uc = cg_prog_uses_capture(p.items)
    CgProg { items = p.items; ix = ix; cond_consts = checker::cond_const_names(p.items); uses_capture = uc; maypanic = cg_prog_maypanic(p.items, uc); needs_region = cg_prog_needs_region_of(p.items); table = checker::type_table_of(p) }
}

fn cg_type_table(prog: CgProg): checker::TypeTable {
    prog.table
}

fn cg_path_last(p: parser::Path): str {
    if p.segments.len == 0 { "" } else { p.segments[p.segments.len - 1].name }
}

fn cg_find_variant_decl(prog: CgProg, name: str): parser::TypeDecl | error {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as d => {
            match d.body { parser::VariantBody => return d; _ => { } }
        }
        error => { }
    }
    error { message = "codegen: not a declared variant" }
}

fn cg_canon_name(prog: CgProg, name: str): str {
    match cg_find_decl(prog, name) { parser::TypeDecl as d => d.name; error => name }
}

fn cg_canon_name_ns(prog: CgProg, path: parser::Path, ref_ns: str): str {
    match cg_find_decl_ns(prog, path, ref_ns) {
        parser::TypeDecl as d => d.name
        error => cg_canon_name(prog, path.segments[path.segments.len - 1].name)
    }
}

fn cg_named_is_variant(prog: CgProg, name: str): bool {
    match cg_find_variant_decl(prog, name) { parser::TypeDecl => true; error => false }
}

fn cg_named_is_enum(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as d => match d.body { parser::EnumBody => true; _ => false }
        error => false
    }
}

fn cg_named_is_flags(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as d => match d.body { parser::FlagsBody => true; _ => false }
        error => false
    }
}

fn cg_decl_at(prog: CgProg, slot: u64): parser::TypeDecl | error {
    if slot == 0 { return error { message = "codegen: no such type decl" } }
    match prog.items[slot - 1] {
        parser::TypeDecl as d => d
        _ => error { message = "codegen: no such type decl" }
    }
}

fn cg_find_decl_scan(prog: CgProg, name: str): parser::TypeDecl | error {
    var e = 0
    loop {
        if e >= prog.items.len { break }
        match prog.items[e] {
            parser::TypeDecl as d => { if d.name == name { return d } }
            _ => { }
        }
        e++
    }
    var want = checker::name_last_segment(name)
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => { if checker::name_last_segment(d.name) == want { return d } }
            _ => { }
        }
        i++
    }
    error { message = "codegen: no such type decl" }
}

fn cg_find_decl(prog: CgProg, name: str): parser::TypeDecl | error {
    if prog.ix.exact.slots.len == 0 { return cg_find_decl_scan(prog, name) }
    var hit = cg_table_get(prog.ix.exact, name)
    if hit != 0 { return cg_decl_at(prog, hit) }
    cg_decl_at(prog, cg_table_get(prog.ix.last, checker::name_last_segment(name)))
}

fn cg_find_decl_ns(prog: CgProg, path: parser::Path, ref_ns: str): parser::TypeDecl | error {
    var last_raw = path.segments[path.segments.len - 1].name
    var last = checker::name_last_segment(last_raw)
    var embedded_qual = checker::name_qualifier(last_raw)
    var qualified = path.segments.len > 1 || embedded_qual.len > 0
    var qual = ""
    if path.segments.len > 1 {
        var q: u64 = 0
        loop {
            if q >= path.segments.len - 1 { break }
            if q == 0 { qual = path.segments[q].name } else { qual = qual ~ "::" ~ path.segments[q].name }
            q++
        }
    } else {
        qual = embedded_qual
    }
    if prog.ix.same_last_next.len == 0 { return cg_find_decl_ns_scan(prog, last, qual, ref_ns, qualified) }
    var cur = cg_table_get(prog.ix.last, last)
    var head = cur
    loop {
        if cur == 0 { break }
        match prog.items[cur - 1] {
            parser::TypeDecl as d => { if cg_decl_ns_matches(d, qual, ref_ns, qualified) { return d } }
            _ => { }
        }
        cur = prog.ix.same_last_next[cur - 1]
    }
    cg_decl_at(prog, head)
}

fn cg_decl_ns_matches(d: parser::TypeDecl, qual: str, ref_ns: str, qualified: bool): bool {
    var dns = checker::name_qualifier(d.name)
    if !qualified { return dns == ref_ns }
    dns == qual || dns.ends_with("::" ~ qual)
}

fn cg_find_decl_ns_scan(prog: CgProg, last: str, qual: str, ref_ns: str, qualified: bool): parser::TypeDecl | error {
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => {
                if checker::name_last_segment(d.name) == last && cg_decl_ns_matches(d, qual, ref_ns, qualified) { return d }
            }
            _ => { }
        }
        i++
    }
    var j = 0
    loop {
        if j >= prog.items.len { break }
        match prog.items[j] {
            parser::TypeDecl as d => { if checker::name_last_segment(d.name) == last { return d } }
            _ => { }
        }
        j++
    }
    error { message = "codegen: no such type decl" }
}

fn cg_expr_is_addressable(e: checker::TExpr): bool {
    match e.kind {
        checker::TVar => true
        checker::TFieldAccess => true
        checker::TIndex => true
        checker::TStructInit => true
        _ => false
    }
}

fn cg_emit_self_addr(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), recv: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write("&(")
    emit_expr_ctx(buf, prog, ret_type, recv, escaping, regions, fn_body, dctx)
    buf.write(")")
}

fn cg_call_needs_self_hoist(prog: CgProg, cf: checker::TFunction, c: checker::TCall): bool {
    if cf.params.len == 0 { return false }
    var is_self0 = match cg_struct_self_recv(prog, cf) { str => true; null => false }
    if !is_self0 { return false }
    if c.args.len == 0 { return false }
    !cg_expr_is_addressable(c.args[0])
}

fn cg_var_is_struct_self(prog: CgProg, e: checker::TExpr, v: checker::TVar): bool {
    if !teko::runtime::str_eq(v.name, "self") { return false }
    match e.type {
        checker::Named as nm => cg_is_struct_named(prog, nm.name)
        _ => false
    }
}

fn cg_is_struct_named(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as td => match td.body { parser::StructBody => true; _ => false }
        error => false
    }
}

fn cg_struct_self_recv(prog: CgProg, f: checker::TFunction): str | null {
    if f.params.len == 0 { return null }
    if !teko::runtime::str_eq(f.params[0].name, "self") { return null }
    var nt = match f.params[0].type_ann { parser::NamedType as x => x; _ => return null }
    if nt.path.segments.len == 0 { return null }
    var nm = nt.path.segments[nt.path.segments.len - 1].name
    if !cg_is_struct_named(prog, nm) { return null }
    nm
}

fn cg_is_class_named(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as td => match td.body { parser::ClassBody => true; _ => false }
        error => false
    }
}

fn cg_extern_native_tag(prog: CgProg, name: str): str | null {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as td => match td.body {
            parser::ExternStructBody as esb => if esb.c_tag.len > 0 { esb.c_tag } else { null }
            _ => null
        }
        error => null
    }
}

fn cg_class_body_is_poly(cb: parser::ClassBody): bool {
    match cb.kind { parser::ClassKind::Sealed => false; _ => true }
}

fn cg_emit_named_ctype(buf: teko::io::FileStream, prog: CgProg, name: str) {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as td => match td.body {
            parser::ClassBody as cb => if cg_class_body_is_poly(cb) { buf.write("tk_base_"); cb_tysym(buf, name) } else { mangle_type_name(buf, "", name); buf.write(" *") }
            parser::ExternStructBody as esb => if esb.c_tag.len > 0 { buf.write("struct "); buf.write(esb.c_tag) } else { mangle_type_name(buf, "", name) }
            _ => mangle_type_name(buf, "", name)
        }
        error => mangle_type_name(buf, "", name)
    }
}

fn cg_named_ctype_str(prog: CgProg, name: str): str {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as td => match td.body {
            parser::ClassBody as cb => if cg_class_body_is_poly(cb) { teko::str::concat("tk_base_", cb_tysym_str(name)) } else { teko::str::concat(mangle_type_name_str("", name), " *") }
            parser::ExternStructBody as esb => if esb.c_tag.len > 0 { teko::str::concat("struct ", esb.c_tag) } else { mangle_type_name_str("", name) }
            _ => mangle_type_name_str("", name)
        }
        error => mangle_type_name_str("", name)
    }
}

fn cg_is_interface_named(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as td => match td.body { parser::InterfaceBody => true; _ => false }
        error => false
    }
}

fn cg_is_trait_named(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as td => match td.body { parser::TraitBody => true; _ => false }
        error => false
    }
}

fn cg_is_polymorphic_base(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as td => match td.body {
            parser::ClassBody as cb => match cb.kind { parser::ClassKind::Sealed => false; _ => true }
            _ => false
        }
        error => false
    }
}

const SUBCLASS_CHAIN_DEPTH_LIMIT: i64 = 64

fn cg_subclass_reaches(prog: CgProg, sub: str, want: str, depth: i64): bool {
    if depth <= 0 { return false }
    match cg_find_decl(prog, sub) {
        parser::TypeDecl as td => match td.body {
            parser::ClassBody as cb => {
                if !cb.has_base { return false }
                if checker::name_qualifier(cb.base_name) != "" && checker::name_qualifier(want) != "" {
                    if cb.base_name == want { return true }
                } else {
                    if checker::name_last_segment(cb.base_name) == checker::name_last_segment(want) { return true }
                }
                cg_subclass_reaches(prog, cb.base_name, want, depth - 1)
            }
            _ => false
        }
        error => false
    }
}

fn cg_expr_refs_name(e: checker::TExpr, name: str): bool {
    match e.kind {
        checker::TVar as v => v.name == name
        checker::TNumber => false
        checker::TStrLit => false
        checker::TByteStrLit => false
        checker::TByteLit => false
        checker::TCharLit => false
        checker::TBoolLit => false
        checker::TNullLit => false
        checker::TPathExpr => false
        checker::TBinary as b => cg_expr_refs_name(b.left, name) || cg_expr_refs_name(b.right, name)
        checker::TUnary as u => cg_expr_refs_name(u.operand, name)
        checker::TCompare as c => {
            if cg_expr_refs_name(c.first, name) { true } else {
                var i = 0
                var found = false
                loop { if i >= c.rest.len { break }; if cg_expr_refs_name(c.rest[i].operand, name) { found = true; break }; i++ }
                found
            }
        }
        checker::TCall as c => {
            var i = 0
            var found = false
            loop { if i >= c.args.len { break }; if cg_expr_refs_name(c.args[i], name) { found = true; break }; i++ }
            found
        }
        checker::TCast as ct => cg_expr_refs_name(ct.expr, name)
        checker::TFieldAccess as fa => cg_expr_refs_name(fa.receiver, name)
        checker::TIndex as ix => cg_expr_refs_name(ix.receiver, name) || cg_expr_refs_name(ix.index, name)
        checker::TInterp as ip => {
            var i = 0
            var found = false
            loop { if i >= ip.holes.len { break }; if cg_expr_refs_name(ip.holes[i], name) { found = true; break }; i++ }
            found
        }
        checker::TInExpr as ie => {
            if cg_expr_refs_name(ie.lhs, name) { true } else {
                var i = 0
                var found = false
                loop { if i >= ie.elems.len { break }; if cg_expr_refs_name(ie.elems[i], name) { found = true; break }; i++ }
                found
            }
        }
        checker::TStructInit as si => {
            var i = 0
            var found = false
            loop { if i >= si.field_vals.len { break }; if cg_expr_refs_name(si.field_vals[i], name) { found = true; break }; i++ }
            found
        }
        checker::TArrayLit as al => {
            var i = 0
            var found = false
            loop { if i >= al.elements.len { break }; if cg_expr_refs_name(al.elements[i].expr, name) { found = true; break }; i++ }
            found
        }
        _ => true
    }
}

fn cg_find_destruct_ns(prog: CgProg, class_name: str): str | null {
    cg_find_method_ns(prog, class_name, "destruct")
}

fn cg_find_method_ns(prog: CgProg, class_name: str, method: str): str | null {
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as tf => {
                if tf.name == method {
                    if tf.namespace == class_name { return tf.namespace }
                    if tf.namespace.ends_with("::" ~ class_name) { return tf.namespace }
                }
            }
            _ => { }
        }
        i++
    }
}

fn cg_binding_is_slice_element_borrow(b: checker::TBinding): bool {
    match b.value.kind {
        checker::TIndex as ix => match ix.receiver.type { checker::Slice => true; _ => false }
        _ => false
    }
}

fn cg_class_cleanup_text(prog: CgProg, escaping: []str, fn_body: []@TStatement(), has_tail: bool, tail_expr: checker::TExpr): str | error {
    var out = ""
    var i = 0
    loop {
        if i >= fn_body.len { break }
        match fn_body[i] {
            checker::TBinding as b => {
                var name = match b.target { parser::SimpleName as sn => sn.name; parser::DestructurePattern => "" }
                var referenced_in_tail = has_tail && cg_expr_refs_name(tail_expr, name)
                var is_borrow = cg_binding_is_slice_element_borrow(b)
                if name.len > 0 && name != "_" && b.kind != parser::BindKind::Const && !cg_str_in(escaping, name) && !referenced_in_tail && !is_borrow {
                    var cname = match b.bound { checker::Named as nm => nm.name; _ => "" }
                    if cname.len > 0 && cg_is_class_named(prog, cname) && !cg_is_polymorphic_base(prog, cname) {
                        match cg_find_destruct_ns(prog, cname) {
                            str as ns => {
                                out = teko::str::concat(out, cb_fn_name_str(ns, "destruct"))
                                out = teko::str::concat(out, "(")
                                out = teko::str::concat(out, cb_ident_str(name))
                                out = teko::str::concat(out, "); ")
                            }
                            null => { }
                        }
                        out = teko::str::concat(out, cg_arena_sym(CgArenaSym::RegionDrop))
                        out = teko::str::concat(out, "(")
                        out = teko::str::concat(out, cb_ident_str(name))
                        out = teko::str::concat(out, "->__region); ")
                    }
                }
            }
            _ => { }
        }
        i++
    }
    out
}

fn cg_find_function_scan(prog: CgProg, ns: str, name: str): checker::TFunction | error {
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { if f.name == name && f.namespace == ns { return f } }
            _ => { }
        }
        i++
    }
    error { message = "codegen: no such function" }
}

fn cg_find_function(prog: CgProg, ns: str, name: str): checker::TFunction | error {
    if prog.ix.fns.slots.len == 0 { return cg_find_function_scan(prog, ns, name) }
    var hit = cg_table_get(prog.ix.fns, cg_fn_key(ns, name))
    if hit == 0 { return error { message = "codegen: no such function" } }
    match prog.items[hit - 1] {
        checker::TFunction as f => { if f.name == name && f.namespace == ns { return f } }
        _ => { }
    }
    cg_find_function_scan(prog, ns, name)
    error { message = "codegen: no such function" }
}

fn cg_is_prim_name(name: str): bool { cg_is_builtin_scalar(name) }

fn cg_nameset_seen(seen: []str, n: str): bool { cg_str_in(seen, n) }

fn cg_visited_upto(visited: []str, depth: u64, n: str): bool {
    var i: u64 = 0
    loop {
        if i >= depth { break }
        if visited[i] == n { return true }
        i = i + 1
    }
    false
}

fn cg_te_reaches_byvalue(prog: CgProg, te: @TypeExpr(), to: str, ref visited: []str, depth: u64): bool {
    match te {
        parser::NamedType as nt => {
            var stem = nt.path.segments[nt.path.segments.len - 1].name
            if cg_is_prim_name(stem) { return false }
            if cg_is_class_named(prog, stem) { return false }
            var y = if nt.args.len == 0 { stem } else { cg_texpr_inst_name(stem, nt.args) }
            if checker::name_last_segment(y) == checker::name_last_segment(to) { return true }
            cg_name_reaches_byvalue(prog, y, to, visited, depth)
        }
        parser::UnionType as ut => {
            var i = 0
            loop {
                if i >= ut.members.len { break }
                if cg_te_reaches_byvalue(prog, ut.members[i], to, visited, depth) { return true }
                i++
            }
            false
        }
        parser::SliceType => false
        parser::SizedArrayType => false
        parser::FunctionType => false
        parser::MacroType => false
    }
}
fn cg_name_reaches_byvalue(prog: CgProg, from: str, to: str, ref visited: []str, depth: u64): bool {
    if cg_visited_upto(visited.value, depth, from) { return false }
    if depth >= visited.value.len { return true }
    visited[depth] = from
    var d = match cg_find_decl(prog, from) { parser::TypeDecl as dd => dd; error => return false }
    match d.body {
        parser::StructBody as sb => {
            var i = 0
            loop {
                if i >= sb.fields.len { break }
                if cg_te_reaches_byvalue(prog, sb.fields[i].type_ann, to, visited, depth + 1) { return true }
                i++
            }
            false
        }
        parser::VariantBody as vb => match vb.type_expr {
            parser::UnionType as u => {
                var i = 0
                loop {
                    if i >= u.members.len { break }
                    if cg_te_reaches_byvalue(prog, u.members[i], to, visited, depth + 1) { return true }
                    i++
                }
                false
            }
            _ => false
        }
        _ => false
    }
}
fn cg_field_boxed(prog: CgProg, sname: str, fte: @TypeExpr()): bool {
    var is_box_candidate = match fte {
        parser::NamedType => true
        parser::UnionType as ut => cg_union_field_inline_tag(prog, sname, ut)
        _ => false
    }
    if !is_box_candidate { return false }
    var cap: u64 = 512
    var visited: [cap]str = []
    cg_te_reaches_byvalue(prog, fte, sname, visited, 0)
}

fn cg_union_field_inline_tag(prog: CgProg, sname: str, ut: parser::UnionType): bool {
    match cg_te_to_type_ns(prog, checker::type_ns_of(cg_type_table(prog), sname), parser::UnionType { members = ut.members }) {
        checker::Variant as va => match union_repr_class(prog, va, false) {
            UnionRepr::InlineTag => true
            _ => false
        }
        _ => false
    }
}

fn cg_variant_has_member(d: parser::TypeDecl, member: str): bool {
    var members = match d.body {
        parser::VariantBody as vb => match vb.type_expr {
            parser::UnionType as u => u.members
            _ => return false
        }
        _ => return false
    }
    var i = 0
    loop {
        if i >= members.len { break }
        match variant_member_name(members[i]) {
            str as mn => { if mn == member { return true } }
            error => { }
        }
        i++
    }
    false
}

fn emit_type(buf: teko::io::FileStream, prog: CgProg, t: @Type()) {
    if cg_is_str_type(t) { buf.write("tk_str"); return }
    match t {
        checker::Prim as p => emit_prim(buf, p.kind)
        checker::Byte => buf.write("uint8_t")
        checker::Char => buf.write("tk_char")
        checker::Void => buf.write("void")
        checker::Slice as sl => match sl.element {
            checker::Void => panic("codegen: an untyped empty slice needs a known element type from context (internal)")
            _ => cg_slice_typename(buf, sl.element)
        }
        checker::Named as nm => cg_emit_named_ctype(buf, prog, nm.name)
        checker::Variant as va => match cg_union_niche_member(prog, va) {
            (@Type()) as x => emit_type(buf, prog, x)
            null => match cg_union_box_member(prog, va) {
                (@Type()) as bx => { emit_type(buf, prog, bx); buf.write(" *") }
                null => cg_variant_typename(buf, va)
            }
        }
        checker::Func => buf.write("tk_closure")
        checker::Error => buf.write("tk_error")
        checker::Ptr as p => match p.inner {
            null => buf.write("void *")
            (@Type()) as t => { emit_type(buf, prog, t); buf.write(" *") }
        }
        checker::Uptr => buf.write("uintptr_t")
        checker::Reference as r => { emit_type(buf, prog, r.inner); buf.write(" *") }
        checker::Null => buf.write("uint8_t")
    }
}

fn emit_type_str(prog: CgProg, t: @Type()): str {
    if cg_is_str_type(t) { return "tk_str" }
    match t {
        checker::Prim as p => emit_prim_str(p.kind)
        checker::Byte => "uint8_t"
        checker::Char => "tk_char"
        checker::Void => "void"
        checker::Slice as sl => match sl.element {
            checker::Void => panic("codegen: an untyped empty slice needs a known element type from context (internal)")
            _ => teko::str::concat("tk_slice_", match cg_opt_mangle_str(sl.element) { str as s => s; error as e => panic(e.message) })
        }
        checker::Named as nm => cg_named_ctype_str(prog, nm.name)
        checker::Variant as va => match cg_union_niche_member(prog, va) {
            (@Type()) as x => emit_type_str(prog, x)
            null => match cg_union_box_member(prog, va) {
                (@Type()) as bx => teko::str::concat(emit_type_str(prog, bx), " *")
                null => match cg_variant_typename_str(va) { str as s => s; error as e => panic(e.message) }
            }
        }
        checker::Func => "tk_closure"
        checker::Error => "tk_error"
        checker::Ptr as p => match p.inner {
            null => "void *"
            (@Type()) as pt => teko::str::concat(emit_type_str(prog, pt), " *")
        }
        checker::Uptr => "uintptr_t"
        checker::Reference as r => teko::str::concat(emit_type_str(prog, r.inner), " *")
        checker::Null => "uint8_t"
    }
}

fn cg_emit_fnptr_sig_ex(buf: teko::io::FileStream, prog: CgProg, t: @Type(), with_env: bool) {
    match t {
        checker::Func as f => {
            emit_type(buf, prog, f.ret)
            buf.write(" (*)(")
            var first = true
            if with_env { buf.write("void *"); first = false }
            var i = 0
            loop {
                if i >= f.params.len { break }
                if !first { buf.write(", ") }
                first = false
                emit_type(buf, prog, f.params[i])
                i++
            }
            if !first { buf.write(", ") }
            buf.write("tk_region *")
            buf.write(")")
        }
        _ => panic("codegen: closure call on a non-function type (internal)")
    }
}

fn emit_closure_call(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var nm = c.callee.segments[c.callee.segments.len - 1].name
    buf.write("({ ")
    var j = 0
    loop {
        if j >= c.args.len { break }
        emit_type(buf, prog, c.args[j].type)
        buf.write(" ")
        buf.write("_tca")
        cb_u64_digits(buf, j to u64)
        buf.write(" = ")
        emit_expr_ctx(buf, prog, ret_type, c.args[j], escaping, regions, fn_body, dctx)
        buf.write("; ")
        j++
    }
    buf.write("tk_closure _tcf = ")
    cb_ident(buf, nm)
    buf.write("; _tcf.env ? ((")
    cg_emit_fnptr_sig_ex(buf, prog, c.callee_type, true)
    buf.write(")_tcf.fn)(_tcf.env")
    var k = 0
    loop { if k >= c.args.len { break }; buf.write(", "); buf.write("_tca"); cb_u64_digits(buf, k to u64); k++ }
    buf.write(", "); buf.write(cg_call_region(dctx))
    buf.write(") : ((")
    cg_emit_fnptr_sig_ex(buf, prog, c.callee_type, false)
    buf.write(")_tcf.fn)(")
    var m = 0
    loop { if m >= c.args.len { break }; if m > 0 { buf.write(", ") }; buf.write("_tca"); cb_u64_digits(buf, m to u64); m++ }
    if c.args.len > 0 { buf.write(", ") }
    buf.write(cg_call_region(dctx))
    buf.write("); })")
}

fn cg_slice_typename(buf: teko::io::FileStream, elem: @Type()) {
    buf.write("tk_slice_")
    match cg_opt_mangle_str(elem) { str as s => buf.write(s); error as e => panic(e.message) }
}
fn cg_slice_rep_has_cap(elem: @Type()): bool {
    match elem { checker::Byte => false; checker::Char => false; _ => true }
}

fn cg_opt_mangle_str(inner: @Type()): str | error {
    if cg_is_str_type(inner) { return "str" }
    match inner {
        checker::Prim as p => match p.kind {
            checker::PrimKind::U8 => "u8"; checker::PrimKind::U16 => "u16"
            checker::PrimKind::U32 => "u32"; checker::PrimKind::U64 => "u64"
            checker::PrimKind::I8 => "i8"; checker::PrimKind::I16 => "i16"
            checker::PrimKind::I32 => "i32"; checker::PrimKind::I64 => "i64"
            checker::PrimKind::F32 => "f32"; checker::PrimKind::F64 => "f64"
            checker::PrimKind::Bool => "bool"
            checker::PrimKind::Usize => "u64"; checker::PrimKind::Isize => "i64"
        }
        checker::Byte => "byte"
        checker::Char => "char"
        checker::Error => "error"
        checker::Null => "null"
        checker::Void => "void"
        checker::Named as nm => cg_ns_c_key(nm.name)
        checker::Slice as sl => match sl.element {
            checker::Void => error { message = "codegen: an untyped empty slice needs a known element type from context (internal)" }
            _ => { var elem_s = match cg_opt_mangle_str(sl.element) { str as s => s; error as e => return e }; teko::str::concat("slice_", elem_s) }
        }
        checker::Variant as va => cg_union_mangle_str(va)
        checker::Ptr as p => match p.inner {
            (@Type()) as t => { var s = match cg_opt_mangle_str(t) { str as x => x; error as e => return e }; teko::str::concat("ptr_", s) }
            null => "ptr_void"
        }
        checker::Uptr => "uptr"
        checker::Reference as r => { var s = match cg_opt_mangle_str(r.inner) { str as x => x; error as e => return e }; teko::str::concat("ref_", s) }
        checker::Func as f => {
            var rs = match cg_opt_mangle_str(f.ret) { str as x => x; error as e => return e }
            teko::str::concat(teko::str::concat("fn", teko::u64_to_str(f.params.len)), rs)
        }
    }
}

fn cg_union_mangle_str(va: checker::Variant): str | error {
    var out = "u"
    var i = 0
    loop {
        if i >= va.members.len { break }
        var k = match cg_member_key_str(va.members[i]) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

fn cg_is_c_keyword(s: str): bool {
    s == "bool" || s == "int" || s == "char" || s == "short" || s == "long" ||
    s == "float" || s == "double" || s == "void" || s == "unsigned" || s == "signed" ||
    s == "const" || s == "volatile" || s == "register" || s == "auto" || s == "static" ||
    s == "struct" || s == "union" || s == "enum" || s == "return" || s == "default" ||
    s == "goto" || s == "break" || s == "continue" || s == "case" || s == "switch" ||
    s == "do" || s == "for" || s == "while" || s == "if" || s == "else" || s == "sizeof" ||
    s == "typedef" || s == "extern" || s == "inline" || s == "restrict"
}

fn cb_ident(buf: teko::io::FileStream, name: str) {
    buf.write(name)
    if cg_is_c_keyword(name) { buf.write("_") }
}

fn cb_ident_str(name: str): str {
    if cg_is_c_keyword(name) { teko::str::concat(name, "_") } else { name }
}

fn cg_member_key_str(m: @Type()): str | error {
    var k = match m {
        checker::Slice as sl => match sl.element {
            checker::Void => return error { message = "codegen: an untyped slice variant member needs a known element type (internal)" }
            _ => { var inner_s = match cg_opt_mangle_str(sl.element) { str as s => s; error as e => return e }; teko::str::concat("slice_", inner_s) }
        }
        _ => match cg_opt_mangle_str(m) { str as s => s; error as e => return e }
    }
    if cg_is_c_keyword(k) { teko::str::concat(k, "_") } else { k }
}

fn cg_member_key_is_c_keyword(m: @Type()): bool {
    match m {
        checker::Prim as p => match p.kind {
            checker::PrimKind::Bool => true
            _ => false
        }
        checker::Char => true
        checker::Named as nm => cg_is_c_keyword(cg_ns_c_key(nm.name))
        _ => false
    }
}

fn cg_member_key(buf: teko::io::FileStream, m: @Type()) {
    var out = match cg_opt_mangle_str(m) { str as s => s; error as e => panic(e.message) }
    if cg_member_key_is_c_keyword(m) { out = teko::str::concat(out, "_") }
    buf.write(out)
}

fn cg_opt_mangle_bare_str(inner: @Type()): str | error {
    match inner {
        checker::Named as nm => checker::name_last_segment(nm.name)
        checker::Slice as sl => match sl.element {
            checker::Void => error { message = "codegen: an untyped empty slice needs a known element type from context (internal)" }
            _ => { var elem_s = match cg_opt_mangle_bare_str(sl.element) { str as s => s; error as e => return e }; teko::str::concat("slice_", elem_s) }
        }
        checker::Variant as va => cg_union_mangle_bare_str(va)
        _ => cg_opt_mangle_str(inner)
    }
}

fn cg_union_mangle_bare_str(va: checker::Variant): str | error {
    var out = "u"
    var i = 0
    loop {
        if i >= va.members.len { break }
        var k = match cg_member_bare_key(va.members[i]) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

fn cg_member_bare_key(m: @Type()): str | error {
    var k = match m {
        checker::Slice as sl => match sl.element {
            checker::Void => return error { message = "codegen: an untyped slice variant member needs a known element type (internal)" }
            _ => { var inner_s = match cg_opt_mangle_bare_str(sl.element) { str as s => s; error as e => return e }; teko::str::concat("slice_", inner_s) }
        }
        _ => match cg_opt_mangle_bare_str(m) { str as s => s; error as e => return e }
    }
    if cg_is_c_keyword(k) { teko::str::concat(k, "_") } else { k }
}

fn cg_variant_typename(buf: teko::io::FileStream, v: checker::Variant) {
    buf.write("tk_u")
    var i = 0
    loop {
        if i >= v.members.len { break }
        buf.write("_")
        cg_member_key(buf, v.members[i])
        i++
    }
}

fn cg_variant_typename_str(v: checker::Variant): str | error {
    var out = "tk_u"
    var i = 0
    loop {
        if i >= v.members.len { break }
        var k = match cg_member_key_str(v.members[i]) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

fn cg_variant_has_null(v: checker::Variant): bool {
    var i = 0
    loop {
        if i >= v.members.len { break }
        match v.members[i] { checker::Null => return true; _ => { } }
        i++
    }
    false
}

fn cg_union_normalize_null(members: []@Type()): []@Type() {
    var has_null = false
    var i = 0
    loop {
        if i >= members.len { break }
        match members[i] { checker::Null => has_null = true; _ => { } }
        i++
    }
    if !has_null { return members }
    var out: []@Type() = [checker::Null { }]
    var j = 0
    loop {
        if j >= members.len { break }
        match members[j] { checker::Null => { }; _ => out = [..out, members[j]] }
        j++
    }
    out
}

fn cg_type_is_niche_able(prog: CgProg, x: @Type()): bool {
    if cg_is_str_type(x) { return true }
    match x {
        checker::Ptr => true
        checker::Reference => true
        checker::Error => true
        checker::Named as nm => cg_is_class_named(prog, nm.name) && !cg_is_polymorphic_base(prog, nm.name)
        _ => false
    }
}

fn cg_union_niche_member(prog: CgProg, v: checker::Variant): @Type() | null {
    if v.members.len != 2 { return null }
    var null_count = 0
    var other: @Type() | null = null
    var i = 0
    loop {
        if i >= v.members.len { break }
        match v.members[i] {
            checker::Null => null_count = null_count + 1
            _ => other = v.members[i]
        }
        i++
    }
    if null_count != 1 { return null }
    var x = match other { (@Type()) as t => t; null => return null }
    if cg_type_is_niche_able(prog, x) { x } else { null }
}

fn cg_niche_is_fat(x: @Type()): bool {
    if cg_is_str_type(x) { return true }
    match x { checker::Error => true; _ => false }
}

fn cg_niche_null_accessor(x: @Type()): str {
    if cg_is_str_type(x) { return ".ptr" }
    match x {
        checker::Error => ".message.ptr"
        _ => ""
    }
}

fn cg_emit_niche_null(buf: teko::io::FileStream, prog: CgProg, x: @Type()) {
    if cg_niche_is_fat(x) {
        buf.write("(")
        emit_type(buf, prog, x)
        buf.write("){0}")
        return
    }
    buf.write("0")
}

fn cg_emit_niche_is_null(buf: teko::io::FileStream, subj: str, x: @Type()) {
    buf.write("(")
    buf.write(subj)
    buf.write(cg_niche_null_accessor(x))
    buf.write(" == 0)")
}

fn cg_emit_niche_not_null(buf: teko::io::FileStream, subj: str, x: @Type()) {
    buf.write("(")
    buf.write(subj)
    buf.write(cg_niche_null_accessor(x))
    buf.write(" != 0)")
}

fn cg_union_tag_ctype(buf: teko::io::FileStream, v: checker::Variant) {
    if cg_variant_has_null(v) { buf.write("uint8_t"); return }
    buf.write("tk_tag")
    var i = 0
    loop {
        if i >= v.members.len { break }
        buf.write("_")
        cg_member_key(buf, v.members[i])
        i++
    }
}

/**
 * The C representation chosen for a tagged union (sum).
 *
 * @member Niche       two-member `X | null` where `X` carries a spare bit-pattern; no tag word.
 * @member InlineTag   `struct { tag; union { <every member sized to the max> } as; }`.
 * @member BoxInArena  two-member `X | null` where the present value is heap-boxed and `null` is 0.
 * @member TagPtr      `struct { tag; void *payload; uint64_t len; }` with the payload boxed at the
 *                     EXACT per-member size; mirrors the native backend wrapper (24 B). Chosen for
 *                     large self-recursive sums, which InlineTag would otherwise size to the worst case.
 */
type UnionRepr = enum { Niche; InlineTag; BoxInArena; TagPtr }

fn cg_type_min_bytes(prog: CgProg, x: @Type()): u64 {
    cg_type_min_bytes_d(prog, x, 0)
}

fn cg_prim_min_bytes(k: checker::PrimKind): u64 {
    var bits = checker::prim_width(k, checker::host_target()) to u64
    if bits < (8 to u64) { return 1 to u64 }
    bits / (8 to u64)
}

fn cg_type_min_bytes_d(prog: CgProg, x: @Type(), depth: u64): u64 {
    if cg_is_str_type(x) { return 16 to u64 }
    match x {
        checker::Prim as p => cg_prim_min_bytes(p.kind)
        checker::Byte => 1 to u64
        checker::Char => 4 to u64
        checker::Error => 16 to u64
        checker::Slice => 16 to u64
        checker::Ptr => 8 to u64
        checker::Uptr => 8 to u64
        checker::Reference => 8 to u64
        checker::Func => 16 to u64
        checker::Null => 1 to u64
        checker::Named as nm => cg_named_min_bytes(prog, nm.name, depth)
        _ => 8 to u64
    }
}

fn cg_named_min_bytes(prog: CgProg, name: str, depth: u64): u64 {
    if cg_is_class_named(prog, name) { return 8 to u64 }
    if cg_named_is_enum(prog, name) { return 4 to u64 }
    if depth >= (4 to u64) { return 8 to u64 }
    var d = match cg_find_decl(prog, name) { parser::TypeDecl as dd => dd; error => return 8 to u64 }
    var sb = match d.body { parser::StructBody as s => s; _ => return 8 to u64 }
    var total = 0 to u64
    var i = 0
    loop {
        if i >= sb.fields.len { break }
        var ft = cg_te_to_type_ns(prog, checker::name_qualifier(name), sb.fields[i].type_ann)
        total = total + cg_type_min_bytes_d(prog, ft, depth + (1 to u64))
        i++
    }
    total
}

fn cg_union_box_member(prog: CgProg, v: checker::Variant): @Type() | null {
    if v.members.len != 2 { return null }
    var null_count = 0
    var other: @Type() | null = null
    var i = 0
    loop {
        if i >= v.members.len { break }
        match v.members[i] {
            checker::Null => null_count = null_count + 1
            _ => other = v.members[i]
        }
        i++
    }
    if null_count != 1 { return null }
    var x = match other { (@Type()) as t => t; null => return null }
    if cg_type_is_niche_able(prog, x) { return null }
    if cg_union_inline_recursive(prog, checker::Variant { members = v.members }, x) { return x }
    if cg_type_min_bytes(prog, x) >= (16 to u64) { x } else { null }
}

fn union_repr_class(prog: CgProg, v: checker::Variant, forced_inline: bool): UnionRepr {
    match cg_union_niche_member(prog, v) {
        (@Type()) as _gt4 => return UnionRepr::Niche
        null => { }
    }
    if forced_inline { return UnionRepr::InlineTag }
    match cg_union_box_member(prog, v) {
        (@Type()) as _gt5 => return UnionRepr::BoxInArena
        null => { }
    }
    if cg_union_is_tagptr(prog, v) { return UnionRepr::TagPtr }
    UnionRepr::InlineTag
}

/**
 * Is this sum eligible for the `TagPtr` representation? A union laid out `InlineTag` is sized to its
 * worst-case member, so every occurrence pays the largest variant even when it holds the smallest.
 * `TagPtr` replaces that with a 24-byte wrapper plus a payload boxed at the exact per-member size,
 * which lowers the dry-build peak whenever the waste is large enough (ratchet, D68). Two independent
 * triggers select it: the self-recursive family (bite 1) and the size threshold (bite 2).
 *
 * @param prog the program under codegen
 * @param v    the union to classify
 * @return     true iff the recursive-sum trigger or the inline-size threshold fires
 */
fn cg_union_is_tagptr(prog: CgProg, v: checker::Variant): bool {
    if cg_union_is_recursive_sum(prog, v) { return true }
    cg_union_exceeds_inline_threshold(prog, v)
}

/**
 * Does the union reach itself by value and carry more than 20 members? This is the bite-1 trigger:
 * the self-referential AST expression-kind sums (`TExprKind` 26, `ExprKind` 27) are already boxed by
 * `cg_field_boxed` and sized to their worst-case member, so `TagPtr` is a strict improvement. It is
 * kept distinct from the size threshold so those two unions flip on a principled, size-independent
 * ground regardless of how the threshold is calibrated.
 *
 * @param prog the program under codegen
 * @param v    the union to classify
 * @return     true iff some member reaches `v` by value and `v` has more than 20 members
 */
fn cg_union_is_recursive_sum(prog: CgProg, v: checker::Variant): bool {
    if v.members.len <= 20 { return false }
    var union_t: @Type() = checker::Variant { members = v.members }
    var i = 0
    loop {
        if i >= v.members.len { break }
        if cg_union_inline_recursive(prog, union_t, v.members[i]) { return true }
        i++
    }
    false
}

/**
 * Does the union's worst-case inline size waste enough to justify the 24-byte `TagPtr` wrapper? This
 * is the bite-2 trigger: a sum of at least six members whose largest variant is at least 56 bytes
 * (by `cg_type_min_bytes`) is dominated by that variant, so boxing the payload at its exact size and
 * shrinking every occurrence to the wrapper lowers the dry-build peak. Calibrated by ratchet: 56
 * captures the AST sums that dimension-to-max (`Type`, `TStatement`/`Statement`, `Pattern`) and the
 * large backend/IR sums, while leaving the smaller sums (`ConstraintExpr`, `TypeExpr`) inline where
 * the wrapper would cost more than it saves. Null-bearing sums are excluded: they route through the
 * niche / box / inline-null machinery, not the exact-box payload path.
 *
 * @param prog the program under codegen
 * @param v    the union to classify
 * @return     true iff `v` has at least six members, no `null` member, and a >= 56-byte largest member
 */
fn cg_union_exceeds_inline_threshold(prog: CgProg, v: checker::Variant): bool {
    if v.members.len < 6 { return false }
    if cg_variant_has_null(v) { return false }
    cg_union_max_member_bytes(prog, v) >= (56 to u64)
}

/**
 * The largest per-member size estimate, in bytes, across a union's members.
 *
 * @param prog the program under codegen
 * @param v    the union whose members to measure
 * @return     the maximum `cg_type_min_bytes` over every member, or 0 for an empty union
 */
fn cg_union_max_member_bytes(prog: CgProg, v: checker::Variant): u64 {
    var mx = 0 to u64
    var i = 0
    loop {
        if i >= v.members.len { break }
        var b = cg_type_min_bytes(prog, v.members[i])
        if b > mx { mx = b }
        i++
    }
    mx
}

/**
 * Does the union at `expected` use the `TagPtr` representation?
 *
 * @param prog     the program under codegen
 * @param expected the type to inspect (only anonymous `checker::Variant` sums can be `TagPtr`)
 * @return         true iff `union_repr_class` classifies it as `TagPtr`
 */
fn cg_variant_repr_is_tagptr(prog: CgProg, expected: @Type()): bool {
    match expected {
        checker::Variant as va => match union_repr_class(prog, va, false) {
            UnionRepr::TagPtr => true
            _ => false
        }
        _ => false
    }
}

/**
 * The declared type of the member whose C key is `key` in the variant, or `null` when absent.
 *
 * @param prog the program under codegen
 * @param v    the variant type
 * @param key  the mangled member key to match
 * @return     the member's type, or `null` if no member carries that key
 */
fn cg_variant_member_type_of_key(prog: CgProg, v: @Type(), key: str): @Type() | null {
    var n = cg_var_nmem(prog, v)
    var i = 0
    loop {
        if i >= n { break }
        var mk = match cg_var_mkey(prog, v, i) { str as s => s; error => "" }
        if mk == key { return cg_var_mtype(prog, v, i) }
        i++
    }
    null
}

/**
 * Emit a read of the `key` member payload of a `TagPtr`-or-`InlineTag` union `subj`. For `InlineTag`
 * this is `subj.as.<key>`; for `TagPtr` it dereferences the exact-typed box at `subj.payload`.
 *
 * @param prog  the program under codegen
 * @param buf   the output stream
 * @param subj  the C expression naming the wrapper value
 * @param subjT the variant type of `subj`
 * @param key   the mangled member key being read
 */
fn cg_emit_union_member_access(buf: teko::io::FileStream, prog: CgProg, subj: str, subjT: @Type(), key: str) {
    if cg_variant_repr_is_tagptr(prog, subjT) {
        var mt = match cg_variant_member_type_of_key(prog, subjT, key) { (@Type()) as t => t; null => checker::Void { } }
        buf.write("(*(")
        buf.write(emit_type_str(prog, mt))
        buf.write(" *)")
        buf.write(subj)
        buf.write(".payload)")
        return
    }
    buf.write(subj)
    buf.write(".as.")
    buf.write(key)
}

fn cg_union_inline_recursive(prog: CgProg, union_t: @Type(), x: @Type()): bool {
    cg_union_inline_recursive_seen(prog, union_t, x, [])
}

fn cg_union_inline_recursive_seen(prog: CgProg, union_t: @Type(), x: @Type(), seen: []str): bool {
    if cg_mangle_eq(union_t, x) { return true }
    var nm = match x { checker::Named as n => n; _ => return false }
    if cg_is_class_named(prog, nm.name) { return false }
    if cg_nameset_seen(seen, nm.name) { return false }
    var seen2 = [..seen, nm.name]
    var d = match cg_find_decl(prog, nm.name) { parser::TypeDecl as dd => dd; error => return false }
    var ns = checker::name_qualifier(nm.name)
    match d.body {
        parser::StructBody as sb => cg_union_recur_in_fields(prog, union_t, ns, sb.fields, seen2)
        parser::VariantBody as vb => cg_union_recur_in_members(prog, union_t, ns, vb, seen2)
        _ => false
    }
}

fn cg_union_recur_in_fields(prog: CgProg, union_t: @Type(), ns: str, fields: []parser::Field, seen: []str): bool {
    var i = 0
    loop {
        if i >= fields.len { break }
        var ft = cg_te_to_type_ns(prog, ns, fields[i].type_ann)
        if cg_union_inline_recursive_seen(prog, union_t, ft, seen) { return true }
        i++
    }
    false
}

fn cg_union_recur_in_members(prog: CgProg, union_t: @Type(), ns: str, vb: parser::VariantBody, seen: []str): bool {
    var u = match vb.type_expr { parser::UnionType as ut => ut; _ => return false }
    var i = 0
    loop {
        if i >= u.members.len { break }
        var mt = cg_te_to_type_ns(prog, ns, u.members[i])
        if cg_union_inline_recursive_seen(prog, union_t, mt, seen) { return true }
        i++
    }
    false
}

fn inline_attr_eligible(prog: CgProg, t: @Type()) {
    var v = match t {
        checker::Variant as va => va
        _ => panic("`#inline` applies only to a boxed union (sum) type — this is not a sum")
    }
    match cg_union_niche_member(prog, v) {
        (@Type()) as _gt6 => panic("`#inline` is a no-op here: this union is already niche-optimal (one word, no tag)")
        null => { }
    }
    match cg_union_box_member(prog, v) {
        (@Type()) as bx => {
            if cg_union_inline_recursive(prog, t, bx) {
                panic("`#inline` cannot apply to a self-recursive union — it MUST box (an inline self-recursive sum has no finite size)")
            }
        }
        null => panic("`#inline` is a no-op here: this union's payload is already < 16 bytes (inline)")
    }
}

fn cg_emit_variant_ctype(buf: teko::io::FileStream, v: @Type()) {
    match v {
        checker::Named as nm => mangle_type_name(buf, "", nm.name)
        checker::Variant as va => cg_variant_typename(buf, va)
        _ => panic("codegen: cg_emit_variant_ctype on a non-variant type (internal)")
    }
}

fn cg_union_texpr_mangle_str(prog: CgProg, ut: parser::UnionType, ref_ns: str): str | error {
    if cg_texpr_union_has_null(ut) {
        return error { message = "codegen: a nested union member bearing `null` is not yet mangled on the type-expr path" }
    }
    var out = "u"
    var i = 0
    loop {
        if i >= ut.members.len { break }
        var k = match cg_member_key_texpr_str(prog, ut.members[i], ref_ns) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

fn cg_opt_mangle_texpr_str(prog: CgProg, te: @TypeExpr(), ref_ns: str): str | error {
    match te {
        parser::NamedType as nt => {
            var cn = cg_canon_name_ns(prog, nt.path, ref_ns)
            if cn == "teko::base::str" { return "str" }
            cg_ns_c_key(cn)
        }
        parser::SliceType as st => { var inner_s = match cg_opt_mangle_texpr_str(prog, st.element, ref_ns) { str as s => s; error as e => return e }; teko::str::concat("slice_", inner_s) }
        parser::UnionType as ut => cg_union_texpr_mangle_str(prog, ut, ref_ns)
        _ => error { message = "codegen: optional inner type-expr not yet supported" }
    }
}

fn cg_member_key_texpr_str(prog: CgProg, m: @TypeExpr(), ref_ns: str): str | error {
    var k = match cg_opt_mangle_texpr_str(prog, m, ref_ns) { str as s => s; error as e => return e }
    if cg_is_c_keyword(k) { teko::str::concat(k, "_") } else { k }
}

fn cg_opt_mangle_texpr_bare_str(te: @TypeExpr()): str | error {
    match te {
        parser::NamedType as nt => nt.path.segments[nt.path.segments.len - 1].name
        parser::SliceType as st => { var inner_s = match cg_opt_mangle_texpr_bare_str(st.element) { str as s => s; error as e => return e }; teko::str::concat("slice_", inner_s) }
        parser::UnionType as ut => cg_union_texpr_mangle_bare_str(ut)
        _ => error { message = "codegen: optional inner type-expr not yet supported" }
    }
}

fn cg_union_texpr_mangle_bare_str(ut: parser::UnionType): str | error {
    if cg_texpr_union_has_null(ut) {
        return error { message = "codegen: a nested union member bearing `null` is not yet mangled on the type-expr path" }
    }
    var out = "u"
    var i = 0
    loop {
        if i >= ut.members.len { break }
        var k = match cg_member_key_texpr_bare_str(ut.members[i]) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

fn cg_member_key_texpr_bare_str(m: @TypeExpr()): str | error {
    var k = match cg_opt_mangle_texpr_bare_str(m) { str as s => s; error as e => return e }
    if cg_is_c_keyword(k) { teko::str::concat(k, "_") } else { k }
}

fn cg_texpr_union_has_null(ut: parser::UnionType): bool {
    var i = 0
    loop {
        if i >= ut.members.len { break }
        match ut.members[i] {
            parser::NamedType as nt => {
                if nt.args.len == 0 && nt.path.segments.len == 1 && nt.path.segments[0].name == "null" { return true }
            }
            _ => { }
        }
        i++
    }
    false
}

fn cg_variant_typename_texpr(buf: teko::io::FileStream, prog: CgProg, te: parser::UnionType, ref_ns: str) {
    buf.write(cg_variant_typename_texpr_str(prog, te, ref_ns))
}

fn cg_variant_typename_texpr_str(prog: CgProg, te: parser::UnionType, ref_ns: str): str {
    var out = "tk_u"
    var i = 0
    loop {
        if i >= te.members.len { break }
        var k = match cg_member_key_texpr_str(prog, te.members[i], ref_ns) { str as s => s; error as e => panic(e.message) }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

fn cg_texpr_mangle(te: @TypeExpr()): str {
    match te {
        parser::NamedType as nt => {
            var last = nt.path.segments[nt.path.segments.len - 1].name
            if nt.args.len == 0 { last } else { cg_texpr_inst_name(last, nt.args) }
        }
        parser::SliceType as st => teko::str::concat("slice_", cg_texpr_mangle(st.element))
        parser::SizedArrayType as sa => teko::str::concat("slice_", cg_texpr_mangle(sa.element))
        parser::UnionType as ut => cg_union_texpr_inst_mangle(ut)
        parser::FunctionType => "func"
        parser::MacroType => ""
    }
}

fn cg_union_texpr_inst_mangle(ut: parser::UnionType): str {
    var out = "u"
    if cg_texpr_union_has_null(ut) { out = teko::str::concat(out, "_null") }
    var i = 0
    loop {
        if i >= ut.members.len { break }
        if !cg_texpr_member_is_null(ut.members[i]) {
            out = teko::str::concat(out, teko::str::concat("_", cg_texpr_mangle(ut.members[i])))
        }
        i++
    }
    out
}

fn cg_texpr_member_is_null(m: @TypeExpr()): bool {
    match m {
        parser::NamedType as nt => nt.args.len == 0 && nt.path.segments.len == 1 && nt.path.segments[0].name == "null"
        _ => false
    }
}
fn cg_texpr_inst_name(stem: str, args: []@TypeExpr()): str {
    var out = teko::str::concat(stem, "__g__")
    var i = 0
    loop {
        if i >= args.len { break }
        if i > 0 { out = teko::str::concat(out, "__") }
        out = teko::str::concat(out, cg_texpr_mangle(args[i]))
        i++
    }
    out
}

fn cg_emit_slice_type_expr(buf: teko::io::FileStream, prog: CgProg, st: parser::SliceType, ref_ns: str) {
    match st.element {
        parser::UnionType => match cg_te_to_type_ns(prog, ref_ns, st) {
            checker::Slice as sl => cg_slice_typename(buf, sl.element)
            _ => { buf.write("tk_slice_"); match cg_opt_mangle_texpr_str(prog, st.element, ref_ns) { str as s => buf.write(s); error as e => panic(e.message) } }
        }
        _ => { buf.write("tk_slice_"); match cg_opt_mangle_texpr_str(prog, st.element, ref_ns) { str as s => buf.write(s); error as e => panic(e.message) } }
    }
}

fn cg_named_has_user_decl(prog: CgProg, path: parser::Path, ref_ns: str): bool {
    match cg_find_decl_ns(prog, path, ref_ns) { parser::TypeDecl => true; error => false }
}

fn emit_builtin_ctype(buf: teko::io::FileStream, prog: CgProg, nt: parser::NamedType, last: str, ref_ns: str): bool {
    if last == "u8" { buf.write("uint8_t"); return true }
    else if last == "u16" { buf.write("uint16_t"); return true }
    else if last == "u32" { buf.write("uint32_t"); return true }
    else if last == "u64" { buf.write("uint64_t"); return true }
    else if last == "i8" { buf.write("int8_t"); return true }
    else if last == "i16" { buf.write("int16_t"); return true }
    else if last == "i32" { buf.write("int32_t"); return true }
    else if last == "i64" { buf.write("int64_t"); return true }
    else if last == "f32" { buf.write("float"); return true }
    else if last == "f64" { buf.write("double"); return true }
    else if last == "bool" { buf.write("bool"); return true }
    else if last == "usize" { buf.write("uint64_t"); return true }
    else if last == "isize" { buf.write("int64_t"); return true }
    else if last == "byte" { buf.write("uint8_t"); return true }
    else if last == "char" { buf.write("tk_char"); return true }
    else if last == "str" { buf.write("tk_str"); return true }
    else if last == "error" { buf.write("tk_error"); return true }
    else if last == "ptr" {
        if nt.args.len > 0 { emit_type_expr(buf, prog, nt.args[0], ref_ns); buf.write(" *") }
        else { buf.write("void *") }
        return true
    }
    else if last == "uptr" { buf.write("uintptr_t"); return true }
    else if last == "Ref" {
        if nt.args.len > 0 { emit_type_expr(buf, prog, nt.args[0], ref_ns); buf.write(" *"); return true }
        panic("`Ref<T>` needs a type argument")
    }
    false
}

fn emit_generic_inst_ctype(buf: teko::io::FileStream, prog: CgProg, iname: str) {
    if cg_is_polymorphic_base(prog, iname) { buf.write("tk_base_"); cb_tysym(buf, iname); return }
    match cg_find_decl(prog, iname) {
        parser::TypeDecl as cd => match cd.body {
            parser::ClassBody => { mangle_type_name(buf, "", iname); buf.write(" *"); return }
            _ => { }
        }
        error => { }
    }
    mangle_type_name(buf, "", iname)
}

fn emit_type_expr(buf: teko::io::FileStream, prog: CgProg, te: @TypeExpr(), ref_ns: str) {
    match te {
        parser::NamedType as nt => {
            var last = nt.path.segments[nt.path.segments.len - 1].name
            if emit_builtin_ctype(buf, prog, nt, last, ref_ns) { return }
            var cdname = match cg_find_decl_ns(prog, nt.path, ref_ns) { parser::TypeDecl as d => d.name; error => last }
            match cg_find_decl_ns(prog, nt.path, ref_ns) {
                parser::TypeDecl as ad => match ad.body {
                    parser::AliasBody as alb => return emit_type_expr(buf, prog, alb.alias, ref_ns)
                    _ => { }
                }
                error => { }
            }
            if nt.args.len > 0 { emit_generic_inst_ctype(buf, prog, cg_texpr_inst_name(last, nt.args)); return }
            if cg_is_polymorphic_base(prog, cdname) { buf.write("tk_base_"); cb_tysym(buf, cdname); return }
            match cg_find_decl_ns(prog, nt.path, ref_ns) {
                parser::TypeDecl as cd => match cd.body {
                    parser::ClassBody => { mangle_type_name(buf, "", cdname); buf.write(" *"); return }
                    parser::ExternStructBody as esb => if esb.c_tag.len > 0 { buf.write("struct "); buf.write(esb.c_tag); return }
                    _ => { }
                }
                error => { }
            }
            mangle_type_name(buf, "", cdname)
        }
        parser::SliceType as st => cg_emit_slice_type_expr(buf, prog, st, ref_ns)
        parser::SizedArrayType as sa => cg_emit_slice_type_expr(buf, prog, parser::SliceType { element = sa.element }, ref_ns)
        parser::UnionType as ut => {
            if !cg_texpr_union_has_null(ut) { return cg_variant_typename_texpr(buf, prog, ut, ref_ns) }
            match cg_te_to_type_ns(prog, ref_ns, te) {
                checker::Variant as va => match cg_union_niche_member(prog, va) {
                    (@Type()) as x => emit_type(buf, prog, x)
                    null => match cg_union_box_member(prog, va) {
                        (@Type()) as bx => { emit_type(buf, prog, bx); buf.write(" *") }
                        null => cg_variant_typename(buf, va)
                    }
                }
                _ => cg_variant_typename_texpr(buf, prog, ut, ref_ns)
            }
        }
        parser::FunctionType => buf.write("tk_closure")
        parser::MacroType => panic("internal: an unexpanded @Type() macro reached codegen — it should be expanded by the Family-A pre-pass")
    }
}

fn binop_c(op: lexer::TokenKind): str | error {
    match op {
        lexer::TokenKind::Plus => "+"
        lexer::TokenKind::Minus => "-"
        lexer::TokenKind::Star => "*"
        lexer::TokenKind::Slash => "/"
        lexer::TokenKind::Percent => "%"
        lexer::TokenKind::Amp => "&"
        lexer::TokenKind::Pipe => "|"
        lexer::TokenKind::Caret => "^"
        lexer::TokenKind::Shl => "<<"
        lexer::TokenKind::Shr => ">>"
        lexer::TokenKind::AndAnd => "&&"
        lexer::TokenKind::OrOr => "||"
        _ => error { message = "codegen: binary operator not yet supported" }
    }
}

fn unop_c(op: lexer::TokenKind): str | error {
    match op {
        lexer::TokenKind::Minus => "-"
        lexer::TokenKind::Tilde => "~"
        lexer::TokenKind::Bang => "!"
        _ => error { message = "codegen: unary operator not yet supported" }
    }
}

fn cmpop_c(op: lexer::TokenKind): str | error {
    match op {
        lexer::TokenKind::EqEq => "=="
        lexer::TokenKind::Ne => "!="
        lexer::TokenKind::Lt => "<"
        lexer::TokenKind::Le => "<="
        lexer::TokenKind::Gt => ">"
        lexer::TokenKind::Ge => ">="
        _ => error { message = "codegen: comparison operator not yet supported" }
    }
}

fn assignop_c(op: lexer::TokenKind): str | error {
    match op {
        lexer::TokenKind::Assign => "="
        lexer::TokenKind::PlusEq => "+="
        lexer::TokenKind::MinusEq => "-="
        lexer::TokenKind::StarEq => "*="
        lexer::TokenKind::SlashEq => "/="
        lexer::TokenKind::PercentEq => "%="
        lexer::TokenKind::AmpEq => "&="
        lexer::TokenKind::PipeEq => "|="
        lexer::TokenKind::CaretEq => "^="
        lexer::TokenKind::ShlEq => "<<="
        lexer::TokenKind::ShrEq => ">>="
        _ => error { message = "codegen: assignment operator not yet supported" }
    }
}

fn cg_prim_is_float(k: checker::PrimKind): bool { checker::prim_is_float(k) }

fn cg_prim_is_int(k: checker::PrimKind): bool { checker::prim_is_int(k) }

fn cg_assert_symbol(callee: parser::Path): str {
    var segs = callee.segments
    if segs.len < 2 { return "" }
    if segs[0].name != "teko" { return "" }
    if segs[segs.len - 2].name != "assert" { return "" }
    if checker::assert_builtin_name(segs[segs.len - 1].name) {
        return cb_fn_name_str("teko::assert", segs[segs.len - 1].name)
    }
    ""
}

fn cg_prim_is_signed_int(k: checker::PrimKind): bool { checker::prim_is_signed(k) }

fn cg_int_width(k: checker::PrimKind): i64 {
    match k {
        checker::PrimKind::U8 => 8
        checker::PrimKind::I8 => 8
        checker::PrimKind::U16 => 16
        checker::PrimKind::I16 => 16
        checker::PrimKind::U32 => 32
        checker::PrimKind::I32 => 32
        checker::PrimKind::U64 => 64
        checker::PrimKind::I64 => 64
        checker::PrimKind::Usize => 64
        checker::PrimKind::Isize => 64
        _ => 0
    }
}

fn prim_div_tag(k: checker::PrimKind): str | error {
    match k {
        checker::PrimKind::U8 => "u8"
        checker::PrimKind::U16 => "u16"
        checker::PrimKind::U32 => "u32"
        checker::PrimKind::U64 => "u64"
        checker::PrimKind::I8 => "i8"
        checker::PrimKind::I16 => "i16"
        checker::PrimKind::I32 => "i32"
        checker::PrimKind::I64 => "i64"
        checker::PrimKind::F32 => "f32"
        checker::PrimKind::F64 => "f64"
        checker::PrimKind::Bool => error { message = "codegen: bool has no div/cast helper tag" }
        checker::PrimKind::Usize => "u64"
        checker::PrimKind::Isize => "i64"
    }
}

fn prim_int_tag(k: checker::PrimKind): str | error {
    if cg_prim_is_int(k) { return prim_div_tag(k) }
    error { message = "codegen: cast to a non-integer type not yet supported" }
}

pub fn cast_may_lose(src: checker::PrimKind, dst: checker::PrimKind): bool {
    !checker::cast_is_lossless_widen(src, dst)
}

fn emit_div_mod(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, b: checker::TBinary, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var prim = match e.type {
        checker::Prim as p => p
        _ => panic("codegen: division/modulo on a non-primitive type not yet supported")
    }
    if b.op == lexer::TokenKind::Percent && cg_prim_is_float(prim.kind) {
        panic("codegen: modulo on a float type is not allowed")
    }
    var tag = match prim_div_tag(prim.kind) {
        str as t => t
        error => panic("codegen: division/modulo on a non-numeric type not yet supported")
    }
    if b.op == lexer::TokenKind::Slash { buf.write("tk_div_") } else { buf.write("tk_mod_") }
    buf.write(tag)
    buf.write("(")
    emit_expr_ctx(buf, prog, checker::Void { }, b.left, escaping, regions, fn_body, dctx)
    buf.write(", ")
    emit_expr_ctx(buf, prog, checker::Void { }, b.right, escaping, regions, fn_body, dctx)
    buf.write(")")
}

fn emit_div_mod_assign(buf: teko::io::FileStream, prog: CgProg, a: checker::TAssign, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var prim = match a.bound {
        checker::Prim as p => p
        _ => panic("codegen: division/modulo-assign on a non-primitive type not yet supported")
    }
    if a.op == lexer::TokenKind::PercentEq && cg_prim_is_float(prim.kind) {
        panic("codegen: modulo-assign on a float type is not allowed")
    }
    var tag = match prim_div_tag(prim.kind) {
        str as t => t
        error => panic("codegen: division/modulo-assign on a non-numeric type not yet supported")
    }
    var fn_prefix = if a.op == lexer::TokenKind::SlashEq { "tk_div_" } else { "tk_mod_" }
    emit_assign_lvalue(buf, prog, a)
    buf.write(" = ")
    buf.write(fn_prefix)
    buf.write(tag)
    buf.write("(")
    emit_assign_lvalue(buf, prog, a)
    buf.write(", ")
    emit_expr_ctx(buf, prog, checker::Void { }, a.value, escaping, regions, fn_body, dctx)
    buf.write(")")
    buf.write(";\n")
}

fn emit_arith(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, b: checker::TBinary, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var prim = match e.type {
        checker::Prim as p => p
        _ => panic("codegen: arithmetic on a non-primitive type not yet supported")
    }
    if !cg_prim_is_int(prim.kind) {
        panic("codegen: emit_arith called on non-integer type")
    }
    var tag = match prim_int_tag(prim.kind) {
        str as t => t
        error => panic("codegen: arithmetic on a non-integer primitive")
    }
    var fn_prefix = if b.op == lexer::TokenKind::Plus { "tk_add_" }
    else if b.op == lexer::TokenKind::Minus { "tk_sub_" }
    else { "tk_mul_" }
    buf.write(fn_prefix)
    buf.write(tag)
    buf.write("(")
    emit_expr_ctx(buf, prog, checker::Void { }, b.left, escaping, regions, fn_body, dctx)
    buf.write(", ")
    emit_expr_ctx(buf, prog, checker::Void { }, b.right, escaping, regions, fn_body, dctx)
    buf.write(")")
}

fn emit_shift(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, b: checker::TBinary, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var prim = match e.type {
        checker::Prim as p => p
        _ => panic("codegen: shift on a non-integer type not yet supported")
    }
    if !cg_prim_is_int(prim.kind) {
        panic("codegen: shift on a non-integer type not yet supported")
    }
    var tag = match prim_int_tag(prim.kind) {
        str as t => t
        error => panic("codegen: shift on a non-integer type not yet supported")
    }
    var fn_prefix = if b.op == lexer::TokenKind::Shl { "tk_shl_" } else { "tk_shr_" }
    buf.write(fn_prefix)
    buf.write(tag)
    buf.write("(")
    emit_expr_ctx(buf, prog, checker::Void { }, b.left, escaping, regions, fn_body, dctx)
    buf.write(", ")
    emit_expr_ctx(buf, prog, checker::Void { }, b.right, escaping, regions, fn_body, dctx)
    buf.write(")")
}

fn emit_binary(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, b: checker::TBinary, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if b.op == lexer::TokenKind::Slash || b.op == lexer::TokenKind::Percent {
        return emit_div_mod(buf, prog, e, b, escaping, regions, fn_body, dctx)
    }
    if b.op == lexer::TokenKind::Plus || b.op == lexer::TokenKind::Minus || b.op == lexer::TokenKind::Star {
        var is_int_prim = match e.type {
            checker::Prim as p => cg_prim_is_int(p.kind)
            _ => false
        }
        if is_int_prim { return emit_arith(buf, prog, e, b, escaping, regions, fn_body, dctx) }
    }
    if b.op == lexer::TokenKind::Shl || b.op == lexer::TokenKind::Shr {
        return emit_shift(buf, prog, e, b, escaping, regions, fn_body, dctx)
    }
    var op = match binop_c(b.op) { str as s => s; error as err => panic(err.message) }
    buf.write("(")
    emit_expr_ctx(buf, prog, checker::Void { }, b.left, escaping, regions, fn_body, dctx)
    buf.write(" ")
    buf.write(op)
    buf.write(" ")
    emit_expr_ctx(buf, prog, checker::Void { }, b.right, escaping, regions, fn_body, dctx)
    buf.write(")")
}

fn emit_unary(buf: teko::io::FileStream, prog: CgProg, u: checker::TUnary, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var op = match unop_c(u.op) { str as s => s; error as err => panic(err.message) }
    var mask_type = cg_bnot_mask_type(u)
    buf.write("(")
    match mask_type {
        checker::Prim as p => { buf.write("("); emit_type(buf, prog, checker::Prim { kind = p.kind }); buf.write(")(") }
        _ => { }
    }
    buf.write(op)
    emit_expr_ctx(buf, prog, checker::Void { }, u.operand, escaping, regions, fn_body, dctx)
    match mask_type { checker::Prim => { buf.write(")") }; _ => { } }
    buf.write(")")
}

fn cg_bnot_mask_type(u: checker::TUnary): @Type() {
    if u.op != lexer::TokenKind::Tilde { return checker::Void { } }
    match u.operand.type {
        checker::Prim as p => if cg_prim_is_subint(p.kind) { checker::Prim { kind = p.kind } } else { checker::Void { } }
        _ => checker::Void { }
    }
}

fn cg_prim_is_subint(k: checker::PrimKind): bool {
    k == checker::PrimKind::U8 || k == checker::PrimKind::U16 || k == checker::PrimKind::I8 || k == checker::PrimKind::I16
}

pub type CgCmpRoute = enum { Plain; StrEq; CharEq; SliceEq }

fn cg_cmp_route_of(t: @Type()): CgCmpRoute {
    if cg_is_str_type(t) { return CgCmpRoute::StrEq }
    match t {
        checker::Char => CgCmpRoute::CharEq
        checker::Slice => CgCmpRoute::SliceEq
        _ => CgCmpRoute::Plain
    }
}

type CgVariantMemberCmp = struct {
    subj_expr: checker::TExpr
    variant_type: checker::Variant
    member: checker::TExpr
}

fn cg_tagged_variant_side(prog: CgProg, e: checker::TExpr): checker::Variant | null {
    match e.type {
        checker::Variant as v => {
            match cg_union_niche_member(prog, v) { (@Type()) as _gt7 => return null; null => { } }
            match cg_union_box_member(prog, v) { (@Type()) as _gt8 => return null; null => { } }
            v
        }
        _ => null
    }
}

fn cg_variant_member_cmp(prog: CgProg, prev: checker::TExpr, opnd: checker::TExpr): CgVariantMemberCmp | null {
    var opnd_is_variant = match opnd.type { checker::Variant => true; _ => false }
    var prev_is_variant = match prev.type { checker::Variant => true; _ => false }
    if opnd_is_variant && prev_is_variant { return null }
    if !opnd_is_variant {
        match cg_tagged_variant_side(prog, prev) {
            checker::Variant as v => return CgVariantMemberCmp { subj_expr = prev; variant_type = v; member = opnd }
            null => { }
        }
    }
    if !prev_is_variant {
        match cg_tagged_variant_side(prog, opnd) {
            checker::Variant as v => return CgVariantMemberCmp { subj_expr = opnd; variant_type = v; member = prev }
            null => { }
        }
    }
    null
}

fn cg_variant_member_payload_comparable(t: @Type()): bool {
    match t {
        checker::Prim as p => p.kind != checker::PrimKind::Bool
        checker::Byte => true
        _ => false
    }
}

fn emit_content_eq(buf: teko::io::FileStream, prog: CgProg, route: CgCmpRoute, op: lexer::TokenKind, lhs: checker::TExpr, rhs: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    match route {
        CgCmpRoute::StrEq => emit_runtime_eq_call(buf, prog, cb_fn_name_str("teko::runtime", "str_eq"), op, lhs, rhs, escaping, regions, fn_body, dctx)
        CgCmpRoute::CharEq => emit_runtime_eq_call(buf, prog, cb_fn_name_str("teko::runtime", "char_eq"), op, lhs, rhs, escaping, regions, fn_body, dctx)
        CgCmpRoute::SliceEq => emit_slice_eq(buf, prog, op, lhs, rhs, escaping, regions, fn_body, dctx)
        CgCmpRoute::Plain => panic("codegen: emit_content_eq called with the Plain route (internal)")
    }
}

fn emit_runtime_eq_call(buf: teko::io::FileStream, prog: CgProg, rtfn: str, op: lexer::TokenKind, lhs: checker::TExpr, rhs: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write("(")
    if op == lexer::TokenKind::Ne { buf.write("!") }
    buf.write(rtfn)
    buf.write("(")
    emit_expr_ctx(buf, prog, checker::Void { }, lhs, escaping, regions, fn_body, dctx)
    buf.write(", ")
    emit_expr_ctx(buf, prog, checker::Void { }, rhs, escaping, regions, fn_body, dctx)
    buf.write("))")
}

pub type CgSliceEqPlan = struct {
    rtfn: str
    needs_size: bool
    as_word: bool
}

fn cg_slice_eq_plan(elem: @Type()): CgSliceEqPlan | error {
    if cg_is_str_type(elem) { return CgSliceEqPlan { rtfn = "tk_slice_str_eq"; needs_size = false; as_word = false } }
    match elem {
        checker::Char => CgSliceEqPlan { rtfn = "tk_slice_char_eq"; needs_size = false; as_word = false }
        checker::Byte => CgSliceEqPlan { rtfn = cb_fn_name_str("teko::runtime", "slice_eq_bytes"); needs_size = true; as_word = true }
        checker::Prim as p => cg_slice_eq_plan_prim(p.kind)
        _ => error { message = teko::str::concat("codegen: `[]T == []T` is not lowered yet for element type `", checker::type_render(elem), "` (only numeric/bool/byte/char/str elements compare by value)") }
    }
}

fn cg_slice_eq_plan_prim(k: checker::PrimKind): CgSliceEqPlan {
    if k == checker::PrimKind::F32 { return CgSliceEqPlan { rtfn = "tk_slice_f32_eq"; needs_size = false; as_word = false } }
    if k == checker::PrimKind::F64 { return CgSliceEqPlan { rtfn = cb_fn_name_str("teko::runtime", "slice_f64_eq"); needs_size = false; as_word = true } }
    CgSliceEqPlan { rtfn = cb_fn_name_str("teko::runtime", "slice_eq_bytes"); needs_size = true; as_word = true }
}

fn cg_slice_elem_of(t: @Type()): @Type() {
    match t { checker::Slice as sl => sl.element; _ => checker::Void { } }
}

fn emit_slice_eq(buf: teko::io::FileStream, prog: CgProg, op: lexer::TokenKind, lhs: checker::TExpr, rhs: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var elem = cg_slice_elem_of(lhs.type)
    var plan = match cg_slice_eq_plan(elem) { CgSliceEqPlan as p => p; error as err => panic(err.message) }
    var t = $"_teq{buf.gensym()}"
    buf.write("(")
    if op == lexer::TokenKind::Ne { buf.write("!") }
    buf.write("({ ")
    emit_type(buf, prog, lhs.type)
    buf.write(" ")
    buf.write(t)
    buf.write("a = ")
    emit_expr_ctx(buf, prog, checker::Void { }, lhs, escaping, regions, fn_body, dctx)
    buf.write("; ")
    emit_type(buf, prog, rhs.type)
    buf.write(" ")
    buf.write(t)
    buf.write("b = ")
    emit_expr_ctx(buf, prog, checker::Void { }, rhs, escaping, regions, fn_body, dctx)
    buf.write("; ")
    buf.write(plan.rtfn)
    buf.write("(")
    emit_slice_eq_ptr_arg(buf, t, "a", plan.as_word)
    buf.write(", ")
    buf.write(t)
    buf.write("a.len, ")
    emit_slice_eq_ptr_arg(buf, t, "b", plan.as_word)
    buf.write(", ")
    buf.write(t)
    buf.write("b.len")
    if plan.needs_size {
        buf.write(", sizeof(")
        emit_type(buf, prog, elem)
        buf.write(")")
    }
    buf.write("); })")
    buf.write(")")
}

fn emit_slice_eq_ptr_arg(buf: teko::io::FileStream, t: str, side: str, as_word: bool) {
    if as_word { buf.write("(uint64_t)(uintptr_t)(") }
    buf.write(t)
    buf.write(side)
    buf.write(".ptr")
    if as_word { buf.write(")") }
}

fn cg_emit_variant_member_cmp(buf: teko::io::FileStream, prog: CgProg, cmp: CgVariantMemberCmp, eq: bool, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var is_null_member = match cmp.member.type { checker::Null => true; _ => false }
    if !is_null_member && !cg_variant_member_payload_comparable(cmp.member.type) {
        panic("codegen: comparing a tagged union to a non-null, non-numeric member is not yet supported")
    }
    var tmp = fresh_named("_vm", buf.gensym() to i64)
    buf.write("({ ")
    emit_type(buf, prog, cmp.subj_expr.type)
    buf.write(" ")
    buf.write(tmp)
    buf.write(" = (")
    emit_expr_ctx(buf, prog, checker::Void { }, cmp.subj_expr, escaping, regions, fn_body, dctx)
    buf.write("); (")
    buf.write(tmp)
    buf.write(".tag ")
    buf.write(if eq { "== " } else { "!= " })
    cg_emit_tag_prefix(buf, checker::Variant { members = cmp.variant_type.members })
    var mk = match cg_member_key_str(cmp.member.type) { str as s => s; error as err => panic(err.message) }
    cb_upper(buf, mk)
    if is_null_member { buf.write("); })"); return }
    buf.write(if eq { " && " } else { " || " })
    cg_emit_union_member_access(buf, prog, tmp, checker::Variant { members = cmp.variant_type.members }, mk)
    buf.write(if eq { " == (" } else { " != (" })
    emit_expr_ctx(buf, prog, checker::Void { }, cmp.member, escaping, regions, fn_body, dctx)
    buf.write(")); })")
}

fn emit_compare(buf: teko::io::FileStream, prog: CgProg, c: checker::TCompare, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if c.rest.len == 0 { return emit_expr_ctx(buf, prog, checker::Void { }, c.first, escaping, regions, fn_body, dctx) }
    buf.write("(")
    var prev = c.first
    var i = 0
    loop {
        if i >= c.rest.len { break }
        var term = c.rest[i]
        var op = match cmpop_c(term.op) { str as s => s; error as err => panic(err.message) }
        if i > 0 { buf.write(" && ") }
        emit_compare_term(buf, prog, prev, term, op, escaping, regions, fn_body, dctx)
        prev = term.operand
        i++
    }
    buf.write(")")
}

fn emit_compare_term(buf: teko::io::FileStream, prog: CgProg, prev: checker::TExpr, term: checker::TCmpTerm, op: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var is_eq = term.op == lexer::TokenKind::EqEq || term.op == lexer::TokenKind::Ne
    var vm_cmp = if is_eq { cg_variant_member_cmp(prog, prev, term.operand) } else { null }
    match vm_cmp {
        CgVariantMemberCmp as cmp => return cg_emit_variant_member_cmp(buf, prog, cmp, term.op == lexer::TokenKind::EqEq, escaping, regions, fn_body, dctx)
        null => { }
    }
    var prev_route = cg_cmp_route_of(prev.type)
    var opnd_route = cg_cmp_route_of(term.operand.type)
    var route = if prev_route != CgCmpRoute::Plain { prev_route } else { opnd_route }
    if route != CgCmpRoute::Plain && is_eq {
        return emit_content_eq(buf, prog, route, term.op, prev, term.operand, escaping, regions, fn_body, dctx)
    }
    buf.write("(")
    emit_expr_ctx(buf, prog, checker::Void { }, prev, escaping, regions, fn_body, dctx)
    buf.write(" ")
    buf.write(op)
    buf.write(" ")
    emit_expr_ctx(buf, prog, checker::Void { }, term.operand, escaping, regions, fn_body, dctx)
    buf.write(")")
}

fn cg_cast_target_is_variant(prog: CgProg, t: @Type()): bool {
    match t {
        checker::Variant => true
        checker::Named as nm => cg_named_is_variant(prog, nm.name)
        _ => false
    }
}

fn cg_is_str_type(t: @Type()): bool {
    match t {
        checker::Named as nm => nm.name == "teko::base::str"
        _ => false
    }
}

fn cg_is_byte_slice_type(t: @Type()): bool {
    match t { checker::Slice as sl => match sl.element { checker::Byte => true; _ => false }; _ => false }
}

fn cg_fat_view_ctor(t: @Type()): str {
    match t {
        checker::Char => "(tk_char){ (uint8_t *)_tkbsr.ptr, _tkbsr.len }"
        checker::Slice => "(tk_slice_byte){ (tk_byte *)_tkbsr.ptr, _tkbsr.len }"
        _ => "(tk_str){ (const tk_byte *)_tkbsr.ptr, _tkbsr.len }"
    }
}

fn emit_bytes_str_reinterpret(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, inner: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write("({ ")
    emit_type(buf, prog, inner.type)
    buf.write(" _tkbsr = (")
    emit_expr_ctx(buf, prog, checker::Void { }, inner, escaping, regions, fn_body, dctx)
    buf.write("); ")
    buf.write(cg_fat_view_ctor(e.type))
    buf.write("; })")
}

fn cg_is_char_type(t: @Type()): bool { match t { checker::Char => true; _ => false } }

fn cg_is_bytes_str_reinterpret(dst: @Type(), src: @Type()): bool {
    (cg_is_str_type(src) && cg_is_byte_slice_type(dst)) || (cg_is_byte_slice_type(src) && cg_is_str_type(dst)) ||
    (cg_is_str_type(src) && cg_is_char_type(dst)) || (cg_is_char_type(src) && cg_is_str_type(dst))
}

fn emit_cast_checked(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, inner: checker::TExpr, tmp_ctype: str, check_suffix: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var tmp = $"_cv{buf.gensym()}"
    buf.write("({ ")
    buf.write(tmp_ctype)
    buf.write(" ")
    buf.write(tmp)
    buf.write(" = (")
    emit_expr_ctx(buf, prog, checker::Void { }, inner, escaping, regions, fn_body, dctx)
    buf.write("); teko_teko__runtime__cast_check_")
    buf.write(check_suffix)
    buf.write("(")
    buf.write(tmp)
    buf.write(", ")
    cb_u64_digits(buf, e.line to u64)
    buf.write(", ")
    cb_u64_digits(buf, e.col to u64)
    buf.write("); (")
    emit_type(buf, prog, e.type)
    buf.write(")")
    buf.write(tmp)
    buf.write("; })")
}

fn emit_cast(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, c: checker::TCast, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var inner = c.expr
    if cg_is_bytes_str_reinterpret(e.type, inner.type) { return emit_bytes_str_reinterpret(buf, prog, e, inner, escaping, regions, fn_body, dctx) }
    if cg_cast_target_is_variant(prog, e.type) { return emit_as(buf, prog, e.type, inner, escaping, regions, fn_body, dctx) }
    var dst_opt = match e.type { checker::Prim as p => p.kind; _ => checker::PrimKind::Bool }
    var src_opt = match inner.type { checker::Prim as p => p.kind; _ => checker::PrimKind::Bool }
    var prim_both = match e.type {
        checker::Prim => match inner.type { checker::Prim => true; _ => false }
        _ => false
    }
    var dst = dst_opt
    var src = src_opt

    match inner.type {
        checker::Char => {
            buf.write("((")
            emit_type(buf, prog, e.type)
            buf.write(")tk_char_to_u32(")
            emit_expr_ctx(buf, prog, checker::Void { }, inner, escaping, regions, fn_body, dctx)
            buf.write("))")
            return
        }
        _ => { }
    }

    if prim_both && cg_prim_is_float(src) && cg_prim_is_int(dst) {
        var dtag = match prim_int_tag(dst) { str as t => t; error as err => panic(err.message) }
        emit_cast_checked(buf, prog, e, inner, "double", teko::str::concat(dtag, "_from_f64"), escaping, regions, fn_body, dctx)
        return
    }
    if prim_both && cg_prim_is_int(src) && cg_prim_is_int(dst) && cast_may_lose(src, dst) {
        var dtag = match prim_int_tag(dst) { str as t => t; error as err => panic(err.message) }
        var signed_src = cg_prim_is_signed_int(src)
        var tmp_ctype = if signed_src { "int64_t" } else { "uint64_t" }
        var suffix = if signed_src { teko::str::concat(dtag, "_s") } else { teko::str::concat(dtag, "_u") }
        emit_cast_checked(buf, prog, e, inner, tmp_ctype, suffix, escaping, regions, fn_body, dctx)
        return
    }
    buf.write("((")
    emit_type(buf, prog, e.type)
    buf.write(")(")
    emit_expr_ctx(buf, prog, checker::Void { }, inner, escaping, regions, fn_body, dctx)
    buf.write("))")
}

fn cg_is_mem_value_call(p: parser::Path, user_declared: bool): bool {
    if user_declared { return false }
    if p.segments.len < 2 { return false }
    var last = p.segments[p.segments.len - 1].name
    var prev = p.segments[p.segments.len - 2].name
    if prev != "mem" { return false }
    var rooted = p.segments.len == 2 || p.segments[0].name == "teko"
    rooted && (last == "place" || last == "read" || last == "write")
}

fn emit_sizeof_intrinsic(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall) {
    if c.type_args.len != 1 { panic("codegen: sizeof expects one type argument (internal)") }
    buf.write("((uint64_t)sizeof(")
    emit_type(buf, prog, c.type_args[0])
    buf.write("))")
}

fn emit_alignof_intrinsic(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall) {
    if c.type_args.len != 1 { panic("codegen: alignof expects one type argument (internal)") }
    buf.write("((uint64_t)_Alignof(")
    emit_type(buf, prog, c.type_args[0])
    buf.write("))")
}

fn emit_place(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if c.args.len != 2 { panic("codegen: place expects two arguments (internal)") }
    var inner = match e.type {
        checker::Ptr as pt => match pt.inner { (@Type()) as t => t; null => panic("codegen: place result is not a typed pointer (internal)") }
        _ => panic("codegen: place result is not a pointer (internal)")
    }
    var v = fresh_named("_pl", buf.gensym() to i64)
    buf.write("({ ")
    emit_type(buf, prog, inner)
    buf.write(" *"); buf.write(v); buf.write(" = (")
    emit_type(buf, prog, inner)
    buf.write(" *)"); cb_arena_sym(buf, CgArenaSym::RegionAlloc); buf.write("((tk_region *)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write("), (size_t)sizeof(")
    emit_type(buf, prog, inner)
    buf.write(")); *"); buf.write(v); buf.write(" = (")
    emit_expr_ctx(buf, prog, inner, c.args[1], escaping, regions, fn_body, dctx)
    buf.write("); "); buf.write(v); buf.write("; })")
}

fn emit_read(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if c.args.len != 1 { panic("codegen: read expects one argument (internal)") }
    buf.write("(*(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write("))")
}

fn emit_write(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if c.args.len != 2 { panic("codegen: write expects two arguments (internal)") }
    buf.write("(*(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write(") = (")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx)
    buf.write("))")
}

fn emit_buf_ptr(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write("(uint8_t *)"); cb_arena_sym(buf, CgArenaSym::RegionAlloc); buf.write("(")
    buf.write(cg_alloc_region(regions, dctx))
    buf.write(", (size_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write("))")
}

fn emit_byte_ptr(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if c.args.len != 2 { panic("codegen: byte_ptr expects a `[]byte` and an index (internal)") }
    buf.write("((void *)((")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write(").ptr + (size_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx)
    buf.write(")))")
}

fn emit_retain(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    cb_fn_name(buf, "teko::runtime", "wrap_retain")
    buf.write("(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write(")")
}

fn emit_release(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    cb_fn_name(buf, "teko::runtime", "wrap_release")
    buf.write("(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write(")")
}

fn weak_get_non_null_member(members: []@Type()): @Type() | error {
    var i = 0
    loop {
        if i >= members.len { break }
        match members[i] { checker::Null => { }; _ => return members[i] }
        i++
    }
    error { message = "codegen: weak_get result variant has no non-null member (internal)" }
}

fn weak_get_target_type(expected: @Type()): @Type() | error {
    match expected {
        checker::Variant as v => weak_get_non_null_member(v.members)
        _ => error { message = "codegen: weak_get result is not a nullable variant (internal)" }
    }
}

fn emit_weak_get(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if c.args.len != 1 { panic("codegen: weak_get expects one argument (internal)") }
    var ttype = match weak_get_target_type(e.type) { (@Type()) as t => t; error as err => panic(err.message) }
    var v = fresh_named("_wg", buf.gensym() to i64)
    buf.write("({ void *")
    buf.write(v)
    buf.write(" = (void *)")
    cb_fn_name(buf, "teko::runtime", "wrap_weak_get")
    buf.write("((void *)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write(")); ")
    buf.write(v)
    buf.write(" == 0 ? ")
    emit_variant_wrap_str(buf, prog, e.type, checker::Null { }, "0", cg_frame_region(dctx))
    buf.write(" : ")
    var tc = emit_type_str(prog, ttype)
    var tarm = $"*({tc} *){v}"
    emit_variant_wrap_str(buf, prog, e.type, ttype, tarm, cg_frame_region(dctx))
    buf.write("; })")
}

type DcFieldPlan = struct { is_class: bool; nullable: bool; class_name: str }

type DcScan = struct { classes: []str }

fn dc_scan_add(s: DcScan, name: str): DcScan {
    if cg_str_in(s.classes, name) { return s }
    DcScan { classes = [..s.classes, name] }
}

fn cg_dc_is_call(cl: checker::TCall): bool {
    if cl.call_ns != "" { return false }
    if cl.args.len != 1 { return false }
    if cl.callee.segments.len == 0 { return false }
    cl.callee.segments[cl.callee.segments.len - 1].name == "deep_copy"
}

fn cg_dc_scan_expr(s: DcScan, e: checker::TExpr): DcScan | error {
    var s2 = s
    match e.kind {
        checker::TNumber => { }
        checker::TVar => { }
        checker::TStrLit => { }
        checker::TByteStrLit => { }
        checker::TByteLit => { }
        checker::TCharLit => { }
        checker::TBoolLit => { }
        checker::TNullLit => { }
        checker::TPathExpr => { }
        checker::TBinary as b => {
            s2 = match cg_dc_scan_expr(s2, b.left) { DcScan as x => x; error as err => return err }
            s2 = match cg_dc_scan_expr(s2, b.right) { DcScan as x => x; error as err => return err }
        }
        checker::TUnary as u => { s2 = match cg_dc_scan_expr(s2, u.operand) { DcScan as x => x; error as err => return err } }
        checker::TCompare as cm => {
            s2 = match cg_dc_scan_expr(s2, cm.first) { DcScan as x => x; error as err => return err }
            var i = 0
            loop { if i >= cm.rest.len { break }; s2 = match cg_dc_scan_expr(s2, cm.rest[i].operand) { DcScan as x => x; error as err => return err }; i++ }
        }
        checker::TCall as cl => {
            var i = 0
            loop { if i >= cl.args.len { break }; s2 = match cg_dc_scan_expr(s2, cl.args[i]) { DcScan as x => x; error as err => return err }; i++ }
            if cg_dc_is_call(cl) {
                match cl.args[0].type { checker::Named as n => s2 = dc_scan_add(s2, n.name); _ => { } }
            }
        }
        checker::TIfExpr as f => {
            s2 = match cg_dc_scan_expr(s2, f.cond) { DcScan as x => x; error as err => return err }
            s2 = match cg_dc_scan_block(s2, f.then_blk) { DcScan as x => x; error as err => return err }
            s2 = match cg_dc_scan_block(s2, f.else_blk) { DcScan as x => x; error as err => return err }
        }
        checker::TMatchExpr as m => {
            s2 = match cg_dc_scan_expr(s2, m.subject) { DcScan as x => x; error as err => return err }
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { s2 = match cg_dc_scan_expr(s2, m.arms[i].guard) { DcScan as x => x; error as err => return err } }
                s2 = match cg_dc_scan_block(s2, m.arms[i].body) { DcScan as x => x; error as err => return err }
                i++
            }
        }
        checker::TCast as ct => { s2 = match cg_dc_scan_expr(s2, ct.expr) { DcScan as x => x; error as err => return err } }
        checker::TFieldAccess as fa => { s2 = match cg_dc_scan_expr(s2, fa.receiver) { DcScan as x => x; error as err => return err } }
        checker::TStructInit as si => { var i = 0; loop { if i >= si.field_vals.len { break }; s2 = match cg_dc_scan_expr(s2, si.field_vals[i]) { DcScan as x => x; error as err => return err }; i++ } }
        checker::TIndex as ix => {
            s2 = match cg_dc_scan_expr(s2, ix.receiver) { DcScan as x => x; error as err => return err }
            s2 = match cg_dc_scan_expr(s2, ix.index) { DcScan as x => x; error as err => return err }
        }
        checker::TInterp as it => { var i = 0; loop { if i >= it.holes.len { break }; s2 = match cg_dc_scan_expr(s2, it.holes[i]) { DcScan as x => x; error as err => return err }; i++ } }
        checker::TInExpr as ie => {
            s2 = match cg_dc_scan_expr(s2, ie.lhs) { DcScan as x => x; error as err => return err }
            var i = 0
            loop { if i >= ie.elems.len { break }; s2 = match cg_dc_scan_expr(s2, ie.elems[i]) { DcScan as x => x; error as err => return err }; i++ }
        }
        checker::TArrayLit as al => { var i = 0; loop { if i >= al.elements.len { break }; s2 = match cg_dc_scan_expr(s2, al.elements[i].expr) { DcScan as x => x; error as err => return err }; i++ } }
        checker::TSliceOfLen as sol => { s2 = match cg_dc_scan_expr(s2, sol.size) { DcScan as x => x; error as err => return err } }
        checker::TZeroOf => { }
        checker::TLambda as lam => { s2 = match cg_dc_scan_block(s2, lam.body) { DcScan as x => x; error as err => return err } }
        checker::TBorrow as bw => { s2 = match cg_dc_scan_expr(s2, bw.operand) { DcScan as x => x; error as err => return err } }
        checker::TBlockExpr as blk => { s2 = match cg_dc_scan_block(s2, blk.body) { DcScan as x => x; error as err => return err } }
        _ => return error { message = "codegen: deep_copy pre-scan does not handle this expression kind (internal)" }
    }
    s2
}

fn cg_dc_scan_block(s: DcScan, stmts: []@TStatement()): DcScan | error {
    var s2 = s
    var i = 0
    loop {
        if i >= stmts.len { break }
        match stmts[i] {
            checker::TBreakStmt => { }
            checker::TContinueStmt => { }
            checker::TBinding as b => { s2 = match cg_dc_scan_expr(s2, b.value) { DcScan as x => x; error as err => return err } }
            checker::TAssign as a => {
                s2 = match cg_dc_scan_expr(s2, a.value) { DcScan as x => x; error as err => return err }
                if parser::assign_has_target(a.kind) { s2 = match cg_dc_scan_expr(s2, a.target) { DcScan as x => x; error as err => return err } }
            }
            checker::TReturn as r => {
                if r.has_value { s2 = match cg_dc_scan_expr(s2, r.value) { DcScan as x => x; error as err => return err } }
                var vi = 0
                loop { if vi >= r.values.len { break }; s2 = match cg_dc_scan_expr(s2, r.values[vi]) { DcScan as x => x; error as err => return err }; vi++ }
            }
            checker::TLoopStmt as l => {
                s2 = match cg_dc_scan_block(s2, l.init) { DcScan as x => x; error as err => return err }
                s2 = match cg_dc_scan_block(s2, l.body) { DcScan as x => x; error as err => return err }
            }
            checker::TExprStmt as es => { s2 = match cg_dc_scan_expr(s2, es.expr) { DcScan as x => x; error as err => return err } }
            checker::TDeferStmt as d => { s2 = match cg_dc_scan_block(s2, d.body) { DcScan as x => x; error as err => return err } }
            checker::TAdoptStmt as a2 => { s2 = match cg_dc_scan_block(s2, a2.body) { DcScan as x => x; error as err => return err } }
            checker::TBlockStmt as b2 => { s2 = match cg_dc_scan_block(s2, b2.body) { DcScan as x => x; error as err => return err } }
            checker::TSpawn as sp => { s2 = match cg_dc_scan_expr(s2, sp.call) { DcScan as x => x; error as err => return err } }
            _ => return error { message = "codegen: deep_copy pre-scan does not handle this statement kind (internal)" }
        }
        i++
    }
    s2
}

fn cg_dc_scan_program(prog: CgProg): []str | error {
    var s = DcScan { classes = [] }
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { s = match cg_dc_scan_block(s, f.body) { DcScan as x => x; error as err => return err } }
            (@TStatement()) as st => { s = match cg_dc_scan_block(s, [st]) { DcScan as x => x; error as err => return err } }
            _ => { }
        }
        i++
    }
    s.classes
}

fn cg_dc_plan_nullable(prog: CgProg, members: []@Type()): DcFieldPlan | error {
    if members.len != 2 { return error { message = "codegen: deep_copy only supports a `Class | null` union for reference fields (internal)" } }
    var has_null = false
    var cls = ""
    var i = 0
    loop {
        if i >= members.len { break }
        match members[i] {
            checker::Null => has_null = true
            checker::Named as n => {
                if !cg_is_class_named(prog, n.name) { return error { message = "codegen: deep_copy only supports a class reference in a nullable union (internal)" } }
                cls = n.name
            }
            _ => return error { message = "codegen: deep_copy only supports a class reference in a nullable union (internal)" }
        }
        i++
    }
    if !has_null || cls == "" { return error { message = "codegen: deep_copy union member combination unsupported (internal)" } }
    DcFieldPlan { is_class = true; nullable = true; class_name = cls }
}

fn cg_dc_plan_type(prog: CgProg, t: @Type()): DcFieldPlan | error {
    if cg_is_str_type(t) { return DcFieldPlan { is_class = false; nullable = false; class_name = "" } }
    match t {
        checker::Prim => DcFieldPlan { is_class = false; nullable = false; class_name = "" }
        checker::Byte => DcFieldPlan { is_class = false; nullable = false; class_name = "" }
        checker::Char => DcFieldPlan { is_class = false; nullable = false; class_name = "" }
        checker::Named as n => {
            if !cg_is_class_named(prog, n.name) { return error { message = $"codegen: deep_copy does not support field type '{n.name}' (internal)" } }
            if cg_is_polymorphic_base(prog, n.name) { return error { message = $"codegen: deep_copy does not support polymorphic class '{n.name}' yet (internal)" } }
            DcFieldPlan { is_class = true; nullable = false; class_name = n.name }
        }
        checker::Variant as v => cg_dc_plan_nullable(prog, v.members)
        _ => error { message = "codegen: deep_copy does not support this field type (internal)" }
    }
}

fn cg_dc_plan_field(prog: CgProg, ref_ns: str, te: @TypeExpr()): DcFieldPlan | error {
    cg_dc_plan_type(prog, cg_te_to_type_ns(prog, ref_ns, te))
}

fn cg_dc_class_fields(prog: CgProg, cls: str): []parser::Field | error {
    match cg_find_decl(prog, cls) {
        parser::TypeDecl as d => match d.body {
            parser::ClassBody as cb2 => checker::effective_class_fields(cb2, cg_type_table(prog))
            _ => error { message = $"codegen: deep_copy target '{cls}' is not a class (internal)" }
        }
        error => error { message = $"codegen: deep_copy cannot find class '{cls}' (internal)" }
    }
}

fn cg_dc_close(prog: CgProg, seen: []str, work: []str): []str | error {
    if work.len == 0 { return seen }
    var cls = work[0]
    var rest: []str = []
    var wi = 1
    loop { if wi >= work.len { break }; rest = [..rest, work[wi]]; wi++ }
    if cg_str_in(seen, cls) { return cg_dc_close(prog, seen, rest) }
    var fields = match cg_dc_class_fields(prog, cls) { []parser::Field as fs => fs; error as e => return e }
    var ref_ns = checker::name_qualifier(cls)
    var seen2 = [..seen, cls]
    var work2 = rest
    var fi = 0
    loop {
        if fi >= fields.len { break }
        var plan = match cg_dc_plan_field(prog, ref_ns, fields[fi].type_ann) { DcFieldPlan as p => p; error as e => return e }
        if plan.is_class && !cg_str_in(seen2, plan.class_name) && !cg_str_in(work2, plan.class_name) {
            work2 = [..work2, plan.class_name]
        }
        fi++
    }
    cg_dc_close(prog, seen2, work2)
}

fn cg_dc_helper_name(buf: teko::io::FileStream, cls: str) {
    buf.write("tk_dc_")
    cb_tysym(buf, cls)
}

fn cg_dc_emit_proto(buf: teko::io::FileStream, cls: str) {
    buf.write("static ")
    mangle_type_name(buf, "", cls)
    buf.write(" *")
    cg_dc_helper_name(buf, cls)
    buf.write("(tk_region *, ")
    mangle_type_name(buf, "", cls)
    buf.write(" *, uint8_t, uint8_t *);\n")
}

fn cg_dc_emit_field_copy(buf: teko::io::FileStream, prog: CgProg, ref_ns: str, f: parser::Field) {
    var plan = match cg_dc_plan_field(prog, ref_ns, f.type_ann) { DcFieldPlan as p => p; error as e => panic(e.message) }
    if !plan.is_class {
        buf.write("_o->")
        buf.write(f.name)
        buf.write(" = _s->")
        buf.write(f.name)
        buf.write(";\n")
        return
    }
    if !plan.nullable {
        buf.write("_o->")
        buf.write(f.name)
        buf.write(" = ")
        cg_dc_helper_name(buf, plan.class_name)
        buf.write("(_r, _s->")
        buf.write(f.name)
        buf.write(", _d + 1, _e);\n")
        return
    }
    buf.write("_o->")
    buf.write(f.name)
    buf.write(" = (_s->")
    buf.write(f.name)
    buf.write(" == NULL) ? NULL : ")
    cg_dc_helper_name(buf, plan.class_name)
    buf.write("(_r, _s->")
    buf.write(f.name)
    buf.write(", _d + 1, _e);\n")
}

fn cg_dc_emit_body(buf: teko::io::FileStream, prog: CgProg, cls: str) {
    var fields = match cg_dc_class_fields(prog, cls) { []parser::Field as fs => fs; error as e => panic(e.message) }
    var ref_ns = checker::name_qualifier(cls)
    buf.write("static ")
    mangle_type_name(buf, "", cls)
    buf.write(" *")
    cg_dc_helper_name(buf, cls)
    buf.write("(tk_region *_r, ")
    mangle_type_name(buf, "", cls)
    buf.write(" *_s, uint8_t _d, uint8_t *_e) {\n")
    buf.write("if (_s == NULL) { return NULL; }\n")
    buf.write("if (*_e || _d >= 255) { *_e = 1; return NULL; }\n")
    buf.write("tk_region *_nr = ")
    cb_arena_sym(buf, CgArenaSym::RegionNew)
    buf.write("(_r);\n")
    mangle_type_name(buf, "", cls)
    buf.write(" *_o = (")
    mangle_type_name(buf, "", cls)
    buf.write(" *)")
    cb_arena_sym(buf, CgArenaSym::RegionAlloc)
    buf.write("(_nr, (size_t)sizeof(")
    mangle_type_name(buf, "", cls)
    buf.write("));\n")
    var fi = 0
    loop {
        if fi >= fields.len { break }
        cg_dc_emit_field_copy(buf, prog, ref_ns, fields[fi])
        fi++
    }
    buf.write("_o->__region = _nr;\n")
    buf.write("if (*_e) { return NULL; }\n")
    buf.write("return _o;\n}\n")
}

fn cg_emit_deep_copy_helpers(buf: teko::io::FileStream, prog: CgProg) {
    var seeds = match cg_dc_scan_program(prog) { []str as ss => ss; error as e => panic(e.message) }
    if seeds.len == 0 { return }
    var classes = match cg_dc_close(prog, [], seeds) { []str as cs => cs; error as e => panic(e.message) }
    var pi = 0
    loop { if pi >= classes.len { break }; cg_dc_emit_proto(buf, classes[pi]); pi++ }
    var bi = 0
    loop {
        if bi >= classes.len { break }
        cg_dc_emit_body(buf, prog, classes[bi])
        bi++
    }
}

fn emit_deep_copy(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if c.args.len != 1 { panic("codegen: deep_copy expects one argument (internal)") }
    var cls = match c.args[0].type { checker::Named as n => n.name; _ => panic("codegen: deep_copy only supports a class argument (internal)") }
    if !cg_is_class_named(prog, cls) { panic($"codegen: deep_copy only supports a class argument (got '{cls}') (internal)") }
    if cg_is_polymorphic_base(prog, cls) { panic($"codegen: deep_copy does not support polymorphic class '{cls}' yet (internal)") }
    var v = fresh_named("_dc", buf.gensym() to i64)
    var ev = fresh_named("_dce", buf.gensym() to i64)
    buf.write("({ uint8_t ")
    buf.write(ev)
    buf.write(" = 0; ")
    mangle_type_name(buf, "", cls)
    buf.write(" *")
    buf.write(v)
    buf.write(" = ")
    cg_dc_helper_name(buf, cls)
    buf.write("(")
    buf.write(cg_alloc_region(regions, dctx))
    buf.write(", ")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write(", 0, &")
    buf.write(ev)
    buf.write("); ")
    buf.write(ev)
    buf.write(" ? ")
    emit_variant_wrap_str(buf, prog, e.type, checker::Error { }, "(tk_error){0}", cg_frame_region(dctx))
    buf.write(" : ")
    emit_variant_wrap_str(buf, prog, e.type, checker::Named { name = cls }, v, cg_frame_region(dctx))
    buf.write("; })")
}

fn emit_ptr_unwrap_seam(buf: teko::io::FileStream, addr_c: str, tag_c: str) { }

fn emit_ptr_wrap_guard(buf: teko::io::FileStream, addr_c: str, tag_c: str) {
    buf.write("1")
}

fn emit_ptr_unwrap(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if c.args.len != 1 { panic("codegen: ptr::__unwrap expects one argument (internal)") }
    var a = fresh_named("_pu", buf.gensym() to i64)
    buf.write("({ void *")
    buf.write(a)
    buf.write(" = (void *)(&(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write(")); ")
    emit_ptr_unwrap_seam(buf, a, "")
    buf.write("(")
    emit_type(buf, prog, e.type)
    buf.write(")")
    buf.write(a)
    buf.write("; })")
}

fn emit_ref_word(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if c.args.len != 1 { panic("codegen: ref_word expects one argument (internal)") }
    buf.write("((int64_t)(uintptr_t)&(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write("))")
}

fn emit_ptr_wrap(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if c.args.len != 1 { panic("codegen: __wrap expects one (receiver) argument (internal)") }
    if c.type_args.len != 1 { panic("codegen: __wrap expects one type argument (internal)") }
    var ttype = c.type_args[0]
    var addr = fresh_named("_pw", buf.gensym() to i64)
    buf.write("({ void *")
    buf.write(addr)
    buf.write(" = (void *)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write("); ")
    buf.write(addr)
    buf.write(" == 0 ? ")
    emit_variant_wrap_str(buf, prog, e.type, checker::Null { }, "0", cg_frame_region(dctx))
    buf.write(" : (")
    emit_ptr_wrap_guard(buf, addr, "")
    buf.write(" ? ")
    var tc = emit_type_str(prog, ttype)
    var tarm = $"*({tc} *){addr}"
    emit_variant_wrap_str(buf, prog, e.type, ttype, tarm, cg_frame_region(dctx))
    buf.write(" : ")
    emit_variant_wrap_str(buf, prog, e.type, checker::Error { }, "(tk_error){0}", cg_alloc_region(regions, dctx))
    buf.write("); })")
}

fn emit_as_cstr(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var v = $"_ac{buf.gensym()}"
    buf.write($"({{ tk_str {v}_s = (")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    var region = cg_alloc_region(regions, dctx)
    buf.write($"); uint8_t *{v} = (uint8_t *)")
    cb_arena_sym(buf, CgArenaSym::RegionAlloc)
    buf.write($"({region}, (size_t)({v}_s.len + 1)); for (uint64_t {v}_i = 0; {v}_i < {v}_s.len; {v}_i++) {{ {v}[{v}_i] = {v}_s.ptr[{v}_i]; }} {v}[{v}_s.len] = 0; {v}; }})")
}

fn emit_str_from_c(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var v = $"_sfc{buf.gensym()}"
    buf.write($"({{ const uint8_t *{v}_p = (const uint8_t *)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write($"); uint64_t {v}_max = (uint64_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx)
    buf.write($"); uint64_t {v}_n = 0; if ({v}_p != NULL) {{ while ({v}_n < {v}_max && {v}_p[{v}_n] != 0) {{ {v}_n++; }} }} uint8_t *{v}_buf = (uint8_t *)")
    cb_arena_sym(buf, CgArenaSym::RegionAlloc)
    buf.write("("); buf.write(cg_frame_region(dctx))
    buf.write($", {v}_n ? {v}_n : 1); for (uint64_t {v}_i = 0; {v}_i < {v}_n; {v}_i++) {{ {v}_buf[{v}_i] = {v}_p[{v}_i]; }} (tk_str){{ {v}_buf, {v}_n }}; }})")
}

fn emit_slice_view(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if c.args.len != 3 { panic("codegen: slice_view expects a slice, a start and an end (internal)") }
    var v = $"_sv{buf.gensym()}"
    buf.write("({ ")
    emit_type(buf, prog, c.args[0].type)
    buf.write($" {v} = (")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write($"); uint64_t {v}_a = (uint64_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx)
    buf.write($"); uint64_t {v}_b = (uint64_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[2], escaping, regions, fn_body, dctx)
    buf.write("); (")
    emit_type(buf, prog, c.args[0].type)
    buf.write($"){{ {v}.ptr + {v}_a, (size_t)({v}_b - {v}_a) }}; }})")
}

fn emit_region_buf(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var v = $"_rb{buf.gensym()}"
    buf.write($"({{ tk_region *{v}_r = (tk_region *)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write($"); uint64_t {v}_len = (uint64_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx)
    buf.write($"); tk_str {v}_s = (")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[2], escaping, regions, fn_body, dctx)
    buf.write($"); uint8_t *{v} = (uint8_t *)")
    cb_arena_sym(buf, CgArenaSym::RegionAlloc)
    buf.write($"({v}_r, (size_t){v}_len); uint64_t {v}_cn = ({v}_s.len < {v}_len) ? {v}_s.len : {v}_len; for (uint64_t {v}_i = 0; {v}_i < {v}_cn; {v}_i++) {{ {v}[{v}_i] = {v}_s.ptr[{v}_i]; }} if ({v}_cn < {v}_len) {{ {v}[{v}_cn] = 0; }} else if ({v}_len > 0) {{ {v}[{v}_len - 1] = 0; }} {v}; }})")
}

fn emit_ptr_word(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write("((int64_t)(uintptr_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write("))")
}

fn emit_word_ptr(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write("((void *)(uintptr_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write("))")
}

fn emit_load_u64(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write("((uint64_t)*(volatile uint64_t *)(uintptr_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write("))")
}

fn emit_store_u64(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write("(*(volatile uint64_t *)(uintptr_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write(") = (uint64_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx)
    buf.write("))")
}

fn emit_load_u8(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write("((uint64_t)*(volatile uint8_t *)(uintptr_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write("))")
}

fn emit_store_u8(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write("(*(volatile uint8_t *)(uintptr_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write(") = (uint8_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx)
    buf.write("))")
}

fn emit_capture_invoke(buf: teko::io::FileStream, prog: CgProg, body_type: @Type(), bd: str, region: str) {
    buf.write(bd)
    buf.write(".env ? (void)((")
    cg_emit_fnptr_sig_ex(buf, prog, body_type, true)
    buf.write(")")
    buf.write(bd)
    buf.write(".fn)(")
    buf.write(bd)
    buf.write(".env, "); buf.write(region); buf.write(") : (void)((")
    cg_emit_fnptr_sig_ex(buf, prog, body_type, false)
    buf.write(")")
    buf.write(bd)
    buf.write(".fn)("); buf.write(region); buf.write(")")
}

fn emit_capture_panic(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var g = buf.gensym()
    var rv = $"_tkcap_r{g}"
    var bd = $"_tkcap_b{g}"
    buf.write("({ tk_str ")
    buf.write(rv)
    buf.write("; tk_closure ")
    buf.write(bd)
    buf.write(" = ")
    emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
    buf.write("; ")
    cb_fn_name(buf, "teko::runtime", "capture_arm")
    buf.write("(); ")
    emit_capture_invoke(buf, prog, c.args[0].type, bd, cg_call_region(dctx))
    buf.write("; if (")
    cb_fn_name(buf, "teko::runtime", "panicking")
    buf.write("()) { ")
    buf.write(rv)
    buf.write(" = ")
    cb_fn_name(buf, "teko::runtime", "take_panic")
    buf.write("(); } else { ")
    buf.write(rv)
    buf.write(" = (tk_str){0}; } ")
    cb_fn_name(buf, "teko::runtime", "capture_disarm")
    buf.write("(); ")
    buf.write(rv)
    buf.write("; })")
}

fn emit_capture_longjmp(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    cb_fn_name(buf, "teko::runtime", "panic_raise")
    buf.write("()")
}

fn emit_iface_call(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var p = c.callee
    var f = match c.callee_type { checker::Func as ff => ff; _ => panic("codegen: malformed interface-dispatch node (internal)") }
    if p.segments.len < 2 || c.args.len == 0 || c.args.len != f.params.len {
        panic("codegen: malformed interface-dispatch node (internal)")
    }
    var iface_raw = p.segments[p.segments.len - 2].name
    var iface = match cg_find_decl(prog, iface_raw) { parser::TypeDecl as d => d.name; error => iface_raw }
    var t = fresh_named("_tid", buf.gensym() to i64)
    var iface_t = checker::Named { name = iface }
    buf.write("({ ")
    emit_type(buf, prog, iface_t)
    buf.write(" ")
    buf.write(t)
    buf.write(" = ")
    emit_as_r(buf, prog, ret_type, iface_t, c.args[0], escaping, regions, fn_body, dctx)
    buf.write("; ((")
    emit_type(buf, prog, f.ret)
    buf.write(" (*)(void *")
    var pi: u64 = 1
    loop {
        if pi >= f.params.len { break }
        buf.write(", ")
        emit_type(buf, prog, f.params[pi])
        pi++
    }
    buf.write(", tk_region *))")
    buf.write(t)
    buf.write(".vtable[")
    cb_u64_digits(buf, c.iface_slot to u64)
    buf.write("])(")
    buf.write(t)
    buf.write(".data")
    var ai: u64 = 1
    loop {
        if ai >= c.args.len { break }
        buf.write(", ")
        emit_as_r(buf, prog, ret_type, f.params[ai], c.args[ai], escaping, regions, fn_body, dctx)
        ai++
    }
    buf.write(", "); buf.write(cg_call_region(dctx))
    buf.write("); })")
}

fn cg_call_bare_name(c: checker::TCall): str {
    var segs = c.callee.segments
    if segs.len == 0 { return "" }
    segs[segs.len - 1].name
}

fn cg_call_is_user_declared(prog: CgProg, c: checker::TCall): bool {
    if c.call_ns.len == 0 { return false }
    match cg_find_function(prog, c.call_ns, cg_call_bare_name(c)) {
        checker::TFunction as f => !f.is_extern
        error => false
    }
}

fn emit_concat_fold(buf: teko::io::FileStream, prog: CgProg, arg: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write(cb_fn_name_str("teko::runtime", "concat"))
    buf.write("(")
    emit_expr_ctx(buf, prog, checker::Void { }, arg, escaping, regions, fn_body, dctx)
    buf.write(", "); buf.write(cg_call_region(dctx))
    buf.write(")")
}

fn cg_is_concat_bridge(prog: CgProg, c: checker::TCall): bool {
    if cg_call_is_user_declared(prog, c) { return false }
    var p = c.callee
    if p.segments.len == 0 { return false }
    if c.args.len != 1 { return false }
    if p.segments[p.segments.len - 1].name != "concat" { return false }
    (p.segments.len == 1) || (p.segments[0].name == "teko")
}

fn cg_bound_is_str(t: @Type()): bool {
    cg_is_str_type(t)
}

fn emit_svc_slot_call(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), e: checker::TExpr, c: checker::TCall, scope: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var sname = match e.type { checker::Named as nm => nm.name; _ => panic("codegen: a service ctor call must have a named type") }
    var id = checker::svc_type_id(sname)
    var rN = fresh_named("_svcr", buf.gensym() to i64)
    var hN = fresh_named("_svch", buf.gensym() to i64)
    buf.write("({ tk_region *")
    buf.write(rN)
    buf.write(" = ")
    buf.write(scope)
    buf.write("; void *")
    buf.write(hN)
    buf.write(" = "); cb_arena_sym(buf, CgArenaSym::RegionLookup); buf.write("(")
    buf.write(rN)
    buf.write(", ")
    cb_u64_digits(buf, id)
    buf.write("ULL); ")
    buf.write(hN)
    buf.write(" ? (")
    emit_type(buf, prog, e.type)
    buf.write(")")
    buf.write(hN)
    buf.write(" : ({ ")
    emit_type(buf, prog, e.type)
    var vN = fresh_named("_svcv", buf.gensym() to i64)
    buf.write(" ")
    buf.write(vN)
    buf.write(" = ")
    emit_call_inner(buf, prog, ret_type, e, c, escaping, regions, fn_body, dctx)
    buf.write("; "); cb_arena_sym(buf, CgArenaSym::RegionRegister); buf.write("(")
    buf.write(rN)
    buf.write(", ")
    cb_u64_digits(buf, id)
    buf.write("ULL, (void *)")
    buf.write(vN)
    buf.write("); ")
    buf.write(vN)
    buf.write("; }); })")
}

fn svc_scope_expr(lifetime: parser::ServiceLifetime, regions: []RegionFrame, dctx: DeferCtx): str {
    match lifetime {
        parser::ServiceLifetime::Singleton => teko::str::concat(cg_arena_sym(CgArenaSym::RegionRoot), "()")
        parser::ServiceLifetime::Scoped => cg_alloc_region(regions, dctx)
        parser::ServiceLifetime::Transient => ""
    }
}

fn cg_service_ctor_lifetime(prog: CgProg, c: checker::TCall): parser::ServiceLifetime | null {
    if c.args.len != 0 { return null }
    var segs = c.callee.segments
    if segs.len < 2 { return null }
    if !teko::runtime::str_eq(segs[segs.len - 1].name, "ctor") { return null }
    var owner = segs[segs.len - 2].name
    match cg_find_decl(prog, owner) {
        parser::TypeDecl as td => match td.body {
            parser::ClassBody as cb => if cb.is_service { cb.service_lifetime } else { null }
            _ => null
        }
        error => null
    }
}

fn emit_call(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    match cg_service_ctor_lifetime(prog, c) {
        parser::ServiceLifetime as lt => {
            var scope = svc_scope_expr(lt, regions, dctx)
            if scope.len > 0 { return emit_svc_slot_call(buf, prog, ret_type, e, c, scope, escaping, regions, fn_body, dctx) }
        }
        null => { }
    }
    emit_call_inner(buf, prog, ret_type, e, c, escaping, regions, fn_body, dctx)
}

fn emit_call_inner(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if c.is_iface_dispatch { return emit_iface_call(buf, prog, ret_type, c, escaping, regions, fn_body, dctx) }
    if c.is_closure_call { return emit_closure_call(buf, prog, ret_type, c, escaping, regions, fn_body, dctx) }
    if c.call_ns == "teko::__ptr_unwrap" { return emit_ptr_unwrap(buf, prog, e, c, escaping, regions, fn_body, dctx) }
    if c.call_ns == "teko::__ptr_wrap" { return emit_ptr_wrap(buf, prog, e, c, escaping, regions, fn_body, dctx) }
    if c.call_ns == "teko::__ref_word" { return emit_ref_word(buf, prog, c, escaping, regions, fn_body, dctx) }
    if c.call_ns == "teko::__sizeof" { return emit_sizeof_intrinsic(buf, prog, c) }
    if c.call_ns == "teko::__alignof" { return emit_alignof_intrinsic(buf, prog, c) }
    var p = c.callee
    var user_declared = cg_call_is_user_declared(prog, c)
    if cg_is_mem_value_call(p, user_declared) {
        var vlast = p.segments[p.segments.len - 1].name
        if vlast == "place" { return emit_place(buf, prog, e, c, escaping, regions, fn_body, dctx) }
        if vlast == "read" { return emit_read(buf, prog, c, escaping, regions, fn_body, dctx) }
        if vlast == "write" { return emit_write(buf, prog, c, escaping, regions, fn_body, dctx) }
    }
    if p.segments.len >= 1 && !user_declared {
        var pe = p.segments[p.segments.len - 1].name
        if pe == "err_loc" {
            buf.write("tk_error_loc(")
            emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
            buf.write(", (uint32_t)(")
            emit_expr_ctx(buf, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx)
            buf.write("), (uint32_t)(")
            emit_expr_ctx(buf, prog, checker::Void { }, c.args[2], escaping, regions, fn_body, dctx)
            buf.write("))")
            return
        }
        if pe == "err_typed" {
            buf.write("tk_error_types(")
            emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
            buf.write(", ")
            emit_expr_ctx(buf, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx)
            buf.write(", ")
            emit_expr_ctx(buf, prog, checker::Void { }, c.args[2], escaping, regions, fn_body, dctx)
            buf.write(")")
            return
        }
        var addr = (p.segments.len == 1) || (p.segments[0].name == "teko")
        if addr && pe == "append_fo" && c.args.len == 2 {
            var ab = $"_ab{buf.gensym()}"
            var asr = $"_as{buf.gensym()}"
            var al = $"_al{buf.gensym()}"
            var ap = $"_ap{buf.gensym()}"
            buf.write("({ ")
            cg_slice_typename(buf, checker::Byte { })
            buf.write(" "); buf.write(ab); buf.write(" = ")
            emit_as(buf, prog, checker::Slice { element = checker::Byte { } }, c.args[0], escaping, regions, fn_body, dctx)
            buf.write("; tk_str "); buf.write(asr); buf.write(" = ")
            emit_as(buf, prog, checker::Named { name = "teko::base::str" }, c.args[1], escaping, regions, fn_body, dctx)
            buf.write("; uint64_t "); buf.write(al); buf.write("; uint8_t *"); buf.write(ap)
            buf.write(" = (uint8_t *)tk_append_bytes_fo("); buf.write(ab); buf.write(".ptr, "); buf.write(ab); buf.write(".len, "); buf.write(asr); buf.write(".ptr, "); buf.write(asr); buf.write(".len, &"); buf.write(al)
            buf.write("); (")
            cg_slice_typename(buf, checker::Byte { })
            buf.write("){ .ptr = "); buf.write(ap); buf.write(", .len = "); buf.write(al)
            buf.write(" }; })")
            return
        }
        if addr && (pe == "str" || pe == "str_of_bytes") && c.args.len == 1 {
            var sb = $"_sb{buf.gensym()}"
            buf.write("({ ")
            emit_type(buf, prog, c.args[0].type)
            buf.write(" ")
            buf.write(sb)
            buf.write(" = ")
            emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
            buf.write("; tk_str_of_bytes((tk_str){ (const tk_byte *)")
            buf.write(sb)
            buf.write(".ptr, ")
            buf.write(sb)
            buf.write(".len }); })")
            return
        }
        if addr && pe == "concat" && c.args.len == 1 {
            return emit_concat_fold(buf, prog, c.args[0], escaping, regions, fn_body, dctx)
        }
    }
    if p.segments.len >= 1 {
        var l = p.segments[p.segments.len - 1].name
        var addr2 = !user_declared && ((p.segments.len == 1) || (p.segments[0].name == "teko"))
        if addr2 {
            if l == "var" { return emit_host_ffi(buf, prog, e, c, "sres", "tk_rt_getenv", escaping, regions, fn_body, dctx) }
            if l == "chdir" { return emit_host_ffi(buf, prog, e, c, "ures", "tk_rt_chdir", escaping, regions, fn_body, dctx) }
            if l == "cwd" { return emit_host_ffi(buf, prog, e, c, "sres", "tk_rt_getcwd", escaping, regions, fn_body, dctx) }
            if l == "set_var" { return emit_host_ffi(buf, prog, e, c, "ures", "tk_rt_setenv", escaping, regions, fn_body, dctx) }
            if l == "last_index_of" { return emit_host_ffi(buf, prog, e, c, "u64res", "tk_rt_last_index_of", escaping, regions, fn_body, dctx) }
            if l == "args" { return emit_host_ffi(buf, prog, e, c, "args", "tk_rt_args", escaping, regions, fn_body, dctx) }
            if l == "run" { return emit_host_ffi(buf, prog, e, c, "run", "tk_rt_run", escaping, regions, fn_body, dctx) }
            if l == "run_quiet" { return emit_host_ffi(buf, prog, e, c, "run", "tk_rt_run_quiet", escaping, regions, fn_body, dctx) }
            if l == "bytes_from_ptr" { return emit_host_ffi(buf, prog, e, c, "bytes", "tk_bytes_from_ptr", escaping, regions, fn_body, dctx) }
            if l == "str_from_utf8" { return emit_host_ffi(buf, prog, e, c, "sres_byteslice", "tk_rt_str_from_utf8", escaping, regions, fn_body, dctx) }
            if l == "buf_ptr" { return emit_buf_ptr(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "byte_ptr" { return emit_byte_ptr(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "as_cstr" { return emit_as_cstr(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "str_from_c" { return emit_str_from_c(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "slice_view" { return emit_slice_view(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "region_buf" { return emit_region_buf(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "ptr_word" { return emit_ptr_word(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "word_ptr" { return emit_word_ptr(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "load_u64" { return emit_load_u64(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "store_u64" { return emit_store_u64(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "load_u8" { return emit_load_u8(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "store_u8" { return emit_store_u8(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "capture_panic" { return emit_capture_panic(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "capture_longjmp" { return emit_capture_longjmp(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "retain" { return emit_retain(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "release" { return emit_release(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "weak_get" { return emit_weak_get(buf, prog, e, c, escaping, regions, fn_body, dctx) }
            if l == "deep_copy" { return emit_deep_copy(buf, prog, e, c, escaping, regions, fn_body, dctx) }
        }
    }
    var builtin = ""
    var has_builtin = false
    if p.segments.len >= 1 {
        var last = p.segments[p.segments.len - 1].name
        var addressable = !user_declared && ((p.segments.len == 1) || (p.segments[0].name == "teko"))
        var assert_sym = if c.call_ns.len == 0 { cg_assert_symbol(p) } else { "" }
        if assert_sym.len != 0 { builtin = assert_sym; has_builtin = true }
        else if addressable {
            if last == "read_line" { builtin = "tk_rt_read_line"; has_builtin = true }
            else if last == "stdin_eof" { builtin = "tk_rt_stdin_eof"; has_builtin = true }
            else if last == "read_stdin" { builtin = "tk_rt_read_stdin"; has_builtin = true }
            else if last == "parse" { builtin = "tk_float_parse"; has_builtin = true }
            else if last == "fdiv" { builtin = "tk_fdiv"; has_builtin = true }
            else if last == "f64_bits" { builtin = "tk_f64_bits"; has_builtin = true }
            else if last == "f64_from_bits" { builtin = "tk_f64_from_bits"; has_builtin = true }
            else if last == "syscall0" { builtin = "tk_syscall0"; has_builtin = true }
            else if last == "syscall1" { builtin = "tk_syscall1"; has_builtin = true }
            else if last == "syscall2" { builtin = "tk_syscall2"; has_builtin = true }
            else if last == "syscall3" { builtin = "tk_syscall3"; has_builtin = true }
            else if last == "syscall4" { builtin = "tk_syscall4"; has_builtin = true }
            else if last == "syscall5" { builtin = "tk_syscall5"; has_builtin = true }
            else if last == "syscall6" { builtin = "tk_syscall6"; has_builtin = true }
            else if last == "thread_clone" { builtin = "tk_thread_clone"; has_builtin = true }
            else if last == "atomic_cas_u32" { builtin = "tk_atomic_cas_u32"; has_builtin = true }
            else if last == "atomic_xchg_u32" { builtin = "tk_atomic_xchg_u32"; has_builtin = true }
            else if last == "atomic_add_u32" { builtin = "tk_atomic_add_u32"; has_builtin = true }
            else if last == "atomic_load_u32" { builtin = "tk_atomic_load_u32"; has_builtin = true }
            else if last == "arena_push" { builtin = cg_arena_sym(CgArenaSym::ArenaPush); has_builtin = true }
            else if last == "arena_pop" { builtin = cg_arena_sym(CgArenaSym::ArenaPop); has_builtin = true }
            else if last == "arena_commit" { builtin = cg_arena_sym(CgArenaSym::ArenaCommit); has_builtin = true }
            else if last == "task_reset" { builtin = "tk_task_reset"; has_builtin = true }
            else if last == "version" { builtin = "tk_rt_version"; has_builtin = true }
            else if last == "peak_rss" { builtin = cb_fn_name_str("teko::runtime", "peak_rss"); has_builtin = true }
            else if last == "floor" { builtin = "tk_floor"; has_builtin = true }
        }
    }
    if !has_builtin && c.call_ns.len == 0 { panic("codegen: no resolved namespace") }
    var cf_res = if c.call_ns.len != 0 {
        cg_find_function(prog, c.call_ns, p.segments[p.segments.len - 1].name)
    } else {
        error { message = "codegen: no resolved namespace" }
    }
    var call_wants_region = if has_builtin { false } else { match cf_res { checker::TFunction as cf => cg_fn_needs_region(prog, cf); error => false } }
    var self_hoist = match cf_res {
        checker::TFunction as cf => cg_call_needs_self_hoist(prog, cf, c)
        error => false
    }
    var self_hoist_name = ""
    if self_hoist {
        self_hoist_name = fresh_named("_rcv", buf.gensym() to i64)
        buf.write("({ ")
        emit_type(buf, prog, c.args[0].type)
        buf.write(" ")
        buf.write(self_hoist_name)
        buf.write(" = ")
        emit_expr_ctx(buf, prog, ret_type, c.args[0], escaping, regions, fn_body, dctx)
        buf.write("; ")
    }
    if has_builtin {
        buf.write(builtin)
    } else if c.call_ns.len != 0 {
        var is_extern_call = false
        var ext_symbol = ""
        match cf_res {
            checker::TFunction as cf => { if cf.is_extern { is_extern_call = true; ext_symbol = cf.c_symbol } }
            error => { }
        }
        if is_extern_call {
            buf.write(ext_symbol)
        } else {
            cb_fn_name(buf, c.call_ns, p.segments[p.segments.len - 1].name, c.overload_suffix)
        }
    } else {
        cb_ident(buf, p.segments[p.segments.len - 1].name)
    }
    buf.write("(")
    var j = 0
    loop {
        if j >= c.args.len { break }
        if j > 0 { buf.write(", ") }
        var wrapped = false
        match cf_res {
            checker::TFunction as cf => {
                if j < cf.params.len {
                    var cf_ref_ns = cg_fn_ref_ns(prog, cf.namespace)
                    var is_self_recv = if j != 0 { false } else { match cg_struct_self_recv(prog, cf) { str => true; null => false } }
                    match cf.params[j].type_ann {
                        parser::NamedType as nt => {
                            var pn = nt.path.segments[nt.path.segments.len - 1].name
                            if is_self_recv {
                                if self_hoist { buf.write("&"); buf.write(self_hoist_name) }
                                else { cg_emit_self_addr(buf, prog, ret_type, c.args[j], escaping, regions, fn_body, dctx) }
                            } else if pn == "Ref" {
                                var arg_is_ref = match c.args[j].type { checker::Reference => true; _ => false }
                                if !arg_is_ref { buf.write("&") }
                                emit_expr_ctx(buf, prog, ret_type, c.args[j], escaping, regions, fn_body, dctx)
                            } else {
                                emit_as_r(buf, prog, ret_type, checker::Named { name = cg_canon_name_ns(prog, nt.path, cf_ref_ns) }, c.args[j], escaping, regions, fn_body, dctx)
                            }
                            wrapped = true
                        }
                        parser::SliceType as slt => {
                            var exp_slice = cg_slice_param_type(prog, slt, c.args[j].type)
                            emit_as_r(buf, prog, ret_type, exp_slice, c.args[j], escaping, regions, fn_body, dctx)
                            wrapped = true
                        }
                        parser::UnionType => {
                            var exp_union = cg_te_to_type_ns(prog, cf_ref_ns, cf.params[j].type_ann)
                            emit_as_r(buf, prog, ret_type, exp_union, c.args[j], escaping, regions, fn_body, dctx)
                            wrapped = true
                        }
                        _ => { }
                    }
                }
            }
            error => { }
        }
        if !wrapped {
            emit_expr_ctx(buf, prog, ret_type, c.args[j], escaping, regions, fn_body, dctx)
        }
        j++
    }
    if call_wants_region {
        if c.args.len > 0 { buf.write(", ") }
        buf.write(cg_call_region(dctx))
    }
    buf.write(")")
    if self_hoist { buf.write("; })") }
}

fn cg_emit_nn_guard(buf: teko::io::FileStream, prog: CgProg, recv: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var p = $"_p{buf.gensym()}"
    buf.write("({ ")
    emit_type(buf, prog, recv.type)
    buf.write(" ")
    buf.write(p)
    buf.write(" = (")
    emit_expr_ctx(buf, prog, checker::Void { }, recv, escaping, regions, fn_body, dctx)
    buf.write("); ")
    buf.write(p)
    buf.write(" ? ")
    buf.write(p)
    buf.write(" : (")
    buf.write(cb_fn_name_str("teko::runtime", "panic_null_deref_at"))
    buf.write("(")
    cb_u64_digits(buf, recv.line to u64)
    buf.write(", ")
    cb_u64_digits(buf, recv.col to u64)
    buf.write("), ")
    buf.write(p)
    buf.write("); })")
}

fn emit_field_access(buf: teko::io::FileStream, prog: CgProg, fa: checker::TFieldAccess, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var is_slice = match fa.receiver.type { checker::Slice => true; _ => false }
    if is_slice && fa.field == "len" {
        buf.write("(")
        emit_expr_ctx(buf, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx)
        buf.write(".len)")
        return
    }
    var is_error = match fa.receiver.type { checker::Error => true; _ => false }
    if is_error {
        buf.write("((")
        emit_expr_ctx(buf, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx)
        buf.write(").")
        buf.write(fa.field)
        buf.write(")")
        return
    }
    var is_ref = match fa.receiver.type { checker::Reference => true; _ => false }
    if is_ref && fa.field == "value" {
        buf.write("(*(")
        emit_expr_ctx(buf, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx)
        buf.write("))")
        return
    }
    var is_class_recv = match fa.receiver.type {
        checker::Named as nm => cg_is_class_named(prog, nm.name)
        _ => false
    }
    if is_class_recv {
        var recv_poly_base = match fa.receiver.type {
            checker::Named as nm => cg_is_polymorphic_base(prog, nm.name)
            _ => false
        }
        if recv_poly_base {
            var bname = match fa.receiver.type { checker::Named as nm => nm.name; _ => "" }
            buf.write("((*((")
            mangle_type_name(buf, "", bname)
            buf.write(" *)(")
            emit_expr_ctx(buf, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx)
            buf.write(").data)).")
            buf.write(fa.field)
            buf.write(")")
            return
        }
        buf.write("((*")
        cg_emit_nn_guard(buf, prog, fa.receiver, escaping, regions, fn_body, dctx)
        buf.write(").")
        buf.write(fa.field)
        buf.write(")")
        return
    }
    var fa_boxed = if cg_is_str_type(fa.receiver.type) { false } else { match fa.receiver.type {
        checker::Named as nm => match cg_find_struct_field_type(prog, nm.name, fa.field) {
            (@TypeExpr()) as fte => cg_field_boxed(prog, nm.name, fte)
            null => false
        }
        _ => false
    } }
    buf.write("(")
    if fa_boxed { buf.write("*") }
    buf.write("(")
    emit_expr_ctx(buf, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx)
    buf.write(".")
    buf.write(fa.field)
    buf.write("))")
}

fn cg_expr_diverges(e: checker::TExpr): bool {
    match e.kind {
        checker::TCall as c => checker::tcall_is_diverging_builtin(c)
        _ => false
    }
}

fn emit_index(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, ix: checker::TIndex, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    match ix.receiver.type {
        checker::Slice as srt => {
            var elem = match srt.element {
                checker::Void => panic("codegen: indexing an untyped empty slice (internal: checker should reject)")
                _ => srt.element
            }
            var lstmp = $"_ls{buf.gensym()}"
            var litmp = $"_li{buf.gensym()}"
            buf.write("({ ")
            emit_type(buf, prog, elem)
            buf.write(" const *")
            buf.write(lstmp)
            buf.write(" = (")
            emit_expr_ctx(buf, prog, checker::Void { }, ix.receiver, escaping, regions, fn_body, dctx)
            buf.write(").ptr; uint64_t ")
            buf.write(litmp)
            buf.write(" = (uint64_t)(")
            emit_expr_ctx(buf, prog, checker::Void { }, ix.index, escaping, regions, fn_body, dctx)
            buf.write("); ")
            buf.write(litmp)
            buf.write(" < (")
            emit_expr_ctx(buf, prog, checker::Void { }, ix.receiver, escaping, regions, fn_body, dctx)
            buf.write(").len ? ")
            buf.write(lstmp)
            buf.write("[")
            buf.write(litmp)
            buf.write("]")
            buf.write(" : (")
    buf.write(cb_fn_name_str("teko::runtime", "panic_oob_at"))
    buf.write("(")
            cb_u64_digits(buf, e.line to u64)
            buf.write(", ")
            cb_u64_digits(buf, e.col to u64)
            buf.write("), (")
            emit_type(buf, prog, elem)
            buf.write("){0}); })")
            return
        }
        _ => if !cg_is_str_type(ix.receiver.type) { panic("codegen: indexing a non-string value not yet supported") }
    }
    var stmp = $"_s{buf.gensym()}"
    var itmp = $"_i{buf.gensym()}"
    buf.write("({ tk_str ")
    buf.write(stmp)
    buf.write(" = ")
    emit_expr_ctx(buf, prog, checker::Void { }, ix.receiver, escaping, regions, fn_body, dctx)
    buf.write("; uint64_t ")
    buf.write(itmp)
    buf.write(" = (uint64_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, ix.index, escaping, regions, fn_body, dctx)
    buf.write("); ")
    buf.write(itmp)
    buf.write(" < ")
    buf.write(stmp)
    buf.write(".len ? ")
    buf.write(stmp)
    buf.write(".ptr[")
    buf.write(itmp)
    buf.write("]")
    buf.write(" : (")
    buf.write(cb_fn_name_str("teko::runtime", "panic_oob_at"))
    buf.write("(")
    cb_u64_digits(buf, e.line to u64)
    buf.write(", ")
    cb_u64_digits(buf, e.col to u64)
    buf.write("), (tk_byte)0); })")
}

fn emit_in(buf: teko::io::FileStream, prog: CgProg, ie: checker::TInExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if ie.elems.len == 0 {
        buf.write("({ (void)(")
        emit_expr_ctx(buf, prog, checker::Void { }, ie.lhs, escaping, regions, fn_body, dctx)
        buf.write("); 0; })")
        return
    }
    var tmp = $"_inv{buf.gensym()}"
    var str_in = cg_is_str_type(ie.lhs.type)
    buf.write("({ ")
    emit_type(buf, prog, ie.lhs.type)
    buf.write(" ")
    buf.write(tmp)
    buf.write(" = ")
    emit_expr_ctx(buf, prog, checker::Void { }, ie.lhs, escaping, regions, fn_body, dctx)
    buf.write("; ")
    var i = 0
    loop {
        if i >= ie.elems.len { break }
        if i > 0 { buf.write(" || ") }
        if str_in {
            buf.write(cb_fn_name_str("teko::runtime", "str_eq"))
            buf.write("(")
            buf.write(tmp)
            buf.write(", ")
            emit_expr_ctx(buf, prog, checker::Void { }, ie.elems[i], escaping, regions, fn_body, dctx)
            buf.write(")")
        } else {
            buf.write("(")
            buf.write(tmp)
            buf.write(" == ")
            emit_expr_ctx(buf, prog, checker::Void { }, ie.elems[i], escaping, regions, fn_body, dctx)
            buf.write(")")
        }
        i++
    }
    buf.write("; })")
}

fn emit_slice_of_len(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, s: checker::TSliceOfLen, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var elem = s.element
    var lenN = $"_oln{buf.gensym()}"
    var ptrN = $"_olp{buf.gensym()}"
    buf.write("({ uint64_t ")
    buf.write(lenN)
    buf.write(" = (uint64_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, s.size, escaping, regions, fn_body, dctx)
    buf.write("); ")
    emit_type(buf, prog, elem)
    buf.write(" *")
    buf.write(ptrN)
    buf.write(" = (")
    emit_type(buf, prog, elem)
    buf.write(" *)")
    cb_arena_sym(buf, CgArenaSym::RegionAlloc)
    buf.write("(")
    buf.write(cg_alloc_region(regions, dctx))
    buf.write(", ")
    buf.write(lenN)
    buf.write(" * sizeof(")
    emit_type(buf, prog, elem)
    buf.write(")); tk_memset(")
    buf.write(ptrN)
    buf.write(", 0, ")
    buf.write(lenN)
    buf.write(" * sizeof(")
    emit_type(buf, prog, elem)
    buf.write(")); (")
    cg_slice_typename(buf, elem)
    buf.write("){ .ptr = ")
    buf.write(ptrN)
    buf.write(", .len = ")
    buf.write(lenN)
    if cg_slice_rep_has_cap(elem) {
        buf.write(", .cap = ")
        buf.write(lenN)
    }
    buf.write(" }; })")
}

fn emit_zero_of(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, z: checker::TZeroOf, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write("(")
    emit_type(buf, prog, z.element)
    buf.write("){0}")
}

fn emit_array_lit(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, a: checker::TArrayLit, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var elem = match e.type { checker::Slice as s => s.element; _ => panic("codegen: array literal is not a slice type (internal)") }
    if a.elements.len == 0 {
        buf.write("(")
        cg_slice_typename(buf, elem)
        buf.write("){ .ptr = 0, .len = 0 }")
        return
    }
    var has_spread = false
    var si: u64 = 0
    loop {
        if si >= a.elements.len { break }
        if a.elements[si].is_spread { has_spread = true; break }
        si++
    }
    if !has_spread {
        var pN = $"_arr{buf.gensym()}"
        buf.write("({ ")
        emit_type(buf, prog, elem)
        buf.write(" *"); buf.write(pN); buf.write(" = (")
        emit_type(buf, prog, elem)
        buf.write(" *)")
        cb_arena_sym(buf, CgArenaSym::RegionAlloc)
        buf.write("("); buf.write(cg_frame_region(dctx)); buf.write(", ")
        cb_u64_digits(buf, a.elements.len)
        buf.write(" * sizeof(")
        emit_type(buf, prog, elem)
        buf.write(")); ")
        var i: u64 = 0
        loop {
            if i >= a.elements.len { break }
            buf.write(pN); buf.write("["); cb_u64_digits(buf, i); buf.write("] = ")
            emit_as(buf, prog, elem, a.elements[i].expr, escaping, regions, fn_body, dctx)
            buf.write("; ")
            i++
        }
        buf.write("(")
        cg_slice_typename(buf, elem)
        buf.write("){ .ptr = "); buf.write(pN); buf.write(", .len = ")
        cb_u64_digits(buf, a.elements.len)
        if cg_slice_rep_has_cap(elem) {
            buf.write(", .cap = ")
            cb_u64_digits(buf, a.elements.len)
        }
        buf.write(" }; })")
        return
    }
    var tag = buf.gensym()
    var accN = $"_sacc{tag}"
    var totN = $"_stot{tag}"
    var posN = $"_spos{tag}"
    buf.write("({ ")
    cg_array_lit_bind_operands(buf, prog, e, a, elem, tag, escaping, regions, fn_body, dctx)
    cg_array_lit_total(buf, a, totN, tag)
    cg_array_lit_alloc(buf, prog, elem, accN, totN, posN, cg_frame_region(dctx))
    cg_array_lit_fill(buf, a, accN, posN, tag)
    buf.write("(")
    cg_slice_typename(buf, elem)
    buf.write("){ .ptr = "); buf.write(accN); buf.write(", .len = "); buf.write(totN)
    if cg_slice_rep_has_cap(elem) { buf.write(", .cap = "); buf.write(totN) }
    buf.write(" }; })")
}

fn cg_array_plain_count(a: checker::TArrayLit): u64 {
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        if !a.elements[i].is_spread { n = n + 1 }
        i++
    }
    n
}

fn cg_array_lit_bind_operands(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, a: checker::TArrayLit, elem: @Type(), tag: u64, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        var ae = a.elements[i]
        if ae.is_spread {
            cg_slice_typename(buf, elem)
            buf.write(" "); buf.write($"_ssub{tag}_{i}"); buf.write(" = ")
            emit_expr_ctx(buf, prog, checker::Void { }, ae.expr, escaping, regions, fn_body, dctx)
            buf.write("; ")
        } else {
            emit_type(buf, prog, elem)
            buf.write(" "); buf.write($"_sitm{tag}_{i}"); buf.write(" = ")
            emit_as(buf, prog, elem, ae.expr, escaping, regions, fn_body, dctx)
            buf.write("; ")
        }
        i++
    }
}

fn cg_array_lit_total(buf: teko::io::FileStream, a: checker::TArrayLit, totN: str, tag: u64) {
    buf.write("uint64_t "); buf.write(totN); buf.write(" = ")
    cb_u64_digits(buf, cg_array_plain_count(a))
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        if a.elements[i].is_spread {
            buf.write(" + "); buf.write($"_ssub{tag}_{i}"); buf.write(".len")
        }
        i++
    }
    buf.write("; ")
}

fn cg_array_lit_alloc(buf: teko::io::FileStream, prog: CgProg, elem: @Type(), accN: str, totN: str, posN: str, region: str) {
    emit_type(buf, prog, elem)
    buf.write(" *"); buf.write(accN); buf.write(" = (")
    emit_type(buf, prog, elem)
    buf.write(" *)")
    cb_arena_sym(buf, CgArenaSym::RegionAlloc)
    buf.write("("); buf.write(region); buf.write(", "); buf.write(totN); buf.write(" * sizeof(")
    emit_type(buf, prog, elem)
    buf.write(")); uint64_t "); buf.write(posN); buf.write(" = 0; ")
}

fn cg_array_lit_fill(buf: teko::io::FileStream, a: checker::TArrayLit, accN: str, posN: str, tag: u64) {
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        if a.elements[i].is_spread {
            var subN = $"_ssub{tag}_{i}"
            var jN = $"_sj{tag}_{i}"
            buf.write("for (uint64_t "); buf.write(jN); buf.write(" = 0; "); buf.write(jN)
            buf.write(" < "); buf.write(subN); buf.write(".len; "); buf.write(jN); buf.write("++) { ")
            buf.write(accN); buf.write("["); buf.write(posN); buf.write("++] = ")
            buf.write(subN); buf.write(".ptr["); buf.write(jN); buf.write("]; } ")
        } else {
            buf.write(accN); buf.write("["); buf.write(posN); buf.write("++] = ")
            buf.write($"_sitm{tag}_{i}"); buf.write("; ")
        }
        i++
    }
}

fn emit_piece_lit(buf: teko::io::FileStream, piece: str) {
    buf.write("(tk_str){ (const tk_byte *)\"")
    cb_cstr_escaped(buf, piece)
    buf.write("\", ")
    cb_i64(buf, piece.len to i64)
    buf.write(" }")
}

fn fmt_family_takes_prec(fc_low: byte, is_flt: bool): bool {
    if fc_low == 120 { return false }
    if fc_low == 98 { return false }
    if fc_low == 110 && !is_flt { return false }
    true
}
fn emit_interp(buf: teko::io::FileStream, prog: CgProg, in: checker::TInterp, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var nsegs = in.pieces.len + in.holes.len
    var v = $"_is{buf.gensym()}"
    var rgn = cg_frame_region(dctx)
    var crgn = cg_call_region(dctx)
    buf.write($"({{ tk_str *{v} = (tk_str *)")
    cb_arena_sym(buf, CgArenaSym::RegionAlloc)
    buf.write("("); buf.write(rgn); buf.write(", ")
    cb_u64_digits(buf, nsegs)
    buf.write(" * sizeof(tk_str)); ")
    var k: u64 = 0
    loop {
        if k >= nsegs { break }
        buf.write($"{v}[")
        cb_u64_digits(buf, k)
        buf.write("] = ")
        emit_interp_seg(buf, prog, in, k, escaping, regions, fn_body, dctx)
        buf.write("; ")
        k++
    }
    buf.write(cb_fn_name_str("teko::runtime", "concat"))
    buf.write("((")
    cg_slice_typename(buf, checker::Named { name = "teko::base::str" })
    buf.write("){ .ptr = ")
    buf.write(v)
    buf.write(", .len = ")
    cb_u64_digits(buf, nsegs)
    buf.write(", .cap = ")
    cb_u64_digits(buf, nsegs)
    buf.write(" }, "); buf.write(crgn); buf.write("); })")
}

fn emit_interp_seg(buf: teko::io::FileStream, prog: CgProg, in: checker::TInterp, k: u64, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if k % 2 == 0 {
        emit_piece_lit(buf, in.pieces[k / 2])
        return
    }
    var hi = k / 2
    var h = in.holes[hi]
    var rgn = cg_call_region(dctx)
    if hi < in.specs.len {
        var sp = in.specs[hi]
        match sp.kind {
                    checker::TFSpecStatic as fs => {
                        var spec = fs.s
                        var fc0 = if spec.len > 0 { spec[0] } else { 102 to byte }
                        var fc_low = if fc0 >= 65 && fc0 <= 90 { (fc0 to u64 + 32) to byte } else { fc0 }
                        var prec = 0
                        var has_prec = false
                        var si = 1 to u64
                        loop {
                            if si >= spec.len { break }
                            var ch = spec[si]
                            if ch >= 48 && ch <= 57 { prec = prec * 10 + (ch to i64 - 48); has_prec = true }
                            si++
                        }
                        if !has_prec { prec = if fc_low == 100 { 1 } else { 6 } }
                        var is_flt = match h.type { checker::Prim as p => p.kind == checker::PrimKind::F32 || p.kind == checker::PrimKind::F64; _ => false }
                        var prec_str = teko::i64_to_str(prec)
                        if fc_low == 102 { cg_rt_fmt_open(buf, "fmt_f", "double") }
                        else if fc_low == 101 { cg_rt_fmt_open(buf, "fmt_e", "double") }
                        else if fc_low == 103 { cg_rt_fmt_open(buf, "fmt_g", "double") }
                        else if fc_low == 112 { cg_rt_fmt_open(buf, "fmt_p", "double") }
                        else if fc_low == 100 { cg_rt_fmt_open(buf, "fmt_d", "int64_t") }
                        else if fc_low == 120 && spec.len > 0 && spec[0] == 88 { cg_rt_fmt_open(buf, "fmt_x_upper", "uint64_t") }
                        else if fc_low == 120 { cg_rt_fmt_open(buf, "fmt_x_lower", "uint64_t") }
                        else if fc_low == 98 { cg_rt_fmt_open(buf, "fmt_b", "uint64_t") }
                        else if fc_low == 110 && is_flt { cg_rt_fmt_open(buf, "fmt_n_f", "double") }
                        else if fc_low == 110 { cg_rt_fmt_open(buf, "fmt_n_i", "int64_t") }
                        else { panic("codegen: unrecognized format spec") }
                        emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
                        if fmt_family_takes_prec(fc_low, is_flt) {
                            buf.write("), ")
                            buf.write(prec_str)
                            buf.write(", "); buf.write(rgn); buf.write(")")
                        } else {
                            buf.write("), "); buf.write(rgn); buf.write(")")
                        }
                    }
                    checker::TFSpecDynamic as fd => {
                        var is_flt = match h.type { checker::Prim as p => p.kind == checker::PrimKind::F32 || p.kind == checker::PrimKind::F64; _ => false }
                        var is_sint = match h.type { checker::Prim as p => cg_prim_is_signed_int(p.kind); _ => false }
                        if is_flt { cg_rt_fmt_open(buf, "fmt_dyn_f64", "double") }
                        else if is_sint { cg_rt_fmt_open(buf, "fmt_dyn_i64", "int64_t") }
                        else { cg_rt_fmt_open(buf, "fmt_dyn_u64", "uint64_t") }
                        emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
                        buf.write("), ")
                        emit_expr_ctx(buf, prog, checker::Void { }, fd.args[0], escaping, regions, fn_body, dctx)
                        buf.write(", "); buf.write(rgn); buf.write(")")
                    }
                    _ => {
                        match h.type {
                            checker::Char => { emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) }
                            checker::Prim as p => {
                                if p.kind == checker::PrimKind::Bool {
                                    buf.write("(")
                                    emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
                                    buf.write(" ? (tk_str){ (const tk_byte *)\"true\", 4 } : (tk_str){ (const tk_byte *)\"false\", 5 })")
                                } else if p.kind == checker::PrimKind::F32 || p.kind == checker::PrimKind::F64 {
                                    cg_rt_fmt_open(buf, "ftoa", "double")
                                    emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
                                    buf.write("), "); buf.write(rgn); buf.write(")")
                                } else if cg_prim_is_signed_int(p.kind) {
                                    cg_rt_fmt_open(buf, "i64_to_str", "int64_t")
                                    emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
                                    buf.write("), "); buf.write(rgn); buf.write(")")
                                } else {
                                    cg_rt_fmt_open(buf, "u64_to_str", "uint64_t")
                                    emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
                                    buf.write("), "); buf.write(rgn); buf.write(")")
                                }
                            }
                            checker::Byte => {
                                cg_rt_fmt_open(buf, "u64_to_str", "uint64_t")
                                emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
                                buf.write("), "); buf.write(rgn); buf.write(")")
                            }
                            checker::Error => {
                                buf.write("(")
                                emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
                                buf.write(").message")
                            }
                            _ => if cg_is_str_type(h.type) { emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) } else { panic("codegen: interpolation hole type not supported") }
                        }
                    }
        }
        return
    }
    match h.type {
        checker::Char => { emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) }
        checker::Prim as p => {
            if p.kind == checker::PrimKind::Bool {
                buf.write("(")
                emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
                buf.write(" ? (tk_str){ (const tk_byte *)\"true\", 4 } : (tk_str){ (const tk_byte *)\"false\", 5 })")
            } else if p.kind == checker::PrimKind::F32 || p.kind == checker::PrimKind::F64 {
                cg_rt_fmt_open(buf, "ftoa", "double")
                emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
                buf.write("), "); buf.write(rgn); buf.write(")")
            } else if cg_prim_is_signed_int(p.kind) {
                cg_rt_fmt_open(buf, "i64_to_str", "int64_t")
                emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
                buf.write("), "); buf.write(rgn); buf.write(")")
            } else {
                cg_rt_fmt_open(buf, "u64_to_str", "uint64_t")
                emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
                buf.write("), "); buf.write(rgn); buf.write(")")
            }
        }
        checker::Byte => {
            cg_rt_fmt_open(buf, "u64_to_str", "uint64_t")
            emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
            buf.write("), "); buf.write(rgn); buf.write(")")
        }
        checker::Error => {
            buf.write("(")
            emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx)
            buf.write(").message")
        }
        _ => if cg_is_str_type(h.type) { emit_expr_ctx(buf, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) } else { panic("codegen: interpolation hole type not supported") }
    }
}

fn cg_find_struct_field_type(prog: CgProg, sname: str, fname: str): @TypeExpr() | null {
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => {
                if d.name == sname || checker::name_last_segment(d.name) == checker::name_last_segment(sname) {
                    match d.body {
                        parser::StructBody as sb => {
                            var j = 0
                            loop {
                                if j >= sb.fields.len { break }
                                if sb.fields[j].name == fname { return sb.fields[j].type_ann }
                                j++
                            }
                        }
                        parser::ClassBody as cb2 => {
                            var table = cg_type_table(prog)
                            var fields = match checker::effective_class_fields(cb2, table) { []parser::Field as fs => fs; error => return null }
                            var j = 0
                            loop {
                                if j >= fields.len { break }
                                if fields[j].name == fname { return fields[j].type_ann }
                                j++
                            }
                        }
                        parser::ExternStructBody as esb => {
                            var j = 0
                            loop {
                                if j >= esb.fields.len { break }
                                if esb.fields[j].name == fname { return esb.fields[j].type_ann }
                                j++
                            }
                        }
                        _ => { }
                    }
                }
            }
            _ => { }
        }
        i++
    }
}

fn emit_struct_init(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, si: checker::TStructInit, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    return emit_struct_init_framed(buf, prog, e, si, "", escaping, regions, fn_body, dctx)
}

fn emit_struct_init_framed(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, si: checker::TStructInit, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var is_class = match e.type {
        checker::Named as nm => cg_is_class_named(prog, nm.name)
        _ => false
    }
    if is_class {
        var id = buf.gensym() to i64
        var rN = fresh_named("_clsr", id)
        var pN = fresh_named("_clsp", id)
        buf.write("({ tk_region *")
        buf.write(rN)
        buf.write(" = "); cb_arena_sym(buf, CgArenaSym::RegionNew); buf.write("(")
        buf.write(cg_alloc_region(regions, dctx))
        buf.write("); ")
        match e.type { checker::Named as nm => mangle_type_name(buf, "", nm.name); _ => { } }
        buf.write(" *")
        buf.write(pN)
        buf.write(" = "); cb_arena_sym(buf, CgArenaSym::RegionAlloc); buf.write("(")
        buf.write(rN)
        buf.write(", sizeof(*")
        buf.write(pN)
        buf.write(")); *")
        buf.write(pN)
        buf.write(" = ")
        emit_struct_init_literal(buf, prog, e, si, frame, escaping, regions, fn_body, dctx)
        buf.write("; ")
        buf.write(pN)
        buf.write("->__region = ")
        buf.write(rN)
        buf.write("; ")
        buf.write(pN)
        buf.write("; })")
        return
    }
    emit_struct_init_literal(buf, prog, e, si, frame, escaping, regions, fn_body, dctx)
}

fn emit_struct_init_literal(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, si: checker::TStructInit, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var name = match e.type {
        checker::Named as nm => nm.name
        checker::Error => {
            if si.field_vals.len != 1 { panic("codegen: error value must have exactly the `message` field (internal)") }
            buf.write("tk_error_make(")
            emit_expr_ctx(buf, prog, checker::Void { }, si.field_vals[0], escaping, regions, fn_body, dctx)
            buf.write(")")
            return
        }
        _ => panic("codegen: struct literal with a non-named type not yet supported")
    }
    buf.write("(")
    match cg_extern_native_tag(prog, name) {
        str as tag => { buf.write("struct "); buf.write(tag) }
        null => mangle_type_name(buf, "", name)
    }
    buf.write("){ ")
    var i = 0
    loop {
        if i >= si.field_names.len { break }
        if i > 0 { buf.write(", ") }
        buf.write(".")
        buf.write(si.field_names[i])
        buf.write(" = ")
        var fv = si.field_vals[i]
        var fte_opt = cg_find_struct_field_type(prog, name, si.field_names[i])
        var boxed = match fte_opt {
            (@TypeExpr()) as fte => cg_field_boxed(prog, name, fte)
            null => false
        }
        var bxid = buf.gensym() to i64
        var bxN = fresh_named("_bx", bxid)
        if boxed {
            buf.write("({ ")
            match fte_opt { (@TypeExpr()) as fte => { emit_type_expr(buf, prog, fte, checker::name_qualifier(name)) }; null => { } }
            buf.write(" *"); buf.write(bxN)
            if frame.len > 0 {
                buf.write(" = "); cb_arena_sym(buf, CgArenaSym::RegionAlloc); buf.write("("); buf.write(frame); buf.write(", sizeof *"); buf.write(bxN); buf.write("); *"); buf.write(bxN); buf.write(" = ")
            } else {
                buf.write(" = "); cb_arena_sym(buf, CgArenaSym::Alloc); buf.write("(sizeof *"); buf.write(bxN); buf.write("); *"); buf.write(bxN); buf.write(" = ")
            }
        }
        var emitted: bool = match fv.kind {
            checker::TNullLit => false
            _ => match fv.type {
                checker::Slice as sl => match sl.element {
                    checker::Void => {
                        match fte_opt {
                            (@TypeExpr()) as fte => match fte {
                                parser::SliceType as st => {
                                    buf.write("(")
                                    emit_type_expr(buf, prog, fte, checker::name_qualifier(name))
                                    buf.write("){ .ptr = 0, .len = 0 }")
                                    true
                                }
                                _ => false
                            }
                            null => false
                        }
                    }
                    _ => false
                }
                _ => false
            }
        }
        if !emitted {
            var exp_t: @Type() = checker::Void { }
            match fte_opt {
                (@TypeExpr()) as fte => match fte {
                    parser::NamedType as nt => { exp_t = checker::Named { name = cg_canon_name_ns(prog, nt.path, checker::name_qualifier(name)) } }
                    parser::SliceType as st => match st.element {
                        parser::NamedType as ent => {
                            var elem = ent.path.segments[ent.path.segments.len - 1].name
                            if !cg_is_prim_name(elem) { exp_t = checker::Slice { element = checker::Named { name = cg_canon_name_ns(prog, ent.path, checker::name_qualifier(name)) } } }
                        }
                        _ => { }
                    }
                    parser::UnionType as ut => match cg_te_to_type_ns(prog, checker::name_qualifier(name), parser::UnionType { members = ut.members }) {
                        checker::Variant as va => { exp_t = checker::Variant { members = va.members } }
                        _ => { }
                    }
                    _ => { }
                }
                null => { }
            }
            match exp_t {
                checker::Void => { emit_expr_ctx(buf, prog, checker::Void { }, fv, escaping, regions, fn_body, dctx) }
                _ => { emit_as_r_in(buf, prog, checker::Void { }, exp_t, fv, frame, escaping, regions, fn_body, dctx) }
            }
        }
        if boxed { buf.write("; "); buf.write(bxN); buf.write("; })") }
        i++
    }
    buf.write(" }")
}

fn emit_strlit(buf: teko::io::FileStream, s: checker::TStrLit) {
    buf.write("(tk_str){ (const tk_byte *)\"")
    cb_cstr_escaped(buf, s.text)
    buf.write("\", ")
    cb_i64(buf, s.text.len to i64)
    buf.write(" }")
}

fn emit_bytestrlit(buf: teko::io::FileStream, s: checker::TByteStrLit) {
    buf.write("(tk_slice_byte){ (tk_byte *)\"")
    cb_cstr_escaped(buf, s.text)
    buf.write("\", ")
    cb_i64(buf, s.text.len to i64)
    buf.write(" }")
}

fn emit_charlit(buf: teko::io::FileStream, ch: checker::TCharLit) {
    buf.write("(tk_char){ (uint8_t *)\"")
    cb_cstr_escaped(buf, ch.bytes)
    buf.write("\", ")
    cb_i64(buf, ch.bytes.len to i64)
    buf.write(" }")
}

fn is_void_type(t: @Type()): bool {
    match t { checker::Void => true; _ => false }
}

fn fresh_tmp_name(buf_len: i64): str {
    teko::str::concat("_tk", teko::i64_to_str(buf_len))
}

fn emit_stmt_value(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), s: @TStatement(), slot: @Type(), sink: str, indent: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement()) {
    match s {
        checker::TReturn => panic("codegen: control flow inside an `if` used as a sub-expression not yet supported")
        checker::TBreakStmt => panic("codegen: control flow inside an `if` used as a sub-expression not yet supported")
        checker::TContinueStmt => panic("codegen: control flow inside an `if` used as a sub-expression not yet supported")
        checker::TExprStmt as es => {
            if is_void_type(es.expr.type) {
                return emit_stmt(buf, s, false, prog, ret_type, indent, "", escaping, regions, fn_body, dctx, cur_block, true)
            }
            emit_cov_lines(buf, dctx.cov, cov_collect_expr(es.expr, []), indent)
            buf.write(indent)
            buf.write(sink)
            buf.write(" = ")
            emit_as_r(buf, prog, ret_type, slot, es.expr, escaping, regions, fn_body, dctx)
            buf.write(";\n")
        }
        _ => emit_stmt(buf, s, false, prog, ret_type, indent, "", escaping, regions, fn_body, dctx, cur_block, true)
    }
}

fn emit_branch_value(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), body: []@TStatement(), slot: @Type(), sink: str, indent: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var want_block = cg_block_has_block_local(prog, escaping, fn_body, body, true) && regions.len < 64 && checker::scope_slot_count(body) > 0
    if !want_block {
        var defer_floor = dctx.defers.len
        var cur = dctx
        var i = 0
        loop {
            if i + 1 >= body.len { break }
            match body[i] {
                checker::TDeferStmt => { cur = dctx_register(cur, body[i]) }
                _ => { emit_stmt(buf, body[i], false, prog, ret_type, indent, "", escaping, regions, fn_body, cur, [], false) }
            }
            i++
        }
        if body.len > 0 {
            emit_stmt_value(buf, prog, ret_type, body[body.len - 1], slot, sink, indent, escaping, regions, fn_body, cur, [])
        }
        if cur.defers.len > defer_floor {
            emit_defers(buf, cur.defers, defer_floor, prog, indent, escaping, fn_body)
        }
        return
    }
    var defer_floor = dctx.defers.len
    var fall = cg_append_direct_defers(dctx.defers, body)
    var region = fresh_named("_tkbr", buf.gensym() to i64)
    buf.write(indent); buf.write("tk_region *"); buf.write(region); buf.write(" = "); cb_region_open(buf, cg_alloc_region(regions, dctx), body); buf.write(";\n")
    var regs2 = [..regions, RegionFrame { name = region; label = ""; is_loop = false; defer_base = defer_floor; decls = cg_block_slice_accums(prog, escaping, fn_body, body, true); bound_names = cg_block_bound_names(body) }]
    var cur = dctx
    var i = 0
    loop {
        if i + 1 >= body.len { break }
        match body[i] {
            checker::TDeferStmt => { cur = dctx_register(cur, body[i]) }
            _ => { emit_stmt(buf, body[i], false, prog, ret_type, indent, "", escaping, regs2, fn_body, cur, body, true) }
        }
        i++
    }
    if body.len > 0 {
        emit_stmt_value(buf, prog, ret_type, body[body.len - 1], slot, sink, indent, escaping, regs2, fn_body, cur, body)
    }
    emit_defers(buf, fall, defer_floor, prog, indent, escaping, fn_body)
    buf.write(indent); cb_arena_sym(buf, CgArenaSym::RegionDrop); buf.write("("); buf.write(region); buf.write("); "); buf.write(region); buf.write(" = NULL;\n")
}

fn emit_if_value(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), e: checker::TExpr, f: checker::TIfExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if !f.has_else { panic("codegen: if-without-else used as a value not yet supported") }
    var tmp = fresh_tmp_name(buf.gensym() to i64)
    buf.write("({ ")
    emit_type(buf, prog, e.type)
    buf.write(" ")
    buf.write(tmp)
    buf.write("; if (")
    emit_expr_ctx(buf, prog, checker::Void { }, f.cond, escaping, regions, fn_body, dctx)
    buf.write(") {\n")
    emit_cov_branch(buf, dctx.cov, e.line, e.col, 0, "    ")
    emit_branch_value(buf, prog, ret_type, f.then_blk, e.type, tmp, "    ", escaping, regions, fn_body, dctx)
    buf.write("} else {\n")
    emit_cov_branch(buf, dctx.cov, e.line, e.col, 1, "    ")
    emit_branch_value(buf, prog, ret_type, f.else_blk, e.type, tmp, "    ", escaping, regions, fn_body, dctx)
    buf.write("} ")
    buf.write(tmp)
    buf.write("; })")
}

fn fresh_named(prefix: str, n: i64): str {
    teko::str::concat(prefix, teko::i64_to_str(n))
}

fn cg_var_nmem(prog: CgProg, v: @Type()): i64 {
    match v {
        checker::Variant as va => va.members.len to i64
        checker::Named as nm => match cg_find_variant_decl(prog, nm.name) {
            parser::TypeDecl as d => match d.body {
                parser::VariantBody as vb => match vb.type_expr {
                    parser::UnionType as u => u.members.len to i64
                    _ => 0
                }
                _ => 0
            }
            error => 0
        }
        _ => 0
    }
}

fn cg_var_mkey(prog: CgProg, v: @Type(), i: i64): str | error {
    match v {
        checker::Variant as va => cg_member_key_str(va.members[i])
        checker::Named as nm => {
            var vd = match cg_find_variant_decl(prog, nm.name) { parser::TypeDecl as d => d; error as e => return e }
            var members = match vd.body {
                parser::VariantBody as vb => match vb.type_expr { parser::UnionType as u => u.members; _ => return error { message = "codegen: cg_var_mkey on a non-union variant body (internal)" } }
                _ => return error { message = "codegen: cg_var_mkey on a non-variant decl (internal)" }
            }
            cg_member_key_texpr_str(prog, members[i], checker::name_qualifier(nm.name))
        }
        _ => error { message = "codegen: cg_var_mkey on a non-variant type (internal)" }
    }
}

fn cg_var_mkey_bare(prog: CgProg, v: @Type(), i: i64): str | error {
    match v {
        checker::Variant as va => cg_member_bare_key(va.members[i])
        checker::Named as nm => {
            var vd = match cg_find_variant_decl(prog, nm.name) { parser::TypeDecl as d => d; error as e => return e }
            var members = match vd.body {
                parser::VariantBody as vb => match vb.type_expr { parser::UnionType as u => u.members; _ => return error { message = "codegen: cg_var_mkey_bare on a non-union variant body (internal)" } }
                _ => return error { message = "codegen: cg_var_mkey_bare on a non-variant decl (internal)" }
            }
            cg_member_key_texpr_bare_str(members[i])
        }
        _ => error { message = "codegen: cg_var_mkey_bare on a non-variant type (internal)" }
    }
}

fn cg_case_key_qualified(prog: CgProg, variantT: @Type(), pat: @Pattern()): str | error {
    var bare = match cg_emit_case_key_str(pat) { str as s => s; error as e => return e }
    var n = cg_var_nmem(prog, variantT)
    var i = 0
    loop {
        if i >= n { break }
        var mb = match cg_var_mkey_bare(prog, variantT, i) { str as s => s; error => "" }
        if mb == bare { return cg_var_mkey(prog, variantT, i) }
        i++
    }
    bare
}

fn cg_var_mtype(prog: CgProg, v: @Type(), i: i64): @Type() {
    match v {
        checker::Variant as va => va.members[i]
        checker::Named as nm => {
            var vd = match cg_find_variant_decl(prog, nm.name) { parser::TypeDecl as d => d; error => return checker::Void { } }
            var members = match vd.body {
                parser::VariantBody as vb => match vb.type_expr { parser::UnionType as u => u.members; _ => return checker::Void { } }
                _ => return checker::Void { }
            }
            match members[i] {
                parser::NamedType as nt => checker::Named { name = cg_canon_name(prog, nt.path.segments[nt.path.segments.len - 1].name) }
                _ => checker::Void { }
            }
        }
        _ => checker::Void { }
    }
}

fn cg_is_variant_type(prog: CgProg, mt: @Type()): bool {
    match mt {
        checker::Variant => true
        checker::Named as nm => cg_named_is_variant(prog, nm.name)
        _ => false
    }
}

fn cg_member_reached_via_subclass(prog: CgProg, mt: @Type(), vkey: str): bool {
    match mt {
        checker::Named as mn => cg_is_polymorphic_base(prog, mn.name) && vkey != mn.name && cg_is_class_named(prog, vkey) && cg_subclass_reaches(prog, vkey, mn.name, SUBCLASS_CHAIN_DEPTH_LIMIT)
        _ => false
    }
}

fn cg_var_reaches(prog: CgProg, v: @Type(), vkey: str, depth: i64): bool {
    if depth <= 0 { return false }
    var n = cg_var_nmem(prog, v)
    var i = 0
    loop {
        if i >= n { break }
        var k = match cg_var_mkey(prog, v, i) { str as s => s; error => "" }
        if k == vkey { return true }
        var mt = cg_var_mtype(prog, v, i)
        if cg_is_variant_type(prog, mt) {
            if cg_var_reaches(prog, mt, vkey, depth - 1) { return true }
        }
        if cg_member_reached_via_subclass(prog, mt, vkey) { return true }
        i++
    }
    false
}

fn cg_var_reaches_exact(prog: CgProg, v: @Type(), vkey: str, depth: i64): bool {
    if depth <= 0 { return false }
    var n = cg_var_nmem(prog, v)
    var i = 0
    loop {
        if i >= n { break }
        var k = match cg_var_mkey(prog, v, i) { str as s => s; error => "" }
        if k == vkey { return true }
        var mt = cg_var_mtype(prog, v, i)
        if cg_is_variant_type(prog, mt) {
            if cg_var_reaches_exact(prog, mt, vkey, depth - 1) { return true }
        }
        i++
    }
    false
}

fn cg_narrow_variant_widens_into(prog: CgProg, from: @Type(), to: @Type()): bool {
    if !cg_is_variant_type(prog, to) { return false }
    var n = cg_var_nmem(prog, from)
    if n == 0 { return false }
    var i = 0
    loop {
        if i >= n { break }
        var mk = match cg_var_mkey(prog, from, i) { str as s => s; error => return false }
        if !cg_var_reaches(prog, to, mk, 16) { return false }
        i++
    }
    true
}

fn cg_wrap_open(buf: teko::io::FileStream, v: @Type(), mkey: str) {
    match v {
        checker::Variant as va => {
            buf.write("(")
            cg_variant_typename(buf, va)
            buf.write("){ .tag = TK_TAG_U")
            var j = 0
            loop {
                if j >= va.members.len { break }
                buf.write("_")
                var kj = match cg_member_key_str(va.members[j]) { str as s => s; error as err => panic(err.message) }
                cb_upper(buf, kj)
                j++
            }
            buf.write("_")
            cb_upper(buf, mkey)
            buf.write(", .as.")
            buf.write(mkey)
            buf.write(" = ")
        }
        checker::Named as nm => {
            buf.write("(")
            mangle_type_name(buf, "", nm.name)
            buf.write("){ .tag = TK_TAG_")
            cb_upper(buf, cg_ns_c_key(nm.name))
            buf.write("_")
            cb_upper(buf, mkey)
            buf.write(", .as.")
            buf.write(mkey)
            buf.write(" = ")
        }
        _ => panic("codegen: cg_wrap_open on a non-variant type (internal)")
    }
}

/**
 * Open a union-member wrapper, choosing the representation. For `TagPtr` this emits the compound
 * literal `(<wrapper>){ .tag = ..., .payload = ({ <MT> *_ubx = tk_region_alloc(...); *_ubx = ` and
 * returns the box-variable name to close with; otherwise it defers to `cg_wrap_open` and returns "".
 *
 * @param prog     the program under codegen
 * @param buf      the output stream
 * @param expected the variant type being constructed
 * @param mkey     the C key of the member the value fills
 * @return         the fresh box-variable name for `TagPtr`, or "" for the inline path
 */
fn cg_wrap_open_r(buf: teko::io::FileStream, prog: CgProg, expected: @Type(), mkey: str, region: str): str {
    if !cg_variant_repr_is_tagptr(prog, expected) {
        cg_wrap_open(buf, expected, mkey)
        return ""
    }
    var va = match expected { checker::Variant as v => v; _ => panic("codegen: cg_wrap_open_r TagPtr on a non-variant (internal)") }
    var mt = match cg_variant_member_type_of_key(prog, expected, mkey) { (@Type()) as t => t; null => checker::Void { } }
    var bxN = fresh_named("_ubx", buf.gensym() to i64)
    buf.write("(")
    cg_variant_typename(buf, va)
    buf.write("){ .tag = TK_TAG_U")
    var j = 0
    loop {
        if j >= va.members.len { break }
        buf.write("_")
        var kj = match cg_member_key_str(va.members[j]) { str as s => s; error as err => panic(err.message) }
        cb_upper(buf, kj)
        j++
    }
    buf.write("_")
    cb_upper(buf, mkey)
    buf.write(", .payload = ({ ")
    emit_type(buf, prog, mt)
    buf.write(" *")
    buf.write(bxN)
    buf.write(" = ")
    cb_arena_sym(buf, CgArenaSym::RegionAlloc)
    buf.write("(")
    buf.write(region)
    buf.write(", sizeof(")
    emit_type(buf, prog, mt)
    buf.write(")); *")
    buf.write(bxN)
    buf.write(" = ")
    bxN
}

/**
 * Close a wrapper opened by `cg_wrap_open_r`. For `TagPtr` this finishes the boxed payload
 * statement-expression and the `.len` field; otherwise it emits the plain `}`.
 *
 * @param prog     the program under codegen
 * @param buf      the output stream
 * @param expected the variant type being constructed
 * @param bxN      the box-variable name returned by `cg_wrap_open_r` (empty for the inline path)
 */
fn cg_wrap_close_r(buf: teko::io::FileStream, prog: CgProg, expected: @Type(), bxN: str) {
    if !cg_variant_repr_is_tagptr(prog, expected) {
        buf.write(" }")
        return
    }
    buf.write("; ")
    buf.write(bxN)
    buf.write("; }), .len = 0 }")
}

fn emit_variant_wrap(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    match expected {
        checker::Variant as bva => match cg_union_box_member(prog, bva) {
            (@Type()) as bx => {
                match value.kind {
                    checker::TNullLit => { buf.write("0"); return }
                    _ => {
                        if cg_mangle_eq(expected, value.type) { emit_expr_ret(buf, prog, ret_type, value); return }
                        cg_emit_box_construct(buf, prog, ret_type, bx, value, "", escaping, regions, fn_body, dctx)
                        return
                    }
                }
            }
            null => { }
        }
        _ => { }
    }
    var vkey = match cg_member_key_str(value.type) { str as s => s; error => "" }
    var n = cg_var_nmem(prog, expected)
    if emit_variant_wrap_exact_pass(buf, prog, ret_type, expected, value, vkey, n, cg_frame_region(dctx)) { return }
    if emit_variant_wrap_widen_pass(buf, prog, ret_type, expected, value, vkey, n, escaping, regions, fn_body, dctx) { return }
    if emit_variant_wrap_transitive_pass(buf, prog, ret_type, expected, value, vkey, n, escaping, regions, fn_body, dctx) { return }
    panic("codegen: emit_variant_wrap on an unreachable case (internal — caller must guard with cg_var_reaches)")
}

fn emit_variant_wrap_exact_pass(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, vkey: str, n: i64, region: str): bool {
    var i = 0
    loop {
        if i >= n { break }
        var mk = match cg_var_mkey(prog, expected, i) { str as s => s; error => "" }
        if mk == vkey {
            var bx = cg_wrap_open_r(buf, prog, expected, vkey, region)
            emit_expr_ret(buf, prog, ret_type, value)
            cg_wrap_close_r(buf, prog, expected, bx)
            return true
        }
        i++
    }
    false
}

fn emit_variant_wrap_widen_pass(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, vkey: str, n: i64, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): bool {
    var w = 0
    loop {
        if w >= n { break }
        var wmt = cg_var_mtype(prog, expected, w)
        if cg_member_reached_via_subclass(prog, wmt, vkey) {
            var wmk = match cg_var_mkey(prog, expected, w) { str as s => s; error => "" }
            var bx = cg_wrap_open_r(buf, prog, expected, wmk, cg_frame_region(dctx))
            emit_as_r(buf, prog, ret_type, wmt, value, escaping, regions, fn_body, dctx)
            cg_wrap_close_r(buf, prog, expected, bx)
            return true
        }
        w++
    }
    false
}

fn emit_variant_wrap_transitive_pass(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, vkey: str, n: i64, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): bool {
    var j = 0
    loop {
        if j >= n { break }
        var mt = cg_var_mtype(prog, expected, j)
        if cg_is_variant_type(prog, mt) {
            if cg_var_reaches(prog, mt, vkey, 16) {
                var mk = match cg_var_mkey(prog, expected, j) { str as s => s; error => "" }
                var bx = cg_wrap_open_r(buf, prog, expected, mk, cg_frame_region(dctx))
                emit_variant_wrap(buf, prog, ret_type, mt, value, escaping, regions, fn_body, dctx)
                cg_wrap_close_r(buf, prog, expected, bx)
                return true
            }
        }
        j++
    }
    false
}

fn emit_variant_wrap_str(buf: teko::io::FileStream, prog: CgProg, expected: @Type(), vtype: @Type(), cexpr: str, region: str) {
    var vkey = match cg_member_key_str(vtype) { str as s => s; error => "" }
    var n = cg_var_nmem(prog, expected)
    var i = 0
    loop {
        if i >= n { break }
        var mk = match cg_var_mkey(prog, expected, i) { str as s => s; error => "" }
        if mk == vkey {
            var bx = cg_wrap_open_r(buf, prog, expected, vkey, region)
            buf.write(cexpr)
            cg_wrap_close_r(buf, prog, expected, bx)
            return
        }
        i++
    }
    var j = 0
    loop {
        if j >= n { break }
        var mt = cg_var_mtype(prog, expected, j)
        if cg_is_variant_type(prog, mt) {
            if cg_var_reaches(prog, mt, vkey, 16) {
                var mk = match cg_var_mkey(prog, expected, j) { str as s => s; error => "" }
                var bx = cg_wrap_open_r(buf, prog, expected, mk, region)
                emit_variant_wrap_str(buf, prog, mt, vtype, cexpr, region)
                cg_wrap_close_r(buf, prog, expected, bx)
                return
            }
        }
        j++
    }
    panic("codegen: emit_variant_wrap_str on an unreachable case (internal — caller must guard with cg_var_reaches)")
}

fn cg_emit_union_present_str(buf: teko::io::FileStream, prog: CgProg, uni: @Type(), mem: @Type(), cexpr: str, region: str) {
    var va = match uni { checker::Variant as v => v; _ => { buf.write(cexpr); return } }
    match cg_union_niche_member(prog, va) {
        (@Type()) as _gt9 => { buf.write(cexpr); return }
        null => { }
    }
    emit_variant_wrap_str(buf, prog, uni, mem, cexpr, region)
}

fn cg_emit_ffi_ures(buf: teko::io::FileStream, prog: CgProg, result_ty: @Type(), ures_tmp: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var nulllit = checker::TExpr { kind = checker::TNullLit { }; type = result_ty; line = 0; col = 0 }
    buf.write(ures_tmp)
    buf.write(".ok ? ")
    emit_as_r(buf, prog, result_ty, result_ty, nulllit, escaping, regions, fn_body, dctx)
    buf.write(" : ")
    var errcexpr = teko::str::concat("tk_error_make(", ures_tmp, ".err)")
    cg_emit_union_present_str(buf, prog, result_ty, checker::Error { }, errcexpr, cg_frame_region(dctx))
}

fn cg_wrap_elem_str(buf: teko::io::FileStream, prog: CgProg, expected: @Type(), vtype: @Type(), cexpr: str, region: str) {
    match expected {
        checker::Named as en => {
            if cg_wrap_elem_str_contract(buf, prog, en, vtype, cexpr) { return }
        }
        _ => { }
    }
    var ukey = match cg_member_key_str(vtype) { str as s => s; error => "" }
    var wrappable = match expected {
        checker::Variant => ukey != "" && cg_var_reaches_exact(prog, expected, ukey, 16)
        checker::Named => ukey != "" && cg_var_reaches_exact(prog, expected, ukey, 16)
        _ => false
    }
    if wrappable {
        emit_variant_wrap_str(buf, prog, expected, vtype, cexpr, region)
        return
    }
    buf.write(cexpr)
}

fn cg_wrap_elem_str_contract(buf: teko::io::FileStream, prog: CgProg, en: checker::Named, vtype: @Type(), cexpr: str): bool {
    if !(cg_is_interface_named(prog, en.name) || cg_is_trait_named(prog, en.name)) { return false }
    match vtype {
        checker::Named as vn => {
            if !cg_is_class_named(prog, vn.name) { return false }
            buf.write("(")
            mangle_type_name(buf, "", en.name)
            buf.write("){ .data = (void *)(")
            buf.write(cexpr)
            buf.write("), .vtable = tk_vt_")
            cb_tysym(buf, vn.name)
            buf.write("_")
            cb_tysym(buf, en.name)
            buf.write(" }")
            true
        }
        _ => false
    }
}

fn emit_host_ffi(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, c: checker::TCall, kind: str, rtfn: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var t = $"_h{buf.gensym()}"
    var str_t = checker::Named { name = "teko::base::str" }
    var err_t = checker::Error { }

    if kind == "args" {
        buf.write("({ uint64_t ")
        buf.write(t)
        buf.write("n; tk_str *")
        buf.write(t)
        buf.write("p = ")
        buf.write(rtfn)
        buf.write("(&")
        buf.write(t)
        buf.write("n); (")
        cg_slice_typename(buf, str_t)
        buf.write("){ .ptr = ")
        buf.write(t)
        buf.write("p, .len = ")
        buf.write(t)
        buf.write("n }; })")
        return
    }
    if kind == "bytes" {
        var byte_t = checker::Byte { }
        buf.write("({ tk_ffi_bytes ")
        buf.write(t)
        buf.write(" = ")
        buf.write(rtfn)
        buf.write("(")
        emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
        buf.write(", ")
        emit_expr_ctx(buf, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx)
        buf.write("); (")
        cg_slice_typename(buf, byte_t)
        buf.write("){ .ptr = ")
        buf.write(t)
        buf.write(".ptr, .len = ")
        buf.write(t)
        buf.write(".len }; })")
        return
    }
    if kind == "run" {
        buf.write("({ ")
        cg_slice_typename(buf, str_t)
        buf.write(" ")
        buf.write(t)
        buf.write(" = ")
        emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
        buf.write("; ")
        buf.write(rtfn)
        buf.write("(")
        buf.write(t)
        buf.write(".ptr, ")
        buf.write(t)
        buf.write(".len); })")
        return
    }

    if kind == "ures_byteslice" {
        var byte_t = checker::Byte { }
        buf.write("({ ")
        cg_slice_typename(buf, byte_t)
        buf.write(" ")
        buf.write(t)
        buf.write("s = ")
        emit_expr_ctx(buf, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx)
        buf.write("; tk_ffi_ures ")
        buf.write(t)
        buf.write("r = ")
        buf.write(rtfn)
        buf.write("(")
        emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
        buf.write(", ")
        buf.write(t)
        buf.write("s.ptr, (uint64_t)")
        buf.write(t)
        buf.write("s.len); ")
        cg_emit_ffi_ures(buf, prog, e.type, teko::str::concat(t, "r"), escaping, regions, fn_body, dctx)
        buf.write("; })")
        return
    }

    if kind == "sres_byteslice" {
        var byte_t = checker::Byte { }
        buf.write("({ ")
        cg_slice_typename(buf, byte_t)
        buf.write(" ")
        buf.write(t)
        buf.write("s = ")
        emit_expr_ctx(buf, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx)
        buf.write("; tk_ffi_sres ")
        buf.write(t)
        buf.write("r = ")
        buf.write(rtfn)
        buf.write("(")
        buf.write(t)
        buf.write("s.ptr, (uint64_t)")
        buf.write(t)
        buf.write("s.len); ")
        buf.write(t)
        buf.write("r.ok ? ")
        emit_variant_wrap_str(buf, prog, e.type, str_t, $"{t}r.value", cg_frame_region(dctx))
        buf.write(" : ")
        emit_variant_wrap_str(buf, prog, e.type, err_t, teko::str::concat("tk_error_make(", $"{t}r", ".err)"), cg_frame_region(dctx))
        buf.write("; })")
        return
    }

    var resty = if kind == "sres" { "tk_ffi_sres" } else if kind == "ures" { "tk_ffi_ures" } else if kind == "slres" { "tk_ffi_slres" } else { "tk_ffi_u64res" }
    buf.write("({ ")
    buf.write(resty)
    buf.write(" ")
    buf.write(t)
    buf.write(" = ")
    buf.write(rtfn)
    buf.write("(")
    var i: u64 = 0
    loop {
        if i >= c.args.len { break }
        if i > 0 { buf.write(", ") }
        emit_expr_ctx(buf, prog, checker::Void { }, c.args[i], escaping, regions, fn_body, dctx)
        i++
    }
    buf.write("); ")

    if kind == "ures" {
        cg_emit_ffi_ures(buf, prog, e.type, t, escaping, regions, fn_body, dctx)
        buf.write("; })")
        return
    }

    buf.write(t)
    buf.write(".ok ? ")
    if kind == "sres" {
        emit_variant_wrap_str(buf, prog, e.type, str_t, $"{t}.value", cg_frame_region(dctx))
    } else if kind == "u64res" {
        emit_variant_wrap_str(buf, prog, e.type, checker::Prim { kind = checker::PrimKind::U64 }, $"{t}.value", cg_frame_region(dctx))
    } else {
        var slice_t = checker::Slice { element = checker::Named { name = "teko::base::str" } }
        var sx = teko::str::concat("(tk_slice_str){ .ptr = ", t, teko::str::concat(".ptr, .len = ", t, ".len }"))
        emit_variant_wrap_str(buf, prog, e.type, slice_t, sx, cg_frame_region(dctx))
    }
    buf.write(" : ")
    var eexpr = if kind == "u64res" { "tk_error_make((tk_str){0})" } else { teko::str::concat("tk_error_make(", t, ".err)") }
    emit_variant_wrap_str(buf, prog, e.type, err_t, eexpr, cg_frame_region(dctx))
    buf.write("; })")
}

fn cg_mangle_eq(a: @Type(), b: @Type()): bool {
    var ea = cg_mangle_errors(a)
    var eb = cg_mangle_errors(b)
    if ea || eb { return ea && eb }
    cg_mangle_bytes_eq(a, b)
}

fn cg_mangle_errors(t: @Type()): bool {
    match t {
        checker::Prim => false
        checker::Byte => false
        checker::Char => false
        checker::Error => false
        checker::Named => false
        checker::Slice as sl => match sl.element {
            checker::Void => true
            _ => cg_mangle_errors(sl.element)
        }
        _ => true
    }
}

fn cg_mangle_bytes_eq(a: @Type(), b: @Type()): bool {
    match a {
        checker::Named as na => cg_mangle_type_matches_name(b, na.name)
        checker::Slice as sa => match b {
            checker::Named as nb => cg_mangle_type_matches_name(a, nb.name)
            checker::Slice as sb => cg_mangle_bytes_eq(sa.element, sb.element)
            _ => false
        }
        _ => match b {
            checker::Named as nb => cg_mangle_type_matches_name(a, nb.name)
            checker::Slice => false
            _ => cg_leaf_literal_eq(a, b)
        }
    }
}

fn cg_leaf_literal_eq(a: @Type(), b: @Type()): bool {
    match cg_opt_mangle_str(a) {
        str as sa => match cg_opt_mangle_str(b) { str as sb => sa == sb; error => false }
        error => false
    }
}

fn cg_mangle_type_matches_name(t: @Type(), name: str): bool {
    var start = cg_name_last_segment_offset(name)
    var end = cg_mangle_consume(t, name, start)
    end >= 0 && (end to u64) == name.len
}

fn cg_mangle_consume(t: @Type(), name: str, off: u64): i64 {
    match t {
        checker::Slice as sl => {
            var o2 = cg_match_literal(name, off, "slice_")
            if o2 < 0 { -1 } else { cg_mangle_consume(sl.element, name, o2 to u64) }
        }
        checker::Named as nm => cg_match_segment(name, off, nm.name)
        _ => match cg_opt_mangle_str(t) {
            str as lit => cg_match_literal(name, off, lit)
            error => -1
        }
    }
}

fn cg_match_literal(name: str, off: u64, lit: str): i64 {
    if off + lit.len > name.len { return -1 }
    var i: u64 = 0
    loop {
        if i >= lit.len { break }
        if name[off + i] != lit[i] { return -1 }
        i++
    }
    (off + lit.len) to i64
}

fn cg_match_segment(name: str, off: u64, other: str): i64 {
    var s = cg_name_last_segment_offset(other)
    var seglen = other.len - s
    if off + seglen > name.len { return -1 }
    var i: u64 = 0
    loop {
        if i >= seglen { break }
        if name[off + i] != other[s + i] { return -1 }
        i++
    }
    (off + seglen) to i64
}

fn cg_name_last_segment_offset(name: str): u64 {
    var last_sep: i64 = -1
    var i: u64 = 0
    loop {
        if i + 1 >= name.len { break }
        if name[i] == b':' && name[i + 1] == b':' { last_sep = i to i64 }
        i++
    }
    if last_sep < 0 { 0 } else { (last_sep to u64) + 2 }
}

fn emit_as(buf: teko::io::FileStream, prog: CgProg, expected: @Type(), value: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    emit_as_r(buf, prog, checker::Void { }, expected, value, escaping, regions, fn_body, dctx)
}

fn cg_slice_param_type(prog: CgProg, slt: parser::SliceType, arg_type: @Type()): @Type() {
    match slt.element {
        parser::NamedType as nt => checker::Slice { element = checker::Named { name = cg_canon_name(prog, nt.path.segments[nt.path.segments.len - 1].name) } }
        _ => arg_type
    }
}

fn cg_emit_inline_null(buf: teko::io::FileStream, expected: @Type()) {
    cg_wrap_open(buf, expected, "null")
    buf.write("0 }")
}

fn cg_value_already_boxed(prog: CgProg, bx: @Type(), vt: @Type()): bool {
    match vt {
        checker::Variant as vv => match cg_union_box_member(prog, vv) {
            (@Type()) as vbx => cg_mangle_eq(bx, vbx)
            null => false
        }
        _ => false
    }
}

fn cg_emit_box_construct(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), inner: @Type(), value: checker::TExpr, box_region: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var bxN = fresh_named("_ubx", buf.gensym() to i64)
    buf.write("({ ")
    emit_type(buf, prog, inner)
    buf.write(" *")
    buf.write(bxN)
    buf.write(" = "); cb_arena_sym(buf, CgArenaSym::RegionAlloc); buf.write("(")
    if box_region.len > 0 { buf.write(box_region) } else { buf.write(cg_frame_region(dctx)) }
    buf.write(", sizeof(")
    emit_type(buf, prog, inner)
    buf.write(")); *")
    buf.write(bxN)
    buf.write(" = ")
    emit_as_r_in(buf, prog, ret_type, inner, value, box_region, escaping, regions, fn_body, dctx)
    buf.write("; ")
    buf.write(bxN)
    buf.write("; })")
}

fn emit_as_r(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    emit_as_r_in(buf, prog, ret_type, expected, value, "", escaping, regions, fn_body, dctx)
}

fn emit_as_r_in(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, box_region: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if cg_is_bytes_str_reinterpret(expected, value.type) {
        var reint = checker::TExpr { kind = checker::TCast { expr = value }; type = expected; line = value.line; col = value.col }
        emit_bytes_str_reinterpret(buf, prog, reint, value, escaping, regions, fn_body, dctx)
        return
    }
    match expected {
        checker::Reference => {
            match value.type {
                checker::Reference => { emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx); return }
                _ => {
                    buf.write("&")
                    emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
                    return
                }
            }
        }
        _ => { }
    }
    match expected {
        checker::Variant as nva => match cg_union_niche_member(prog, nva) {
            (@Type()) as nx => {
                match value.kind {
                    checker::TNullLit => { cg_emit_niche_null(buf, prog, nx); return }
                    _ => { emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx); return }
                }
            }
            null => { }
        }
        _ => { }
    }
    match expected {
        checker::Variant as bva => match cg_union_box_member(prog, bva) {
            (@Type()) as bx => {
                match value.kind {
                    checker::TNullLit => { buf.write("0"); return }
                    _ => {
                        if cg_value_already_boxed(prog, bx, value.type) { emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx); return }
                        cg_emit_box_construct(buf, prog, ret_type, bx, value, box_region, escaping, regions, fn_body, dctx)
                        return
                    }
                }
            }
            null => { }
        }
        _ => { }
    }
    match expected {
        checker::Variant as iva => match value.kind {
            checker::TNullLit => if cg_variant_has_null(iva) { cg_emit_inline_null(buf, expected); return }
            _ => { }
        }
        _ => { }
    }
    match expected {
        checker::Slice as sexp => {
            match sexp.element {
                checker::Void => { }
                _ => {
                    var val_sentinel = match value.type {
                        checker::Slice as svt => match svt.element { checker::Void => true; _ => false }
                        _ => false
                    }
                    if val_sentinel {
                        buf.write("(")
                        cg_slice_typename(buf, sexp.element)
                        buf.write("){ .ptr = 0, .len = 0 }")
                        return
                    }
                    var concrete_diff = match value.type {
                        checker::Slice as svt => match svt.element {
                            checker::Void => false
                            _ => !cg_mangle_eq(sexp.element, svt.element)
                        }
                        _ => false
                    }
                    if concrete_diff {
                        var elemU = match value.type { checker::Slice as svt => svt.element; _ => checker::Void { } }
                        var T = sexp.element
                        var U = elemU
                        var sv = fresh_named("_cv", buf.gensym() to i64)
                        var rp = fresh_named("_cp", buf.gensym() to i64)
                        var ri = fresh_named("_ci", buf.gensym() to i64)
                        buf.write("({ ")
                        cg_slice_typename(buf, U)
                        buf.write(" "); buf.write(sv); buf.write(" = ")
                        emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
                        buf.write("; ")
                        emit_type(buf, prog, T)
                        buf.write(" *"); buf.write(rp); buf.write(" = (")
                        emit_type(buf, prog, T)
                        buf.write(" *)")
                        cb_arena_sym(buf, CgArenaSym::RegionAlloc)
                        buf.write("("); buf.write(cg_frame_region(dctx)); buf.write(", "); buf.write(sv); buf.write(".len * sizeof(")
                        emit_type(buf, prog, T)
                        buf.write(")); ")
                        buf.write("for (uint64_t "); buf.write(ri); buf.write(" = 0; "); buf.write(ri); buf.write(" < "); buf.write(sv); buf.write(".len; "); buf.write(ri); buf.write(" += 1) { ")
                        buf.write(rp); buf.write("["); buf.write(ri); buf.write("] = ")
                        var elem = teko::str::concat(sv, teko::str::concat(".ptr[", teko::str::concat(ri, "]")))
                        cg_wrap_elem_str(buf, prog, T, U, elem, cg_frame_region(dctx))
                        buf.write("; } (")
                        cg_slice_typename(buf, T)
                        buf.write("){ .ptr = "); buf.write(rp); buf.write(", .len = "); buf.write(sv); buf.write(".len }; })")
                        return
                    }
                    emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
                    return
                }
            }
        }
        _ => { }
    }
    match expected {
        checker::Named as en => {
            if cg_is_interface_named(prog, en.name) || cg_is_trait_named(prog, en.name) {
                match value.type {
                    checker::Named as vn => {
                        if cg_is_class_named(prog, vn.name) {
                            buf.write("(")
                            mangle_type_name(buf, "", en.name)
                            buf.write("){ .data = ")
                            if cg_is_polymorphic_base(prog, vn.name) {
                                buf.write("(")
                                emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
                                buf.write(").data")
                            } else {
                                buf.write("(void *)(")
                                emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
                                buf.write(")")
                            }
                            buf.write(", .vtable = tk_vt_")
                            cb_tysym(buf, vn.name)
                            buf.write("_")
                            cb_tysym(buf, en.name)
                            buf.write(" }")
                            return
                        }
                    }
                    _ => { }
                }
            }
        }
        _ => { }
    }
    match expected {
        checker::Named as ben => {
            if cg_is_polymorphic_base(prog, ben.name) {
                match value.type {
                    checker::Named as bvn => {
                        if cg_is_class_named(prog, bvn.name) {
                            var is_strict_sub = bvn.name != ben.name && cg_subclass_reaches(prog, bvn.name, ben.name, SUBCLASS_CHAIN_DEPTH_LIMIT)
                            var is_raw_self = bvn.name == ben.name && match value.kind { checker::TStructInit => true; _ => false }
                            if is_strict_sub || is_raw_self {
                                buf.write("(tk_base_"); cb_tysym(buf, ben.name)
                                buf.write("){ .data = (void *)(")
                                emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
                                buf.write("), .vtable = tk_vt_"); cb_tysym(buf, bvn.name); buf.write("_"); cb_tysym(buf, ben.name)
                                buf.write(" }")
                                return
                            }
                        }
                    }
                    _ => { }
                }
            }
        }
        _ => { }
    }
    var vt_is_variant = match value.type { checker::Variant => true; checker::Named as vn => cg_named_is_variant(prog, vn.name); _ => false }
    if vt_is_variant && !cg_mangle_eq(value.type, expected) && cg_narrow_variant_widens_into(prog, value.type, expected) {
        var widened = checker::TExpr { kind = value.kind; type = expected; line = value.line; col = value.col }
        match value.kind {
            checker::TIfExpr as f => { emit_if_value(buf, prog, ret_type, widened, f, escaping, regions, fn_body, dctx); return }
            checker::TMatchExpr as m => { emit_match_value(buf, prog, ret_type, widened, m, escaping, regions, fn_body, dctx); return }
            _ => { }
        }
    }
    var vkey = match cg_member_key_str(value.type) { str as s => s; error => "" }
    if vkey == "" { emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx); return }
    var is_variant_slot = match expected { checker::Variant => true; checker::Named => true; _ => false }
    if is_variant_slot {
        if cg_var_reaches(prog, expected, vkey, 16) {
            emit_variant_wrap(buf, prog, ret_type, expected, value, escaping, regions, fn_body, dctx)
            return
        }
    }
    emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
}

fn cg_emit_lit_pattern(buf: teko::io::FileStream, lit: parser::Expr) {
    match lit.kind {
        parser::Number as n => {
            if n.is_float { cb_f64_literal(buf, n.fval); return }
            cb_numint(buf, n.value)
        }
        parser::ByteLit as b => cb_i64(buf, b.value to i64)
        parser::StrLit as sl => {
            buf.write("(tk_str){ (const tk_byte *)\"")
            cb_cstr_escaped(buf, sl.text)
            buf.write("\", ")
            cb_i64(buf, sl.text.len to i64)
            buf.write(" }")
        }
        _ => panic("codegen: unsupported literal in a pattern (parser emits only number/byte/str)")
    }
}

fn cg_emit_tag_prefix(buf: teko::io::FileStream, variantT: @Type()) {
    buf.write("TK_TAG_")
    match variantT {
        checker::Variant as va => {
            buf.write("U")
            var j = 0
            loop {
                if j >= va.members.len { break }
                buf.write("_")
                var kj = match cg_member_key_str(va.members[j]) { str as s => s; error as err => panic(err.message) }
                cb_upper(buf, kj)
                j++
            }
            buf.write("_")
        }
        checker::Named as nm => { cb_upper(buf, cg_ns_c_key(nm.name)); buf.write("_") }
        _ => panic("codegen: tag prefix over a non-variant subject (internal)")
    }
}

fn cg_emit_case_key_str(pat: @Pattern()): str | error {
    match pat {
        parser::BindPattern as bp => {
            if bp.is_slice {
                match bp.slice_type {
                    null => error { message = "codegen: slice pattern without a slice type (internal)" }
                    (@TypeExpr()) as st => cg_member_key_texpr_bare_str(st)
                }
            } else if bp.type_args.len > 0 {
                cg_case_name_escaped(cg_texpr_inst_name(cg_path_last(bp.type_name), bp.type_args))
            } else { cg_case_name_escaped(cg_path_last(bp.type_name)) }
        }
        parser::FieldPattern as fp => cg_case_name_escaped(cg_path_last(fp.type_name))
        parser::GroupBindPattern as gp => cg_group_case_key(gp)
        _ => error { message = "codegen: case key over a non-bind/field pattern (internal)" }
    }
}

fn cg_group_case_key(gp: parser::GroupBindPattern): str | error {
    var out = "u"
    var i = 0
    loop {
        if i >= gp.options.len { break }
        var k = match cg_emit_case_key_str(gp.options[i]) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

fn cg_case_name_escaped(name: str): str {
    if cg_is_c_keyword(name) { teko::str::concat(name, "_") } else { name }
}

fn emit_pat_test(buf: teko::io::FileStream, prog: CgProg, pat: @Pattern(), subj: str, variantT: @Type()) {
    match pat {
        parser::WildcardPattern => buf.write("1")
        parser::LiteralPattern as lp => {
            var is_str_lit = match lp.value.kind { parser::StrLit => true; _ => false }
            if is_str_lit {
                buf.write(cb_fn_name_str("teko::runtime", "str_eq"))
                buf.write("(")
                buf.write(subj)
                buf.write(", ")
                cg_emit_lit_pattern(buf, lp.value)
                buf.write(")")
                return
            }
            buf.write("(")
            buf.write(subj)
            buf.write(" == ")
            cg_emit_lit_pattern(buf, lp.value)
            buf.write(")")
        }
        parser::RangePattern as rp => {
            buf.write("(")
            buf.write(subj)
            buf.write(" >= ")
            cg_emit_lit_pattern(buf, rp.lo)
            buf.write(" && ")
            buf.write(subj)
            buf.write(" <= ")
            cg_emit_lit_pattern(buf, rp.hi)
            buf.write(")")
        }
        parser::AltPattern as ap => {
            buf.write("(")
            var i = 0
            loop {
                if i >= ap.options.len { break }
                if i > 0 { buf.write(" || ") }
                emit_pat_test(buf, prog, ap.options[i], subj, variantT)
                i++
            }
            buf.write(")")
        }
        parser::BindPattern as bp0 => {
            var bind_whole = match variantT {
                checker::Named as nm => (!bp0.is_slice) && (cg_path_last(bp0.type_name) == checker::name_last_segment(nm.name))
                _ => false
            }
            if bind_whole { buf.write("1"); return }
            var is_enum = match variantT { checker::Named as nm => cg_named_is_enum(prog, nm.name); _ => false }
            if is_enum {
                var ename = match variantT { checker::Named as nm => checker::name_last_segment(nm.name); _ => "" }
                buf.write("(")
                buf.write(subj)
                buf.write(" == TK_E_")
                cb_upper(buf, ename)
                buf.write("_")
                var cke = match cg_emit_case_key_str(pat) { str as s => s; error as err => panic(err.message) }
                cb_upper(buf, cke)
                buf.write(")")
                return
            }
            buf.write("(")
            buf.write(subj)
            buf.write(".tag == ")
            cg_emit_tag_prefix(buf, variantT)
            var ck = match cg_case_key_qualified(prog, variantT, pat) { str as s => s; error as err => panic(err.message) }
            cb_upper(buf, ck)
            buf.write(")")
        }
        parser::FieldPattern => {
            buf.write("(")
            buf.write(subj)
            buf.write(".tag == ")
            cg_emit_tag_prefix(buf, variantT)
            var ck = match cg_case_key_qualified(prog, variantT, pat) { str as s => s; error as err => panic(err.message) }
            cb_upper(buf, ck)
            buf.write(")")
        }
        parser::NullPattern => {
            if cg_var_reaches(prog, variantT, "null", 16) {
                buf.write("(")
                buf.write(subj)
                buf.write(".tag == ")
                cg_emit_tag_prefix(buf, variantT)
                cb_upper(buf, "null")
                buf.write(")")
                return
            }
            panic("codegen: `null` pattern over a non-optional subject (internal)")
        }
        parser::GroupBindPattern => {
            buf.write("(")
            buf.write(subj)
            buf.write(".tag == ")
            cg_emit_tag_prefix(buf, variantT)
            var ck = match cg_case_key_qualified(prog, variantT, pat) { str as s => s; error as err => panic(err.message) }
            cb_upper(buf, ck)
            buf.write(")")
        }
        parser::MacroPattern => panic("internal: an unexpanded @Type() macro reached codegen — it should be expanded by the Family-A pre-pass")
    }
}

type CgKindDescend = struct { var_type: @Type(); boxed: bool }

fn cg_kind_descend(prog: CgProg, subjT: @Type(), pat: @Pattern()): CgKindDescend | null {
    var sname = match subjT { checker::Named as nm => nm.name; _ => return null }
    match pat {
        parser::BindPattern => { }
        parser::FieldPattern => { }
        _ => return null
    }
    var d = match cg_find_decl(prog, sname) { parser::TypeDecl as dd => dd; error => return null }
    var sb = match d.body { parser::StructBody as s => s; _ => return null }
    var kfte: @TypeExpr() | null = null
    var i = 0
    loop {
        if i >= sb.fields.len { break }
        if sb.fields[i].name == "kind" { kfte = sb.fields[i].type_ann; break }
        i++
    }
    var fte = match kfte { null => return null; (@TypeExpr()) as t => t }
    var vname = match fte { parser::NamedType as nt => cg_canon_name(prog, cg_path_last(nt.path)); _ => return null }
    if !cg_named_is_variant(prog, vname) { return null }
    var v = checker::Named { name = vname }
    var key = match cg_case_key_qualified(prog, v, pat) { str as s => s; error => return null }
    if !cg_var_reaches(prog, v, key, 2) { return null }
    CgKindDescend { var_type = v; boxed = cg_field_boxed(prog, sname, fte) }
}

fn cg_kind_derived_subj(subj: str, boxed: bool): str {
    var o = if boxed { "(*(" } else { "(" }
    o = teko::str::concat(o, subj)
    o = teko::str::concat(o, ").kind")
    if boxed { o = teko::str::concat(o, ")") }
    o
}

fn cg_fatptr_subject_name(prog: CgProg, subjT: @Type()): str | null {
    match subjT {
        checker::Named as nm => {
            if cg_is_polymorphic_base(prog, nm.name) || cg_is_interface_named(prog, nm.name) || cg_is_trait_named(prog, nm.name) { return nm.name }
            null
        }
        _ => null
    }
}

fn cg_emit_fatptr_pat_test(buf: teko::io::FileStream, prog: CgProg, pat: @Pattern(), subj: str, subjname: str) {
    match pat {
        parser::WildcardPattern => buf.write("1")
        parser::BindPattern as bp => {
            if bp.is_slice { panic("codegen: a slice pattern cannot discriminate a class/interface subject (internal)") }
            var sub_last = cg_path_last(bp.type_name)
            if sub_last == checker::name_last_segment(subjname) { buf.write("1"); return }
            var canon = cg_canon_name(prog, sub_last)
            buf.write("((")
            buf.write(subj)
            buf.write(").vtable == tk_vt_")
            cb_tysym(buf, canon)
            buf.write("_")
            cb_tysym(buf, subjname)
            buf.write(")")
        }
        _ => panic("codegen: unsupported pattern over a class/interface subject (internal)")
    }
}

fn cg_emit_fatptr_pat_binds(buf: teko::io::FileStream, prog: CgProg, pat: @Pattern(), subj: str, subjname: str, indent: str) {
    match pat {
        parser::BindPattern as bp => {
            if !bp.has_binding { return }
            buf.write(indent)
            buf.write("auto ")
            buf.write(bp.binding)
            buf.write(" = ")
            var sub_last = cg_path_last(bp.type_name)
            if sub_last == checker::name_last_segment(subjname) {
                buf.write(subj)
                buf.write(";\n")
                return
            }
            var canon = cg_canon_name(prog, sub_last)
            buf.write("(")
            mangle_type_name(buf, "", canon)
            buf.write(" *)((")
            buf.write(subj)
            buf.write(").data);\n")
        }
        _ => { }
    }
}

fn cg_emit_pat_test(buf: teko::io::FileStream, prog: CgProg, pat: @Pattern(), subj: str, subjT: @Type()) {
    match cg_kind_descend(prog, subjT, pat) {
        CgKindDescend as kd => {
            var ds = cg_kind_derived_subj(subj, kd.boxed)
            cg_emit_pat_test(buf, prog, pat, ds, kd.var_type)
            return
        }
        null => { }
    }
    match subjT {
        checker::Variant as nva => match cg_union_niche_member(prog, nva) {
            (@Type()) as nx => {
                match pat {
                    parser::NullPattern => { cg_emit_niche_is_null(buf, subj, nx); return }
                    parser::WildcardPattern => { buf.write("1"); return }
                    parser::BindPattern => { cg_emit_niche_not_null(buf, subj, nx); return }
                    parser::FieldPattern => { cg_emit_niche_not_null(buf, subj, nx); return }
                    parser::GroupBindPattern => { cg_emit_niche_not_null(buf, subj, nx); return }
                    _ => { }
                }
            }
            null => { }
        }
        _ => { }
    }
    match subjT {
        checker::Variant as bva => match cg_union_box_member(prog, bva) {
            (@Type()) as _gt10 => {
                match pat {
                    parser::NullPattern => { buf.write("("); buf.write(subj); buf.write(" == 0)"); return }
                    parser::WildcardPattern => { buf.write("1"); return }
                    parser::BindPattern => { buf.write("("); buf.write(subj); buf.write(" != 0)"); return }
                    parser::FieldPattern => { buf.write("("); buf.write(subj); buf.write(" != 0)"); return }
                    parser::GroupBindPattern => { buf.write("("); buf.write(subj); buf.write(" != 0)"); return }
                    _ => { }
                }
            }
            null => { }
        }
        _ => { }
    }
    match cg_fatptr_subject_name(prog, subjT) {
        str as sname => { cg_emit_fatptr_pat_test(buf, prog, pat, subj, sname); return }
        null => { }
    }
    emit_pat_test(buf, prog, pat, subj, subjT)
}

fn emit_pat_binds(buf: teko::io::FileStream, prog: CgProg, pat: @Pattern(), subj: str, subjT: @Type(), indent: str) {
    match pat {
        parser::BindPattern as bp => {
            if bp.has_binding {
                buf.write(indent)
                buf.write("auto ")
                buf.write(bp.binding)
                buf.write(" = ")
                var ck = match cg_case_key_qualified(prog, subjT, pat) { str as s => s; error as err => panic(err.message) }
                cg_emit_union_member_access(buf, prog, subj, subjT, ck)
                buf.write(";\n")
            }
        }
        parser::FieldPattern as fp => {
            var i = 0
            loop {
                if i >= fp.fields.len { break }
                buf.write(indent)
                buf.write("auto ")
                buf.write(fp.fields[i])
                buf.write(" = ")
                var ck = match cg_case_key_qualified(prog, subjT, pat) { str as s => s; error as err => panic(err.message) }
                cg_emit_union_member_access(buf, prog, subj, subjT, ck)
                buf.write(".")
                buf.write(fp.fields[i])
                buf.write(";\n")
                i++
            }
        }
        parser::GroupBindPattern as gp => {
            buf.write(indent)
            buf.write("auto ")
            buf.write(gp.binding)
            buf.write(" = ")
            var ck = match cg_case_key_qualified(prog, subjT, pat) { str as s => s; error as err => panic(err.message) }
            cg_emit_union_member_access(buf, prog, subj, subjT, ck)
            buf.write(";\n")
        }
        _ => { }
    }
}

fn cg_emit_pat_binds(buf: teko::io::FileStream, prog: CgProg, pat: @Pattern(), subj: str, subjT: @Type(), indent: str) {
    match cg_kind_descend(prog, subjT, pat) {
        CgKindDescend as kd => {
            var ds = cg_kind_derived_subj(subj, kd.boxed)
            cg_emit_pat_binds(buf, prog, pat, ds, kd.var_type, indent)
            return
        }
        null => { }
    }
    match subjT {
        checker::Variant as nva => match cg_union_niche_member(prog, nva) {
            (@Type()) as _gt11 => {
                match pat {
                    parser::BindPattern as nbp => {
                        if nbp.has_binding {
                            buf.write(indent)
                            buf.write("auto ")
                            buf.write(nbp.binding)
                            buf.write(" = ")
                            buf.write(subj)
                            buf.write(";\n")
                        }
                        return
                    }
                    parser::GroupBindPattern as ngp => {
                        buf.write(indent)
                        buf.write("auto ")
                        buf.write(ngp.binding)
                        buf.write(" = ")
                        buf.write(subj)
                        buf.write(";\n")
                        return
                    }
                    _ => return
                }
            }
            null => { }
        }
        _ => { }
    }
    match subjT {
        checker::Variant as bva => match cg_union_box_member(prog, bva) {
            (@Type()) as _gt12 => {
                match pat {
                    parser::BindPattern as nbp => {
                        if nbp.has_binding {
                            buf.write(indent)
                            buf.write("auto ")
                            buf.write(nbp.binding)
                            buf.write(" = (*(")
                            buf.write(subj)
                            buf.write("));\n")
                        }
                        return
                    }
                    parser::GroupBindPattern as bgp => {
                        buf.write(indent)
                        buf.write("auto ")
                        buf.write(bgp.binding)
                        buf.write(" = (*(")
                        buf.write(subj)
                        buf.write("));\n")
                        return
                    }
                    _ => return
                }
            }
            null => { }
        }
        _ => { }
    }
    match cg_fatptr_subject_name(prog, subjT) {
        str as sname => { cg_emit_fatptr_pat_binds(buf, prog, pat, subj, sname, indent); return }
        null => { }
    }
    match pat {
        parser::BindPattern as bp => {
            var bind_whole = match subjT {
                checker::Named as nm => (!bp.is_slice) && (cg_path_last(bp.type_name) == checker::name_last_segment(nm.name))
                _ => false
            }
            if bind_whole {
                if bp.has_binding {
                    buf.write(indent); buf.write("auto "); buf.write(bp.binding)
                    buf.write(" = "); buf.write(subj); buf.write(";\n")
                }
                return
            }
        }
        _ => { }
    }
    emit_pat_binds(buf, prog, pat, subj, subjT, indent)
}

fn cg_block_diverges(stmts: []@TStatement()): bool {
    if stmts.len == 0 { return false }
    match stmts[stmts.len - 1] {
        checker::TReturn => true
        checker::TBreakStmt => true
        checker::TContinueStmt => true
        checker::TExprStmt as es => match es.expr.kind {
            checker::TIfExpr as f => f.has_else && cg_block_diverges(f.then_blk) && cg_block_diverges(f.else_blk)
            checker::TMatchExpr as m => {
                if m.arms.len == 0 { return false }
                var i = 0
                loop {
                    if i >= m.arms.len { break }
                    if !cg_block_diverges(m.arms[i].body) { return false }
                    i++
                }
                true
            }
            _ => false
        }
        _ => false
    }
}

fn cg_block_diverges_jump(stmts: []@TStatement()): bool {
    if stmts.len == 0 { return false }
    match stmts[stmts.len - 1] {
        checker::TBreakStmt => true
        checker::TContinueStmt => true
        checker::TExprStmt as es => match es.expr.kind {
            checker::TIfExpr as f => f.has_else && (cg_block_diverges_jump(f.then_blk) || cg_block_diverges_jump(f.else_blk))
            checker::TMatchExpr as m => {
                var i = 0
                loop {
                    if i >= m.arms.len { break }
                    if cg_block_diverges_jump(m.arms[i].body) { return true }
                    i++
                }
                false
            }
            _ => false
        }
        _ => false
    }
}

fn emit_arm_value(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), match_e: checker::TExpr, body: []@TStatement(), sink: str, ci: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if cg_block_diverges_jump(body) {
        panic("codegen: break/continue inside a `match` used as a sub-expression not yet supported")
    }
    if cg_block_diverges(body) {
        var cur = dctx
        var i = 0
        loop {
            if i + 1 >= body.len { break }
            match body[i] {
                checker::TDeferStmt => { cur = dctx_register(cur, body[i]) }
                _ => { emit_stmt(buf, body[i], false, prog, ret_type, ci, "", escaping, regions, fn_body, cur, [], false) }
            }
            i++
        }
        var last = body[body.len - 1]
        match last {
            checker::TExprStmt as es => match es.expr.kind {
                checker::TIfExpr as _ => emit_exprstmt_tail(buf, es.expr, false, prog, ret_type, ci, "", escaping, regions, fn_body, cur)
                checker::TMatchExpr as _ => emit_exprstmt_tail(buf, es.expr, false, prog, ret_type, ci, "", escaping, regions, fn_body, cur)
                _ => emit_stmt(buf, last, false, prog, ret_type, ci, "", escaping, regions, fn_body, cur, [], false)
            }
            _ => emit_stmt(buf, last, false, prog, ret_type, ci, "", escaping, regions, fn_body, cur, [], false)
        }
        return
    }
    var defer_floor = dctx.defers.len
    var want_block = cg_block_has_block_local(prog, escaping, fn_body, body, true) && regions.len < 64 && checker::scope_slot_count(body) > 0
    var region = if want_block { fresh_named("_tkbr", buf.gensym() to i64) } else { "" }
    var regs2 = if want_block { [..regions, RegionFrame { name = region; label = ""; is_loop = false; defer_base = defer_floor; decls = cg_block_slice_accums(prog, escaping, fn_body, body, true); bound_names = cg_block_bound_names(body) }] } else { regions }
    var cur_blk = if want_block { body } else { [] }
    if want_block {
        buf.write(ci); buf.write("tk_region *"); buf.write(region); buf.write(" = "); cb_region_open(buf, cg_alloc_region(regions, dctx), body); buf.write(";\n")
    }
    var cur = dctx
    var i = 0
    loop {
        if i + 1 >= body.len { break }
        match body[i] {
            checker::TDeferStmt => { cur = dctx_register(cur, body[i]) }
            _ => { emit_stmt(buf, body[i], false, prog, ret_type, ci, "", escaping, regs2, fn_body, cur, cur_blk, want_block) }
        }
        i++
    }
    if body.len == 0 { panic("codegen: empty match arm body in value position") }
    var fall = cg_append_direct_defers(dctx.defers, body)
    var last = body[body.len - 1]
    match last {
        checker::TExprStmt as es => {
            emit_cov_lines(buf, dctx.cov, cov_collect_expr(es.expr, []), ci)
            buf.write(ci)
            buf.write(sink)
            buf.write(" = (")
            if cg_expr_diverges(es.expr) {
                emit_expr_ctx(buf, prog, checker::Void { }, es.expr, escaping, regs2, fn_body, cur)
                buf.write(", (")
                emit_type(buf, prog, match_e.type)
                buf.write("){0}")
            } else {
                emit_as_r(buf, prog, ret_type, match_e.type, es.expr, escaping, regs2, fn_body, cur)
            }
            buf.write(");")
            if want_block {
                if fall.len > defer_floor {
                    buf.write("\n")
                    emit_defers(buf, fall, defer_floor, prog, ci, escaping, fn_body)
                    buf.write(ci); cb_arena_sym(buf, CgArenaSym::RegionDrop); buf.write("("); buf.write(region); buf.write("); "); buf.write(region); buf.write(" = NULL;")
                } else {
                    buf.write(" "); cb_arena_sym(buf, CgArenaSym::RegionDrop); buf.write("("); buf.write(region); buf.write("); "); buf.write(region); buf.write(" = NULL;")
                }
                buf.write(" break;\n")
            } else if fall.len > defer_floor {
                buf.write("\n")
                emit_defers(buf, fall, defer_floor, prog, ci, escaping, fn_body)
                buf.write(ci); buf.write("break;\n")
            } else {
                buf.write(" break;\n")
            }
        }
        _ => panic("codegen: non-value trailing statement in a match arm used as a value")
    }
}

fn emit_match_value(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), e: checker::TExpr, m: checker::TMatchExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var subj = fresh_named("_s", buf.gensym() to i64)
    var res = fresh_named("_r", buf.gensym() to i64)
    var subjT = m.subject.type
    buf.write("({ ")
    emit_type(buf, prog, m.subject.type)
    buf.write(" ")
    buf.write(subj)
    buf.write(" = (")
    emit_expr_ctx(buf, prog, checker::Void { }, m.subject, escaping, regions, fn_body, dctx)
    buf.write("); ")
    emit_type(buf, prog, e.type)
    buf.write(" ")
    buf.write(res)
    buf.write(" = {0}; do {\n")
    var i = 0
    loop {
        if i >= m.arms.len { break }
        var arm = m.arms[i]
        buf.write("    if (")
        cg_emit_pat_test(buf, prog, arm.pattern, subj, subjT)
        buf.write(") {\n")
        cg_emit_pat_binds(buf, prog, arm.pattern, subj, subjT, "        ")
        var ci = "        "
        if arm.has_when {
            buf.write("        if (")
            emit_expr_ctx(buf, prog, checker::Void { }, arm.guard, escaping, regions, fn_body, dctx)
            buf.write(") {\n")
            ci = "            "
        }
        emit_cov_branch(buf, dctx.cov, e.line, e.col, i to u64, ci)
        emit_arm_value(buf, prog, ret_type, e, arm.body, res, ci, escaping, regions, fn_body, dctx)
        if arm.has_when { buf.write("        }\n") }
        buf.write("    }\n")
        i++
    }
    buf.write("    } while (0); ")
    buf.write(res)
    buf.write("; })")
}

fn emit_match_tail(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, m: checker::TMatchExpr, in_main: bool, ret_type: @Type(), indent: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var subj = fresh_named("_s", buf.gensym() to i64)
    var done = teko::str::concat(fresh_named("tk_mt", buf.gensym() to i64), "_done")
    var subjT = m.subject.type
    var inner = cb_indent_deeper(indent)
    var inner2 = cb_indent_deeper(inner)
    buf.write(indent)
    buf.write("{\n")
    buf.write(inner)
    emit_type(buf, prog, m.subject.type)
    buf.write(" ")
    buf.write(subj)
    buf.write(" = (")
    emit_expr_ctx(buf, prog, checker::Void { }, m.subject, escaping, regions, fn_body, dctx)
    buf.write(");\n")
    var i = 0
    loop {
        if i >= m.arms.len { break }
        var arm = m.arms[i]
        buf.write(inner)
        buf.write("if (")
        cg_emit_pat_test(buf, prog, arm.pattern, subj, subjT)
        buf.write(") {\n")
        cg_emit_pat_binds(buf, prog, arm.pattern, subj, subjT, inner2)
        var ci = inner2
        if arm.has_when {
            buf.write(inner2)
            buf.write("if (")
            emit_expr_ctx(buf, prog, checker::Void { }, arm.guard, escaping, regions, fn_body, dctx)
            buf.write(") {\n")
            ci = cb_indent_deeper(inner2)
        }
        emit_cov_branch(buf, dctx.cov, e.line, e.col, i to u64, ci)
        var tarm_base = dctx.defers.len
        emit_block_tail(buf, arm.body, in_main, prog, ret_type, ci, "", escaping, regions, fn_body, dctx)
        var tarm_term = if arm.body.len > 0 { cg_stmt_c_terminates(arm.body[arm.body.len - 1]) } else { false }
        if !tarm_term { emit_defers(buf, cg_append_direct_defers(dctx.defers, arm.body), tarm_base, prog, ci, escaping, fn_body) }
        buf.write(ci)
        buf.write("goto ")
        buf.write(done)
        buf.write(";\n")
        if arm.has_when { buf.write(inner2); buf.write("}\n") }
        buf.write(inner)
        buf.write("}\n")
        i++
    }
    buf.write(inner)
    buf.write(done)
    buf.write(": ;\n")
    emit_match_tail_fallthrough_return(buf, prog, ret_type, in_main, inner)
    buf.write(indent)
    buf.write("}\n")
}

fn emit_match_tail_fallthrough_return(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), in_main: bool, inner: str) {
    if in_main { return }
    if is_void_type(ret_type) { return }
    buf.write(inner)
    buf.write("return (")
    emit_type(buf, prog, ret_type)
    buf.write("){0};\n")
}

fn emit_match_stmt(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, m: checker::TMatchExpr, in_main: bool, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool) {
    var subj = fresh_named("_s", buf.gensym() to i64)
    var done = teko::str::concat(fresh_named("tk_m", buf.gensym() to i64), "_done")
    var subjT = m.subject.type
    var inner = cb_indent_deeper(indent)
    var inner2 = cb_indent_deeper(inner)
    buf.write(indent)
    buf.write("{\n")
    buf.write(inner)
    emit_type(buf, prog, m.subject.type)
    buf.write(" ")
    buf.write(subj)
    buf.write(" = (")
    emit_expr_ctx(buf, prog, checker::Void { }, m.subject, escaping, regions, fn_body, dctx)
    buf.write(");\n")
    var i = 0
    loop {
        if i >= m.arms.len { break }
        var arm = m.arms[i]
        buf.write(inner)
        buf.write("if (")
        cg_emit_pat_test(buf, prog, arm.pattern, subj, subjT)
        buf.write(") {\n")
        cg_emit_pat_binds(buf, prog, arm.pattern, subj, subjT, inner2)
        var ci = inner2
        if arm.has_when {
            buf.write(inner2)
            buf.write("if (")
            emit_expr_ctx(buf, prog, checker::Void { }, arm.guard, escaping, regions, fn_body, dctx)
            buf.write(") {\n")
            ci = cb_indent_deeper(inner2)
        }
        emit_cov_branch(buf, dctx.cov, e.line, e.col, i to u64, ci)
        emit_block_region(buf, arm.body, in_main, prog, ret_type, ci, frame, escaping, regions, fn_body, dctx)
        buf.write(ci)
        buf.write("goto ")
        buf.write(done)
        buf.write(";\n")
        if arm.has_when { buf.write(inner2); buf.write("}\n") }
        buf.write(inner)
        buf.write("}\n")
        i++
    }
    buf.write(inner)
    buf.write(done)
    buf.write(": ;\n")
    buf.write(indent)
    buf.write("}\n")
}

fn emit_number(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, n: checker::TNumber) {
    match e.type {
        checker::Byte => {
            buf.write("((uint8_t)")
            cb_numint(buf, n.value)
            buf.write(")")
            return
        }
        _ => { }
    }
    match e.type {
        checker::Named as nm => {
            if cg_named_is_flags(prog, nm.name) {
                buf.write("((")
                mangle_type_name(buf, "", nm.name)
                buf.write(")")
                cb_numint(buf, n.value)
                buf.write(")")
                return
            }
        }
        _ => { }
    }
    var k = match e.type {
        checker::Prim as p => p.kind
        _ => panic("codegen: numeric literal with a non-primitive type not yet supported")
    }
    if n.is_float {
        match k {
            checker::PrimKind::F64 => { cb_f64_literal(buf, n.fval); return }
            checker::PrimKind::F32 => {
                buf.write("(float)(")
                cb_f64_literal(buf, n.fval)
                buf.write(")")
                return
            }
            _ => panic("codegen: float literal with a non-float type not yet supported")
        }
        return
    }
    buf.write("((")
    emit_prim(buf, k)
    buf.write(")")
    cb_numint(buf, n.value)
    buf.write(")")
}

fn emit_expr(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr) {
    emit_expr_ctx(buf, prog, checker::Void { }, e, [], [], [], dctx_empty())
}
fn emit_expr_ret(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), e: checker::TExpr) {
    emit_expr_ctx(buf, prog, ret_type, e, [], [], [], dctx_empty())
}
fn emit_expr_ctx(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), e: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    match e.kind {
        checker::TNumber as n => emit_number(buf, prog, e, n)
        checker::TVar as v => if v.is_func {
            buf.write("(tk_closure){ (void*)&")
            cb_fn_name(buf, v.func_ns, v.name)
            buf.write(", (void*)0 }")
        } else if cg_var_is_struct_self(prog, e, v) {
            buf.write("(*")
            cb_ident(buf, v.name)
            buf.write(")")
        } else if checker::is_cond_const(v.func_ns, v.name, prog.cond_consts) {
            buf.write(cond_const_c_symbol(v.func_ns, v.name))
        } else {
            cb_ident(buf, v.name)
        }
        checker::TBinary as b => emit_binary(buf, prog, e, b, escaping, regions, fn_body, dctx)
        checker::TUnary as u => emit_unary(buf, prog, u, escaping, regions, fn_body, dctx)
        checker::TCompare as c => emit_compare(buf, prog, c, escaping, regions, fn_body, dctx)
        checker::TCast as c => emit_cast(buf, prog, e, c, escaping, regions, fn_body, dctx)
        checker::TCall as cl => emit_call(buf, prog, ret_type, e, cl, escaping, regions, fn_body, dctx)
        checker::TFieldAccess as fa => emit_field_access(buf, prog, fa, escaping, regions, fn_body, dctx)
        checker::TStructInit as si => emit_struct_init(buf, prog, e, si, escaping, regions, fn_body, dctx)
        checker::TStrLit as s => emit_strlit(buf, s)
        checker::TByteStrLit as bs => emit_bytestrlit(buf, bs)
        checker::TByteLit as by => cb_i64(buf, by.value to i64)
        checker::TCharLit as ch => emit_charlit(buf, ch)
        checker::TBoolLit as bl => buf.write(if bl.value { "true" } else { "false" })
        checker::TIfExpr as f => emit_if_value(buf, prog, ret_type, e, f, escaping, regions, fn_body, dctx)
        checker::TMatchExpr as m => emit_match_value(buf, prog, ret_type, e, m, escaping, regions, fn_body, dctx)
        checker::TNullLit => match e.type {
            checker::Null => buf.write("0")
            _ => panic("codegen: a bare `null` needs a known optional type from context (use it where a `T?` is expected)")
        }
        checker::TIndex as ix => emit_index(buf, prog, e, ix, escaping, regions, fn_body, dctx)
        checker::TInterp as in => emit_interp(buf, prog, in, escaping, regions, fn_body, dctx)
        checker::TInExpr as ie => emit_in(buf, prog, ie, escaping, regions, fn_body, dctx)
        checker::TArrayLit as a => emit_array_lit(buf, prog, e, a, escaping, regions, fn_body, dctx)
        checker::TSliceOfLen as s => emit_slice_of_len(buf, prog, e, s, escaping, regions, fn_body, dctx)
        checker::TZeroOf as z => emit_zero_of(buf, prog, e, z, escaping, regions, fn_body, dctx)
        checker::TPathExpr as pe => {
            if cg_named_is_flags(prog, pe.enum_name) {
                mangle_type_name(buf, "", pe.enum_name)
                buf.write("_")
                cb_upper(buf, pe.member)
            } else {
                buf.write("TK_E_")
                cb_upper(buf, checker::name_last_segment(pe.enum_name))
                buf.write("_")
                cb_upper(buf, pe.member)
            }
        }
        checker::TLambda as lam => emit_lambda(buf, prog, e, lam, escaping, regions, fn_body, dctx)
        checker::TBorrow as b => emit_borrow(buf, prog, ret_type, b, escaping, regions, fn_body, dctx)
        checker::TBlockExpr as blk => emit_block_expr(buf, prog, ret_type, e, blk, escaping, regions, fn_body, dctx)
    }
}

fn emit_block_expr(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), e: checker::TExpr, blk: checker::TBlockExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var tmp = fresh_tmp_name(buf.gensym() to i64)
    buf.write("({ ")
    emit_type(buf, prog, e.type)
    buf.write(" ")
    buf.write(tmp)
    buf.write(";\n")
    emit_branch_value(buf, prog, ret_type, blk.body, e.type, tmp, "    ", escaping, regions, fn_body, dctx)
    buf.write(" ")
    buf.write(tmp)
    buf.write("; })")
}

fn emit_borrow(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), b: checker::TBorrow, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write("&")
    emit_expr_ctx(buf, prog, ret_type, b.operand, escaping, regions, fn_body, dctx)
}

fn lam_fn_name(id: u64): str { teko::str::concat("__tkclo_", teko::u64_to_str(id)) }

fn emit_lambda(buf: teko::io::FileStream, prog: CgProg, e: checker::TExpr, lam: checker::TLambda, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if lam.captures.len == 0 {
        buf.write("(tk_closure){ (void*)&")
        cb_fn_name(buf, "", lam_fn_name(lam.lift_id))
        buf.write(", (void*)0 }")
        return
    }
    buf.write("({ __tkenv_")
    cb_u64_digits(buf, lam.lift_id)
    buf.write(" *_tke = "); cb_arena_sym(buf, CgArenaSym::RegionAlloc); buf.write("("); buf.write(cg_closure_env_region(dctx)); buf.write(", sizeof(__tkenv_")
    cb_u64_digits(buf, lam.lift_id)
    buf.write(")); ")
    var i = 0
    loop {
        if i >= lam.captures.len { break }
        buf.write("_tke->")
        cb_ident(buf, lam.captures[i].name)
        buf.write(" = ")
        cb_ident(buf, lam.captures[i].name)
        buf.write("; ")
        i++
    }
    buf.write("(tk_closure){ (void*)&")
    cb_fn_name(buf, "", lam_fn_name(lam.lift_id))
    buf.write(", (void*)_tke }; })")
}

type RegionFrame = struct {
    name: str
    label: str
    is_loop: bool
    defer_base: u64
    decls: []str
    bound_names: []str
}

fn cg_block_bound_names(body: []@TStatement()): []str {
    var acc: []str = []
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding as b => match b.target {
                parser::SimpleName as sn => { acc = [..acc, sn.name] }
                parser::DestructurePattern => { }
            }
            _ => { }
        }
        i = i + 1
    }
    acc
}

fn cg_block_wants_region(body: []@TStatement()): bool {
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding => { return true }
            checker::TExprStmt as es => match es.expr.kind {
                checker::TCall => { return true }
                checker::TIfExpr => { return true }
                checker::TMatchExpr => { return true }
                _ => { }
            }
            checker::TLoopStmt => { return true }
            _ => { }
        }
        i = i + 1
    }
    false
}

fn cg_write_residence(regions: []RegionFrame, name: str): str {
    var k = regions.len
    loop {
        if k == 0 { break }
        if str_list_has(regions[k - 1].bound_names, name) { return regions[k - 1].name }
        k = k - 1
    }
    "_tkfr"
}

fn cg_stmt_write_target(s: @TStatement()): str {
    match s {
        checker::TAssign as a => a.name
        _ => ""
    }
}

fn str_list_has(xs: []str, name: str): bool {
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == name { return true }
        i = i + 1
    }
    false
}

fn cg_block_slice_accums(prog: CgProg, escaping: []str, fn_body: []@TStatement(), body: []@TStatement(), is_value: bool): []str {
    var acc: []str = []
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding as b => {
                if cg_binding_is_block_local_slice(prog, escaping, fn_body, body, is_value, b) {
                    match b.target {
                        parser::SimpleName as sn => { acc = [..acc, sn.name] }
                        parser::DestructurePattern => { }
                    }
                }
            }
            _ => { }
        }
        i = i + 1
    }
    acc
}

fn cg_binding_is_block_local_slice(prog: CgProg, escaping: []str, fn_body: []@TStatement(), body: []@TStatement(), is_value: bool, b: checker::TBinding): bool {
    if !checker::type_is_slice_backed(b.bound, prog.table) { return false }
    checker::binding_is_block_local(escaping, fn_body, body, is_value, b)
}

/**
 * cg_alloc_region — the C expression naming the region that an allocation at the current emit point
 * bumps from: the innermost open per-scope region when one is live, then the region pinned by an
 * escape/residence/return bracket (`dctx.cur`), otherwise the dynamic current region
 * `region_current()`. The ambient is used for the general case because it correctly reflects both the
 * enclosing frame AND any manual scratch region the running code entered (`cg_scope_begin`), which a
 * static parameter cannot track.
 *
 * @param regions  the live per-scope region frame stack
 * @param dctx     the defer context carrying any bracket-pinned region
 * @return         the C region expression
 */
fn cg_alloc_region(regions: []RegionFrame, dctx: DeferCtx): str {
    if regions.len > 0 { return regions[regions.len - 1].name }
    if dctx.cur.len > 0 { return dctx.cur }
    if dctx.regbase.len > 0 { return dctx.regbase }
    teko::str::concat(cg_arena_sym(CgArenaSym::RegionCurrent), "()")
}

/**
 * cg_call_region — the region argument threaded into a callee (its `_tkrgn`). Unlike a body
 * allocation, this must be the DYNAMIC current region so a callee reached inside a manually entered
 * scratch region (`cg_scope_begin`) allocates in that scratch rather than in a static frame. It is the
 * bracket-pinned region (`dctx.cur`) when set, otherwise `region_current()`. Reading the ambient here
 * (once, at the call) is what lets every callee then use its `_tkrgn` parameter directly.
 *
 * @param dctx  the defer context carrying any bracket-pinned region
 * @return      the C region expression passed as the callee's region argument
 */
fn cg_call_region(dctx: DeferCtx): str {
    if dctx.cur.len > 0 { return dctx.cur }
    teko::str::concat(cg_arena_sym(CgArenaSym::RegionCurrent), "()")
}

/**
 * cg_frame_region — the region a value that may outlive the current lexical scope must live in (call
 * returns and escaping allocations: array literals, boxes, interpolation, variant wraps), IGNORING any
 * open per-scope region. It is the bracket-pinned region (`dctx.cur`, e.g. the return region `_tkrr`)
 * when set, else the dynamic current region `region_current()` — the enclosing frame, or the caller's
 * region for a frameless helper.
 *
 * @param dctx  the defer context carrying any bracket-pinned region
 * @return      the C frame-region expression
 */
fn cg_frame_region(dctx: DeferCtx): str {
    if dctx.cur.len > 0 { return dctx.cur }
    if dctx.regbase.len > 0 { return dctx.regbase }
    teko::str::concat(cg_arena_sym(CgArenaSym::RegionCurrent), "()")
}

fn cb_region_open(buf: teko::io::FileStream, parent_expr: str, body: []@TStatement()) {
    var floor = checker::region_slots(body)
    if floor == 0 {
        cb_arena_sym(buf, CgArenaSym::RegionNew)
        buf.write("("); buf.write(parent_expr); buf.write(")")
        return
    }
    cb_arena_sym(buf, CgArenaSym::RegionNewSized)
    buf.write("("); buf.write(parent_expr); buf.write(", "); buf.write(teko::i64_to_str(floor to i64)); buf.write(")")
}

type LoopDeferFrame = struct {
    label: str
    defer_base: u64
    region_base: u64
}

type DeferCtx = struct {
    defers: []@TStatement()
    loops: []LoopDeferFrame
    cov: CovCtx
    rr: str
    bracket_depth: u64
    cur: str
    regbase: str
}

fn dctx_empty(): DeferCtx {
    DeferCtx { defers = []; loops = []; cov = cov_off(); rr = ""; bracket_depth = 0; cur = ""; regbase = "" }
}

fn emit_defers(buf: teko::io::FileStream, defers: []@TStatement(), defer_floor: u64, prog: CgProg, indent: str, escaping: []str, fn_body: []@TStatement()) {
    var i = defers.len
    loop {
        if i <= defer_floor { break }
        i = i - 1
        match defers[i] {
            checker::TDeferStmt as d => {
                var j: u64 = 0
                loop {
                    if j >= d.body.len { break }
                    emit_stmt(buf, d.body[j], false, prog, checker::Void { }, indent, "", escaping, [], fn_body, dctx_empty(), [], false)
                    j++
                }
            }
            _ => { }
        }
    }
}

fn dctx_register(dctx: DeferCtx, s: @TStatement()): DeferCtx {
    DeferCtx { defers = [..dctx.defers, s]; loops = dctx.loops; cov = dctx.cov; rr = dctx.rr; bracket_depth = dctx.bracket_depth; cur = dctx.cur; regbase = dctx.regbase }
}

fn cg_append_direct_defers(defers: []@TStatement(), body: []@TStatement()): []@TStatement() {
    var out = defers
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TDeferStmt => { out = [..out, body[i]] }
            _ => { }
        }
        i++
    }
    out
}

fn cg_target_defer_base(loops: []LoopDeferFrame, label: str): u64 {
    var k = loops.len
    loop {
        if k == 0 { break }
        var lf = loops[k - 1]
        var is_target = if label.len == 0 { true } else { lf.label == label }
        if is_target { return lf.defer_base }
        k = k - 1
    }
    0
}

fn cg_target_region_base(loops: []LoopDeferFrame, label: str): u64 {
    var k = loops.len
    loop {
        if k == 0 { break }
        var lf = loops[k - 1]
        var is_target = if label.len == 0 { true } else { lf.label == label }
        if is_target { return lf.region_base }
        k = k - 1
    }
    0
}

fn cg_drop_regions_from(buf: teko::io::FileStream, indent: str, regions: []RegionFrame, defer_floor: u64) {
    var k = regions.len
    loop {
        if k <= defer_floor { break }
        var r = regions[k - 1]
        buf.write(indent); cb_arena_sym(buf, CgArenaSym::RegionDrop); buf.write("("); buf.write(r.name); buf.write("); "); buf.write(r.name); buf.write(" = NULL;\n")
        k = k - 1
    }
}

fn cg_drop_all_regions(buf: teko::io::FileStream, indent: str, regions: []RegionFrame) {
    var k = regions.len
    loop {
        if k == 0 { break }
        var r = regions[k - 1]
        buf.write(indent); cb_arena_sym(buf, CgArenaSym::RegionDrop); buf.write("("); buf.write(r.name); buf.write("); "); buf.write(r.name); buf.write(" = NULL;\n")
        k = k - 1
    }
}

fn cg_binding_routes_box_to_local_region(prog: CgProg, b: checker::TBinding): bool {
    match b.bound {
        checker::Variant as va => match cg_union_box_member(prog, va) {
            (@Type()) as _gt13 => match b.value.kind {
                checker::TNullLit => false
                _ => !cg_mangle_eq(b.bound, b.value.type)
            }
            null => false
        }
        _ => false
    }
}

fn cg_binding_routes_str_to_local_region(prog: CgProg, b: checker::TBinding): bool {
    if !cg_bound_is_str(b.bound) { return false }
    match b.value.kind {
        checker::TInterp => true
        checker::TCall as bc => cg_is_concat_bridge(prog, bc)
        _ => false
    }
}

fn cg_block_has_block_local(prog: CgProg, escaping: []str, fn_body: []@TStatement(), block: []@TStatement(), is_value: bool): bool {
    var i: u64 = 0
    loop {
        if i >= block.len { break }
        match block[i] {
            checker::TBinding as b => {
                if cg_binding_is_block_local_slice(prog, escaping, fn_body, block, is_value, b) { return true }
                if checker::binding_is_block_local(escaping, fn_body, block, is_value, b) {
                    if cg_same_named_struct(b.bound, b.value.type) || cg_binding_routes_box_to_local_region(prog, b) || cg_binding_routes_str_to_local_region(prog, b) { return true }
                }
            }
            _ => { }
        }
        i++
    }
    false
}

fn emit_block(buf: teko::io::FileStream, body: []@TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool) {
    var cur = dctx
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        var s = body[i]
        match s {
            checker::TDeferStmt => { cur = dctx_register(cur, s) }
            _ => {
                emit_stmt(buf, s, in_main, prog, ret_type, indent, "", escaping, regions, fn_body, cur, cur_block, cur_block_is_value)
            }
        }
        i++
    }
}

fn emit_block_region(buf: teko::io::FileStream, body: []@TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var defer_floor = dctx.defers.len
    var fall = cg_append_direct_defers(dctx.defers, body)
    var want_block = (cg_block_has_block_local(prog, escaping, fn_body, body, false) || (dctx.rr.len > 0 && cg_block_wants_region(body))) && regions.len < 64 && checker::scope_slot_count(body) > 0
    if !want_block {
        emit_block(buf, body, in_main, prog, ret_type, indent, escaping, regions, fn_body, dctx, [], false)
        emit_defers(buf, fall, defer_floor, prog, indent, escaping, fn_body)
        return
    }
    var region = fresh_named("_tkbr", buf.gensym() to i64)
    buf.write(indent); buf.write("tk_region *"); buf.write(region); buf.write(" = "); cb_region_open(buf, cg_alloc_region(regions, dctx), body); buf.write(";\n")
    var regs2 = [..regions, RegionFrame { name = region; label = ""; is_loop = false; defer_base = defer_floor; decls = cg_block_slice_accums(prog, escaping, fn_body, body, false); bound_names = cg_block_bound_names(body) }]
    emit_block(buf, body, in_main, prog, ret_type, indent, escaping, regs2, fn_body, dctx, body, false)
    emit_defers(buf, fall, defer_floor, prog, indent, escaping, fn_body)
    buf.write(indent); cb_arena_sym(buf, CgArenaSym::RegionDrop); buf.write("("); buf.write(region); buf.write("); "); buf.write(region); buf.write(" = NULL;\n")
}

fn emit_exprstmt_tail(buf: teko::io::FileStream, x: checker::TExpr, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    match x.kind {
        checker::TIfExpr as f => {
            emit_cov_lines(buf, dctx.cov, cov_collect_expr(x, []), indent)
            if !f.has_else { emit_if_stmt(buf, f, x.line, x.col, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx, [], false); return }
            buf.write(indent)
            buf.write("if (")
            emit_expr_ctx(buf, prog, checker::Void { }, f.cond, escaping, regions, fn_body, dctx)
            buf.write(") {\n")
            var inner = cb_indent_deeper(indent)
            emit_cov_branch(buf, dctx.cov, x.line, x.col, 0, inner)
            var then_base = dctx.defers.len
            emit_block_tail(buf, f.then_blk, in_main, prog, ret_type, inner, "", escaping, regions, fn_body, dctx)
            var then_term = if f.then_blk.len > 0 { cg_stmt_c_terminates(f.then_blk[f.then_blk.len - 1]) } else { false }
            if !then_term { emit_defers(buf, cg_append_direct_defers(dctx.defers, f.then_blk), then_base, prog, inner, escaping, fn_body) }
            buf.write(indent)
            buf.write("} else {\n")
            emit_cov_branch(buf, dctx.cov, x.line, x.col, 1, inner)
            var else_base = dctx.defers.len
            emit_block_tail(buf, f.else_blk, in_main, prog, ret_type, inner, "", escaping, regions, fn_body, dctx)
            var else_term = if f.else_blk.len > 0 { cg_stmt_c_terminates(f.else_blk[f.else_blk.len - 1]) } else { false }
            if !else_term { emit_defers(buf, cg_append_direct_defers(dctx.defers, f.else_blk), else_base, prog, inner, escaping, fn_body) }
            buf.write(indent)
            buf.write("}\n")
        }
        checker::TMatchExpr as m => {
            emit_cov_lines(buf, dctx.cov, cov_collect_expr(x, []), indent)
            emit_match_tail(buf, prog, x, m, in_main, ret_type, indent, escaping, regions, fn_body, dctx)
        }
        _ => {
            emit_cov_lines(buf, dctx.cov, cov_collect_expr(x, []), indent)
            if is_void_type(x.type) {
                buf.write(indent)
                emit_expr_ctx(buf, prog, checker::Void { }, x, escaping, regions, fn_body, dctx)
                buf.write(";\n")
                emit_defers(buf, dctx.defers, 0, prog, indent, escaping, fn_body)
                return
            }
            emit_defers(buf, dctx.defers, 0, prog, indent, escaping, fn_body)
            cg_drop_all_regions(buf, indent, regions)
            if !in_main {
                var cleanup = match cg_class_cleanup_text(prog, escaping, fn_body, true, x) { str as c => c; error as e => panic(e.message) }
                if cleanup.len > 0 { buf.write(indent); buf.write(cleanup); buf.write("\n") }
            }
            if !in_main {
                cg_emit_bracket_unwind(buf, indent, dctx.bracket_depth)
                cg_return_frame_exit(buf, indent, frame, dctx)
            }
            var tdctx = if dctx.rr.len > 0 { cg_dctx_with_cur(dctx, dctx.rr) } else { dctx }
            buf.write(indent)
            if in_main {
                buf.write(CG_MAIN_RETURN_OPEN)
                emit_expr_ctx(buf, prog, checker::Void { }, x, escaping, [], fn_body, tdctx)
                buf.write(CG_MAIN_RETURN_CLOSE)
                return
            }
            buf.write("return ")
            emit_as_r(buf, prog, ret_type, ret_type, x, escaping, [], fn_body, tdctx)
            buf.write(";\n")
        }
    }
}

fn emit_block_tail(buf: teko::io::FileStream, body: []@TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var cur = dctx
    var i: u64 = 0
    loop {
        if i + 1 >= body.len { break }
        var s = body[i]
        match s {
            checker::TDeferStmt => { cur = dctx_register(cur, s) }
            _ => {
                emit_stmt(buf, s, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, cur, [], false)
            }
        }
        i++
    }
    if body.len == 0 { return }
    var last = body[body.len - 1]
    match last {
        checker::TDeferStmt => { }
        checker::TExprStmt as es => emit_exprstmt_tail(buf, es.expr, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, cur)
        _ => emit_stmt(buf, last, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, cur, [], false)
    }
}

fn emit_if_stmt(buf: teko::io::FileStream, f: checker::TIfExpr, line: u32, col: u32, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool) {
    buf.write(indent)
    buf.write("if (")
    emit_expr_ctx(buf, prog, checker::Void { }, f.cond, escaping, regions, fn_body, dctx)
    buf.write(") {\n")
    var inner = cb_indent_deeper(indent)
    emit_cov_branch(buf, dctx.cov, line, col, 0, inner)
    emit_block_region(buf, f.then_blk, in_main, prog, ret_type, inner, frame, escaping, regions, fn_body, dctx)
    if f.has_else {
        buf.write(indent)
        buf.write("} else {\n")
        emit_cov_branch(buf, dctx.cov, line, col, 1, inner)
        emit_block_region(buf, f.else_blk, in_main, prog, ret_type, inner, frame, escaping, regions, fn_body, dctx)
    } else if dctx.cov.on {
        buf.write(indent)
        buf.write("} else {\n")
        emit_cov_branch(buf, dctx.cov, line, col, 1, inner)
    }
    buf.write(indent)
    buf.write("}\n")
}

fn emit_binding(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), b: checker::TBinding, indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool) {
    var name = match b.target {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => panic("codegen: destructuring binding not yet supported")
    }
    if name == "_" {
        buf.write(indent)
        buf.write("(void)(")
        emit_as_r(buf, prog, ret_type, b.bound, b.value, escaping, regions, fn_body, dctx)
        buf.write(");\n")
        return
    }
    buf.write(indent)
    if b.kind == parser::BindKind::Const { buf.write("const ") }
    emit_type(buf, prog, b.bound)
    buf.write(" ")
    cb_ident(buf, name)
    buf.write(" = ")
    if regions.len > 0 && cur_block.len > 0 && cg_same_named_struct(b.bound, b.value.type) && checker::binding_is_block_local(escaping, fn_body, cur_block, cur_block_is_value, b) {
        match b.value.kind {
            checker::TStructInit as si => {
                emit_struct_init_framed(buf, prog, b.value, si, regions[regions.len - 1].name, escaping, regions, fn_body, dctx)
                buf.write(";\n")
                return
            }
            _ => { }
        }
    }
    if regions.len > 0 && cur_block.len > 0 && cg_binding_routes_str_to_local_region(prog, b) && checker::binding_is_block_local(escaping, fn_body, cur_block, cur_block_is_value, b) {
        match b.value.kind {
            checker::TInterp as bin => {
                emit_interp(buf, prog, bin, escaping, regions, fn_body, dctx)
                buf.write(";\n")
                return
            }
            checker::TCall as bc => {
                if cg_is_concat_bridge(prog, bc) {
                    emit_concat_fold(buf, prog, bc.args[0], escaping, regions, fn_body, dctx)
                    buf.write(";\n")
                    return
                }
            }
            _ => { }
        }
    }
    if frame.len > 0 && checker::binding_is_frame_local(escaping, b) && cg_same_named_struct(b.bound, b.value.type) {
        match b.value.kind {
            checker::TStructInit as si => {
                emit_struct_init_framed(buf, prog, b.value, si, frame, escaping, regions, fn_body, dctx)
                buf.write(";\n")
                return
            }
            _ => { }
        }
    }
    var box_region = if regions.len > 0 && cur_block.len > 0 && checker::binding_is_block_local(escaping, fn_body, cur_block, cur_block_is_value, b) && cg_binding_routes_box_to_local_region(prog, b) {
        regions[regions.len - 1].name
    } else if frame.len > 0 && checker::binding_is_frame_local(escaping, b) && cg_binding_routes_box_to_local_region(prog, b) {
        frame
    } else {
        ""
    }
    emit_as_r_in(buf, prog, ret_type, b.bound, b.value, box_region, escaping, regions, fn_body, dctx)
    buf.write(";\n")
}

fn emit_assign_lvalue(buf: teko::io::FileStream, prog: CgProg, a: checker::TAssign) {
    match a.kind {
        parser::AssignKind::Field => emit_expr(buf, prog, a.target)
        _ => {
            if a.deref {
                buf.write("(*")
                cb_ident(buf, a.name)
                buf.write(")")
            } else {
                cb_ident(buf, a.name)
            }
        }
    }
}

fn emit_index_assign(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), a: checker::TAssign, indent: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var ix = match a.target.kind { checker::TIndex as ti => ti; _ => panic("codegen: index-assign target is not a subscript (internal)") }
    var elem = match ix.receiver.type { checker::Slice as sl => sl.element; _ => panic("codegen: index-assign receiver is not a slice (internal)") }
    var wstmp = $"_ws{buf.gensym()}"
    var witmp = $"_wi{buf.gensym()}"
    buf.write(indent)
    buf.write("{ ")
    emit_type(buf, prog, ix.receiver.type)
    buf.write(" ")
    buf.write(wstmp)
    buf.write(" = (")
    emit_expr_ctx(buf, prog, checker::Void { }, ix.receiver, escaping, regions, fn_body, dctx)
    buf.write("); uint64_t ")
    buf.write(witmp)
    buf.write(" = (uint64_t)(")
    emit_expr_ctx(buf, prog, checker::Void { }, ix.index, escaping, regions, fn_body, dctx)
    buf.write("); if (")
    buf.write(witmp)
    buf.write(" < ")
    buf.write(wstmp)
    buf.write(".len) { ")
    emit_index_store_body(buf, prog, ret_type, a, wstmp, witmp, elem, escaping, regions, fn_body, dctx)
    buf.write(" } else { ")
    buf.write(cb_fn_name_str("teko::runtime", "panic_oob_at"))
    buf.write("(")
    cb_u64_digits(buf, a.target.line to u64)
    buf.write(", ")
    cb_u64_digits(buf, a.target.col to u64)
    buf.write("); }\n }\n")
}

fn emit_index_store_body(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), a: checker::TAssign, wstmp: str, witmp: str, elem: @Type(), escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if a.op == lexer::TokenKind::ShlEq || a.op == lexer::TokenKind::ShrEq {
        var prim = match elem { checker::Prim as p => p; _ => panic("codegen: shift-assign on a non-integer slice element not supported") }
        if !cg_prim_is_int(prim.kind) { panic("codegen: shift-assign on a non-integer slice element not supported") }
        var tag = match prim_int_tag(prim.kind) { str as t => t; error => panic("codegen: shift-assign on a non-integer slice element not supported") }
        var fn_prefix = if a.op == lexer::TokenKind::ShlEq { "tk_shl_" } else { "tk_shr_" }
        emit_index_slot(buf, wstmp, witmp)
        buf.write(" = ")
        buf.write(fn_prefix)
        buf.write(tag)
        buf.write("(")
        emit_index_slot(buf, wstmp, witmp)
        buf.write(", ")
        emit_expr_ctx(buf, prog, checker::Void { }, a.value, escaping, regions, fn_body, dctx)
        buf.write(");")
        return
    }
    var op = match assignop_c(a.op) { str as s => s; error as err => panic(err.message) }
    emit_index_slot(buf, wstmp, witmp)
    buf.write(" ")
    buf.write(op)
    buf.write(" ")
    emit_as_r(buf, prog, ret_type, elem, a.value, escaping, regions, fn_body, dctx)
    buf.write(";")
}

fn emit_index_slot(buf: teko::io::FileStream, wstmp: str, witmp: str) {
    buf.write(wstmp)
    buf.write(".ptr[")
    buf.write(witmp)
    buf.write("]")
}

fn emit_assign(buf: teko::io::FileStream, prog: CgProg, ret_type: @Type(), a: checker::TAssign, indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var is_index = match a.kind { parser::AssignKind::Index => true; _ => false }
    if is_index { emit_index_assign(buf, prog, ret_type, a, indent, escaping, regions, fn_body, dctx); return }
    if a.op == lexer::TokenKind::Assign && checker::assign_frees_old(fn_body, a) {
        var nm = $"_tkna{buf.gensym()}"
        buf.write(indent)
        buf.write("{ ")
        emit_type(buf, prog, a.bound)
        buf.write(" ")
        buf.write(nm)
        buf.write(" = ")
        emit_as_r(buf, prog, ret_type, a.bound, a.value, escaping, regions, fn_body, dctx)
        buf.write("; ")
        cb_arena_sym(buf, CgArenaSym::FreeBlock)
        buf.write("((uint64_t)(uintptr_t)")
        emit_assign_lvalue(buf, prog, a)
        buf.write(".ptr, (uint64_t)")
        emit_assign_lvalue(buf, prog, a)
        buf.write(".len * sizeof(*")
        emit_assign_lvalue(buf, prog, a)
        buf.write(".ptr)); ")
        emit_assign_lvalue(buf, prog, a)
        buf.write(" = ")
        buf.write(nm)
        buf.write("; }\n")
        return
    }
    var op = match assignop_c(a.op) { str as s => s; error as err => panic(err.message) }
    buf.write(indent)
    if a.op == lexer::TokenKind::ShlEq || a.op == lexer::TokenKind::ShrEq {
        var prim = match a.bound {
            checker::Prim as p => p
            _ => panic("codegen: shift-assign on a non-integer type not yet supported")
        }
        if !cg_prim_is_int(prim.kind) {
            panic("codegen: shift-assign on a non-integer type not yet supported")
        }
        var tag = match prim_int_tag(prim.kind) {
            str as t => t
            error => panic("codegen: shift-assign on a non-integer type not yet supported")
        }
        var fn_prefix = if a.op == lexer::TokenKind::ShlEq { "tk_shl_" } else { "tk_shr_" }
        emit_assign_lvalue(buf, prog, a)
        buf.write(" = ")
        buf.write(fn_prefix)
        buf.write(tag)
        buf.write("(")
        emit_assign_lvalue(buf, prog, a)
        buf.write(", ")
        emit_expr_ctx(buf, prog, checker::Void { }, a.value, escaping, regions, fn_body, dctx)
        buf.write(")")
        buf.write(";\n")
        return
    }
    if a.op == lexer::TokenKind::SlashEq || a.op == lexer::TokenKind::PercentEq {
        emit_div_mod_assign(buf, prog, a, escaping, regions, fn_body, dctx)
        return
    }
    emit_assign_lvalue(buf, prog, a)
    buf.write(" ")
    buf.write(op)
    buf.write(" ")
    emit_as_r(buf, prog, ret_type, a.bound, a.value, escaping, regions, fn_body, dctx)
    buf.write(";\n")
}

fn emit_return(buf: teko::io::FileStream, prog: CgProg, r: checker::TReturn, in_main: bool, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    emit_defers(buf, dctx.defers, 0, prog, indent, escaping, fn_body)
    cg_drop_all_regions(buf, indent, regions)
    var no_tail = checker::TExpr { kind = checker::TNullLit { }; type = checker::Void { }; line = 0; col = 0 }
    var cleanup = if r.has_value {
        match cg_class_cleanup_text(prog, escaping, fn_body, true, r.value) { str as c => c; error as e => panic(e.message) }
    } else {
        match cg_class_cleanup_text(prog, escaping, fn_body, false, no_tail) { str as c => c; error as e => panic(e.message) }
    }
    if cleanup.len > 0 { buf.write(indent); buf.write(cleanup); buf.write("\n") }
    cg_emit_bracket_unwind(buf, indent, dctx.bracket_depth)
    cg_return_frame_exit(buf, indent, frame, dctx)
    buf.write(indent)
    if !r.has_value {
        if in_main { buf.write("return 0;\n"); return }
        buf.write("return;\n")
        return
    }
    var ret_regions: []RegionFrame = []
    var rdctx = if dctx.rr.len > 0 { cg_dctx_with_cur(dctx, dctx.rr) } else { dctx }
    if in_main {
        buf.write(CG_MAIN_RETURN_OPEN)
        emit_expr_ctx(buf, prog, checker::Void { }, r.value, escaping, ret_regions, fn_body, rdctx)
        buf.write(CG_MAIN_RETURN_CLOSE)
        return
    }
    buf.write("return ")
    emit_as_r(buf, prog, ret_type, ret_type, r.value, escaping, ret_regions, fn_body, rdctx)
    buf.write(";\n")
}

/**
 * cg_dctx_with_cur — a copy of `dctx` whose current allocation region is pinned to `region`, without
 * changing the bracket depth. Used where the ambient region has already been switched (e.g. a return
 * after the frame's own region was left) so later allocations name the surviving region explicitly.
 *
 * @param dctx    the defer context
 * @param region  the region later allocations must name
 * @return        `dctx` with `cur = region`
 */
fn cg_dctx_with_cur(dctx: DeferCtx, region: str): DeferCtx {
    DeferCtx { defers = dctx.defers; loops = dctx.loops; cov = dctx.cov; rr = dctx.rr; bracket_depth = dctx.bracket_depth; cur = region; regbase = dctx.regbase }
}

fn emit_loop(buf: teko::io::FileStream, l: checker::TLoopStmt, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    if l.init.len == 0 { emit_loop_while(buf, l, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx); return }
    buf.write(indent)
    buf.write("{\n")
    var inner = cb_indent_deeper(indent)
    emit_block(buf, l.init, in_main, prog, ret_type, inner, escaping, regions, fn_body, dctx, [], false)
    emit_loop_while(buf, l, in_main, prog, ret_type, inner, frame, escaping, regions, fn_body, dctx)
    buf.write(indent)
    buf.write("}\n")
}

fn emit_loop_while(buf: teko::io::FileStream, l: checker::TLoopStmt, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var labeled = l.label.len > 0
    buf.write(indent)
    buf.write("while (1) {\n")
    var inner = cb_indent_deeper(indent)
    if labeled { buf.write(inner); buf.write("tk_lbl_"); buf.write(l.label); buf.write("_cont: ;\n") }
    var defer_floor = dctx.defers.len
    var fall = cg_append_direct_defers(dctx.defers, l.body)
    var dctx2 = DeferCtx { defers = dctx.defers; loops = [..dctx.loops, LoopDeferFrame { label = l.label; defer_base = defer_floor; region_base = regions.len }]; cov = dctx.cov; rr = dctx.rr; bracket_depth = dctx.bracket_depth; cur = dctx.cur; regbase = dctx.regbase }
    var want_block = (cg_block_has_block_local(prog, escaping, fn_body, l.body, false) || (dctx.rr.len > 0 && cg_block_wants_region(l.body))) && regions.len < 64 && checker::scope_slot_count(l.body) > 0
    var region = if want_block { fresh_named("_tkbr", buf.gensym() to i64) } else { "" }
    var regs2 = regions
    if want_block {
        buf.write(inner); buf.write("tk_region *"); buf.write(region); buf.write(" = "); cb_region_open(buf, cg_alloc_region(regions, dctx), l.body); buf.write(";\n")
        regs2 = [..regions, RegionFrame { name = region; label = l.label; is_loop = true; defer_base = defer_floor; decls = cg_block_slice_accums(prog, escaping, fn_body, l.body, false); bound_names = cg_block_bound_names(l.body) }]
    }
    var cur_blk = if want_block { l.body } else { [] }
    emit_block(buf, l.body, in_main, prog, ret_type, inner, escaping, regs2, fn_body, dctx2, cur_blk, false)
    emit_defers(buf, fall, defer_floor, prog, inner, escaping, fn_body)
    if want_block { buf.write(inner); cb_arena_sym(buf, CgArenaSym::RegionDrop); buf.write("("); buf.write(region); buf.write("); "); buf.write(region); buf.write(" = NULL;\n") }
    buf.write(indent)
    buf.write("}\n")
    if labeled { buf.write(indent); buf.write("tk_lbl_"); buf.write(l.label); buf.write("_break: ;\n") }
}

fn cb_indent_deeper(indent: str): str {
    var n = indent.len
    var total = n + 4
    var xs: [total]byte = []
    var i: u64 = 0
    loop {
        if i >= n { break }
        xs[i] = indent[i]
        i = i + 1
    }
    xs[n] = b' '
    xs[n + 1] = b' '
    xs[n + 2] = b' '
    xs[n + 3] = b' '
    str(xs)
}

fn cov_push_line(acc: []u32, line: u32): []u32 {
    if line == 0 { return acc }
    var i: u64 = 0
    loop { if i >= acc.len { break }; if acc[i] == line { return acc }; i = i + 1 }
    [..acc, line]
}

fn cov_collect_expr(e: checker::TExpr, acc: []u32): []u32 {
    var a0 = cov_push_line(acc, e.line)
    match e.kind {
        checker::TBinary as b => cov_collect_expr(b.right, cov_collect_expr(b.left, a0))
        checker::TUnary as u => cov_collect_expr(u.operand, a0)
        checker::TCompare as c => {
            var a = cov_collect_expr(c.first, a0)
            var i = 0
            loop { if i >= c.rest.len { break }; a = cov_collect_expr(c.rest[i].operand, a); i++ }
            a
        }
        checker::TCall as c => {
            var a = a0
            var i = 0
            loop { if i >= c.args.len { break }; a = cov_collect_expr(c.args[i], a); i++ }
            a
        }
        checker::TCast as c => cov_collect_expr(c.expr, a0)
        checker::TFieldAccess as fa => cov_collect_expr(fa.receiver, a0)
        checker::TIndex as ix => cov_collect_expr(ix.index, cov_collect_expr(ix.receiver, a0))
        checker::TStructInit as si => {
            var a = a0
            var i = 0
            loop { if i >= si.field_vals.len { break }; a = cov_collect_expr(si.field_vals[i], a); i++ }
            a
        }
        checker::TInterp as in => {
            var a = a0
            var i = 0
            loop {
                if i >= in.holes.len { break }
                a = cov_collect_expr(in.holes[i], a)
                if i < in.specs.len {
                    match in.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; a = cov_collect_expr(fd.args[k], a); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            a
        }
        checker::TInExpr as ie => {
            var a = cov_collect_expr(ie.lhs, a0)
            var i = 0
            loop { if i >= ie.elems.len { break }; a = cov_collect_expr(ie.elems[i], a); i++ }
            a
        }
        checker::TArrayLit as al => {
            var a = a0
            var i = 0
            loop { if i >= al.elements.len { break }; a = cov_collect_expr(al.elements[i].expr, a); i++ }
            a
        }
        checker::TIfExpr as f => cov_collect_expr(f.cond, a0)
        checker::TMatchExpr as m => {
            var a = cov_collect_expr(m.subject, a0)
            var i = 0
            loop { if i >= m.arms.len { break }; if m.arms[i].has_when { a = cov_collect_expr(m.arms[i].guard, a) }; i++ }
            a
        }
        _ => a0
    }
}

fn stmt_cov_lines(s: @TStatement()): []u32 {
    var acc: []u32 = []
    match s {
        checker::TBinding as b => cov_collect_expr(b.value, acc)
        checker::TAssign as a => {
            var av = cov_collect_expr(a.value, acc)
            if parser::assign_has_target(a.kind) { cov_collect_expr(a.target, av) } else { av }
        }
        checker::TReturn as r => if r.has_value { cov_collect_expr(r.value, acc) } else { acc }
        checker::TExprStmt as es => cov_collect_expr(es.expr, acc)
        _ => acc
    }
}

fn emit_cov_lines(buf: teko::io::FileStream, ctx: CovCtx, lines: []u32, indent: str) {
    if !ctx.on { return }
    var i: u64 = 0
    loop { if i >= lines.len { break }; emit_cov_line(buf, ctx, lines[i], indent); i = i + 1 }
}

fn emit_stmt(buf: teko::io::FileStream, s: @TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool) {
    emit_stmt_body(buf, s, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx, cur_block, cur_block_is_value)
    if prog.uses_capture && cg_stmt_needs_panic_guard(s) && cg_stmt_calls_maypanic(prog, s) {
        emit_panic_guard(buf, prog, in_main, ret_type, indent, frame, escaping, regions, fn_body, dctx)
    }
}

fn cg_stmt_needs_panic_guard(s: @TStatement()): bool {
    match s {
        checker::TReturn => false
        checker::TBreakStmt => false
        checker::TContinueStmt => false
        checker::TDeferStmt => false
        _ => true
    }
}

fn emit_panic_sentinel_return(buf: teko::io::FileStream, prog: CgProg, in_main: bool, ret_type: @Type(), indent: str) {
    buf.write(indent)
    if in_main { buf.write("return 0;\n"); return }
    if is_void_type(ret_type) { buf.write("return;\n"); return }
    buf.write("return (")
    emit_type(buf, prog, ret_type)
    buf.write("){0};\n")
}

fn emit_panic_guard(buf: teko::io::FileStream, prog: CgProg, in_main: bool, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    buf.write(indent)
    buf.write("if (")
    cb_fn_name(buf, "teko::runtime", "panicking")
    buf.write("()) {\n")
    var inner = cb_indent_deeper(indent)
    emit_defers(buf, dctx.defers, 0, prog, inner, escaping, fn_body)
    cg_drop_all_regions(buf, inner, regions)
    cg_emit_bracket_unwind(buf, inner, dctx.bracket_depth)
    cg_return_frame_exit(buf, inner, frame, dctx)
    emit_panic_sentinel_return(buf, prog, in_main, ret_type, inner)
    buf.write(indent)
    buf.write("}\n")
}

fn emit_stmt_body(buf: teko::io::FileStream, s: @TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool) {
    emit_cov_lines(buf, dctx.cov, stmt_cov_lines(s), indent)
    if dctx.rr.len > 0 && dctx.bracket_depth == 0 && cg_conveys_escape_deep(escaping, s) {
        buf.write(indent); cb_arena_sym(buf, CgArenaSym::RegionEnter); buf.write("("); buf.write(dctx.rr); buf.write(");\n")
        var d2 = cg_dctx_bracket_cur(dctx, dctx.rr)
        emit_stmt_dispatch(buf, s, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, d2, cur_block, cur_block_is_value)
        buf.write(indent); cb_arena_sym(buf, CgArenaSym::RegionLeave); buf.write("();\n")
        return
    }
    if dctx.rr.len > 0 && dctx.bracket_depth == 0 && regions.len > 0 {
        var wt = cg_stmt_write_target(s)
        if wt != "" && !str_list_has(regions[regions.len - 1].bound_names, wt) {
            var res = cg_write_residence(regions, wt)
            buf.write(indent); cb_arena_sym(buf, CgArenaSym::RegionEnter); buf.write("("); buf.write(res); buf.write(");\n")
            var rd2 = cg_dctx_bracket_cur(dctx, res)
            emit_stmt_dispatch(buf, s, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, rd2, cur_block, cur_block_is_value)
            buf.write(indent); cb_arena_sym(buf, CgArenaSym::RegionLeave); buf.write("();\n")
            return
        }
    }
    emit_stmt_dispatch(buf, s, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx, cur_block, cur_block_is_value)
}

fn emit_stmt_dispatch(b0: teko::io::FileStream, s: @TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool) {
    match s {
        checker::TBinding as b => emit_binding(b0, prog, ret_type, b, indent, frame, escaping, regions, fn_body, dctx, cur_block, cur_block_is_value)
        checker::TAssign as a => emit_assign(b0, prog, ret_type, a, indent, frame, escaping, regions, fn_body, dctx)
        checker::TReturn as r => emit_return(b0, prog, r, in_main, ret_type, indent, frame, escaping, regions, fn_body, dctx)
        checker::TExprStmt as es => {
            match es.expr.kind {
                checker::TIfExpr as f => emit_if_stmt(b0, f, es.expr.line, es.expr.col, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx, cur_block, cur_block_is_value)
                checker::TMatchExpr as m => emit_match_stmt(b0, prog, es.expr, m, in_main, ret_type, indent, frame, escaping, regions, fn_body, dctx, cur_block, cur_block_is_value)
                _ => emit_expr_stmt_default(b0, es.expr, prog, escaping, regions, fn_body, dctx, indent)
            }
        }
        checker::TLoopStmt as l => emit_loop(b0, l, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx)
        checker::TBreakStmt as b => {
            emit_defers(b0, dctx.defers, cg_target_defer_base(dctx.loops, b.label), prog, indent, escaping, fn_body)
            cg_emit_bracket_unwind(b0, indent, dctx.bracket_depth)
            cg_drop_regions_from(b0, indent, regions, cg_target_region_base(dctx.loops, b.label))
            b0.write(indent)
            if b.label.len > 0 { b0.write("goto tk_lbl_"); b0.write(b.label); b0.write("_break;\n") }
            else { b0.write("break;\n") }
        }
        checker::TContinueStmt as c => {
            emit_defers(b0, dctx.defers, cg_target_defer_base(dctx.loops, c.label), prog, indent, escaping, fn_body)
            cg_emit_bracket_unwind(b0, indent, dctx.bracket_depth)
            cg_drop_regions_from(b0, indent, regions, cg_target_region_base(dctx.loops, c.label))
            b0.write(indent)
            if c.label.len > 0 { b0.write("goto tk_lbl_"); b0.write(c.label); b0.write("_cont;\n") }
            else { b0.write("continue;\n") }
        }
        checker::TDeferStmt => { }
        checker::TAdoptStmt as a => emit_adopt(b0, a, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx)
        checker::TBlockStmt as b => emit_block_region(b0, b.body, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx)
        checker::TSpawn as sp => emit_spawn(b0, sp, prog, escaping, regions, fn_body, dctx, indent)
    }
}

fn cg_spawn_arg_is_fat(t: @Type()): bool {
    if cg_is_str_type(t) { return true }
    match t {
        checker::Slice => true
        _ => false
    }
}

fn cg_ctype_text(prog: CgProg, t: @Type()): str {
    emit_type_str(prog, t)
}

fn cg_spawn_target_name(buf: teko::io::FileStream, prog: CgProg, c: checker::TCall) {
    var last = cg_path_last(c.callee)
    match cg_find_function(prog, c.call_ns, last) {
        checker::TFunction as cf => if cf.is_extern { buf.write(cf.c_symbol) } else { cb_fn_name(buf, c.call_ns, last, c.overload_suffix) }
        error => cb_fn_name(buf, c.call_ns, last, c.overload_suffix)
    }
}

fn emit_spawn_thunks(buf: teko::io::FileStream, prog: CgProg, spawns: []checker::TSpawn) {
    var i: u64 = 0
    loop {
        if i >= spawns.len { break }
        emit_spawn_thunk_one(buf, prog, spawns[i])
        i = i + 1
    }
}

fn emit_spawn_thunk_one(buf: teko::io::FileStream, prog: CgProg, sp: checker::TSpawn) {
    var c = match sp.call.kind { checker::TCall as tc => tc; _ => panic("internal: spawn target is not a call at codegen") }
    var k = sp.id
    var args = c.args
    buf.write($"typedef struct {{ ")
    var i: u64 = 0
    loop {
        if i >= args.len { break }
        emit_type(buf, prog, args[i].type)
        buf.write($" a{i}; ")
        i = i + 1
    }
    if args.len == 0 { buf.write("char _pad; ") }
    buf.write($"}} tk_spawn_ctx_{k};\n")
    buf.write($"static tk_spawn_ctx_{k} *tk_spawn_pack_{k}(")
    if args.len == 0 { buf.write("void") }
    i = 0
    loop {
        if i >= args.len { break }
        if i > 0 { buf.write(", ") }
        emit_type(buf, prog, args[i].type)
        buf.write($" a{i}")
        i = i + 1
    }
    buf.write($") {{\n    size_t _need = sizeof(tk_spawn_ctx_{k});\n")
    i = 0
    loop {
        if i >= args.len { break }
        if cg_spawn_arg_is_fat(args[i].type) {
            var bytes_expr = cg_spawn_fat_bytes(prog, args[i].type, i)
            buf.write($"    _need += 15u + {bytes_expr};\n")
        }
        i = i + 1
    }
    var panic_sym = cb_fn_name_str("teko::runtime", "panic_oom")
    buf.write($"    char *_blk = (char *)malloc(_need ? _need : 1); if (!_blk) {panic_sym}();\n")
    buf.write($"    tk_spawn_ctx_{k} *_c = (tk_spawn_ctx_{k} *)_blk;\n")
    buf.write($"    char *_tail = _blk + sizeof(tk_spawn_ctx_{k}); (void)_tail;\n")
    i = 0
    loop {
        if i >= args.len { break }
        emit_spawn_pack_field(buf, prog, args[i].type, i)
        i = i + 1
    }
    buf.write("    return _c;\n}\n")
    buf.write($"static void tk_spawn_tramp_{k}(void *_raw) {{\n    tk_spawn_ctx_{k} *_c = (tk_spawn_ctx_{k} *)_raw; (void)_c;\n    ")
    cg_spawn_target_name(buf, prog, c)
    buf.write("(")
    i = 0
    loop {
        if i >= args.len { break }
        if i > 0 { buf.write(", ") }
        buf.write($"_c->a{i}")
        i = i + 1
    }
    if cg_spawn_target_wants_region(prog, c) {
        if args.len > 0 { buf.write(", ") }
        cb_arena_sym(buf, CgArenaSym::RegionRoot); buf.write("()")
    }
    buf.write(");\n    free(_raw);\n}\n")
}

/**
 * cg_spawn_target_wants_region — true when the spawned call's target function is above the line and so
 * must receive a region. A spawned thread has no caller region, so it is handed the program root.
 *
 * @param prog  the codegen program
 * @param c     the spawned call node
 * @return      true iff the resolved target function receives `_tkrgn`
 */
fn cg_spawn_target_wants_region(prog: CgProg, c: checker::TCall): bool {
    if c.is_closure_call || c.is_iface_dispatch { return false }
    if c.callee.segments.len == 0 { return false }
    match cg_find_function(prog, c.call_ns, c.callee.segments[c.callee.segments.len - 1].name) {
        checker::TFunction as tf => cg_fn_needs_region(prog, tf)
        error => false
    }
}

fn cg_spawn_fat_bytes(prog: CgProg, t: @Type(), i: u64): str {
    if cg_is_str_type(t) { return $"(size_t)a{i}.len" }
    match t {
        checker::Slice as sl => {
            var elem = cg_ctype_text(prog, sl.element)
            $"(size_t)a{i}.len * sizeof({elem})"
        }
        _ => panic("internal: cg_spawn_fat_bytes on a non-fat spawn argument")
    }
}

fn emit_spawn_pack_field(buf: teko::io::FileStream, prog: CgProg, t: @Type(), i: u64) {
    if cg_is_str_type(t) { buf.write($"    _tail = (char *)(((uintptr_t)_tail + 15u) & ~(uintptr_t)15u); tk_memcpy(_tail, (const void *)a{i}.ptr, (uintptr_t)a{i}.len); _c->a{i}.ptr = (const tk_byte *)_tail; _c->a{i}.len = a{i}.len; _tail += a{i}.len;\n"); return }
    match t {
        checker::Slice as sl => {
            var elem = cg_ctype_text(prog, sl.element)
            buf.write($"    {{ uintptr_t _n = (uintptr_t)a{i}.len * sizeof({elem}); _tail = (char *)(((uintptr_t)_tail + 15u) & ~(uintptr_t)15u); tk_memcpy(_tail, (const void *)a{i}.ptr, _n); _c->a{i}.ptr = ({elem} *)_tail; _c->a{i}.len = a{i}.len; _tail += _n; }}\n")
        }
        _ => buf.write($"    _c->a{i} = a{i};\n")
    }
}

fn emit_spawn(buf: teko::io::FileStream, sp: checker::TSpawn, prog: CgProg, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, indent: str) {
    var c = match sp.call.kind { checker::TCall as tc => tc; _ => panic("internal: spawn target is not a call at codegen") }
    var k = sp.id
    buf.write(indent)
    buf.write($"{{ tk_spawn_ctx_{k} *_sc = tk_spawn_pack_{k}(")
    var i: u64 = 0
    loop {
        if i >= c.args.len { break }
        if i > 0 { buf.write(", ") }
        emit_expr_ctx(buf, prog, checker::Void { }, c.args[i], escaping, regions, fn_body, dctx)
        i = i + 1
    }
    buf.write($"); tk_thread_spawn(tk_spawn_tramp_{k}, _sc); }}\n")
}

fn emit_expr_stmt_default(buf: teko::io::FileStream, expr: checker::TExpr, prog: CgProg, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, indent: str) {
    if checker::texpr_diverges(expr) {
        emit_defers(buf, dctx.defers, 0, prog, indent, escaping, fn_body)
    }
    buf.write(indent)
    emit_expr_ctx(buf, prog, checker::Void { }, expr, escaping, regions, fn_body, dctx)
    buf.write(";\n")
}

fn emit_adopt(buf: teko::io::FileStream, a: checker::TAdoptStmt, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx) {
    var defer_floor = dctx.defers.len
    var fall = cg_append_direct_defers(dctx.defers, a.body)
    var region = fresh_named("_tkad", buf.gensym() to i64)
    buf.write(indent); buf.write("tk_region *"); buf.write(region); buf.write(" = "); cb_region_open(buf, cg_alloc_region(regions, dctx), a.body); buf.write(";\n")
    var regs2 = [..regions, RegionFrame { name = region; label = ""; is_loop = false; defer_base = defer_floor; decls = []; bound_names = cg_block_bound_names(a.body) }]
    emit_block(buf, a.body, in_main, prog, ret_type, indent, escaping, regs2, fn_body, dctx, a.body, false)
    emit_defers(buf, fall, defer_floor, prog, indent, escaping, fn_body)
    buf.write(indent); cb_arena_sym(buf, CgArenaSym::RegionDropSubtree); buf.write("("); buf.write(region); buf.write("); "); buf.write(region); buf.write(" = NULL;\n")
}

fn cg_expr_calls_self(e: checker::TExpr, ns: str, name: str): bool {
    match e.kind {
        checker::TCall as c => {
            if !c.is_closure_call && !c.is_iface_dispatch && c.call_ns == ns && cg_path_last(c.callee) == name { return true }
            var i = 0
            loop { if i >= c.args.len { break }; if cg_expr_calls_self(c.args[i], ns, name) { return true }; i++ }
            false
        }
        checker::TBinary as b => cg_expr_calls_self(b.left, ns, name) || cg_expr_calls_self(b.right, ns, name)
        checker::TUnary as u => cg_expr_calls_self(u.operand, ns, name)
        checker::TCompare as c => {
            if cg_expr_calls_self(c.first, ns, name) { return true }
            var i = 0
            loop { if i >= c.rest.len { break }; if cg_expr_calls_self(c.rest[i].operand, ns, name) { return true }; i++ }
            false
        }
        checker::TIfExpr as f => cg_expr_calls_self(f.cond, ns, name) || cg_block_calls_self(f.then_blk, ns, name) || cg_block_calls_self(f.else_blk, ns, name)
        checker::TMatchExpr as m => {
            if cg_expr_calls_self(m.subject, ns, name) { return true }
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when && cg_expr_calls_self(m.arms[i].guard, ns, name) { return true }
                if cg_block_calls_self(m.arms[i].body, ns, name) { return true }
                i++
            }
            false
        }
        checker::TCast as c => cg_expr_calls_self(c.expr, ns, name)
        checker::TFieldAccess as fa => cg_expr_calls_self(fa.receiver, ns, name)
        checker::TStructInit as si => {
            var i = 0
            loop { if i >= si.field_vals.len { break }; if cg_expr_calls_self(si.field_vals[i], ns, name) { return true }; i++ }
            false
        }
        checker::TIndex as ix => cg_expr_calls_self(ix.receiver, ns, name) || cg_expr_calls_self(ix.index, ns, name)
        checker::TInterp as ip => {
            var i = 0
            loop {
                if i >= ip.holes.len { break }
                if cg_expr_calls_self(ip.holes[i], ns, name) { return true }
                if i < ip.specs.len {
                    match ip.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; if cg_expr_calls_self(fd.args[k], ns, name) { return true }; k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            false
        }
        checker::TInExpr as ie => {
            if cg_expr_calls_self(ie.lhs, ns, name) { return true }
            var i = 0
            loop { if i >= ie.elems.len { break }; if cg_expr_calls_self(ie.elems[i], ns, name) { return true }; i++ }
            false
        }
        checker::TArrayLit as al => {
            var i = 0
            loop { if i >= al.elements.len { break }; if cg_expr_calls_self(al.elements[i].expr, ns, name) { return true }; i++ }
            false
        }
        checker::TLambda as lam => cg_block_calls_self(lam.body, ns, name)
        checker::TBlockExpr as blk => cg_block_calls_self(blk.body, ns, name)
        _ => false
    }
}

fn cg_block_calls_self(stmts: []@TStatement(), ns: str, name: str): bool {
    var i = 0
    loop {
        if i >= stmts.len { break }
        match stmts[i] {
            checker::TBinding as b => if cg_expr_calls_self(b.value, ns, name) { return true }
            checker::TAssign as a => { if cg_expr_calls_self(a.value, ns, name) { return true }; if parser::assign_has_target(a.kind) { if cg_expr_calls_self(a.target, ns, name) { return true } } }
            checker::TReturn as r => if r.has_value && cg_expr_calls_self(r.value, ns, name) { return true }
            checker::TLoopStmt as l => { if cg_block_calls_self(l.init, ns, name) { return true }; if cg_block_calls_self(l.body, ns, name) { return true } }
            checker::TExprStmt as es => if cg_expr_calls_self(es.expr, ns, name) { return true }
            checker::TDeferStmt as d => if cg_block_calls_self(d.body, ns, name) { return true }
            checker::TAdoptStmt as a => if cg_block_calls_self(a.body, ns, name) { return true }
            checker::TBlockStmt as b => if cg_block_calls_self(b.body, ns, name) { return true }
            _ => { }
        }
        i++
    }
    false
}

fn cg_fn_is_self_recursive(f: checker::TFunction): bool {
    if f.is_extern { return false }
    cg_block_calls_self(f.body, f.namespace, f.name)
}

fn cg_fn_ref_ns(prog: CgProg, ns: str): str {
    if prog.ix.exact.slots.len != 0 {
        if cg_table_get(prog.ix.exact, ns) != 0 { return checker::name_qualifier(ns) }
        return ns
    }
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => { if d.name == ns { return checker::name_qualifier(ns) } }
            _ => { }
        }
        i++
    }
    ns
}

fn emit_function_sig(buf: teko::io::FileStream, prog: CgProg, f: checker::TFunction) {
    if cg_fn_is_self_recursive(f) { buf.write("__attribute__((noinline)) ") }
    if f.is_extern { buf.write("extern ") }
    emit_type(buf, prog, f.return_type)
    buf.write(" ")
    if f.is_extern {
        buf.write(f.c_symbol)
    } else {
        cb_fn_name(buf, f.namespace, f.name, f.overload_suffix)
    }
    buf.write("(")
    var wants_rgn = cg_fn_needs_region(prog, f)
    if f.params.len == 0 {
        if wants_rgn { buf.write("tk_region *_tkrgn") } else { buf.write("void") }
    } else {
        var ref_ns = cg_fn_ref_ns(prog, f.namespace)
        var self_is_ref = match cg_struct_self_recv(prog, f) { str => true; null => false }
        var i: u64 = 0
        loop {
            if i >= f.params.len { break }
            if i > 0 { buf.write(", ") }
            emit_type_expr(buf, prog, f.params[i].type_ann, ref_ns)
            buf.write(" ")
            if i == 0 && self_is_ref { buf.write("*") }
            cb_ident(buf, f.params[i].name)
            i++
        }
        if wants_rgn { buf.write(", tk_region *_tkrgn") }
    }
    buf.write(")")
}

fn cg_stmt_c_terminates(s: @TStatement()): bool {
    match s {
        checker::TReturn => true
        checker::TBreakStmt => true
        checker::TContinueStmt => true
        checker::TExprStmt as es => match es.expr.kind {
            checker::TMatchExpr => false
            checker::TIfExpr => false
            _ => true
        }
        _ => false
    }
}

fn cg_same_named_struct(a: @Type(), b: @Type()): bool {
    match a {
        checker::Named as na => match b {
            checker::Named as nb => teko::runtime::str_eq(na.name, nb.name)
            _ => false
        }
        _ => false
    }
}

fn fn_body_has_frame_local(prog: CgProg, escaping: []str, body: []@TStatement()): bool {
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding as b => {
                if checker::binding_is_frame_local(escaping, b) && (cg_same_named_struct(b.bound, b.value.type) || cg_binding_routes_box_to_local_region(prog, b)) { return true }
                if checker::binding_is_frame_local_slice(escaping, prog.table, b) { return true }
            }
            _ => { }
        }
        i++
    }
    false
}

fn emit_function(buf: teko::io::FileStream, prog: CgProg, f: checker::TFunction) {
    emit_function_cov(buf, prog, f, -1)
}

fn cg_frame_region_parent_expr(f: checker::TFunction): str {
    teko::str::concat(cg_arena_sym(CgArenaSym::RegionRoot), "()")
}

/**
 * cg_rr_init_expr — the initialiser for a frame's return region `_tkrr`: the caller-passed region
 * `_tkrgn` when the function receives one, else the process root (the rare entry/extern fallback).
 *
 * @param wants_region  true when the enclosing function carries `_tkrgn`
 * @return              the C expression the frame's `_tkrr` binds to
 */
fn cg_rr_init_expr(wants_region: bool): str {
    if wants_region { return "_tkrgn" }
    teko::str::concat(cg_arena_sym(CgArenaSym::RegionRoot), "()")
}

fn cg_tkfr_init_expr(f: checker::TFunction, use_rr: bool): str {
    var parent = if use_rr { "_tkrr" } else { cg_frame_region_parent_expr(f) }
    var floor = checker::region_slots(f.body)
    if floor == 0 { return teko::str::concat(cg_arena_sym(CgArenaSym::RegionNew), "(", parent, ")") }
    teko::str::concat(cg_arena_sym(CgArenaSym::RegionNewSized), "(", parent, ", ", teko::i64_to_str(floor to i64), ")")
}

fn cg_tkfr_drop_active(entered: bool): bool { true }

fn binding_conveys_escape(escaping: []str, name: str): bool {
    str_list_has(escaping, name)
}

fn cg_target_name(t: @BindTarget()): str {
    match t {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => ""
    }
}

fn cg_dctx_bracket(dctx: DeferCtx): DeferCtx {
    DeferCtx { defers = dctx.defers; loops = dctx.loops; cov = dctx.cov; rr = dctx.rr; bracket_depth = dctx.bracket_depth + 1; cur = dctx.cur; regbase = dctx.regbase }
}

/**
 * cg_dctx_bracket_cur — open an escape/residence bracket that redirects the current allocation region
 * to `region` (the return region `_tkrr` or a binding's residence region). While this bracket is
 * active, allocations made for the bracketed statement land in `region` instead of the frame region,
 * mirroring the old `region_enter(region)` ambient override.
 *
 * @param dctx    the enclosing defer context
 * @param region  the region entered for the bracketed statement
 * @return        a defer context nested one bracket deeper with `cur` pinned to `region`
 */
fn cg_dctx_bracket_cur(dctx: DeferCtx, region: str): DeferCtx {
    DeferCtx { defers = dctx.defers; loops = dctx.loops; cov = dctx.cov; rr = dctx.rr; bracket_depth = dctx.bracket_depth + 1; cur = region; regbase = dctx.regbase }
}

fn cg_conveys_escape_deep(escaping: []str, s: @TStatement()): bool {
    match s {
        checker::TBinding as b => binding_conveys_escape(escaping, cg_target_name(b.target))
        checker::TAssign as a => binding_conveys_escape(escaping, a.name)
        checker::TExprStmt as es => cg_expr_arm_has_escaping_write(escaping, es.expr)
        _ => false
    }
}

fn cg_expr_arm_has_escaping_write(escaping: []str, e: checker::TExpr): bool {
    match e.kind {
        checker::TIfExpr as f => cg_block_has_escaping_write(escaping, f.then_blk) || (f.has_else && cg_block_has_escaping_write(escaping, f.else_blk))
        checker::TMatchExpr as m => cg_arms_have_escaping_write(escaping, m.arms)
        _ => false
    }
}

fn cg_arms_have_escaping_write(escaping: []str, arms: []checker::TArm): bool {
    var i: u64 = 0
    loop {
        if i >= arms.len { break }
        if cg_block_has_escaping_write(escaping, arms[i].body) { return true }
        i = i + 1
    }
    false
}

fn cg_block_has_escaping_write(escaping: []str, body: []@TStatement()): bool {
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding as b => { if binding_conveys_escape(escaping, cg_target_name(b.target)) { return true } }
            checker::TAssign as a => { if binding_conveys_escape(escaping, a.name) { return true } }
            checker::TExprStmt as es => { if cg_expr_arm_has_escaping_write(escaping, es.expr) { return true } }
            checker::TLoopStmt as l => { if cg_block_has_escaping_write(escaping, l.init) || cg_block_has_escaping_write(escaping, l.body) { return true } }
            _ => { }
        }
        i = i + 1
    }
    false
}

fn cg_emit_bracket_unwind(buf: teko::io::FileStream, indent: str, n: u64) {
    var i: u64 = 0
    loop {
        if i >= n { break }
        buf.write(indent); cb_arena_sym(buf, CgArenaSym::RegionLeave); buf.write("();\n")
        i = i + 1
    }
}

fn cg_frame_exit(buf: teko::io::FileStream, indent: str, frame: str, entered: bool) {
    if entered { buf.write(indent); cb_arena_sym(buf, CgArenaSym::RegionLeave); buf.write("();\n") }
    if cg_tkfr_drop_active(entered) { buf.write(indent); cb_arena_sym(buf, CgArenaSym::RegionDrop); buf.write("("); buf.write(frame); buf.write(");\n") }
}

fn cg_return_frame_exit(buf: teko::io::FileStream, indent: str, frame: str, dctx: DeferCtx) {
    if dctx.rr.len > 0 { cg_frame_exit(buf, indent, "_tkfr", true); return }
    if frame.len > 0 { cg_frame_exit(buf, indent, frame, false) }
}

fn cg_closure_env_region(dctx: DeferCtx): str {
    if dctx.bracket_depth > 0 && dctx.rr.len > 0 { return dctx.rr }
    teko::str::concat(cg_arena_sym(CgArenaSym::RegionRoot), "()")
}

fn emit_function_cov(buf: teko::io::FileStream, prog: CgProg, f: checker::TFunction, cov_idx: i64) {
    emit_function_sig(buf, prog, f)
    buf.write(" {\n")
    if cov_idx >= 0 { cb_cov_call_idx(buf, "cov_mark", cov_idx to u64) }
    var fbody = f.body
    var cov = if cov_idx >= 0 { CovCtx { on = true; fn_idx = cov_idx to u64 } } else { cov_off() }
    var escaping = checker::fn_escaping_vars(f)
    var want_frame = fn_body_has_frame_local(prog, escaping, fbody)
    var wants_region = cg_fn_needs_region(prog, f)
    var frame: str = if want_frame { "_tkfr" } else { "" }
    var use_rr = want_frame
    var rr: str = if use_rr { "_tkrr" } else { "" }
    var regbase: str = if want_frame { "_tkfr" } else { if wants_region { "_tkrgn" } else { "" } }
    var dctx = DeferCtx { defers = []; loops = []; cov = cov; rr = rr; bracket_depth = 0; cur = ""; regbase = regbase }
    if use_rr { buf.write("    tk_region *_tkrr = "); buf.write(cg_rr_init_expr(wants_region)); buf.write(";\n") }
    if want_frame {
        buf.write("    tk_region *_tkfr = "); buf.write(cg_tkfr_init_expr(f, use_rr)); buf.write(";\n")
        if use_rr { buf.write("    "); cb_arena_sym(buf, CgArenaSym::RegionEnter); buf.write("(_tkfr);\n") }
    }
    emit_block_tail(buf, fbody, false, prog, f.return_type, "    ", frame, escaping, [], fbody, dctx)
    var tail_is_expr = if fbody.len > 0 { match fbody[fbody.len - 1] { checker::TExprStmt => true; _ => false } } else { false }
    var tail_term = if fbody.len > 0 { cg_stmt_c_terminates(fbody[fbody.len - 1]) } else { false }
    if !tail_is_expr && !tail_term {
        var fn_defers = cg_append_direct_defers(dctx.defers, fbody)
        emit_defers(buf, fn_defers, 0, prog, "    ", escaping, fbody)
    }
    if !tail_term {
        var no_tail = checker::TExpr { kind = checker::TNullLit { }; type = checker::Void { }; line = 0; col = 0 }
        var cleanup = match cg_class_cleanup_text(prog, escaping, fbody, false, no_tail) { str as c => c; error as e => panic(e.message) }
        if cleanup.len > 0 { buf.write("    "); buf.write(cleanup); buf.write("\n") }
    }
    if want_frame {
        var tail_terminates = if fbody.len > 0 { cg_stmt_c_terminates(fbody[fbody.len - 1]) } else { false }
        if !tail_terminates { cg_frame_exit(buf, "    ", "_tkfr", use_rr) }
    }
    var needs_unreachable = match f.return_type {
        checker::Void => false
        _ => if fbody.len > 0 { !cg_stmt_c_terminates(fbody[fbody.len - 1]) } else { true }
    }
    if needs_unreachable { buf.write("    __builtin_unreachable();\n") }
    buf.write("}\n\n")
}

fn cb_upper(buf: teko::io::FileStream, s: str) {
    var i = 0
    loop {
        if i >= s.len { break }
        var c = s[i]
        if c >= b'a' && c <= b'z' {
            buf.write_byte((c to i64 - b'a' to i64 + b'A' to i64) to byte)
        } else {
            buf.write_byte(c)
        }
        i++
    }
}

fn variant_member_name(m: @TypeExpr()): str | error {
    match m {
        parser::NamedType as nt => nt.path.segments[nt.path.segments.len - 1].name
        _ => error { message = "codegen: a variant member must be a named type" }
    }
}

fn flags_carrier_ctype(n: u64): str {
    if n <= 8 { return "uint8_t" }
    if n <= 16 { return "uint16_t" }
    if n <= 32 { return "uint32_t" }
    "uint64_t"
}

fn emit_flags_member_const(buf: teko::io::FileStream, type_name: str, member: str, ordinal: u64) {
    buf.write("static const ")
    mangle_type_name(buf, "", type_name)
    buf.write(" ")
    mangle_type_name(buf, "", type_name)
    buf.write("_")
    cb_upper(buf, member)
    buf.write(" = (")
    mangle_type_name(buf, "", type_name)
    buf.write(")(((uint64_t)1) << ")
    cb_i64(buf, ordinal to i64)
    buf.write(");\n")
}

fn emit_newtype_typedef(buf: teko::io::FileStream, prog: CgProg, d: parser::TypeDecl, nb: parser::NewtypeBody) {
    if d.name == "teko::base::str" { return }
    buf.write("typedef ")
    emit_type_expr(buf, prog, nb.backing, checker::name_qualifier(d.name))
    buf.write(" ")
    mangle_type_name(buf, "", d.name)
    buf.write(";\n\n")
}

fn emit_flags_typedef(buf: teko::io::FileStream, d: parser::TypeDecl, fb: parser::FlagsBody) {
    buf.write("typedef ")
    buf.write(flags_carrier_ctype(fb.members.len))
    buf.write(" ")
    mangle_type_name(buf, "", d.name)
    buf.write(";\n")
    var mi: u64 = 0
    loop {
        if mi >= fb.members.len { break }
        emit_flags_member_const(buf, d.name, fb.members[mi], mi)
        mi++
    }
    buf.write("\n")
}

fn emit_type_decl(buf: teko::io::FileStream, prog: CgProg, d: parser::TypeDecl) {
    match d.body {
        parser::StructBody as sb => {
            buf.write("typedef struct ")
            mangle_type_name(buf, "", d.name)
            buf.write(" {\n")
            buf.write("    tk_struct_hdr __hdr;\n")
            var i = 0
            loop {
                if i >= sb.fields.len { break }
                buf.write("    ")
                emit_type_expr(buf, prog, sb.fields[i].type_ann, checker::name_qualifier(d.name))
                buf.write(" ")
                if cg_field_boxed(prog, d.name, sb.fields[i].type_ann) { buf.write("*") }
                buf.write(sb.fields[i].name)
                buf.write(";\n")
                i++
            }
            buf.write("} ")
            mangle_type_name(buf, "", d.name)
            buf.write(";\n\n")
        }
        parser::ClassBody as cb2 => {
            var table = cg_type_table(prog)
            var fields = match checker::effective_class_fields(cb2, table) { []parser::Field as fs => fs; error as err => panic(err.message) }
            buf.write("typedef struct ")
            mangle_type_name(buf, "", d.name)
            buf.write(" {\n")
            var i = 0
            loop {
                if i >= fields.len { break }
                buf.write("    ")
                emit_type_expr(buf, prog, fields[i].type_ann, checker::name_qualifier(d.name))
                buf.write(" ")
                if cg_field_boxed(prog, d.name, fields[i].type_ann) { buf.write("*") }
                buf.write(fields[i].name)
                buf.write(";\n")
                i++
            }
            buf.write("    tk_region *__region;\n")
            buf.write("} ")
            mangle_type_name(buf, "", d.name)
            buf.write(";\n\n")
        }
        parser::InterfaceBody => { }
        parser::TraitBody => { }
        parser::VariantBody as vb => {
            var members = match vb.type_expr {
                parser::UnionType as u => u.members
                _ => panic("codegen: a variant body must be a union of members")
            }
            buf.write("typedef enum tk_tag_")
            cb_tysym(buf, d.name)
            buf.write(" {\n")
            var i = 0
            loop {
                if i >= members.len { break }
                var mk = match cg_member_key_texpr_str(prog, members[i], checker::name_qualifier(d.name)) { str as s => s; error as err => panic(err.message) }
                buf.write("    TK_TAG_")
                cb_upper(buf, cg_ns_c_key(d.name))
                buf.write("_")
                cb_upper(buf, mk)
                if i + 1 < members.len { buf.write(",") }
                buf.write("\n")
                i++
            }
            buf.write("} tk_tag_")
            cb_tysym(buf, d.name)
            buf.write(";\n\n")
            buf.write("typedef struct ")
            mangle_type_name(buf, "", d.name)
            buf.write(" {\n    tk_tag_")
            cb_tysym(buf, d.name)
            buf.write(" tag;\n    union {\n")
            var j = 0
            loop {
                if j >= members.len { break }
                var mem = members[j]
                var mk = match cg_member_key_texpr_str(prog, mem, checker::name_qualifier(d.name)) { str as s => s; error as err => panic(err.message) }
                buf.write("        ")
                emit_type_expr(buf, prog, mem, checker::name_qualifier(d.name))
                buf.write(" ")
                buf.write(mk)
                buf.write(";\n")
                j++
            }
            buf.write("    } as;\n} ")
            mangle_type_name(buf, "", d.name)
            buf.write(";\n\n")
        }
        parser::EnumBody as eb => {
            buf.write("typedef enum ")
            mangle_type_name(buf, "", d.name)
            buf.write(" {\n")
            var i = 0
            loop {
                if i >= eb.members.len { break }
                buf.write("    TK_E_")
                cb_upper(buf, checker::name_last_segment(d.name))
                buf.write("_")
                cb_upper(buf, eb.members[i])
                if i + 1 < eb.members.len { buf.write(",") }
                buf.write("\n")
                i++
            }
            buf.write("} ")
            mangle_type_name(buf, "", d.name)
            buf.write(";\n\n")
        }
        parser::AliasBody => { }
        parser::NewtypeBody as nb => emit_newtype_typedef(buf, prog, d, nb)
        parser::FlagsBody as fb => emit_flags_typedef(buf, d, fb)
        parser::ExternBody => {
            buf.write("typedef void *")
            mangle_type_name(buf, "", d.name)
            buf.write(";\n\n")
        }
        parser::ExternStructBody as esb => emit_extern_struct_typedef(buf, prog, d, esb)
    }
}

fn emit_extern_struct_typedef(buf: teko::io::FileStream, prog: CgProg, d: parser::TypeDecl, esb: parser::ExternStructBody) {
    if esb.c_tag.len > 0 { return }
    buf.write("typedef struct ")
    mangle_type_name(buf, "", d.name)
    buf.write(" {\n")
    var i = 0
    loop {
        if i >= esb.fields.len { break }
        buf.write("    ")
        emit_type_expr(buf, prog, esb.fields[i].type_ann, checker::name_qualifier(d.name))
        buf.write(" ")
        buf.write(esb.fields[i].name)
        buf.write(";\n")
        i++
    }
    buf.write("} ")
    mangle_type_name(buf, "", d.name)
    buf.write(";\n\n")
}

type CgTypeSet = struct {
    slices: []@Type()
    slice_keys: []str
    slices_n: u64
    variants: []@Type()
    variant_keys: []str
    variants_n: u64
    counting: bool
}

fn cg_opt_key(t: @Type()): str {
    match cg_opt_mangle_str(t) { str as s => s; error => "" }
}
fn cg_slice_add(set: CgTypeSet, elem: @Type()): CgTypeSet {
    var s = set
    if s.counting { s.slices_n = s.slices_n + 1; return s }
    var key = cg_opt_key(elem)
    if key == "" { return s }
    var i: u64 = 0
    loop {
        if i >= s.slices_n { break }
        if s.slice_keys[i] == key { return s }
        i = i + 1
    }
    s.slices[s.slices_n] = elem
    s.slice_keys[s.slices_n] = key
    s.slices_n = s.slices_n + 1
    s
}
fn cg_variant_key(t: @Type()): str {
    match t {
        checker::Variant as v => match cg_variant_typename_str(v) { str as s => s; error => "" }
        _ => ""
    }
}
fn cg_variant_add(set: CgTypeSet, t: @Type()): CgTypeSet {
    var s = set
    if s.counting { s.variants_n = s.variants_n + 1; return s }
    var key = cg_variant_key(t)
    if key == "" { return s }
    var i: u64 = 0
    loop {
        if i >= s.variants_n { break }
        if s.variant_keys[i] == key { return s }
        i = i + 1
    }
    s.variants[s.variants_n] = t
    s.variant_keys[s.variants_n] = key
    s.variants_n = s.variants_n + 1
    s
}
fn cg_collect_type_opts(set: CgTypeSet, t: @Type()): CgTypeSet {
    match t {
        checker::Slice as sl => match sl.element {
            checker::Void => set
            _ => cg_slice_add(cg_collect_type_opts(set, sl.element), sl.element)
        }
        checker::Variant as va => {
            var s = set
            var i = 0
            loop {
                if i >= va.members.len { break }
                s = cg_collect_type_opts(s, va.members[i])
                i++
            }
            cg_variant_add(s, t)
        }
        _ => set
    }
}
fn cg_collect_expr_opts(set: CgTypeSet, e: checker::TExpr): CgTypeSet {
    var s = cg_collect_type_opts(set, e.type)
    match e.kind {
        checker::TBinary as b => { s = cg_collect_expr_opts(s, b.left); s = cg_collect_expr_opts(s, b.right) }
        checker::TUnary as u => { s = cg_collect_expr_opts(s, u.operand) }
        checker::TCompare as c => {
            s = cg_collect_expr_opts(s, c.first)
            var i = 0
            loop { if i >= c.rest.len { break }; s = cg_collect_expr_opts(s, c.rest[i].operand); i++ }
        }
        checker::TCall as cl => { var i = 0; loop { if i >= cl.args.len { break }; s = cg_collect_expr_opts(s, cl.args[i]); i++ } }
        checker::TIfExpr as f => {
            s = cg_collect_expr_opts(s, f.cond)
            s = cg_collect_block_opts(s, f.then_blk)
            s = cg_collect_block_opts(s, f.else_blk)
        }
        checker::TMatchExpr as m => {
            s = cg_collect_expr_opts(s, m.subject)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { s = cg_collect_expr_opts(s, m.arms[i].guard) }
                s = cg_collect_block_opts(s, m.arms[i].body)
                i++
            }
        }
        checker::TCast as c => { s = cg_collect_expr_opts(s, c.expr) }
        checker::TFieldAccess as fa => { s = cg_collect_expr_opts(s, fa.receiver) }
        checker::TStructInit as si => { var i = 0; loop { if i >= si.field_vals.len { break }; s = cg_collect_expr_opts(s, si.field_vals[i]); i++ } }
        checker::TIndex as ix => { s = cg_collect_expr_opts(s, ix.receiver); s = cg_collect_expr_opts(s, ix.index) }
        checker::TInterp as in => {
            var i = 0
            loop {
                if i >= in.holes.len { break }
                s = cg_collect_expr_opts(s, in.holes[i])
                if i < in.specs.len {
                    match in.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; s = cg_collect_expr_opts(s, fd.args[k]); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
        }
        checker::TInExpr as ie => { s = cg_collect_expr_opts(s, ie.lhs); var i = 0; loop { if i >= ie.elems.len { break }; s = cg_collect_expr_opts(s, ie.elems[i]); i++ } }
        checker::TLambda as lam => {
            var i = 0
            loop { if i >= lam.params.len { break }; s = cg_collect_type_opts(s, lam.params[i].type); i++ }
            s = cg_collect_type_opts(s, lam.ret)
            s = cg_collect_block_opts(s, lam.body)
        }
        checker::TBlockExpr as blk => { s = cg_collect_block_opts(s, blk.body) }
        _ => { }
    }
    s
}
fn cg_collect_block_opts(set: CgTypeSet, stmts: []@TStatement()): CgTypeSet {
    var s = set
    var i = 0
    loop {
        if i >= stmts.len { break }
        match stmts[i] {
            checker::TBinding as b => { s = cg_collect_type_opts(s, b.bound); s = cg_collect_expr_opts(s, b.value) }
            checker::TAssign as a => { s = cg_collect_type_opts(s, a.bound); s = cg_collect_expr_opts(s, a.value); if parser::assign_has_target(a.kind) { s = cg_collect_expr_opts(s, a.target) } }
            checker::TReturn as r => { if r.has_value { s = cg_collect_expr_opts(s, r.value) } }
            checker::TLoopStmt as l => { s = cg_collect_block_opts(s, l.init); s = cg_collect_block_opts(s, l.body) }
            checker::TExprStmt as es => { s = cg_collect_expr_opts(s, es.expr) }
            checker::TDeferStmt as d => { s = cg_collect_block_opts(s, d.body) }
            checker::TAdoptStmt as a => { s = cg_collect_block_opts(s, a.body) }
            checker::TBlockStmt as b => { s = cg_collect_block_opts(s, b.body) }
            _ => { }
        }
        i++
    }
    s
}
fn cg_te_to_type_ns(prog: CgProg, ref_ns: str, te: @TypeExpr()): @Type() {
    match te {
        parser::NamedType as nt => {
            var last = nt.path.segments[nt.path.segments.len - 1].name
            if last == "u8" { checker::Prim { kind = checker::PrimKind::U8 } }
            else if last == "u16" { checker::Prim { kind = checker::PrimKind::U16 } }
            else if last == "u32" { checker::Prim { kind = checker::PrimKind::U32 } }
            else if last == "u64" { checker::Prim { kind = checker::PrimKind::U64 } }
            else if last == "i8" { checker::Prim { kind = checker::PrimKind::I8 } }
            else if last == "i16" { checker::Prim { kind = checker::PrimKind::I16 } }
            else if last == "i32" { checker::Prim { kind = checker::PrimKind::I32 } }
            else if last == "i64" { checker::Prim { kind = checker::PrimKind::I64 } }
            else if last == "f32" { checker::Prim { kind = checker::PrimKind::F32 } }
            else if last == "f64" { checker::Prim { kind = checker::PrimKind::F64 } }
            else if last == "bool" { checker::Prim { kind = checker::PrimKind::Bool } }
            else if last == "usize" { checker::Prim { kind = checker::PrimKind::Usize } }
            else if last == "isize" { checker::Prim { kind = checker::PrimKind::Isize } }
            else if last == "byte" { checker::Byte { } }
            else if last == "str" { checker::Named { name = "teko::base::str" } }
            else if last == "error" { checker::Error { } }
            else if last == "void" { checker::Void { } }
            else if last == "()" { checker::Void { } }
            else if last == "null" { checker::Null { } }
            else if last == "uptr" { checker::Uptr { } }
            else if last == "Ref" { if nt.args.len > 0 { checker::Reference { inner = cg_te_to_type_ns(prog, ref_ns, nt.args[0]) } } else { checker::Reference { inner = checker::Void { } } } }
            else if last == "ptr" { checker::Ptr { inner = null } }
            else if nt.args.len == 0 { checker::Named { name = cg_te_canonical_name(prog, ref_ns, nt.path, last) } }
            else { checker::Named { name = cg_texpr_inst_name(last, nt.args) } }
        }
        parser::SliceType as st => checker::Slice { element = cg_te_to_type_ns(prog, ref_ns, st.element) }
        parser::SizedArrayType as sa => checker::Slice { element = cg_te_to_type_ns(prog, ref_ns, sa.element) }
        parser::UnionType as ut => {
            var mn = ut.members.len
            var mem: [mn]@Type() = []
            var i = 0
            loop {
                if i >= ut.members.len { break }
                mem[i] = cg_te_to_type_ns(prog, ref_ns, ut.members[i])
                i++
            }
            checker::Variant { members = cg_union_normalize_null(mem) }
        }
        parser::FunctionType => checker::Func { params = []; ret = checker::Void { }; variadic = false; param_names = []; n_required = 0; defaults = []; ret_extra = [] }
        parser::MacroType => checker::Void { }
    }
}

fn cg_te_canonical_name(prog: CgProg, ref_ns: str, path: parser::Path, last: str): str {
    match cg_find_decl_ns(prog, path, ref_ns) {
        parser::TypeDecl as d => d.name
        error => last
    }
}

fn cg_register_decl_field_types(set: CgTypeSet, prog: CgProg, d: parser::TypeDecl): CgTypeSet {
    var ref_ns = checker::name_qualifier(d.name)
    match d.body {
        parser::StructBody as sb => cg_register_field_list(set, prog, ref_ns, sb.fields)
        parser::VariantBody as vb => cg_register_variant_body(set, prog, ref_ns, vb.type_expr)
        parser::AliasBody as alb => cg_collect_type_opts(set, cg_te_to_type_ns(prog, ref_ns, alb.alias))
        _ => set
    }
}

fn cg_register_field_list(set: CgTypeSet, prog: CgProg, ref_ns: str, fields: []parser::Field): CgTypeSet {
    var s = set
    var fi = 0
    loop {
        if fi >= fields.len { break }
        s = cg_collect_type_opts(s, cg_te_to_type_ns(prog, ref_ns, fields[fi].type_ann))
        fi++
    }
    s
}

fn cg_register_variant_body(set: CgTypeSet, prog: CgProg, ref_ns: str, te: @TypeExpr()): CgTypeSet {
    match te {
        parser::UnionType as ut => {
            var s = set
            var mi = 0
            loop {
                if mi >= ut.members.len { break }
                s = cg_collect_type_opts(s, cg_te_to_type_ns(prog, ref_ns, ut.members[mi]))
                mi++
            }
            s
        }
        _ => cg_collect_type_opts(set, cg_te_to_type_ns(prog, ref_ns, te))
    }
}

fn cg_emit_inline_variant_typedef(buf: teko::io::FileStream, prog: CgProg, v: checker::Variant) {
    match cg_union_niche_member(prog, v) {
        (@Type()) as _gt14 => return
        null => { }
    }
    match cg_union_box_member(prog, v) {
        (@Type()) as _gt15 => return
        null => { }
    }
    buf.write("typedef enum tk_tag")
    var a = 0
    loop {
        if a >= v.members.len { break }
        buf.write("_")
        cg_member_key(buf, v.members[a])
        a++
    }
    buf.write(" {\n")
    var i = 0
    loop {
        if i >= v.members.len { break }
        buf.write("    TK_TAG_U")
        var j = 0
        loop {
            if j >= v.members.len { break }
            buf.write("_")
            var kj = match cg_member_key_str(v.members[j]) { str as s => s; error as err => panic(err.message) }
            cb_upper(buf, kj)
            j++
        }
        buf.write("_")
        var ki = match cg_member_key_str(v.members[i]) { str as s => s; error as err => panic(err.message) }
        cb_upper(buf, ki)
        if i + 1 < v.members.len { buf.write(",") }
        buf.write("\n")
        i++
    }
    buf.write("} tk_tag")
    var b = 0
    loop {
        if b >= v.members.len { break }
        buf.write("_")
        cg_member_key(buf, v.members[b])
        b++
    }
    buf.write(";\n")
    buf.write("typedef struct ")
    cg_variant_typename(buf, v)
    buf.write(" {\n    ")
    cg_union_tag_ctype(buf, v)
    buf.write(" tag;\n")
    if cg_union_is_tagptr(prog, v) {
        buf.write("    void *payload;\n    uint64_t len;\n} ")
        cg_variant_typename(buf, v)
        buf.write(";\n")
        return
    }
    buf.write("    union {\n")
    var m = 0
    loop {
        if m >= v.members.len { break }
        buf.write("        ")
        emit_type(buf, prog, v.members[m])
        buf.write(" ")
        cg_member_key(buf, v.members[m])
        buf.write(";\n")
        m++
    }
    buf.write("    } as;\n} ")
    cg_variant_typename(buf, v)
    buf.write(";\n")
}

type CgEmitted = struct { names: []str; names_n: u64; opt_keys: []str; uvar_keys: []str; uvar_n: u64 }

fn cg_str_in(xs: []str, s: str): bool {
    var i = 0
    loop { if i >= xs.len { break }; if xs[i] == s { return true }; i++ }
    false
}

fn cg_str_in_n(xs: []str, n: u64, s: str): bool {
    var i: u64 = 0
    loop { if i >= n { break }; if xs[i] == s { return true }; i++ }
    false
}
fn cg_find_decl_exact(prog: CgProg, name: str): parser::TypeDecl | error {
    if prog.ix.exact.slots.len != 0 { return cg_decl_at(prog, cg_table_get(prog.ix.exact, name)) }
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => { if d.name == name { return d } }
            _ => { }
        }
        i++
    }
    error { message = "codegen: no such type decl" }
}
fn cg_named_emitted_precise(prog: CgProg, em: CgEmitted, name: str): bool {
    if checker::name_qualifier(name) != "" {
        match cg_find_decl_exact(prog, name) {
            parser::TypeDecl as dd => {
                var gate = match dd.body { parser::StructBody => true; parser::VariantBody => true; _ => false }
                if gate { return cg_str_in_n(em.names, em.names_n, name) }
            }
            error => { }
        }
    }
    cg_named_emitted(em, name)
}
fn cg_named_emitted(em: CgEmitted, name: str): bool {
    var want = checker::name_last_segment(name)
    var i: u64 = 0
    loop {
        if i >= em.names_n { break }
        if checker::name_last_segment(em.names[i]) == want { return true }
        i++
    }
    false
}
fn cg_uvar_emitted_key(em: CgEmitted, set: CgTypeSet, key: str): bool {
    var i: u64 = 0
    var present = false
    loop {
        if i >= set.variants_n { break }
        if set.variant_keys[i] == key { present = true; break }
        i = i + 1
    }
    if !present { return true }
    cg_str_in_n(em.uvar_keys, em.uvar_n, key)
}
fn cg_type_ready(prog: CgProg, em: CgEmitted, set: CgTypeSet, t: @Type()): bool {
    if cg_is_str_type(t) { return true }
    match t {
        checker::Named as nm => if cg_is_class_named(prog, nm.name) { true } else { cg_named_emitted_precise(prog, em, nm.name) }
        checker::Variant as va => cg_uvar_emitted_key(em, set, cg_variant_key(t))
        checker::Slice => true
        _ => true
    }
}
fn cg_is_builtin_scalar(last: str): bool {
    last == "u8" || last == "u16" || last == "u32" || last == "u64" ||
    last == "i8" || last == "i16" || last == "i32" || last == "i64" ||
    last == "f32" || last == "f64" || last == "bool" || last == "byte" ||
    last == "usize" || last == "isize" ||
    last == "str" || last == "error" || last == "ptr" || last == "uptr" ||
    last == "Ref"
}
fn cg_texpr_union_ready(prog: CgProg, em: CgEmitted, set: CgTypeSet, ut: parser::UnionType, owner_ns: str): bool {
    if !cg_texpr_union_has_null(ut) {
        return cg_uvar_emitted_key(em, set, cg_variant_typename_texpr_str(prog, ut, owner_ns))
    }
    var resolved = cg_te_to_type_ns(prog, owner_ns, parser::UnionType { members = ut.members })
    var va = match resolved { checker::Variant as v => v; _ => return cg_uvar_emitted_key(em, set, cg_variant_typename_texpr_str(prog, ut, owner_ns)) }
    match cg_union_niche_member(prog, va) { (@Type()) as _gt16 => return true; null => { } }
    match cg_union_box_member(prog, va) { (@Type()) as _gt17 => return true; null => { } }
    cg_uvar_emitted_key(em, set, cg_variant_key(va))
}
fn cg_texpr_ready(prog: CgProg, em: CgEmitted, set: CgTypeSet, te: @TypeExpr(), owner_ns: str): bool {
    match te {
        parser::NamedType as nt => {
            var stem = nt.path.segments[nt.path.segments.len - 1].name
            if cg_is_builtin_scalar(stem) { return true }
            if cg_is_class_named(prog, stem) { return true }
            if nt.args.len > 0 { return cg_named_emitted(em, cg_texpr_inst_name(stem, nt.args)) }
            var want = match cg_find_decl_ns(prog, nt.path, owner_ns) { parser::TypeDecl as dd => dd.name; error => stem }
            cg_named_emitted_precise(prog, em, want)
        }
        parser::SliceType => true
        parser::SizedArrayType => true
        parser::UnionType as ut => cg_texpr_union_ready(prog, em, set, ut, owner_ns)
        parser::FunctionType => true
        parser::MacroType => false
    }
}
fn cg_named_ready(prog: CgProg, em: CgEmitted, set: CgTypeSet, d: parser::TypeDecl): bool {
    var owner_ns = checker::type_ns_of(cg_type_table(prog), d.name)
    match d.body {
        parser::StructBody as sb => {
            var i = 0
            loop {
                if i >= sb.fields.len { break }
                if cg_field_boxed(prog, d.name, sb.fields[i].type_ann) { i++ } else {
                    if !cg_texpr_ready(prog, em, set, sb.fields[i].type_ann, owner_ns) { return false }
                    i++
                }
            }
            true
        }
        parser::VariantBody as vb => match vb.type_expr {
            parser::UnionType as u => {
                var i = 0
                loop {
                    if i >= u.members.len { break }
                    if !cg_texpr_ready(prog, em, set, u.members[i], owner_ns) { return false }
                    i++
                }
                true
            }
            _ => true
        }
        parser::ClassBody as cb2 => {
            var table = cg_type_table(prog)
            var fields = match checker::effective_class_fields(cb2, table) { []parser::Field as fs => fs; error => return true }
            var i = 0
            loop {
                if i >= fields.len { break }
                if !cg_texpr_ready(prog, em, set, fields[i].type_ann, owner_ns) { return false }
                i++
            }
            true
        }
        _ => true
    }
}

fn cg_named_decls(prog: CgProg): []parser::TypeDecl {
    var n: u64 = 0
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] { parser::TypeDecl => { n = n + 1 }; _ => { } }
        i++
    }
    var named: [n]parser::TypeDecl = []
    var k: u64 = 0
    var j = 0
    loop {
        if j >= prog.items.len { break }
        match prog.items[j] {
            parser::TypeDecl as d => { named[k] = d; k = k + 1 }
            _ => { }
        }
        j++
    }
    named
}

fn cg_collect_all(set: CgTypeSet, prog: CgProg): CgTypeSet {
    var s = set
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                s = cg_collect_type_opts(s, f.return_type)
                s = cg_collect_block_opts(s, f.body)
            }
            (@TStatement()) as st => { s = cg_collect_block_opts(s, [st]) }
            _ => { }
        }
        i++
    }
    var td = 0
    loop {
        if td >= prog.items.len { break }
        match prog.items[td] {
            parser::TypeDecl as d => { s = cg_register_decl_field_types(s, prog, d) }
            _ => { }
        }
        td++
    }
    s
}

fn cg_emit_types_ordered(buf: teko::io::FileStream, prog: CgProg) {
    var empty_t: []@Type() = []
    var empty_s: []str = []
    var cset = CgTypeSet { slices = empty_t; slice_keys = empty_s; slices_n = 0; variants = empty_t; variant_keys = empty_s; variants_n = 0; counting = true }
    cset = cg_collect_all(cset, prog)
    var scap = cset.slices_n
    var vcap = cset.variants_n
    var sbuf: [scap]@Type() = []
    var skbuf: [scap]str = []
    var vbuf: [vcap]@Type() = []
    var vkbuf: [vcap]str = []
    var set = CgTypeSet { slices = sbuf; slice_keys = skbuf; slices_n = 0; variants = vbuf; variant_keys = vkbuf; variants_n = 0; counting = false }
    set = cg_collect_all(set, prog)
    var named = cg_named_decls(prog)

    var names_cap = named.len
    var uvar_cap = set.variants_n
    var names_buf: [names_cap]str = []
    var uvar_buf: [uvar_cap]str = []
    var em0 = CgEmitted { names = names_buf; names_n = 0; opt_keys = []; uvar_keys = uvar_buf; uvar_n = 0 }
    var enum_count: u64 = 0
    var ei = 0
    loop {
        if ei >= named.len { break }
        var is_enum_or_flags = match named[ei].body {
            parser::EnumBody => true
            parser::FlagsBody => true
            _ => false
        }
        if is_enum_or_flags {
            emit_type_decl(buf, prog, named[ei])
            em0.names[em0.names_n] = named[ei].name
            em0.names_n = em0.names_n + 1
            enum_count = enum_count + 1
        }
        ei++
    }
    if enum_count > 0 { buf.write("\n") }
    var fv = 0
    loop {
        if fv >= set.variants_n { break }
        match set.variants[fv] {
            checker::Variant as va => {
                buf.write("typedef struct ")
                cg_variant_typename(buf, va)
                buf.write(" ")
                cg_variant_typename(buf, va)
                buf.write(";\n")
            }
            _ => { }
        }
        fv++
    }
    if set.variants_n > 0 { buf.write("\n") }

    var k = 0
    loop {
        if k >= set.slices_n { break }
        match set.slices[k] { Char => { k++; continue }; _ => { } }
        match set.slices[k] { Byte => { k++; continue }; _ => { } }
        buf.write("typedef struct { ")
        emit_type(buf, prog, set.slices[k])
        buf.write(" *ptr; uint64_t len; uint64_t cap; } ")
        cg_slice_typename(buf, set.slices[k])
        buf.write(";\n")
        k++
    }
    if set.slices_n > 0 { buf.write("\n") }

    var em = em0
    var remaining = named.len + set.variants_n - enum_count
    var progress = true
    loop {
        if remaining == 0 { break }
        if !progress { break }
        progress = false
        var ni = 0
        loop {
            if ni >= named.len { break }
            var d = named[ni]
            if cg_str_in_n(em.names, em.names_n, d.name) { ni++ } else {
                if !cg_named_ready(prog, em, set, d) { ni++ } else {
                    emit_type_decl(buf, prog, d)
                    em.names[em.names_n] = d.name
                    em.names_n = em.names_n + 1
                    remaining = remaining - 1
                    progress = true
                    ni++
                }
            }
        }
        var vi = 0
        loop {
            if vi >= set.variants_n { break }
            var vt = set.variants[vi]
            var vkey = set.variant_keys[vi]
            if cg_str_in_n(em.uvar_keys, em.uvar_n, vkey) { vi++ } else {
                var ready = true
                match vt {
                    checker::Variant as va => {
                        if !cg_union_is_tagptr(prog, va) {
                            var m = 0
                            loop {
                                if m >= va.members.len { break }
                                if !cg_type_ready(prog, em, set, va.members[m]) { ready = false; break }
                                m++
                            }
                        }
                    }
                    _ => { }
                }
                if !ready { vi++ } else {
                    match vt {
                        checker::Variant as va => cg_emit_inline_variant_typedef(buf, prog, va)
                        _ => { }
                    }
                    em.uvar_keys[em.uvar_n] = vkey
                    em.uvar_n = em.uvar_n + 1
                    remaining = remaining - 1
                    progress = true
                    vi++
                }
            }
        }
    }
    if remaining > 0 { panic("codegen: cyclic value-type dependency (a recursive type must pass through a slice or a boxed reference)") }
}

type TFnChunk = struct {
    data: []checker::TFunction
}

type TFnVec = struct {
    chunks: []TFnChunk
    nch: u64
    cur: []checker::TFunction
    fill: u64
    len: u64
}

fn tfnvec_new(): TFnVec {
    var ec: []TFnChunk = []
    var z: []checker::TFunction = []
    TFnVec { chunks = ec; nch = 0; cur = z; fill = 0; len = 0 }
}

fn tfnvec_chunk_room(v: TFnVec): TFnVec {
    var nv = v
    if nv.chunks.len == 0 {
        var p: [8]TFnChunk = []
        nv.chunks = p
        return nv
    }
    if nv.nch < nv.chunks.len { return nv }
    var cap = nv.chunks.len * 2
    var np: [cap]TFnChunk = []
    var i: u64 = 0
    loop {
        if i >= nv.nch { break }
        np[i] = nv.chunks[i]
        i = i + 1
    }
    nv.chunks = np
    nv
}

fn tfnvec_push(v: TFnVec, x: checker::TFunction): TFnVec {
    var nv = v
    if nv.fill >= nv.cur.len {
        if nv.cur.len > 0 {
            nv = tfnvec_chunk_room(nv)
            nv.chunks[nv.nch] = TFnChunk { data = nv.cur }
            nv.nch = nv.nch + 1
        }
        var next: u64 = 16
        if nv.cur.len > 0 {
            next = nv.cur.len * 2
            if next > 4096 { next = 4096 }
        }
        var nc: [next]checker::TFunction = []
        nv.cur = nc
        nv.fill = 0
    }
    nv.cur[nv.fill] = x
    nv.fill = nv.fill + 1
    nv.len = nv.len + 1
    nv
}

fn tfnvec_flat(v: TFnVec): []checker::TFunction {
    var out: [v.len]checker::TFunction = []
    var k: u64 = 0
    var ci: u64 = 0
    loop {
        if ci >= v.nch { break }
        var ch = v.chunks[ci].data
        var j: u64 = 0
        loop {
            if j >= ch.len { break }
            out[k] = ch[j]
            k = k + 1
            j = j + 1
        }
        ci = ci + 1
    }
    var j2: u64 = 0
    loop {
        if j2 >= v.fill { break }
        out[k] = v.cur[j2]
        k = k + 1
        j2 = j2 + 1
    }
    out
}

type TLamChunk = struct {
    data: []checker::TLambda
}

type TLamVec = struct {
    chunks: []TLamChunk
    nch: u64
    cur: []checker::TLambda
    fill: u64
    len: u64
}

fn tlamvec_new(): TLamVec {
    var ec: []TLamChunk = []
    var z: []checker::TLambda = []
    TLamVec { chunks = ec; nch = 0; cur = z; fill = 0; len = 0 }
}

fn tlamvec_chunk_room(v: TLamVec): TLamVec {
    var nv = v
    if nv.chunks.len == 0 {
        var p: [8]TLamChunk = []
        nv.chunks = p
        return nv
    }
    if nv.nch < nv.chunks.len { return nv }
    var cap = nv.chunks.len * 2
    var np: [cap]TLamChunk = []
    var i: u64 = 0
    loop {
        if i >= nv.nch { break }
        np[i] = nv.chunks[i]
        i = i + 1
    }
    nv.chunks = np
    nv
}

fn tlamvec_push(v: TLamVec, x: checker::TLambda): TLamVec {
    var nv = v
    if nv.fill >= nv.cur.len {
        if nv.cur.len > 0 {
            nv = tlamvec_chunk_room(nv)
            nv.chunks[nv.nch] = TLamChunk { data = nv.cur }
            nv.nch = nv.nch + 1
        }
        var next: u64 = 16
        if nv.cur.len > 0 {
            next = nv.cur.len * 2
            if next > 4096 { next = 4096 }
        }
        var nc: [next]checker::TLambda = []
        nv.cur = nc
        nv.fill = 0
    }
    nv.cur[nv.fill] = x
    nv.fill = nv.fill + 1
    nv.len = nv.len + 1
    nv
}

fn tlamvec_flat(v: TLamVec): []checker::TLambda {
    var out: [v.len]checker::TLambda = []
    var k: u64 = 0
    var ci: u64 = 0
    loop {
        if ci >= v.nch { break }
        var ch = v.chunks[ci].data
        var j: u64 = 0
        loop {
            if j >= ch.len { break }
            out[k] = ch[j]
            k = k + 1
            j = j + 1
        }
        ci = ci + 1
    }
    var j2: u64 = 0
    loop {
        if j2 >= v.fill { break }
        out[k] = v.cur[j2]
        k = k + 1
        j2 = j2 + 1
    }
    out
}

type StampAcc = struct { next: u64; next_spawn: u64; fns: TFnVec; lams: TLamVec; spawns: []checker::TSpawn }
type LiftResult = struct { prog: checker::TProgram; lams: []checker::TLambda; spawns: []checker::TSpawn }

fn cg_expr_has_lift(e: checker::TExpr): bool {
    match e.kind {
        checker::TLambda => true
        checker::TBinary as b => cg_expr_has_lift(b.left) || cg_expr_has_lift(b.right)
        checker::TUnary as u => cg_expr_has_lift(u.operand)
        checker::TCompare as c => {
            if cg_expr_has_lift(c.first) { return true }
            var i = 0
            loop { if i >= c.rest.len { break }; if cg_expr_has_lift(c.rest[i].operand) { return true }; i++ }
            false
        }
        checker::TCall as cl => {
            var i = 0
            loop { if i >= cl.args.len { break }; if cg_expr_has_lift(cl.args[i]) { return true }; i++ }
            false
        }
        checker::TIfExpr as f => cg_expr_has_lift(f.cond) || cg_block_has_lift(f.then_blk) || (f.has_else && cg_block_has_lift(f.else_blk))
        checker::TMatchExpr as m => {
            if cg_expr_has_lift(m.subject) { return true }
            var i = 0
            loop {
                if i >= m.arms.len { break }
                var a = m.arms[i]
                if a.has_when && cg_expr_has_lift(a.guard) { return true }
                if cg_block_has_lift(a.body) { return true }
                i++
            }
            false
        }
        checker::TCast as ct => cg_expr_has_lift(ct.expr)
        checker::TFieldAccess as fa => cg_expr_has_lift(fa.receiver)
        checker::TStructInit as si => {
            var i = 0
            loop { if i >= si.field_vals.len { break }; if cg_expr_has_lift(si.field_vals[i]) { return true }; i++ }
            false
        }
        checker::TIndex as ix => cg_expr_has_lift(ix.receiver) || cg_expr_has_lift(ix.index)
        checker::TInterp as in => {
            var i = 0
            loop {
                if i >= in.holes.len { break }
                if cg_expr_has_lift(in.holes[i]) { return true }
                if i < in.specs.len {
                    match in.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; if cg_expr_has_lift(fd.args[k]) { return true }; k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            false
        }
        checker::TInExpr as ie => {
            if cg_expr_has_lift(ie.lhs) { return true }
            var i = 0
            loop { if i >= ie.elems.len { break }; if cg_expr_has_lift(ie.elems[i]) { return true }; i++ }
            false
        }
        checker::TArrayLit as a => {
            var i = 0
            loop { if i >= a.elements.len { break }; if cg_expr_has_lift(a.elements[i].expr) { return true }; i++ }
            false
        }
        checker::TBlockExpr as blk => cg_block_has_lift(blk.body)
        _ => false
    }
}

fn cg_stmt_has_lift(s: @TStatement()): bool {
    match s {
        checker::TBinding as b => cg_expr_has_lift(b.value)
        checker::TAssign as a => cg_expr_has_lift(a.value) || (parser::assign_has_target(a.kind) && cg_expr_has_lift(a.target))
        checker::TReturn as r => r.has_value && cg_expr_has_lift(r.value)
        checker::TLoopStmt as l => cg_block_has_lift(l.init) || cg_block_has_lift(l.body)
        checker::TExprStmt as es => cg_expr_has_lift(es.expr)
        checker::TDeferStmt as d => cg_block_has_lift(d.body)
        checker::TAdoptStmt as a => cg_block_has_lift(a.body)
        checker::TBlockStmt as b => cg_block_has_lift(b.body)
        checker::TBreakStmt => false
        checker::TContinueStmt => false
        checker::TSpawn => true
    }
}

fn cg_block_has_lift(stmts: []@TStatement()): bool {
    var i = 0
    loop { if i >= stmts.len { break }; if cg_stmt_has_lift(stmts[i]) { return true }; i++ }
    false
}

fn cg_lift_lambdas(prog: CgProg): LiftResult {
    var acc = StampAcc { next = 0; next_spawn = 0; fns = tfnvec_new(); lams = tlamvec_new(); spawns = [] }
    var mapped: [prog.items.len]@TItem() = []
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if cg_block_has_lift(f.body) {
                    var nb = cg_lift_block(f.body, acc)
                    mapped[i] = checker::TFunction { overload_suffix = f.overload_suffix; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; return_type = f.return_type; body = nb; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = f.namespace; file = f.file; line = f.line; col = f.col; is_test = f.is_test; is_extern = f.is_extern; c_symbol = f.c_symbol; from_lib = f.from_lib; ret_extra = f.ret_extra; guard = f.guard }
                } else {
                    mapped[i] = prog.items[i]
                }
            }
            (@TStatement()) as ts => {
                if cg_stmt_has_lift(ts) {
                    mapped[i] = cg_lift_stmt(ts, acc)
                } else {
                    mapped[i] = prog.items[i]
                }
            }
            _ => mapped[i] = prog.items[i]
        }
        i++
    }
    var lifted_fns = tfnvec_flat(acc.fns)
    var items: [prog.items.len + lifted_fns.len]@TItem() = []
    var m: u64 = 0
    loop {
        if m >= prog.items.len { break }
        items[m] = mapped[m]
        m++
    }
    var j: u64 = 0
    loop {
        if j >= lifted_fns.len { break }
        items[prog.items.len + j] = lifted_fns[j]
        j++
    }
    LiftResult { prog = checker::TProgram { items = items }; lams = tlamvec_flat(acc.lams); spawns = acc.spawns }
}
fn cg_lift_block(stmts: []@TStatement(), ref acc: StampAcc): []@TStatement() {
    var out: [stmts.len]@TStatement() = []
    var i = 0
    loop { if i >= stmts.len { break }; out[i] = cg_lift_stmt(stmts[i], acc); i++ }
    out
}
fn cg_lift_stmt(s: @TStatement(), ref acc: StampAcc): @TStatement() {
    match s {
        checker::TBinding as b => checker::TBinding { kind = b.kind; target = b.target; bound = b.bound; value = cg_lift_expr(b.value, acc) }
        checker::TAssign as a => checker::TAssign { kind = a.kind; name = a.name; op = a.op; bound = a.bound; value = cg_lift_expr(a.value, acc); deref = a.deref; target = if parser::assign_has_target(a.kind) { cg_lift_expr(a.target, acc) } else { a.target } }
        checker::TReturn as r => checker::TReturn { has_value = r.has_value; value = if r.has_value { cg_lift_expr(r.value, acc) } else { r.value }; values = [] }
        checker::TLoopStmt as l => checker::TLoopStmt { label = l.label; init = cg_lift_block(l.init, acc); body = cg_lift_block(l.body, acc) }
        checker::TExprStmt as es => checker::TExprStmt { expr = cg_lift_expr(es.expr, acc) }
        checker::TDeferStmt as d => checker::TDeferStmt { body = cg_lift_block(d.body, acc) }
        checker::TAdoptStmt as a => checker::TAdoptStmt { name = a.name; body = cg_lift_block(a.body, acc) }
        checker::TBlockStmt as b => checker::TBlockStmt { body = cg_lift_block(b.body, acc) }
        checker::TBreakStmt => s
        checker::TContinueStmt => s
        checker::TSpawn as sp => {
            var k = acc.next_spawn
            acc = StampAcc { next = acc.next; next_spawn = k + 1; fns = acc.fns; lams = acc.lams; spawns = acc.spawns }
            var stamped = checker::TSpawn { call = cg_lift_expr(sp.call, acc); id = k }
            acc = StampAcc { next = acc.next; next_spawn = acc.next_spawn; fns = acc.fns; lams = acc.lams; spawns = [..acc.spawns, stamped] }
            stamped
        }
    }
}
fn cg_lift_expr(e: checker::TExpr, ref acc: StampAcc): checker::TExpr {
    match e.kind {
        checker::TLambda as lam => {
            var id = acc.next
            acc = StampAcc { next = id + 1; next_spawn = acc.next_spawn; fns = acc.fns; lams = acc.lams; spawns = acc.spawns }
            var nbody = cg_lift_block(lam.body, acc)
            var newfns = acc.fns
            var newlams = acc.lams
            var stamped = checker::TLambda { params = lam.params; body = nbody; captures = lam.captures; ret = lam.ret; lift_id = id }
            if lam.captures.len == 0 {
                var ps: []parser::Param = []
                var pi = 0
                loop { if pi >= lam.params.len { break }; ps = [..ps, parser::Param { name = lam.params[pi].name; has_type = true; type_ann = checker::type_to_texpr(lam.params[pi].type); is_params = false; has_default = false; default_expr = parser::no_expr() }]; pi++ }
                newfns = tfnvec_push(newfns, checker::TFunction { overload_suffix = ""; name = lam_fn_name(id); type_params = []; type_constraints = []; params = ps; return_type = lam.ret; body = nbody; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); namespace = ""; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; ret_extra = []; guard = parser::pred_true() })
            } else {
                newlams = tlamvec_push(newlams, stamped)
            }
            acc = StampAcc { next = acc.next; next_spawn = acc.next_spawn; fns = newfns; lams = newlams; spawns = acc.spawns }
            checker::TExpr { kind = stamped; type = e.type; line = e.line; col = e.col }
        }
        checker::TBinary as b => checker::TExpr { kind = checker::TBinary { op = b.op; left = cg_lift_expr(b.left, acc); right = cg_lift_expr(b.right, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TUnary as u => checker::TExpr { kind = checker::TUnary { op = u.op; operand = cg_lift_expr(u.operand, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TCompare as c => {
            var terms: []checker::TCmpTerm = []
            var i = 0
            loop { if i >= c.rest.len { break }; terms = [..terms, checker::TCmpTerm { op = c.rest[i].op; operand = cg_lift_expr(c.rest[i].operand, acc) }]; i++ }
            checker::TExpr { kind = checker::TCompare { first = cg_lift_expr(c.first, acc); rest = terms }; type = e.type; line = e.line; col = e.col }
        }
        checker::TCall as cl => {
            var args: []checker::TExpr = []
            var i = 0
            loop { if i >= cl.args.len { break }; args = [..args, cg_lift_expr(cl.args[i], acc)]; i++ }
            checker::TExpr { kind = checker::TCall { overload_suffix = cl.overload_suffix; callee = cl.callee; args = args; call_ns = cl.call_ns; is_closure_call = cl.is_closure_call; callee_type = cl.callee_type; is_iface_dispatch = cl.is_iface_dispatch; iface_slot = cl.iface_slot; type_args = cl.type_args; ret_extra = cl.ret_extra }; type = e.type; line = e.line; col = e.col }
        }
        checker::TIfExpr as f => checker::TExpr { kind = checker::TIfExpr { cond = cg_lift_expr(f.cond, acc); then_blk = cg_lift_block(f.then_blk, acc); has_else = f.has_else; else_blk = cg_lift_block(f.else_blk, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TMatchExpr as m => {
            var arms: []checker::TArm = []
            var i = 0
            loop { if i >= m.arms.len { break }; var a = m.arms[i]; arms = [..arms, checker::TArm { pattern = a.pattern; has_when = a.has_when; guard = if a.has_when { cg_lift_expr(a.guard, acc) } else { a.guard }; body = cg_lift_block(a.body, acc) }]; i++ }
            checker::TExpr { kind = checker::TMatchExpr { subject = cg_lift_expr(m.subject, acc); arms = arms }; type = e.type; line = e.line; col = e.col }
        }
        checker::TCast as ct => checker::TExpr { kind = checker::TCast { expr = cg_lift_expr(ct.expr, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TFieldAccess as fa => checker::TExpr { kind = checker::TFieldAccess { receiver = cg_lift_expr(fa.receiver, acc); field = fa.field }; type = e.type; line = e.line; col = e.col }
        checker::TStructInit as si => {
            var vals: []checker::TExpr = []
            var i = 0
            loop { if i >= si.field_vals.len { break }; vals = [..vals, cg_lift_expr(si.field_vals[i], acc)]; i++ }
            checker::TExpr { kind = checker::TStructInit { field_names = si.field_names; field_vals = vals }; type = e.type; line = e.line; col = e.col }
        }
        checker::TIndex as ix => checker::TExpr { kind = checker::TIndex { receiver = cg_lift_expr(ix.receiver, acc); index = cg_lift_expr(ix.index, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TInterp as in => {
            var holes: []checker::TExpr = []
            var specs: []checker::TFSpec = []
            var i = 0
            loop {
                if i >= in.holes.len { break }
                holes = [..holes, cg_lift_expr(in.holes[i], acc)]
                if i < in.specs.len {
                    var sp = in.specs[i]
                    var lifted_sp = match sp.kind {
                        checker::TFSpecDynamic as fd => {
                            var args: []checker::TExpr = []
                            var k = 0
                            loop { if k >= fd.args.len { break }; args = [..args, cg_lift_expr(fd.args[k], acc)]; k++ }
                            checker::TFSpec { kind = checker::TFSpecDynamic { args = args } }
                        }
                        _ => sp
                    }
                    specs = [..specs, lifted_sp]
                }
                i++
            }
            checker::TExpr { kind = checker::TInterp { pieces = in.pieces; holes = holes; specs = specs }; type = e.type; line = e.line; col = e.col }
        }
        checker::TInExpr as ie => {
            var elems: []checker::TExpr = []
            var i = 0
            loop { if i >= ie.elems.len { break }; elems = [..elems, cg_lift_expr(ie.elems[i], acc)]; i++ }
            checker::TExpr { kind = checker::TInExpr { lhs = cg_lift_expr(ie.lhs, acc); elems = elems }; type = e.type; line = e.line; col = e.col }
        }
        checker::TArrayLit as a => {
            var elems: []checker::TArrayElem = []
            var i = 0
            loop { if i >= a.elements.len { break }; elems = [..elems, checker::TArrayElem { is_spread = a.elements[i].is_spread; expr = cg_lift_expr(a.elements[i].expr, acc) }]; i++ }
            checker::TExpr { kind = checker::TArrayLit { elements = elems }; type = e.type; line = e.line; col = e.col }
        }
        checker::TBlockExpr as blk => checker::TExpr { kind = checker::TBlockExpr { body = cg_lift_block(blk.body, acc) }; type = e.type; line = e.line; col = e.col }
        _ => e
    }
}

/**
 * cg_lambda_dctx — the defer context for a lifted lambda body: no defers or loops, and the base
 * allocation region is the lambda's own `_tkrgn` parameter (lambdas are uniformly above the line).
 *
 * @return  the lambda body's defer context
 */
fn cg_lambda_dctx(): DeferCtx {
    DeferCtx { defers = []; loops = []; cov = cov_off(); rr = ""; bracket_depth = 0; cur = ""; regbase = "_tkrgn" }
}

fn cg_emit_lambda_decls(buf: teko::io::FileStream, prog: CgProg, lams: []checker::TLambda, protos_only: bool) {
    var li = 0
    loop {
        if li >= lams.len { break }
        var lam = lams[li]
        if protos_only {
            buf.write("typedef struct { ")
            var ci = 0
            loop {
                if ci >= lam.captures.len { break }
                emit_type(buf, prog, lam.captures[ci].type)
                buf.write(" ")
                cb_ident(buf, lam.captures[ci].name)
                buf.write("; ")
                ci++
            }
            buf.write("} __tkenv_"); cb_u64_digits(buf, lam.lift_id); buf.write(";\n")
        }
        emit_type(buf, prog, lam.ret)
        buf.write(" ")
        cb_fn_name(buf, "", lam_fn_name(lam.lift_id))
        buf.write("(void *envp")
        var pi = 0
        loop {
            if pi >= lam.params.len { break }
            buf.write(", ")
            emit_type(buf, prog, lam.params[pi].type)
            buf.write(" ")
            cb_ident(buf, lam.params[pi].name)
            pi++
        }
        buf.write(", tk_region *_tkrgn)")
        if protos_only {
            buf.write(";\n")
        } else {
            buf.write(" {\n")
            buf.write("    __tkenv_"); cb_u64_digits(buf, lam.lift_id); buf.write(" *_e = envp;\n")
            var ui = 0
            loop {
                if ui >= lam.captures.len { break }
                buf.write("    ")
                emit_type(buf, prog, lam.captures[ui].type)
                buf.write(" ")
                cb_ident(buf, lam.captures[ui].name)
                buf.write(" = _e->")
                cb_ident(buf, lam.captures[ui].name)
                buf.write(";\n")
                ui++
            }
            emit_block_tail(buf, lam.body, false, prog, lam.ret, "    ", "", [], [], lam.body, cg_lambda_dctx())
            buf.write("}\n")
        }
        li++
    }
}

fn cb_vtthunk_name(buf: teko::io::FileStream, cd_name: str, idd_name: str, method: str) {
    buf.write("tk_vtthunk_")
    cb_tysym(buf, cd_name)
    buf.write("__")
    cb_tysym(buf, idd_name)
    buf.write("__")
    cb_ident(buf, method)
}

fn cg_emit_vtthunk_def(buf: teko::io::FileStream, prog: CgProg, cd_name: str, idd_name: str, mns: str, method: str) {
    var f = match cg_find_function(prog, mns, method) { checker::TFunction as tf => tf; error => panic("codegen: vtable thunk cannot resolve its concrete method (internal)") }
    if f.params.len == 0 { panic("codegen: vtable thunk method has no receiver parameter (internal)") }
    emit_type(buf, prog, f.return_type)
    buf.write(" ")
    cb_vtthunk_name(buf, cd_name, idd_name, method)
    buf.write("(void *self")
    var pi: u64 = 1
    loop {
        if pi >= f.params.len { break }
        buf.write(", ")
        emit_type_expr(buf, prog, f.params[pi].type_ann, f.namespace)
        buf.write(" ")
        cb_ident(buf, f.params[pi].name)
        pi++
    }
    var returns_void = match f.return_type { checker::Void => true; _ => false }
    buf.write(", tk_region *_tkrgn) { ")
    buf.write(if returns_void { "" } else { "return " })
    cb_fn_name(buf, mns, method)
    buf.write("(")
    cg_emit_vtthunk_receiver(buf, prog, cd_name, f.params[0].type_ann, f.namespace)
    var ai: u64 = 1
    loop {
        if ai >= f.params.len { break }
        buf.write(", ")
        cb_ident(buf, f.params[ai].name)
        ai++
    }
    if cg_fn_needs_region(prog, f) { buf.write(", _tkrgn") }
    buf.write("); }\n")
}

fn cg_emit_vtthunk_receiver(buf: teko::io::FileStream, prog: CgProg, cd_name: str, recv_ann: @TypeExpr(), recv_ns: str) {
    var thunk_base = cg_vtthunk_base_name(recv_ann)
    if thunk_base.len > 0 && cg_is_polymorphic_base(prog, thunk_base) {
        buf.write("(tk_base_")
        cb_tysym(buf, thunk_base)
        buf.write("){ .data = self, .vtable = ")
        buf.write("tk_vt_")
        cb_tysym(buf, cd_name)
        buf.write("_")
        cb_tysym(buf, thunk_base)
        buf.write(" }")
        return
    }
    buf.write("(")
    emit_type_expr(buf, prog, recv_ann, recv_ns)
    buf.write(")self")
}

fn cg_vtthunk_base_name(recv_ann: @TypeExpr()): str {
    match recv_ann {
        parser::NamedType as nt => nt.path.segments[nt.path.segments.len - 1].name
        _ => ""
    }
}

fn cg_method_is_instance(m: parser::Function): bool {
    m.params.len > 0 && !m.params[0].has_type
}

fn cg_emit_vtable_slot(buf: teko::io::FileStream, prog: CgProg, cd_name: str, idd_name: str, m: parser::Function) {
    if cg_method_is_instance(m) {
        buf.write("(void *)&")
        cb_vtthunk_name(buf, cd_name, idd_name, m.name)
        return
    }
    var mns = match cg_find_method_ns(prog, cd_name, m.name) {
        str as ns2 => ns2
        null => panic("codegen: conforming class is missing a vtable method's stamped function (internal)")
    }
    buf.write("(void *)&")
    cb_fn_name(buf, mns, m.name)
}

fn cg_pair_is_iface_vtable(cd: parser::TypeDecl, idd: parser::TypeDecl, vt_table: checker::TypeTable): bool {
    var idd_is_iface = match idd.body { parser::InterfaceBody => true; _ => false }
    idd_is_iface && checker::type_conforms_to(cd.name, idd.name, vt_table)
}

fn cg_class_is_abstract(cd: parser::TypeDecl): bool {
    match cd.body {
        parser::ClassBody as cb => match cb.kind { parser::ClassKind::Abstract => true; _ => false }
        _ => false
    }
}

fn cg_pair_is_base_vtable(prog: CgProg, cd: parser::TypeDecl, idd: parser::TypeDecl): bool {
    var idd_is_poly_base = cg_is_polymorphic_base(prog, idd.name)
    var cd_is_instantiable_self = cd.name == idd.name && !cg_class_is_abstract(cd)
    var cd_is_a = cd_is_instantiable_self || cg_subclass_reaches(prog, cd.name, idd.name, SUBCLASS_CHAIN_DEPTH_LIMIT)
    idd_is_poly_base && cd_is_a
}

fn cg_emit_vtable_def(buf: teko::io::FileStream, prog: CgProg, cd_name: str, idd_name: str, method_list: []parser::Function) {
    buf.write("static void *const tk_vt_")
    cb_tysym(buf, cd_name)
    buf.write("_")
    cb_tysym(buf, idd_name)
    buf.write("[] = {")
    if method_list.len == 0 { buf.write(" (void *)0") }
    var i: u64 = 0
    loop {
        if i >= method_list.len { break }
        buf.write(if i == 0 { " " } else { ", " })
        cg_emit_vtable_slot(buf, prog, cd_name, idd_name, method_list[i])
        i++
    }
    buf.write(" };\n")
}

fn cg_vtthunk_name_str(cd_name: str, idd_name: str, method: str): str {
    teko::str::concat("tk_vtthunk_", teko::str::concat(cb_tysym_str(cd_name), teko::str::concat("__", teko::str::concat(cb_tysym_str(idd_name), teko::str::concat("__", cb_ident_str(method))))))
}

fn cg_emit_vtable_thunks(buf: teko::io::FileStream, prog: CgProg, cd_name: str, idd_name: str, method_list: []parser::Function, emitted: []str): []str {
    var seen = emitted
    var i: u64 = 0
    loop {
        if i >= method_list.len { break }
        var m = method_list[i]
        i++
        if !cg_method_is_instance(m) { continue }
        var key = cg_vtthunk_name_str(cd_name, idd_name, m.name)
        if cg_str_in(seen, key) { continue }
        var mns = match cg_find_method_ns(prog, cd_name, m.name) {
            str as ns2 => ns2
            null => panic("codegen: conforming class is missing a vtable method's stamped function (internal)")
        }
        cg_emit_vtthunk_def(buf, prog, cd_name, idd_name, mns, m.name)
        seen = [..seen, key]
    }
    seen
}

fn cg_emit_vtables_and_thunks(buf: teko::io::FileStream, prog: CgProg) {
    var vt_table = cg_type_table(prog)
    cg_emit_vtable_protos(buf, prog, vt_table)
    cg_emit_all_vtthunks(buf, prog, vt_table)
    cg_emit_all_vtable_defs(buf, prog, vt_table)
}

fn cg_emit_vtable_protos(buf: teko::io::FileStream, prog: CgProg, vt_table: checker::TypeTable) {
    var ci = 0
    loop {
        if ci >= prog.items.len { break }
        match prog.items[ci] {
            parser::TypeDecl as cd => {
                if match cd.body { parser::ClassBody => true; _ => false } {
                    var ii = 0
                    loop {
                        if ii >= prog.items.len { break }
                        match prog.items[ii] {
                            parser::TypeDecl as idd => {
                                if cg_pair_is_iface_vtable(cd, idd, vt_table) { cg_emit_vtable_proto_line(buf, cd.name, idd.name) }
                                if cg_pair_is_base_vtable(prog, cd, idd) { cg_emit_vtable_proto_line(buf, cd.name, idd.name) }
                            }
                            _ => { }
                        }
                        ii++
                    }
                }
            }
            _ => { }
        }
        ci++
    }
}

fn cg_emit_vtable_proto_line(buf: teko::io::FileStream, cd_name: str, idd_name: str) {
    buf.write("static void *const tk_vt_")
    cb_tysym(buf, cd_name)
    buf.write("_")
    cb_tysym(buf, idd_name)
    buf.write("[];\n")
}

fn cg_emit_all_vtthunks(buf: teko::io::FileStream, prog: CgProg, vt_table: checker::TypeTable) {
    var emitted: []str = []
    var ci = 0
    loop {
        if ci >= prog.items.len { break }
        match prog.items[ci] {
            parser::TypeDecl as cd => {
                if match cd.body { parser::ClassBody => true; _ => false } {
                    var ii = 0
                    loop {
                        if ii >= prog.items.len { break }
                        match prog.items[ii] {
                            parser::TypeDecl as idd => {
                                if cg_pair_is_iface_vtable(cd, idd, vt_table) {
                                    var ms = match checker::iface_methods_by_name(idd.name, vt_table) { []parser::Function as f => f; error => panic("codegen: interface method list failed (internal)") }
                                    emitted = cg_emit_vtable_thunks(buf, prog, cd.name, idd.name, ms, emitted)
                                }
                                if cg_pair_is_base_vtable(prog, cd, idd) {
                                    var bms = match checker::base_vtable_methods(idd.name, vt_table) { []parser::Function as f => f; error => panic("codegen: base method list failed (internal)") }
                                    emitted = cg_emit_vtable_thunks(buf, prog, cd.name, idd.name, bms, emitted)
                                }
                            }
                            _ => { }
                        }
                        ii++
                    }
                }
            }
            _ => { }
        }
        ci++
    }
}

fn cg_emit_all_vtable_defs(buf: teko::io::FileStream, prog: CgProg, vt_table: checker::TypeTable) {
    var ci = 0
    loop {
        if ci >= prog.items.len { break }
        match prog.items[ci] {
            parser::TypeDecl as cd => {
                if match cd.body { parser::ClassBody => true; _ => false } {
                    var ii = 0
                    loop {
                        if ii >= prog.items.len { break }
                        match prog.items[ii] {
                            parser::TypeDecl as idd => {
                                if cg_pair_is_iface_vtable(cd, idd, vt_table) {
                                    var ms = match checker::iface_methods_by_name(idd.name, vt_table) { []parser::Function as f => f; error => panic("codegen: interface method list failed (internal)") }
                                    cg_emit_vtable_def(buf, prog, cd.name, idd.name, ms)
                                }
                                if cg_pair_is_base_vtable(prog, cd, idd) {
                                    var bms = match checker::base_vtable_methods(idd.name, vt_table) { []parser::Function as f => f; error => panic("codegen: base method list failed (internal)") }
                                    cg_emit_vtable_def(buf, prog, cd.name, idd.name, bms)
                                }
                            }
                            _ => { }
                        }
                        ii++
                    }
                }
            }
            _ => { }
        }
        ci++
    }
}

type SyscallUse = struct {
    s0: bool
    s1: bool
    s2: bool
    s3: bool
    s4: bool
    s5: bool
    s6: bool
    clone: bool
    atomics: bool
}

fn cg_syscall_use_none(): SyscallUse {
    SyscallUse { s0 = false; s1 = false; s2 = false; s3 = false; s4 = false; s5 = false; s6 = false; clone = false; atomics = false }
}

fn cg_mark_syscall_call(prog: CgProg, c: checker::TCall, used: SyscallUse): SyscallUse {
    if cg_call_is_user_declared(prog, c) { return used }
    var p = c.callee
    var qualifier_ok = p.segments.len == 1 || p.segments[0].name == "teko"
    if !qualifier_ok { return used }
    var last = p.segments[p.segments.len - 1].name
    if last == "syscall0" { return SyscallUse { s0 = true; s1 = used.s1; s2 = used.s2; s3 = used.s3; s4 = used.s4; s5 = used.s5; s6 = used.s6; clone = used.clone; atomics = used.atomics } }
    if last == "syscall1" { return SyscallUse { s0 = used.s0; s1 = true; s2 = used.s2; s3 = used.s3; s4 = used.s4; s5 = used.s5; s6 = used.s6; clone = used.clone; atomics = used.atomics } }
    if last == "syscall2" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = true; s3 = used.s3; s4 = used.s4; s5 = used.s5; s6 = used.s6; clone = used.clone; atomics = used.atomics } }
    if last == "syscall3" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = used.s2; s3 = true; s4 = used.s4; s5 = used.s5; s6 = used.s6; clone = used.clone; atomics = used.atomics } }
    if last == "syscall4" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = used.s2; s3 = used.s3; s4 = true; s5 = used.s5; s6 = used.s6; clone = used.clone; atomics = used.atomics } }
    if last == "syscall5" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = used.s2; s3 = used.s3; s4 = used.s4; s5 = true; s6 = used.s6; clone = used.clone; atomics = used.atomics } }
    if last == "syscall6" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = used.s2; s3 = used.s3; s4 = used.s4; s5 = used.s5; s6 = true; clone = used.clone; atomics = used.atomics } }
    if last == "thread_clone" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = used.s2; s3 = used.s3; s4 = used.s4; s5 = used.s5; s6 = used.s6; clone = true; atomics = used.atomics } }
    if last == "atomic_cas_u32" || last == "atomic_xchg_u32" || last == "atomic_add_u32" || last == "atomic_load_u32" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = used.s2; s3 = used.s3; s4 = used.s4; s5 = used.s5; s6 = used.s6; clone = used.clone; atomics = true } }
    used
}

fn cg_scan_syscall_expr(prog: CgProg, e: checker::TExpr, used: SyscallUse): SyscallUse {
    match e.kind {
        checker::TLambda as lam => cg_scan_syscall_block(prog, lam.body, used)
        checker::TBinary as b => cg_scan_syscall_expr(prog, b.right, cg_scan_syscall_expr(prog, b.left, used))
        checker::TUnary as u => cg_scan_syscall_expr(prog, u.operand, used)
        checker::TCompare as c => {
            var acc = cg_scan_syscall_expr(prog, c.first, used)
            var i = 0
            loop { if i >= c.rest.len { break }; acc = cg_scan_syscall_expr(prog, c.rest[i].operand, acc); i++ }
            acc
        }
        checker::TCall as cl => {
            var acc = cg_mark_syscall_call(prog, cl, used)
            var i = 0
            loop { if i >= cl.args.len { break }; acc = cg_scan_syscall_expr(prog, cl.args[i], acc); i++ }
            acc
        }
        checker::TIfExpr as f => {
            var acc = cg_scan_syscall_block(prog, f.then_blk, cg_scan_syscall_expr(prog, f.cond, used))
            cg_scan_syscall_block(prog, f.else_blk, acc)
        }
        checker::TMatchExpr as m => {
            var acc = cg_scan_syscall_expr(prog, m.subject, used)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                var a = m.arms[i]
                if a.has_when { acc = cg_scan_syscall_expr(prog, a.guard, acc) }
                acc = cg_scan_syscall_block(prog, a.body, acc)
                i++
            }
            acc
        }
        checker::TCast as ct => cg_scan_syscall_expr(prog, ct.expr, used)
        checker::TFieldAccess as fa => cg_scan_syscall_expr(prog, fa.receiver, used)
        checker::TStructInit as si => {
            var acc = used
            var i = 0
            loop { if i >= si.field_vals.len { break }; acc = cg_scan_syscall_expr(prog, si.field_vals[i], acc); i++ }
            acc
        }
        checker::TIndex as ix => cg_scan_syscall_expr(prog, ix.index, cg_scan_syscall_expr(prog, ix.receiver, used))
        checker::TInterp as in => {
            var acc = used
            var i = 0
            loop {
                if i >= in.holes.len { break }
                acc = cg_scan_syscall_expr(prog, in.holes[i], acc)
                if i < in.specs.len {
                    match in.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; acc = cg_scan_syscall_expr(prog, fd.args[k], acc); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            acc
        }
        checker::TInExpr as ie => {
            var acc = cg_scan_syscall_expr(prog, ie.lhs, used)
            var i = 0
            loop { if i >= ie.elems.len { break }; acc = cg_scan_syscall_expr(prog, ie.elems[i], acc); i++ }
            acc
        }
        checker::TArrayLit as a => {
            var acc = used
            var i = 0
            loop { if i >= a.elements.len { break }; acc = cg_scan_syscall_expr(prog, a.elements[i].expr, acc); i++ }
            acc
        }
        checker::TBlockExpr as blk => cg_scan_syscall_block(prog, blk.body, used)
        _ => used
    }
}

fn cg_scan_syscall_stmt(prog: CgProg, s: @TStatement(), used: SyscallUse): SyscallUse {
    match s {
        checker::TBinding as b => cg_scan_syscall_expr(prog, b.value, used)
        checker::TAssign as a => {
            var acc = cg_scan_syscall_expr(prog, a.value, used)
            if parser::assign_has_target(a.kind) { acc = cg_scan_syscall_expr(prog, a.target, acc) }
            acc
        }
        checker::TReturn as r => if r.has_value { cg_scan_syscall_expr(prog, r.value, used) } else { used }
        checker::TLoopStmt as l => cg_scan_syscall_block(prog, l.body, cg_scan_syscall_block(prog, l.init, used))
        checker::TExprStmt as es => cg_scan_syscall_expr(prog, es.expr, used)
        checker::TDeferStmt as d => cg_scan_syscall_block(prog, d.body, used)
        checker::TAdoptStmt as a => cg_scan_syscall_block(prog, a.body, used)
        checker::TBlockStmt as b => cg_scan_syscall_block(prog, b.body, used)
        checker::TBreakStmt => used
        checker::TContinueStmt => used
        checker::TSpawn as sp => cg_scan_syscall_expr(prog, sp.call, used)
    }
}

fn cg_scan_syscall_block(prog: CgProg, stmts: []@TStatement(), used: SyscallUse): SyscallUse {
    var acc = used
    var i = 0
    loop { if i >= stmts.len { break }; acc = cg_scan_syscall_stmt(prog, stmts[i], acc); i++ }
    acc
}

fn cg_scan_syscall_arities(prog: CgProg): SyscallUse {
    var used = cg_syscall_use_none()
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { if !f.is_extern { used = cg_scan_syscall_block(prog, f.body, used) } }
            (@TStatement()) as ts => { used = cg_scan_syscall_stmt(prog, ts, used) }
            _ => { }
        }
        i++
    }
    used
}

fn cg_emit_syscall_helper_text(arity: u64): str {
    if arity == 0 to u64 {
        return "static inline long tk_syscall0(long n) {\n    long ret;\n    __asm__ volatile (\"syscall\" : \"=a\"(ret) : \"a\"(n) : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    if arity == 1 to u64 {
        return "static inline long tk_syscall1(long n, long a1) {\n    long ret;\n    __asm__ volatile (\"syscall\" : \"=a\"(ret) : \"a\"(n), \"D\"(a1) : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    if arity == 2 to u64 {
        return "static inline long tk_syscall2(long n, long a1, long a2) {\n    long ret;\n    __asm__ volatile (\"syscall\" : \"=a\"(ret) : \"a\"(n), \"D\"(a1), \"S\"(a2) : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    if arity == 3 to u64 {
        return "static inline long tk_syscall3(long n, long a1, long a2, long a3) {\n    long ret;\n    __asm__ volatile (\"syscall\"\n        : \"=a\"(ret) : \"a\"(n), \"D\"(a1), \"S\"(a2), \"d\"(a3) : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    if arity == 4 to u64 {
        return "static inline long tk_syscall4(long n, long a1, long a2, long a3, long a4) {\n    long ret; register long r10 __asm__(\"r10\") = a4;\n    __asm__ volatile (\"syscall\"\n        : \"=a\"(ret) : \"a\"(n), \"D\"(a1), \"S\"(a2), \"d\"(a3), \"r\"(r10) : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    if arity == 5 to u64 {
        return "static inline long tk_syscall5(long n, long a1, long a2, long a3, long a4, long a5) {\n    long ret; register long r10 __asm__(\"r10\") = a4; register long r8 __asm__(\"r8\") = a5;\n    __asm__ volatile (\"syscall\"\n        : \"=a\"(ret) : \"a\"(n), \"D\"(a1), \"S\"(a2), \"d\"(a3), \"r\"(r10), \"r\"(r8) : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    if arity == 6 to u64 {
        return "static inline long tk_syscall6(long n, long a1, long a2, long a3, long a4, long a5, long a6) {\n    long ret;\n    register long r10 __asm__(\"r10\") = a4;\n    register long r8  __asm__(\"r8\")  = a5;\n    register long r9  __asm__(\"r9\")  = a6;\n    __asm__ volatile (\"syscall\"\n        : \"=a\"(ret)\n        : \"a\"(n), \"D\"(a1), \"S\"(a2), \"d\"(a3), \"r\"(r10), \"r\"(r8), \"r\"(r9)\n        : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    ""
}

fn cg_emit_syscall_helper_text_aarch64(arity: u64): str {
    if arity == 0 to u64 {
        return "static inline long tk_syscall0(long n) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\");\n    __asm__ volatile (\"svc #0\" : \"=r\"(x0) : \"r\"(x8) : \"memory\");\n    return x0;\n}\n"
    }
    if arity == 1 to u64 {
        return "static inline long tk_syscall1(long n, long a1) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\") = a1;\n    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8) : \"memory\");\n    return x0;\n}\n"
    }
    if arity == 2 to u64 {
        return "static inline long tk_syscall2(long n, long a1, long a2) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\") = a1;\n    register long x1 __asm__(\"x1\") = a2;\n    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8), \"r\"(x1) : \"memory\");\n    return x0;\n}\n"
    }
    if arity == 3 to u64 {
        return "static inline long tk_syscall3(long n, long a1, long a2, long a3) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\") = a1;\n    register long x1 __asm__(\"x1\") = a2;\n    register long x2 __asm__(\"x2\") = a3;\n    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8), \"r\"(x1), \"r\"(x2) : \"memory\");\n    return x0;\n}\n"
    }
    if arity == 4 to u64 {
        return "static inline long tk_syscall4(long n, long a1, long a2, long a3, long a4) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\") = a1;\n    register long x1 __asm__(\"x1\") = a2;\n    register long x2 __asm__(\"x2\") = a3;\n    register long x3 __asm__(\"x3\") = a4;\n    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8), \"r\"(x1), \"r\"(x2), \"r\"(x3) : \"memory\");\n    return x0;\n}\n"
    }
    if arity == 5 to u64 {
        return "static inline long tk_syscall5(long n, long a1, long a2, long a3, long a4, long a5) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\") = a1;\n    register long x1 __asm__(\"x1\") = a2;\n    register long x2 __asm__(\"x2\") = a3;\n    register long x3 __asm__(\"x3\") = a4;\n    register long x4 __asm__(\"x4\") = a5;\n    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8), \"r\"(x1), \"r\"(x2), \"r\"(x3), \"r\"(x4) : \"memory\");\n    return x0;\n}\n"
    }
    if arity == 6 to u64 {
        return "static inline long tk_syscall6(long n, long a1, long a2, long a3, long a4, long a5, long a6) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\") = a1;\n    register long x1 __asm__(\"x1\") = a2;\n    register long x2 __asm__(\"x2\") = a3;\n    register long x3 __asm__(\"x3\") = a4;\n    register long x4 __asm__(\"x4\") = a5;\n    register long x5 __asm__(\"x5\") = a6;\n    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8), \"r\"(x1), \"r\"(x2), \"r\"(x3), \"r\"(x4), \"r\"(x5) : \"memory\");\n    return x0;\n}\n"
    }
    ""
}

fn cg_syscall_use_any(used: SyscallUse): bool {
    used.s0 || used.s1 || used.s2 || used.s3 || used.s4 || used.s5 || used.s6
}

fn cg_emit_syscall_helpers_x86_64(buf: teko::io::FileStream, used: SyscallUse) {
    if used.s0 { buf.write(cg_emit_syscall_helper_text(0 to u64)) }
    if used.s1 { buf.write(cg_emit_syscall_helper_text(1 to u64)) }
    if used.s2 { buf.write(cg_emit_syscall_helper_text(2 to u64)) }
    if used.s3 { buf.write(cg_emit_syscall_helper_text(3 to u64)) }
    if used.s4 { buf.write(cg_emit_syscall_helper_text(4 to u64)) }
    if used.s5 { buf.write(cg_emit_syscall_helper_text(5 to u64)) }
    if used.s6 { buf.write(cg_emit_syscall_helper_text(6 to u64)) }
}

fn cg_emit_syscall_helpers_aarch64(buf: teko::io::FileStream, used: SyscallUse) {
    if used.s0 { buf.write(cg_emit_syscall_helper_text_aarch64(0 to u64)) }
    if used.s1 { buf.write(cg_emit_syscall_helper_text_aarch64(1 to u64)) }
    if used.s2 { buf.write(cg_emit_syscall_helper_text_aarch64(2 to u64)) }
    if used.s3 { buf.write(cg_emit_syscall_helper_text_aarch64(3 to u64)) }
    if used.s4 { buf.write(cg_emit_syscall_helper_text_aarch64(4 to u64)) }
    if used.s5 { buf.write(cg_emit_syscall_helper_text_aarch64(5 to u64)) }
    if used.s6 { buf.write(cg_emit_syscall_helper_text_aarch64(6 to u64)) }
}

fn cg_emit_syscall_helpers(buf: teko::io::FileStream, used: SyscallUse) {
    if !cg_syscall_use_any(used) { return }
    buf.write("#if defined(__x86_64__) || defined(__amd64__)\n")
    buf.write("/* teko section 16 raw-syscall intrinsic (x86_64 Linux); emitted only for arities the program uses */\n")
    cg_emit_syscall_helpers_x86_64(buf, used)
    buf.write("#elif defined(__aarch64__) || defined(__arm64__)\n")
    buf.write("/* teko section 16 raw-syscall intrinsic (aarch64 Linux); emitted only for arities the program uses */\n")
    cg_emit_syscall_helpers_aarch64(buf, used)
    buf.write("#else\n")
    buf.write("#error \"teko section 16: the raw-syscall intrinsic is validated for x86_64 and aarch64 Linux only (docs/design/plano-s16-syscall-intrinsic.md section 2 and 2.5)\"\n")
    buf.write("#endif\n\n")
}

fn cond_const_c_symbol(ns: str, name: str): str {
    var out = "tk_const_"
    if ns.len != 0 {
        var nsout: [ns.len]byte = []
        var i: u64 = 0
        loop {
            if i >= ns.len { break }
            nsout[i] = if ns[i] == b':' { b'_' } else { ns[i] }
            i = i + 1
        }
        out = teko::str::concat(out, teko::str::concat(str_of_bytes(nsout), "__"))
    }
    teko::str::concat(out, cb_ident_str(name))
}

fn cc_axis_atom_cond(e: parser::PEq): str | error {
    if e.axis == "os" {
        if e.value == "linux" { return "defined(__linux__)" }
        if e.value == "macos" { return "defined(__APPLE__)" }
        if e.value == "windows" { return "defined(_WIN32)" }
    }
    if e.axis == "arch" {
        if e.value == "x86_64" { return "(defined(__x86_64__) || defined(__amd64__))" }
        if e.value == "arm64" { return "(defined(__aarch64__) || defined(__arm64__))" }
    }
    error { message = teko::str::concat("codegen section 16: cannot render a C #if condition for axis '", teko::str::concat(e.axis, teko::str::concat("' value '", teko::str::concat(e.value, "'")))) }
}

fn guard_to_c_cond(p: parser::Pred): str | error {
    match p.kind {
        parser::PTrue => "1"
        parser::PEq as e => cc_axis_atom_cond(e)
        parser::PFlag => error { message = "codegen section 16: a target-conditional const cannot depend on a build flag (`#if(<flag>)`) — only os/arch guards ladder" }
        parser::PNot as n => {
            var inner = match guard_to_c_cond(n.inner) { str as s => s; error as e => panic(e.message) }
            teko::str::concat("(!(", teko::str::concat(inner, "))"))
        }
        parser::PAnd as a => {
            var l = match guard_to_c_cond(a.left) { str as s => s; error as e => panic(e.message) }
            var r = match guard_to_c_cond(a.right) { str as s => s; error as e => panic(e.message) }
            teko::str::concat("((", teko::str::concat(l, teko::str::concat(") && (", teko::str::concat(r, "))"))))
        }
        parser::POr as o => {
            var l = match guard_to_c_cond(o.left) { str as s => s; error as e => panic(e.message) }
            var r = match guard_to_c_cond(o.right) { str as s => s; error as e => panic(e.message) }
            teko::str::concat("((", teko::str::concat(l, teko::str::concat(") || (", teko::str::concat(r, "))"))))
        }
    }
}

fn cg_cond_const_arm_value(init: checker::TExpr): str | error {
    match init.kind {
        checker::TNumber as n => if n.is_float { error { message = "codegen section 16: a target-conditional const arm must be an integer literal, not a float" } } else { cb_numint_str(n.value) }
        _ => error { message = "codegen section 16: a target-conditional const arm must be an integer literal" }
    }
}

fn cg_emit_one_cond_ladder(buf: teko::io::FileStream, prog: CgProg, fam: checker::ConstQName) {
    var sym = cond_const_c_symbol(fam.namespace, fam.name)
    var first = true
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TConstDecl as cd => {
                if cd.namespace == fam.namespace && cd.name == fam.name {
                    var cond = match guard_to_c_cond(cd.guard) { str as s => s; error as e => panic(e.message) }
                    var val = match cg_cond_const_arm_value(cd.init) { str as s => s; error as e => panic(e.message) }
                    buf.write(if first { "#if " } else { "#elif " })
                    buf.write(cond)
                    buf.write("\n#define ")
                    buf.write(sym)
                    buf.write(" ")
                    buf.write(val)
                    buf.write("\n")
                    first = false
                }
            }
            _ => { }
        }
        i = i + 1
    }
    buf.write("#endif\n")
}

fn cg_emit_cond_const_ladder(buf: teko::io::FileStream, prog: CgProg) {
    var fams = prog.cond_consts
    if fams.len == 0 { return }
    var f: u64 = 0
    loop {
        if f >= fams.len { break }
        cg_emit_one_cond_ladder(buf, prog, fams[f])
        f = f + 1
    }
    buf.write("\n")
}

fn cg_emit_global_target_guard(buf: teko::io::FileStream) {
    buf.write("#if !( (defined(__linux__) && (defined(__x86_64__) || defined(__amd64__) || defined(__aarch64__) || defined(__arm64__))) || (defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))) || (defined(_WIN32) && (defined(__x86_64__) || defined(__amd64__))) )\n")
    buf.write("#error \"unsupported (os,arch)\"\n")
    buf.write("#endif\n\n")
}

fn cg_fn_guard_cond(guard: parser::Pred): str | error {
    if !checker::pred_is_target_guard(guard) { return "" }
    guard_to_c_cond(guard)
}

fn cg_emit_fn_proto_guarded(buf: teko::io::FileStream, prog: CgProg, f: checker::TFunction) {
    if f.is_extern && f.from_lib == "teko_rt" { return }
    var gc = match cg_fn_guard_cond(f.guard) { str as s => s; error as e => panic(e.message) }
    if gc.len != 0 { buf.write("#if "); buf.write(gc); buf.write("\n") }
    emit_function_sig(buf, prog, f)
    buf.write(";\n")
    if f.is_extern && f.from_lib.len > 0 && gc == "defined(_WIN32)" {
        buf.write("#pragma comment(lib, \""); buf.write(f.from_lib); buf.write("\")\n")
    }
    if gc.len != 0 { buf.write("#endif\n") }
}

fn cg_scope_begin(): ptr {
    var scratch = teko::runtime::region_new(teko::runtime::region_current())
    teko::runtime::region_enter(scratch)
    scratch
}

fn cg_scope_end(scratch: ptr) {
    teko::runtime::region_leave()
    teko::runtime::region_drop(scratch)
}

fn cg_emit_fn_def_scoped(buf: teko::io::FileStream, prog: CgProg, f: checker::TFunction, mode: CgMode) {
    var scratch = cg_scope_begin()
    cg_emit_fn_def_guarded(buf, prog, f, mode)
    cg_scope_end(scratch)
}

fn cg_emit_fn_proto_scoped(buf: teko::io::FileStream, prog: CgProg, f: checker::TFunction) {
    var scratch = cg_scope_begin()
    cg_emit_fn_proto_guarded(buf, prog, f)
    cg_scope_end(scratch)
}

fn cg_emit_fn_def_guarded(buf: teko::io::FileStream, prog: CgProg, f: checker::TFunction, mode: CgMode) {
    if f.is_extern { return }
    var gc = match cg_fn_guard_cond(f.guard) { str as s => s; error as e => panic(e.message) }
    if gc.len != 0 { buf.write("#if "); buf.write(gc); buf.write("\n") }
    emit_function_mode(buf, prog, f, mode)
    if gc.len != 0 { buf.write("#endif\n") }
}

fn cg_emit_thread_clone_helper_text_x86_64(): str {
    "static long tk_thread_clone(long entry, long stack_top, long arg, long ctid_addr, long flags) {\n    void **sp = (void **)stack_top;\n    *(--sp) = (void *)arg;\n    *(--sp) = (void *)entry;\n    long ret;\n    register long r10 __asm__(\"r10\") = ctid_addr;\n    register long r8 __asm__(\"r8\") = 0;\n    __asm__ volatile (\n        \"syscall\\n\\t\"\n        \"testq %%rax, %%rax\\n\\t\"\n        \"jnz 1f\\n\\t\"\n        \"popq %%rax\\n\\t\"\n        \"popq %%rdi\\n\\t\"\n        \"callq *%%rax\\n\\t\"\n        \"movq $60, %%rax\\n\\t\"\n        \"xorq %%rdi, %%rdi\\n\\t\"\n        \"syscall\\n\\t\"\n        \"1:\\n\\t\"\n        : \"=a\"(ret)\n        : \"a\"(56L), \"D\"(flags), \"S\"(sp), \"d\"(0L), \"r\"(r10), \"r\"(r8)\n        : \"rcx\", \"r11\", \"memory\", \"cc\");\n    return ret;\n}\n"
}

fn cg_emit_thread_clone_helper(buf: teko::io::FileStream, want: bool) {
    if !want { return }
    buf.write("#if defined(__x86_64__) || defined(__amd64__)\n")
    buf.write("/* teko section 10 raw thread-spawn intrinsic (x86_64 Linux); emitted only if the program spawns */\n")
    buf.write(cg_emit_thread_clone_helper_text_x86_64())
    buf.write("#elif defined(__aarch64__) || defined(__arm64__)\n")
    buf.write("#error \"teko section 10 aarch64 thread_clone not yet validated on this host (docs/design/plano-s10-multithread-nativo.md section 3.4)\"\n")
    buf.write("#else\n")
    buf.write("#error \"teko section 10: thread_clone is validated for x86_64 Linux only (docs/design/plano-s10-multithread-nativo.md section 3)\"\n")
    buf.write("#endif\n\n")
}

fn cg_emit_atomic_helpers_text(): str {
    "static inline long tk_atomic_cas_u32(long addr, long expected, long desired) {\n    unsigned int e = (unsigned int)expected;\n    __atomic_compare_exchange_n((unsigned int *)(unsigned long)addr, &e, (unsigned int)desired, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);\n    return (long)(unsigned long)e;\n}\nstatic inline long tk_atomic_xchg_u32(long addr, long value) {\n    return (long)(unsigned long)__atomic_exchange_n((unsigned int *)(unsigned long)addr, (unsigned int)value, __ATOMIC_SEQ_CST);\n}\nstatic inline long tk_atomic_add_u32(long addr, long delta) {\n    return (long)(unsigned long)__atomic_fetch_add((unsigned int *)(unsigned long)addr, (unsigned int)delta, __ATOMIC_SEQ_CST);\n}\nstatic inline long tk_atomic_load_u32(long addr) {\n    return (long)(unsigned long)__atomic_load_n((unsigned int *)(unsigned long)addr, __ATOMIC_SEQ_CST);\n}\n"
}

fn cg_emit_atomic_helpers(buf: teko::io::FileStream, want: bool) {
    if !want { return }
    buf.write("/* teko section 10 atomic RMW intrinsics (futex mutex/condvar substrate); emitted only if the program uses one */\n")
    buf.write(cg_emit_atomic_helpers_text())
}

fn cg_emit_c_file_mode(prog0: checker::TProgram, mode: CgMode, out_path: str, meta: str, export_c: bool): u64 | error {
    var fs = match teko::io::FileStream::open(out_path) { teko::io::FileStream as f => f; error as e => panic(e.message) }
    defer { fs.flush(); fs.close() }
    match tk_emit_c_body(prog0, mode, fs) { error as e => panic(e.message); null => { } }
    if export_c {
        var wrappers = match cg_c_export_wrappers_text(prog0) { str as s => s; error as e => panic(e.message) }
        fs.write(wrappers)
    }
    fs.write(meta)
    fs.written
}

pub fn tk_emit_c_file(prog0: checker::TProgram, out_path: str, meta: str): u64 | error {
    cg_emit_c_file_mode(prog0, CgMode::Program, out_path, meta, false)
}

pub fn tk_emit_c_export_file(prog0: checker::TProgram, out_path: str, meta: str): u64 | error {
    cg_emit_c_file_mode(prog0, CgMode::Program, out_path, meta, true)
}

pub fn tk_emit_c_test_file(prog0: checker::TProgram, cov: bool, out_path: str, meta: str): u64 | error {
    cg_emit_c_file_mode(prog0, if cov { CgMode::TestCov } else { CgMode::TestPlain }, out_path, meta, false)
}

pub fn tk_emit_c_cov_file(prog0: checker::TProgram, out_path: str, meta: str): u64 | error {
    cg_emit_c_file_mode(prog0, CgMode::ProgramCov, out_path, meta, false)
}

pub fn tk_emit_c_test_analyze_file(prog0: checker::TProgram, out_path: str, meta: str): u64 | error {
    cg_emit_c_file_mode(prog0, CgMode::TestAnalyze, out_path, meta, false)
}

fn cg_phase_rss_enabled(): bool {
    match teko::env::var("TEKO_PHASE_RSS") { str as v => v == "1"; error => false }
}

fn cg_mb_tenths(bytes: u64): str {
    var mb10 = bytes * 10 / 1048576
    $"{mb10 / 10}.{mb10 % 10}"
}

fn cg_report_phase_rss(label: str) {
    if !cg_phase_rss_enabled() { return }
    var cur = teko::runtime::cur_rss()
    if cur == 0 { return }
    teko::io::eprintln($"teko: memory: codegen {label}: cur {cg_mb_tenths(cur)} MB / peak {cg_mb_tenths(teko::mem::peak_rss())} MB")
}

fn cg_emit_fixed_width_typedefs(buf: teko::io::FileStream) {
    buf.write("typedef __UINT8_TYPE__ uint8_t;\n")
    buf.write("typedef __INT8_TYPE__ int8_t;\n")
    buf.write("typedef __UINT16_TYPE__ uint16_t;\n")
    buf.write("typedef __INT16_TYPE__ int16_t;\n")
    buf.write("typedef __UINT32_TYPE__ uint32_t;\n")
    buf.write("typedef __INT32_TYPE__ int32_t;\n")
    buf.write("typedef __UINT64_TYPE__ uint64_t;\n")
    buf.write("typedef __INT64_TYPE__ int64_t;\n")
    buf.write("typedef __UINTPTR_TYPE__ uintptr_t;\n")
}

fn cg_emit_libc_free_intrinsics(buf: teko::io::FileStream) {
    buf.write("static double tk_floor(double x) {\n")
    buf.write("    union { double f; unsigned long long i; } u; u.f = x;\n")
    buf.write("    int e = (int)((u.i >> 52) & 0x7ff);\n")
    buf.write("    if (e >= 0x3ff + 52 || x == 0.0) { return x; }\n")
    buf.write("    double toint = 4503599627370496.0; double y;\n")
    buf.write("    if ((u.i >> 63) != 0ull) { y = x - toint + toint - x; } else { y = x + toint - toint - x; }\n")
    buf.write("    if (e <= 0x3ff - 1) { if ((u.i >> 63) != 0ull) { return -1.0; } return 0.0; }\n")
    buf.write("    if (y > 0.0) { return x + y - 1.0; }\n")
    buf.write("    return x + y;\n")
    buf.write("}\n")
    buf.write("static void *tk_memset(void *dst, int c, uintptr_t n) {\n")
    buf.write("    unsigned char *d = (unsigned char *)dst; uintptr_t i = 0;\n")
    buf.write("    while (i < n) { d[i] = (unsigned char)c; i = i + 1; }\n")
    buf.write("    return dst;\n")
    buf.write("}\n")
    buf.write("static void *tk_memcpy(void *dst, const void *src, uintptr_t n) {\n")
    buf.write("    unsigned char *d = (unsigned char *)dst; const unsigned char *s = (const unsigned char *)src; uintptr_t i = 0;\n")
    buf.write("    while (i < n) { d[i] = s[i]; i = i + 1; }\n")
    buf.write("    return dst;\n")
    buf.write("}\n\n")
    cg_emit_mem_freestanding(buf)
}

fn cg_emit_mem_freestanding(buf: teko::io::FileStream) {
    buf.write("extern uint64_t teko_teko__runtime__rt_memcpy(uint64_t, uint64_t, uint64_t);\n")
    buf.write("extern uint64_t teko_teko__runtime__rt_memset(uint64_t, uint64_t, uint64_t);\n")
    buf.write("extern uint64_t teko_teko__runtime__rt_memmove(uint64_t, uint64_t, uint64_t);\n")
    buf.write("extern int64_t teko_teko__runtime__rt_memcmp(uint64_t, uint64_t, uint64_t);\n")
    buf.write("void *memcpy(void *dst, const void *src, uintptr_t n) { return (void *)(uintptr_t)teko_teko__runtime__rt_memcpy((uint64_t)(uintptr_t)dst, (uint64_t)(uintptr_t)src, (uint64_t)n); }\n")
    buf.write("void *memset(void *dst, int c, uintptr_t n) { return (void *)(uintptr_t)teko_teko__runtime__rt_memset((uint64_t)(uintptr_t)dst, (uint64_t)(unsigned int)c, (uint64_t)n); }\n")
    buf.write("void *memmove(void *dst, const void *src, uintptr_t n) { return (void *)(uintptr_t)teko_teko__runtime__rt_memmove((uint64_t)(uintptr_t)dst, (uint64_t)(uintptr_t)src, (uint64_t)n); }\n")
    buf.write("int memcmp(const void *a, const void *b, uintptr_t n) { return (int)teko_teko__runtime__rt_memcmp((uint64_t)(uintptr_t)a, (uint64_t)(uintptr_t)b, (uint64_t)n); }\n\n")
}

fn tk_emit_c_body(prog0: checker::TProgram, mode: CgMode, buf: teko::io::FileStream): error | null {
    cg_report_phase_rss("emit-start")
    var prog_ag = match checker::inline_aggregate_consts(prog0) { checker::TProgram as p => p; error as e => panic(e.message) }
    var _lr = cg_lift_lambdas(cg_prog_of(prog_ag))
    var prog = cg_prog_maybe_force_capture(cg_prog_of(_lr.prog), mode)
    var cap_lams = _lr.lams
    var spawn_sites = _lr.spawns
    cg_report_phase_rss("after-lift")
    buf.write("// generated by teko (F2 backend) — do not edit\n")
    cg_emit_fixed_width_typedefs(buf)
    buf.write("#include <stdlib.h>\n")
    buf.write("#include \"teko_rt.h\"\n")
    buf.write("#include \"assert.h\"\n\n")

    buf.write("#pragma GCC diagnostic ignored \"-Wincompatible-pointer-types\"\n")
    buf.write("#pragma GCC diagnostic ignored \"-Wint-conversion\"\n")
    buf.write("#pragma GCC diagnostic ignored \"-Wimplicit-function-declaration\"\n")
    buf.write("#pragma GCC diagnostic ignored \"-Wimplicit-int\"\n\n")

    cg_emit_libc_free_intrinsics(buf)
    cg_emit_global_target_guard(buf)
    var sc_used = cg_scan_syscall_arities(prog)
    cg_emit_syscall_helpers(buf, sc_used)
    cg_emit_cond_const_ladder(buf, prog)
    cg_emit_arena_provider_ladder(buf)
    cg_emit_thread_clone_helper(buf, sc_used.clone)
    cg_emit_atomic_helpers(buf, sc_used.atomics)

    var fw = 0
    loop {
        if fw >= prog.items.len { break }
        match prog.items[fw] {
            parser::TypeDecl as d => cg_emit_forward_typedef(buf, d)
            _ => { }
        }
        fw++
    }
    buf.write("\n")
    var _types_scope = cg_scope_begin()
    cg_emit_types_ordered(buf, prog)
    cg_scope_end(_types_scope)

    var pi = 0
    loop {
        if pi >= prog.items.len { break }
        match prog.items[pi] {
            checker::TFunction as f => cg_emit_fn_proto_scoped(buf, prog, f)
            _ => { }
        }
        pi++
    }
    buf.write("\n")
    var _helpers_scope = cg_scope_begin()
    cg_emit_deep_copy_helpers(buf, prog)
    cg_emit_vtables_and_thunks(buf, prog)
    cg_scope_end(_helpers_scope)
    buf.write("\n")
    var _lam_scope = cg_scope_begin()
    cg_emit_lambda_decls(buf, prog, cap_lams, true)
    buf.write("\n")
    emit_spawn_thunks(buf, prog, spawn_sites)
    cg_scope_end(_lam_scope)
    buf.write("\n")
    cg_report_phase_rss("after-decls")

    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => cg_emit_fn_def_scoped(buf, prog, f, mode)
            parser::TypeDecl => { }
            parser::UseDecl => { }
            (@TStatement()) as _gb3 => { }
            checker::TConstDecl => { }
        }
        i++
    }
    cg_emit_lambda_decls(buf, prog, cap_lams, false)

    emit_mode_main(buf, prog, mode)
    cg_report_phase_rss("after-bodies")
    null
}

fn cg_emit_forward_typedef(buf: teko::io::FileStream, d: parser::TypeDecl) {
    match d.body {
        parser::StructBody => cg_emit_forward_struct_typedef(buf, d.name)
        parser::VariantBody => cg_emit_forward_struct_typedef(buf, d.name)
        parser::ClassBody as fcb => {
            cg_emit_forward_struct_typedef(buf, d.name)
            match fcb.kind {
                parser::ClassKind::Sealed => { }
                _ => {
                    buf.write("typedef struct { void *data; void *const *vtable; } tk_base_")
                    cb_tysym(buf, d.name)
                    buf.write(";\n")
                }
            }
        }
        parser::InterfaceBody => {
            buf.write("typedef struct { void *data; void *const *vtable; } ")
            mangle_type_name(buf, "", d.name)
            buf.write(";\n")
        }
        parser::ExternStructBody as esb => if esb.c_tag.len == 0 { cg_emit_forward_struct_typedef(buf, d.name) }
        _ => { }
    }
}

fn cg_emit_forward_struct_typedef(buf: teko::io::FileStream, name: str) {
    buf.write("typedef struct ")
    mangle_type_name(buf, "", name)
    buf.write(" ")
    mangle_type_name(buf, "", name)
    buf.write(";\n")
}

fn emit_mode_main(buf: teko::io::FileStream, prog: CgProg, mode: CgMode) {
    match mode {
        CgMode::Program => emit_program_main(buf, prog)
        CgMode::ProgramCov => emit_program_main_cov(buf, prog)
        _ => emit_test_main(buf, prog, mode)
    }
}

fn emit_program_main(buf: teko::io::FileStream, prog: CgProg) {
    emit_program_main_body(buf, prog, false)
}

fn emit_program_main_cov(buf: teko::io::FileStream, prog: CgProg) {
    emit_program_main_body(buf, prog, true)
}

fn emit_program_main_body(buf: teko::io::FileStream, prog: CgProg, cov: bool) {
    var last_stmt = prog.items.len
    var li: u64 = 0
    loop {
        if li >= prog.items.len { break }
        match prog.items[li] {
            (@TStatement()) as _gb4 => { last_stmt = li }
            _ => { }
        }
        li++
    }
    if cov {
        buf.write("static void __tk_cov_atexit_dump(void) { ")
        cb_fn_name(buf, "teko::runtime", "cov_dump_env")
        buf.write("(); }\n")
    }
    buf.write("int main(int argc, char **argv) {\n")
    buf.write("    tk_set_args(argc, argv);\n")
    if cov {
        cb_cov_call0(buf, "cov_begin")
        buf.write("    atexit(__tk_cov_atexit_dump);\n")
    }
    var j = 0
    loop {
        if j >= prog.items.len { break }
        match prog.items[j] {
            checker::TFunction => { }
            parser::TypeDecl => { }
            parser::UseDecl => { }
            checker::TConstDecl => { }
            (@TStatement()) as s => {
                if j == last_stmt {
                    var tail = [s]
                    emit_block_tail(buf, tail, true, prog, checker::Void { }, "    ", "", [], [], [], dctx_empty())
                } else {
                    emit_stmt(buf, s, true, prog, checker::Void { }, "    ", "", [], [], [], dctx_empty(), [], false)
                }
            }
        }
        j++
    }
    buf.write("    return 0;\n")
    buf.write("}\n")
}

fn emit_test_main(buf: teko::io::FileStream, prog: CgProg, mode: CgMode) {
    if mode == CgMode::TestAnalyze { emit_test_main_analyze(buf, prog); return }
    var cov = mode == CgMode::TestCov
    buf.write("int main(int argc, char **argv) {\n")
    buf.write("    tk_set_args(argc, argv);\n")
    if cov { cb_cov_call0(buf, "cov_begin") }
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.is_test { emit_test_call(buf, f, i, cov) }
            }
            _ => { }
        }
        i++
    }
    if cov {
        cb_cov_call0(buf, "cov_stop")
        cb_cov_call0(buf, "cov_dump_env")
    }
    emit_test_main_close(buf)
    buf.write("}\n")
}

fn emit_test_main_analyze(buf: teko::io::FileStream, prog: CgProg) {
    buf.write("int main(int argc, char **argv) {\n")
    buf.write("    tk_set_args(argc, argv);\n")
    cb_cov_call0(buf, "cov_begin")
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.is_test { emit_test_call_analyze(buf, f, i) }
            }
            _ => { }
        }
        i++
    }
    emit_test_main_close(buf)
    buf.write("}\n")
}

fn emit_test_main_close(buf: teko::io::FileStream) {
    buf.write("    ")
    cb_fn_name(buf, "teko::runtime", "test_summary")
    buf.write("();\n    ")
    cb_fn_name(buf, "teko::journal", "note_test_end")
    buf.write("();\n")
    buf.write("    return ")
    cb_fn_name(buf, "teko::runtime", "test_any_failed")
    buf.write("() ? 1 : 0;\n")
}

fn cb_journal_tkstr_lit(buf: teko::io::FileStream, label: str) {
    buf.write("(tk_str){ (const tk_byte *)\"")
    cb_cstr_escaped(buf, label)
    buf.write("\", ")
    cb_u64_digits(buf, label.len)
}

fn cb_journal_call1(buf: teko::io::FileStream, name: str, label: str) {
    cb_fn_name(buf, "teko::journal", name)
    buf.write("(")
    cb_journal_tkstr_lit(buf, label)
    buf.write(" });\n")
}

fn cb_journal_call_exited(buf: teko::io::FileStream, label: str, code_expr: str) {
    cb_fn_name(buf, "teko::journal", "note_test_exited")
    buf.write("(")
    cb_journal_tkstr_lit(buf, label)
    buf.write(" }, "); buf.write(code_expr); buf.write(");\n")
}

fn emit_test_call(buf: teko::io::FileStream, f: checker::TFunction, idx: u64, cov: bool) {
    buf.write("    if (")
    cb_fn_name(buf, "teko::test", "shard_take")
    buf.write("()) {\n")
    buf.write("    "); cb_arena_sym(buf, CgArenaSym::ArenaPush); buf.write("();\n")
    emit_test_channel_open(buf, f)
    if cov { cb_cov_call_idx(buf, "cov_enter", idx) }
    emit_test_captured_call(buf, f)
    if cov { cb_cov_call0(buf, "cov_leave") }
    buf.write("    "); cb_arena_sym(buf, CgArenaSym::ArenaPop); buf.write("();\n")
    buf.write("    }\n")
}

fn emit_test_captured_call(buf: teko::io::FileStream, f: checker::TFunction) {
    var label = test_label_of(f)
    var how = $"_thow{buf.gensym()}"
    var code = $"_tcode{buf.gensym()}"
    buf.write("    ")
    cb_fn_name(buf, "teko::runtime", "capture_arm")
    buf.write("();\n    ")
    cb_fn_name(buf, f.namespace, f.name, f.overload_suffix)
    buf.write("();\n")
    buf.write($"    {{ int32_t {how} = ")
    cb_fn_name(buf, "teko::runtime", "test_collect")
    buf.write("();\n")
    buf.write($"    int32_t {code} = ")
    cb_fn_name(buf, "teko::runtime", "test_collect_code")
    buf.write("();\n")
    buf.write($"    if ({how} == 0) {{ ")
    cb_journal_call1(buf, "note_test_ok", label)
    buf.write($"    }} else if ({how} == 2) {{ ")
    cb_journal_call_exited(buf, label, code)
    buf.write("    } else { ")
    cb_journal_call1(buf, "note_test_panicked", label)
    buf.write("    }\n    ")
    cb_fn_name(buf, "teko::runtime", "test_report")
    buf.write($"({how}, {code});\n    }}\n")
}

fn emit_test_channel_open(buf: teko::io::FileStream, f: checker::TFunction) {
    var label = test_label_of(f)
    buf.write("    ")
    cb_fn_name(buf, "teko::runtime", "test_begin")
    buf.write("((tk_str){ (const tk_byte *)\"")
    cb_cstr_escaped(buf, label)
    buf.write("\", ")
    cb_u64_digits(buf, label.len)
    buf.write(" });\n")
    cb_journal_call1(buf, "note_test_begin", label)
}

fn test_label_of(f: checker::TFunction): str {
    if f.namespace.len != 0 { teko::str::concat(f.namespace, "::", f.name) } else { f.name }
}

fn emit_test_call_analyze(buf: teko::io::FileStream, f: checker::TFunction, idx: u64) {
    buf.write("    "); cb_arena_sym(buf, CgArenaSym::ArenaPush); buf.write("();\n")
    emit_test_channel_open(buf, f)
    cb_cov_call0(buf, "cov_reset_all")
    cb_cov_call_idx(buf, "cov_enter", idx)
    emit_test_captured_call(buf, f)
    cb_cov_call0(buf, "cov_leave")
    cb_cov_call_idx(buf, "cov_dump_analyze", idx)
    buf.write("    "); cb_arena_sym(buf, CgArenaSym::ArenaPop); buf.write("();\n")
}

fn mode_instruments_cov(mode: CgMode): bool {
    match mode {
        CgMode::TestCov => true
        CgMode::TestAnalyze => true
        CgMode::ProgramCov => true
        _ => false
    }
}

fn emit_function_mode(buf: teko::io::FileStream, prog: CgProg, f: checker::TFunction, mode: CgMode) {
    if !mode_instruments_cov(mode) { emit_function(buf, prog, f); return }
    if f.is_test || f.namespace == "teko::coverage" { emit_function(buf, prog, f); return }
    emit_function_cov(buf, prog, f, fn_items_index(prog, f) to i64)
}

fn fn_items_index(prog: CgProg, f: checker::TFunction): u64 {
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as g => {
                if g.namespace == f.namespace && g.name == f.name && g.line == f.line { return i }
            }
            _ => { }
        }
        i++
    }
    0
}

fn tk_emit_tsym(prog: checker::TProgram): str {
    "# teko symbol map (.tsym v1): disabled (debug-only, native backend)\n"
}
