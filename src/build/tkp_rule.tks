
type Artifact = enum { Binary; Static; Shared; Package; Tool; }

fn check_main_file_rule(artifact: Artifact, has_main: bool): Artifact | error {
    if (artifact == Artifact::Binary || artifact == Artifact::Tool) && !has_main {
        return error { message = "a binary/tool project requires a main.tks" }
    }
    if artifact != Artifact::Binary && artifact != Artifact::Tool && has_main {
        return error { message = "a library project (static/shared/package) may not have a main.tks" }
    }
    artifact
}
