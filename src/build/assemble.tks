
use teko::parser
use teko::lexer

fn asm_is_main(path: str): bool {
    if !path.ends_with("main.tks") { return false }
    if path.len == 8 { return true }
    path[path.len - 9] == b'/'
}

fn asm_main_items(mf: parser::MainFile): []parser::Item {
    var items: [mf.uses.len + mf.body.len]parser::Item = []
    var ui: u64 = 0
    loop {
        if ui >= mf.uses.len { break }
        items[ui] = parser::Item { content = mf.uses[ui]; namespace = ""; file = ""; guard = parser::pred_true() }
        ui = ui + 1
    }
    var si: u64 = 0
    loop {
        if si >= mf.body.len { break }
        items[mf.uses.len + si] = parser::Item { content = mf.body[si]; namespace = ""; file = ""; guard = parser::pred_true() }
        si = si + 1
    }
    items
}

pub type AsmUnit = struct {
    items: []parser::Item
    embeds: []parser::EmbedDecl
}

fn count_embed_decls(m: parser::Module): u64 {
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i >= m.decls.len { break }
        match m.decls[i] { parser::EmbedDecl => n = n + 1; _ => { } }
        i = i + 1
    }
    n
}

fn asm_module_items(m: parser::Module): AsmUnit {
    var nembed = count_embed_decls(m)
    var items: [m.uses.len + (m.decls.len - nembed)]parser::Item = []
    var embeds: [nembed]parser::EmbedDecl = []
    var ui: u64 = 0
    loop {
        if ui >= m.uses.len { break }
        items[ui] = parser::Item { content = m.uses[ui]; namespace = ""; file = ""; guard = parser::pred_true() }
        ui = ui + 1
    }
    var di: u64 = 0
    var oi: u64 = m.uses.len
    var ei: u64 = 0
    loop {
        if di >= m.decls.len { break }
        var g = asm_decl_guard(m, di)
        match m.decls[di] {
            parser::Function as f => { items[oi] = parser::Item { content = f; namespace = ""; file = ""; guard = g }; oi = oi + 1 }
            parser::TypeDecl as t => { items[oi] = parser::Item { content = t; namespace = ""; file = ""; guard = g }; oi = oi + 1 }
            parser::ConstDecl as c => { items[oi] = parser::Item { content = c; namespace = ""; file = ""; guard = g }; oi = oi + 1 }
            parser::MacroDecl as md => { items[oi] = parser::Item { content = md; namespace = ""; file = ""; guard = g }; oi = oi + 1 }
            parser::ComptimeDecl as cd => { items[oi] = parser::Item { content = cd; namespace = ""; file = ""; guard = g }; oi = oi + 1 }
            parser::EmbedDecl as ed => { embeds[ei] = ed; ei = ei + 1 }
        }
        di = di + 1
    }
    AsmUnit { items = items; embeds = embeds }
}

fn asm_decl_guard(m: parser::Module, di: u64): parser::Pred {
    if di < m.decl_guards.len { return m.decl_guards[di] }
    parser::pred_true()
}

fn asm_parse(path: str, tokens: []lexer::Token): AsmUnit | error {
    if asm_is_main(path) {
        var mf = match parser::parse_main_file(tokens, 0) { parser::Parsed<parser::MainFile> as x => x.node; error as e => return e }
        AsmUnit { items = asm_main_items(mf); embeds = [] }
    } else {
        var m = match parser::parse_module(tokens, 0) { parser::Parsed<parser::Module> as x => x.node; error as e => return e }
        asm_module_items(m)
    }
}

fn asm_lex_and_parse(path: str, src: str): AsmUnit | error {
    var tokens = match lexer::tokenize_file(src, path) { []lexer::Token as t => t; error as e => return e }
    match asm_parse(path, tokens) { AsmUnit as u => u; error as e => return e }
}

fn eligible_file_count(files: []SourceFile, include_tests: bool): u64 {
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i >= files.len { break }
        if include_tests || !files[i].path.ends_with(".tkt") { n = n + 1 }
        i = i + 1
    }
    n
}

fn assemble(files: []SourceFile): parser::Program | error {
    var a = match assemble_sel(files, false, false, false) { Assembled as x => x; error as e => return e }
    if a.diags.len > 0 { return error { message = join_diags(a.diags) } }
    a.program
}

pub type Assembled = struct {
    program: parser::Program
    diags: []str
    embeds: []parser::EmbedDecl
}

pub fn join_diags(diags: []str): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= diags.len { break }
        if i > 0 { out = out ~ "\n" }
        out = out ~ diags[i]
        i = i + 1
    }
    out
}

type AsmFileItems = struct {
    items: []parser::Item
    embeds: []parser::EmbedDecl
    namespace: str
    path: str
}

fn assemble_sel(files: []SourceFile, include_tests: bool, report: bool, tty: bool): Assembled | error {
    var diags: []str = []
    var total = eligible_file_count(files, include_tests)
    var mode = report_mode(!report, tty)
    var lex_phase = phase_begin("lexer", count_unit_text(0, total, "files"), mode)
    var parse_phase = phase_begin("parser", count_unit_text(0, total, "files"), mode)
    var lexed: u64 = 0
    var parsed: u64 = 0
    var per_file: [files.len]AsmFileItems = []
    var nfiles: u64 = 0
    var total_items: u64 = 0
    var total_embeds: u64 = 0
    var i: u64 = 0
    loop {
        if i >= files.len { break }
        var sf = files[i]
        if sf.path.ends_with(".tkt") && !include_tests {
            i = i + 1
            continue
        }
        var src = match source_text_of(sf) { str as s => s; error as e => return e }
        var one: []parser::Item = []
        var one_embeds: []parser::EmbedDecl = []
        var ok = true
        match asm_lex_and_parse(sf.path, src) {
            AsmUnit as u => { one = u.items; one_embeds = u.embeds }
            error as e => {
                diags = [..diags, teko::str::concat(sf.path, ":", e.message)]
                ok = false
            }
        }
        if !ok {
            i = i + 1
            continue
        }
        lexed = lexed + 1
        parsed = parsed + 1
        phase_tick(lex_phase, count_unit_text(lexed, total, "files"))
        phase_tick(parse_phase, count_unit_text(parsed, total, "files"))
        per_file[nfiles] = AsmFileItems { items = one; embeds = one_embeds; namespace = sf.namespace; path = sf.path }
        nfiles++
        total_items = total_items + one.len
        total_embeds = total_embeds + one_embeds.len
        i = i + 1
    }
    var merged: [total_items]parser::Item = []
    var embeds: [total_embeds]parser::EmbedDecl = []
    var mi: u64 = 0
    var embi: u64 = 0
    var fi: u64 = 0
    loop {
        if fi >= nfiles { break }
        var pf = per_file[fi]
        var k: u64 = 0
        loop {
            if k >= pf.items.len { break }
            merged[mi] = parser::Item { content = pf.items[k].content; namespace = pf.namespace; file = pf.path; guard = pf.items[k].guard }
            mi++
            k++
        }
        var e: u64 = 0
        loop {
            if e >= pf.embeds.len { break }
            embeds[embi] = pf.embeds[e]
            embi++
            e++
        }
        fi++
    }
    if diags.len > 0 {
        phase_end_fail(lex_phase, count_unit_text(lexed, total, "files"), diags[0])
        phase_end_fail(parse_phase, count_unit_text(parsed, total, "files"), diags[0])
        return Assembled { program = parser::Program { items = merged }; diags = diags; embeds = embeds }
    }
    phase_end_ok(lex_phase, count_unit_text(lexed, total, "files"))
    phase_end_ok(parse_phase, count_unit_text(parsed, total, "files"))
    Assembled { program = parser::Program { items = merged }; diags = diags; embeds = embeds }
}

pub type FileOverride = struct {
    path: str
    content: str
}

fn overridden_content(overrides: []FileOverride, path: str): str | null {
    var i: u64 = 0
    loop {
        if i >= overrides.len { break }
        if overrides[i].path == path { return overrides[i].content }
        i = i + 1
    }
    null
}

fn source_text_of(sf: SourceFile): str | error {
    if sf.content.len > 0 { return sf.content }
    match teko::io::read_file(sf.path) { str as s => s; error as e => return e }
}

fn read_source_with_overrides(sf: SourceFile, overrides: []FileOverride): str | error {
    match overridden_content(overrides, sf.path) {
        str as c => return c
        null => { }
    }
    source_text_of(sf)
}

fn append_tagged_items(merged: []parser::Item, items: []parser::Item, sf: SourceFile): []parser::Item {
    var out = merged
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        out = [..out, parser::Item { content = items[i].content; namespace = sf.namespace; file = sf.path; guard = items[i].guard }]
        i = i + 1
    }
    out
}

pub fn assemble_with_overrides(files: []SourceFile, overrides: []FileOverride): Assembled | error {
    var merged: []parser::Item = []
    var diags: []str = []
    var i: u64 = 0
    loop {
        if i >= files.len { break }
        var sf = files[i]
        if sf.path.ends_with(".tkt") {
            i = i + 1
            continue
        }
        var src = match read_source_with_overrides(sf, overrides) { str as s => s; error as e => return e }
        match asm_lex_and_parse(sf.path, src) {
            AsmUnit as u => { merged = append_tagged_items(merged, u.items, sf) }
            error as e => { diags = [..diags, teko::str::concat(sf.path, ":", e.message)] }
        }
        i = i + 1
    }
    Assembled { program = parser::Program { items = merged }; diags = diags; embeds = [] }
}
