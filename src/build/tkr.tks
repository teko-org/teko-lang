use teko::casting

pub type TkrKind = enum { Exit; Print; Trap; CompileFail; EmitOnly }

pub type TkrMatchMode = enum { Ignore; Literal; Sha256; Pattern }

pub type TkrMatch = struct {
    mode: TkrMatchMode
    text: str
}

pub type TkrExpect = struct {
    osarch: str
    has_exit: bool
    exit: i32
    stdout: TkrMatch
    stderr: TkrMatch
}

pub type TkrGolden = struct {
    osarch: str
    sha256: str
}

pub type Tkr = struct {
    args: []str
    stdin: str
    kind: TkrKind
    exit: i32
    stdout: TkrMatch
    stderr: TkrMatch
    targets: []str
    expect: []TkrExpect
    golden: []TkrGolden
    diagnostic: str
    source_inline: str
    source_file: str
    env: []str
    target: str
    in_place: bool
    dep_dir: str
    check_wellformed: bool
}

fn tkr_match_ignore(): TkrMatch { TkrMatch { mode = TkrMatchMode::Ignore; text = "" } }

fn tkr_read_i32(s: str, p: u64): i32 | error {
    match casting::u64_to_i32(mf_read_int(s, p)) {
        i32 as v => v
        error => error { message = teko::str::concat("tkr: expected exit code is not a process status (out of i32 range): ", s) }
    }
}

fn tkr_expect_for(t: Tkr, osarch: str): TkrExpect | null {
    var k: u64 = 0
    loop {
        if k >= t.expect.len { break }
        if t.expect[k].osarch == osarch { return t.expect[k] }
        k = k + 1
    }
    null
}

pub type TkrPhase = enum { Given; When; Then }

pub type TkrStep = struct {
    phase: TkrPhase
    noun: str
    verb: str
    osarch: str
    value: str
}

pub type TkrRow = struct {
    cells: []str
}

pub type TkrExamples = struct {
    headers: []str
    rows: []TkrRow
}

pub type TkrScenario = struct {
    name: str
    outline: bool
    steps: []TkrStep
    examples: TkrExamples
}

pub type TkrFeature = struct {
    name: str
    scenarios: []TkrScenario
}

fn tkr_is_ws(c: byte): bool { c == b' ' || c == b'\t' || c == b'\r' || c == b'\n' }

fn tkr_trim(s: str): str {
    var a: u64 = 0
    loop {
        if a >= s.len { break }
        if !tkr_is_ws(s[a]) { break }
        a = a + 1
    }
    var b = s.len
    loop {
        if b <= a { break }
        if !tkr_is_ws(s[b - 1]) { break }
        b = b - 1
    }
    s.slice(a, b)
}

fn tkr_find_byte(s: str, c: byte, from: u64): u64 {
    var k = from
    loop {
        if k >= s.len { break }
        if s[k] == c { return k }
        k = k + 1
    }
    s.len
}

fn tkr_after(line: str, prefix: str): str { tkr_trim(line.slice_from(prefix.len)) }

fn tkr_table_cells(line: str): []str {
    var t = tkr_trim(line)
    var out: []str = []
    if t.len == 0 || t[0] != b'|' { return out }
    var k: u64 = 1
    loop {
        if k >= t.len { break }
        var nb = tkr_find_byte(t, b'|', k)
        if nb >= t.len { break }
        out = [..out, tkr_trim(t.slice(k, nb))]
        k = nb + 1
    }
    out
}

fn tkr_phase_of_keyword(kw: str, prev: TkrPhase): TkrPhase {
    if kw == "Given" { return TkrPhase::Given }
    if kw == "When" { return TkrPhase::When }
    if kw == "Then" { return TkrPhase::Then }
    prev
}

type TkrStepKw = struct {
    kw: str
    body: str
}

fn tkr_step_keyword(line: str): TkrStepKw {
    if mf_starts_with(line, "Given ") { return TkrStepKw { kw = "Given"; body = tkr_after(line, "Given ") } }
    if mf_starts_with(line, "When ") { return TkrStepKw { kw = "When"; body = tkr_after(line, "When ") } }
    if mf_starts_with(line, "Then ") { return TkrStepKw { kw = "Then"; body = tkr_after(line, "Then ") } }
    if mf_starts_with(line, "And ") { return TkrStepKw { kw = "And"; body = tkr_after(line, "And ") } }
    if mf_starts_with(line, "But ") { return TkrStepKw { kw = "But"; body = tkr_after(line, "But ") } }
    TkrStepKw { kw = ""; body = "" }
}

fn tkr_parse_step(phase: TkrPhase, body: str): TkrStep | error {
    var eq = tkr_find_byte(body, b'=', 0)
    if eq >= body.len {
        return TkrStep { phase = phase; noun = ""; verb = body; osarch = ""; value = "" }
    }
    var value = tkr_trim(body.slice_from(eq + 1))
    var lhs = tkr_trim(body.slice_to(eq))
    var osarch = ""
    if mf_starts_with(lhs, "on ") {
        var rest = tkr_trim(lhs.slice_from(3))
        var q = match mf_read_quoted(rest, 0) { MfQuoted as x => x; error as e => return e }
        osarch = q.text
        lhs = tkr_trim(rest.slice_from(q.next))
    }
    TkrStep { phase = phase; noun = lhs; verb = ""; osarch = osarch; value = value }
}

type TkrParse = struct {
    features: []TkrFeature
    feat_active: bool
    name: str
    scenarios: []TkrScenario
    bg: []TkrStep
    in_bg: bool
    have_cur: bool
    cur_name: str
    cur_outline: bool
    cur_steps: []TkrStep
    ex_headers: []str
    ex_have_headers: bool
    ex_rows: []TkrRow
    in_examples: bool
    phase: TkrPhase
}

fn tkr_parse_new(): TkrParse {
    TkrParse {
        features = []; feat_active = false; name = ""; scenarios = []
        bg = []; in_bg = false
        have_cur = false; cur_name = ""; cur_outline = false; cur_steps = []
        ex_headers = []; ex_have_headers = false; ex_rows = []
        in_examples = false; phase = TkrPhase::Given
    }
}

fn tkr_prepend_bg(bg: []TkrStep, steps: []TkrStep): []TkrStep {
    var out: []TkrStep = []
    var k: u64 = 0
    loop {
        if k >= bg.len { break }
        out = [..out, bg[k]]
        k = k + 1
    }
    var j: u64 = 0
    loop {
        if j >= steps.len { break }
        out = [..out, steps[j]]
        j = j + 1
    }
    out
}

fn tkr_flush_cur(p: TkrParse): TkrParse {
    if !p.have_cur { return p }
    var sc = TkrScenario {
        name = p.cur_name; outline = p.cur_outline
        steps = tkr_prepend_bg(p.bg, p.cur_steps)
        examples = TkrExamples { headers = p.ex_headers; rows = p.ex_rows }
    }
    TkrParse {
        features = p.features; feat_active = p.feat_active; name = p.name; scenarios = [..p.scenarios, sc]
        bg = p.bg; in_bg = false
        have_cur = false; cur_name = ""; cur_outline = false; cur_steps = []
        ex_headers = []; ex_have_headers = false; ex_rows = []
        in_examples = false; phase = p.phase
    }
}

fn tkr_flush_feature(p: TkrParse): TkrParse {
    var f = tkr_flush_cur(p)
    if !f.feat_active { return f }
    var feat = TkrFeature { name = f.name; scenarios = f.scenarios }
    TkrParse {
        features = [..f.features, feat]; feat_active = false; name = ""; scenarios = []
        bg = []; in_bg = false
        have_cur = false; cur_name = ""; cur_outline = false; cur_steps = []
        ex_headers = []; ex_have_headers = false; ex_rows = []
        in_examples = false; phase = TkrPhase::Given
    }
}

fn tkr_open_scenario(p: TkrParse, name: str, outline: bool): TkrParse {
    var f = tkr_flush_cur(p)
    TkrParse {
        features = f.features; feat_active = true; name = f.name; scenarios = f.scenarios
        bg = f.bg; in_bg = false
        have_cur = true; cur_name = name; cur_outline = outline; cur_steps = []
        ex_headers = []; ex_have_headers = false; ex_rows = []
        in_examples = false; phase = TkrPhase::Given
    }
}

fn tkr_add_step(p: TkrParse, step: TkrStep): TkrParse | error {
    if p.in_bg {
        return TkrParse {
            features = p.features; feat_active = p.feat_active; name = p.name; scenarios = p.scenarios
            bg = [..p.bg, step]; in_bg = true
            have_cur = p.have_cur; cur_name = p.cur_name; cur_outline = p.cur_outline; cur_steps = p.cur_steps
            ex_headers = p.ex_headers; ex_have_headers = p.ex_have_headers; ex_rows = p.ex_rows
            in_examples = false; phase = step.phase
        }
    }
    if !p.have_cur { return error { message = "tkr: a step appears before any Scenario/Background" } }
    TkrParse {
        features = p.features; feat_active = p.feat_active; name = p.name; scenarios = p.scenarios
        bg = p.bg; in_bg = false
        have_cur = true; cur_name = p.cur_name; cur_outline = p.cur_outline; cur_steps = [..p.cur_steps, step]
        ex_headers = p.ex_headers; ex_have_headers = p.ex_have_headers; ex_rows = p.ex_rows
        in_examples = false; phase = step.phase
    }
}

fn tkr_add_table_row(p: TkrParse, cells: []str): TkrParse | error {
    if !p.in_examples { return error { message = "tkr: a table row appears outside an Examples block" } }
    if !p.ex_have_headers {
        return TkrParse {
            features = p.features; feat_active = p.feat_active; name = p.name; scenarios = p.scenarios; bg = p.bg; in_bg = false
            have_cur = p.have_cur; cur_name = p.cur_name; cur_outline = p.cur_outline; cur_steps = p.cur_steps
            ex_headers = cells; ex_have_headers = true; ex_rows = p.ex_rows; in_examples = true; phase = p.phase
        }
    }
    TkrParse {
        features = p.features; feat_active = p.feat_active; name = p.name; scenarios = p.scenarios; bg = p.bg; in_bg = false
        have_cur = p.have_cur; cur_name = p.cur_name; cur_outline = p.cur_outline; cur_steps = p.cur_steps
        ex_headers = p.ex_headers; ex_have_headers = true; ex_rows = [..p.ex_rows, TkrRow { cells = cells }]
        in_examples = true; phase = p.phase
    }
}

fn tkr_open_examples(p: TkrParse): TkrParse {
    TkrParse {
        features = p.features; feat_active = p.feat_active; name = p.name; scenarios = p.scenarios; bg = p.bg; in_bg = false
        have_cur = p.have_cur; cur_name = p.cur_name; cur_outline = p.cur_outline; cur_steps = p.cur_steps
        ex_headers = p.ex_headers; ex_have_headers = p.ex_have_headers; ex_rows = p.ex_rows
        in_examples = true; phase = p.phase
    }
}

fn tkr_open_feature(p: TkrParse, nm: str): TkrParse {
    var f = tkr_flush_feature(p)
    TkrParse {
        features = f.features; feat_active = true; name = nm; scenarios = []
        bg = []; in_bg = false
        have_cur = false; cur_name = ""; cur_outline = false; cur_steps = []
        ex_headers = []; ex_have_headers = false; ex_rows = []
        in_examples = false; phase = TkrPhase::Given
    }
}

fn tkr_open_background(p: TkrParse): TkrParse {
    var f = tkr_flush_cur(p)
    TkrParse {
        features = f.features; feat_active = true; name = f.name; scenarios = f.scenarios
        bg = []; in_bg = true
        have_cur = false; cur_name = ""; cur_outline = false; cur_steps = []
        ex_headers = []; ex_have_headers = false; ex_rows = []
        in_examples = false; phase = TkrPhase::Given
    }
}

fn tkr_apply_line(p: TkrParse, line: str): TkrParse | error {
    if mf_starts_with(line, "Feature:") { return tkr_open_feature(p, tkr_after(line, "Feature:")) }
    if mf_starts_with(line, "Background:") { return tkr_open_background(p) }
    if mf_starts_with(line, "Scenario Outline:") { return tkr_open_scenario(p, tkr_after(line, "Scenario Outline:"), true) }
    if mf_starts_with(line, "Scenario:") { return tkr_open_scenario(p, tkr_after(line, "Scenario:"), false) }
    if mf_starts_with(line, "Examples:") { return tkr_open_examples(p) }
    if line[0] == b'|' { return tkr_add_table_row(p, tkr_table_cells(line)) }
    var kw = tkr_step_keyword(line)
    if kw.kw.len == 0 { return error { message = teko::str::concat("tkr: unrecognised line: ", line) } }
    var phase = tkr_phase_of_keyword(kw.kw, p.phase)
    var step = match tkr_parse_step(phase, kw.body) { TkrStep as s => s; error as e => return e }
    tkr_add_step(p, step)
}

fn tkr_count_triple_quotes(line: str): u64 {
    var n: u64 = 0
    var k: u64 = 0
    loop {
        if k + 3 > line.len { break }
        if mf_at(line, k) == b'"' && mf_at(line, k + 1) == b'"' && mf_at(line, k + 2) == b'"' { n = n + 1; k = k + 3 } else { k = k + 1 }
    }
    n
}

fn tkr_needs_docstring_continuation(line: str): bool { tkr_count_triple_quotes(line) % 2 == 1 }

type TkrSlurp = struct {
    text: str
    next: u64
}

fn tkr_slurp_docstring_body(src: str, from: u64): TkrSlurp | error {
    var cur = from
    var out = ""
    var first = true
    loop {
        if cur >= src.len { return error { message = "tkr: unterminated \"\"\" docstring (missing a closing \"\"\" line)" } }
        var eol = cur
        loop {
            if eol >= src.len { break }
            if src[eol] == b'\n' { break }
            eol = eol + 1
        }
        var raw = src.slice(cur, eol)
        var next = if eol < src.len { eol + 1 } else { eol }
        if tkr_trim(raw) == "\"\"\"" { return TkrSlurp { text = out; next = next } }
        if !first { out = out ~ "\n" }
        out = out ~ raw
        first = false
        cur = next
    }
    error { message = "tkr: unreachable docstring slurp" }
}

fn tkr_strip_trailing_fence(line: str): str {
    if line.len < 3 { return line }
    line.slice_to(line.len - 3)
}

fn parse_tkr(src: str): []TkrFeature | error {
    var p = tkr_parse_new()
    var cur: u64 = 0
    loop {
        if cur >= src.len { break }
        var eol = cur
        loop {
            if eol >= src.len { break }
            if src[eol] == b'\n' { break }
            eol = eol + 1
        }
        var raw = src.slice(cur, eol)
        cur = if eol < src.len { eol + 1 } else { eol }
        var line = tkr_trim(raw)
        if line.len == 0 || line[0] == b'#' { continue }
        if tkr_needs_docstring_continuation(line) {
            var body = match tkr_slurp_docstring_body(src, cur) { TkrSlurp as s => s; error as e => return e }
            var full_line = tkr_strip_trailing_fence(line) ~ body.text
            p = match tkr_apply_line(p, full_line) { TkrParse as np => np; error as e => return e }
            cur = body.next
            continue
        }
        p = match tkr_apply_line(p, line) { TkrParse as np => np; error as e => return e }
    }
    var done = tkr_flush_feature(p)
    done.features
}

fn tkr_hex_nibble(c: byte): u64 | error {
    if c >= b'0' && c <= b'9' { return (c to u64) - (b'0' to u64) }
    if c >= b'a' && c <= b'f' { return (c to u64) - (b'a' to u64) + 10 }
    if c >= b'A' && c <= b'F' { return (c to u64) - (b'A' to u64) + 10 }
    error { message = "tkr: non-hex byte in a HEX docstring" }
}

fn tkr_read_hex_docstring(s: str, p: u64): str | error {
    if !(mf_at(s, p) == b'"' && mf_at(s, p + 1) == b'"' && mf_at(s, p + 2) == b'"') {
        return error { message = "tkr: expected a \"\"\" HEX docstring" }
    }
    var k = p + 3
    var nibbles: []u64 = []
    var closed = false
    loop {
        if k >= s.len { break }
        if mf_at(s, k) == b'"' && mf_at(s, k + 1) == b'"' && mf_at(s, k + 2) == b'"' { closed = true; k = k + 3; break }
        var c = s[k]
        if tkr_is_ws(c) { k = k + 1; continue }
        var n = match tkr_hex_nibble(c) { u64 as v => v; error as e => return e }
        nibbles = [..nibbles, n]
        k = k + 1
    }
    if !closed { return error { message = "tkr: unterminated HEX docstring (missing closing \"\"\")" } }
    if nibbles.len % 2 != 0 { return error { message = "tkr: odd hex-nibble count in a HEX docstring" } }
    var bytes: []byte = []
    var j: u64 = 0
    loop {
        if j >= nibbles.len { break }
        bytes = [..bytes, (nibbles[j] * 16 + nibbles[j + 1]) to byte]
        j = j + 2
    }
    match str_from_utf8(bytes) { str as out => out; error as e => e }
}

fn tkr_replace_all(hay: str, needle: str, rep: str): str {
    if needle.len == 0 { return hay }
    var out = ""
    var k: u64 = 0
    loop {
        if k >= hay.len { break }
        if k + needle.len <= hay.len && hay.slice(k, k + needle.len) == needle {
            out = out ~ rep
            k = k + needle.len
        } else {
            out = out ~ hay.slice(k, k + 1)
            k = k + 1
        }
    }
    out
}

fn tkr_subst_row(value: str, headers: []str, row: []str): str {
    var out = value
    var k: u64 = 0
    loop {
        if k >= headers.len { break }
        var col = if k < row.len { row[k] } else { "" }
        out = tkr_replace_all(out, teko::str::concat(teko::str::concat("<", headers[k]), ">"), col)
        k = k + 1
    }
    out
}

fn tkr_step_subst(step: TkrStep, headers: []str, row: []str): TkrStep {
    TkrStep {
        phase = step.phase; noun = step.noun; verb = step.verb; osarch = step.osarch
        value = tkr_subst_row(step.value, headers, row)
    }
}

fn tkr_kind_for_verb(verb: str): TkrKind | error {
    if verb == "compilation fails" { return TkrKind::CompileFail }
    if verb == "it traps" { return TkrKind::Trap }
    if verb == "built" { return TkrKind::EmitOnly }
    if verb == "built and run" || verb == "compiled" { return TkrKind::Print }
    error { message = teko::str::concat("tkr: unknown When entry verb: ", verb) }
}

fn tkr_get_expect(list: []TkrExpect, osarch: str): TkrExpect {
    var k: u64 = 0
    loop {
        if k >= list.len { break }
        if list[k].osarch == osarch { return list[k] }
        k = k + 1
    }
    TkrExpect { osarch = osarch; has_exit = false; exit = 0; stdout = tkr_match_ignore(); stderr = tkr_match_ignore() }
}

fn tkr_put_expect(list: []TkrExpect, e: TkrExpect): []TkrExpect {
    var out: []TkrExpect = []
    var found = false
    var k: u64 = 0
    loop {
        if k >= list.len { break }
        if list[k].osarch == e.osarch { out = [..out, e]; found = true } else { out = [..out, list[k]] }
        k = k + 1
    }
    if !found { out = [..out, e] }
    out
}

fn tkr_put_golden(list: []TkrGolden, osarch: str, sha: str): []TkrGolden {
    var out: []TkrGolden = []
    var found = false
    var k: u64 = 0
    loop {
        if k >= list.len { break }
        if list[k].osarch == osarch { out = [..out, TkrGolden { osarch = osarch; sha256 = sha }]; found = true } else { out = [..out, list[k]] }
        k = k + 1
    }
    if !found { out = [..out, TkrGolden { osarch = osarch; sha256 = sha }] }
    out
}

fn tkr_noun_stream_match(noun: str, value: str): TkrMatch | error {
    if noun.ends_with("bytes") {
        var b = match tkr_read_hex_docstring(value, 0) { str as x => x; error as e => return e }
        return TkrMatch { mode = TkrMatchMode::Literal; text = b }
    }
    var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
    if noun.ends_with("sha256") { return TkrMatch { mode = TkrMatchMode::Sha256; text = q.text } }
    if noun.ends_with("pattern") { return TkrMatch { mode = TkrMatchMode::Pattern; text = q.text } }
    TkrMatch { mode = TkrMatchMode::Literal; text = q.text }
}

type TkrLower = struct {
    args: []str
    stdin: str
    kind: TkrKind
    exit: i32
    stdout: TkrMatch
    stderr: TkrMatch
    targets: []str
    diagnostic: str
    expect: []TkrExpect
    golden: []TkrGolden
    source_inline: str
    source_file: str
    env: []str
    target: str
    in_place: bool
    dep_dir: str
    check_wellformed: bool
}

fn tkr_lower_new(): TkrLower {
    TkrLower {
        args = []; stdin = ""; kind = TkrKind::Exit; exit = 0
        stdout = tkr_match_ignore(); stderr = tkr_match_ignore(); targets = []
        diagnostic = ""; expect = []; golden = []
        source_inline = ""; source_file = ""; env = []; target = ""
        in_place = false; dep_dir = ""; check_wellformed = false
    }
}

fn tkr_env_extend(env0: []str, extra: []str): []str {
    var out = env0
    var k: u64 = 0
    loop {
        if k >= extra.len { break }
        out = [..out, extra[k]]
        k = k + 1
    }
    out
}

fn tkr_target_env(value: str): []str {
    if value.len == 0 || value == HOST_TARGET { return [] }
    [teko::str::concat("TEKO_TARGET=", value)]
}

const HOST_OS_ARCH_TARGET: str = "host-os-arch"

fn tkr_resolve_target_name(value: str): str {
    if value != HOST_OS_ARCH_TARGET { return value }
    match host_default_target() { NativeTarget as t => target_name(t); error => HOST_TARGET }
}

fn tkr_apply_given(b: TkrLower, noun: str, value: str): TkrLower | error {
    if noun == "source" {
        var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = q.text; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "source inline" {
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = value; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "env" {
        var xs = match mf_read_str_list(value, 0) { []str as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = tkr_env_extend(b.env, xs); target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "target" {
        var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
        var name = tkr_resolve_target_name(q.text)
        var env2 = tkr_env_extend(b.env, tkr_target_env(name))
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = env2; target = name; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "dependency" {
        var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = q.text; check_wellformed = b.check_wellformed }
    }
    if noun == "args" {
        var xs = match mf_read_str_list(value, 0) { []str as x => x; error as e => return e }
        return TkrLower { args = xs; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "targets" {
        var xs = match mf_read_str_list(value, 0) { []str as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = xs; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "stdin" {
        var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = q.text; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "stdin bytes" {
        var d = match tkr_read_hex_docstring(value, 0) { str as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = d; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    error { message = teko::str::concat("tkr: unknown Given noun-phrase: ", noun) }
}

fn tkr_apply_then_top(b: TkrLower, noun: str, value: str): TkrLower | error {
    if noun == "exit" {
        var code = match tkr_read_i32(value, 0) { i32 as v => v; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = code; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "diagnostic" {
        var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = q.text; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if mf_starts_with(noun, "stdout") {
        var m = match tkr_noun_stream_match(noun, value) { TkrMatch as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = m; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if mf_starts_with(noun, "stderr") {
        var m = match tkr_noun_stream_match(noun, value) { TkrMatch as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = m; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    error { message = teko::str::concat("tkr: unknown Then noun-phrase: ", noun) }
}

fn tkr_apply_then_osarch(b: TkrLower, osarch: str, noun: str, value: str): TkrLower | error {
    if noun == "artifact sha256" {
        var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = tkr_put_golden(b.golden, osarch, q.text); source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    var e = tkr_get_expect(b.expect, osarch)
    if noun == "exit" {
        var code = match tkr_read_i32(value, 0) { i32 as v => v; error as er => return er }
        var ne = TkrExpect { osarch = osarch; has_exit = true; exit = code; stdout = e.stdout; stderr = e.stderr }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = tkr_put_expect(b.expect, ne); golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if mf_starts_with(noun, "stdout") {
        var m = match tkr_noun_stream_match(noun, value) { TkrMatch as x => x; error as er => return er }
        var ne = TkrExpect { osarch = osarch; has_exit = e.has_exit; exit = e.exit; stdout = m; stderr = e.stderr }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = tkr_put_expect(b.expect, ne); golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if mf_starts_with(noun, "stderr") {
        var m = match tkr_noun_stream_match(noun, value) { TkrMatch as x => x; error as er => return er }
        var ne = TkrExpect { osarch = osarch; has_exit = e.has_exit; exit = e.exit; stdout = e.stdout; stderr = m }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = tkr_put_expect(b.expect, ne); golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    error { message = teko::str::concat("tkr: unknown routed Then noun-phrase: ", noun) }
}

fn tkr_apply_step_lower(b: TkrLower, step: TkrStep): TkrLower | error {
    if step.phase == TkrPhase::When {
        if step.verb == "built in place" {
            return TkrLower { args = b.args; stdin = b.stdin; kind = TkrKind::Print; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = true; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
        }
        var k = match tkr_kind_for_verb(step.verb) { TkrKind as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = k; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if step.phase == TkrPhase::Given { return tkr_apply_given(b, step.noun, step.value) }
    if step.verb == "it traps" {
        return TkrLower { args = b.args; stdin = b.stdin; kind = TkrKind::Trap; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if step.verb == "object well-formed" {
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = true }
    }
    if step.osarch.len > 0 { return tkr_apply_then_osarch(b, step.osarch, step.noun, step.value) }
    tkr_apply_then_top(b, step.noun, step.value)
}

fn tkr_lower_to_tkr(steps: []TkrStep): Tkr | error {
    var b = tkr_lower_new()
    var k: u64 = 0
    loop {
        if k >= steps.len { break }
        b = match tkr_apply_step_lower(b, steps[k]) { TkrLower as nb => nb; error as e => return e }
        k = k + 1
    }
    Tkr {
        args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; expect = b.expect; golden = b.golden; diagnostic = b.diagnostic
        source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed
    }
}

fn tkr_lower_scenario(sc: TkrScenario): Tkr | error { tkr_lower_to_tkr(sc.steps) }

fn tkr_expand_outline(sc: TkrScenario): []Tkr | error {
    if !sc.outline || sc.examples.headers.len == 0 {
        var t = match tkr_lower_scenario(sc) { Tkr as x => x; error as e => return e }
        return [t]
    }
    var out: [sc.examples.rows.len]Tkr = []
    var r: u64 = 0
    loop {
        if r >= sc.examples.rows.len { break }
        var row = sc.examples.rows[r].cells
        if row.len != sc.examples.headers.len { return error { message = "tkr: Examples row width does not match the header row" } }
        var subst: [sc.steps.len]TkrStep = []
        var si: u64 = 0
        loop {
            if si >= sc.steps.len { break }
            subst[si] = tkr_step_subst(sc.steps[si], sc.examples.headers, row)
            si = si + 1
        }
        var t = match tkr_lower_to_tkr(subst) { Tkr as x => x; error as e => return e }
        out[r] = t
        r = r + 1
    }
    out
}

fn tkb_scenario_is_declarative(sc: TkrScenario): bool {
    var k: u64 = 0
    loop {
        if k >= sc.steps.len { break }
        if sc.steps[k].phase == TkrPhase::When { return false }
        k = k + 1
    }
    true
}
