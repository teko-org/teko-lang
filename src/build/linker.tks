type LinkArch = enum { X8664; Arm64 }

type LinkFormat = enum { Elf; Macho; Pe }

const MINGW_TOKEN: str = "mingw"

fn linker_is_mingw(cmd: str): bool {
    cmd.contains(MINGW_TOKEN)
}

const MINGW_TRIPLE_ABI_TOKEN: str = "windows-gnu"

fn triple_is_mingw(triple: str): bool {
    triple.contains(MINGW_TOKEN) || triple.contains(MINGW_TRIPLE_ABI_TOKEN)
}

fn arch_name(a: LinkArch): str {
    match a {
        LinkArch::X8664 => "x86_64"
        LinkArch::Arm64 => "arm64"
    }
}

fn format_name(f: LinkFormat): str {
    match f {
        LinkFormat::Elf => "ELF"
        LinkFormat::Macho => "Mach-O"
        LinkFormat::Pe => "PE"
    }
}

fn gnu_emulation_for(arch: LinkArch, fmt: LinkFormat): str {
    match fmt {
        LinkFormat::Elf => match arch {
            LinkArch::X8664 => "elf_x86_64"
            LinkArch::Arm64 => "aarch64linux"
        }
        LinkFormat::Pe => match arch {
            LinkArch::X8664 => "i386pep"
            LinkArch::Arm64 => ""
        }
        LinkFormat::Macho => ""
    }
}

fn linker_candidates(arch: LinkArch, fmt: LinkFormat): []str {
    match fmt {
        LinkFormat::Macho => {
            ["ld", "ld64.lld"]
        }
        LinkFormat::Pe => {
            ["lld-link"]
        }
        LinkFormat::Elf => {
            ["ld.lld", "ld", "ld.gold"]
        }
    }
}

fn no_linker_error(arch: LinkArch, fmt: LinkFormat): error {
    error { message = $"no linker on this host targets {arch_name(arch)}/{format_name(fmt)}. Tried: {join_candidates(linker_candidates(arch, fmt))}. A linker is NOT resolved from the PATH by default; install a linker native to the target or name one explicitly." }
}

const MINGW_BAN_REASON: str = "MinGW is forbidden (proibido) on every Windows host: the linker must be native to the target, not an EMULATED one resolved from the PATH."

fn mingw_rejected_error(cmd: str, arch: LinkArch): error {
    error { message = $"refusing the MinGW linker '{cmd}' for a {arch_name(arch)} target. {MINGW_BAN_REASON} Use a linker native to the target (lld-link ships with LLVM)." }
}

fn join_candidates(cands: []str): str {
    if cands.len == 0 { return "(none)" }
    var out = cands[0]
    var i: u64 = 1
    loop {
        if i >= cands.len { break }
        out = $"{out}, {cands[i]}"
        i = i + 1
    }
    out
}

fn linker_targets_arch(cmd: str, arch: LinkArch, fmt: LinkFormat): bool {
    var emu = gnu_emulation_for(arch, fmt)
    if emu.len == 0 { return false }
    var argv: []str = [
        cmd, "-m", emu, "--version"
    ]
    teko::process::run_quiet(argv) == 0
}

fn pe_linker_targets_arch(cmd: str, arch: LinkArch): bool {
    var machine = match arch {
        LinkArch::X8664 => "/machine:X64"
        LinkArch::Arm64 => ""
    }
    if machine.len == 0 { return false }
    var argv: []str = [
        cmd, machine, "/?"
    ]
    teko::process::run_quiet(argv) == 0
}

fn macho_linker_targets_arch(cmd: str, arch: LinkArch): bool {
    var argv: []str = [
        cmd, "-arch", arch_name(arch), "-v"
    ]
    teko::process::run_quiet(argv) == 0
}

fn candidate_targets(cmd: str, arch: LinkArch, fmt: LinkFormat): bool {
    if fmt == LinkFormat::Pe { return pe_linker_targets_arch(cmd, arch) }
    if fmt == LinkFormat::Macho { return macho_linker_targets_arch(cmd, arch) }
    linker_targets_arch(cmd, arch, fmt)
}

fn resolve_linker(arch: LinkArch, fmt: LinkFormat): str | error {
    var cands = linker_candidates(arch, fmt)
    var saw_mingw = ""
    var i: u64 = 0
    loop {
        if i >= cands.len { break }
        var cmd = cands[i]
        if linker_is_mingw(cmd) {
            saw_mingw = cmd
        } else if candidate_targets(cmd, arch, fmt) {
            return cmd
        }
        i = i + 1
    }
    if saw_mingw.len > 0 { return mingw_rejected_error(saw_mingw, arch) }
    no_linker_error(arch, fmt)
}
