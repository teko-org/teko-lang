type CapResult = struct {
    exit: i32
    stdout: str
    stderr: str
    harness_ns: i64
    child_ns: i64
    cmd: str
    chan_text: str
}

type RegrOutcome = struct {
    ok: bool
    skipped: bool
    skips: u64
    message: str
}

fn regr_fail(msg: str): RegrOutcome { RegrOutcome { ok = false; skipped = false; skips = 0; message = msg } }

fn regr_pass(): RegrOutcome { RegrOutcome { ok = true; skipped = false; skips = 0; message = "ok" } }

fn regr_skip(msg: str): RegrOutcome { RegrOutcome { ok = true; skipped = true; skips = 1; message = msg } }

fn regr_add_skips(oc: RegrOutcome, extra: u64): RegrOutcome {
    RegrOutcome { ok = oc.ok; skipped = oc.skipped; skips = oc.skips + extra; message = oc.message }
}

type ProcSpec = struct {
    argv: []str
    dir: str
    env: []str
    stdin_data: str
    prefix: str
}

fn spec_argv_display(argv: []str): str {
    var out = ""
    var k: u64 = 0
    loop {
        if k >= argv.len { break }
        if k > 0 { out = out ~ " " }
        out = out ~ argv[k]
        k = k + 1
    }
    out
}

fn spec_env_with_channel(spec: ProcSpec): []str {
    [..spec.env, teko::str::concat(teko::process::VERDICT_CHANNEL_ENV, teko::str::concat("=", spec.prefix ~ ".chan"))]
}

fn spawn_spec(spec: ProcSpec): teko::process::ProcHandle {
    match mkdir_p(teko::str::concat(dirname_of(spec.prefix), "/")) { error => { }; null => { } }
    match teko::io::write_file(spec.prefix ~ ".in", spec.stdin_data) { error => { }; null => { } }
    teko::process::spawn_redirected(spec.argv, spec.dir, spec_env_with_channel(spec), spec.prefix ~ ".in", spec.prefix ~ ".out", spec.prefix ~ ".err")
}

fn harvest_spec(spec: ProcSpec, h: teko::process::ProcHandle, t_spawn: i64, t_harness0: i64): CapResult {
    var rc = teko::process::wait_one(h)
    var t_waited = regr_now_ns()
    var out = match teko::io::read_file(spec.prefix ~ ".out") { str as s => s; error => "" }
    var err = match teko::io::read_file(spec.prefix ~ ".err") { str as s => s; error => "" }
    var chan = match teko::io::read_file(spec.prefix ~ ".chan") { str as s => s; error => "" }
    var t_read = regr_now_ns()
    CapResult {
        exit = rc; stdout = out; stderr = err
        harness_ns = (t_spawn - t_harness0) + (t_read - t_waited)
        child_ns = t_waited - t_spawn
        cmd = spec_argv_display(spec.argv)
        chan_text = chan
    }
}

fn run_captured_spec(spec: ProcSpec): CapResult {
    var t_start = regr_now_ns()
    var h = spawn_spec(spec)
    var t_spawn = regr_now_ns()
    harvest_spec(spec, h, t_spawn, t_start)
}

extern fn nproc_rt(): u64 = "tk_rt_nproc" from "teko_rt"

const MEMINFO_PATH: str = "/proc/meminfo"

const MEM_AVAILABLE_LABEL: str = "MemAvailable:"

const MEM_PER_JOB_KIB: u64 = 2097152

const NO_MEM_CAP: u64 = 1000000

fn mem_available_kib(content: str): u64 {
    var at = mem_label_end(content, MEM_AVAILABLE_LABEL)
    if at >= content.len { return 0 }
    var i = at
    loop {
        if i >= content.len { break }
        if content[i] != b' ' { break }
        i = i + 1
    }
    var v: u64 = 0
    var seen = false
    loop {
        if i >= content.len { break }
        var c = content[i]
        if c < b'0' || c > b'9' { break }
        v = (v * 10) + ((c to u64) - (b'0' to u64))
        seen = true
        i = i + 1
    }
    if !seen { return 0 }
    v
}

fn mem_label_end(content: str, label: str): u64 {
    if label.len == 0 || label.len > content.len { return content.len }
    var i: u64 = 0
    var last = content.len - label.len
    loop {
        if i > last { return content.len }
        if content.slice(i, i + label.len) == label { return i + label.len }
        i = i + 1
    }
}

fn mem_job_cap_at(path: str): u64 {
    var content = match teko::io::read_file(path) { str as s => s; error => return NO_MEM_CAP }
    var avail = mem_available_kib(content)
    if avail == 0 { return NO_MEM_CAP }
    var cap = avail / MEM_PER_JOB_KIB
    if cap < 1 { return 1 }
    cap
}

fn mem_job_cap(): u64 { mem_job_cap_at(MEMINFO_PATH) }

fn os_max_of(cpu: u64, mem: u64): u64 { if mem < cpu { mem } else { cpu } }

fn os_max(): u64 { os_max_of(nproc_rt(), mem_job_cap()) }

fn clamp_jobs(v: u64): u64 {
    var m = os_max()
    if v < 1 { return 1 }
    if v > m { return m }
    v
}

const REGR_JOBS_ENV: str = "TEKO_REGR_JOBS"

fn regr_jobs_of(raw: str): u64 { regr_jobs_of_default(raw, os_max()) }

fn regr_jobs_of_default(raw: str, fallback: u64): u64 {
    var v: u64 = 0
    var i: u64 = 0
    loop {
        if i >= raw.len { break }
        var c = raw[i]
        if c < b'0' { return fallback }
        if c > b'9' { return fallback }
        v = (v * 10) + ((c to u64) - (b'0' to u64))
        i = i + 1
    }
    if v == 0 { return fallback }
    v
}

fn regr_jobs(): u64 {
    match teko::env::var(REGR_JOBS_ENV) { str as v => clamp_jobs(regr_jobs_of(v)); error => os_max() }
}

fn pool_window(n: u64, jobs: u64): u64 {
    if jobs < 1 { return 1 }
    if jobs > n { return n }
    jobs
}

pub fn run_pool(specs: []ProcSpec, jobs: u64): []CapResult {
    var n = specs.len
    if n == 0 { return [] }
    var caps: [n]CapResult = []
    var window = pool_window(n, jobs)
    var t_pool0 = regr_now_ns()
    var handles: [window]teko::process::ProcHandle = []
    var spawned_at: [window]i64 = []
    var launched: u64 = 0
    loop {
        if launched >= window { break }
        handles[launched] = spawn_spec(specs[launched])
        spawned_at[launched] = regr_now_ns()
        launched = launched + 1
    }
    var harvested: u64 = 0
    loop {
        if harvested >= n { break }
        caps[harvested] = harvest_spec(specs[harvested], handles[harvested], spawned_at[harvested], t_pool0)
        harvested = harvested + 1
        if launched < n {
            handles = [..handles, spawn_spec(specs[launched])]
            spawned_at = [..spawned_at, regr_now_ns()]
            launched = launched + 1
        }
    }
    caps
}

fn regr_now_ns(): i64 {
    teko::time::span_monotonic_now().ticks
}

fn cap_synthetic(exit: i32, stderr: str): CapResult {
    CapResult { exit = exit; stdout = ""; stderr = stderr; harness_ns = 0; child_ns = 0; cmd = ""; chan_text = "" }
}

fn cap_with_extra_harness(c: CapResult, ns: i64): CapResult {
    CapResult { exit = c.exit; stdout = c.stdout; stderr = c.stderr; harness_ns = c.harness_ns + ns; child_ns = c.child_ns; cmd = c.cmd; chan_text = c.chan_text }
}

fn run_captured_env(argv: []str, stdin_data: str, env: []str, prefix: str): CapResult {
    run_captured_spec(ProcSpec { argv = argv; dir = ""; env = env; stdin_data = stdin_data; prefix = prefix })
}

fn run_captured_in_dir(argv: []str, stdin_data: str, env: []str, dir: str, prefix: str): CapResult {
    var effective_dir = if dir == "." { "" } else { dir }
    run_captured_spec(ProcSpec { argv = argv; dir = effective_dir; env = env; stdin_data = stdin_data; prefix = prefix })
}

fn run_captured(argv: []str, stdin_data: str, prefix: str): CapResult {
    run_captured_env(argv, stdin_data, [], prefix)
}

fn tool_on_path(name: str): bool {
    var shv: []str = ["sh", "-c", teko::str::concat("command -v ", name) ~ " >/dev/null 2>&1"]
    teko::process::run_quiet(shv) == 0
}

const TOOL_QUERY_PREFIX: str = "bin/.regr-work/.toolquery"

fn tool_query_prefix(): str { teko::test::scoped(TOOL_QUERY_PREFIX) }

fn tool_query_line(argv: []str): str {
    var cap = run_captured(argv, "", tool_query_prefix())
    if cap.exit != 0 { return "" }
    trimmed_line(first_line(cap.stdout))
}

const REGRESSION_REQUIRE_TOOLS_VAR: str = "REGRESSION_REQUIRE_TOOLS"

fn tool_skip_or_fail(reason: str): RegrOutcome {
    var require = match teko::env::var(REGRESSION_REQUIRE_TOOLS_VAR) { str as v => v == "1"; error => false }
    if require { return regr_fail(reason) }
    regr_skip(reason)
}

fn regressive_name(regr_dir: str): str | error {
    var entries = match teko::fs::list_dir(regr_dir) { []str as e => e; error as e => return e }
    var tkp = ""
    var k: u64 = 0
    loop {
        if k >= entries.len { break }
        if entries[k].ends_with(".tkp") { tkp = entries[k] }
        k = k + 1
    }
    if tkp.len == 0 { return error { message = "regressive has no .tkp manifest" } }
    var text = match teko::io::read_file(regr_dir ~ "/" ~ tkp) { str as s => s; error as e => return e }
    var m = match parse_manifest(text) { Manifest as mm => mm; error as e => return e }
    m.name
}

fn argv_with_args(binp: str, args: []str): []str {
    [binp, ..args]
}

fn tkr_effective_target(target: str): str {
    if target.len > 0 && target != HOST_TARGET { return target }
    os()
}

const HOST_CC_NAME: str = "cc"

fn cross_cc_for_target(target: str): str {
    if target.len == 0 || target == HOST_TARGET { return "" }
    var cc = match target_from_name(target) { NativeTarget as t => default_cc_for_target(t); error => "" }
    if cc == HOST_CC_NAME { return "" }
    cc
}

fn host_cc_cannot_link_cross_reason(target: str): str {
    if !cross_note_for_name(target).is_cross { return "" }
    var t = match target_from_name(target) { NativeTarget as x => x; error => return "" }
    if !target_links_with_cc(t) { return "" }
    if default_cc_for_target(t) != HOST_CC_NAME { return "" }
    if teko_cc_env().len > 0 { return "" }
    $"the host cc cannot link a {target_name(t)} object and no cross toolchain is pinned (TEKO_CC)"
}

const HOST_CC_MACHINE_FLAG: str = "-dumpmachine"

fn arch_token_canonical(tok: str): str {
    if tok == "aarch64" { return "arm64" }
    if tok == "amd64" || tok == "x64" { return "x86_64" }
    tok
}

fn host_cc_arch(): str {
    var argv: []str = [HOST_CC_NAME, HOST_CC_MACHINE_FLAG]
    var triple = tool_query_line(argv)
    var k: u64 = 0
    loop {
        if k >= triple.len { break }
        if triple[k] == b'-' { break }
        k = k + 1
    }
    arch_token_canonical(triple.slice_to(k))
}

fn host_default_unsupported_skip_reason(is_host_default_row: bool, e: error): str {
    if !is_host_default_row { return "" }
    $"this row needs the own backend's host-default target, but this host has none: {e.message}"
}

fn host_cc_cannot_link_host_default_reason(target: str, own_backend: bool): str {
    if !own_backend { return "" }
    if teko_cc_env().len > 0 { return "" }
    if cross_note_for_name(target).is_cross { return "" }
    var is_host_default_row = target.len == 0 || target == HOST_TARGET
    var sel = match own_backend_target_of_row(target) {
        NativeTarget as x => x
        error as e => return host_default_unsupported_skip_reason(is_host_default_row, e)
    }
    if !target_links_with_cc(sel) { return "" }
    if default_cc_for_target(sel) != HOST_CC_NAME { return "" }
    if target_objfmt(sel) != OBJFMT_ELF { return "" }
    var want = target_arch_name(sel)
    if want.len == 0 { return "" }
    var have = host_cc_arch()
    if have.len == 0 || have == want { return "" }
    $"this row emits for {target_name(sel)} ({want} ELF) but the host cc targets {have}, and the host cc cannot link a foreign-arch object — its own `arch()` reading and its `cc`'s target arch disagree"
}

fn own_backend_target_of_row(target: str): NativeTarget | error {
    if target.len == 0 || target == HOST_TARGET { return host_default_target() }
    target_from_name(target)
}

fn target_toolchain_skip_reason(target: str): str {
    var cc = cross_cc_for_target(target)
    if cc.len > 0 && !tool_on_path(cc) {
        return $"{cc} (the cross-linker for target {target}) not found on PATH"
    }
    host_cc_cannot_link_cross_reason(target)
}

fn tkr_row_capability_skip_reason(t: Tkr): str {
    var missing = target_toolchain_skip_reason(t.target)
    if missing.len > 0 { return missing }
    host_cc_cannot_link_host_default_reason(t.target, true)
}

fn wellformed_script_for(target: str): str {
    if target.contains("windows") { return "scripts/check_coff.sh" }
    if target.contains("macos") || target.contains("macho") || target.contains("darwin") { return "scripts/check_macho.sh" }
    "scripts/check_elf.sh"
}

fn check_object_wellformed(objp: str, target: str): RegrOutcome {
    var script = wellformed_script_for(target)
    if script.len == 0 { return regr_skip(teko::str::concat("no object well-formedness checker for target ", target)) }
    var argv: []str = [script, objp, target]
    var cap = run_captured(argv, "", objp ~ ".wellformed")
    if cap.exit != 0 {
        return regr_fail($"object well-formedness check failed{captured_output_block(cap)}")
    }
    regr_pass()
}

fn compile_regressive(exe: str, regr_dir: str, env: []str, prefix: str): CapResult {
    run_captured_env(compile_regressive_argv(exe, regr_dir), "", env, prefix)
}

fn compile_regressive_argv(exe: str, regr_dir: str): []str {
    [exe, regr_dir, "-o", "bin", "--no-verify"]
}

fn compile_regressive_spec(exe: str, regr_dir: str, env: []str, prefix: str): ProcSpec {
    ProcSpec { argv = compile_regressive_argv(exe, regr_dir); dir = ""; env = env; stdin_data = ""; prefix = prefix }
}

fn compile_in_place(exe: str, regr_dir: str, env: []str, prefix: str): CapResult {
    var argv: []str = [exe, ".", "-o", "bin", "--no-verify"]
    run_captured_in_dir(argv, "", env, regr_dir, prefix)
}

const SNIPPET_PROJECT_NAME: str = "snippet"

fn snippet_manifest_text(): str {
    "name = \"" ~ SNIPPET_PROJECT_NAME ~ "\"\nsource = \"src\"\n\n[artifact]\nkind = \"binary\"\n"
}

type SnippetSplit = struct {
    decls: str
    stmts: str
    tail: str
}

fn snippet_chunk_head_keyword_start(t: str): u64 {
    var rest = t
    var off: u64 = 0
    loop {
        var before = rest
        if mf_starts_with(rest, "pub ") { rest = rest.slice(4, rest.len); off = off + 4 }
        if mf_starts_with(rest, "exp ") { rest = rest.slice(4, rest.len); off = off + 4 }
        if mf_starts_with(rest, "unsafe ") { rest = rest.slice(7, rest.len); off = off + 7 }
        if mf_starts_with(rest, "extern ") { rest = rest.slice(7, rest.len); off = off + 7 }
        if rest == before { break }
    }
    off
}

fn snippet_chunk_skip_attr_lines(text: str): str {
    var rest = text
    loop {
        if !mf_starts_with(tkr_trim(rest), "#") { return rest }
        var k: u64 = 0
        loop {
            if k >= rest.len { break }
            if rest[k] == b'\n' { break }
            k = k + 1
        }
        if k >= rest.len { return "" }
        rest = rest.slice(k + 1, rest.len)
    }
}

fn snippet_chunk_is_decl(chunk: str): bool {
    var t = tkr_trim(snippet_chunk_skip_attr_lines(chunk))
    var head = t.slice(snippet_chunk_head_keyword_start(t), t.len)
    mf_starts_with(head, "type ") || mf_starts_with(head, "fn ") || mf_starts_with(head, "class ") || mf_starts_with(head, "flags ") || mf_starts_with(head, "interface ") || mf_starts_with(head, "use ") || mf_starts_with(head, "const ")
}

type BraceScan = struct {
    delta: i64
    in_str: bool
    in_comment: bool
}

fn snippet_brace_delta(line: str, in_str: bool, in_comment: bool): BraceScan {
    var d: i64 = 0
    var open = in_str
    var quote: byte = b'"'
    var comment = in_comment
    var k: u64 = 0
    loop {
        if k >= line.len { break }
        var c = line[k]
        if comment {
            if c == b'*' && k + 1 < line.len && line[k + 1] == b'/' { comment = false; k = k + 2; continue }
            k = k + 1
            continue
        }
        if open {
            if c == b'\\' { k = k + 2; continue }
            if c == quote { open = false }
            k = k + 1
            continue
        }
        if c == b'/' && k + 1 < line.len && line[k + 1] == b'*' { comment = true; k = k + 2; continue }
        if c == b'"' || c == b'\'' { open = true; quote = c; k = k + 1; continue }
        if c == b'/' && k + 1 < line.len && line[k + 1] == b'/' { break }
        if c == b'{' { d = d + 1 }
        if c == b'}' { d = d - 1 }
        k = k + 1
    }
    BraceScan { delta = d; in_str = open; in_comment = comment }
}

fn snippet_skip_doc_comment(src: str, from: u64): u64 {
    var cur = from
    loop {
        if cur >= src.len { return cur }
        var eol = cur
        loop {
            if eol >= src.len { break }
            if src[eol] == b'\n' { break }
            eol = eol + 1
        }
        var line = src.slice(cur, eol)
        var next = if eol < src.len { eol + 1 } else { eol }
        if line.contains("*/") { return next }
        cur = next
    }
    src.len
}

fn split_snippet_decls_and_stmts(src: str): SnippetSplit {
    var decls = ""
    var stmts = ""
    var tail = ""
    var chunk = ""
    var depth: i64 = 0
    var in_chunk = false
    var in_str = false
    var in_comment = false
    var attr_only = true
    var cur: u64 = 0
    loop {
        if cur >= src.len { break }
        var eol = cur
        loop {
            if eol >= src.len { break }
            if src[eol] == b'\n' { break }
            eol = eol + 1
        }
        var line = src.slice(cur, eol)
        var next = if eol < src.len { eol + 1 } else { eol }
        var trimmed = tkr_trim(line)
        if !in_chunk && trimmed.len == 0 { cur = next; continue }
        if !in_chunk && mf_starts_with(trimmed, "/**") { cur = snippet_skip_doc_comment(src, cur); continue }
        if !in_chunk { attr_only = true }
        in_chunk = true
        if chunk.len > 0 { chunk = chunk ~ "\n" }
        chunk = chunk ~ line
        if trimmed.len > 0 && !mf_starts_with(trimmed, "#") { attr_only = false }
        var scan = snippet_brace_delta(line, in_str, in_comment)
        depth = depth + scan.delta
        in_str = scan.in_str
        in_comment = scan.in_comment
        if depth <= 0 && !attr_only {
            if snippet_chunk_is_decl(chunk) { decls = decls ~ chunk ~ "\n\n" } else { stmts = stmts ~ chunk ~ "\n\n"; tail = chunk ~ "\n\n" }
            chunk = ""
            depth = 0
            in_chunk = false
        }
        cur = next
    }
    if chunk.len > 0 {
        if snippet_chunk_is_decl(chunk) { decls = decls ~ chunk ~ "\n" } else { stmts = stmts ~ chunk ~ "\n"; tail = chunk ~ "\n" }
    }
    SnippetSplit { decls = decls; stmts = stmts; tail = tail }
}

fn rm_rf(path: str): null | error {
    var argv: []str = ["rm", "-rf", path]
    if teko::process::run(argv) != 0 { return error { message = teko::str::concat("failed to remove ", path) } }
    null
}

fn compile_snippet_text(exe: str, src_text: str, env: []str, prefix: str): CapResult {
    var t_start = regr_now_ns()
    var proj = prefix ~ ".proj"
    match rm_rf(proj) { error => { }; null => { } }
    match mkdir_p(teko::str::concat(proj, "/src/")) { error => { }; null => { } }
    match teko::io::write_file(proj ~ "/teko.tkp", snippet_manifest_text()) { error => { }; null => { } }
    var split = split_snippet_decls_and_stmts(src_text)
    if split.decls.len == 0 {
        match teko::io::write_file(proj ~ "/main.tks", src_text) { error => { }; null => { } }
    } else {
        match teko::io::write_file(proj ~ "/src/regr_decls.tks", split.decls) { error => { }; null => { } }
        match teko::io::write_file(proj ~ "/main.tks", split.stmts) { error => { }; null => { } }
    }
    var scratch_ns = regr_now_ns() - t_start
    cap_with_extra_harness(compile_regressive(exe, proj, env, prefix ~ ".compile"), scratch_ns)
}

fn snippet_project_binp(prefix: str): str { prefix ~ ".proj/bin/" ~ SNIPPET_PROJECT_NAME }

fn row_artifact_target(target: str): NativeTarget {
    match own_backend_target_of_row(target) { NativeTarget as t => t; error => host_default_target_guess() }
}

fn artifact_path_for_target(base_binp: str, target: str): str {
    base_binp ~ executable_suffix(row_artifact_target(target))
}

fn compile_standalone_source(exe: str, srcp: str, env: []str, prefix: str): CapResult {
    var text = match teko::io::read_file(srcp) {
        str as s => s
        error as e => return cap_synthetic(1, teko::str::concat("cannot read source file: ", e.message))
    }
    compile_snippet_text(exe, text, env, prefix)
}

fn compile_inline_source(exe: str, src_text: str, env: []str, prefix: str): CapResult {
    compile_snippet_text(exe, src_text, env, prefix)
}

fn copy_dir(src: str, dst: str): null | error {
    match rm_rf(dst) { error as e => return e; null => { } }
    match mkdir_p(teko::str::concat(dirname_of(dst), "/")) { error as e => return e; null => { } }
    var argv: []str = ["cp", "-R", src, dst]
    if teko::process::run(argv) != 0 { return error { message = teko::str::concat("failed to copy directory ", src) } }
    null
}

fn provision_dependency(exe: str, dep_dir: str, scratch_packages: str, prefix: str): str | error {
    match mkdir_p(teko::str::concat(scratch_packages, "/")) { error => { }; null => { } }
    var cwd = match teko::env::cwd() { str as c => c; error => "" }
    var dep_out = abs_path_of(prefix ~ ".depout", cwd)
    var argv: []str = [exe, dep_dir, "-o", dep_out, "--no-verify"]
    var comp = run_captured_env(argv, "", with_regr_cov_env([], prefix ~ ".dep_compile"), prefix ~ ".dep_compile")
    if comp.exit != 0 { return error { message = teko::str::concat("dependency build failed: ", compile_failure_message(comp)) } }
    var entries = match teko::fs::list_dir(dep_out) { []str as e => e; error as e => return e }
    var tkl = ""
    var k: u64 = 0
    loop {
        if k >= entries.len { break }
        if entries[k].ends_with(".tkl") { tkl = entries[k] }
        k = k + 1
    }
    if tkl.len == 0 { return error { message = "dependency build produced no .tkl artifact" } }
    var bytes = match teko::io::read_file(dep_out ~ "/" ~ tkl) { str as s => s; error as e => return e }
    var dst = scratch_packages ~ "/" ~ tkl
    match teko::io::write_file(dst, bytes) { error as e => return e; null => { } }
    dst
}

fn first_line(s: str): str {
    var k: u64 = 0
    loop {
        if k >= s.len { break }
        if s[k] == b'\n' { break }
        k = k + 1
    }
    s.slice(0, k)
}

const COMPILE_FAIL_TAIL_LINES: u64 = 40

const COMPILE_FAIL_HEAD_LINES: u64 = 20

fn count_text_lines(s: str): u64 {
    var end = s.len
    loop {
        if end == 0 { return 0 }
        if s[end - 1] != b'\n' { break }
        end = end - 1
    }
    var n: u64 = 1
    var i: u64 = 0
    loop {
        if i >= end { break }
        if s[i] == b'\n' { n = n + 1 }
        i = i + 1
    }
    n
}

fn head_lines(s: str, n: u64): str {
    if n == 0 { return "" }
    var end = s.len
    loop {
        if end == 0 { break }
        if s[end - 1] != b'\n' { break }
        end = end - 1
    }
    var stop: u64 = 0
    var seen: u64 = 0
    loop {
        if stop >= end { break }
        if s[stop] == b'\n' {
            seen = seen + 1
            if seen == n { break }
        }
        stop = stop + 1
    }
    s.slice(0, stop)
}

fn tail_lines(s: str, n: u64): str {
    if n == 0 { return "" }
    var end = s.len
    loop {
        if end == 0 { break }
        if s[end - 1] != b'\n' { break }
        end = end - 1
    }
    var start = end
    var seen: u64 = 0
    loop {
        if start == 0 { break }
        if s[start - 1] == b'\n' {
            seen = seen + 1
            if seen == n { break }
        }
        start = start - 1
    }
    s.slice(start, end)
}

fn compile_fail_excerpt(s: str): str {
    var total = count_text_lines(s)
    var kept = COMPILE_FAIL_HEAD_LINES + COMPILE_FAIL_TAIL_LINES
    if total <= kept { return tail_lines(s, total) }
    var elided = total - kept
    var head = head_lines(s, COMPILE_FAIL_HEAD_LINES)
    var tail = tail_lines(s, COMPILE_FAIL_TAIL_LINES)
    $"{head}\n… {elided} line(s) elided; the excerpt keeps both ends …\n{tail}"
}

fn compile_failure_message(comp: CapResult): str {
    var err_part = compile_fail_excerpt(comp.stderr)
    if err_part.len > 0 { return $"compile failed (exit {comp.exit}); captured output excerpt:\n{err_part}" }
    var out_part = compile_fail_excerpt(comp.stdout)
    if out_part.len > 0 { return $"compile failed (exit {comp.exit}); captured stdout excerpt:\n{out_part}" }
    $"compile failed (exit {comp.exit}); the build wrote nothing to stdout or stderr"
}

fn match_stream(m: TkrMatch, actual: str): bool {
    if m.mode == TkrMatchMode::Ignore { return true }
    if m.mode == TkrMatchMode::Literal { return actual == m.text }
    if m.mode == TkrMatchMode::Pattern {
        match teko::regex::is_match_pattern(m.text, actual) { bool as b => return b; error => return false }
    }
    teko::crypto::sha256_hex_of(actual.bytes()) == m.text
}

fn stream_match_failure(m: TkrMatch, actual: str, stream: str): str {
    if m.mode != TkrMatchMode::Pattern {
        if match_stream(m, actual) { return "" }
        return $"{stream} did not match the expectation"
    }
    var re = match teko::regex::compile(m.text) {
        teko::regex::Regex as r => r
        error as e => return $"{stream} pattern is not a valid regex: {e.message}\n  pattern: {m.text}"
    }
    if teko::regex::is_match(re, actual) { return "" }
    var tail = tail_lines(actual, RUN_FAIL_TAIL_LINES)
    if tail.len > 0 { return $"{stream} did not contain the declared pattern\n  pattern: {m.text}\n  captured {stream} tail:\n{tail}" }
    $"{stream} did not contain the declared pattern\n  pattern: {m.text}\n  the program wrote nothing to {stream}"
}

fn resolve_stream(base_match: TkrMatch, ov: TkrMatch): TkrMatch {
    if ov.mode == TkrMatchMode::Ignore { return base_match }
    ov
}

fn check_compile_fail(t: Tkr, comp: CapResult): RegrOutcome {
    if comp.exit == 0 {
        return regr_fail($"expected a compile failure but the build succeeded{captured_output_block(comp)}")
    }
    if t.diagnostic.len > 0 && !comp.stderr.contains(t.diagnostic) {
        return regr_fail($"build failed but its diagnostic omitted: {t.diagnostic}{captured_output_block(comp)}")
    }
    regr_pass()
}

fn captured_output_block(comp: CapResult): str {
    var err = "(the build wrote nothing to stderr)\n"
    if comp.stderr.len > 0 { err = comp.stderr }
    var out = "(the build wrote nothing to stdout)\n"
    if comp.stdout.len > 0 { out = comp.stdout }
    $"\n  the build's own output follows IN FULL — this is what the compiler actually said:\n--- build stderr (exit {comp.exit}) ---\n{err}--- build stdout ---\n{out}--- end of build output ---"
}

const SPAWN_FAILED_EXIT: i32 = -1

const EXEC_FAILED_EXIT: i32 = 127

fn exit_origin_note(code: i32): str {
    if code == SPAWN_FAILED_EXIT { return " (the runtime could not start the child at all — harness/host fault, the scenario never ran)" }
    if code == EXEC_FAILED_EXIT { return " (the child forked but could not exec — command-not-found, or the child chose 127 itself)" }
    ""
}

fn exit_mismatch_message(run: CapResult, exp_exit: i32): str {
    var head = $"exit {run.exit}, expected {exp_exit}{exit_origin_note(run.exit)}"
    var cmd_line = if run.cmd.len > 0 { $"\n  argv: {run.cmd}" } else { "" }
    var err_tail = tail_lines(run.stderr, RUN_FAIL_TAIL_LINES)
    if err_tail.len > 0 { return $"{head}{cmd_line}; captured stderr tail:\n{err_tail}" }
    var out_tail = tail_lines(run.stdout, RUN_FAIL_TAIL_LINES)
    if out_tail.len > 0 { return $"{head}{cmd_line}; captured stdout tail:\n{out_tail}" }
    $"{head}{cmd_line}; the program wrote nothing to stdout or stderr"
}

const RUN_FAIL_TAIL_LINES: u64 = 12

fn check_run(t: Tkr, target: str, run: CapResult): RegrOutcome {
    var ov = tkr_expect_for(t, target)
    var exp_exit = match ov { TkrExpect as e => if e.has_exit { e.exit } else { t.exit }; null => t.exit }
    var so = match ov { TkrExpect as e => resolve_stream(t.stdout, e.stdout); null => t.stdout }
    var se = match ov { TkrExpect as e => resolve_stream(t.stderr, e.stderr); null => t.stderr }
    if t.kind == TkrKind::Trap {
        if run.exit == 0 { return regr_fail("expected a trap (non-zero exit) but the program exited 0") }
    } else {
        if run.exit != exp_exit { return regr_fail(exit_mismatch_message(run, exp_exit)) }
    }
    var out_bad = stream_match_failure(so, run.stdout, "stdout")
    if out_bad.len > 0 { return regr_fail(out_bad) }
    var err_bad = stream_match_failure(se, run.stderr, "stderr")
    if err_bad.len > 0 { return regr_fail(err_bad) }
    regr_pass()
}

pub const REGR_WORK_DIR: str = "bin/.regr-work"

fn with_regr_cov_env(env: []str, prefix: str): []str {
    var cwd = match teko::env::cwd() { str as c => c; error => "" }
    [..env, $"TEKO_TKCOV={abs_path_of(prefix, cwd)}.tkcov"]
}

fn collect_tkcov_files(dir: str): []str {
    var out: []str = []
    var entries = match teko::fs::list_dir(dir) { []str as e => e; error => return out }
    var i: u64 = 0
    loop {
        if i >= entries.len { break }
        var full = dir ~ "/" ~ entries[i]
        match teko::fs::list_dir(full) {
            []str => {
                var sub = collect_tkcov_files(full)
                var si: u64 = 0
                loop { if si >= sub.len { break }; out = [..out, sub[si]]; si = si + 1 }
            }
            error => { if full.ends_with(".tkcov") { out = [..out, full] } }
        }
        i = i + 1
    }
    out
}

pub fn merge_regression_coverage(): u64 {
    var files = collect_tkcov_files(REGR_WORK_DIR)
    var i: u64 = 0
    loop {
        if i >= files.len { break }
        teko::coverage::cov_merge(files[i])
        i = i + 1
    }
    files.len
}

type RegrBuildKind = enum { None; Project; Dependency; InPlace }

type RegrSrcBuild = struct {
    key: str
    comp: CapResult
    binp: str
}

fn regr_src_key(srcp: str, env: []str): str {
    var out = srcp
    var i: u64 = 0
    loop {
        if i >= env.len { break }
        out = out ~ "\n" ~ env[i]
        i = i + 1
    }
    out
}

fn regr_src_lookup(built: RegrBuilt, key: str): RegrSrcBuild | null {
    var i: u64 = 0
    loop {
        if i >= built.srcs.len { break }
        if built.srcs[i].key == key { return built.srcs[i] }
        i = i + 1
    }
    null
}

fn regr_src_remember(built: RegrBuilt, entry: RegrSrcBuild): RegrBuilt {
    RegrBuilt { done = built.done; kind = built.kind; comp = built.comp; binp = built.binp; srcs = [..built.srcs, entry] }
}

fn tkr_standalone_artifact(exe: str, srcp: str, t: Tkr, prefix: str, built: RegrBuilt): TkrArtifact {
    var key = regr_src_key(srcp, t.env)
    match regr_src_lookup(built, key) {
        RegrSrcBuild as hit => return TkrArtifact { comp = hit.comp; binp = hit.binp; built = built; fresh = false }
        null => { }
    }
    var comp = compile_standalone_source(exe, srcp, with_regr_cov_env(t.env, prefix), prefix)
    var binp = artifact_path_for_target(snippet_project_binp(prefix), t.target)
    TkrArtifact { comp = comp; binp = binp; built = regr_src_remember(built, RegrSrcBuild { key = key; comp = comp; binp = binp }); fresh = true }
}

type RegrBuilt = struct {
    done: bool
    kind: RegrBuildKind
    comp: CapResult
    binp: str
    srcs: []RegrSrcBuild
}

fn tkr_ensure_built(exe: str, regr_dir: str, env: []str, prefix: str, built: RegrBuilt): RegrBuilt {
    if regr_built_serves(built, RegrBuildKind::Project) { return built }
    var comp = compile_regressive(exe, regr_dir, env, prefix ~ ".compile")
    var name = match regressive_name(regr_dir) { str as s => s; error => "" }
    RegrBuilt { done = true; kind = RegrBuildKind::Project; comp = comp; binp = regr_dir ~ "/bin/" ~ name; srcs = built.srcs }
}

fn regr_built_serves(built: RegrBuilt, want: RegrBuildKind): bool {
    if !built.done { return false }
    built.kind == want
}

fn guard_no_project_build_at_root(regr_dir: str, t: Tkr): null | error {
    var at_root = regr_dir == "." || regr_dir.len == 0
    var has_src = t.source_inline.len > 0 || t.source_file.len > 0
    if at_root && !has_src {
        return error { message = "regressor.tkr scenario at the project root has no inline/explicit `source` — it would rebuild the compiler root" }
    }
    null
}

type TkrArtifact = struct {
    comp: CapResult
    binp: str
    built: RegrBuilt
    fresh: bool
}

fn tkr_artifact_fail(msg: str, built: RegrBuilt): TkrArtifact {
    TkrArtifact { comp = cap_synthetic(1, msg); binp = ""; built = built; fresh = false }
}

fn tkr_ensure_artifact(exe: str, regr_dir: str, t: Tkr, prefix: str, built: RegrBuilt): TkrArtifact {
    match guard_no_project_build_at_root(regr_dir, t) { error as e => return tkr_artifact_fail(e.message, built); null => { } }
    if t.source_inline.len > 0 {
        var comp = compile_inline_source(exe, t.source_inline, with_regr_cov_env(t.env, prefix), prefix)
        return TkrArtifact { comp = comp; binp = artifact_path_for_target(snippet_project_binp(prefix), t.target); built = built; fresh = true }
    }
    if t.source_file.len > 0 {
        return tkr_standalone_artifact(exe, regr_dir ~ "/" ~ t.source_file, t, prefix, built)
    }
    if t.dep_dir.len > 0 {
        if regr_built_serves(built, RegrBuildKind::Dependency) { return TkrArtifact { comp = built.comp; binp = built.binp; built = built; fresh = false } }
        var scratch_consumer = prefix ~ ".consumer"
        match copy_dir(regr_dir, scratch_consumer) { error as e => return tkr_artifact_fail(e.message, built); null => { } }
        match provision_dependency(exe, regr_dir ~ "/" ~ t.dep_dir, scratch_consumer ~ "/packages", prefix ~ ".dep") {
            error as e => return tkr_artifact_fail(e.message, built)
            str => { }
        }
        var comp = compile_regressive(exe, scratch_consumer, with_regr_cov_env(t.env, prefix ~ ".compile"), prefix ~ ".compile")
        var name = match regressive_name(scratch_consumer) { str as s => s; error => "" }
        var nb = RegrBuilt { done = true; kind = RegrBuildKind::Dependency; comp = comp; binp = artifact_path_for_target(scratch_consumer ~ "/bin/" ~ name, t.target); srcs = built.srcs }
        return TkrArtifact { comp = nb.comp; binp = nb.binp; built = nb; fresh = true }
    }
    if t.in_place {
        if regr_built_serves(built, RegrBuildKind::InPlace) { return TkrArtifact { comp = built.comp; binp = built.binp; built = built; fresh = false } }
        var comp = compile_in_place(exe, regr_dir, with_regr_cov_env(t.env, prefix ~ ".compile"), prefix ~ ".compile")
        var name = match regressive_name(regr_dir) { str as s => s; error => "" }
        var nb = RegrBuilt { done = true; kind = RegrBuildKind::InPlace; comp = comp; binp = artifact_path_for_target(regr_dir ~ "/bin/" ~ name, t.target); srcs = built.srcs }
        return TkrArtifact { comp = nb.comp; binp = nb.binp; built = nb; fresh = true }
    }
    var fresh = !regr_built_serves(built, RegrBuildKind::Project)
    var nb = tkr_ensure_built(exe, regr_dir, with_regr_cov_env(t.env, prefix), prefix, built)
    TkrArtifact { comp = nb.comp; binp = artifact_path_for_target(nb.binp, t.target); built = nb; fresh = fresh }
}

fn tkr_row_run_verdict(t: Tkr, binp: str, prefix: str): RowVerdict {
    if t.kind == TkrKind::EmitOnly { return emit_only_row_verdict() }
    var cross = cross_note_for_name(t.target)
    if cross.is_cross { return RowVerdict { outcome = regr_skip(cross.note); harness_ns = 0; run_ns = 0 } }
    var cwd = match teko::env::cwd() { str as c => c; error => "" }
    var rundir = prefix ~ ".cwd"
    match mkdir_p(teko::str::concat(rundir, "/")) { error => { }; null => { } }
    var argv = argv_with_args(abs_path_of(binp, cwd), t.args)
    var run = run_captured_in_dir(argv, t.stdin, t.env, rundir, abs_path_of(prefix, cwd))
    RowVerdict { outcome = check_run(t, HOST_TARGET, run); harness_ns = run.harness_ns; run_ns = run.child_ns }
}

fn emit_only_row_verdict(): RowVerdict {
    RowVerdict { outcome = regr_pass(); harness_ns = 0; run_ns = 0 }
}

type RowVerdict = struct {
    outcome: RegrOutcome
    harness_ns: i64
    run_ns: i64
}

fn tkr_run_one_row(t: Tkr, binp: str, prefix: str): RowVerdict {
    var rv = tkr_row_run_verdict(t, binp, prefix)
    if !rv.outcome.ok { return rv }
    var skips: u64 = 0
    if t.check_wellformed {
        var wf = check_object_wellformed(sibling_object_path(binp, row_artifact_target(t.target)), tkr_effective_target(t.target))
        if !wf.ok && !wf.skipped { return RowVerdict { outcome = wf; harness_ns = rv.harness_ns; run_ns = rv.run_ns } }
        skips = skips + wf.skips
    }
    RowVerdict { outcome = regr_add_skips(rv.outcome, skips); harness_ns = rv.harness_ns; run_ns = rv.run_ns }
}

type FeatureRunResult = struct {
    outcome: RegrOutcome
    built: RegrBuilt
    rows: []RowTiming
}

type TkrRowRun = struct {
    outcome: RegrOutcome
    built: RegrBuilt
    times: PhaseTimes
}

fn tkr_run_row(exe: str, regr_dir: str, t: Tkr, prefix: str, built: RegrBuilt, groups: RegrGroups): TkrRowRun {
    var missing = tkr_row_capability_skip_reason(t)
    if missing.len > 0 { return TkrRowRun { outcome = tool_skip_or_fail(missing); built = built; times = phase_zero() } }
    match regr_group_slot(groups, prefix) {
        RegrGroupSlot as slot => return tkr_run_grouped_row(t, slot, prefix, built)
        null => { }
    }
    var art = tkr_ensure_artifact(exe, regr_dir, t, prefix, built)
    var build_times = if art.fresh {
        PhaseTimes { harness_ns = art.comp.harness_ns; compile_ns = art.comp.child_ns; run_ns = 0; builds = 1 }
    } else {
        phase_zero()
    }
    if art.comp.exit != 0 {
        return TkrRowRun { outcome = regr_fail(compile_failure_message(art.comp)); built = art.built; times = build_times }
    }
    var rv = tkr_run_one_row(t, art.binp, prefix ~ ".run")
    var run_times = PhaseTimes { harness_ns = rv.harness_ns; compile_ns = 0; run_ns = rv.run_ns; builds = 0 }
    TkrRowRun { outcome = rv.outcome; built = art.built; times = phase_add(build_times, run_times) }
}

fn tkr_run_grouped_row(t: Tkr, slot: RegrGroupSlot, prefix: str, built: RegrBuilt): TkrRowRun {
    var rv = tkr_run_one_row(regr_with_entry_env(t, slot.module), slot.binp, prefix ~ ".run")
    TkrRowRun {
        outcome = rv.outcome; built = built
        times = PhaseTimes { harness_ns = rv.harness_ns; compile_ns = 0; run_ns = rv.run_ns; builds = 0 }
    }
}

fn regr_row_skip_line(scenario: str, row: u64, reason: str): str {
    $"teko: regression skip {scenario}[{row}]: {reason}"
}

fn tkr_run_scenarios(exe: str, regr_dir: str, feat: TkrFeature, prefix: str, built: RegrBuilt, groups: RegrGroups): FeatureRunResult {
    var cur = built
    var skips: u64 = 0
    var rows: []RowTiming = []
    var si: u64 = 0
    loop {
        if si >= feat.scenarios.len { break }
        var sc = feat.scenarios[si]
        if tkb_scenario_is_declarative(sc) { si = si + 1; continue }
        var specs = match tkr_expand_outline(sc) { []Tkr as xs => xs; error as e => return FeatureRunResult { outcome = regr_fail(e.message); built = cur; rows = rows } }
        var ri: u64 = 0
        loop {
            if ri >= specs.len { break }
            var rr = tkr_run_row(exe, regr_dir, specs[ri], $"{prefix}.{si}.{ri}", cur, groups)
            cur = rr.built
            rows = [..rows, RowTiming { feature = feat.name; scenario = sc.name; row = ri; skipped = rr.outcome.skipped; times = rr.times }]
            if !rr.outcome.ok && !rr.outcome.skipped {
                return FeatureRunResult { outcome = regr_fail($"{sc.name}[{ri}]: {rr.outcome.message}"); built = cur; rows = rows }
            }
            if rr.outcome.skipped { teko::io::println(regr_row_skip_line(sc.name, ri, rr.outcome.message)) }
            skips = skips + rr.outcome.skips
            ri = ri + 1
        }
        si = si + 1
    }
    FeatureRunResult { outcome = regr_add_skips(regr_pass(), skips); built = cur; rows = rows }
}

fn regr_dir_has_single_tkp(regr_dir: str): bool {
    var entries = match teko::fs::list_dir(regr_dir) { []str as e => e; error => return false }
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= entries.len { break }
        if entries[i].ends_with(".tkp") { count = count + 1 }
        i++
    }
    count == 1
}

fn tkr_compile_fail_artifact(exe: str, regr_dir: str, t: Tkr, prefix: str, built: RegrBuilt): TkrArtifact | error {
    if t.source_inline.len > 0 {
        var comp = compile_inline_source(exe, t.source_inline, with_regr_cov_env(t.env, prefix), prefix)
        return TkrArtifact { comp = comp; binp = ""; built = built; fresh = true }
    }
    if t.source_file.len > 0 {
        return tkr_standalone_artifact(exe, regr_dir ~ "/" ~ t.source_file, t, prefix, built)
    }
    match guard_no_project_build_at_root(regr_dir, t) {
        error as e => return e
        null => { }
    }
    if !regr_dir_has_single_tkp(regr_dir) || t.diagnostic.len == 0 {
        return error { message = "a compile-fail scenario with no `Given source`/`Given source inline` needs a `.tkp` project in " ~ regr_dir ~ " and a `Then diagnostic`" }
    }
    var fresh = !regr_built_serves(built, RegrBuildKind::Project)
    var nb = tkr_ensure_built(exe, regr_dir, with_regr_cov_env(t.env, prefix), prefix, built)
    TkrArtifact { comp = nb.comp; binp = nb.binp; built = nb; fresh = fresh }
}

fn tkr_run_compile_fail(exe: str, regr_dir: str, feat: TkrFeature, prefix: str, built: RegrBuilt): FeatureRunResult {
    var rows: []RowTiming = []
    var cur = built
    var si: u64 = 0
    loop {
        if si >= feat.scenarios.len { break }
        var sc = feat.scenarios[si]
        if tkb_scenario_is_declarative(sc) { si = si + 1; continue }
        var specs = match tkr_expand_outline(sc) { []Tkr as xs => xs; error as e => return compile_fail_result_at(regr_fail(e.message), rows, cur) }
        var ri: u64 = 0
        loop {
            if ri >= specs.len { break }
            var t = specs[ri]
            var row_prefix = $"{prefix}.{si}.{ri}"
            var art = match tkr_compile_fail_artifact(exe, regr_dir, t, row_prefix, cur) { TkrArtifact as a => a; error as e => return compile_fail_result_at(regr_fail($"{sc.name}[{ri}]: {e.message}"), rows, cur) }
            cur = art.built
            var comp = art.comp
            var oc = check_compile_fail(t, comp)
            var times = if art.fresh {
                PhaseTimes { harness_ns = comp.harness_ns; compile_ns = comp.child_ns; run_ns = 0; builds = 1 }
            } else {
                phase_zero()
            }
            rows = [..rows, RowTiming { feature = feat.name; scenario = sc.name; row = ri; skipped = false; times = times }]
            if !oc.ok { return compile_fail_result_at(regr_fail($"{sc.name}[{ri}]: {oc.message}"), rows, cur) }
            ri = ri + 1
        }
        si = si + 1
    }
    compile_fail_result_at(regr_pass(), rows, cur)
}

fn compile_fail_result_at(oc: RegrOutcome, rows: []RowTiming, built: RegrBuilt): FeatureRunResult {
    FeatureRunResult { outcome = oc; built = built; rows = rows }
}

fn tkr_feature_is_compile_fail(feat: TkrFeature): bool {
    if feat.scenarios.len == 0 { return false }
    match tkr_lower_scenario(feat.scenarios[0]) { Tkr as t => t.kind == TkrKind::CompileFail; error => false }
}

fn run_one_tkr(exe: str, regr_dir: str, tkr_name: str, prefix: str, groups: RegrGroups): TkrFileRun {
    var src = match teko::io::read_file(regr_dir ~ "/" ~ tkr_name) { str as s => s; error as e => return file_run_of(regr_fail(e.message), []) }
    var feats = match parse_tkr(src) { []TkrFeature as xs => xs; error as e => return file_run_of(regr_fail(e.message), []) }
    var built = RegrBuilt { done = false; kind = RegrBuildKind::None; comp = cap_synthetic(0, ""); binp = ""; srcs = [] }
    var skips: u64 = 0
    var rows: []RowTiming = []
    var fi: u64 = 0
    loop {
        if fi >= feats.len { break }
        var feat = feats[fi]
        var fr = run_one_feature(exe, regr_dir, feat, $"{prefix}.f{fi}", built, groups)
        built = fr.built
        rows = concat_row_timings(rows, fr.rows)
        if !fr.outcome.ok && !fr.outcome.skipped { return file_run_of(fr.outcome, rows) }
        skips = skips + fr.outcome.skips
        fi = fi + 1
    }
    file_run_of(regr_add_skips(regr_pass(), skips), rows)
}

type TkrFileRun = struct {
    outcome: RegrOutcome
    rows: []RowTiming
}

fn file_run_of(oc: RegrOutcome, rows: []RowTiming): TkrFileRun {
    TkrFileRun { outcome = oc; rows = rows }
}

fn run_one_feature(exe: str, regr_dir: str, feat: TkrFeature, prefix: str, built: RegrBuilt, groups: RegrGroups): FeatureRunResult {
    if tkr_feature_is_compile_fail(feat) {
        return tkr_run_compile_fail(exe, regr_dir, feat, prefix, built)
    }
    tkr_run_scenarios(exe, regr_dir, feat, prefix, built, groups)
}

fn concat_row_timings(a: []RowTiming, b: []RowTiming): []RowTiming {
    [..a, ..b]
}

fn report_regressive(rd: str, oc: RegrOutcome, rows: []RowTiming) {
    if oc.skipped {
        if oc.message.len > 0 { teko::io::println(teko::str::concat(teko::str::concat("teko: regression skip ", rd), teko::str::concat(" ", oc.message))); return }
        teko::io::println(teko::str::concat("teko: regression skip ", rd)); return
    }
    var totals = regr_totals_text(rows_total(rows))
    if oc.ok && oc.skips > 0 { teko::io::println($"teko: regression ok {rd} ({totals}; {oc.skips} scenario row(s) skipped — capability absent on this host)"); return }
    if oc.ok { teko::io::println($"teko: regression ok {rd} ({totals})"); return }
    teko::io::println($"teko: regression FAIL {rd} ({totals}) — {oc.message}")
}

fn regr_sanitize(s: str): str {
    var out = ""
    var k: u64 = 0
    loop {
        if k >= s.len { break }
        var c = s[k]
        var alnum = (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9')
        if alnum { out = out ~ s.slice(k, k + 1) } else { out = out ~ "_" }
        k = k + 1
    }
    out
}

fn regr_summary_line(files: u64, skips: u64, fails: u64): str {
    $"teko: regressions {files} run, {skips} skipped, {fails} failed"
}

fn run_regression_sources(exe: str, m: Manifest): i32 {
    var work = teko::test::scoped(REGR_WORK_DIR)
    match rm_rf(work) { error => { }; null => { } }
    match mkdir_p(teko::str::concat(work, "/")) { error => { }; null => { } }
    var groups = regr_build_groups(exe, regr_plan_groups(m, work), work)
    var fails: u64 = 0
    var skips: u64 = 0
    var phase = regr_groups_total(groups)
    var si: u64 = 0
    loop {
        if si >= m.test_regression_files.len { break }
        var path = m.test_regression_files[si]
        match teko::io::read_file(path) {
            error => {
                teko::io::println($"teko: regression FAIL {path} — listed regressor file does not exist")
                if regression_journal_enabled() { teko::journal::note_row_fail(path, "listed regressor file does not exist") }
                fails = fails + 1
                si = si + 1
            }
            str => {
                if regression_journal_enabled() { teko::journal::note_row_begin(path) }
                var fr = run_one_tkr(exe, dirname_of(path), basename_of(path), work ~ "/" ~ regr_sanitize(path), groups)
                report_regressive(path, fr.outcome, fr.rows)
                if regression_journal_enabled() { note_row_outcome(path, fr.outcome) }
                regr_print_timings(fr.rows)
                phase = phase_add(phase, rows_total(fr.rows))
                if !fr.outcome.ok && !fr.outcome.skipped { fails = fails + 1 }
                skips = skips + fr.outcome.skips
                si = si + 1
            }
        }
    }
    teko::io::println(regr_summary_line(m.test_regression_files.len, skips, fails) ~ $" ({regr_totals_text(phase)})")
    if regression_journal_enabled() { teko::journal::note_row_end() }
    if fails > 0 && m.test_gate { return 1 }
    0
}

fn regression_journal_enabled(): bool { teko::test::scope().len == 0 }

fn note_row_outcome(path: str, oc: RegrOutcome) {
    if oc.skipped { teko::journal::note_row_skip(path, oc.message); return }
    if oc.ok { teko::journal::note_row_ok(path); return }
    teko::journal::note_row_fail(path, oc.message)
}

const TEKO_IN_REGRESSION_VAR: str = "TEKO_IN_REGRESSION"

fn run_regression_phase(exe: str, m: Manifest): i32 {
    match teko::env::var(TEKO_IN_REGRESSION_VAR) { str => return 0; error => { } }
    match teko::env::set_var(TEKO_IN_REGRESSION_VAR, "1") { error => { }; null => { } }
    run_regression_sources(exe, m)
}

fn self_exe_path(): str {
    var argv = teko::env::args()
    if argv.len == 0 { return "teko" }
    var cwd = match teko::env::cwd() { str as c => c; error => "" }
    var a = abs_path_of(argv[0], cwd)
    if a.len > 0 && path_exists(a) { return a }
    argv[0]
}
