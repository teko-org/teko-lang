use teko::encoding::toml


type Backend = enum { C; Native }

pub type Manifest = struct {
    name: str
    artifact: Artifact
    abi: str
    source: str
    deps: []str
    aliases: []str
    version: str
    suffix: str
    description: str
    platforms: []str
    cov_functions: u64
    cov_lines: u64
    cov_branches: u64
    link_flags: []str
    link_lib_name: []str
    link_mode: []str
    os_lib_os: []str
    os_lib_flag: []str
    os_lib_name: []str
    os_lib_mode: []str
    cc: str
    target: str
    sysroot: str
    freestanding: bool
    test_regression_files: []str
    test_gate: bool
    test_default_targets: []str
    backend: Backend
}


fn mf_at(s: str, p: u64): byte {
    if p >= s.len { return 0 }
    s[p]
}

fn mf_is_space(c: byte): bool { c == b' ' || c == b'\t' || c == b'\r' }

fn mf_skip_spaces(s: str, p: u64): u64 {
    var q = p
    loop {
        if q >= s.len { break }
        if !mf_is_space(s[q]) { break }
        q = q + 1
    }
    q
}

fn mf_is_key_byte(c: byte): bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') ||
    c == b'_' || c == b'-' || c == b'.'
}

fn mf_key_end(s: str, p: u64): u64 {
    var q = p
    loop {
        if q >= s.len { break }
        if !mf_is_key_byte(s[q]) { break }
        q = q + 1
    }
    q
}

type MfQuoted = struct { text: str; next: u64 }
fn mf_read_quoted(s: str, p: u64): MfQuoted | error {
    if mf_at(s, p) != b'"' { return error { message = "expected a quoted string value" } }
    var start = p + 1
    var q = start
    loop {
        if q >= s.len { break }
        if s[q] == b'"' { break }
        q = q + 1
    }
    if q >= s.len { return error { message = "unterminated string value" } }
    MfQuoted { text = s.slice(start, q); next = q + 1 }
}

fn mf_read_int(s: str, p: u64): u64 {
    var q = p
    var n: u64 = 0
    loop {
        if q >= s.len { break }
        var c = s[q]
        if c < b'0' || c > b'9' { break }
        n = n * 10 + (c to u64) - (b'0' to u64)
        q = q + 1
    }
    n
}

type MfArray = struct { items: []str; next: u64 }
fn mf_read_array(s: str, p: u64): MfArray | error {
    if mf_at(s, p) != b'[' { return error { message = "expected '[' for an array value" } }
    var q = mf_skip_spaces(s, p + 1)
    var items: []str = []
    if mf_at(s, q) == b']' { return MfArray { items = items; next = q + 1 } }
    loop {
        var elem = match mf_read_quoted(s, q) { MfQuoted as x => x; error as e => return e }
        items = [..items, elem.text]
        q = mf_skip_spaces(s, elem.next)
        var c = mf_at(s, q)
        if c == b']' { return MfArray { items = items; next = q + 1 } }
        if c != b',' { return error { message = "expected ',' or ']' in an array value" } }
        q = mf_skip_spaces(s, q + 1)
    }
    error { message = "unterminated array value" }
}

fn mf_strip_lib(name: str): str {
    if name.len > 3 && name[0] == b'l' && name[1] == b'i' && name[2] == b'b' { name.slice_from(3) } else { name }
}

fn mf_starts_with(s: str, p: str): bool {
    if s.len < p.len { return false }
    s.slice_to(p.len) == p
}

fn mf_has_path(s: str): bool {
    if s.contains("/") { return true }
    s.ends_with(".a") || s.ends_with(".so") || s.ends_with(".dylib") ||
    s.ends_with(".dll") || s.ends_with(".o") || s.ends_with(".lib")
}

const LINK_MODE_STATIC: str = "static"

const LINK_MODE_SHARED: str = "shared"

const MODE_PREFIX_LEN: u64 = 7

type ExternLibSpec = struct {
    flag: str
    mode: str
}

fn mf_mode_from_ext(s: str): str {
    if s.ends_with(".a") || s.ends_with(".lib") || s.ends_with(".o") { return LINK_MODE_STATIC }
    if s.ends_with(".so") || s.ends_with(".dylib") || s.ends_with(".dll") { return LINK_MODE_SHARED }
    ""
}

fn mf_extern_spec(s: str): ExternLibSpec {
    if s.len > 0 && s[0] == b'-' { return ExternLibSpec { flag = s; mode = "" } }
    var mode = ""
    var rest = s
    if mf_starts_with(rest, "static:") { mode = LINK_MODE_STATIC; rest = rest.slice_from(MODE_PREFIX_LEN) }
    else if mf_starts_with(rest, "shared:") { mode = LINK_MODE_SHARED; rest = rest.slice_from(MODE_PREFIX_LEN) }
    if mf_has_path(rest) {
        var by_ext = if mode.len > 0 { mode } else { mf_mode_from_ext(rest) }
        return ExternLibSpec { flag = rest; mode = by_ext }
    }
    ExternLibSpec { flag = teko::str::concat("-l", mf_strip_lib(rest)); mode = mode }
}

type ExternLibsAccum = struct {
    link_flags: []str
    link_lib_name: []str
    link_mode: []str
    os_lib_os: []str
    os_lib_flag: []str
    os_lib_name: []str
    os_lib_mode: []str
}

fn parse_extern_libs_entry(accum: ExternLibsAccum, key: str, elems: []str, is_os: bool, os: str): ExternLibsAccum {
    if elems.len == 0 { return push_extern_lib_spec(accum, key, mf_extern_spec(key), is_os, os) }
    var acc = accum
    var ai = 0
    loop {
        if ai >= elems.len { break }
        acc = push_extern_lib_spec(acc, key, mf_extern_spec(elems[ai]), is_os, os)
        ai = ai + 1
    }
    acc
}

fn push_extern_lib_spec(accum: ExternLibsAccum, key: str, spec: ExternLibSpec, is_os: bool, os: str): ExternLibsAccum {
    if is_os {
        return ExternLibsAccum {
            link_flags = accum.link_flags; link_lib_name = accum.link_lib_name; link_mode = accum.link_mode
            os_lib_os = [..accum.os_lib_os, os]
            os_lib_flag = [..accum.os_lib_flag, spec.flag]
            os_lib_name = [..accum.os_lib_name, key]
            os_lib_mode = [..accum.os_lib_mode, spec.mode]
        }
    }
    ExternLibsAccum {
        link_flags = [..accum.link_flags, spec.flag]
        link_lib_name = [..accum.link_lib_name, key]
        link_mode = [..accum.link_mode, spec.mode]
        os_lib_os = accum.os_lib_os; os_lib_flag = accum.os_lib_flag; os_lib_name = accum.os_lib_name
        os_lib_mode = accum.os_lib_mode
    }
}

const HOST_TARGET: str = "host"

fn mf_read_str_list(s: str, p: u64): []str | error {
    var c = mf_at(s, p)
    if c == b'[' {
        var arr = match mf_read_array(s, p) { MfArray as a => a; error as e => return e }
        return arr.items
    }
    if c == b'"' {
        var q = match mf_read_quoted(s, p) { MfQuoted as x => x; error as e => return e }
        return [q.text]
    }
    error { message = "expected a quoted string or an array value" }
}

const ARTIFACT_KIND_BINARY: str = "binary"

const ARTIFACT_KIND_STATIC: str = "static"

const ARTIFACT_KIND_SHARED: str = "shared"

const ARTIFACT_KIND_PACKAGE: str = "package"

const ARTIFACT_KIND_TOOL: str = "tool"

type ArtifactKind = struct {
    spelling: str
    artifact: Artifact
}

fn artifact_kind_table(): []ArtifactKind {
    [
        ArtifactKind { spelling = ARTIFACT_KIND_BINARY; artifact = Artifact::Binary },
        ArtifactKind { spelling = ARTIFACT_KIND_STATIC; artifact = Artifact::Static },
        ArtifactKind { spelling = ARTIFACT_KIND_SHARED; artifact = Artifact::Shared },
        ArtifactKind { spelling = ARTIFACT_KIND_PACKAGE; artifact = Artifact::Package },
        ArtifactKind { spelling = ARTIFACT_KIND_TOOL; artifact = Artifact::Tool }
    ]
}

fn artifact_kinds_listed(): str {
    var rows = artifact_kind_table()
    var out = ""
    var i: u64 = 0
    loop {
        if i >= rows.len { break }
        if i > 0 { out = out ~ ", " }
        out = out ~ rows[i].spelling
        i = i + 1
    }
    out
}

fn artifact_from_kind(spelling: str): Artifact | error {
    var rows = artifact_kind_table()
    var i: u64 = 0
    loop {
        if i >= rows.len { break }
        if rows[i].spelling == spelling { return rows[i].artifact }
        i = i + 1
    }
    error { message = "unknown [artifact] kind \"" ~ spelling ~ "\" — accepted kinds: " ~ artifact_kinds_listed() }
}

fn mf2_str(t: toml::TomlValue, key: str, default: str): str {
    match toml::toml_get(t, key) {
        toml::TomlValue as v => if v.kind == toml::TomlKind::String { v.text } else { default }
        null => default
    }
}

fn mf2_bool(t: toml::TomlValue, key: str, default: bool): bool {
    match toml::toml_get(t, key) {
        toml::TomlValue as v => if v.kind == toml::TomlKind::Boolean { v.bool_val } else { default }
        null => default
    }
}

fn mf2_u64(t: toml::TomlValue, key: str, default: u64): u64 {
    match toml::toml_get(t, key) {
        toml::TomlValue as v => if v.kind == toml::TomlKind::Integer && v.int_val >= 0 { v.int_val to u64 } else { default }
        null => default
    }
}

fn mf2_table(t: toml::TomlValue, key: str): toml::TomlValue {
    match toml::toml_get(t, key) {
        toml::TomlValue as v => if v.kind == toml::TomlKind::Table { v } else { toml::toml_table_empty() }
        null => toml::toml_table_empty()
    }
}

fn mf2_value_to_str_list(v: toml::TomlValue): []str {
    if v.kind == toml::TomlKind::String { return [v.text] }
    if v.kind != toml::TomlKind::Array { return [] }
    var out: []str = []
    var i: u64 = 0
    loop {
        if i >= v.items.len { break }
        if v.items[i].kind == toml::TomlKind::String { out = [..out, v.items[i].text] }
        i++
    }
    out
}

fn mf2_str_list(t: toml::TomlValue, key: str): []str {
    match toml::toml_get(t, key) {
        toml::TomlValue as v => mf2_value_to_str_list(v)
        null => []
    }
}

fn mf2_fold_libs_table(accum: ExternLibsAccum, libs: toml::TomlValue, is_os: bool, os: str): ExternLibsAccum {
    var acc = accum
    var i: u64 = 0
    loop {
        if i >= libs.keys.len { break }
        var key = libs.keys[i]
        var val = libs.vals[i]
        if val.kind == toml::TomlKind::Array {
            acc = parse_extern_libs_entry(acc, key, mf2_value_to_str_list(val), is_os, os)
        } else if val.kind == toml::TomlKind::Table {
            acc = mf2_fold_libs_table(acc, val, true, key)
        }
        i++
    }
    acc
}

fn parse_manifest(src: str): Manifest | error {
    var root = match toml::parse_toml(src) { toml::TomlValue as t => t; error as e => return e }

    var name = ""
    var have_name = false
    match toml::toml_get(root, "name") {
        toml::TomlValue as v => { have_name = true; if v.kind == toml::TomlKind::String { name = v.text } }
        null => { }
    }
    var source = ""
    var have_source = false
    match toml::toml_get(root, "source") {
        toml::TomlValue as v => { have_source = true; if v.kind == toml::TomlKind::String { source = v.text } }
        null => { }
    }
    if !have_name { return error { message = "manifest missing required field 'name'" } }
    if !have_source { return error { message = "manifest missing required field 'source'" } }

    var version = mf2_str(root, "version", "")
    var suffix = mf2_str(root, "suffix", "")
    var description = mf2_str(root, "description", "")

    var artifact_table = mf2_table(root, "artifact")
    var artifact = Artifact::Binary
    match toml::toml_get(artifact_table, "kind") {
        toml::TomlValue as v => {
            var spelling = if v.kind == toml::TomlKind::String { v.text } else { "" }
            artifact = match artifact_from_kind(spelling) { Artifact as a => a; error as e => return e }
        }
        null => { }
    }
    var abi_raw = mf2_str(artifact_table, "abi", "")
    var abi = if abi_raw == "c" { "c" } else { "" }

    var deps = mf2_table(root, "dependencies").keys
    var aliases = mf2_table(root, "aliases").keys
    var platforms = mf2_str_list(mf2_table(root, "platforms"), "targets")

    var coverage_table = mf2_table(root, "coverage")
    var cov_functions = mf2_u64(coverage_table, "functions", 80)
    var cov_lines = mf2_u64(coverage_table, "lines", 80)
    var cov_branches = mf2_u64(coverage_table, "branches", 80)

    var tests_table = mf2_table(root, "tests")
    var test_regression_files = mf2_str_list(tests_table, "regression")
    var test_gate = mf2_bool(tests_table, "gate", true)
    var test_default_targets = match toml::toml_get(tests_table, "targets") {
        toml::TomlValue as v => mf2_value_to_str_list(v)
        null => [HOST_TARGET]
    }

    var extern_table = mf2_table(root, "extern")
    var cc = mf2_str(extern_table, "cc", "")
    var target = mf2_str(extern_table, "target", "")
    var sysroot = mf2_str(extern_table, "sysroot", "")
    var freestanding = mf2_bool(extern_table, "freestanding", false)

    var libs_table = mf2_table(extern_table, "libs")
    var empty_accum = ExternLibsAccum { link_flags = []; link_lib_name = []; link_mode = []; os_lib_os = []; os_lib_flag = []; os_lib_name = []; os_lib_mode = [] }
    var libs_accum = mf2_fold_libs_table(empty_accum, libs_table, false, "")

    Manifest { name = name; artifact = artifact; abi = abi; source = source; deps = deps; aliases = aliases; version = version; suffix = suffix; description = description; platforms = platforms; cov_functions = cov_functions; cov_lines = cov_lines; cov_branches = cov_branches; link_flags = libs_accum.link_flags; link_lib_name = libs_accum.link_lib_name; link_mode = libs_accum.link_mode; os_lib_os = libs_accum.os_lib_os; os_lib_flag = libs_accum.os_lib_flag; os_lib_name = libs_accum.os_lib_name; os_lib_mode = libs_accum.os_lib_mode; cc = cc; target = target; sysroot = sysroot; freestanding = freestanding; test_regression_files = test_regression_files; test_gate = test_gate; test_default_targets = test_default_targets; backend = Backend::C }
}

fn with_backend(m: Manifest, b: Backend): Manifest {
    Manifest { name = m.name; artifact = m.artifact; abi = m.abi; source = m.source; deps = m.deps; aliases = m.aliases; version = m.version; suffix = m.suffix; description = m.description; platforms = m.platforms; cov_functions = m.cov_functions; cov_lines = m.cov_lines; cov_branches = m.cov_branches; link_flags = m.link_flags; link_lib_name = m.link_lib_name; link_mode = m.link_mode; os_lib_os = m.os_lib_os; os_lib_flag = m.os_lib_flag; os_lib_name = m.os_lib_name; os_lib_mode = m.os_lib_mode; cc = m.cc; target = m.target; sysroot = m.sysroot; freestanding = m.freestanding; test_regression_files = m.test_regression_files; test_gate = m.test_gate; test_default_targets = m.test_default_targets; backend = b }
}
