use teko::parser
use teko::checker

fn name_in(set: []str, name: str): bool {
    var i: u64 = 0
    loop {
        if i >= set.len { break }
        if set[i] == name { return true }
        i++
    }
    false
}

type NameSet = struct { buf: []str; count: u64 }

fn ns_of(cap: u64): NameSet {
    var buf: [cap]str = []
    NameSet { buf = buf; count = 0 }
}

fn ns_has(set: NameSet, name: str): bool {
    var i: u64 = 0
    loop {
        if i >= set.count { break }
        if set.buf[i] == name { return true }
        i++
    }
    false
}

fn ns_add(set: NameSet, name: str): NameSet {
    if ns_has(set, name) { return set }
    var b = set.buf
    b[set.count] = name
    NameSet { buf = b; count = set.count + 1 }
}

fn ns_to_names(set: NameSet): []str {
    var out: [set.count]str = []
    var i: u64 = 0
    loop {
        if i >= set.count { break }
        out[i] = set.buf[i]
        i++
    }
    out
}

fn collect_expr(e: checker::TExpr, out: NameSet): NameSet {
    match e.kind {
        checker::TVar as v => if v.is_func { ns_add(out, v.name) } else { out }
        checker::TBinary as b => collect_expr(b.right, collect_expr(b.left, out))
        checker::TUnary as u => collect_expr(u.operand, out)
        checker::TCompare as c => {
            var acc = collect_expr(c.first, out)
            var i = 0
            loop {
                if i >= c.rest.len { break }
                acc = collect_expr(c.rest[i].operand, acc)
                i++
            }
            acc
        }
        checker::TCall as call => {
            var acc = ns_add(out, call.callee.segments[call.callee.segments.len - 1].name)
            var i = 0
            loop {
                if i >= call.args.len { break }
                acc = collect_expr(call.args[i], acc)
                i++
            }
            acc
        }
        checker::TIfExpr as f => {
            var acc = collect_expr(f.cond, out)
            acc = collect_block(f.then_blk, acc)
            if f.has_else { acc = collect_block(f.else_blk, acc) }
            acc
        }
        checker::TMatchExpr as m => {
            var acc = collect_expr(m.subject, out)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                var a = m.arms[i]
                if a.has_when { acc = collect_expr(a.guard, acc) }
                acc = collect_block(a.body, acc)
                i++
            }
            acc
        }
        checker::TCast as cst => collect_expr(cst.expr, out)
        checker::TFieldAccess as fa => collect_expr(fa.receiver, out)
        checker::TStructInit as si => {
            var acc = out
            var i = 0
            loop {
                if i >= si.field_vals.len { break }
                acc = collect_expr(si.field_vals[i], acc)
                i++
            }
            acc
        }
        checker::TIndex as ix => collect_expr(ix.index, collect_expr(ix.receiver, out))
        checker::TInterp as it => {
            var acc = out
            var i = 0
            loop {
                if i >= it.holes.len { break }
                acc = collect_expr(it.holes[i], acc)
                if i < it.specs.len { acc = collect_fspec(it.specs[i].kind, acc) }
                i++
            }
            acc
        }
        checker::TInExpr as ie => {
            var acc = collect_expr(ie.lhs, out)
            var i = 0
            loop {
                if i >= ie.elems.len { break }
                acc = collect_expr(ie.elems[i], acc)
                i++
            }
            acc
        }
        checker::TLambda as lam => collect_block(lam.body, out)
        checker::TBlockExpr as b => collect_block(b.body, out)
        checker::TArrayLit as al => {
            var acc = out
            var i = 0
            loop { if i >= al.elements.len { break }; acc = collect_expr(al.elements[i].expr, acc); i++ }
            acc
        }
        _ => out
    }
}

fn collect_fspec(kind: @TFSpecKind(), out: NameSet): NameSet {
    match kind {
        checker::TFSpecDynamic as fd => {
            var acc = out
            var k = 0
            loop { if k >= fd.args.len { break }; acc = collect_expr(fd.args[k], acc); k++ }
            acc
        }
        _ => out
    }
}

fn collect_stmt(s: @TStatement(), out: NameSet): NameSet {
    match s {
        checker::TBinding as b => collect_expr(b.value, out)
        checker::TAssign as a => {
            var with_target = if parser::assign_has_target(a.kind) { collect_expr(a.target, out) } else { out }
            collect_expr(a.value, with_target)
        }
        checker::TReturn as r => if r.has_value { collect_expr(r.value, out) } else { out }
        checker::TLoopStmt as l => collect_block(l.body, collect_block(l.init, out))
        checker::TExprStmt as es => collect_expr(es.expr, out)
        checker::TDeferStmt as d => collect_block(d.body, out)
        checker::TAdoptStmt as a => collect_block(a.body, out)
        checker::TBlockStmt as b => collect_block(b.body, out)
        _ => out
    }
}

fn collect_block(stmts: []@TStatement(), out: NameSet): NameSet {
    var acc = out
    var i = 0
    loop {
        if i >= stmts.len { break }
        acc = collect_stmt(stmts[i], acc)
        i++
    }
    acc
}

fn entry_roots(prog: checker::TProgram, names0: NameSet): NameSet {
    var names = names0
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            (@TStatement()) as s => { names = collect_stmt(s, names) }
            checker::TFunction as f => { if f.vis == parser::Visibility::Exp { names = ns_add(names, f.name) } }
            _ => { }
        }
        i++
    }
    names
}

fn close_reachable(prog: checker::TProgram, names: NameSet): NameSet {
    var acc = names
    loop {
        var grown = grow_reachable_pass(prog, acc)
        if grown.count == acc.count { return acc }
        acc = grown
    }
    acc
}

fn grow_reachable_pass(prog: checker::TProgram, acc: NameSet): NameSet {
    var grown = acc
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { if ns_has(acc, f.name) { grown = collect_block(f.body, grown) } }
            _ => { }
        }
        i++
    }
    grown
}

fn reachable_libs(prog: checker::TProgram): []str {
    var cap = prog.items.len + (512 to u64)
    var closure = close_reachable(prog, entry_roots(prog, ns_of(cap)))
    var libs = ns_of(cap)
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.is_extern && f.from_lib.len > 0 && ns_has(closure, f.name) { libs = ns_add(libs, f.from_lib) }
            }
            _ => { }
        }
        i++
    }
    ns_to_names(libs)
}
