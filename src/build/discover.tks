
pub type SourceFile = struct {
    path: str
    namespace: str
    content: str
}

fn dsc_is_teko_source(name: str): bool {
    name.ends_with(".tks") || name.ends_with(".tkt")
}

fn dsc_append(a: []SourceFile, b: []SourceFile): []SourceFile {
    var out = a
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        out = [..out, b[i]]
        i = i + 1
    }
    out
}

fn dsc_walk(dir: str, ns: str): []SourceFile | error {
    var entries = match teko::fs::list_dir(dir) {
        []str as e => e
        error => return error { message = teko::str::concat("discover: cannot open source directory: ", dir) }
    }
    var out: []SourceFile = []
    var i: u64 = 0
    loop {
        if i >= entries.len { break }
        var nm = entries[i]
        var child = teko::str::concat(dir, "/", nm)
        match teko::fs::list_dir(child) {
            []str as _ => {
                var cns = teko::str::concat(ns, "::", nm)
                var sub = match dsc_walk(child, cns) { []SourceFile as s => s; error as e => return e }
                out = dsc_append(out, sub)
            }
            error => {
                if dsc_is_teko_source(nm) {
                    out = [..out, SourceFile { path = child; namespace = ns; content = "" }]
                }
            }
        }
        i = i + 1
    }
    out
}

fn discover(name: str, source: str): []SourceFile | error {
    dsc_walk(source, name)
}
