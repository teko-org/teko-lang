fn is_backend_flag(a: str): bool {
    if a == "--backend" { return true }
    a.len > 10 && a.slice_to(10) == "--backend="
}

fn has_backend_flag(args: []str, start: u64): bool {
    var i = start
    loop {
        if i >= args.len { break }
        if is_backend_flag(args[i]) { return true }
        i = i + 1
    }
    false
}

fn project_arg_of(args: []str, start: u64): str {
    var i = start
    loop {
        if i >= args.len { break }
        if args[i] == "-o" { i = i + 2 }
        else if args[i] == "--no-test" { i = i + 1 }
        else if args[i] == "--no-verify" { i = i + 1 }
        else if args[i] == "--cov-validation" { i = i + 1 }
        else if args[i] == "--per-test-cov" { i = i + 1 }
        else if args[i] == "--per-commit-test" { i = i + 2 }
        else if args[i] == "--native-gate" { i = i + 1 }
        else if args[i] == "--release" { i = i + 1 }
        else if args[i] == "--explicit" { i = i + 1 }
        else if args[i] == "--no-tty" { i = i + 1 }
        else if args[i] == "--analyzer" { i = i + 1 }
        else if args[i] == "--arith-cast-gate" { i = i + 1 }
        else if args[i] == ALLOW_UNDEF_FLAG { i = i + 1 }
        else if args[i] == REGR_TIMINGS_FLAG { i = i + 1 }
        else if opt_arg_has_prefix(args[i]) { i = i + 1 }
        else if debug_arg_has_prefix(args[i]) { i = i + 1 }
        else { return args[i] }
    }
    ""
}

fn build_debug_binary(dir: str, stem: str, out_dir: str, prog: checker::TProgram, m: Manifest): i32 {
    match validate_extern_libs_for_target(m) { error as e => return fail(dir, e.message); null => { } }
    if m.backend == Backend::Native {
        return emit_native(dir, stem, out_dir, prog, m, DebugInfo::None)
    }
    var od = strip_trailing_slash(out_dir)
    var cfile = teko::str::concat(od, "/", teko::str::concat(stem, ".c"))
    var binp = binary_output_path(od, stem, resolved_target())
    match codegen::tk_emit_c_file(prog, cfile, codegen::tk_emit_meta(m.name, m.version, m.suffix, m.description)) { u64 => { }; error as e => return fail(dir, e.message) }
    if run_cc_debug(cfile, binp, m, prog) != 0 {
        return fail(dir, "cc failed to build the generated C")
    }
    match teko::io::write_file(teko::str::concat(binp, ".tsym"), codegen::tk_emit_tsym(prog)) { error => { }; null => { } }
    teko::io::println(teko::str::concat("teko: ", dir, teko::str::concat(": built ", binp, "")))
    0
}

fn build_debug_and_report(dir: str, stem: str, out_dir: str, prog: checker::TProgram, m: Manifest): i32 {
    match mkdir_p(strip_trailing_slash(out_dir)) { error => return fail(dir, "cannot create the output directory"); null => { } }
    var rc = build_debug_binary(dir, stem, out_dir, prog, m)
    if rc == 0 { report_peak() }
    rc
}

const DEBUG_SCRATCH_DIR: str = "target/debug"

fn run_project(dir: str, backend: Backend): i32 {
    ensure_rt_dir_abs()
    var fe = match project_frontend(dir) { Frontend as x => x; error as e => return fail(dir, e.message) }
    var stem = fe.manifest.name
    var bc = build_debug_and_report(dir, stem, DEBUG_SCRATCH_DIR, fe.prog, with_backend(fe.manifest, backend))
    if bc != 0 { return bc }
    var cross = resolved_cross_note()
    if cross.is_cross { teko::io::println(cross.note); return 0 }
    var binp = binary_output_path(DEBUG_SCRATCH_DIR, stem, resolved_target())
    var argv = [binp]
    teko::process::run(argv)
}

const TKCOV_MAGIC_LEN: u64 = 8

const TKCOV_SECTIONS: u64 = 3

const REDUNDANT_MIN: u64 = 2

type Verdict = enum { Stale; Redundant; Live }

type Status = enum { Misleading; Foundational; Dead; Redundant; Live }

type TestRecord = struct {
    label: str
    ids: []u64
    asserts_total: u64
    asserts_folded: u64
}

fn verdict_text(v: Verdict): str {
    match v {
        Verdict::Stale => "STALE"
        Verdict::Redundant => "REDUNDANT"
        Verdict::Live => "LIVE"
    }
}

fn status_text(s: Status): str {
    match s {
        Status::Misleading => "MISLEADING"
        Status::Foundational => "FOUNDATIONAL"
        Status::Dead => "DEAD"
        Status::Redundant => "REDUNDANT"
        Status::Live => "LIVE"
    }
}

fn combined_status(cov: Verdict, total: u64, folded: u64): Status {
    var covers = cov != Verdict::Stale
    var has_folded = folded >= 1
    var all_folded = total >= 1 && folded == total
    if has_folded && covers { return Status::Misleading }
    if all_folded { return Status::Foundational }
    if !covers { return Status::Dead }
    match cov {
        Verdict::Redundant => Status::Redundant
        _ => Status::Live
    }
}

fn read_u64_le(data: str, off: u64): u64 {
    var v: u64 = 0
    var i: u64 = 0
    loop {
        if i >= TKCOV_MAGIC_LEN { break }
        var at = off + i
        if at < data.len { v = v | ((data[at] to u64) << (i * TKCOV_MAGIC_LEN)) }
        i++
    }
    v
}

fn tkcov_magic_ok(data: str): bool {
    if data.len < TKCOV_MAGIC_LEN { return false }
    var ascii = "TKCOV1"
    var i: u64 = 0
    loop {
        if i >= ascii.len { break }
        if data[i] != ascii[i] { return false }
        i++
    }
    if (data[6] to u64) != 0 { return false }
    if (data[7] to u64) != 0 { return false }
    true
}

fn ids_contains(ids: []u64, id: u64): bool {
    var i: u64 = 0
    loop {
        if i >= ids.len { break }
        if ids[i] == id { return true }
        i++
    }
    false
}

fn dedup_ids(ids: []u64): []u64 {
    var out: []u64 = []
    var i: u64 = 0
    loop {
        if i >= ids.len { break }
        if !ids_contains(out, ids[i]) { out = [..out, ids[i]] }
        i++
    }
    out
}

fn tkcov_ids(data: str): []u64 {
    if !tkcov_magic_ok(data) { return [] }
    var acc: []u64 = []
    var off: u64 = TKCOV_MAGIC_LEN
    var s: u64 = 0
    loop {
        if s >= TKCOV_SECTIONS { break }
        if off + TKCOV_MAGIC_LEN > data.len { break }
        var n = read_u64_le(data, off)
        off = off + TKCOV_MAGIC_LEN
        var k: u64 = 0
        loop {
            if k >= n { break }
            if off + TKCOV_MAGIC_LEN > data.len { break }
            acc = [..acc, read_u64_le(data, off)]
            off = off + TKCOV_MAGIC_LEN
            k++
        }
        s++
    }
    dedup_ids(acc)
}

fn concat_ids(a: []u64, b: []u64): []u64 {
    var out = a
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        out = [..out, b[i]]
        i++
    }
    out
}

fn all_ids_of(recs: []TestRecord): []u64 {
    var acc: []u64 = []
    var i: u64 = 0
    loop {
        if i >= recs.len { break }
        acc = concat_ids(acc, recs[i].ids)
        i++
    }
    acc
}

fn count_of(all_ids: []u64, id: u64): u64 {
    var c: u64 = 0
    var i: u64 = 0
    loop {
        if i >= all_ids.len { break }
        if all_ids[i] == id { c = c + 1 }
        i++
    }
    c
}

fn classify_test(ids: []u64, all_ids: []u64): Verdict {
    if ids.len == 0 { return Verdict::Stale }
    var i: u64 = 0
    loop {
        if i >= ids.len { break }
        if count_of(all_ids, ids[i]) < REDUNDANT_MIN { return Verdict::Live }
        i++
    }
    Verdict::Redundant
}

fn analyzer_header_line(): str { "teko: test analyzer (dev-time; ADVISORY — removal is manual)" }

fn analyzer_caveat_line(): str { "teko: caveat — a REDUNDANT test may still be a sole localizer (diagnostic value); a human decides" }

fn analyzer_fold_line(): str { "teko: note — MISLEADING = assertion folded-to-constant yet covers production (invisible to coverage); FOUNDATIONAL = tests the foundation (e.g. 1+1)" }

fn analyzer_line(label: str, n: u64, total: u64, folded: u64, s: Status): str {
    var st = status_text(s)
    $"analyzer {label} ids={n} asserts={total}/{folded} status={st}"
}

type StatusTally = struct {
    misleading: u64
    foundational: u64
    dead: u64
    redundant: u64
    live: u64
}

fn tally_empty(): StatusTally { StatusTally { misleading = 0; foundational = 0; dead = 0; redundant = 0; live = 0 } }

fn tally_add(t: StatusTally, s: Status): StatusTally {
    match s {
        Status::Misleading => StatusTally { misleading = t.misleading + 1; foundational = t.foundational; dead = t.dead; redundant = t.redundant; live = t.live }
        Status::Foundational => StatusTally { misleading = t.misleading; foundational = t.foundational + 1; dead = t.dead; redundant = t.redundant; live = t.live }
        Status::Dead => StatusTally { misleading = t.misleading; foundational = t.foundational; dead = t.dead + 1; redundant = t.redundant; live = t.live }
        Status::Redundant => StatusTally { misleading = t.misleading; foundational = t.foundational; dead = t.dead; redundant = t.redundant + 1; live = t.live }
        Status::Live => StatusTally { misleading = t.misleading; foundational = t.foundational; dead = t.dead; redundant = t.redundant; live = t.live + 1 }
    }
}

fn analyzer_summary_line(t: StatusTally): str {
    var total = t.misleading + t.foundational + t.dead + t.redundant + t.live
    $"analyzer: {t.misleading} MISLEADING, {t.foundational} FOUNDATIONAL, {t.dead} DEAD, {t.redundant} REDUNDANT, {t.live} LIVE (total {total})"
}

fn analyzer_report(recs: []TestRecord): str {
    var all = all_ids_of(recs)
    var out = teko::str::concat(analyzer_header_line(), "\n", analyzer_caveat_line(), "\n", analyzer_fold_line(), "\n")
    var tally = tally_empty()
    var i: u64 = 0
    loop {
        if i >= recs.len { break }
        var r = recs[i]
        var cov = classify_test(r.ids, all)
        var s = combined_status(cov, r.asserts_total, r.asserts_folded)
        out = teko::str::concat(out, analyzer_line(r.label, r.ids.len, r.asserts_total, r.asserts_folded, s), "\n")
        tally = tally_add(tally, s)
        i++
    }
    teko::str::concat(out, analyzer_summary_line(tally), "\n")
}

fn analyze_records_of(prog: checker::TProgram, adir: str): []TestRecord {
    var recs: []TestRecord = []
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.is_test {
                    var path = $"{adir}/{i}.tkcov"
                    var data = match teko::io::read_file(path) { str as s => s; error => "" }
                    var stats = checker::test_assert_stats(f)
                    recs = [..recs, TestRecord { label = test_label(f); ids = tkcov_ids(data); asserts_total = stats.total; asserts_folded = stats.folded }]
                }
            }
            _ => { }
        }
        i++
    }
    recs
}

fn run_analyzer(dir: str, fe: Frontend): i32 {
    var od = strip_trailing_slash("bin")
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the analyzer output directory"); null => { } }
    var stem = teko::str::concat(fe.manifest.name, "-tkanalyze")
    var cfile = teko::str::concat(od, "/", stem, ".c")
    var binp = binary_output_path(od, stem, resolved_target())
    match codegen::tk_emit_c_test_analyze_file(fe.prog, cfile, codegen::tk_emit_meta(fe.manifest.name, fe.manifest.version, fe.manifest.suffix, fe.manifest.description)) { u64 => { }; error as e => return fail(dir, e.message) }
    if run_cc(cfile, binp, fe.manifest, fe.prog, 0) != 0 { return fail(dir, "cc failed to build the analyzer test gate") }
    var adir = teko::str::concat(od, "/analyze")
    match teko::fs::mkdir(adir) { error => return fail(dir, "cannot create the analyzer scratch directory"); null => { } }
    match teko::env::set_var("TEKO_ANALYZE_DIR", adir) { error => { }; null => { } }
    var arc = teko::process::run([binp])
    if arc != 0 { return arc }
    teko::io::print(analyzer_report(analyze_records_of(fe.prog, adir)))
    0
}

fn arith_cast_rate_line(r: checker::ArithCastRateReport): str {
    var pct = checker::arith_cast_rate_pct(r)
    var ceiling = checker::ARITH_CAST_RATE_CEILING
    $"teko: arith-cast-rate: {r.with_conversion}/{r.total} ({pct:F2}%), ceiling <={ceiling:F2}%"
}

fn run_arith_cast_gate(dir: str, fe: Frontend): i32 {
    arith_cast_verdict(report_arith_cast_rate(fe))
}

fn report_arith_cast_rate(fe: Frontend): checker::ArithCastRateReport {
    var r = checker::arith_cast_rate_report(fe.prog)
    teko::io::println(arith_cast_rate_line(r))
    r
}

fn arith_cast_verdict(r: checker::ArithCastRateReport): i32 {
    if checker::arith_cast_rate_gate_ok(r) { return 0 }
    var ceiling = checker::ARITH_CAST_RATE_CEILING
    teko::io::eprintln($"teko: arith-cast-rate gate FAILED — the D4 ceiling (<={ceiling:F2}%) was exceeded")
    1
}

type PerTestCoverage = struct {
    label: str
    functions: u64
    lines: u64
    branches: u64
}

fn test_label(f: checker::TFunction): str {
    if f.namespace.len != 0 { teko::str::concat(f.namespace, "::", f.name) } else { f.name }
}

fn per_test_cov_row_str(r: PerTestCoverage): str {
    $"per-test-cov {r.label} functions={r.functions}% lines={r.lines}% branches={r.branches}%"
}

fn per_test_cov_report_str(rows: []PerTestCoverage): str {
    var out = teko::str::concat("teko: per-test coverage attribution", "\n")
    var i: u64 = 0
    loop {
        if i >= rows.len { break }
        out = teko::str::concat(out, per_test_cov_row_str(rows[i]), "\n")
        i = i + 1
    }
    out
}

fn keep_single_test(prog: checker::TProgram, keep_idx: u64): checker::TProgram {
    var kept: [prog.items.len]@TItem() = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        var drop = false
        match prog.items[i] {
            checker::TFunction as f => { if f.is_test && i != keep_idx { drop = true } }
            _ => { }
        }
        if !drop { kept[count] = prog.items[i]; count = count + 1 }
        i = i + 1
    }
    var trimmed: [count]@TItem() = []
    var k: u64 = 0
    loop { if k >= count { break }; trimmed[k] = kept[k]; k++ }
    checker::TProgram { items = trimmed }
}

fn run_one_test_cov(dir: str, out_dir: str, filtered: checker::TProgram, m: Manifest, stem: str): i32 {
    var od = strip_trailing_slash(out_dir)
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    var cfile = teko::str::concat(od, "/", stem, ".c")
    var binp = binary_output_path(od, stem, resolved_target())
    var covfile = teko::str::concat(od, "/", stem, ".tkcov")
    match codegen::tk_emit_c_test_file(filtered, true, cfile, codegen::tk_emit_meta(m.name, m.version, m.suffix, m.description)) { u64 => { }; error as e => return fail(dir, e.message) }
    if run_cc(cfile, binp, m, filtered, 0) != 0 { return fail(dir, "cc failed to build the per-test coverage gate") }
    match teko::env::set_var("TEKO_TKCOV", covfile) { error => { }; null => { } }
    var argv = [binp]
    var trc = teko::process::run(argv)
    if trc != 0 { return trc }
    teko::cov_reset()
    teko::cov_branch_reset()
    teko::cov_line_reset()
    coverage::cov_merge(covfile)
    0
}

fn run_per_test_cov(dir: str, fe: Frontend): i32 {
    var rows: []PerTestCoverage = []
    var i: u64 = 0
    loop {
        if i >= fe.prog.items.len { break }
        match fe.prog.items[i] {
            checker::TFunction as f => {
                if f.is_test {
                    var filtered = keep_single_test(fe.prog, i)
                    var rc = run_one_test_cov(dir, "bin", filtered, fe.manifest, teko::str::concat(fe.manifest.name, "-pertest"))
                    if rc != 0 { return rc }
                    rows = [..rows, PerTestCoverage { label = test_label(f); functions = coverage::coverage_pct(filtered); lines = coverage::line_coverage_pct(filtered); branches = coverage::branch_coverage_pct(filtered) }]
                }
            }
            _ => { }
        }
        i = i + 1
    }
    teko::io::print(per_test_cov_report_str(rows))
    0
}

type ChangedFile = struct {
    path: str
    lines: []u32
}

type ChangedLines = struct {
    files: []ChangedFile
}

type CovLine = struct {
    file: str
    line: u32
    hit: bool
}

type DeltaCoverage = struct {
    cov: u64
    val: u64
}

fn per_commit_base_of(args: []str): str {
    var i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == "--per-commit-test" {
            if i + 1 < args.len { return args[i + 1] }
            return ""
        }
        i = i + 1
    }
    ""
}

fn bp_prefix(s: str, p: str): bool {
    if s.len < p.len { return false }
    var i: u64 = 0
    loop {
        if i >= p.len { break }
        if s[i] != p[i] { return false }
        i = i + 1
    }
    true
}

fn bp_lines(text: str): []str {
    var out: []str = []
    var start: u64 = 0
    var i: u64 = 0
    loop {
        if i >= text.len { break }
        if text[i] == b'\n' {
            out = [..out, text.slice(start, i)]
            start = i + 1
        }
        i = i + 1
    }
    if start < text.len { out = [..out, text.slice_from(start)] }
    out
}

fn bp_find(s: str, needle: str): i64 {
    if needle.len == 0 { return 0 }
    if s.len < needle.len { return -1 }
    var i: u64 = 0
    var last = s.len - needle.len
    loop {
        if i > last { break }
        if bp_prefix(s.slice_from(i), needle) { return i to i64 }
        i = i + 1
    }
    -1
}

fn bp_parse_uint(s: str): u64 {
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i >= s.len { break }
        var c = s[i]
        if c < b'0' || c > b'9' { break }
        n = n * 10 + (c to u64) - (b'0' to u64)
        i = i + 1
    }
    n
}

fn bp_hunk_newstart(line: str): u32 {
    var i: u64 = 0
    loop {
        if i >= line.len { break }
        if line[i] == b'+' { return bp_parse_uint(line.slice_from(i + 1)) to u32 }
        i = i + 1
    }
    0
}

fn bp_plusfile(line: str): str {
    var rest = line.slice_from(4)
    if rest == "/dev/null" { return "" }
    if bp_prefix(rest, "b/") { return rest.slice_from(2) }
    rest
}

fn cl_flush(files: []ChangedFile, path: str, lines: []u32): []ChangedFile {
    if lines.len == 0 { return files }
    if !path.ends_with(".tks") { return files }
    [..files, ChangedFile { path = path; lines = lines }]
}

fn changed_line_set(diff: str): ChangedLines {
    var files: []ChangedFile = []
    var cur_file: str = ""
    var cur_lines: []u32 = []
    var newno: u32 = 0
    var lines = bp_lines(diff)
    var i: u64 = 0
    loop {
        if i >= lines.len { break }
        var ln = lines[i]
        if bp_prefix(ln, "+++ ") {
            files = cl_flush(files, cur_file, cur_lines)
            cur_file = bp_plusfile(ln)
            cur_lines = []
        } else if bp_prefix(ln, "@@ ") {
            newno = bp_hunk_newstart(ln)
        } else if bp_prefix(ln, "+") && !bp_prefix(ln, "+++") {
            cur_lines = [..cur_lines, newno]
            newno = newno + 1
        } else if bp_prefix(ln, " ") {
            newno = newno + 1
        }
        i = i + 1
    }
    files = cl_flush(files, cur_file, cur_lines)
    ChangedLines { files = files }
}

fn path_tail_match(a: str, b: str): bool {
    if a == b { return true }
    if a.ends_with(teko::str::concat("/", b)) { return true }
    if b.ends_with(teko::str::concat("/", a)) { return true }
    false
}

fn changed_contains(cls: ChangedLines, file: str, line: u32): bool {
    var i: u64 = 0
    loop {
        if i >= cls.files.len { break }
        if path_tail_match(cls.files[i].path, file) {
            var j: u64 = 0
            loop {
                if j >= cls.files[i].lines.len { break }
                if cls.files[i].lines[j] == line { return true }
                j = j + 1
            }
        }
        i = i + 1
    }
    false
}

fn xml_attr(s: str, key: str): str {
    var at = bp_find(s, key)
    if at < 0 { return "" }
    var start = (at to u64) + key.len
    var j = start
    loop {
        if j >= s.len { break }
        if s[j] == b'\'' { break }
        j = j + 1
    }
    s.slice(start, j)
}

fn cov_lines_from_cobertura(xml: str): []CovLine {
    var out: []CovLine = []
    var cur_file: str = ""
    var lines = bp_lines(xml)
    var i: u64 = 0
    loop {
        if i >= lines.len { break }
        var ln = lines[i]
        if ln.contains("<class ") {
            cur_file = xml_attr(ln, "filename='")
        } else if ln.contains("<line number='") && !ln.contains("<methods>") {
            var num = bp_parse_uint(xml_attr(ln, "number='")) to u32
            var hits = bp_parse_uint(xml_attr(ln, "hits='"))
            out = [..out, CovLine { file = cur_file; line = num; hit = hits > 0 }]
        }
        i = i + 1
    }
    out
}

fn delta_line_coverage(covlines: []CovLine, cls: ChangedLines): DeltaCoverage {
    var cov: u64 = 0
    var val: u64 = 0
    var i: u64 = 0
    loop {
        if i >= covlines.len { break }
        if changed_contains(cls, covlines[i].file, covlines[i].line) {
            val = val + 1
            if covlines[i].hit { cov = cov + 1 }
        }
        i = i + 1
    }
    DeltaCoverage { cov = cov; val = val }
}

fn delta_pct(d: DeltaCoverage): u64 { if d.val == 0 { 100 } else { d.cov * 100 / d.val } }

fn delta_floor_blocks(pct: u64, floor: u64, cov_validation: bool): bool {
    cov_validation && pct < floor
}

fn per_commit_report_str(base_rev: str, d: DeltaCoverage): str {
    $"teko: per-commit delta coverage (base {base_rev}): {delta_pct(d)}% ({d.cov}/{d.val}) of changed executable lines covered"
}

fn run_git_diff(base_rev: str, out_path: str): i32 {
    var cmd = teko::str::concat("git diff ", base_rev, "...HEAD -- '*.tks' > ", out_path, " 2>/dev/null")
    var argv: []str = ["sh", "-c", cmd]
    teko::process::run(argv)
}

fn per_commit_diff_text(base_rev: str): str | error {
    var out_path = teko::test::scoped(".teko-per-commit.diff")
    if run_git_diff(base_rev, out_path) != 0 {
        return error { message = teko::str::concat("git diff ", base_rev, "...HEAD failed (git unavailable or invalid base)") }
    }
    teko::io::read_file(out_path)
}

fn run_per_commit_test(dir: str, m: Manifest, base_rev: str, cov_validation: bool, pre_regr_cob: str): i32 {
    var diff = match per_commit_diff_text(base_rev) {
        str as s => s
        error => {
            teko::io::eprintln($"teko: warning: per-commit delta coverage skipped — `git diff {base_rev}...HEAD` unavailable")
            return 0
        }
    }
    var cls = changed_line_set(diff)
    var covlines = cov_lines_from_cobertura(pre_regr_cob)
    var d = delta_line_coverage(covlines, cls)
    teko::io::println(per_commit_report_str(base_rev, d))
    var pct = delta_pct(d)
    var floor = m.cov_lines
    if delta_floor_blocks(pct, floor, cov_validation) {
        return fail(dir, $"per-commit delta coverage {pct}% is below the {floor}% floor ([coverage] lines) — the lines changed since {base_rev} are undertested")
    }
    if pct < floor {
        teko::io::eprintln($"teko: warning: per-commit delta coverage {pct}% is below the {floor}% floor ([coverage] lines) — the lines changed since {base_rev} are undertested")
    }
    0
}

const REGRESSION_FEED_PROJECT: str = "teko"

fn build_regression_feed_exe(m: Manifest, prog: checker::TProgram) {
    if m.test_regression_files.len == 0 { return }
    if m.name != REGRESSION_FEED_PROJECT { return }
    match build_regression_cov_exe(m, prog) {
        str => { }
        error as e => teko::io::println(teko::str::concat("teko: regression coverage-feed build failed (", e.message, ") — running regressions without coverage attribution"))
    }
}

fn regression_feed_exe(exe: str, m: Manifest): str {
    if m.name != REGRESSION_FEED_PROJECT { return exe }
    var binp = binary_output_path(GATE_OUT_DIR, teko::str::concat(m.name, "-regrcov"), resolved_target())
    if !path_exists(binp) { return exe }
    var cwd = match teko::env::cwd() { str as c => c; error => "" }
    abs_path_of(binp, cwd)
}

fn path_exists(p: str): bool {
    var entries = match teko::fs::list_dir(dirname_of(p)) { []str as e => e; error => return false }
    var name = basename_of(p)
    var i: u64 = 0
    loop {
        if i >= entries.len { break }
        if entries[i] == name { return true }
        i = i + 1
    }
    false
}

fn build_regression_cov_exe(m: Manifest, prog: checker::TProgram): str | error {
    var od = GATE_OUT_DIR
    match teko::fs::mkdir(od) { error => { }; null => { } }
    var stem = teko::str::concat(m.name, "-regrcov")
    var cfile = teko::str::concat(od, "/", teko::str::concat(stem, ".c"))
    var binp = binary_output_path(od, stem, resolved_target())
    var mode = report_mode(false, output_is_tty(false))
    var emit_phase = phase_begin("emit rcov", cfile, mode)
    var csize = match codegen::tk_emit_c_cov_file(prog, cfile, codegen::tk_emit_meta(m.name, m.version, m.suffix, m.description)) {
        u64 as n => n
        error as e => { phase_end_fail(emit_phase, cfile, e.message); return e }
    }
    phase_end_ok(emit_phase, teko::str::concat(cfile, teko::str::concat(" ", size_text(csize))))
    match teko::fs::remove_file(binp) { error => { }; null => { } }
    var cc_phase = phase_begin("cc rcov", binp, mode)
    if run_cc(cfile, binp, m, prog, REGRCOV_CC_OPT) != 0 {
        phase_end_fail(cc_phase, binp, REGRCOV_CC_FAIL)
        return error { message = REGRCOV_CC_FAIL }
    }
    phase_end_ok(cc_phase, binp)
    var cwd = match teko::env::cwd() { str as c => c; error => "" }
    abs_path_of(binp, cwd)
}

const REGRCOV_CC_OPT: i32 = 2

const REGRCOV_CC_FAIL: str = "cc failed to build the coverage-instrumented regression compiler"

const GATE_OUT_DIR: str = "bin"

const TEST_STAGE_ENV: str = "TEKO_TEST_STAGE"

const TEST_STAGE_BUILD: str = "build"

const TEST_STAGE_REPORT: str = "report"

const TEST_STAGE_REGR: str = "regr"

const TEST_GATE_RC_ENV: str = "TEKO_TEST_GATE_RC"

const TEST_REGR_RC_ENV: str = "TEKO_TEST_REGR_RC"

const STAGE_SELECT_FAILED: i32 = 2

fn test_project(dir: str, gen_cov: bool, cov_validation: bool, per_test_cov: bool, per_commit_base: str, analyzer: bool, arith_cast_gate: bool): i32 {
    var stage = selected_test_stage()
    if stage == TEST_STAGE_BUILD { return test_stage_build(dir) }
    if stage == TEST_STAGE_REGR { return test_stage_regr(dir) }
    if stage == TEST_STAGE_REPORT {
        return test_stage_report(dir, gen_cov, cov_validation, per_test_cov, per_commit_base, analyzer, arith_cast_gate)
    }
    test_drive(dir)
}

fn selected_test_stage(): str {
    match teko::env::var(TEST_STAGE_ENV) { str as v => v; error => "" }
}

fn test_drive(dir: str): i32 {
    _ = teko::journal::run_id()
    _ = teko::journal::sweep(teko::journal::run_root())
    ensure_rt_dir_abs()
    var exe = self_exe_path()
    var launch = match teko::env::cwd() { str as c => c; error => "" }
    var brc = run_test_stage(TEST_STAGE_BUILD, exe)
    if brc != 0 { return brc }
    var m = match enter_project_manifest(dir) { Manifest as x => x; error as e => return fail(dir, e.message) }
    var trc = native_gate_run(GATE_OUT_DIR, gate_paths(GATE_OUT_DIR, m), false)
    match teko::env::chdir(launch) { error => return fail(dir, "cannot return to the launch directory"); null => { } }
    var regr_rc = run_test_stage(TEST_STAGE_REGR, exe)
    run_test_report_stage(exe, trc, regr_rc)
}

fn drive_regression_tier(exe: str, m: Manifest): i32 {
    if m.test_regression_files.len == 0 { return 0 }
    run_regression_phase(regression_feed_exe(exe, m), m)
}

fn test_stage_regr(dir: str): i32 {
    ensure_rt_dir_abs()
    var exe = self_exe_path()
    var m = match enter_project_manifest(dir) { Manifest as x => x; error as e => return fail(dir, e.message) }
    drive_regression_tier(exe, m)
}

fn enter_project_manifest(dir: str): Manifest | error {
    match teko::env::chdir(dir) { error => return error { message = "cannot enter project directory" }; null => { } }
    var mname = match find_manifest() { str as n => n; error as e => return e }
    var mtext = match teko::io::read_file(mname) { str as s => s; error => return error { message = "cannot read .tkp manifest" } }
    parse_manifest(mtext)
}

fn test_stage_build(dir: str): i32 {
    ensure_rt_dir_abs()
    match teko::env::chdir(dir) { error => return fail(dir, "cannot enter project directory"); null => { } }
    var tty = output_is_tty(false)
    var pf = match frontend_parse(true, false, tty) { ParsedFront as x => x; error as e => return fail(dir, e.message) }
    var fe = match frontend_check(pf, false, tty, false) { Frontend as x => x; error as e => return fail(dir, e.message) }
    report_arith_cast_rate(fe)
    var smrc = emit_sitemap_file(dir, GATE_OUT_DIR, fe.manifest, fe.prog)
    if smrc != 0 { return smrc }
    var brc = test_gate_build(dir, GATE_OUT_DIR, gate_paths(GATE_OUT_DIR, fe.manifest), fe, pf, tty)
    if brc != 0 { return brc }
    build_regression_feed_exe(fe.manifest, fe.prog)
    0
}

fn test_gate_build(dir: str, od: str, gp: GatePaths, fe: Frontend, pf: ParsedFront, tty: bool): i32 {
    if c_backend_selected() {
        return c_gate_build(dir, od, gp, fe)
    }
    native_gate_build(dir, od, gp, pf, fe.manifest, tty)
}

fn sitemap_path(od: str, m: Manifest): str {
    teko::str::concat(gate_out_dir(od), "/", m.name, ".tksites")
}

fn emit_sitemap_file(dir: str, od: str, m: Manifest, prog: checker::TProgram): i32 {
    match teko::fs::mkdir(gate_out_dir(od)) { error => return fail(dir, "cannot create the output directory"); null => { } }
    var blob = coverage::cov_emit_sitemap(prog)
    match teko::io::write_file(sitemap_path(od, m), blob) { error as e => return fail(dir, e.message); null => { } }
    0
}

fn read_sitemap(od: str, m: Manifest): coverage::SiteMap | error {
    var path = sitemap_path(od, m)
    var blob = match teko::io::read_file(path) { str as s => s; error => return error { message = teko::str::concat("cannot read the coverage site-map ", path) } }
    coverage::cov_parse_sitemap(blob)
}

fn print_journal_summary(sm: coverage::SiteMap) {
    var recs = teko::journal::fold(teko::journal::run_root(), teko::journal::run_id())
    var summary = teko::journal::summarize(recs)
    var cov = teko::journal::CovTriple {
        functions_cov = coverage::functions_coverage_of(sm).cov
        functions_val = coverage::functions_coverage_of(sm).val
        lines_cov = coverage::line_coverage_of(sm).cov
        lines_val = coverage::line_coverage_of(sm).val
        branches_cov = coverage::branch_coverage_of(sm).cov
        branches_val = coverage::branch_coverage_of(sm).val
    }
    teko::io::println(teko::journal::render_summary(teko::journal::with_coverage(summary, cov, 0)))
}

fn test_stage_report(dir: str, gen_cov: bool, cov_validation: bool, per_test_cov: bool, per_commit_base: str, analyzer: bool, arith_cast_gate: bool): i32 {
    var trc = stage_rc_of_env(TEST_GATE_RC_ENV)
    var regr_rc = stage_rc_of_env(TEST_REGR_RC_ENV)
    var m = match enter_project_manifest(dir) { Manifest as x => x; error as e => return fail(dir, e.message) }
    var sm = match read_sitemap(GATE_OUT_DIR, m) { coverage::SiteMap as x => x; error as e => return fail(dir, e.message) }
    match merge_gate_coverage(GATE_OUT_DIR, gate_paths(GATE_OUT_DIR, m), test_jobs(), trc) { error as e => return fail(dir, e.message); null => { } }
    var pre_regr_cob = coverage::cov_cobertura_of(sm)
    merge_regression_coverage()
    print_journal_summary(sm)
    if gen_cov {
        var xml = coverage::cov_cobertura_of(sm)
        match teko::io::write_file("cobertura.xml", xml) { error as e => return fail(dir, e.message); null => { } }
        teko::io::println("teko: wrote coverage report cobertura.xml")
    }
    var floor_rc = if trc == 0 { enforce_coverage_floors_sm(dir, sm, m, cov_validation) } else { 0 }
    var per_commit_rc: i32 = 0
    if trc == 0 && floor_rc == 0 && per_commit_base.len > 0 {
        per_commit_rc = run_per_commit_test(dir, m, per_commit_base, cov_validation, pre_regr_cob)
    }
    var has_regr = m.test_regression_files.len > 0
    var gate_rc = test_gate_precedence(trc, floor_rc, per_commit_rc, has_regr, regr_rc)
    if gate_rc != 0 { return gate_rc }
    if arith_cast_gate {
        var acrc = arith_cast_verdict(checker::arith_cast_rate_from(sm.arith_total, sm.arith_with_conversion))
        if acrc != 0 { return acrc }
    }
    if per_test_cov { return report_per_test_cov(dir) }
    if analyzer { return report_analyzer(dir) }
    0
}

fn report_per_test_cov(dir: str): i32 {
    var fe = match recheck_frontend_here(dir) { Frontend as x => x; error as e => return fail(dir, e.message) }
    run_per_test_cov(dir, fe)
}

fn report_analyzer(dir: str): i32 {
    var fe = match recheck_frontend_here(dir) { Frontend as x => x; error as e => return fail(dir, e.message) }
    run_analyzer(dir, fe)
}

fn recheck_frontend_here(dir: str): Frontend | error {
    var phase = phase_begin("recheck", dir, report_mode(false, output_is_tty(false)))
    match frontend_body(true, true, false, false) {
        Frontend as fe => { phase_end_ok(phase, dir); fe }
        error as e => { phase_end_fail(phase, dir, e.message); e }
    }
}

fn run_test_stage(stage: str, exe: str): i32 {
    if !env_visible_to_children(TEST_STAGE_ENV, stage) { return report_stage_select_failure(stage) }
    teko::io::flush()
    var rc = teko::process::run(self_stage_argv(exe))
    match teko::env::set_var(TEST_STAGE_ENV, "") { error => { }; null => { } }
    rc
}

fn run_test_report_stage(exe: str, trc: i32, regr_rc: i32): i32 {
    var ready = env_visible_to_children(TEST_GATE_RC_ENV, $"{trc}") && env_visible_to_children(TEST_REGR_RC_ENV, $"{regr_rc}")
    if !ready {
        report_stage_select_failure(TEST_STAGE_REPORT)
        if trc != 0 { return trc }
        return STAGE_SELECT_FAILED
    }
    run_test_stage(TEST_STAGE_REPORT, exe)
}

fn report_stage_select_failure(stage: str): i32 {
    teko::io::eprintln(teko::str::concat("teko: cannot hand the `", stage, "` stage its ", TEST_STAGE_ENV, " selector — refusing to run `teko test` unstaged"))
    STAGE_SELECT_FAILED
}

fn env_visible_to_children(key: str, value: str): bool {
    match teko::env::set_var(key, value) { error => return false; null => { } }
    match teko::env::var(key) { str as v => v == value; error => false }
}

fn stage_rc_of_env(key: str): i32 {
    match teko::env::var(key) { str as v => bp_parse_uint(v) to i32; error => 0 to i32 }
}

fn self_stage_argv(exe: str): []str {
    var args = teko::env::args()
    if args.len == 0 { return [exe] }
    var out: [args.len]str = []
    out[0] = exe
    var i: u64 = 1
    loop {
        if i >= args.len { break }
        out[i] = args[i]
        i = i + 1
    }
    out
}

fn test_gate_precedence(trc: i32, floor_rc: i32, per_commit_rc: i32, has_regr: bool, regr_rc: i32): i32 {
    if trc != 0 { return trc }
    if floor_rc != 0 { return floor_rc }
    if per_commit_rc != 0 { return per_commit_rc }
    if has_regr && regr_rc != 0 { return regr_rc }
    0
}
