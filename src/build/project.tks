
use teko::parser
use teko::lexer
use teko::checker
use teko::codegen
use teko::emit
use teko::compress
use teko::coverage

fn project_dir_of(arg: str): str {
    if !arg.ends_with(".tkp") {
        return arg
    }
    match teko::str::last_index_of(arg, "/") {
        u64 as i => arg.slice_to(i)
        error => "."
    }
}

type Frontend = struct {
    prog: checker::TProgram
    manifest: Manifest
}

fn fail(path: str, message: str): i32 {
    if path == "" {
        teko::io::eprint(teko::str::concat("teko: ", message))
    } else {
        teko::io::eprint(teko::str::concat("teko: ", path, teko::str::concat(": ", message)))
    }
    1
}

fn find_manifest(): str | error {
    var entries = match teko::fs::list_dir(".") { []str as e => e; error as e => return e }
    var found = ""
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= entries.len { break }
        var name = entries[i]
        if name.ends_with(".tkp") {
            found = name
            count = count + 1
        }
        i++
    }
    if count != 1 {
        return error { message = "no single .tkp manifest in project directory" }
    }
    found
}

fn project_frontend(dir: str): Frontend | error { project_frontend_sel(dir, false) }

fn project_frontend_sel(dir: str, include_tests: bool): Frontend | error {
    match teko::env::chdir(dir) { error => return error { message = "cannot enter project directory" }; null => { } }
    frontend_body(include_tests, false, output_is_tty(false), false)
}

fn target_os(m: Manifest): str {
    if m.target.len > 0 {
        if m.target.contains("linux") { return "linux" }
        if m.target.contains("darwin") || m.target.contains("macos") || m.target.contains("apple") { return "macos" }
        if m.target.contains("windows") || m.target.contains("mingw") || m.target.contains("w64") { return "windows" }
    }
    os()
}

fn target_arch(m: Manifest): str {
    if m.target.len > 0 {
        if m.target.contains("aarch64") || m.target.contains("arm64") { return "arm64" }
        if m.target.contains("x86_64") || m.target.contains("amd64") || m.target.contains("x64") { return "x86_64" }
    }
    arch()
}

const CC_SUPPORTED_TARGETS: []str = [
    "windows-x86_64",
    "linux-x86_64",
    "linux-arm64",
    "macos-arm64"
]

fn cc_validate_target(os: str, arch: str): null | error {
    var key = $"{os}-{arch}"
    var i: u64 = 0
    loop {
        if i >= CC_SUPPORTED_TARGETS.len { break }
        if CC_SUPPORTED_TARGETS[i] == key { return null }
        i = i + 1
    }
    error { message = $"unsupported (os,arch): {os}-{arch}" }
}


fn load_dep_program(dep: str): checker::TProgram | error {
    var entries = match teko::fs::list_dir("packages") {
        []str as e => e
        error => return error { message = $"teko: dep '{dep}': packages/ directory not found — place .tkl packages in packages/" }
    }
    var tkl_path = ""
    var ei: u64 = 0
    loop {
        if ei >= entries.len { break }
        var e = entries[ei]
        var prefix = teko::str::concat(dep, "-")
        var has_prefix = e.len >= prefix.len && e.slice_to(prefix.len) == prefix
        if has_prefix && e.ends_with(".tkl") {
            tkl_path = teko::str::concat("packages/", e)
            break
        }
        ei++
    }
    if tkl_path == "" {
        return error { message = $"teko: dep '{dep}': package not found (looked in packages/)" }
    }

    var raw_str = match teko::io::read_file(tkl_path) {
        str as s => s
        error => return error { message = $"teko: dep '{dep}': cannot read .tkl file" }
    }
    var raw: [raw_str.len]byte = []
    var ri: u64 = 0
    loop {
        if ri >= raw_str.len { break }
        raw[ri] = raw_str[ri]
        ri++
    }

    var zip_entries = match compress::read_zip(raw) {
        []compress::ZipEntry as es => es
        error as e => return error { message = $"teko: dep '{dep}': bad .tkl (ZIP parse error): {e.message}" }
    }
    var tkb_name = dep ~ ".tkb"
    var tkb_data: []byte = []
    var found_tkb = false
    var zi: u64 = 0
    loop {
        if zi >= zip_entries.len { break }
        if zip_entries[zi].name == tkb_name {
            tkb_data = zip_entries[zi].data
            found_tkb = true
            break
        }
        zi++
    }
    if !found_tkb {
        return error { message = $"teko: dep '{dep}': .tkl does not contain {tkb_name}" }
    }

    match emit::deserialize_program(tkb_data) {
        checker::TProgram as p => p
        error as e => return error { message = $"teko: dep '{dep}': .tkb deserialization failed: {e.message}" }
    }
}

fn load_deps_program(m: Manifest): checker::TProgram | error {
    var all_items: []@TItem() = []
    var di: u64 = 0
    loop {
        if di >= m.deps.len { break }
        var dep_prog = match load_dep_program(m.deps[di]) {
            checker::TProgram as p => p
            error as e => return e
        }
        var ii: u64 = 0
        loop {
            if ii >= dep_prog.items.len { break }
            all_items = [..all_items, dep_prog.items[ii]]
            ii++
        }
        di++
    }
    checker::TProgram { items = all_items }
}

fn checker_tick_fn(phase: Phase, ref last: u64, ref total_cell: u64): checker::ProgressFn {
    (n: u64, m: u64) => {
        last.value = n
        total_cell.value = m
        phase_tick(phase, count_unit_text(n, m, "items"))
    }
}

fn module_const_count(prog: checker::TProgram): u64 {
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TConstDecl => { n++ }
            _ => { }
        }
        i++
    }
    n
}

fn append_diags(a: []str, b: []str): []str {
    [..a, ..b]
}

fn checked_program_of(selected: parser::Program, dep_prog: checker::TProgram, report: bool, tty: bool, parse_diags: []str, explicit: bool): checker::TProgram | error {
    var mode = report_mode(!report, tty)
    var checker_phase = phase_begin("checker", count_unit_text(0, selected.items.len, "items"), mode)
    var last: u64 = 0
    var total_cell: u64 = selected.items.len
    var on_item = checker_tick_fn(checker_phase, last, total_cell)
    var pre = match checker::type_program_with_deps_pre_mono(selected, dep_prog, on_item, explicit) {
        checker::PreMono as p => p
        error as e => {
            var all = append_diags(parse_diags, [e.message])
            phase_end_fail(checker_phase, count_unit_text(last, total_cell, "items"), all[0])
            return error { message = join_diags(all) }
        }
    }
    var collected = append_diags(parse_diags, pre.diags)
    if collected.len > 0 {
        phase_end_fail(checker_phase, count_unit_text(last, total_cell, "items"), collected[0])
        return error { message = join_diags(collected) }
    }
    phase_end_ok(checker_phase, count_unit_text(total_cell, total_cell, "items"))
    report_phase_rss("checker")

    var mono_phase = phase_begin("monomorph", count_only_text(0, "instances"), mode)
    var checked = match checker::monomorphize(pre.prog, pre.table) {
        checker::TProgram as c => c
        error as e => {
            phase_end_fail(mono_phase, count_only_text(0, "instances"), e.message)
            return e
        }
    }
    var instances = if checked.items.len > pre.prog.items.len { checked.items.len - pre.prog.items.len } else { 0 }
    phase_end_ok(mono_phase, count_unit_text(instances, instances, "instances"))
    report_phase_rss("monomorph")

    var expanded = match checker::expand_comptime(checked, pre.table) {
        checker::TProgram as x => x
        error as e => return e
    }

    var consts_total = module_const_count(expanded)
    var consteval_phase = phase_begin("consteval", count_unit_text(0, consts_total, "consts"), mode)
    match checker::inline_consts(expanded) {
        checker::TProgram as inlined => {
            phase_end_ok(consteval_phase, count_unit_text(consts_total, consts_total, "consts"))
            report_phase_rss("consteval")
            inlined
        }
        error as e => {
            phase_end_fail(consteval_phase, count_unit_text(0, consts_total, "consts"), e.message)
            return e
        }
    }
}

type ParsedFront = struct {
    parsed: parser::Program
    manifest: Manifest
    diags: []str
    embeds: teko::embed::EmbedResult
}

fn rt_already_present(files: []SourceFile, ns: str): bool {
    var i: u64 = 0
    loop {
        if i >= files.len { break }
        if files[i].namespace == ns { return true }
        i = i + 1
    }
    false
}

fn wants_base_prelude(a: Artifact): bool {
    match a {
        Artifact::Binary => true
        Artifact::Static => true
        Artifact::Shared => true
        Artifact::Package => true
        Artifact::Tool => true
    }
}

fn wants_runtime_prelude(a: Artifact): bool {
    match a {
        Artifact::Binary => true
        Artifact::Tool => true
        Artifact::Static => false
        Artifact::Shared => false
        Artifact::Package => false
    }
}

fn key_has_prefix(key: str, prefix: str): bool {
    if key.len < prefix.len { return false }
    var i: u64 = 0
    loop {
        if i >= prefix.len { break }
        if key[i] != prefix[i] { return false }
        i = i + 1
    }
    true
}

fn ns_of_prelude_key(key: str): str | null {
    if key_has_prefix(key, "teko::/src/base/") { return "teko::base" }
    if key_has_prefix(key, "teko::/src/runtime/") { return "teko::runtime" }
    if key_has_prefix(key, "teko::/src/sys/abi/") { return "teko::sys::abi" }
    if key_has_prefix(key, "teko::/src/sys/") { return "teko::sys" }
    if key_has_prefix(key, "teko::/src/assert/") { return "teko::assert" }
    null
}

fn prelude_ns_wanted(ns: str, wants_runtime: bool): bool {
    if ns == "teko::base" { return true }
    wants_runtime
}

fn prelude_key_needs_runtime(key: str): bool {
    key == "teko::/src/base/str_surface.tks"
}

fn prelude_vfs_decode(rf: teko::embed::RoFile): str | error {
    var comp = teko::io::stream_bytes(rf.content)
    match rf.compress {
        teko::embed::EmbedCompress::None => str_of_bytes(comp)
        teko::embed::EmbedCompress::Deflate => match teko::compress::inflate(comp) { []byte as b => str_of_bytes(b); error as e => return e }
        teko::embed::EmbedCompress::Gzip => match teko::compress::gzip_decompress(comp) { []byte as b => str_of_bytes(b); error as e => return e }
    }
}

fn inject_runtime_prelude(files: []SourceFile, artifact: Artifact): []SourceFile | error {
    var wants_runtime = wants_runtime_prelude(artifact)
    var vfs = teko::embed::files()
    var keys = vfs.list()
    var pre: [keys.len]SourceFile = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= keys.len { break }
        var key = keys[i]
        if !key_has_prefix(key, "teko::/src/") {
            i = i + 1
            continue
        }
        var ns = match ns_of_prelude_key(key) {
            str as s => s
            null => return error { message = $"runtime prelude: shipped file '{key}' maps to no prelude namespace" }
        }
        if !prelude_ns_wanted(ns, wants_runtime) {
            i = i + 1
            continue
        }
        if prelude_key_needs_runtime(key) && !wants_runtime {
            i = i + 1
            continue
        }
        if rt_already_present(files, ns) {
            i = i + 1
            continue
        }
        var rf = match vfs.get(key) { teko::embed::RoFile as f => f; error as e => return e }
        var content = match prelude_vfs_decode(rf) { str as s => s; error as e => return e }
        pre[count] = SourceFile { path = key; namespace = ns; content = content }
        count = count + 1
        i = i + 1
    }
    dsc_append(teko::collections::arr_slice(pre, 0, count), files)
}

fn embed_bytes_expr(bytes: []byte): parser::Expr {
    parser::Expr { kind = parser::ByteStrLit { text = str_of_bytes(bytes) }; line = 0; col = 0 }
}

fn embed_u64_expr(v: u64): parser::Expr {
    parser::Expr { kind = parser::Number { is_float = false; value = parser::numint_of_u64(v); fval = 0.0 }; line = 0; col = 0 }
}

fn embed_reinit_const(cd: parser::ConstDecl, init: parser::Expr): parser::ConstDecl {
    parser::ConstDecl { name = cd.name; ty = cd.ty; init = init; vis = cd.vis; has_doc = cd.has_doc; doc = cd.doc; line = cd.line; col = cd.col; is_global = cd.is_global }
}

fn embed_const_new_init(cd: parser::ConstDecl, heaps: teko::embed::EmbedHeaps): parser::ConstDecl {
    if cd.name == "EMBED_NAMES" { return embed_reinit_const(cd, embed_bytes_expr(heaps.names)) }
    if cd.name == "EMBED_BLOBS" { return embed_reinit_const(cd, embed_bytes_expr(heaps.blobs)) }
    if cd.name == "EMBED_TABLE" { return embed_reinit_const(cd, embed_bytes_expr(heaps.table)) }
    if cd.name == "EMBED_COUNT" { return embed_reinit_const(cd, embed_u64_expr(heaps.count)) }
    cd
}

fn patch_embed_consts(program: parser::Program, heaps: teko::embed::EmbedHeaps): parser::Program {
    var n = program.items.len
    var out: [n]parser::Item = []
    var i: u64 = 0
    loop {
        if i >= n { break }
        var it = program.items[i]
        var content = it.content
        if it.namespace == "teko::embed" {
            match it.content {
                parser::ConstDecl as cd => content = embed_const_new_init(cd, heaps)
                _ => { }
            }
        }
        out[i] = parser::Item { content = content; namespace = it.namespace; file = it.file; guard = it.guard }
        i = i + 1
    }
    parser::Program { items = out }
}

fn frontend_parse(include_tests: bool, quiet: bool, tty: bool): ParsedFront | error {
    var mname = match find_manifest() { str as n => n; error as e => return e }
    var mtext = match teko::io::read_file(mname) { str as s => s; error => return error { message = "cannot read .tkp manifest" } }
    var m = match parse_manifest(mtext) { Manifest as x => x; error as e => return e }

    var files = match discover(m.name, m.source) { []SourceFile as f => f; error as e => return e }

    match teko::io::read_file("main.tks") {
        str => files = [..files, SourceFile { path = "main.tks"; namespace = m.name; content = "" }]
        error => { }
    }

    if wants_base_prelude(m.artifact) {
        files = match inject_runtime_prelude(files, m.artifact) { []SourceFile as f => f; error as e => return e }
    }

    var has_main = false
    var mi: u64 = 0
    loop {
        if mi >= files.len { break }
        if files[mi].path.ends_with("main.tks") { has_main = true; break }
        mi = mi + 1
    }
    match check_main_file_rule(m.artifact, has_main) { Artifact => { }; error as e => return e }

    if !quiet {
        teko::io::eprintln(teko::str::concat("teko ", teko::env::version()))
        teko::io::eprintln(teko::str::concat("project '", m.name, teko::str::concat("' (source=", m.source, ")")))
    }

    var asm = match assemble_sel(files, include_tests, !quiet, tty) { Assembled as a => a; error as e => return e }

    var embed_result = teko::embed::run_embed_pass(asm.embeds, m.name, "")
    var all_diags = append_diags(asm.diags, embed_result.diags)
    var prog = asm.program
    if embed_result.entries.len > 0 {
        prog = patch_embed_consts(prog, teko::embed::serialize_embed_heaps(embed_result))
    }

    ParsedFront { parsed = prog; manifest = m; diags = all_diags; embeds = embed_result }
}

fn frontend_check(pf: ParsedFront, quiet: bool, tty: bool, explicit: bool): Frontend | error {
    match cc_validate_target(target_os(pf.manifest), target_arch(pf.manifest)) { error as e => return e; null => { } }
    var selected = prune_cc(pf.parsed, CcEnv { os = target_os(pf.manifest); arch = target_arch(pf.manifest); build_flags = [] }, PruneMode { keep_target_arms = c_backend_selected() })

    var expanded = match parser::expand_macros_syntactic(selected) { parser::Program as p => p; error as e => return e }

    var dep_prog = match load_deps_program(pf.manifest) { checker::TProgram as p => p; error as e => return e }

    var checked = match checked_program_of(expanded, dep_prog, !quiet, tty, pf.diags, explicit) { checker::TProgram as c => c; error as e => return e }

    _ = checker::divergence_analysis(checked)

    Frontend { prog = checked; manifest = pf.manifest }
}

fn frontend_body(include_tests: bool, quiet: bool, tty: bool, explicit: bool): Frontend | error {
    var pf = match frontend_parse(include_tests, quiet, tty) { ParsedFront as x => x; error as e => return e }
    frontend_check(pf, quiet, tty, explicit)
}

fn filter_tkt(p: parser::Program): parser::Program {
    var kept: [p.items.len]parser::Item = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= p.items.len { break }
        if !p.items[i].file.ends_with(".tkt") { kept[count] = p.items[i]; count = count + 1 }
        i = i + 1
    }
    parser::Program { items = teko::collections::arr_slice(kept, 0, count) }
}


fn rt_dir(): str {
    match teko::env::var("TK_RT_DIR") {
        str as d => d
        error => {
            match teko::io::read_file("src/runtime/teko_rt.h") { str => return "src/runtime"; error => { } }
            match teko::io::read_file("runtime/teko_rt.h") { str => return "runtime"; error => { } }
            "src/runtime"
        }
    }
}

fn assert_dir(rt: str): str {
    match teko::str::last_index_of(rt, "/") {
        u64 as i => teko::str::concat(rt.slice_to(i), "/assert")
        error => "assert"
    }
}

fn cc_family_is_clang(cc: str, binary: str): bool {
    var probe = teko::str::concat(binary, ".ccprobe.c")
    match teko::io::write_file(probe, "int main(void){return 0;}\n") {
        error => return true
        null => { }
    }
    var argv: []str = [
        cc,
        "-std=c23",
        "-ferror-limit=0",
        "-fsyntax-only",
        probe
    ]
    var is_clang = teko::process::run_quiet(argv) == 0
    match teko::fs::remove_file(probe) { error => { }; null => { } }
    is_clang
}

fn append_reachable_link_flags(argv: []str, m: Manifest, reachable: []str): []str {
    var out = argv
    var li = 0
    loop {
        if li >= m.link_flags.len { break }
        if name_in(reachable, m.link_lib_name[li]) && !omit_flag_for_blind_link(m.link_flags[li], m.link_mode[li]) {
            out = [..out, m.link_flags[li]]
        }
        li = li + 1
    }
    out
}

fn omit_flag_for_blind_link(flag: str, mode: str): bool {
    if mode != LINK_MODE_SHARED { return false }
    if !allow_undef_selected() { return false }
    var path = lib_spec_path(flag)
    if path.len == 0 { return false }
    !lib_file_present(path)
}

fn append_reachable_os_lib_flags(argv: []str, m: Manifest, keys: LinkTargetKeys, reachable: []str): []str {
    var out = argv
    var oi = 0
    loop {
        if oi >= m.os_lib_os.len { break }
        if os_lib_key_matches(m.os_lib_os[oi], keys) && name_in(reachable, m.os_lib_name[oi]) && !omit_flag_for_blind_link(m.os_lib_flag[oi], m.os_lib_mode[oi]) {
            out = [..out, m.os_lib_flag[oi]]
        }
        oi = oi + 1
    }
    out
}

const ASSERT_SEED_NAMESPACE: str = "teko::assert"

const ASSERT_SEED_STRONG_FLAG: str = "-DTK_ASSERT_SEED_STRONG"

fn declares_assert_seed(namespace: str, is_extern: bool): bool {
    !is_extern && namespace == ASSERT_SEED_NAMESPACE
}

fn program_declares_assert_seed(prog: checker::TProgram): bool {
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { if declares_assert_seed(f.namespace, f.is_extern) { return true } }
            _ => { }
        }
        i = i + 1
    }
    false
}

fn teko_cc_env(): str {
    match teko::env::var("TEKO_CC") { str as v => v; error => "" }
}

fn default_cc_for_target(t: NativeTarget): str {
    match t {
        NativeTarget::X8664Windows => HOST_CC_NAME
        NativeTarget::X8664Linux => HOST_CC_NAME
        NativeTarget::Arm64Macho => HOST_CC_NAME
        NativeTarget::Arm64Linux => HOST_CC_NAME
    }
}

const WINDOWS_OS_NAME: str = "windows"

const WINDOWS_CC_NAME: str = "clang"

const WINDOWS_MSVC_TRIPLE: str = "x86_64-pc-windows-msvc"

const CC_TARGET_FLAG_PREFIX: str = "--target="

type CcChoice = struct {
    cmd: str
    target_flag: str
}

fn host_cc_choice(): CcChoice {
    if os() == WINDOWS_OS_NAME {
        return CcChoice { cmd = WINDOWS_CC_NAME; target_flag = CC_TARGET_FLAG_PREFIX ~ WINDOWS_MSVC_TRIPLE }
    }
    CcChoice { cmd = HOST_CC_NAME; target_flag = "" }
}

fn resolve_cc_choice(m: Manifest): CcChoice {
    if m.cc.len > 0 { return CcChoice { cmd = m.cc; target_flag = "" } }
    var env_cc = teko_cc_env()
    if env_cc.len > 0 { return CcChoice { cmd = env_cc; target_flag = "" } }
    host_cc_choice()
}

fn resolve_cc(m: Manifest): str { resolve_cc_choice(m).cmd }

fn opt_cc_flag(level: i32): str {
    if level >= 2 { return "-O2" }
    if level == 1 { return "-O1" }
    ""
}

fn opt_arg_has_prefix(a: str): bool {
    a.len > 6 && a.slice_to(6) == "--opt="
}

fn opt_level_of_value(v: str): i32 {
    if v == "0" { return 0 }
    if v == "1" { return 1 }
    2
}

fn opt_level_of(args: []str): i32 {
    var i: u64 = 0
    var level: i32 = 0
    loop {
        if i >= args.len { break }
        var a = args[i]
        if a == "--release" { level = 2 }
        else if opt_arg_has_prefix(a) { level = opt_level_of_value(a.slice_from(6)) }
        i = i + 1
    }
    level
}

pub type DebugInfo = enum { None; Lines }

fn debug_arg_has_prefix(a: str): bool {
    a.len > 8 && a.slice_to(8) == "--debug="
}

fn debug_info_of_value(v: str): DebugInfo | error {
    if v == "none" { return DebugInfo::None }
    if v == "lines" { return DebugInfo::Lines }
    error { message = teko::str::concat("teko: --debug=", v, ": unknown level — accepted: none, lines") }
}

fn debug_info_of(args: []str): DebugInfo | error {
    var i: u64 = 0
    var level = DebugInfo::None
    loop {
        if i >= args.len { break }
        if debug_arg_has_prefix(args[i]) {
            level = match debug_info_of_value(args[i].slice_from(8)) {
                DebugInfo as d => d
                error as e => return e
            }
        }
        i = i + 1
    }
    level
}

fn has_bare_g_flag(args: []str, start: u64): bool {
    var i = start
    loop {
        if i >= args.len { break }
        if args[i] == "-g" { return true }
        i = i + 1
    }
    false
}

fn bare_g_rejected_message(): str {
    teko::str::concat(
        "teko: `-g` is not a Teko flag.\n",
        "      In gcc, clang and rustc `-g` means FULL debug information (types and variables), and this\n",
        "      compiler cannot emit that yet — promising it would be a lie.\n",
        "      Use `--debug=lines` for the line table (breakpoint by .tks line, step, backtrace).")
}

fn build_cc_argv(input: str, binary: str, m: Manifest, prog: checker::TProgram, debug: bool, opt: i32): []str {
    var rt = rt_dir()
    var asrt = assert_dir(rt)
    var choice = resolve_cc_choice(m)
    var is_clang = cc_family_is_clang(choice.cmd, binary)
    var argv: []str = [
        choice.cmd
    ]
    if choice.target_flag.len > 0 { argv = [..argv, choice.target_flag] }
    argv = [
        ..argv,
        if is_clang { "-std=c23" } else { "-std=c2x" },
        "-w",
        if is_clang { "-ferror-limit=0" } else { "-fmax-errors=0" },
    ]
    if debug { argv = [..argv, "-g"] }
    var oflag = opt_cc_flag(opt)
    if oflag.len > 0 { argv = [..argv, oflag] }
    var verval = if m.suffix.len > 0 { teko::str::concat(teko::str::concat(m.version, "-"), m.suffix) } else { m.version }
    argv = [..argv, teko::str::concat("-DTEKO_VERSION_STRING=", verval)]
    if !program_declares_assert_seed(prog) { argv = [..argv, ASSERT_SEED_STRONG_FLAG] }
    if m.target.len > 0 { argv = [..argv, "-target", m.target] }
    if m.sysroot.len > 0 { argv = [..argv, "--sysroot", m.sysroot] }
    if m.freestanding { argv = [..argv, "-nostdlib"] }
    argv = [
        ..argv,
        "-I",
        rt,
        "-I",
        asrt,
        input,
        teko::str::concat(rt, "/teko_rt.c"),
        teko::str::concat(asrt, "/assert.c"),
    ]
    var keys = link_target_keys(m)
    argv = append_pthread_flag(argv, m, keys.emit_os)
    var reachable = reachable_libs(prog)
    argv = append_reachable_link_flags(argv, m, reachable)
    argv = append_reachable_os_lib_flags(argv, m, keys, reachable)
    argv = append_allow_undef_flag(argv)
    argv = append_macos_plist_flag(argv, binary, m, keys.emit_os)
    argv = append_windows_reproducible_flag(argv, keys.emit_os)
    argv = append_windows_stack_reserve_flag(argv, keys.emit_os)
    [..argv, "-o", binary]
}

const PTHREAD_FLAG: str = "-pthread"

fn append_pthread_flag(argv: []str, m: Manifest, emit_os: str): []str {
    if m.freestanding { return argv }
    if emit_os == WINDOWS_OS_NAME { return argv }
    [..argv, PTHREAD_FLAG]
}

const WINDOWS_NO_TIMESTAMP_FLAG: str = "-Wl,/Brepro"

fn append_windows_reproducible_flag(argv: []str, emit_os: str): []str {
    if emit_os != "windows" { return argv }
    [..argv, WINDOWS_NO_TIMESTAMP_FLAG]
}

const WINDOWS_STACK_RESERVE_FLAG: str = "-Wl,/STACK:16777216"

fn append_windows_stack_reserve_flag(argv: []str, emit_os: str): []str {
    if emit_os != WINDOWS_OS_NAME { return argv }
    [..argv, WINDOWS_STACK_RESERVE_FLAG]
}

const ALLOW_UNDEF_FLAG: str = "--allow-undef"

fn allow_undef_of(args: []str): bool {
    var i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == ALLOW_UNDEF_FLAG { return true }
        i = i + 1
    }
    false
}

fn allow_undef_selected(): bool { allow_undef_of(teko::env::args()) }

fn allow_undef_cc_flag(objfmt: str): str {
    if objfmt == OBJFMT_ELF { return "-Wl,--allow-shlib-undefined,--unresolved-symbols=ignore-all" }
    if objfmt == OBJFMT_MACHO { return "-Wl,-undefined,dynamic_lookup" }
    ""
}

fn append_allow_undef_flag(argv: []str): []str {
    if !allow_undef_selected() { return argv }
    var flag = allow_undef_cc_flag(target_objfmt(resolved_target()))
    if flag.len == 0 { return argv }
    [..argv, flag]
}

type ExternLibEntry = struct {
    key: str
    flag: str
    mode: str
    section: str
}

fn applicable_extern_libs(m: Manifest, target: NativeTarget): []ExternLibEntry {
    var out: [m.link_flags.len]ExternLibEntry = []
    var i: u64 = 0
    loop {
        if i >= m.link_flags.len { break }
        out[i] = ExternLibEntry { key = m.link_lib_name[i]; flag = m.link_flags[i]; mode = m.link_mode[i]; section = "" }
        i = i + 1
    }
    var keys = target_link_keys(target)
    var j: u64 = 0
    loop {
        if j >= m.os_lib_os.len { break }
        if os_lib_key_matches(m.os_lib_os[j], keys) {
            out =[..out, ExternLibEntry { key = m.os_lib_name[j]; flag = m.os_lib_flag[j]; mode = m.os_lib_mode[j]; section = m.os_lib_os[j] }]
        }
        j = j + 1
    }
    out
}

fn lib_spec_path(flag: str): str {
    if flag.len > 0 && flag[0] == b'-' { return "" }
    flag
}

fn lib_file_present(path: str): bool {
    var entries = match teko::fs::list_dir(dirname_of(path)) { []str as e => e; error => return false }
    name_in(entries, basename_of(path))
}

fn static_lib_locality_error(e: ExternLibEntry, target: NativeTarget): null | error {
    var tname = target_name(target)
    var path = lib_spec_path(e.flag)
    if path.len == 0 {
        if !cross_note(target).is_cross { return null }
        return error { message = $"[extern.libs] static lib {e.key} is not pointed at for target {tname}: a cross static lib must name a file present locally — declare it as [extern.libs.{tname}] {e.key} = [static:<path>]" }
    }
    if lib_file_present(path) { return null }
    error { message = $"[extern.libs] static lib {e.key} for target {tname} is not present locally: {path}" }
}

fn validate_static_libs_for_target(m: Manifest, target: NativeTarget): null | error {
    var entries = applicable_extern_libs(m, target)
    var i: u64 = 0
    loop {
        if i >= entries.len { break }
        if entries[i].mode == LINK_MODE_STATIC {
            match static_lib_locality_error(entries[i], target) { error as err => return err; null => { } }
        }
        i = i + 1
    }
    null
}

fn is_import_lib_path(path: str): bool {
    path.ends_with(".lib") || path.ends_with(".a")
}

fn shared_lib_link_error(e: ExternLibEntry, target: NativeTarget, allow_undef: bool): null | error {
    var tname = target_name(target)
    var path = lib_spec_path(e.flag)
    if target_objfmt(target) == OBJFMT_COFF && cross_note(target).is_cross && !is_import_lib_path(path) {
        return error { message = $"[extern.libs] shared lib {e.key} cannot be linked for target {tname}: PE/COFF references a DLL only through an import library, which the transitional system linker will not synthesize — point at one ([extern.libs.{tname}] {e.key} = [shared:<path>.lib]); --allow-undef does not lift this (E1's own import-table writer does)" }
    }
    if path.len == 0 { return null }
    if lib_file_present(path) { return null }
    if allow_undef { return null }
    error { message = $"[extern.libs] shared lib {e.key} for target {tname} is not present locally: {path} — supply the library, or pass {ALLOW_UNDEF_FLAG} to link blind and resolve it at load time on the target" }
}

fn validate_shared_libs_for_target(m: Manifest, target: NativeTarget, allow_undef: bool): null | error {
    var entries = applicable_extern_libs(m, target)
    var i: u64 = 0
    loop {
        if i >= entries.len { break }
        if entries[i].mode == LINK_MODE_SHARED {
            match shared_lib_link_error(entries[i], target, allow_undef) { error as err => return err; null => { } }
        }
        i = i + 1
    }
    null
}

fn validate_extern_libs_for_target(m: Manifest): null | error {
    var target = resolved_target()
    match validate_static_libs_for_target(m, target) { error as e => return e; null => { } }
    validate_shared_libs_for_target(m, target, allow_undef_selected())
}

fn append_macos_plist_flag(argv: []str, binary: str, m: Manifest, tos: str): []str {
    if tos != "macos" { return argv }
    var plist = teko::str::concat(binary, ".Info.plist")
    match teko::io::write_file(plist, plist_xml(m)) {
        null => [..argv, teko::str::concat("-Wl,-sectcreate,__TEXT,__info_plist,", plist)]
        error => argv
    }
}

const CC_TRIPLE_PROBE_SUFFIX: str = ".ccmachine"

fn cc_target_triple(cc: str, binary: str): str {
    var outp = binary ~ CC_TRIPLE_PROBE_SUFFIX
    var argv: []str = [cc, HOST_CC_MACHINE_FLAG]
    var h = teko::process::spawn_redirected(argv, "", [], "", outp, outp ~ ".err")
    var rc = teko::process::wait_one(h)
    var out = match teko::io::read_file(outp) { str as s => s; error => "" }
    match teko::fs::remove_file(outp) { error => { }; null => { } }
    match teko::fs::remove_file(outp ~ ".err") { error => { }; null => { } }
    if rc != 0 { return "" }
    trimmed_line(first_line(out))
}

fn trimmed_line(line: str): str {
    if line.len > 0 && line[line.len - 1] == b'\r' { return line.slice_to(line.len - 1) }
    line
}

const MINGW_PATH_EVIDENCE_PHRASE: str = "itself names a MinGW install"

const MINGW_TRIPLE_EVIDENCE_PHRASE: str = "with the MinGW target triple"

fn mingw_path_evidence(cc: str): str {
    if !linker_is_mingw(cc) { return "" }
    $"the command '{cc}' {MINGW_PATH_EVIDENCE_PHRASE}"
}

fn mingw_triple_evidence(triple: str): str {
    if !triple_is_mingw(triple) { return "" }
    $"it answers {HOST_CC_MACHINE_FLAG} {MINGW_TRIPLE_EVIDENCE_PHRASE} '{triple}'"
}

fn mingw_cc_evidence(cc: str, binary: str): str {
    var by_name = mingw_path_evidence(cc)
    if by_name.len > 0 { return by_name }
    mingw_triple_evidence(cc_target_triple(cc, binary))
}

fn mingw_cc_rejected_error(cc: str, evidence: str): error {
    error { message = teko::str::concat(
        "refusing the MinGW C compiler '", cc, "': ", evidence, ". ",
        MINGW_BAN_REASON,
        " Use clang with an explicit MSVC target (", WINDOWS_CC_NAME, " ", CC_TARGET_FLAG_PREFIX,
        WINDOWS_MSVC_TRIPLE, "), which is this build's own default on a Windows host — MSVC supplies",
        " the headers, the libraries and the linker, and clang supplies the GNU C extensions the",
        " emitted C uses.") }
}

const CC_VERBOSE_FLAG: str = "-v"

fn cc_verbose_argv(argv: []str): []str {
    var out: []str = [argv[0], CC_VERBOSE_FLAG]
    var i: u64 = 1
    loop {
        if i >= argv.len { break }
        out = [..out, argv[i]]
        i = i + 1
    }
    out
}

fn report_cc_failure(argv: []str, rc: i32): i32 {
    teko::io::eprintln($"teko: cc failed (status {rc}) — re-running the same line with {CC_VERBOSE_FLAG} so the invocation is on the record:")
    if teko::process::run(cc_verbose_argv(argv)) == 0 {
        teko::io::eprintln($"teko: the {CC_VERBOSE_FLAG} re-run of the SAME line SUCCEEDED — the failure above is not reproducible from these inputs")
    }
    rc
}

fn invoke_cc(argv: []str, binary: str): i32 {
    var evidence = mingw_cc_evidence(argv[0], binary)
    if evidence.len > 0 { return fail("", mingw_cc_rejected_error(argv[0], evidence).message) }
    var rc = teko::process::run(argv)
    if rc == 0 { return 0 }
    report_cc_failure(argv, rc)
}

fn run_cc(cfile: str, binary: str, m: Manifest, prog: checker::TProgram, opt: i32): i32 {
    invoke_cc(build_cc_argv(cfile, binary, m, prog, false, opt), binary)
}

fn run_cc_debug(cfile: str, binary: str, m: Manifest, prog: checker::TProgram): i32 {
    invoke_cc(build_cc_argv(cfile, binary, m, prog, true, 0), binary)
}

fn run_cc_for_level(cfile: str, binary: str, m: Manifest, prog: checker::TProgram, opt: i32, debug: DebugInfo): i32 {
    if debug == DebugInfo::None { return run_cc(cfile, binary, m, prog, opt) }
    invoke_cc(build_cc_argv(cfile, binary, m, prog, true, opt), binary)
}

fn link_object(objfile: str, binary: str, m: Manifest, prog: checker::TProgram): i32 {
    if m.freestanding { return invoke_cc(build_cc_argv(objfile, binary, m, prog, false, 0), binary) }
    match resolved_target() {
        NativeTarget::X8664Linux => link_object_elf_direct(objfile, binary, m, prog, elf_link_spec(LinkArch::X8664))
        NativeTarget::Arm64Linux => link_object_elf_direct(objfile, binary, m, prog, elf_link_spec(LinkArch::Arm64))
        NativeTarget::Arm64Macho => link_object_macho_direct(objfile, binary, m, prog)
        NativeTarget::X8664Windows => link_object_pe_direct(objfile, binary, m, prog)
    }
}

const ELF_DYNLINKER_X8664: str = "/lib64/ld-linux-x86-64.so.2"

const ELF_DYNLINKER_ARM64: str = "/lib/ld-linux-aarch64.so.1"

type ElfLinkSpec = struct {
    arch: LinkArch
    dynamic_linker: str
    crt_dirs: []str
}

fn elf_link_spec(arch: LinkArch): ElfLinkSpec {
    match arch {
        LinkArch::X8664 => {
            ElfLinkSpec {
                arch = LinkArch::X8664
                dynamic_linker = ELF_DYNLINKER_X8664
                crt_dirs = [
                    "/usr/lib/x86_64-linux-gnu",
                    "/lib/x86_64-linux-gnu",
                    "/usr/lib64",
                    "/usr/lib"
                ]
            }
        }
        LinkArch::Arm64 => {
            ElfLinkSpec {
                arch = LinkArch::Arm64
                dynamic_linker = ELF_DYNLINKER_ARM64
                crt_dirs = [
                    "/usr/lib/aarch64-linux-gnu",
                    "/lib/aarch64-linux-gnu",
                    "/usr/lib64",
                    "/usr/lib"
                ]
            }
        }
    }
}

fn elf_crt_dir(spec: ElfLinkSpec): str | error {
    var i: u64 = 0
    loop {
        if i >= spec.crt_dirs.len { break }
        if lib_file_present(teko::str::concat(spec.crt_dirs[i], "/Scrt1.o")) { return spec.crt_dirs[i] }
        i = i + 1
    }
    error { message = teko::str::concat(
        "de-C native link: no ELF startup object `Scrt1.o` for ", arch_name(spec.arch),
        " in the standard glibc multiarch paths (", join_candidates(spec.crt_dirs),
        ") — install libc development files, or link this target through the C driver.") }
}

fn compile_c_object_argv(cc: str, is_clang: bool, csrc: str, obj: str, rt: str, asrt: str, m: Manifest, prog: checker::TProgram, strong_seed: bool): []str {
    var argv: []str = [
        cc,
        if is_clang { "-std=c23" } else { "-std=c2x" },
        "-w",
        if is_clang { "-ferror-limit=0" } else { "-fmax-errors=0" },
    ]
    if !m.freestanding { argv = [..argv, PTHREAD_FLAG] }
    var verval = if m.suffix.len > 0 { teko::str::concat(teko::str::concat(m.version, "-"), m.suffix) } else { m.version }
    argv = [..argv, teko::str::concat("-DTEKO_VERSION_STRING=", verval)]
    if strong_seed && !program_declares_assert_seed(prog) { argv = [..argv, ASSERT_SEED_STRONG_FLAG] }
    [..argv, "-I", rt, "-I", asrt, "-c", csrc, "-o", obj]
}

type RuntimeObjects = struct {
    rt_obj: str
    assert_obj: str
}

fn compile_runtime_objects(binary: str, m: Manifest, prog: checker::TProgram): RuntimeObjects | error {
    var rt = rt_dir()
    var asrt = assert_dir(rt)
    var cc = resolve_cc(m)
    var is_clang = cc_family_is_clang(cc, binary)
    var rtobj = teko::str::concat(binary, ".teko_rt.o")
    var asobj = teko::str::concat(binary, ".assert.o")
    if teko::process::run(compile_c_object_argv(cc, is_clang, teko::str::concat(rt, "/teko_rt.c"), rtobj, rt, asrt, m, prog, false)) != 0 {
        return error { message = "de-C native link: compiling teko_rt.c to an object failed" }
    }
    if teko::process::run(compile_c_object_argv(cc, is_clang, teko::str::concat(asrt, "/assert.c"), asobj, rt, asrt, m, prog, true)) != 0 {
        return error { message = "de-C native link: compiling assert.c to an object failed" }
    }
    RuntimeObjects { rt_obj = rtobj; assert_obj = asobj }
}

fn run_direct_link(argv: []str): i32 {
    var rc = teko::process::run(argv)
    if rc == 0 { return 0 }
    report_cc_failure(argv, rc)
}

fn link_object_elf_direct(objfile: str, binary: str, m: Manifest, prog: checker::TProgram, spec: ElfLinkSpec): i32 {
    var objs = match compile_runtime_objects(binary, m, prog) { RuntimeObjects as o => o; error as e => return fail("", e.message) }
    var ld = match resolve_linker(spec.arch, LinkFormat::Elf) { str as s => s; error as e => return fail("", e.message) }
    var crt = match elf_crt_dir(spec) { str as d => d; error as e => return fail("", e.message) }
    var argv: []str = [
        ld, "-pie", "-z", "noexecstack", "--eh-frame-hdr", "-m",
        gnu_emulation_for(spec.arch, LinkFormat::Elf), "-dynamic-linker",
        spec.dynamic_linker, teko::str::concat(crt, "/Scrt1.o"), teko::str::concat(crt, "/crti.o"),
        objfile, objs.rt_obj, objs.assert_obj, "-L", crt, "-lc"
    ]
    var keys = link_target_keys(m)
    var reachable = reachable_libs(prog)
    argv = append_reachable_link_flags(argv, m, reachable)
    argv = append_reachable_os_lib_flags(argv, m, keys, reachable)
    run_direct_link([
        ..argv, teko::str::concat(crt, "/crtn.o"), "-o", binary
    ])
}

const MACHO_MIN_OS_VERSION: str = "11.0.0"

const MACHO_SDK_VERSION_FALLBACK: str = MACHO_MIN_OS_VERSION

fn capture_tool_line(argv: []str, binary: str, suffix: str): str {
    var outp = binary ~ suffix
    var h = teko::process::spawn_redirected(argv, "", [], "", outp, outp ~ ".err")
    var rc = teko::process::wait_one(h)
    var out = match teko::io::read_file(outp) { str as s => s; error => "" }
    match teko::fs::remove_file(outp) { error => { }; null => { } }
    match teko::fs::remove_file(outp ~ ".err") { error => { }; null => { } }
    if rc != 0 { return "" }
    trimmed_line(first_line(out))
}

fn xcrun_show(what: str, binary: str): str {
    var argv: []str = [ "xcrun", teko::str::concat("--show-", what) ]
    capture_tool_line(argv, binary, teko::str::concat(".xcrun-", what))
}

fn append_macho_plist_section(argv: []str, binary: str, m: Manifest): []str {
    var plist = teko::str::concat(binary, ".Info.plist")
    match teko::io::write_file(plist, plist_xml(m)) {
        error => return argv
        null => { }
    }
    [..argv, "-sectcreate", "__TEXT", "__info_plist", plist]
}

fn link_object_macho_direct(objfile: str, binary: str, m: Manifest, prog: checker::TProgram): i32 {
    var objs = match compile_runtime_objects(binary, m, prog) { RuntimeObjects as o => o; error as e => return fail("", e.message) }
    var ld = match resolve_linker(LinkArch::Arm64, LinkFormat::Macho) { str as s => s; error as e => return fail("", e.message) }
    var sdk = xcrun_show("sdk-path", binary)
    var sdkver = xcrun_show("sdk-version", binary)
    var argv: []str = [
        ld, "-arch", arch_name(LinkArch::Arm64), "-macosx_version_min", MACHO_MIN_OS_VERSION,
        if sdkver.len > 0 { sdkver } else { MACHO_SDK_VERSION_FALLBACK }
    ]
    if sdk.len > 0 {
        argv = [..argv, "-syslibroot", sdk]
    }
    argv = [..argv, objfile, objs.rt_obj, objs.assert_obj, "-lSystem"]
    var keys = link_target_keys(m)
    var reachable = reachable_libs(prog)
    argv = append_reachable_link_flags(argv, m, reachable)
    argv = append_reachable_os_lib_flags(argv, m, keys, reachable)
    argv = append_macho_plist_section(argv, binary, m)
    run_direct_link([..argv, "-o", binary])
}

const PE_UCRT_DEFAULTLIB: str = "/defaultlib:libcmt"

const PE_SUBSYSTEM_CONSOLE: str = "/subsystem:console"

const PE_REPRODUCIBLE_FLAG: str = "/Brepro"

const PE_STACK_RESERVE_FLAG: str = "/stack:16777216"

fn link_object_pe_direct(objfile: str, binary: str, m: Manifest, prog: checker::TProgram): i32 {
    var objs = match compile_runtime_objects(binary, m, prog) { RuntimeObjects as o => o; error as e => return fail("", e.message) }
    var ld = match resolve_linker(LinkArch::X8664, LinkFormat::Pe) { str as s => s; error as e => return fail("", e.message) }
    var argv: []str = [
        ld, "/nologo", PE_SUBSYSTEM_CONSOLE, PE_REPRODUCIBLE_FLAG, PE_STACK_RESERVE_FLAG, PE_UCRT_DEFAULTLIB,
        objfile, objs.rt_obj, objs.assert_obj
    ]
    var keys = link_target_keys(m)
    var reachable = reachable_libs(prog)
    argv = append_reachable_link_flags(argv, m, reachable)
    argv = append_reachable_os_lib_flags(argv, m, keys, reachable)
    run_direct_link([..argv, teko::str::concat("/out:", binary)])
}

fn plist_xml(m: Manifest): str {
    var ver = if m.version != "" { m.version } else { "0.0.0.0" }
    var info = if m.description != "" { teko::str::concat(m.name, " — ", m.description) } else { m.name }
    teko::str::concat(
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n",
        teko::str::concat(
            teko::str::concat("  <key>CFBundleName</key><string>", m.name, "</string>\n"),
            teko::str::concat(
                teko::str::concat("  <key>CFBundleIdentifier</key><string>org.teko.", m.name, "</string>\n"),
                teko::str::concat(
                    teko::str::concat("  <key>CFBundleShortVersionString</key><string>", ver, "</string>\n"),
                    teko::str::concat(
                        teko::str::concat("  <key>CFBundleVersion</key><string>", ver, "</string>\n"),
                        teko::str::concat("  <key>CFBundleGetInfoString</key><string>", info, "</string>\n</dict>\n</plist>\n"))))))
}

fn write_tkh_sidecar(prog: checker::TProgram, path: str) {
    var table = checker::type_table_of(prog)
    match emit::emit_tkh_file(prog, table, path) { error => { }; null => { } }
}

fn tkh_bytes_of(prog: checker::TProgram, table: checker::TypeTable, od: str, name: str): []byte | error {
    var tmp_path = teko::str::concat(od, "/.", teko::str::concat(name, ".tkh.tmp"))
    match emit::emit_tkh_file(prog, table, tmp_path) { error as e => return e; null => { } }
    var bytes = match teko::io::read_stream(tmp_path) { []byte as b => b; error as e => return e }
    match teko::fs::remove_file(tmp_path) { error => { }; null => { } }
    bytes
}

fn backend(dir: str, stem: str, out_dir: str, prog: checker::TProgram, m: Manifest, opt: i32, tty: bool, debug: DebugInfo): i32 {
    match validate_extern_libs_for_target(m) { error as e => return fail(dir, e.message); null => { } }
    if m.artifact == Artifact::Static {
        return emit_static_lib(dir, stem, out_dir, prog, m)
    }
    if m.artifact == Artifact::Shared {
        return fail(dir, "shared library output (.dylib/.so/.dll) is not yet implemented")
    }
    if m.artifact == Artifact::Package {
        var od = if out_dir.len > 0 && out_dir[out_dir.len - 1] == b'/' { out_dir.slice_to(out_dir.len - 1) } else { out_dir }
        match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
        var table = checker::type_table_of(prog)
        var tkh_bytes = match tkh_bytes_of(prog, table, od, m.name) {
            []byte as b => b
            error as e => return fail(dir, e.message)
        }
        var tkb_bytes = match emit::serialize_program(prog) { []byte as b => b; error as e => return fail(dir, e.message) }
        var tsym_str = codegen::tk_emit_tsym(prog)
        var tsym_bytes: [tsym_str.len]byte = []
        var k = 0
        loop {
            if k >= tsym_str.len { break }
            tsym_bytes[k] = tsym_str[k]
            k++
        }
        var entries: []compress::ZipEntry = [
            compress::ZipEntry { name = teko::str::concat(m.name, ".tkh"); data = tkh_bytes },
            compress::ZipEntry { name = teko::str::concat(m.name, ".tkb"); data = tkb_bytes },
            compress::ZipEntry { name = teko::str::concat(m.name, ".tsym"); data = tsym_bytes }
        ]
        var zip_bytes = compress::write_zip(entries)
        var ver = if m.version == "" { "0.0.0" } else { m.version }
        var tkl_name = teko::str::concat(m.name, "-", teko::str::concat(ver, ".tkl"))
        var tkl_path = teko::str::concat(od, "/", tkl_name)
        match teko::io::write_file_bytes(tkl_path, zip_bytes) {
            error as e => return fail(dir, e.message)
            null => { }
        }
        teko::io::println(teko::str::concat("teko: ", dir, teko::str::concat(": packaged ", tkl_path, "")))
        return 0
    }
    if m.backend == Backend::Native {
        return emit_native(dir, stem, out_dir, prog, m, debug)
    }
    var mode = report_mode(false, tty)
    if m.abi == "c" {
        match codegen::check_ffi_export(prog) { null => { }; error as e => return fail(dir, e.message) }
    }
    var od = strip_trailing_slash(out_dir)
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    var cfile = teko::str::concat(od, "/", teko::str::concat(stem, ".c"))
    var binp = binary_output_path(od, stem, resolved_target())
    var codegen_phase = phase_begin("codegen", count_unit_text(0, prog.items.len, "items"), mode)
    var csize = match ffi_emit_c_file(prog, m.abi, cfile, codegen::tk_emit_meta(m.name, m.version, m.suffix, m.description)) {
        u64 as n => n
        error as e => {
            phase_end_fail(codegen_phase, count_unit_text(0, prog.items.len, "items"), e.message)
            return fail(dir, e.message)
        }
    }
    phase_end_ok(codegen_phase, count_unit_text(prog.items.len, prog.items.len, "items"))
    var emit_phase = phase_begin("emit C", cfile, mode)
    phase_end_ok(emit_phase, teko::str::concat(cfile, teko::str::concat(" ", size_text(csize))))
    if m.abi == "c" {
        match ffi_write_c_header(od, stem, prog) { null => { }; error as e => return fail(dir, e.message) }
    }
    var cc_phase = phase_begin("cc", binp, mode)
    if run_cc_for_level(cfile, binp, m, prog, opt, debug) != 0 {
        phase_end_fail(cc_phase, binp, "cc failed to build the generated C")
        return fail(dir, "cc failed to build the generated C")
    }
    phase_end_ok(cc_phase, binp)
    match teko::io::write_file(teko::str::concat(binp, ".tsym"), codegen::tk_emit_tsym(prog)) { error => { }; null => { } }
    write_tkh_sidecar(prog, teko::str::concat(binp, ".tkh"))
    teko::io::println(teko::str::concat("teko: ", dir, teko::str::concat(": built ", binp, "")))
    0
}

fn backend_of(): Backend {
    if c_backend_selected() { Backend::C } else { Backend::Native }
}

const TEKO_BACKEND_C_VALUE: str = "c"

fn c_backend_selected(): bool {
    match teko::env::var("TEKO_BACKEND") { str as v => v == TEKO_BACKEND_C_VALUE; error => false }
}

type NativeTarget = enum { Arm64Macho; Arm64Linux; X8664Linux; X8664Windows }

fn unsupported_target_error(name: str): error {
    error { message = teko::str::concat(
        "unsupported TEKO_TARGET \"", name,
        "\" — supported targets: x86_64-linux (alias x86_64-elf), ",
        "x86_64-windows (aliases x86_64-win, x86_64-pe, x86_64-coff), arm64-macos, ",
        "arm64-linux (alias aarch64-linux)") }
}

fn target_from_name(name: str): NativeTarget | error {
    if name == "x86_64-linux" { return NativeTarget::X8664Linux }
    if name == "x86_64-elf" { return NativeTarget::X8664Linux }
    if name == "x86_64-windows" { return NativeTarget::X8664Windows }
    if name == "x86_64-win" { return NativeTarget::X8664Windows }
    if name == "x86_64-pe" { return NativeTarget::X8664Windows }
    if name == "x86_64-coff" { return NativeTarget::X8664Windows }
    if name == "arm64-macos" { return NativeTarget::Arm64Macho }
    if name == "arm64-linux" { return NativeTarget::Arm64Linux }
    if name == "aarch64-linux" { return NativeTarget::Arm64Linux }
    unsupported_target_error(name)
}

fn host_target_for_os_guess(os: str): NativeTarget {
    if os == "linux" { return NativeTarget::X8664Linux }
    if os == "windows" { return NativeTarget::X8664Windows }
    NativeTarget::Arm64Macho
}

fn host_target_for_os(os: str, arch: str): NativeTarget | error {
    if os == "linux" && arch == "x86_64" { return NativeTarget::X8664Linux }
    if os == "windows" && arch == "x86_64" { return NativeTarget::X8664Windows }
    if os == "macos" && arch == "arm64" { return NativeTarget::Arm64Macho }
    if os == "linux" && arch == "arm64" { return NativeTarget::Arm64Linux }
    unsupported_target_error($"{arch}-{os}")
}

fn host_default_target(): NativeTarget | error { host_target_for_os(os(), arch()) }

fn host_default_target_guess(): NativeTarget {
    match host_default_target() { NativeTarget as t => t; error => host_target_for_os_guess(os()) }
}

fn native_target(): NativeTarget | error {
    match teko::env::var("TEKO_TARGET") { str as v => target_from_name(v); error => host_default_target() }
}

fn resolved_target(): NativeTarget {
    match native_target() { NativeTarget as t => t; error => host_default_target_guess() }
}

fn target_name(t: NativeTarget): str {
    match t {
        NativeTarget::Arm64Macho => "arm64-macos"
        NativeTarget::Arm64Linux => "arm64-linux"
        NativeTarget::X8664Linux => "x86_64-linux"
        NativeTarget::X8664Windows => "x86_64-windows"
    }
}

const OBJFMT_ELF: str = "elf"

const OBJFMT_MACHO: str = "macho"

const OBJFMT_COFF: str = "coff"

fn target_objfmt(t: NativeTarget): str {
    match t {
        NativeTarget::Arm64Macho => OBJFMT_MACHO
        NativeTarget::Arm64Linux => OBJFMT_ELF
        NativeTarget::X8664Linux => OBJFMT_ELF
        NativeTarget::X8664Windows => OBJFMT_COFF
    }
}

const EXE_SUFFIX_PE: str = ".exe"

const EXE_SUFFIX_NONE: str = ""

fn executable_suffix(t: NativeTarget): str {
    if target_objfmt(t) == OBJFMT_COFF { return EXE_SUFFIX_PE }
    EXE_SUFFIX_NONE
}

fn binary_output_path(od: str, stem: str, t: NativeTarget): str {
    teko::str::concat(od, "/", teko::str::concat(stem, executable_suffix(t)))
}

const OBJ_SUFFIX: str = ".o"

fn object_output_path(od: str, stem: str): str {
    teko::str::concat(od, "/", teko::str::concat(stem, OBJ_SUFFIX))
}

fn sibling_object_path(binp: str, t: NativeTarget): str {
    var sfx = executable_suffix(t)
    if sfx.len == 0 { return teko::str::concat(binp, OBJ_SUFFIX) }
    if !binp.ends_with(sfx) { return teko::str::concat(binp, OBJ_SUFFIX) }
    teko::str::concat(binp.slice_to(binp.len - sfx.len), OBJ_SUFFIX)
}

fn links_with_cc(t: NativeTarget, pinned: bool): bool { !cross_note(t).is_cross || pinned }

fn target_links_with_cc(t: NativeTarget): bool { links_with_cc(t, teko_cc_env().len > 0) }

fn build_links_binary(t: NativeTarget, m: Manifest): bool {
    links_with_cc(t, m.cc.len > 0 || teko_cc_env().len > 0)
}

fn target_os_name(t: NativeTarget): str {
    match t {
        NativeTarget::Arm64Macho => "macos"
        NativeTarget::Arm64Linux => "linux"
        NativeTarget::X8664Linux => "linux"
        NativeTarget::X8664Windows => "windows"
    }
}

fn target_arch_name(t: NativeTarget): str {
    match t {
        NativeTarget::Arm64Macho => "arm64"
        NativeTarget::Arm64Linux => "arm64"
        NativeTarget::X8664Linux => "x86_64"
        NativeTarget::X8664Windows => "x86_64"
    }
}

type CrossNote = struct {
    is_cross: bool
    note: str
}

fn cross_note(target: NativeTarget): CrossNote {
    var host = host_default_target_guess()
    if target == host { return CrossNote { is_cross = false; note = "" } }
    CrossNote { is_cross = true; note = $"teko: cross: emitted for {target_name(target)} on host {target_name(host)} — not executed" }
}

fn cross_note_for_name(name: str): CrossNote {
    if name.len == 0 { return CrossNote { is_cross = false; note = "" } }
    match target_from_name(name) { NativeTarget as t => cross_note(t); error => CrossNote { is_cross = false; note = "" } }
}

fn resolved_cross_note(): CrossNote { cross_note(resolved_target()) }

type LinkTargetKeys = struct {
    build_os: str
    emit_os: str
    os_arch: str
}

fn link_target_keys(m: Manifest): LinkTargetKeys {
    var t = resolved_target()
    LinkTargetKeys { build_os = target_os(m); emit_os = target_os_name(t); os_arch = target_name(t) }
}

fn target_link_keys(t: NativeTarget): LinkTargetKeys {
    LinkTargetKeys { build_os = target_os_name(t); emit_os = target_os_name(t); os_arch = target_name(t) }
}

fn os_lib_key_matches(key: str, keys: LinkTargetKeys): bool {
    if key.len == 0 { return false }
    key == keys.build_os || key == keys.emit_os || key == keys.os_arch
}

fn strip_trailing_slash(dir: str): str {
    if dir.len > 0 && dir[dir.len - 1] == b'/' { return dir.slice_to(dir.len - 1) }
    dir
}

fn mkdir_p(dir: str): error | null {
    var i: u64 = 0
    loop {
        if i >= dir.len { break }
        if dir[i] == b'/' && i > 0 {
            match teko::fs::mkdir(dir.slice_to(i)) { error as e => return e; null => { } }
        }
        i = i + 1
    }
    teko::fs::mkdir(dir)
}

type DwarfFuncFact = struct {
    symbol: str
    teko_name: str
    file: str
    line: u32
    offset: u32
}

type DwarfSymLookup = struct {
    found: bool
    offset: u32
}

fn dwarf_find_text_symbol(symbols: []teko::backend::Symbol, name: str): DwarfSymLookup {
    var i: u64 = 0
    loop {
        if i >= symbols.len { break }
        var s = symbols[i]
        if s.defined && !s.local && s.sect == (1 to u8) && s.name == name { return DwarfSymLookup { found = true; offset = s.offset } }
        i = i + 1
    }
    DwarfSymLookup { found = false; offset = 0 to u32 }
}

fn dwarf_qualified_name(f: checker::TFunction): str {
    if f.namespace.len == 0 { return f.name }
    teko::str::concat(f.namespace, "::", f.name)
}

fn dwarf_func_fact_of(f: checker::TFunction, symbols: []teko::backend::Symbol): DwarfFuncFact | null {
    if f.is_extern { return null }
    var sym = teko::lir::mangle_fn_symbol(f.namespace, f.name, false, f.overload_suffix)
    var hit = dwarf_find_text_symbol(symbols, sym)
    if !hit.found { return null }
    DwarfFuncFact { symbol = sym; teko_name = dwarf_qualified_name(f); file = f.file; line = f.line; offset = hit.offset }
}

fn dwarf_collect_facts(prog: checker::TProgram, symbols: []teko::backend::Symbol): []DwarfFuncFact {
    var out: []DwarfFuncFact = []
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                match dwarf_func_fact_of(f, symbols) {
                    DwarfFuncFact as fact => out = [..out, fact]
                    null => { }
                }
            }
            _ => { }
        }
        i = i + 1
    }
    out
}

fn dwarf_insert_by_offset(sorted: []DwarfFuncFact, item: DwarfFuncFact): []DwarfFuncFact {
    var out: []DwarfFuncFact = []
    var inserted = false
    var i: u64 = 0
    loop {
        if i >= sorted.len { break }
        if !inserted && item.offset < sorted[i].offset {
            out = [..out, item]
            inserted = true
        }
        out = [..out, sorted[i]]
        i = i + 1
    }
    if !inserted { out = [..out, item] }
    out
}

fn dwarf_sort_by_offset(facts: []DwarfFuncFact): []DwarfFuncFact {
    var out: []DwarfFuncFact = []
    var i: u64 = 0
    loop {
        if i >= facts.len { break }
        out = dwarf_insert_by_offset(out, facts[i])
        i = i + 1
    }
    out
}

fn dwarf_file_index_of(files: []str, name: str): i64 {
    var i: u64 = 0
    loop {
        if i >= files.len { break }
        if files[i] == name { return (i to i64) + 1 }
        i = i + 1
    }
    0
}

fn dwarf_files_of(facts: []DwarfFuncFact): []str {
    var out: []str = []
    var i: u64 = 0
    loop {
        if i >= facts.len { break }
        if dwarf_file_index_of(out, facts[i].file) == 0 { out = [..out, facts[i].file] }
        i = i + 1
    }
    out
}

fn dwarf_code_size_of(facts: []DwarfFuncFact, i: u64, text_len: u64): u64 {
    if i + 1 < facts.len { return (facts[i + 1].offset - facts[i].offset) to u64 }
    text_len - (facts[i].offset to u64)
}

fn dwarf_subprograms_of(facts: []DwarfFuncFact, files: []str, text_len: u64): []teko::backend::DwSubprogram {
    var out: []teko::backend::DwSubprogram = []
    var i: u64 = 0
    loop {
        if i >= facts.len { break }
        var f = facts[i]
        out = [..out, teko::backend::DwSubprogram {
            name = f.teko_name
            decl_file = dwarf_file_index_of(files, f.file)
            decl_line = f.line
            symbol = f.symbol
            code_size = dwarf_code_size_of(facts, i, text_len)
        }]
        i = i + 1
    }
    out
}

fn dwarf_rows_of(facts: []DwarfFuncFact, files: []str): []teko::backend::DwLineRow {
    var out: []teko::backend::DwLineRow = []
    var i: u64 = 0
    loop {
        if i >= facts.len { break }
        var f = facts[i]
        var advance: u64 = if i == 0 { 0 to u64 } else { (f.offset - facts[i - 1].offset) to u64 }
        out = [..out, teko::backend::DwLineRow { pc_advance = advance; line = f.line; file = dwarf_file_index_of(files, f.file) }]
        i = i + 1
    }
    out
}

fn build_dwarf_sink_for(dir: str, prog: checker::TProgram, symbols: []teko::backend::Symbol, text_len: u64, debug: DebugInfo): teko::backend::DwarfSink {
    if debug != DebugInfo::Lines { return teko::backend::no_dwarf_sink() }
    var facts = dwarf_sort_by_offset(dwarf_collect_facts(prog, symbols))
    if facts.len == 0 { return teko::backend::no_dwarf_sink() }
    var files = dwarf_files_of(facts)
    var first = facts[0]
    var last = facts[facts.len - 1]
    var cu = teko::backend::DwCompileUnit {
        producer = "teko 0.3.1"
        language = 0x0c to u32
        name = files[0]
        comp_dir = dir
        text_symbol = first.symbol
        text_size = text_len
        subprograms = dwarf_subprograms_of(facts, files, text_len)
    }
    teko::backend::build_dwarf_sink(cu, files, dwarf_rows_of(facts, files), text_len - (last.offset to u64))
}

fn emit_native(dir: str, stem: str, out_dir: str, prog: checker::TProgram, m: Manifest, debug: DebugInfo): i32 {
    report_phase_rss("codegen start")
    var od = strip_trailing_slash(out_dir)
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    var target = match native_target() { NativeTarget as t => t; error as e => return fail(dir, e.message) }
    match target {
        NativeTarget::X8664Linux => emit_native_x86(dir, od, stem, prog, m, debug)
        NativeTarget::X8664Windows => emit_native_win(dir, od, stem, prog, m)
        NativeTarget::Arm64Macho => emit_native_arm64(dir, od, stem, prog, m, debug)
        NativeTarget::Arm64Linux => emit_native_arm64_linux(dir, od, stem, prog, m, debug)
    }
}

fn emit_native_arm64(dir: str, od: str, stem: str, prog: checker::TProgram, m: Manifest, debug: DebugInfo): i32 {
    emit_native_arm64_fused(dir, od, stem, prog, m, debug, (enc, dwarf) => teko::backend::emit_macho(enc, dwarf))
}

fn emit_native_arm64_linux(dir: str, od: str, stem: str, prog: checker::TProgram, m: Manifest, debug: DebugInfo): i32 {
    emit_native_arm64_fused(dir, od, stem, prog, m, debug, (enc, dwarf) => teko::backend::emit_elf_arm64(enc, dwarf))
}

extern fn region_root(): u64 = "tk_region_root_u" from "teko_rt"

extern fn region_new(parent: u64): u64 = "tk_region_new_u" from "teko_rt"

extern fn region_drop(region: u64) = "tk_region_drop_u" from "teko_rt"

extern fn region_enter(child: u64) = "tk_region_enter_u" from "teko_rt"

extern fn region_leave() = "tk_region_leave" from "teko_rt"

extern fn region_current(): u64 = "tk_region_current_u" from "teko_rt"

fn encode_lfunc_in_region_x86(f: teko::lir::LFunc): teko::backend::EncodedFuncX86 | error {
    var sel = match teko::backend::select_lfunc_x86(teko::backend::SYSV64, f) { teko::backend::MFuncX86 as x => x; error as e => return e }
    var col = match teko::backend::regalloc_func_x86(teko::backend::SYSV64, sel) { teko::backend::MFuncX86 as x => x; error as e => return e }
    teko::backend::encode_func_x86(teko::backend::SYSV64, col)
}

fn fold_lfunc_scoped_x86(mt: teko::backend::ModuleTextX86, f: teko::lir::LFunc): teko::backend::ModuleTextX86 | error {
    var child = region_new(region_root())
    region_enter(child)
    var encoded = encode_lfunc_in_region_x86(f)
    region_leave()
    match encoded {
        teko::backend::EncodedFuncX86 as ef => {
            var out = teko::backend::fold_encoded_func_x86(mt, ef)
            region_drop(child)
            out
        }
        error as e => e
    }
}

fn encode_module_fused_x86(entry: teko::lir::LModule): teko::backend::EncodedModuleX86 | error {
    var mt = teko::backend::empty_module_text_x86()
    var it = entry.funcs.iter()
    loop {
        match it.next() {
            teko::lir::LFunc as f => {
                mt = match fold_lfunc_scoped_x86(mt, f) { teko::backend::ModuleTextX86 as x => x; error as e => return e }
            }
            null => break
        }
    }
    teko::backend::finish_encoded_module_x86(mt, entry.rodata, entry.globals)
}

fn copy_str_to_current_region(s: str): str { teko::str::concat("", s) }

fn copy_bytes_to_current_region(src: []byte): []byte {
    var out: [src.len]byte = []
    var i: u64 = 0
    loop {
        if i >= src.len { break }
        out[i] = src[i]
        i++
    }
    out
}

fn copy_reloc_to_current_region_x86(r: teko::backend::RelocX86): teko::backend::RelocX86 {
    var sym = copy_str_to_current_region(r.sym)
    teko::backend::RelocX86 { offset = r.offset; sym = sym; kind = r.kind; addend = r.addend; sect = r.sect }
}

fn copy_relocs_to_current_region_x86(relocs: []teko::backend::RelocX86): []teko::backend::RelocX86 {
    var out: [relocs.len]teko::backend::RelocX86 = []
    var i: u64 = 0
    loop {
        if i >= relocs.len { break }
        out[i] = copy_reloc_to_current_region_x86(relocs[i])
        i++
    }
    out
}

fn copy_encoded_func_to_current_region_x86(ef: teko::backend::EncodedFuncX86): teko::backend::EncodedFuncX86 {
    var symbol = copy_str_to_current_region(ef.symbol)
    var bytes = copy_bytes_to_current_region(ef.bytes)
    var relocs = copy_relocs_to_current_region_x86(ef.relocs)
    teko::backend::EncodedFuncX86 { symbol = symbol; bytes = bytes; relocs = relocs }
}

fn move_encoded_funcs_to_region_x86(efs: []teko::backend::EncodedFuncX86): []teko::backend::EncodedFuncX86 {
    var out: [efs.len]teko::backend::EncodedFuncX86 = []
    var i: u64 = 0
    loop {
        if i >= efs.len { break }
        out[i] = copy_encoded_func_to_current_region_x86(efs[i])
        i++
    }
    out
}

pub fn encode_lfuncs_in_region_x86(fs: teko::collections::Chunked<teko::lir::LFunc>): []teko::backend::EncodedFuncX86 | error {
    var out: []teko::backend::EncodedFuncX86 = []
    var it = fs.iter()
    loop {
        match it.next() {
            teko::lir::LFunc as f => {
                var ef = match encode_lfunc_in_region_x86(f) { teko::backend::EncodedFuncX86 as x => x; error as e => return e }
                out = [..out, ef]
            }
            null => break
        }
    }
    out
}

fn fold_encoded_funcs_x86(mt: teko::backend::ModuleTextX86, efs: []teko::backend::EncodedFuncX86): teko::backend::ModuleTextX86 {
    var acc = mt
    var i: u64 = 0
    loop {
        if i >= efs.len { break }
        acc = teko::backend::fold_encoded_func_x86(acc, copy_encoded_func_to_current_region_x86(efs[i]))
        i++
    }
    acc
}

fn copy_ldata_reloc_to_current_region(r: teko::lir::LDataReloc): teko::lir::LDataReloc {
    var target = copy_str_to_current_region(r.target)
    teko::lir::LDataReloc { offset = r.offset; target = target }
}

fn copy_ldata_relocs_to_current_region(relocs: []teko::lir::LDataReloc): []teko::lir::LDataReloc {
    var out: [relocs.len]teko::lir::LDataReloc = []
    var i: u64 = 0
    loop {
        if i >= relocs.len { break }
        out[i] = copy_ldata_reloc_to_current_region(relocs[i])
        i++
    }
    out
}

fn copy_lrodata_to_current_region(r: teko::lir::LRodata): teko::lir::LRodata {
    var symbol = copy_str_to_current_region(r.symbol)
    var bytes = copy_bytes_to_current_region(r.bytes)
    var relocs = copy_ldata_relocs_to_current_region(r.relocs)
    teko::lir::LRodata { symbol = symbol; bytes = bytes; relocs = relocs }
}

fn commit_rodata_delta(robase: []teko::lir::LRodata, grown: []teko::lir::LRodata): []teko::lir::LRodata {
    var out = robase
    var i: u64 = robase.len
    loop {
        if i >= grown.len { break }
        out = [..out, copy_lrodata_to_current_region(grown[i])]
        i++
    }
    out
}

fn commit_loose(acc: []@TStatement(), delta: []@TStatement()): []@TStatement() {
    var out = acc
    var i: u64 = acc.len
    loop {
        if i >= delta.len { break }
        out = [..out, delta[i]]
        i++
    }
    out
}

type FusedItemOut = struct {
    encoded: []teko::backend::EncodedFuncX86
    rodata: []teko::lir::LRodata
    loose: []@TStatement()
    new_lifted_count: u64
}

fn lifted_suffix(all: []teko::lir::LFunc, from: u64): []teko::lir::LFunc {
    var out: []teko::lir::LFunc = []
    var i: u64 = from
    loop {
        if i >= all.len { break }
        out = [..out, all[i]]
        i++
    }
    out
}

fn concat_lfuncs(a: teko::collections::Chunked<teko::lir::LFunc>, b: []teko::lir::LFunc): teko::collections::Chunked<teko::lir::LFunc> {
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        a.push(b[i])
        i++
    }
    a
}

fn frame_escape_window(fs: teko::collections::Chunked<teko::lir::LFunc>): null | error {
    teko::lir::frame_escape_guard(teko::lir::LModule { funcs = fs; rodata = []; globals = []; layouts = [] })
}

fn extend_lifted_placeholders(ph: []teko::lir::LFunc, count: u64): []teko::lir::LFunc {
    var out = ph
    var i: u64 = 0
    loop {
        if i >= count { break }
        out = [..out, teko::lir::new_func("", 0, [], teko::lir::LType::Void)]
        i++
    }
    out
}

fn fuse_lower_item_x86(rodata_base: u64, prelude: teko::lir::LowerPrelude, loose: []@TStatement(), it: @TItem(), lifted_base: u64): FusedItemOut | error {
    var seed = teko::lir::LModule { funcs = teko::collections::Chunked<teko::lir::LFunc>::make(); rodata = []; globals = prelude.module.globals; layouts = prelude.module.layouts }
    var step = match teko::lir::lower_item(seed, loose, it, prelude.layouts, prelude.enums, [], prelude.externs, false, prelude.variants, prelude.table, prelude.ref_fns, prelude.field_decls, rodata_base, prelude.module.rodata, lifted_base) { teko::lir::LowerItemOut as x => x; error as e => return e }
    var item_funcs = concat_lfuncs(step.module.funcs, step.lifted)
    match frame_escape_window(item_funcs) { error as e => return e; null => { } }
    var encoded = match encode_lfuncs_in_region_x86(item_funcs) { []teko::backend::EncodedFuncX86 as x => x; error as e => return e }
    FusedItemOut { encoded = encoded; rodata = step.module.rodata; loose = step.loose; new_lifted_count = step.lifted.len }
}

fn fuse_virtual_main_x86(loose: []@TStatement(), prelude: teko::lir::LowerPrelude, rodata_base: u64, lifted_base: u64): FusedItemOut | error {
    var vmain = match teko::lir::lower_virtual_main(loose, prelude.layouts, prelude.enums, [], [], prelude.externs, false, prelude.variants, prelude.ref_fns, prelude.field_decls, prelude.table, rodata_base, prelude.module.rodata, lifted_base) { teko::lir::LoweredFunction as x => x; error as e => return e }
    var seed = teko::lir::LModule { funcs = teko::lir::funcs_of(vmain.func); rodata = vmain.rodata; globals = prelude.module.globals; layouts = prelude.module.layouts }
    var wrapped = match teko::lir::wrap_native_entry(seed) { teko::lir::LModule as x => x; error as e => return e }
    var all_funcs = concat_lfuncs(wrapped.funcs, vmain.lifted)
    match frame_escape_window(all_funcs) { error as e => return e; null => { } }
    var encoded = match encode_lfuncs_in_region_x86(all_funcs) { []teko::backend::EncodedFuncX86 as x => x; error as e => return e }
    FusedItemOut { encoded = encoded; rodata = vmain.rodata; loose = []; new_lifted_count = vmain.lifted.len }
}

fn native_trace_items_enabled(): bool {
    match teko::env::var("TEKO_NATIVE_TRACE_ITEMS") { str as v => v == "1"; error => false }
}

fn item_trace_label(it: @TItem()): str {
    match it {
        checker::TFunction as f => teko::str::concat("fn ", teko::str::concat(f.namespace, teko::str::concat("::", f.name)))
        checker::TConstDecl as c => teko::str::concat("const ", teko::str::concat(c.namespace, teko::str::concat("::", c.name)))
        parser::TypeDecl as td => teko::str::concat("type ", td.name)
        _ => "loose statement / use"
    }
}

fn ns_delta_str(start_ns: i64, end_ns: i64): str {
    teko::str::concat(teko::i64_to_str(end_ns - start_ns), "ns")
}

fn trace_native_item(i: u64, total: u64, it: @TItem()): i64 {
    if !native_trace_items_enabled() { return 0 }
    teko::io::eprint(teko::str::concat("teko: native-lowering item ", teko::str::concat(teko::u64_to_str(i + 1), teko::str::concat("/", teko::str::concat(teko::u64_to_str(total), teko::str::concat(": ", item_trace_label(it)))))))
    teko::time::monotonic_ns()
}

fn trace_native_vmain(): i64 {
    if !native_trace_items_enabled() { return 0 }
    teko::io::eprint("teko: native-lowering item (virtual-main)")
    teko::time::monotonic_ns()
}

fn trace_native_item_done(start_ns: i64) {
    if !native_trace_items_enabled() { return }
    teko::io::eprintln(teko::str::concat(" | ", ns_delta_str(start_ns, teko::time::monotonic_ns())))
}

fn native_region_check_enabled(): bool {
    match teko::env::var("TEKO_NATIVE_REGION_CHECK") { str as v => v == "1"; error => false }
}

fn check_current_region_is_root(checkpoint: str): error | null {
    if !native_region_check_enabled() { return null }
    var cur = region_current()
    var root = region_root()
    if cur == root { return null }
    error { message = teko::str::concat("TEKO_NATIVE_REGION_CHECK: current region is not the root after region_leave() at ", teko::str::concat(checkpoint, teko::str::concat(" — current=", teko::str::concat(teko::u64_to_str(cur), teko::str::concat(" root=", teko::u64_to_str(root)))))) }
}

fn native_item_label(i: u64, total: u64): str {
    teko::str::concat("item ", teko::str::concat(teko::u64_to_str(i + 1), teko::str::concat("/", teko::u64_to_str(total))))
}

type ItemTextX86 = struct {
    encoded: []teko::backend::EncodedFuncX86
    rodata: []teko::lir::LRodata
}

fn move_rodata_to_region(rs: []teko::lir::LRodata): []teko::lir::LRodata {
    var out: [rs.len]teko::lir::LRodata = []
    var i: u64 = 0
    loop {
        if i >= rs.len { break }
        out[i] = copy_lrodata_to_current_region(rs[i])
        i++
    }
    out
}

fn count_rodata_total(prelude: []teko::lir::LRodata, results: []ItemTextX86): u64 {
    var n: u64 = prelude.len
    var i: u64 = 0
    loop {
        if i >= results.len { break }
        n = n + results[i].rodata.len
        i++
    }
    n
}

fn place_rodata(dst: ref []teko::lir::LRodata, src: []teko::lir::LRodata, at: u64): u64 {
    var i: u64 = 0
    var out = at
    loop {
        if i >= src.len { break }
        dst[out] = src[i]
        out++
        i++
    }
    out
}

fn assemble_rodata(prelude: []teko::lir::LRodata, results: []ItemTextX86): []teko::lir::LRodata {
    var total = count_rodata_total(prelude, results)
    var out: [total]teko::lir::LRodata = []
    var at = place_rodata(out, prelude, 0)
    var i: u64 = 0
    loop {
        if i >= results.len { break }
        at = place_rodata(out, results[i].rodata, at)
        i++
    }
    out
}

fn count_funcs_x86(results: []ItemTextX86): u64 {
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i >= results.len { break }
        n = n + results[i].encoded.len
        i++
    }
    n
}

fn count_text_bytes_x86(results: []ItemTextX86): u64 {
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i >= results.len { break }
        var efs = results[i].encoded
        var f: u64 = 0
        loop {
            if f >= efs.len { break }
            n = n + efs[f].bytes.len
            f++
        }
        i++
    }
    n
}

fn count_relocs_x86(results: []ItemTextX86): u64 {
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i >= results.len { break }
        var efs = results[i].encoded
        var f: u64 = 0
        loop {
            if f >= efs.len { break }
            n = n + efs[f].relocs.len
            f++
        }
        i++
    }
    n
}

type AssemblyCursorX86 = struct {
    text_off: u32
    fi: u64
    ti: u64
    ri: u64
}

fn place_func_bytes_x86(text: ref []byte, ef: teko::backend::EncodedFuncX86, ti: u64): u64 {
    var b: u64 = 0
    var out = ti
    loop {
        if b >= ef.bytes.len { break }
        text[out] = ef.bytes[b]
        out++
        b++
    }
    out
}

fn place_func_relocs_x86(relocs: ref []teko::backend::RelocX86, ef: teko::backend::EncodedFuncX86, ri: u64, base_off: u32): u64 {
    var r: u64 = 0
    var out = ri
    loop {
        if r >= ef.relocs.len { break }
        var rr = ef.relocs[r]
        relocs[out] = teko::backend::RelocX86 { offset = rr.offset + base_off; sym = rr.sym; kind = rr.kind; addend = rr.addend; sect = rr.sect }
        out++
        r++
    }
    out
}

fn func_symbol_x86(ef: teko::backend::EncodedFuncX86, off: u32): teko::backend::Symbol {
    teko::backend::Symbol { name = ef.symbol; defined = true; sect = 1 to u8; offset = off; local = false }
}

fn assemble_item_text_x86(text: ref []byte, syms: ref []teko::backend::Symbol, relocs: ref []teko::backend::RelocX86, efs: []teko::backend::EncodedFuncX86, cur: AssemblyCursorX86): AssemblyCursorX86 {
    var c = cur
    var f: u64 = 0
    loop {
        if f >= efs.len { break }
        var ef = efs[f]
        syms[c.fi] = func_symbol_x86(ef, c.text_off)
        var nt = place_func_bytes_x86(text, ef, c.ti)
        var nr = place_func_relocs_x86(relocs, ef, c.ri, c.text_off)
        c = AssemblyCursorX86 { text_off = c.text_off + (ef.bytes.len to u32); fi = c.fi + 1; ti = nt; ri = nr }
        f++
    }
    c
}

fn assemble_module_text_x86(results: []ItemTextX86): teko::backend::ModuleTextX86 {
    var nt = count_text_bytes_x86(results)
    var nf = count_funcs_x86(results)
    var nr = count_relocs_x86(results)
    var text: [nt]byte = []
    var syms: [nf]teko::backend::Symbol = []
    var relocs: [nr]teko::backend::RelocX86 = []
    var cur = AssemblyCursorX86 { text_off = 0 to u32; fi = 0; ti = 0; ri = 0 }
    var i: u64 = 0
    loop {
        if i >= results.len { break }
        cur = assemble_item_text_x86(text, syms, relocs, results[i].encoded, cur)
        i++
    }
    teko::backend::ModuleTextX86 { text = text; relocs = relocs; syms = syms; text_off = cur.text_off }
}

fn emit_native_x86(dir: str, od: str, stem: str, prog: checker::TProgram, m: Manifest, debug: DebugInfo): i32 {
    var prelude = match teko::lir::lower_prelude(prog, false) { teko::lir::LowerPrelude as x => x; error as e => return fail(dir, e.message) }
    var robase = prelude.module.rodata
    var loose: []@TStatement() = []
    var lifted_base: u64 = 0
    var rodata_base: u64 = robase.len
    var results: [prog.items.len + 1]ItemTextX86 = []
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        var t0 = trace_native_item(i, prog.items.len, prog.items[i])
        var child = region_new(region_root())
        region_enter(child)
        var outcome = fuse_lower_item_x86(rodata_base, prelude, loose, prog.items[i], lifted_base)
        region_leave()
        match outcome {
            FusedItemOut as out => {
                match check_current_region_is_root(native_item_label(i, prog.items.len)) { error as e => return fail(dir, e.message); null => { } }
                results[i] = ItemTextX86 { encoded = move_encoded_funcs_to_region_x86(out.encoded); rodata = move_rodata_to_region(out.rodata) }
                rodata_base = rodata_base + out.rodata.len
                loose = commit_loose(loose, out.loose)
                lifted_base = lifted_base + out.new_lifted_count
                region_drop(child)
                trace_native_item_done(t0)
            }
            error as e => return fail(dir, e.message)
        }
        i++
    }
    var vt0 = trace_native_vmain()
    var vchild = region_new(region_root())
    region_enter(vchild)
    var vmain_outcome = fuse_virtual_main_x86(loose, prelude, rodata_base, lifted_base)
    region_leave()
    match vmain_outcome {
        FusedItemOut as out => {
            match check_current_region_is_root("virtual-main") { error as e => return fail(dir, e.message); null => { } }
            results[prog.items.len] = ItemTextX86 { encoded = move_encoded_funcs_to_region_x86(out.encoded); rodata = move_rodata_to_region(out.rodata) }
            region_drop(vchild)
            trace_native_item_done(vt0)
            match teko::backend::finish_encoded_module_x86(assemble_module_text_x86(results), assemble_rodata(robase, results), prelude.module.globals) {
                teko::backend::EncodedModuleX86 as enc => {
                    var dwarf = build_dwarf_sink_for(dir, prog, enc.symbols, enc.text.len, debug)
                    finish_native_object(dir, od, stem, teko::backend::emit_elf(enc, dwarf), prog, m)
                }
                error as e => fail(dir, e.message)
            }
        }
        error as e => fail(dir, e.message)
    }
}

fn copy_reloc_to_current_region_arm64(r: teko::backend::Reloc): teko::backend::Reloc {
    teko::backend::Reloc { offset = r.offset; sym = copy_str_to_current_region(r.sym); kind = r.kind; sect = r.sect }
}

fn copy_relocs_to_current_region_arm64(relocs: []teko::backend::Reloc): []teko::backend::Reloc {
    var out: []teko::backend::Reloc = []
    var i: u64 = 0
    loop {
        if i >= relocs.len { break }
        out = [..out, copy_reloc_to_current_region_arm64(relocs[i])]
        i++
    }
    out
}

fn copy_encoded_func_to_current_region_arm64(ef: teko::backend::EncodedFunc): teko::backend::EncodedFunc {
    var symbol = copy_str_to_current_region(ef.symbol)
    var relocs = copy_relocs_to_current_region_arm64(ef.relocs)
    teko::backend::EncodedFunc { symbol = symbol; words = ef.words; relocs = relocs }
}

fn encode_lfunc_in_region_arm64(f: teko::lir::LFunc): teko::backend::EncodedFunc | error {
    var sel = match teko::backend::select_lfunc(f) { teko::backend::MFunc as x => x; error as e => return e }
    var col = match teko::backend::regalloc_func(teko::backend::AAPCS64, sel) { teko::backend::MFunc as x => x; error as e => return e }
    teko::backend::encode_func(teko::backend::AAPCS64, col)
}

pub fn encode_lfuncs_in_region_arm64(fs: teko::collections::Chunked<teko::lir::LFunc>): []teko::backend::EncodedFunc | error {
    var out: []teko::backend::EncodedFunc = []
    var it = fs.iter()
    loop {
        match it.next() {
            teko::lir::LFunc as f => {
                var ef = match encode_lfunc_in_region_arm64(f) { teko::backend::EncodedFunc as x => x; error as e => return e }
                out = [..out, ef]
            }
            null => break
        }
    }
    out
}

fn fold_encoded_funcs_arm64(mt: teko::backend::ModuleText, efs: []teko::backend::EncodedFunc): teko::backend::ModuleText {
    var acc = mt
    var i: u64 = 0
    loop {
        if i >= efs.len { break }
        acc = teko::backend::fold_encoded_func(acc, copy_encoded_func_to_current_region_arm64(efs[i]))
        i++
    }
    acc
}

type FusedItemOutArm64 = struct {
    encoded: []teko::backend::EncodedFunc
    rodata: []teko::lir::LRodata
    loose: []@TStatement()
    new_lifted_count: u64
}

fn fuse_lower_item_arm64(robase: []teko::lir::LRodata, prelude: teko::lir::LowerPrelude, loose: []@TStatement(), it: @TItem(), lifted_ph: []teko::lir::LFunc): FusedItemOutArm64 | error {
    var seed = teko::lir::LModule { funcs = teko::collections::Chunked<teko::lir::LFunc>::make(); rodata = robase; globals = prelude.module.globals; layouts = prelude.module.layouts }
    var step = match teko::lir::lower_item(seed, loose, it, prelude.layouts, prelude.enums, lifted_ph, prelude.externs, false, prelude.variants, prelude.table, prelude.ref_fns, prelude.field_decls) { teko::lir::LowerItemOut as x => x; error as e => return e }
    var new_lifted = lifted_suffix(step.lifted, lifted_ph.len)
    var item_funcs = concat_lfuncs(step.module.funcs, new_lifted)
    match frame_escape_window(item_funcs) { error as e => return e; null => { } }
    var encoded = match encode_lfuncs_in_region_arm64(item_funcs) { []teko::backend::EncodedFunc as x => x; error as e => return e }
    FusedItemOutArm64 { encoded = encoded; rodata = step.module.rodata; loose = step.loose; new_lifted_count = new_lifted.len }
}

fn fuse_virtual_main_arm64(loose: []@TStatement(), prelude: teko::lir::LowerPrelude, robase: []teko::lir::LRodata, lifted_ph: []teko::lir::LFunc): FusedItemOutArm64 | error {
    var vmain = match teko::lir::lower_virtual_main(loose, prelude.layouts, prelude.enums, robase, lifted_ph, prelude.externs, false, prelude.variants, prelude.ref_fns, prelude.field_decls, prelude.table) { teko::lir::LoweredFunction as x => x; error as e => return e }
    var new_lifted = lifted_suffix(vmain.lifted, lifted_ph.len)
    var seed = teko::lir::LModule { funcs = teko::lir::funcs_of(vmain.func); rodata = vmain.rodata; globals = prelude.module.globals; layouts = prelude.module.layouts }
    var wrapped = match teko::lir::wrap_native_entry(seed) { teko::lir::LModule as x => x; error as e => return e }
    var all_funcs = concat_lfuncs(wrapped.funcs, new_lifted)
    match frame_escape_window(all_funcs) { error as e => return e; null => { } }
    var encoded = match encode_lfuncs_in_region_arm64(all_funcs) { []teko::backend::EncodedFunc as x => x; error as e => return e }
    FusedItemOutArm64 { encoded = encoded; rodata = vmain.rodata; loose = []; new_lifted_count = new_lifted.len }
}

type NativeObjectWriterArm64 = func<teko::backend::EncodedModule, teko::backend::DwarfSink, []byte>

fn emit_native_arm64_fused(dir: str, od: str, stem: str, prog: checker::TProgram, m: Manifest, debug: DebugInfo, writer: NativeObjectWriterArm64): i32 {
    var prelude = match teko::lir::lower_prelude(prog, false) { teko::lir::LowerPrelude as x => x; error as e => return fail(dir, e.message) }
    var robase = prelude.module.rodata
    var loose: []@TStatement() = []
    var lifted_ph: []teko::lir::LFunc = []
    var mt = teko::backend::empty_module_text()
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        var t0 = trace_native_item(i, prog.items.len, prog.items[i])
        var child = region_new(region_root())
        region_enter(child)
        var outcome = fuse_lower_item_arm64(robase, prelude, loose, prog.items[i], lifted_ph)
        region_leave()
        match outcome {
            FusedItemOutArm64 as out => {
                match check_current_region_is_root(native_item_label(i, prog.items.len)) { error as e => return fail(dir, e.message); null => { } }
                mt = fold_encoded_funcs_arm64(mt, out.encoded)
                robase = commit_rodata_delta(robase, out.rodata)
                loose = commit_loose(loose, out.loose)
                lifted_ph = extend_lifted_placeholders(lifted_ph, out.new_lifted_count)
                region_drop(child)
                trace_native_item_done(t0)
            }
            error as e => return fail(dir, e.message)
        }
        i++
    }
    var vt0 = trace_native_vmain()
    var vchild = region_new(region_root())
    region_enter(vchild)
    var vmain_outcome = fuse_virtual_main_arm64(loose, prelude, robase, lifted_ph)
    region_leave()
    match vmain_outcome {
        FusedItemOutArm64 as out => {
            match check_current_region_is_root("virtual-main") { error as e => return fail(dir, e.message); null => { } }
            mt = fold_encoded_funcs_arm64(mt, out.encoded)
            robase = commit_rodata_delta(robase, out.rodata)
            region_drop(vchild)
            trace_native_item_done(vt0)
            match teko::backend::finish_encoded_module(mt, robase, prelude.module.globals) {
                teko::backend::EncodedModule as enc => {
                    var dwarf = build_dwarf_sink_for(dir, prog, enc.symbols, enc.text.len, debug)
                    finish_native_object(dir, od, stem, writer(enc, dwarf), prog, m)
                }
                error as e => fail(dir, e.message)
            }
        }
        error as e => fail(dir, e.message)
    }
}

fn encode_lfunc_in_region_win(f: teko::lir::LFunc): teko::backend::EncodedFuncX86 | error {
    var sel = match teko::backend::select_lfunc_x86(teko::backend::WIN64, f) { teko::backend::MFuncX86 as x => x; error as e => return e }
    var col = match teko::backend::regalloc_func_x86(teko::backend::WIN64, sel) { teko::backend::MFuncX86 as x => x; error as e => return e }
    teko::backend::encode_func_x86(teko::backend::WIN64, col)
}

pub fn encode_lfuncs_in_region_win(fs: teko::collections::Chunked<teko::lir::LFunc>): []teko::backend::EncodedFuncX86 | error {
    var out: []teko::backend::EncodedFuncX86 = []
    var it = fs.iter()
    loop {
        match it.next() {
            teko::lir::LFunc as f => {
                var ef = match encode_lfunc_in_region_win(f) { teko::backend::EncodedFuncX86 as x => x; error as e => return e }
                out = [..out, ef]
            }
            null => break
        }
    }
    out
}

fn fuse_lower_item_win(robase: []teko::lir::LRodata, prelude: teko::lir::LowerPrelude, loose: []@TStatement(), it: @TItem(), lifted_ph: []teko::lir::LFunc): FusedItemOut | error {
    var seed = teko::lir::LModule { funcs = teko::collections::Chunked<teko::lir::LFunc>::make(); rodata = robase; globals = prelude.module.globals; layouts = prelude.module.layouts }
    var step = match teko::lir::lower_item(seed, loose, it, prelude.layouts, prelude.enums, lifted_ph, prelude.externs, false, prelude.variants, prelude.table, prelude.ref_fns, prelude.field_decls) { teko::lir::LowerItemOut as x => x; error as e => return e }
    var new_lifted = lifted_suffix(step.lifted, lifted_ph.len)
    var item_funcs = concat_lfuncs(step.module.funcs, new_lifted)
    match frame_escape_window(item_funcs) { error as e => return e; null => { } }
    var encoded = match encode_lfuncs_in_region_win(item_funcs) { []teko::backend::EncodedFuncX86 as x => x; error as e => return e }
    FusedItemOut { encoded = encoded; rodata = step.module.rodata; loose = step.loose; new_lifted_count = new_lifted.len }
}

fn fuse_virtual_main_win(loose: []@TStatement(), prelude: teko::lir::LowerPrelude, robase: []teko::lir::LRodata, lifted_ph: []teko::lir::LFunc): FusedItemOut | error {
    var vmain = match teko::lir::lower_virtual_main(loose, prelude.layouts, prelude.enums, robase, lifted_ph, prelude.externs, false, prelude.variants, prelude.ref_fns, prelude.field_decls, prelude.table) { teko::lir::LoweredFunction as x => x; error as e => return e }
    var new_lifted = lifted_suffix(vmain.lifted, lifted_ph.len)
    var seed = teko::lir::LModule { funcs = teko::lir::funcs_of(vmain.func); rodata = vmain.rodata; globals = prelude.module.globals; layouts = prelude.module.layouts }
    var wrapped = match teko::lir::wrap_native_entry(seed) { teko::lir::LModule as x => x; error as e => return e }
    var all_funcs = concat_lfuncs(wrapped.funcs, new_lifted)
    match frame_escape_window(all_funcs) { error as e => return e; null => { } }
    var encoded = match encode_lfuncs_in_region_win(all_funcs) { []teko::backend::EncodedFuncX86 as x => x; error as e => return e }
    FusedItemOut { encoded = encoded; rodata = vmain.rodata; loose = []; new_lifted_count = new_lifted.len }
}

fn emit_native_win(dir: str, od: str, stem: str, prog: checker::TProgram, m: Manifest): i32 {
    var prelude = match teko::lir::lower_prelude(prog, false) { teko::lir::LowerPrelude as x => x; error as e => return fail(dir, e.message) }
    var robase = prelude.module.rodata
    var loose: []@TStatement() = []
    var lifted_ph: []teko::lir::LFunc = []
    var mt = teko::backend::empty_module_text_x86()
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        var t0 = trace_native_item(i, prog.items.len, prog.items[i])
        var child = region_new(region_root())
        region_enter(child)
        var outcome = fuse_lower_item_win(robase, prelude, loose, prog.items[i], lifted_ph)
        region_leave()
        match outcome {
            FusedItemOut as out => {
                match check_current_region_is_root(native_item_label(i, prog.items.len)) { error as e => return fail(dir, e.message); null => { } }
                mt = fold_encoded_funcs_x86(mt, out.encoded)
                robase = commit_rodata_delta(robase, out.rodata)
                loose = commit_loose(loose, out.loose)
                lifted_ph = extend_lifted_placeholders(lifted_ph, out.new_lifted_count)
                region_drop(child)
                trace_native_item_done(t0)
            }
            error as e => return fail(dir, e.message)
        }
        i++
    }
    var vt0 = trace_native_vmain()
    var vchild = region_new(region_root())
    region_enter(vchild)
    var vmain_outcome = fuse_virtual_main_win(loose, prelude, robase, lifted_ph)
    region_leave()
    match vmain_outcome {
        FusedItemOut as out => {
            match check_current_region_is_root("virtual-main") { error as e => return fail(dir, e.message); null => { } }
            mt = fold_encoded_funcs_x86(mt, out.encoded)
            robase = commit_rodata_delta(robase, out.rodata)
            region_drop(vchild)
            trace_native_item_done(vt0)
            match teko::backend::finish_encoded_module_x86(mt, robase, prelude.module.globals) {
                teko::backend::EncodedModuleX86 as enc => finish_native_object(dir, od, stem, teko::backend::emit_coff(enc), prog, m)
                error as e => fail(dir, e.message)
            }
        }
        error as e => fail(dir, e.message)
    }
}

fn report_object_only(dir: str, objp: str, t: NativeTarget): i32 {
    teko::io::println($"teko: {dir}: emitted {objp} for {target_name(t)} (own backend) — not linked on host {target_name(host_default_target_guess())}: the object IS the artifact of a cross build here")
    0
}

fn finish_native_object(dir: str, od: str, stem: str, obj: []byte, prog: checker::TProgram, m: Manifest): i32 {
    var objp = object_output_path(od, stem)
    var target = resolved_target()
    var binp = binary_output_path(od, stem, target)
    match teko::io::write_file_bytes(objp, obj) { error as e => return fail(dir, e.message); null => { } }
    if !build_links_binary(target, m) { return report_object_only(dir, objp, target) }
    if link_object(objp, binp, m, prog) != 0 {
        return fail(dir, "cc failed to link the own-backend object")
    }
    match teko::io::write_file(teko::str::concat(binp, ".tsym"), codegen::tk_emit_tsym(prog)) { error => { }; null => { } }
    teko::io::println(teko::str::concat("teko: ", dir, teko::str::concat(": built ", binp, " (own backend)")))
    0
}

fn emit_static_lib(dir: str, stem: str, out_dir: str, prog: checker::TProgram, m: Manifest): i32 {
    if m.backend != Backend::Native {
        return fail(dir, "static library output (.a) needs the own-native backend (TEKO_BACKEND=native) — the C emitter never produces a `.o` to archive")
    }
    var od = strip_trailing_slash(out_dir)
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    var raw_lmod = match teko::lir::lower_program(prog, true) { teko::lir::LModule as x => x; error as e => return fail(dir, e.message) }
    var lmod = strip_virtual_main(raw_lmod)
    var target = match native_target() { NativeTarget as t => t; error as e => return fail(dir, e.message) }
    var rc = match target {
        NativeTarget::X8664Linux => emit_static_lib_x86(dir, od, stem, lmod)
        NativeTarget::Arm64Macho => emit_static_lib_macho(dir, od, stem, lmod)
        NativeTarget::Arm64Linux => emit_static_lib_arm64_linux(dir, od, stem, lmod)
        NativeTarget::X8664Windows => emit_static_lib_coff(dir, od, stem, lmod)
    }
    if rc == 0 { write_tkh_sidecar(prog, teko::str::concat(od, "/", teko::str::concat(stem, ".tkh"))) }
    rc
}

fn strip_virtual_main(lmod: teko::lir::LModule): teko::lir::LModule {
    var kept = teko::collections::Chunked<teko::lir::LFunc>::make()
    var it = lmod.funcs.iter()
    loop {
        match it.next() {
            teko::lir::LFunc as f => {
                if f.symbol != "main" { kept.push(f) }
            }
            null => break
        }
    }
    teko::lir::LModule { funcs = kept; rodata = lmod.rodata; globals = lmod.globals; layouts = lmod.layouts }
}

fn emit_static_lib_x86(dir: str, od: str, stem: str, lmod: teko::lir::LModule): i32 {
    var sel = match teko::backend::select_module_x86(teko::backend::SYSV64, lmod) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    var col = match teko::backend::regalloc_module_x86(teko::backend::SYSV64, sel) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    var enc = match teko::backend::encode_module_x86(teko::backend::SYSV64, col) { teko::backend::EncodedModuleX86 as x => x; error as e => return fail(dir, e.message) }
    finish_static_archive(dir, od, stem, teko::backend::emit_elf(enc, teko::backend::no_dwarf_sink()), enc.symbols, ArchiveFormat::Gnu)
}

fn emit_static_lib_macho(dir: str, od: str, stem: str, lmod: teko::lir::LModule): i32 {
    var sel = match teko::backend::select_module(lmod) { teko::backend::MModule as x => x; error as e => return fail(dir, e.message) }
    var col = match teko::backend::regalloc_module(teko::backend::AAPCS64, sel) { teko::backend::MModule as x => x; error as e => return fail(dir, e.message) }
    var enc = match teko::backend::encode_module(teko::backend::AAPCS64, col) { teko::backend::EncodedModule as x => x; error as e => return fail(dir, e.message) }
    finish_static_archive(dir, od, stem, teko::backend::emit_macho(enc, teko::backend::no_dwarf_sink()), enc.symbols, ArchiveFormat::Bsd)
}

fn emit_static_lib_arm64_linux(dir: str, od: str, stem: str, lmod: teko::lir::LModule): i32 {
    var sel = match teko::backend::select_module(lmod) { teko::backend::MModule as x => x; error as e => return fail(dir, e.message) }
    var col = match teko::backend::regalloc_module(teko::backend::AAPCS64, sel) { teko::backend::MModule as x => x; error as e => return fail(dir, e.message) }
    var enc = match teko::backend::encode_module(teko::backend::AAPCS64, col) { teko::backend::EncodedModule as x => x; error as e => return fail(dir, e.message) }
    finish_static_archive(dir, od, stem, teko::backend::emit_elf_arm64(enc, teko::backend::no_dwarf_sink()), enc.symbols, ArchiveFormat::Gnu)
}

fn emit_static_lib_coff(dir: str, od: str, stem: str, lmod: teko::lir::LModule): i32 {
    var sel = match teko::backend::select_module_x86(teko::backend::WIN64, lmod) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    var col = match teko::backend::regalloc_module_x86(teko::backend::WIN64, sel) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    var enc = match teko::backend::encode_module_x86(teko::backend::WIN64, col) { teko::backend::EncodedModuleX86 as x => x; error as e => return fail(dir, e.message) }
    finish_static_archive(dir, od, stem, teko::backend::emit_coff(enc), enc.symbols, ArchiveFormat::Coff)
}

type ArchiveFormat = enum { Gnu; Bsd; Coff }

fn archive_output_path(od: str, stem: str, format: ArchiveFormat): str {
    match format {
        Coff => teko::str::concat(od, "/", teko::str::concat(stem, ".lib"))
        _ => teko::str::concat(od, "/", teko::str::concat("lib", teko::str::concat(stem, ".a")))
    }
}

fn wrap_archive_bytes(member_name: str, obj: []byte, symbols: []teko::backend::Symbol, format: ArchiveFormat): []byte | error {
    match format {
        Gnu => teko::backend::emit_static_archive(member_name, obj, symbols)
        Bsd => teko::backend::emit_static_archive_macho(member_name, obj, symbols)
        Coff => teko::backend::emit_static_archive_coff(member_name, obj, symbols)
    }
}

fn finish_static_archive(dir: str, od: str, stem: str, obj: []byte, symbols: []teko::backend::Symbol, format: ArchiveFormat): i32 {
    var objp = teko::str::concat(od, "/", teko::str::concat(stem, ".o"))
    var member_name = teko::str::concat(stem, ".o")
    var libp = archive_output_path(od, stem, format)
    match teko::io::write_file_bytes(objp, obj) { error as e => return fail(dir, e.message); null => { } }
    var archive = match wrap_archive_bytes(member_name, obj, symbols, format) { []byte as b => b; error as e => return fail(dir, e.message) }
    match teko::io::write_file_bytes(libp, archive) { error as e => return fail(dir, e.message); null => { } }
    teko::io::println(teko::str::concat("teko: ", dir, teko::str::concat(": built ", libp, " (own backend, static archive)")))
    0
}

fn dirname_of(path: str): str {
    var i = path.len
    loop {
        if i == 0 { break }
        i = i - 1
        var b = path[i]
        if b == b'/' || b == b'\\' { return path.slice_to(i) }
    }
    "."
}

fn basename_of(path: str): str {
    var i = path.len
    loop {
        if i == 0 { break }
        i = i - 1
        var b = path[i]
        if b == b'/' || b == b'\\' { return path.slice_from(i + 1) }
    }
    path
}

fn is_ascii_alpha(b: byte): bool {
    (b >= b'A' && b <= b'Z') || (b >= b'a' && b <= b'z')
}

fn abs_path_of(path: str, cwd: str): str {
    if path.len == 0 { return "" }
    if path[0] == b'/' { return path }
    if path.len >= 2 && is_ascii_alpha(path[0]) && path[1] == b':' { return path }
    if path.len >= 2 && path[0] == b'\\' && path[1] == b'\\' { return path }
    if cwd.len == 0 { return "" }
    teko::str::concat(cwd, "/", path)
}

fn probe_rt_dir(root: str): bool {
    match teko::io::read_file(teko::str::concat(root, "/src/runtime/teko_rt.h")) {
        str => { teko::env::set_var("TK_RT_DIR", teko::str::concat(root, "/src/runtime")); return true }
        error => { }
    }
    match teko::io::read_file(teko::str::concat(root, "/runtime/teko_rt.h")) {
        str => { teko::env::set_var("TK_RT_DIR", teko::str::concat(root, "/runtime")); return true }
        error => { }
    }
    false
}

fn home_dir(): str {
    match teko::env::var("HOME") {
        str as h => h
        error => match teko::env::var("USERPROFILE") { str as h => h; error => "" }
    }
}

fn share_rt_bases(): []str {
    var bases: []str = []
    var home = home_dir()
    if home.len > 0 { bases = [teko::str::concat(home, "/.local/share/teko")] }
    [..bases, "/usr/local/share/teko"]
}

fn probe_share_rt_dir(): bool {
    var bases = share_rt_bases()
    var i = 0
    loop {
        if i >= bases.len { break }
        if probe_rt_dir(bases[i]) { return true }
        i++
    }
    false
}

fn ensure_rt_dir_abs() {
    match teko::env::var("TK_RT_DIR") { str => return; error => { } }
    var cwd = match teko::env::cwd() { str as c => c; error => "" }

    var argv = teko::env::args()
    if argv.len > 0 {
        var exe_abs = abs_path_of(argv[0], cwd)
        if exe_abs.len > 0 {
            var bindir = dirname_of(exe_abs)
            if probe_rt_dir(dirname_of(bindir)) { return }
            if probe_rt_dir(bindir) { return }
        }
    }

    if cwd.len > 0 && probe_rt_dir(cwd) { return }
    if probe_share_rt_dir() { return }
}

fn compile_project(dir: str, out_dir: str): i32 { compile_project_g(dir, out_dir, false, false, 0, false, Backend::C, false, DebugInfo::None, false) }

fn report_peak() {
    var pb = teko::mem::peak_rss()
    if pb > 0 {
        var mb10 = pb * 10 / 1048576
        var whole = mb10 / 10
        var frac = mb10 % 10
        teko::io::println($"teko: memory: peak {whole}.{frac} MB")
    }
}

fn bytes_to_mb_tenths_str(bytes: u64): str {
    var mb10 = bytes * 10 / 1048576
    var whole = mb10 / 10
    var frac = mb10 % 10
    $"{whole}.{frac}"
}

fn phase_rss_enabled(): bool {
    match teko::env::var("TEKO_PHASE_RSS") { str as v => v == "1"; error => false }
}

fn report_phase_rss(label: str) {
    if !phase_rss_enabled() { return }
    var cur = teko::runtime::cur_rss()
    if cur == 0 { return }
    var cur_s = bytes_to_mb_tenths_str(cur)
    var peak_s = bytes_to_mb_tenths_str(teko::mem::peak_rss())
    teko::io::eprintln($"teko: memory: after {label}: cur {cur_s} MB / peak {peak_s} MB")
}

fn strip_tests(prog: checker::TProgram): checker::TProgram {
    var kept: [prog.items.len]@TItem() = []
    var count: u64 = 0
    var i = 0
    loop {
        if i >= prog.items.len { break }
        var drop = false
        match prog.items[i] {
            checker::TFunction as f => { if f.is_test { drop = true } }
            _ => { }
        }
        if !drop { kept[count] = prog.items[i]; count = count + 1 }
        i++
    }
    var trimmed: [count]@TItem() = []
    var k: u64 = 0
    loop { if k >= count { break }; trimmed[k] = kept[k]; k++ }
    checker::TProgram { items = trimmed }
}

fn artifact_path_for(out_dir: str, m: Manifest, t: NativeTarget): str {
    var out_path = teko::str::concat(strip_trailing_slash(out_dir), "/", m.name)
    if m.artifact != Artifact::Binary { return out_path }
    if m.backend != Backend::Native { return out_path }
    if build_links_binary(t, m) { return out_path }
    out_path ~ ".o"
}

fn built_artifact_path(out_dir: str, m: Manifest): str { artifact_path_for(out_dir, m, resolved_target()) }

fn report_build_done(binp: str, start: i64) {
    teko::io::eprintln(teko::str::concat("built ", binp, teko::str::concat("   ", teko::str::concat(elapsed_str(start), "s"))))
}

fn ffi_emit_c_file(prog: checker::TProgram, abi: str, out_path: str, meta: str): u64 | error {
    if abi == "c" { return codegen::tk_emit_c_export_file(prog, out_path, meta) }
    codegen::tk_emit_c_file(prog, out_path, meta)
}

fn ffi_write_c_header(od: str, stem: str, prog: checker::TProgram): error | null {
    var hsrc = match codegen::emit_c_header(prog) { str as s => s; error as e => return e }
    var hpath = teko::str::concat(od, "/", teko::str::concat(stem, ".h"))
    match teko::io::write_file(hpath, hsrc) { error as e => return e; null => { } }
    teko::io::println(teko::str::concat("teko: wrote reverse-FFI header ", hpath))
    null
}

fn codegen_and_report(dir: str, out_dir: str, prog: checker::TProgram, m: Manifest, opt: i32, tty: bool, start: i64, debug: DebugInfo): i32 {
    report_pt_census(prog)
    var rc = backend(dir, m.name, out_dir, prog, m, opt, tty, debug)
    if rc == 0 {
        report_build_done(built_artifact_path(out_dir, m), start)
        report_peak()
    }
    rc
}

fn report_pt_census(prog: checker::TProgram) {
    var c = checker::pt_census(prog)
    teko::io::println(checker::pt_census_liveness_line(c))
    teko::io::println(checker::pt_census_line(c))
}

fn build_ungated(dir: str, out_dir: str, opt: i32, tty: bool, start: i64, backend: Backend, debug: DebugInfo, explicit: bool): i32 {
    var fe = match frontend_body(false, false, tty, explicit) { Frontend as f => f; error as e => return fail(dir, e.message) }
    codegen_and_report(dir, out_dir, fe.prog, with_backend(fe.manifest, backend), opt, tty, start, debug)
}

fn unmet_coverage_floors(fcov: u64, lcov: u64, bcov: u64, floor_f: u64, floor_l: u64, floor_b: u64): []str {
    var msgs: []str = []
    if fcov < floor_f {
        msgs = [$"function coverage {fcov}% is below the {floor_f}% floor ([coverage] functions) — add tests"]
    }
    if lcov < floor_l {
        msgs = [..msgs, $"line coverage {lcov}% is below the {floor_l}% floor ([coverage] lines) — add tests"]
    }
    if bcov < floor_b {
        msgs = [..msgs, $"branch coverage {bcov}% is below the {floor_b}% floor ([coverage] branches) — add tests"]
    }
    msgs
}

fn coverage_floor_misses(fe: Frontend): []str {
    unmet_coverage_floors(coverage::coverage_pct(fe.prog), coverage::line_coverage_pct(fe.prog), coverage::branch_coverage_pct(fe.prog), fe.manifest.cov_functions, fe.manifest.cov_lines, fe.manifest.cov_branches)
}

fn coverage_floor_blocks(misses: []str, cov_validation: bool): bool {
    cov_validation && misses.len > 0
}

fn coverage_gate_result(dir: str, fe: Frontend): i32 {
    var misses = coverage_floor_misses(fe)
    if coverage_floor_blocks(misses, true) { return fail(dir, misses[0]) }
    0
}

fn warn_coverage_floors(misses: []str) {
    var i: u64 = 0
    loop {
        if i >= misses.len { break }
        teko::io::eprintln(teko::str::concat("teko: warning: ", misses[i]))
        i = i + 1
    }
}

fn enforce_coverage_floors(dir: str, fe: Frontend, cov_validation: bool): i32 {
    if cov_validation { return coverage_gate_result(dir, fe) }
    warn_coverage_floors(coverage_floor_misses(fe))
    0
}

fn coverage_floor_misses_sm(sm: coverage::SiteMap, m: Manifest): []str {
    unmet_coverage_floors(coverage::coverage_pct_of(sm), coverage::line_coverage_pct_of(sm), coverage::branch_coverage_pct_of(sm), m.cov_functions, m.cov_lines, m.cov_branches)
}

fn coverage_gate_result_sm(dir: str, sm: coverage::SiteMap, m: Manifest): i32 {
    var misses = coverage_floor_misses_sm(sm, m)
    if coverage_floor_blocks(misses, true) { return fail(dir, misses[0]) }
    0
}

fn enforce_coverage_floors_sm(dir: str, sm: coverage::SiteMap, m: Manifest, cov_validation: bool): i32 {
    if cov_validation { return coverage_gate_result_sm(dir, sm, m) }
    warn_coverage_floors(coverage_floor_misses_sm(sm, m))
    0
}

fn report_native_coverage(prog: checker::TProgram) {
    var fcov = coverage::coverage_pct(prog)
    var lcov = coverage::line_coverage_pct(prog)
    var bcov = coverage::branch_coverage_pct(prog)
    teko::io::println($"teko: coverage {fcov}% functions")
    teko::io::println($"teko: coverage {lcov}% lines")
    teko::io::println($"teko: coverage {bcov}% branches")
}

fn run_native_gate(dir: str, out_dir: str, pf: ParsedFront, m: Manifest, tty: bool): i32 {
    var od = gate_out_dir(out_dir)
    var gp = gate_paths(od, m)
    var brc = native_gate_build(dir, od, gp, pf, m, tty)
    if brc != 0 { return brc }
    native_gate_run(od, gp, false)
}

type GatePaths = struct {
    stem: str
    cfile: str
    binp: str
    covfile: str
}

fn gate_out_dir(out_dir: str): str {
    if out_dir.len > 0 && out_dir[out_dir.len - 1] == b'/' { return out_dir.slice_to(out_dir.len - 1) }
    out_dir
}

fn gate_paths(od: str, m: Manifest): GatePaths {
    var stem = teko::str::concat(m.name, "-tktest")
    GatePaths {
        stem = stem
        cfile = teko::str::concat(od, "/", teko::str::concat(stem, ".c"))
        binp = binary_output_path(od, stem, resolved_target())
        covfile = teko::str::concat(od, "/", teko::str::concat(stem, ".tkcov"))
    }
}

type TestRef = struct { namespace: str; name: str }

fn native_gate_test_refs(items: []parser::Item): []TestRef {
    var kept: [items.len]TestRef = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        match items[i].content {
            parser::Function as f => { if f.is_test { kept[count] = TestRef { namespace = items[i].namespace; name = f.name }; count = count + 1 } }
            _ => { }
        }
        i = i + 1
    }
    var out: [count]TestRef = []
    var k: u64 = 0
    loop {
        if k >= count { break }
        out[k] = kept[k]
        k = k + 1
    }
    out
}

fn native_gate_drop_statements(items: []parser::Item): []parser::Item {
    var kept: [items.len]parser::Item = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        match items[i].content {
            (@Statement()) as _dropped => { }
            _ => { kept[count] = items[i]; count = count + 1 }
        }
        i = i + 1
    }
    var out: [count]parser::Item = []
    var k: u64 = 0
    loop {
        if k >= count { break }
        out[k] = kept[k]
        k = k + 1
    }
    out
}

fn native_gate_test_label(t: TestRef): str {
    if t.namespace.len > 0 { teko::str::concat(t.namespace, "::", t.name) } else { t.name }
}

fn native_gate_harness_src(refs: []TestRef): str | error {
    var total: u64 = 0
    var i: u64 = 0
    loop {
        if i >= refs.len { break }
        total = total + native_gate_test_label(refs[i]).len + 3
        i = i + 1
    }
    var buf: [total]byte = []
    var k: u64 = 0
    var j: u64 = 0
    loop {
        if j >= refs.len { break }
        var label = native_gate_test_label(refs[j])
        var li: u64 = 0
        loop {
            if li >= label.len { break }
            buf[k] = label[li]
            k = k + 1
            li = li + 1
        }
        buf[k] = b'('
        k = k + 1
        buf[k] = b')'
        k = k + 1
        buf[k] = b'\n'
        k = k + 1
        j = j + 1
    }
    teko::text::str_from_utf8(buf)
}

fn native_gate_harness_items(proj_ns: str, src: str): []parser::Item | error {
    var tokens = match lexer::tokenize(src) { []lexer::Token as t => t; error as e => return e }
    var mf = match parser::parse_main_file(tokens, 0) { parser::Parsed<parser::MainFile> as x => x.node; error as e => return e }
    var raw = asm_main_items(mf)
    var out: [raw.len]parser::Item = []
    var i: u64 = 0
    loop {
        if i >= raw.len { break }
        out[i] = parser::Item { content = raw[i].content; namespace = proj_ns; file = "<native-test-gate>"; guard = raw[i].guard }
        i = i + 1
    }
    out
}

fn append_items(a: []parser::Item, b: []parser::Item): []parser::Item {
    var out: [a.len + b.len]parser::Item = []
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        out[i] = a[i]
        i = i + 1
    }
    var j: u64 = 0
    loop {
        if j >= b.len { break }
        out[a.len + j] = b[j]
        j = j + 1
    }
    out
}

fn unmark_test_function(f: checker::TFunction): checker::TFunction {
    checker::TFunction { overload_suffix = f.overload_suffix; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; return_type = f.return_type; body = f.body; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = f.namespace; file = f.file; line = f.line; col = f.col; is_test = false; is_extern = f.is_extern; c_symbol = f.c_symbol; from_lib = f.from_lib; ret_extra = f.ret_extra; guard = f.guard }
}

fn native_gate_unmark_tests(prog: checker::TProgram): checker::TProgram {
    var out: []@TItem() = []
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => out = [..out, if f.is_test { unmark_test_function(f) } else { f }]
            _ => out = [..out, prog.items[i]]
        }
        i = i + 1
    }
    checker::TProgram { items = out }
}

fn native_gate_program(pf: ParsedFront, tty: bool): checker::TProgram | error {
    var refs = native_gate_test_refs(pf.parsed.items)
    var kept = native_gate_drop_statements(pf.parsed.items)
    var harness_src = match native_gate_harness_src(refs) { str as s => s; error as e => return e }
    var harness_items = match native_gate_harness_items(pf.manifest.name, harness_src) {
        []parser::Item as items => items
        error as e => return e
    }
    var pf2 = ParsedFront { parsed = parser::Program { items = append_items(kept, harness_items) }; manifest = pf.manifest; diags = pf.diags; embeds = pf.embeds }
    match frontend_check(pf2, false, tty, false) { Frontend as fe => native_gate_unmark_tests(fe.prog); error as e => e }
}

fn native_gate_build(dir: str, od: str, gp: GatePaths, pf: ParsedFront, m: Manifest, tty: bool): i32 {
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    var test_prog = match native_gate_program(pf, tty) { checker::TProgram as p => p; error as e => return fail(dir, e.message) }
    emit_native(dir, gp.stem, od, test_prog, m, DebugInfo::None)
}

fn native_gate_run(od: str, gp: GatePaths, merge_cov: bool): i32 {
    var cross = resolved_cross_note()
    if cross.is_cross { teko::io::println(cross.note); return 0 }
    var rc = run_gate_single(gp)
    if merge_cov {
        match merge_gate_coverage(od, gp, 1, rc) {
            error as e => { var printed = fail("", e.message); return if rc != 0 { rc } else { printed } }
            null => { }
        }
    }
    rc
}

fn run_gate_single(gp: GatePaths): i32 {
    match teko::env::set_var("TEKO_TKCOV", gp.covfile) { error => { }; null => { } }
    var argv: []str = [gp.binp]
    teko::process::run(argv)
}

fn merge_gate_coverage(od: str, gp: GatePaths, jobs: u64, trc: i32): null | error {
    if jobs > 1 { return merge_shard_coverage(gate_shard_base(od, gp.stem), jobs) }
    if trc == 0 { coverage::cov_merge(gp.covfile) }
    null
}

fn gate_shard_base(od: str, stem: str): str {
    teko::str::concat(od, "/.", stem, "-shard/")
}

const TEST_JOBS_ENV: str = "TEKO_TEST_JOBS"

fn test_jobs(): u64 {
    match teko::env::var(TEST_JOBS_ENV) { str as v => clamp_jobs(regr_jobs_of_default(v, os_max())); error => os_max() }
}

fn gate_shard_spec(binp: str, shard_prefix: str, i: u64, jobs: u64): ProcSpec {
    var prefix = teko::str::concat(shard_prefix, $"{i}")
    var env: []str = [$"TEKO_TEST_SHARD={i}/{jobs}", teko::str::concat("TEKO_TKCOV=", prefix, ".tkcov")]
    ProcSpec { argv = [binp]; dir = ""; env = env; stdin_data = ""; prefix = prefix }
}

fn run_gate_sharded(od: str, stem: str, binp: str, jobs: u64): i32 {
    var shard_prefix = gate_shard_base(od, stem)
    var specs: [jobs]ProcSpec = []
    var i: u64 = 0
    loop {
        if i >= jobs { break }
        specs[i] = gate_shard_spec(binp, shard_prefix, i, jobs)
        i = i + 1
    }
    teko::io::println($"teko: test gate sharded {jobs} ways (TEKO_TEST_JOBS)")
    var caps = run_pool(specs, jobs)
    report_shard_captures(caps)
    first_shard_failure(caps)
}

fn report_shard_captures(caps: []CapResult) {
    var i: u64 = 0
    loop {
        if i >= caps.len { break }
        teko::io::write(caps[i].stdout)
        teko::io::ewrite(caps[i].stderr)
        i = i + 1
    }
}

fn merge_shard_coverage(cov_prefix: str, jobs: u64): null | error {
    var i: u64 = 0
    loop {
        if i >= jobs { break }
        var p = teko::str::concat(cov_prefix, $"{i}", ".tkcov")
        if !coverage::cov_merge(p) { return error { message = $"shard {i} left no coverage dump ({p})" } }
        i = i + 1
    }
    null
}

fn first_shard_failure(caps: []CapResult): i32 {
    var i: u64 = 0
    loop {
        if i >= caps.len { break }
        if caps[i].exit != 0 { return caps[i].exit }
        i = i + 1
    }
    0
}

fn cobertura_path_of(out_dir: str, gen_cov: bool): str {
    if !gen_cov { return "" }
    teko::fs::mkdir(out_dir)
    teko::str::concat(out_dir, "/cobertura.xml")
}

fn release_build_of(dir: str, out_dir: str, opt: i32, tty: bool, start: i64, backend: Backend, pf: ParsedFront, debug: DebugInfo): i32 {
    var pf_prod = ParsedFront { parsed = filter_tkt(pf.parsed); manifest = pf.manifest; diags = pf.diags; embeds = pf.embeds }
    var rel = match frontend_check(pf_prod, false, tty, false) { Frontend as f => f; error as e => return fail(dir, e.message) }
    codegen_and_report(dir, out_dir, strip_tests(rel.prog), with_backend(rel.manifest, backend), opt, tty, start, debug)
}

fn run_gate_native(dir: str, out_dir: str, gen_cov: bool, fe: Frontend, pf: ParsedFront, opt: i32, tty: bool, start: i64, backend: Backend, cov_validation: bool, debug: DebugInfo): i32 {
    var trc = run_native_gate(dir, out_dir, pf, fe.manifest, tty)
    if trc != 0 { return trc }
    teko::io::println("teko: native test gate v1 — coverage not yet instrumented; floors and --coverage are advisory no-ops (tests-native-no-c)")
    release_build_of(dir, out_dir, opt, tty, start, backend, pf, debug)
}

fn c_gate_build(dir: str, od: str, gp: GatePaths, fe: Frontend): i32 {
    var m = fe.manifest
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    match codegen::tk_emit_c_test_file(fe.prog, false, gp.cfile, codegen::tk_emit_meta(m.name, m.version, m.suffix, m.description)) { u64 => { }; error as e => return fail(dir, e.message) }
    if run_cc(gp.cfile, gp.binp, m, fe.prog, 0) != 0 { return fail(dir, "cc failed to build the test gate") }
    0
}

fn run_c_gate(dir: str, out_dir: str, fe: Frontend): i32 {
    var od = gate_out_dir(out_dir)
    var gp = gate_paths(od, fe.manifest)
    var brc = c_gate_build(dir, od, gp, fe)
    if brc != 0 { return brc }
    var argv = [gp.binp]
    teko::process::run(argv)
}

fn run_gate_c(dir: str, out_dir: str, fe: Frontend, pf: ParsedFront, opt: i32, tty: bool, start: i64, backend: Backend, debug: DebugInfo): i32 {
    var trc = run_c_gate(dir, out_dir, fe)
    if trc != 0 { return trc }
    release_build_of(dir, out_dir, opt, tty, start, backend, pf, debug)
}

fn run_gate(dir: str, out_dir: str, gen_cov: bool, fe: Frontend, pf: ParsedFront, opt: i32, tty: bool, start: i64, backend: Backend, cov_validation: bool, debug: DebugInfo): i32 {
    if backend == Backend::Native {
        return run_gate_native(dir, out_dir, gen_cov, fe, pf, opt, tty, start, backend, cov_validation, debug)
    }
    run_gate_c(dir, out_dir, fe, pf, opt, tty, start, backend, debug)
}

fn build_no_tests_present(dir: str, out_dir: str, fe: Frontend, opt: i32, tty: bool, start: i64, backend: Backend, debug: DebugInfo): i32 { codegen_and_report(dir, out_dir, fe.prog, with_backend(fe.manifest, backend), opt, tty, start, debug) }

fn compile_project_g(dir: str, out_dir: str, gen_cov: bool, no_verify: bool, opt: i32, no_tty: bool, backend: Backend, cov_validation: bool, debug: DebugInfo, explicit: bool): i32 {
    ensure_rt_dir_abs()
    match teko::env::chdir(dir) { error => return fail(dir, "cannot enter project directory"); null => { } }
    var tty = output_is_tty(no_tty)
    var start = now_ns()
    if no_verify {
        return build_ungated(dir, out_dir, opt, tty, start, backend, debug, explicit)
    }
    var pf = match frontend_parse(true, false, tty) { ParsedFront as x => x; error as e => return fail(dir, e.message) }
    match frontend_check(pf, false, tty, explicit) {
        Frontend as fe => {
            if !has_tests(fe.prog) {
                return build_no_tests_present(dir, out_dir, fe, opt, tty, start, backend, debug)
            }
            run_gate(dir, out_dir, gen_cov, fe, pf, opt, tty, start, backend, cov_validation, debug)
        }
        error as e => return fail(dir, e.message)
    }
}

fn has_tests(prog: checker::TProgram): bool {
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { if f.is_test { return true } }
            _ => { }
        }
        i++
    }
    false
}


fn out_dir_of(args: []str, start: u64): str {
    var i = start
    loop {
        if i >= args.len { break }
        if args[i] == "-o" {
            if i + 1 < args.len { return args[i + 1] }
        }
        i = i + 1
    }
    "bin"
}

fn coverage_of(args: []str): bool {
    var i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == "--coverage" { return true }
        i = i + 1
    }
    false
}

