
fn is_known_command(cmd: str): bool {
    cmd == "build" || cmd == "run" || cmd == "test" || cmd == "fmt" || cmd == "init" || cmd == "lsp"
}

fn wants_help(args: []str): bool {
    var i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == "--help" || args[i] == "-h" { return true }
        i = i + 1
    }
    false
}

fn help_cmd_of(args: []str): str {
    if args.len < 2 { return "" }
    var cmd = args[1]
    if is_known_command(cmd) { return cmd }
    ""
}

fn print_help_general() {
    teko::io::eprintln(teko::str::concat("teko ", teko::env::version()))
    teko::io::eprintln("usage: teko build <projdir>   build the project to a native binary")
    teko::io::eprintln("       teko run   <projdir>   build (debug) and run the project's native binary")
    teko::io::eprintln("       teko test  <projdir>   run the project's tests")
    teko::io::eprintln("       teko fmt   --check | --apply <path>...   format .tks/.tkt sources (self-hosted binary only)")
    teko::io::eprintln("       teko init  [dir]        scaffold a new project (interactive; writes teko.tkp + a stub)")
    teko::io::eprintln("       teko lsp                run the language server (JSON-RPC over stdio; for editor integration)")
    teko::io::eprintln("       teko <projdir>         (bare) ≡ build")
    teko::io::eprintln("       teko --version | -v    print the version and exit")
    teko::io::eprintln("       teko --help | -h       print this help and exit")
    teko::io::eprintln("build/bare flags:")
    teko::io::eprintln("       -o <dir>               output directory (default: bin)")
    teko::io::eprintln("       --coverage             write a Cobertura cobertura.xml next to the output")
    teko::io::eprintln("       --no-verify            skip the .tkt test gate (build ONLY; unverified binary — CI/self-host use)")
    teko::io::eprintln("       --cov-validation       enforce the [coverage] floors (default: an unmet floor only warns)")
    teko::io::eprintln("       --release              build the binary optimized (cc -O2; slower to produce, faster to run)")
    teko::io::eprintln("       --debug=lines          emit debug info: breakpoint by .tks line, step, and backtrace in")
    teko::io::eprintln("                              tdb, gdb, lldb and VSCode. Does NOT include variables")
    teko::io::eprintln("       --debug=none           no debug information (the default, including under --release)")
    teko::io::eprintln("       --opt=<0|1|2>          set the cc optimization level (default 0; no -O — fast to produce)")
    teko::io::eprintln("       --no-tty               force plain, non-interactive build output (no \\r in-place updates)")
    teko::io::eprintln("       --allow-undef          link blind over a shared lib absent here (resolved at load on the target)")
    teko::io::eprintln("teko compiles projects, not files: pass a project directory or .tkp")
}

fn print_help_build() {
    teko::io::eprintln(teko::str::concat("teko ", teko::env::version()))
    teko::io::eprintln("usage: teko build <projdir>   build the project to a native binary")
    teko::io::eprintln("flags:")
    teko::io::eprintln("       -o <dir>               output directory (default: bin)")
    teko::io::eprintln("       --coverage             write a Cobertura cobertura.xml next to the output")
    teko::io::eprintln("       --no-verify            skip the .tkt test gate (build ONLY; unverified binary — CI/self-host use)")
    teko::io::eprintln("       --cov-validation       enforce the [coverage] floors (default: an unmet floor only warns)")
    teko::io::eprintln("       --release              build the binary optimized (cc -O2; slower to produce, faster to run)")
    teko::io::eprintln("       --debug=lines          emit debug info: breakpoint by .tks line, step, and backtrace in")
    teko::io::eprintln("                              tdb, gdb, lldb and VSCode. Does NOT include variables")
    teko::io::eprintln("       --debug=none           no debug information (the default, including under --release)")
    teko::io::eprintln("       --opt=<0|1|2>          set the cc optimization level (default 0; no -O — fast to produce)")
    teko::io::eprintln("       --no-tty               force plain, non-interactive build output (no \\r in-place updates)")
    teko::io::eprintln("       --allow-undef          link blind over a shared lib absent here (resolved at load on the target)")
}

fn print_help_run() {
    teko::io::eprintln(teko::str::concat("teko ", teko::env::version()))
    teko::io::eprintln("usage: teko run <projdir>   build (debug) and run the project's native binary")
    teko::io::eprintln("flags:")
    teko::io::eprintln("       -o <dir>               output directory (default: bin)")
}

fn print_help_test() {
    teko::io::eprintln(teko::str::concat("teko ", teko::env::version()))
    teko::io::eprintln("usage: teko test <projdir>   run the project's tests")
    teko::io::eprintln("flags:")
    teko::io::eprintln("       --coverage             write a Cobertura cobertura.xml next to the project root")
    teko::io::eprintln("       --analyzer             dev-time: report stale/redundant/misleading tests (advisory)")
    teko::io::eprintln("       --cov-validation       enforce the [coverage] floors (default: an unmet floor only warns)")
    teko::io::eprintln("       --per-test-cov         print per-test coverage attribution (dev-time; recompiles one binary per test)")
}

fn print_help_fmt() {
    teko::io::eprintln(teko::str::concat("teko ", teko::env::version()))
    teko::io::eprintln("usage: teko fmt --check <path>...   report .tks/.tkt sources that are not formatted")
    teko::io::eprintln("       teko fmt --apply <path>...   format them, rewriting each file in place")
    teko::io::eprintln("       teko fmt -                   format stdin to stdout, touching no file")
    teko::io::eprintln("flags:")
    teko::io::eprintln("       --check                report unformatted files without rewriting them (exit 1 if any)")
    teko::io::eprintln("       --apply                rewrite every unformatted file in place")
    teko::io::eprintln("(a path is a .tks/.tkt file or a directory walked recursively; self-hosted binary only)")
}

fn print_help_lsp() {
    teko::io::eprintln(teko::str::concat("teko ", teko::env::version()))
    teko::io::eprintln("usage: teko lsp   run the language server (JSON-RPC 2.0 over stdio)")
    teko::io::eprintln("meant to be launched by an editor's language-client, not typed directly")
    teko::io::eprintln("speaks: initialize, shutdown, exit, textDocument/didOpen|didChange|didClose,")
    teko::io::eprintln("        textDocument/formatting, textDocument/hover, textDocument/definition,")
    teko::io::eprintln("        textDocument/completion")
}

fn print_help_init() {
    teko::io::eprintln(teko::str::concat("teko ", teko::env::version()))
    teko::io::eprintln("usage: teko init [dir]   scaffold a new project (default dir: the current directory)")
    teko::io::eprintln("interactively asks: project name, artifact kind, source directory, description")
    teko::io::eprintln("(an empty answer or EOF uses the shown default); refuses to overwrite an existing teko.tkp")
}

fn print_help(cmd: str) {
    if cmd == "build" { print_help_build(); return }
    if cmd == "run" { print_help_run(); return }
    if cmd == "test" { print_help_test(); return }
    if cmd == "fmt" { print_help_fmt(); return }
    if cmd == "init" { print_help_init(); return }
    if cmd == "lsp" { print_help_lsp(); return }
    print_help_general()
}
