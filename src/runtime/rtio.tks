#os("linux")
fn rtio_os_write(fd: i64, addr: i64, count: i64): i64 {
    teko::sys::syscall3(teko::sys::SYS_WRITE, fd, addr, count)
}

#os("macos")
fn rtio_os_write(fd: i64, addr: i64, count: i64): i64 {
    teko::sys::abi::os_write_raw(fd to i32, addr to u64, count to u64)
}

#os("windows")
fn rtio_std_handle(fd: i64): u64 {
    if fd == 2 { return teko::sys::abi::GetStdHandle(0xFFFFFFF4 to u32) }
    teko::sys::abi::GetStdHandle(0xFFFFFFF5 to u32)
}

#os("windows")
fn rtio_os_write(fd: i64, addr: i64, count: i64): i64 {
    var put = teko::sys::ptr_word(teko::mem::buf_ptr(8)) to u64
    teko::mem::store_u64(put, 0 to u64)
    if teko::sys::abi::WriteFile(rtio_std_handle(fd), addr to u64, count to u32, put, 0) == 0 { return -1 }
    teko::mem::load_u64(put) to i64
}

fn rtio_write_all(fd: i64, s: str) {
    if s.len == 0 { return }
    var bytes = s.bytes()
    var off: u64 = 0
    loop {
        if off >= s.len { break }
        var addr = teko::sys::ptr_word(teko::mem::byte_ptr(bytes, off))
        var n = rtio_os_write(fd, addr, (s.len - off) to i64)
        if n <= 0 { break }
        off = off + (n to u64)
    }
}

/** teko::runtime::write — write `s` to stdout, or into the running test's captured stdout when a test
 * channel is open, via raw SYS_write when it reaches the OS. */
exp global fn write(s: str) {
    if chan_open() { chan_append(HARNESS_OUT_HEAD, HARNESS_OUT_TAIL, s); return }
    rtio_write_all(1, s)
}

/** teko::runtime::print — write `s` to stdout, or into the running test's captured stdout when a test
 * channel is open. */
exp global fn print(s: str) { write(s) }

/** teko::runtime::println — write `s` then a newline to stdout, or into the running test's captured
 * stdout when a test channel is open. */
exp global fn println(s: str) { write(s); write("\n") }

/** teko::runtime::ewrite — write `s` to stderr, or into the running test's captured stderr when a test
 * channel is open, via raw SYS_write when it reaches the OS. */
exp global fn ewrite(s: str) {
    if chan_open() { chan_append(HARNESS_ERR_HEAD, HARNESS_ERR_TAIL, s); return }
    rtio_write_all(2, s)
}

/** teko::runtime::eprint — write `s` to stderr, or into the running test's captured stderr when a test
 * channel is open. */
exp global fn eprint(s: str) { ewrite(s) }

/** teko::runtime::eprintln — write `s` then a newline to stderr, or into the running test's captured
 * stderr when a test channel is open. */
exp global fn eprintln(s: str) { ewrite(s); ewrite("\n") }

/** teko::runtime::flush — no-op: stdout is written straight to the OS via SYS_write with no buffered
 * stdio layer, so there is nothing to drain. */
exp fn flush() { }

/** teko::runtime::panic — when an enclosing `capture` frame is armed, mark `msg` pending and return so
 * each frame runs its defers/drops on the way out (the harness guard that keeps one failing case from
 * killing the suite); otherwise write "teko: deliberate panic: <msg>" to stderr and terminate with
 * status 134. */
exp global fn panic(msg: str) {
    if teko::runtime::capture_depth() > 0 {
        teko::runtime::ctrl_set(HARNESS_CAP_KIND, HARNESS_KIND_PANIC)
        teko::runtime::capture_deliver(msg)
        return
    }
    ewrite(teko::str::concat("teko: deliberate panic: ", msg, "\n"))
    teko::runtime::rt_exit(134)
}

/** teko::runtime::panic — abort with the error's `.message`, the same loud path as `panic(str)`. */
exp global fn panic(e: error) {
    panic(e.message)
}

/** teko::runtime::exit — under an armed `capture` frame, mark the termination pending and return so each
 * frame runs its defers/drops on the way out (the same graceful-stop path as `panic`, recovered by the
 * harness as an EXITED outcome carrying `code`); otherwise terminate the whole process with status
 * `code`. */
exp global fn exit(code: i64) {
    if teko::runtime::capture_depth() > 0 {
        teko::runtime::ctrl_set(HARNESS_CAP_KIND, HARNESS_KIND_EXIT)
        teko::runtime::ctrl_set(HARNESS_CAP_CODE, code to u64)
        teko::runtime::capture_deliver("exit")
        return
    }
    teko::runtime::rt_exit(code)
}

const STDIN_BUF_CAP: u64 = 1024

const STDIN_BUF_PTR: u64 = 34712

const STDIN_BUF_LEN: u64 = 34720

const STDIN_BUF_POS: u64 = 34728

const STDIN_EOF_FLAG: u64 = 34736

#os("linux")
fn rtio_os_read(fd: i64, addr: i64, count: i64): i64 {
    teko::sys::syscall3(teko::sys::SYS_READ, fd, addr, count)
}

#os("macos")
fn rtio_os_read(fd: i64, addr: i64, count: i64): i64 {
    teko::sys::abi::os_read_raw(fd to i32, addr to u64, count to u64)
}

#os("windows")
fn rtio_os_read(fd: i64, addr: i64, count: i64): i64 {
    var put = teko::sys::ptr_word(teko::mem::buf_ptr(8)) to u64
    teko::mem::store_u64(put, 0 to u64)
    if teko::sys::abi::ReadFile(teko::sys::abi::GetStdHandle(0xFFFFFFF6 to u32), addr to u64, count to u32, put, 0) == 0 { return -1 }
    teko::mem::load_u64(put) to i64
}

fn stdin_buf_addr(): u64 {
    var p = teko::runtime::ctrl_get(STDIN_BUF_PTR)
    if p != 0 { return p }
    var fresh = teko::sys::ptr_word(teko::runtime::Arena::current().program().alloc(STDIN_BUF_CAP)) to u64
    teko::runtime::ctrl_set(STDIN_BUF_PTR, fresh)
    fresh
}

fn stdin_refill(): bool {
    var n = rtio_os_read(0, stdin_buf_addr() to i64, STDIN_BUF_CAP to i64)
    if n <= 0 {
        teko::runtime::ctrl_set(STDIN_BUF_LEN, 0)
        teko::runtime::ctrl_set(STDIN_BUF_POS, 0)
        return false
    }
    teko::runtime::ctrl_set(STDIN_BUF_LEN, n to u64)
    teko::runtime::ctrl_set(STDIN_BUF_POS, 0)
    true
}

fn stdin_next_byte(): i64 {
    if teko::runtime::ctrl_get(STDIN_BUF_POS) >= teko::runtime::ctrl_get(STDIN_BUF_LEN) {
        if !stdin_refill() { return -1 }
    }
    var pos = teko::runtime::ctrl_get(STDIN_BUF_POS)
    var b = teko::mem::load_u8(teko::runtime::ctrl_get(STDIN_BUF_PTR) + pos)
    teko::runtime::ctrl_set(STDIN_BUF_POS, pos + 1)
    b to i64
}

type StdinAcc = struct {
    head: u64
    tail: u64
    total: u64
}

fn stdin_acc_new(): StdinAcc {
    StdinAcc { head = 0; tail = 0; total = 0 }
}

fn stdin_chunk_new(): u64 {
    var node = teko::sys::ptr_word(teko::runtime::Arena::current().program().alloc(CHUNK_DATA + STDIN_BUF_CAP)) to u64
    teko::mem::store_u64(node + CHUNK_NEXT, 0)
    teko::mem::store_u64(node + CHUNK_LEN, 0)
    node
}

fn stdin_acc_push(acc: StdinAcc, b: i64): StdinAcc {
    var head = acc.head
    var tail = acc.tail
    if tail == 0 || teko::mem::load_u64(tail + CHUNK_LEN) >= STDIN_BUF_CAP {
        var node = stdin_chunk_new()
        if tail == 0 { head = node } else { teko::mem::store_u64(tail + CHUNK_NEXT, node) }
        tail = node
    }
    var len = teko::mem::load_u64(tail + CHUNK_LEN)
    teko::mem::store_u8(tail + CHUNK_DATA + len, (b to u64) & 0xFF)
    teko::mem::store_u64(tail + CHUNK_LEN, len + 1)
    StdinAcc { head = head; tail = tail; total = acc.total + 1 }
}

fn stdin_acc_bytes(acc: StdinAcc, count: u64): []byte {
    var out: [count]byte = []
    var k: u64 = 0
    var node = acc.head
    loop {
        if node == 0 || k >= count { break }
        var len = teko::mem::load_u64(node + CHUNK_LEN)
        var j: u64 = 0
        loop {
            if j >= len || k >= count { break }
            out[k] = teko::mem::load_u8(node + CHUNK_DATA + j) to byte
            k = k + 1
            j = j + 1
        }
        node = teko::mem::load_u64(node + CHUNK_NEXT)
    }
    out
}

/**
 * teko::runtime::read_line — one line from stdin (the trailing '\n' consumed and dropped, a trailing
 * '\r' from a "\r\n" source stripped); "" at a genuine blank line or at EOF. Sets the EOF flag (read
 * by stdin_eof) when zero bytes were seen before end of input, so a caller can tell EOF from a blank
 * line.
 *
 * @return the line's bytes as text, or "" at a blank line / EOF
 * @since 0.3.1
 */
exp fn read_line(): str {
    var acc = stdin_acc_new()
    var saw_any = false
    var last: i64 = -1
    loop {
        var ch = stdin_next_byte()
        if ch < 0 { break }
        saw_any = true
        if ch == (b'\n' to i64) { break }
        acc = stdin_acc_push(acc, ch)
        last = ch
    }
    teko::runtime::ctrl_set(STDIN_EOF_FLAG, if saw_any { 0 } else { 1 })
    var count = acc.total
    if count > 0 && last == (b'\r' to i64) { count = count - 1 }
    str(stdin_acc_bytes(acc, count))
}

/**
 * teko::runtime::stdin_eof — whether the last read_line hit real end of input (zero bytes before EOF),
 * to tell EOF from a genuine blank line.
 *
 * @return true when the last read_line reached end of input with no bytes
 * @since 0.3.1
 */
exp fn stdin_eof(): bool {
    teko::runtime::ctrl_get(STDIN_EOF_FLAG) != 0
}

/**
 * teko::runtime::read_stdin — all of stdin drained to EOF, over a reusable ≤1024-byte read buffer with
 * no growing scratch.
 *
 * @return every byte read from stdin as text
 * @since 0.3.1
 */
exp fn read_stdin(): str {
    var acc = stdin_acc_new()
    loop {
        var ch = stdin_next_byte()
        if ch < 0 { break }
        acc = stdin_acc_push(acc, ch)
    }
    str(stdin_acc_bytes(acc, acc.total))
}

/**
 * teko::runtime::read_stdin_n — exactly `n` bytes from stdin, or fewer when EOF arrives first.
 *
 * @param n  the number of bytes to read
 * @return the bytes read, `n` long on a full read or shorter at EOF
 * @since 0.3.1
 */
exp fn read_stdin_n(n: u64): []byte {
    var out: [n]byte = []
    var got: u64 = 0
    loop {
        if got >= n { break }
        var ch = stdin_next_byte()
        if ch < 0 { break }
        out[got] = (ch to u64) to byte
        got = got + 1
    }
    var res: [got]byte = []
    var i: u64 = 0
    loop {
        if i >= got { break }
        res[i] = out[i]
        i = i + 1
    }
    res
}

#os("linux")
fn peak_rss_impl(): u64 {
    var rbuf = teko::sys::ptr_word(teko::mem::buf_ptr(256))
    var r = teko::sys::syscall2(teko::sys::SYS_GETRUSAGE, teko::sys::RUSAGE_SELF, rbuf)
    if r < 0 { return 0 }
    teko::mem::load_u64((rbuf + 32) to u64) * 1024
}

#os("macos")
fn peak_rss_impl(): u64 {
    var ru: teko::sys::abi::Rusage = teko::sys::abi::Rusage { ru_maxrss = 0 }
    if teko::sys::abi::os_getrusage(teko::sys::RUSAGE_SELF to i32, ru) != 0 { return 0 }
    ru.ru_maxrss to u64
}

#os("windows")
fn peak_rss_impl(): u64 {
    0
}

/** teko::runtime::peak_rss — this process's peak resident set size in bytes (0 when unavailable). */
exp fn peak_rss(): u64 {
    peak_rss_impl()
}

#os("linux")
fn statm_resident_bytes(addr: i64, n: u64): u64 {
    var i: u64 = 0
    loop {
        if i >= n { return 0 }
        if teko::mem::load_u8((addr + (i to i64)) to u64) == 32 { break }
        i = i + 1
    }
    loop {
        if i >= n { return 0 }
        if teko::mem::load_u8((addr + (i to i64)) to u64) != 32 { break }
        i = i + 1
    }
    var pages: u64 = 0
    loop {
        if i >= n { break }
        var c = teko::mem::load_u8((addr + (i to i64)) to u64)
        if c < 48 || c > 57 { break }
        pages = pages * 10 + (c - 48)
        i = i + 1
    }
    pages * 4096
}

#os("linux")
fn cur_rss_impl(): u64 {
    var path = teko::sys::ptr_word(teko::mem::as_cstr("/proc/self/statm"))
    var fd = teko::sys::syscall4(teko::sys::SYS_OPENAT, teko::sys::AT_FDCWD, path, teko::sys::O_RDONLY, 0)
    if fd < 0 { return 0 }
    var buf = teko::sys::ptr_word(teko::mem::buf_ptr(128))
    var got = teko::sys::syscall3(teko::sys::SYS_READ, fd, buf, 127)
    _ = teko::sys::syscall1(teko::sys::SYS_CLOSE, fd)
    if got <= 0 { return 0 }
    statm_resident_bytes(buf, got to u64)
}

#os("macos")
fn cur_rss_impl(): u64 {
    0
}

#os("windows")
fn cur_rss_impl(): u64 {
    0
}

/** teko::runtime::cur_rss — this process's current resident set size in bytes (0 when unavailable). */
exp fn cur_rss(): u64 {
    cur_rss_impl()
}

const HARNESS_CHAN_OPEN: u64 = 34552

const HARNESS_OUT_HEAD: u64 = 34560

const HARNESS_OUT_TAIL: u64 = 34568

const HARNESS_ERR_HEAD: u64 = 34576

const HARNESS_ERR_TAIL: u64 = 34584

const HARNESS_REGION: u64 = 34592

const HARNESS_LABEL_PTR: u64 = 34600

const HARNESS_LABEL_LEN: u64 = 34608

const HARNESS_RAN: u64 = 34616

const HARNESS_PASSED: u64 = 34624

const HARNESS_FAILED: u64 = 34632

const HARNESS_EXITED: u64 = 34640

const HARNESS_SCEN_PTR: u64 = 34648

const HARNESS_SCEN_LEN: u64 = 34656

const HARNESS_CAP_KIND: u64 = 34696

const HARNESS_CAP_CODE: u64 = 34704

const HARNESS_KIND_PANIC: u64 = 1

const HARNESS_KIND_EXIT: u64 = 2

const HARNESS_HOW_OK: i32 = 0

const HARNESS_HOW_PANICKED: i32 = 1

const HARNESS_HOW_EXITED: i32 = 2

const CHUNK_NEXT: u64 = 0

const CHUNK_LEN: u64 = 8

const CHUNK_DATA: u64 = 16

const PANIC_MARKER: str = "teko: deliberate panic: "

const OUT_PREFIX: str = "     out| "

const ERR_PREFIX: str = "     err| "

fn chan_open(): bool {
    teko::runtime::ctrl_get(HARNESS_CHAN_OPEN) != 0
}

fn copy_str_to(dst: u64, s: str) {
    if s.len == 0 { return }
    var src = teko::sys::ptr_word(teko::mem::byte_ptr(s.bytes(), 0)) to u64
    _ = teko::runtime::rt_memcpy(dst, src, s.len)
}

fn str_at(addr: u64, n: u64): str {
    if n == 0 { return "" }
    str(teko::mem::bytes_from_ptr(teko::sys::word_ptr(addr to i64), n))
}

fn chan_region_ptr(): ptr {
    teko::sys::word_ptr(teko::runtime::ctrl_get(HARNESS_REGION) to i64)
}

fn chan_alloc(n: u64): u64 {
    var size = if n == 0 { 1 } else { n }
    teko::sys::ptr_word(teko::runtime::region_alloc(chan_region_ptr(), size)) to u64
}

fn chan_region_reset() {
    var old = teko::runtime::ctrl_get(HARNESS_REGION)
    if old != 0 { teko::runtime::region_drop(teko::sys::word_ptr(old to i64)) }
    var fresh = teko::runtime::region_new(teko::runtime::region_program())
    teko::runtime::ctrl_set(HARNESS_REGION, teko::sys::ptr_word(fresh) to u64)
}

fn chan_append(head_field: u64, tail_field: u64, s: str) {
    if s.len == 0 { return }
    var node = chan_alloc(CHUNK_DATA + s.len)
    teko::mem::store_u64(node + CHUNK_NEXT, 0)
    teko::mem::store_u64(node + CHUNK_LEN, s.len)
    copy_str_to(node + CHUNK_DATA, s)
    var tail = teko::runtime::ctrl_get(tail_field)
    if tail == 0 {
        teko::runtime::ctrl_set(head_field, node)
    } else {
        teko::mem::store_u64(tail + CHUNK_NEXT, node)
    }
    teko::runtime::ctrl_set(tail_field, node)
}

fn chan_total(head_field: u64): u64 {
    var total: u64 = 0
    var node = teko::runtime::ctrl_get(head_field)
    loop {
        if node == 0 { break }
        total = total + teko::mem::load_u64(node + CHUNK_LEN)
        node = teko::mem::load_u64(node + CHUNK_NEXT)
    }
    total
}

fn emit_line_run(src0: u64, start: u64, stop: u64, prefix: str) {
    rtio_write_all(1, prefix)
    rtio_write_all(1, str_at(src0 + start, stop - start))
    rtio_write_all(1, "\n")
}

fn emit_lines_raw(src0: u64, total: u64, prefix: str) {
    var line_start: u64 = 0
    var i: u64 = 0
    loop {
        if i >= total { break }
        if teko::mem::load_u8(src0 + i) == (b'\n' to u64) {
            emit_line_run(src0, line_start, i, prefix)
            line_start = i + 1
        }
        i++
    }
    if line_start < total { emit_line_run(src0, line_start, total, prefix) }
}

fn emit_prefixed(head_field: u64, prefix: str) {
    var total = chan_total(head_field)
    if total == 0 { return }
    var src0 = chan_alloc(total)
    var k: u64 = 0
    var node = teko::runtime::ctrl_get(head_field)
    loop {
        if node == 0 { break }
        var len = teko::mem::load_u64(node + CHUNK_LEN)
        _ = teko::runtime::rt_memcpy(src0 + k, node + CHUNK_DATA, len)
        k = k + len
        node = teko::mem::load_u64(node + CHUNK_NEXT)
    }
    emit_lines_raw(src0, total, prefix)
}

fn chan_label(): str {
    str_at(teko::runtime::ctrl_get(HARNESS_LABEL_PTR), teko::runtime::ctrl_get(HARNESS_LABEL_LEN))
}

fn verdict_line(verdict: str) {
    rtio_write_all(1, teko::str::concat("test ", chan_label(), " ... ", verdict, "\n"))
}

fn emit_body() {
    emit_prefixed(HARNESS_OUT_HEAD, OUT_PREFIX)
    emit_prefixed(HARNESS_ERR_HEAD, ERR_PREFIX)
}

fn test_close(verdict: str) {
    if teko::runtime::ctrl_get(HARNESS_CHAN_OPEN) == 0 { return }
    teko::runtime::ctrl_set(HARNESS_CHAN_OPEN, 0)
    verdict_line(verdict)
    emit_body()
}

/**
 * test_begin — open the per-test capture channel: reset the chunk buffers, remember `label` for the
 * verdict line, and clear the pending-outcome slots so a prior test's exit code cannot leak in.
 *
 * @param label  the test's qualified name, shown on its `test <label> ... <verdict>` line
 * @since 0.3.1
 */
exp fn test_begin(label: str) {
    chan_region_reset()
    teko::runtime::ctrl_set(HARNESS_OUT_HEAD, 0)
    teko::runtime::ctrl_set(HARNESS_OUT_TAIL, 0)
    teko::runtime::ctrl_set(HARNESS_ERR_HEAD, 0)
    teko::runtime::ctrl_set(HARNESS_ERR_TAIL, 0)
    teko::runtime::ctrl_set(HARNESS_CAP_KIND, 0)
    teko::runtime::ctrl_set(HARNESS_CAP_CODE, 0)
    var dst = chan_alloc(if label.len == 0 { 1 } else { label.len })
    copy_str_to(dst, label)
    teko::runtime::ctrl_set(HARNESS_LABEL_PTR, dst)
    teko::runtime::ctrl_set(HARNESS_LABEL_LEN, label.len)
    teko::runtime::ctrl_set(HARNESS_CHAN_OPEN, 1)
}

/**
 * test_collect — read the outcome of the test body that just ran under an armed `capture` frame,
 * consume any pending panic, disarm the frame, and classify the result. A panicking body has its
 * panic line appended to the captured stderr so the failure report shows it.
 *
 * @return  `0` when the body returned, `1` when it panicked, `2` when it called `exit`
 * @since 0.3.1
 */
exp fn test_collect(): i32 {
    if !teko::runtime::panicking() {
        teko::runtime::capture_disarm()
        return HARNESS_HOW_OK
    }
    var kind = teko::runtime::ctrl_get(HARNESS_CAP_KIND)
    var msg = teko::runtime::take_panic()
    teko::runtime::capture_disarm()
    if kind == HARNESS_KIND_EXIT { return HARNESS_HOW_EXITED }
    chan_append(HARNESS_ERR_HEAD, HARNESS_ERR_TAIL, teko::str::concat(PANIC_MARKER, msg, "\n"))
    HARNESS_HOW_PANICKED
}

/**
 * test_collect_code — the exit code recovered from a test body that left by calling `exit`.
 *
 * @return  the `exit` status the captured body passed, or 0 when it did not exit
 * @since 0.3.1
 */
exp fn test_collect_code(): i32 {
    teko::runtime::ctrl_get(HARNESS_CAP_CODE) to i32
}

/**
 * test_report — tally one finished test and close its channel with the right verdict: `ok` when it
 * passed, `FAILED` when it panicked, or `FAILED (exit <code>)` when it left by exiting.
 *
 * @param how   the outcome from `test_collect` (0 ok, 1 panicked, 2 exited)
 * @param code  the exit status when `how` is 2, ignored otherwise
 * @since 0.3.1
 */
exp fn test_report(how: i32, code: i32) {
    teko::runtime::ctrl_set(HARNESS_RAN, teko::runtime::ctrl_get(HARNESS_RAN) + 1)
    if how == HARNESS_HOW_OK {
        teko::runtime::ctrl_set(HARNESS_PASSED, teko::runtime::ctrl_get(HARNESS_PASSED) + 1)
        test_close("ok")
        return
    }
    teko::runtime::ctrl_set(HARNESS_FAILED, teko::runtime::ctrl_get(HARNESS_FAILED) + 1)
    if how != HARNESS_HOW_EXITED {
        test_close("FAILED")
        return
    }
    teko::runtime::ctrl_set(HARNESS_EXITED, teko::runtime::ctrl_get(HARNESS_EXITED) + 1)
    test_close(teko::str::concat("FAILED (exit ", teko::str::i64_to_str(code to i64), ")"))
}

/**
 * test_summary — print the one-line suite verdict counting how many tests ran, passed, failed and
 * exited, matching the shape a `.tkr` oracle greps for.
 *
 * @since 0.3.1
 */
exp fn test_summary() {
    var failed = teko::runtime::ctrl_get(HARNESS_FAILED)
    var verdict = if failed != 0 { "FAILED" } else { "ok" }
    rtio_write_all(1, teko::str::concat("test result: ", verdict, ". ",
        teko::str::u64_to_str(teko::runtime::ctrl_get(HARNESS_RAN)), " ran; ",
        teko::str::u64_to_str(teko::runtime::ctrl_get(HARNESS_PASSED)), " passed; ",
        teko::str::u64_to_str(failed), " failed; ",
        teko::str::u64_to_str(teko::runtime::ctrl_get(HARNESS_EXITED)), " exited\n"))
}

/**
 * test_any_failed — whether any test in the suite failed, the process exit predicate the emitted test
 * `main` returns on.
 *
 * @return  true when at least one test failed or exited
 * @since 0.3.1
 */
exp fn test_any_failed(): bool {
    teko::runtime::ctrl_get(HARNESS_FAILED) != 0
}

/**
 * test_label — the qualified name of the test whose channel is currently open, for a driver that needs
 * to derive a per-test scope token from it.
 *
 * @return  the open test's label, or the empty string when no channel is open
 * @since 0.3.1
 */
exp fn test_label(): str {
    if teko::runtime::ctrl_get(HARNESS_CHAN_OPEN) == 0 { return "" }
    chan_label()
}

/**
 * scenario_set — name the assertion case that follows, so a later failure or `scenario_ok` can quote
 * it. The name is copied into program-resident storage that outlives the test's arena.
 *
 * @param name  the case name
 * @since 0.3.1
 */
exp fn scenario_set(name: str) {
    var dst = teko::sys::ptr_word(teko::runtime::Arena::current().program().alloc(if name.len == 0 { 1 } else { name.len })) to u64
    copy_str_to(dst, name)
    teko::runtime::ctrl_set(HARNESS_SCEN_PTR, dst)
    teko::runtime::ctrl_set(HARNESS_SCEN_LEN, name.len)
}

/**
 * scenario_prefix — the `"<name>: "` prefix a failed assertion opens with, or the empty string when no
 * case is named.
 *
 * @return  the scenario prefix, or "" when no scenario is named
 * @since 0.3.1
 */
exp fn scenario_prefix(): str {
    var n = teko::runtime::ctrl_get(HARNESS_SCEN_LEN)
    if n == 0 { return "" }
    teko::str::concat(str_at(teko::runtime::ctrl_get(HARNESS_SCEN_PTR), n), ": ")
}

/**
 * scenario_ok — announce that the named case passed (`scenario <name>: ok`) into the test channel, then
 * clear the name. Panics when no case is named.
 *
 * @since 0.3.1
 */
exp fn scenario_ok() {
    var n = teko::runtime::ctrl_get(HARNESS_SCEN_LEN)
    if n == 0 { panic("assertion failed: scenario_ok — no scenario is named (scenario_begin was never called)") }
    println(teko::str::concat("scenario ", str_at(teko::runtime::ctrl_get(HARNESS_SCEN_PTR), n), ": ok"))
    teko::runtime::ctrl_set(HARNESS_SCEN_LEN, 0)
}
