exp fn float_parse(s: str): f64 {
    teko::float::parse(s)
}

exp fn str_concat(a: str, b: str): str {
    var xs: [a.len + b.len]byte = []
    var k: u64 = 0
    var i: u64 = 0
    loop { if i >= a.len { break }; xs[k] = a[i]; k++; i++ }
    var j: u64 = 0
    loop { if j >= b.len { break }; xs[k] = b[j]; k++; j++ }
    str(xs)
}

/** teko::runtime::u64_to_str — `v`'s decimal digits ("0" when `v` is zero). */
exp fn u64_to_str(v: u64): str {
    if v == 0 { return "0" }
    var w: u64 = 0
    var t = v
    loop { if t == 0 { break }; t = t / 10; w = w + 1 }
    var xs: [w]byte = []
    var rem = v
    var i = w
    loop {
        if i == 0 { break }
        i = i - 1
        xs[i] = (b'0' to u64 + rem % 10) to byte
        rem = rem / 10
    }
    str(xs)
}

exp fn i64_to_str(v: i64): str {
    if v >= 0 { return u64_to_str(v to u64) }
    var mag = ((-(v + 1)) to u64) + 1
    var w: u64 = 1
    var t = mag
    loop { if t == 0 { break }; t = t / 10; w = w + 1 }
    var xs: [w]byte = []
    xs[0] = b'-'
    var rem = mag
    var i = w
    loop {
        if i == 1 { break }
        i = i - 1
        xs[i] = (b'0' to u64 + rem % 10) to byte
        rem = rem / 10
    }
    str(xs)
}

fn u64_to_str_len(v: u64, out_len: u64): i64 {
    var s = u64_to_str(v)
    teko::mem::store_u64(out_len, s.len)
    teko::sys::ptr_word(s.as_ptr())
}

fn i64_to_str_len(v: i64, out_len: u64): i64 {
    var s = i64_to_str(v)
    teko::mem::store_u64(out_len, s.len)
    teko::sys::ptr_word(s.as_ptr())
}

exp fn str_of_bytes(bytes: []byte): str {
    var xs: [bytes.len]byte = []
    var i: u64 = 0
    loop { if i >= bytes.len { break }; xs[i] = bytes[i]; i++ }
    str(xs)
}

exp fn one_byte(c: byte): str {
    var xs: [1]byte = []
    xs[0] = c
    str(xs)
}

exp fn concat(params pieces: []str): str {
    var total: u64 = 0
    var i: u64 = 0
    loop { if i >= pieces.len { break }; total = total + pieces[i].len; i++ }
    var xs: [total]byte = []
    var k: u64 = 0
    var p: u64 = 0
    loop {
        if p >= pieces.len { break }
        var j: u64 = 0
        loop { if j >= pieces[p].len { break }; xs[k] = pieces[p][j]; k++; j++ }
        p++
    }
    str(xs)
}

exp fn str_eq(a: str, b: str): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop { if i >= a.len { break }; if a[i] != b[i] { return false }; i++ }
    true
}

/** teko::runtime::str_hash — the FNV-1a hash of `s`'s bytes. */
exp global fn str_hash(s: str): u64 {
    var h: u64 = 14695981039346656037
    var i: u64 = 0
    loop { if i >= s.len { break }; h = (h ^ (s[i] to u64)) * 1099511628211; i++ }
    h
}

/** teko::runtime::str_compare — lexicographic byte compare: -1 (a < b), 0 (equal), 1 (a > b). */
exp global fn str_compare(a: str, b: str): i64 {
    var n = if a.len < b.len { a.len } else { b.len }
    var i: u64 = 0
    loop {
        if i >= n { break }
        if (a[i] to u64) < (b[i] to u64) { return -1 }
        if (a[i] to u64) > (b[i] to u64) { return 1 }
        i++
    }
    if a.len < b.len { return -1 }
    if a.len > b.len { return 1 }
    0
}

exp fn str_slice(s: str, start: u64, end: u64): str {
    if start > end || end > s.len { panic_str_slice_oob() }
    slice_view(s, start, end)
}

exp fn str_slice_to(s: str, end: u64): str {
    str_slice(s, 0, end)
}

exp fn str_slice_from(s: str, start: u64): str {
    str_slice(s, start, s.len)
}

exp global fn str_len(s: str): u64 {
    s.len
}

exp fn str_ends_with(s: str, suffix: str): bool {
    if suffix.len > s.len { return false }
    var start = s.len - suffix.len
    var i: u64 = 0
    loop { if i >= suffix.len { break }; if s[start + i] != suffix[i] { return false }; i++ }
    true
}

exp fn str_contains(s: str, needle: str): bool {
    if needle.len == 0 { return true }
    if needle.len > s.len { return false }
    var last = s.len - needle.len
    var i: u64 = 0
    loop {
        if i > last { break }
        var matched = true
        var j: u64 = 0
        loop { if j >= needle.len { break }; if s[i + j] != needle[j] { matched = false; break }; j++ }
        if matched { return true }
        i++
    }
    false
}

/** teko::runtime::bytes_of_str — the str's bytes as a `[]byte`, a zero-copy reinterpret (same
 * `{ptr, len}`). */
exp global fn bytes_of_str(s: str): []byte {
    s
}

/** teko::runtime::as_ptr — the raw byte address of a str's buffer (NOT NUL-terminated). */
exp global fn as_ptr(s: str): ptr {
    teko::mem::byte_ptr(s, 0)
}

fn utf8_lead_width(b0: byte): u64 {
    var v = b0 to u64
    if v < 128 { return 1 }
    if v < 192 { return 1 }
    if v < 224 { return 2 }
    if v < 240 { return 3 }
    4
}

fn utf8_codepoint_count(s: str): u64 {
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= s.len { break }
        i = i + utf8_lead_width(s[i])
        count = count + 1
    }
    count
}

/** teko::runtime::len_chars — the number of UTF-8 codepoints in `s`. */
exp global fn len_chars(s: str): i64 {
    utf8_codepoint_count(s) to i64
}

/** teko::runtime::chars — `s` split into one `char` per UTF-8 codepoint; each borrows into `s`. */
exp global fn chars(s: str): []char {
    var n = utf8_codepoint_count(s)
    var arr: [n]char = []
    var ci: u64 = 0
    var pos: u64 = 0
    loop {
        if pos >= s.len { break }
        var w = utf8_lead_width(s[pos])
        if w > s.len - pos { w = s.len - pos }
        arr[ci] = s.slice(pos, pos + w)
        ci = ci + 1
        pos = pos + w
    }
    arr
}

/** teko::runtime::char_at — the `char` at 0-based codepoint index `i` in `s` (borrows into `s`).
 * Panics when `i` is out of range. */
exp global fn char_at(s: str, i: i64): char {
    if i < 0 { panic("char_at: negative codepoint index") }
    var idx = i to u64
    var pos: u64 = 0
    var ci: u64 = 0
    loop {
        if pos >= s.len { break }
        var w = utf8_lead_width(s[pos])
        if w > s.len - pos { w = s.len - pos }
        if ci == idx { return s.slice(pos, pos + w) }
        ci = ci + 1
        pos = pos + w
    }
    panic("char_at: codepoint index out of range")
}

/** teko::runtime::str_slice_chars — the substring of `s` from codepoint index `from` (inclusive)
 * to `to` (exclusive), as a zero-copy view. Panics when the range is invalid. */
exp global fn str_slice_chars(s: str, from: i64, to: i64): str {
    if from < 0 || to < 0 { panic("str_slice_chars: negative codepoint index") }
    var ufrom = from to u64
    var uto = to to u64
    if ufrom > uto { panic("str_slice_chars: from > to") }
    var byte_from: u64 = 0
    var byte_to: u64 = 0
    var ci: u64 = 0
    var pos: u64 = 0
    loop {
        if ci == ufrom { byte_from = pos }
        if ci == uto { byte_to = pos; break }
        if pos == s.len { panic("str_slice_chars: codepoint index out of range") }
        var w = utf8_lead_width(s[pos])
        if w > s.len - pos { w = s.len - pos }
        ci = ci + 1
        pos = pos + w
    }
    s.slice(byte_from, byte_to)
}

/** teko::runtime::to_lower — the ASCII lowercase of `c`; non-ASCII codepoints are unchanged. */
exp global fn to_lower(c: char): char {
    var cp = c to u32
    if cp >= 65 && cp <= 90 { return one_byte((cp + 32) to byte) }
    c
}

/** teko::runtime::to_upper — the ASCII uppercase of `c`; non-ASCII codepoints are unchanged. */
exp global fn to_upper(c: char): char {
    var cp = c to u32
    if cp >= 97 && cp <= 122 { return one_byte((cp - 32) to byte) }
    c
}

/** teko::runtime::char_eq — true iff `a` and `b` are the same codepoint. */
exp fn char_eq(a: char, b: char): bool {
    (a to u32) == (b to u32)
}

/** teko::runtime::is_alpha — true iff the codepoint is an ASCII letter or any non-ASCII byte. */
exp global fn is_alpha(c: char): bool {
    var cp = c to u32
    (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) || cp > 127
}

/** teko::runtime::is_digit — true iff the codepoint is an ASCII decimal digit '0'-'9'. */
exp global fn is_digit(c: char): bool {
    var cp = c to u32
    cp >= 48 && cp <= 57
}

/** teko::runtime::is_space — true iff the codepoint is ASCII whitespace. */
exp global fn is_space(c: char): bool {
    var cp = c to u32
    cp == 32 || cp == 9 || cp == 10 || cp == 13 || cp == 12 || cp == 11
}

/**
 * teko::runtime::slice_eq_bytes — byte-for-byte equality of two POD `[]T` slices addressed by raw
 * pointer words: same length AND identical bytes across `a_len * elem_size` bytes.
 *
 * @param a_ptr      the first slice's base address, as a word
 * @param a_len      the first slice's element count
 * @param b_ptr      the second slice's base address, as a word
 * @param b_len      the second slice's element count
 * @param elem_size  the element's byte width
 * @return           true iff both slices hold the same length and bytes
 */
exp fn slice_eq_bytes(a_ptr: u64, a_len: u64, b_ptr: u64, b_len: u64, elem_size: u64): bool {
    if a_len != b_len { return false }
    var total = a_len * elem_size
    var i: u64 = 0
    loop {
        if i >= total { break }
        if teko::mem::load_u8(a_ptr + i) != teko::mem::load_u8(b_ptr + i) { return false }
        i++
    }
    true
}

/**
 * teko::runtime::slice_f64_eq — element-wise IEEE `==` equality of two `[]f64` slices addressed
 * by raw pointer words: same length AND every element bit-identical-or-equal by native `f64`
 * comparison (NOT memcmp — a float's bits are not its value equality).
 *
 * @param a_ptr  the first slice's base address, as a word
 * @param a_len  the first slice's element count
 * @param b_ptr  the second slice's base address, as a word
 * @param b_len  the second slice's element count
 * @return       true iff both slices hold the same length and every `f64` compares equal
 */
exp fn slice_f64_eq(a_ptr: u64, a_len: u64, b_ptr: u64, b_len: u64): bool {
    if a_len != b_len { return false }
    var i: u64 = 0
    loop {
        if i >= a_len { break }
        var av = teko::f64_from_bits(teko::mem::load_u64(a_ptr + i * 8))
        var bv = teko::f64_from_bits(teko::mem::load_u64(b_ptr + i * 8))
        if av != bv { return false }
        i++
    }
    true
}

/** teko::runtime::panic_div0 — the division-by-zero panic. Diverges. */
exp global fn panic_div0() { panic("division by zero") }

/** teko::runtime::panic_oob — the index-out-of-bounds panic. Diverges. */
exp global fn panic_oob() { panic("index out of bounds") }

/** teko::runtime::panic_cast — the impossible-narrowing-conversion panic. Diverges. */
exp global fn panic_cast() { panic("impossible conversion") }

/** teko::runtime::panic_overflow — the integer-overflow panic. Diverges. */
exp global fn panic_overflow() { panic("integer overflow") }

/** teko::runtime::panic_oob_at — the out-of-bounds panic, prefixed with `"line:col: "`.
 * Diverges. */
exp fn panic_oob_at(line: u32, col: u32) {
    ewrite(teko::str::concat(teko::u64_to_str(line to u64), ":", teko::u64_to_str(col to u64)))
    ewrite(": ")
    panic_oob()
}

/** teko::runtime::panic_null_deref_at — the null-reference-dereference panic, prefixed with
 * `"line:col: "`. Diverges. */
exp fn panic_null_deref_at(line: u32, col: u32) {
    ewrite(teko::str::concat(teko::u64_to_str(line to u64), ":", teko::u64_to_str(col to u64)))
    ewrite(": ")
    panic("null reference dereference")
}

/** teko::runtime::panic_str_slice_oob — the string-slice-out-of-range panic. Diverges. */
exp global fn panic_str_slice_oob() { panic("string slice out of range") }

/** teko::runtime::panic_oom — the out-of-memory panic. Diverges. */
exp global fn panic_oom() { panic("out of memory") }

/** teko::runtime::panic_cast_at — the impossible-conversion panic; prefixed with `"line:col: "`
 * when `line != 0`, plain otherwise. Diverges. */
exp fn panic_cast_at(line: u32, col: u32) {
    if line != 0 {
        ewrite(teko::str::concat(teko::u64_to_str(line to u64), ":", teko::u64_to_str(col to u64)))
        ewrite(": ")
    }
    panic_cast()
}

/** teko::runtime::cast_check_u8_s — trap `i64 -> u8` out of `[0, 255]`. */
exp fn cast_check_u8_s(v: i64, line: u32, col: u32) { if v < 0 || v > 255 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_u16_s — trap `i64 -> u16` out of `[0, 65535]`. */
exp fn cast_check_u16_s(v: i64, line: u32, col: u32) { if v < 0 || v > 65535 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_u32_s — trap `i64 -> u32` out of `[0, 4294967295]`. */
exp fn cast_check_u32_s(v: i64, line: u32, col: u32) { if v < 0 || v > 4294967295 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_u64_s — trap `i64 -> u64` when negative. */
exp fn cast_check_u64_s(v: i64, line: u32, col: u32) { if v < 0 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_i8_s — trap `i64 -> i8` out of `[-128, 127]`. */
exp fn cast_check_i8_s(v: i64, line: u32, col: u32) { if v < -128 || v > 127 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_i16_s — trap `i64 -> i16` out of `[-32768, 32767]`. */
exp fn cast_check_i16_s(v: i64, line: u32, col: u32) { if v < -32768 || v > 32767 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_i32_s — trap `i64 -> i32` out of `[-2147483648, 2147483647]`. */
exp fn cast_check_i32_s(v: i64, line: u32, col: u32) { if v < -2147483648 || v > 2147483647 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_u8_u — trap `u64 -> u8` over `255`. */
exp fn cast_check_u8_u(v: u64, line: u32, col: u32) { if v > 255 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_u16_u — trap `u64 -> u16` over `65535`. */
exp fn cast_check_u16_u(v: u64, line: u32, col: u32) { if v > 65535 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_u32_u — trap `u64 -> u32` over `4294967295`. */
exp fn cast_check_u32_u(v: u64, line: u32, col: u32) { if v > 4294967295 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_i8_u — trap `u64 -> i8` over `127`. */
exp fn cast_check_i8_u(v: u64, line: u32, col: u32) { if v > 127 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_i16_u — trap `u64 -> i16` over `32767`. */
exp fn cast_check_i16_u(v: u64, line: u32, col: u32) { if v > 32767 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_i32_u — trap `u64 -> i32` over `2147483647`. */
exp fn cast_check_i32_u(v: u64, line: u32, col: u32) { if v > 2147483647 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_i64_u — trap `u64 -> i64` over `9223372036854775807`. */
exp fn cast_check_i64_u(v: u64, line: u32, col: u32) { if v > 9223372036854775807 { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_u8_from_f64 — trap `f64 -> u8` outside `[0, 255]` (NaN/inf trap). */
exp fn cast_check_u8_from_f64(v: f64, line: u32, col: u32) { if !(v >= 0.0 && v <= 255.0) { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_u16_from_f64 — trap `f64 -> u16` outside `[0, 65535]` (NaN/inf trap). */
exp fn cast_check_u16_from_f64(v: f64, line: u32, col: u32) { if !(v >= 0.0 && v <= 65535.0) { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_u32_from_f64 — trap `f64 -> u32` outside `[0, 4294967295]` (NaN/inf trap). */
exp fn cast_check_u32_from_f64(v: f64, line: u32, col: u32) { if !(v >= 0.0 && v <= 4294967295.0) { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_u64_from_f64 — trap `f64 -> u64` outside `[0, 2^64)` (NaN/inf trap). */
exp fn cast_check_u64_from_f64(v: f64, line: u32, col: u32) { if !(v >= 0.0 && v < 18446744073709551616.0) { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_i8_from_f64 — trap `f64 -> i8` outside `[-128, 127]` (NaN/inf trap). */
exp fn cast_check_i8_from_f64(v: f64, line: u32, col: u32) { if !(v >= -128.0 && v <= 127.0) { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_i16_from_f64 — trap `f64 -> i16` outside `[-32768, 32767]` (NaN/inf trap). */
exp fn cast_check_i16_from_f64(v: f64, line: u32, col: u32) { if !(v >= -32768.0 && v <= 32767.0) { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_i32_from_f64 — trap `f64 -> i32` outside `[-2147483648, 2147483647]` (NaN/inf trap). */
exp fn cast_check_i32_from_f64(v: f64, line: u32, col: u32) { if !(v >= -2147483648.0 && v <= 2147483647.0) { panic_cast_at(line, col) } }

/** teko::runtime::cast_check_i64_from_f64 — trap `f64 -> i64` outside `[-2^63, 2^63)` (NaN/inf trap). */
exp fn cast_check_i64_from_f64(v: f64, line: u32, col: u32) { if !(v >= -9223372036854775808.0 && v < 9223372036854775808.0) { panic_cast_at(line, col) } }

exp fn div(a: i64, b: i64): i64 {
    if b == 0 { panic_div0() }
    a / b
}

exp fn mod(a: i64, b: i64): i64 {
    if b == 0 { panic_div0() }
    a % b
}

exp fn to_u8(v: i64): u8 {
    if v < 0 || v > 255 { panic_cast() }
    v to u8
}

const INTERN_BUCKETS: u64 = 1024

const INTERN_BUCKET_MASK: u64 = 1023

const INTERN_KEY_PTR: u64 = 0

const INTERN_KEY_LEN: u64 = 8

const INTERN_VAL_PTR: u64 = 16

const INTERN_VAL_LEN: u64 = 24

const INTERN_NEXT: u64 = 32

const INTERN_ENTRY_BYTES: u64 = 40

/**
 * Returns the intern region handle as a word, materializing the region (a child of the program
 * region) on first use so the interned entries outlive every per-test arena rewind.
 *
 * @return  the intern region handle as a word
 */
fn intern_region_word(): u64 {
    var existing = teko::runtime::intern_region_slot()
    if existing != 0 { return existing }
    var region = teko::runtime::region_new(teko::runtime::region_program())
    var word = teko::sys::ptr_word(region) to u64
    teko::runtime::set_intern_region_slot(word)
    word
}

/**
 * Bump-allocates `n` bytes (rounded up from zero to one) inside the intern region and returns the
 * raw address.
 *
 * @param n  the number of bytes to reserve
 * @return   the base address of the reserved block
 */
fn intern_alloc(n: u64): u64 {
    var region = teko::sys::word_ptr(intern_region_word() to i64)
    var size = if n == 0 { 1 } else { n }
    teko::sys::ptr_word(teko::runtime::region_alloc(region, size)) to u64
}

/**
 * Returns the interning bucket table's base address, allocating and zero-filling a fresh
 * `INTERN_BUCKETS`-slot table in the intern region the first time it is needed.
 *
 * @return  the bucket-table base address
 */
fn intern_table(): u64 {
    var existing = teko::runtime::intern_table_slot()
    if existing != 0 { return existing }
    var tbase = intern_alloc(INTERN_BUCKETS * 8)
    var i: u64 = 0
    loop {
        if i >= INTERN_BUCKETS { break }
        teko::mem::store_u64(tbase + i * 8, 0)
        i++
    }
    teko::runtime::set_intern_table_slot(tbase)
    tbase
}

/**
 * Copies `s`'s bytes into a fresh block in the intern region and returns the block's address.
 *
 * @param s  the string whose bytes are copied into intern-region storage
 * @return   the base address of the stored copy
 */
fn intern_store_bytes(s: str): u64 {
    var addr = intern_alloc(s.len)
    var i: u64 = 0
    loop {
        if i >= s.len { break }
        teko::mem::store_u8(addr + i, s[i] to u64)
        i++
    }
    addr
}

/**
 * Tests whether the intern-region key at `kaddr` (length `klen`) equals `key` byte for byte.
 *
 * @param kaddr  the stored key's base address
 * @param klen   the stored key's length in bytes
 * @param key    the query key
 * @return       true when the stored key and `key` are byte-identical
 */
fn intern_key_eq(kaddr: u64, klen: u64, key: str): bool {
    if klen != key.len { return false }
    var i: u64 = 0
    loop {
        if i >= klen { break }
        if teko::mem::load_u8(kaddr + i) != (key[i] to u64) { return false }
        i++
    }
    true
}

/**
 * Walks the bucket chain rooted at `head` for the entry whose key equals `key`.
 *
 * @param head  the first entry address of the bucket chain, or 0 for an empty bucket
 * @param key   the key to locate
 * @return      the matching entry's address, or 0 when the chain holds no such key
 */
fn intern_find(head: u64, key: str): u64 {
    var e = head
    loop {
        if e == 0 { break }
        if intern_key_eq(teko::mem::load_u64(e + INTERN_KEY_PTR), teko::mem::load_u64(e + INTERN_KEY_LEN), key) { return e }
        e = teko::mem::load_u64(e + INTERN_NEXT)
    }
    0
}

/**
 * Builds a fresh copy, in the current region, of the value bytes held by entry `e`.
 *
 * @param e  the entry whose value is copied out
 * @return   an independent `str` owning a copy of the entry's value
 */
fn intern_read_val(e: u64): str {
    var vptr = teko::mem::load_u64(e + INTERN_VAL_PTR)
    var vlen = teko::mem::load_u64(e + INTERN_VAL_LEN)
    var xs: [vlen]byte = []
    var i: u64 = 0
    loop {
        if i >= vlen { break }
        xs[i] = teko::mem::load_u8(vptr + i) to byte
        i++
    }
    str(xs)
}

/**
 * Looks up `key` in the string-interning cache, returning a fresh independent copy of the cached
 * value. Migrates the C `tk_intern_get` (an FNV-1a hash-map over the arena); the returned `str`
 * never views the table's own storage, so a later `intern_put` cannot dangle it.
 *
 * @param key  the key to look up
 * @return     a copy of the cached value, or the empty string when the key is not present
 */
pub global fn intern_get(key: str): str {
    var table = intern_table()
    var bucket = table + (teko::runtime::str_hash(key) & INTERN_BUCKET_MASK) * 8
    var e = intern_find(teko::mem::load_u64(bucket), key)
    if e == 0 { return "" }
    intern_read_val(e)
}

/**
 * Interns `value` under `key`, replacing any prior value, and returns `value`. Migrates the C
 * `tk_intern_put`; key and value bytes are copied into the intern region so the cache owns them.
 *
 * @param key    the key to store under
 * @param value  the value to associate with `key`
 * @return       `value`, unchanged
 */
pub global fn intern_put(key: str, value: str): str {
    var table = intern_table()
    var bucket = table + (teko::runtime::str_hash(key) & INTERN_BUCKET_MASK) * 8
    var e = intern_find(teko::mem::load_u64(bucket), key)
    if e != 0 {
        teko::mem::store_u64(e + INTERN_VAL_PTR, intern_store_bytes(value))
        teko::mem::store_u64(e + INTERN_VAL_LEN, value.len)
        return value
    }
    var entry = intern_alloc(INTERN_ENTRY_BYTES)
    teko::mem::store_u64(entry + INTERN_KEY_PTR, intern_store_bytes(key))
    teko::mem::store_u64(entry + INTERN_KEY_LEN, key.len)
    teko::mem::store_u64(entry + INTERN_VAL_PTR, intern_store_bytes(value))
    teko::mem::store_u64(entry + INTERN_VAL_LEN, value.len)
    teko::mem::store_u64(entry + INTERN_NEXT, teko::mem::load_u64(bucket))
    teko::mem::store_u64(bucket, entry)
    value
}

/**
 * Empties the string-interning cache, dropping the intern region so every entry's storage is
 * reclaimed at once. Migrates the C `tk_intern_reset`; the next access lazily rebuilds the table.
 */
pub global fn intern_reset() {
    var region = teko::runtime::intern_region_slot()
    if region == 0 { return }
    teko::runtime::region_drop(teko::sys::word_ptr(region to i64))
    teko::runtime::set_intern_region_slot(0)
    teko::runtime::set_intern_table_slot(0)
}

const NAMES_GEN_SHIFT: u64 = 32

const NAMES_SLOT_MASK: u64 = 4294967295

const NAMES_NO_SLOT: u64 = 4294967295

const NAMES_GEN_MAX: u64 = 4294967295

const NAMES_INITIAL_CAP: u64 = 16

const NAMES_KIND_CELL: u64 = 1

const NAMES_OK: i64 = 0

const NAMES_ERR_UNKNOWN: i64 = -1

const NAMES_ERR_CLOSED: i64 = -2

const NAMES_ERR_KIND: i64 = -3

const NAMES_NO_VALUE: i64 = -9223372036854775807 - 1

const NS_TABLE: u64 = 0

const NS_CAP: u64 = 8

const NS_USED: u64 = 16

const NS_LIVE: u64 = 24

const NS_FREE: u64 = 32

const NS_BYTES: u64 = 40

const NAME_RESOURCE: u64 = 0

const NAME_GEN: u64 = 8

const NAME_KIND: u64 = 16

const NAME_NEXT_FREE: u64 = 24

const NAME_LIVE: u64 = 32

const NAME_SLOT_BYTES: u64 = 40

/**
 * Returns the name-registry state block, allocating and initializing it in the program region the
 * first time the registry is touched so the handle table is program-resident (survives task exit).
 *
 * @return  the state-block address
 */
fn names_state(): u64 {
    var existing = teko::runtime::names_state_slot()
    if existing != 0 { return existing }
    var block = teko::sys::ptr_word(teko::runtime::Arena::current().program().alloc(NS_BYTES)) to u64
    teko::mem::store_u64(block + NS_TABLE, 0)
    teko::mem::store_u64(block + NS_CAP, 0)
    teko::mem::store_u64(block + NS_USED, 0)
    teko::mem::store_u64(block + NS_LIVE, 0)
    teko::mem::store_u64(block + NS_FREE, NAMES_NO_SLOT)
    teko::runtime::set_names_state_slot(block)
    block
}

/**
 * Returns the address of slot `index` within the registry's slot array.
 *
 * @param st     the registry state block
 * @param index  the zero-based slot index
 * @return       the slot's base address
 */
fn names_slot_addr(st: u64, index: u64): u64 {
    teko::mem::load_u64(st + NS_TABLE) + index * NAME_SLOT_BYTES
}

/**
 * Doubles the slot array inside the program region and copies the live prefix over. The bump
 * allocator has no realloc, so the previous array is abandoned until process exit.
 *
 * @param st  the registry state block
 * @return    true when the array grew, false when the index space is exhausted
 */
fn names_grow(st: u64): bool {
    var cap = teko::mem::load_u64(st + NS_CAP)
    var ncap = if cap == 0 { NAMES_INITIAL_CAP } else { cap * 2 }
    if ncap > NAMES_NO_SLOT { ncap = NAMES_NO_SLOT }
    if ncap <= cap { return false }
    var grown = teko::sys::ptr_word(teko::runtime::Arena::current().program().alloc(ncap * NAME_SLOT_BYTES)) to u64
    var used_bytes = teko::mem::load_u64(st + NS_USED) * NAME_SLOT_BYTES
    var old = teko::mem::load_u64(st + NS_TABLE)
    var i: u64 = 0
    loop {
        if i >= used_bytes { break }
        teko::mem::store_u64(grown + i, teko::mem::load_u64(old + i))
        i = i + 8
    }
    teko::mem::store_u64(st + NS_TABLE, grown)
    teko::mem::store_u64(st + NS_CAP, ncap)
    true
}

/**
 * Reserves a slot and returns its index, recycling the free list when possible and growing the
 * array otherwise, without touching `kind` or `resource` (the caller decides those).
 *
 * @param st  the registry state block
 * @return    the reserved slot index, or `NAMES_NO_SLOT` when no slot can be issued
 */
fn names_take(st: u64): u64 {
    var free = teko::mem::load_u64(st + NS_FREE)
    var index: u64 = 0
    if free != NAMES_NO_SLOT {
        index = free
        teko::mem::store_u64(st + NS_FREE, teko::mem::load_u64(names_slot_addr(st, index) + NAME_NEXT_FREE))
    } else {
        var used = teko::mem::load_u64(st + NS_USED)
        if used == teko::mem::load_u64(st + NS_CAP) {
            if !names_grow(st) { return NAMES_NO_SLOT }
        }
        index = used
        teko::mem::store_u64(st + NS_USED, used + 1)
        var fresh = names_slot_addr(st, index)
        teko::mem::store_u64(fresh + NAME_RESOURCE, 0)
        teko::mem::store_u64(fresh + NAME_GEN, 1)
        teko::mem::store_u64(fresh + NAME_KIND, 0)
    }
    var slot = names_slot_addr(st, index)
    teko::mem::store_u64(slot + NAME_NEXT_FREE, NAMES_NO_SLOT)
    teko::mem::store_u64(slot + NAME_LIVE, 1)
    teko::mem::store_u64(st + NS_LIVE, teko::mem::load_u64(st + NS_LIVE) + 1)
    index
}

/**
 * Mints the name (generation in the high half, slot index in the low half) that slot `index`
 * currently carries.
 *
 * @param st     the registry state block
 * @param index  the slot index
 * @return       the packed name
 */
fn names_name_of(st: u64, index: u64): u64 {
    (teko::mem::load_u64(names_slot_addr(st, index) + NAME_GEN) << NAMES_GEN_SHIFT) | index
}

/**
 * Classifies `name` against the registry: live, never-issued, or closed. The three generation
 * comparisons are the guarantee — a stamp above the slot's was never issued, one below belonged to a
 * closed tenant, and a non-live slot is unknown.
 *
 * @param st    the registry state block
 * @param name  the name to classify
 * @return      `NAMES_OK`, `NAMES_ERR_UNKNOWN`, or `NAMES_ERR_CLOSED`
 */
fn names_check(st: u64, name: u64): i64 {
    var index = name & NAMES_SLOT_MASK
    var gen = name >> NAMES_GEN_SHIFT
    if gen == 0 || index >= teko::mem::load_u64(st + NS_USED) { return NAMES_ERR_UNKNOWN }
    var sgen = teko::mem::load_u64(names_slot_addr(st, index) + NAME_GEN)
    if gen > sgen { return NAMES_ERR_UNKNOWN }
    if gen < sgen { return NAMES_ERR_CLOSED }
    if teko::mem::load_u64(names_slot_addr(st, index) + NAME_LIVE) == 0 { return NAMES_ERR_UNKNOWN }
    NAMES_OK
}

/**
 * Returns the resource `name` stands for when it is a live handle of `kind`, else 0.
 *
 * @param st    the registry state block
 * @param name  the name to resolve
 * @param kind  the required resource kind
 * @return      the resource address, or 0 when the name is stale or of another kind
 */
fn names_lookup(st: u64, name: u64, kind: u64): u64 {
    if names_check(st, name) != NAMES_OK { return 0 }
    var slot = names_slot_addr(st, name & NAMES_SLOT_MASK)
    if teko::mem::load_u64(slot + NAME_KIND) != kind { return 0 }
    teko::mem::load_u64(slot + NAME_RESOURCE)
}

/**
 * Opens a cell (one int64 in the program region) holding `value` and returns its name. Migrates
 * `tk_names_cell_open`; a recycled slot reuses its previous cell's storage.
 *
 * @param value  the initial cell value; `NAMES_NO_VALUE` is refused (not storable)
 * @return       the fresh name, or 0 on refusal or slot exhaustion
 */
pub fn names_cell_open(value: i64): u64 {
    if value == NAMES_NO_VALUE { return 0 }
    var st = names_state()
    var index = names_take(st)
    if index == NAMES_NO_SLOT { return 0 }
    var slot = names_slot_addr(st, index)
    if teko::mem::load_u64(slot + NAME_KIND) != NAMES_KIND_CELL || teko::mem::load_u64(slot + NAME_RESOURCE) == 0 {
        var cell = teko::sys::ptr_word(teko::runtime::Arena::current().program().alloc(8)) to u64
        teko::mem::store_u64(slot + NAME_RESOURCE, cell)
        teko::mem::store_u64(slot + NAME_KIND, NAMES_KIND_CELL)
    }
    teko::mem::store_u64(teko::mem::load_u64(slot + NAME_RESOURCE), value to u64)
    names_name_of(st, index)
}

/**
 * Reads the value held by the cell named `name`, or `NAMES_NO_VALUE` for a dead name. Migrates
 * `tk_names_cell_read`.
 *
 * @param name  the cell's name
 * @return      the cell's value, or `NAMES_NO_VALUE` when the name is not a live cell
 */
pub fn names_cell_read(name: u64): i64 {
    var cell = names_lookup(names_state(), name, NAMES_KIND_CELL)
    if cell == 0 { return NAMES_NO_VALUE }
    teko::mem::load_u64(cell) to i64
}

/**
 * Reports whether `name` is a live cell, else the failure mode. Migrates `tk_names_cell_status`.
 *
 * @param name  the name to check
 * @return      `NAMES_OK`, or the failure status (`NAMES_ERR_KIND` when it names another kind)
 */
pub fn names_cell_status(name: u64): i64 {
    var st = names_state()
    var status = names_check(st, name)
    if status != NAMES_OK { return status }
    if teko::mem::load_u64(names_slot_addr(st, name & NAMES_SLOT_MASK) + NAME_KIND) != NAMES_KIND_CELL { return NAMES_ERR_KIND }
    NAMES_OK
}

/**
 * Reports the liveness/staleness status of `name`, kind-agnostic. Migrates `tk_names_status`.
 *
 * @param name  the name to classify
 * @return      `NAMES_OK` or the failure mode
 */
pub fn names_status(name: u64): i64 {
    names_check(names_state(), name)
}

/**
 * Closes `name`, bumping its slot's generation so every name ever issued for that slot becomes
 * strictly older, and recycles the slot unless its stamp has retired. Migrates `tk_names_close`.
 *
 * @param name  the name to close
 * @return      `NAMES_OK`, or the failure mode when the name was not live
 */
pub fn names_close(name: u64): i64 {
    var st = names_state()
    var status = names_check(st, name)
    if status != NAMES_OK { return status }
    var index = name & NAMES_SLOT_MASK
    var slot = names_slot_addr(st, index)
    teko::mem::store_u64(slot + NAME_LIVE, 0)
    teko::mem::store_u64(slot + NAME_GEN, teko::mem::load_u64(slot + NAME_GEN) + 1)
    teko::mem::store_u64(st + NS_LIVE, teko::mem::load_u64(st + NS_LIVE) - 1)
    if teko::mem::load_u64(slot + NAME_GEN) >= NAMES_GEN_MAX { return NAMES_OK }
    teko::mem::store_u64(slot + NAME_NEXT_FREE, teko::mem::load_u64(st + NS_FREE))
    teko::mem::store_u64(st + NS_FREE, index)
    NAMES_OK
}

/**
 * Returns how many names are live right now. Migrates `tk_names_live_count`.
 *
 * @return  the live-name count
 */
pub fn names_live_count(): u64 {
    teko::mem::load_u64(names_state() + NS_LIVE)
}

/**
 * Returns the slot array's current capacity. Migrates `tk_names_capacity`.
 *
 * @return  the number of slots the array can hold
 */
pub fn names_capacity(): u64 {
    teko::mem::load_u64(names_state() + NS_CAP)
}

/**
 * Extracts the slot index encoded in `name`. Migrates `tk_names_slot_of`.
 *
 * @param name  the packed name
 * @return      the slot index (the name's low half)
 */
pub fn names_slot_of(name: u64): u64 {
    name & NAMES_SLOT_MASK
}

/**
 * Extracts the generation stamp encoded in `name`. Migrates `tk_names_generation_of`.
 *
 * @param name  the packed name
 * @return      the generation stamp (the name's high half)
 */
pub fn names_generation_of(name: u64): u64 {
    name >> NAMES_GEN_SHIFT
}
