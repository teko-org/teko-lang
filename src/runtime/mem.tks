fn mem_same_word_align(a: u64, b: u64): bool {
    (a & 7) == (b & 7)
}

fn mem_forward(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    if mem_same_word_align(dst, src) {
        loop {
            if i >= n { break }
            if ((dst + i) & 7) == 0 { break }
            teko::mem::store_u8(dst + i, teko::mem::load_u8(src + i))
            i++
        }
        loop {
            if i + 8 > n { break }
            teko::mem::store_u64(dst + i, teko::mem::load_u64(src + i))
            i = i + 8
        }
    }
    loop {
        if i >= n { break }
        teko::mem::store_u8(dst + i, teko::mem::load_u8(src + i))
        i++
    }
}

pub fn rt_memcpy(dst: u64, src: u64, n: u64): u64 {
    mem_forward(dst, src, n)
    dst
}

pub fn rt_memset(dst: u64, value: u64, n: u64): u64 {
    var byte_value = value & 0xFF
    var word = byte_value * 0x0101010101010101
    var i: u64 = 0
    loop {
        if i >= n { break }
        if ((dst + i) & 7) == 0 { break }
        teko::mem::store_u8(dst + i, byte_value)
        i++
    }
    loop {
        if i + 8 > n { break }
        teko::mem::store_u64(dst + i, word)
        i = i + 8
    }
    loop {
        if i >= n { break }
        teko::mem::store_u8(dst + i, byte_value)
        i++
    }
    dst
}

pub fn rt_memmove(dst: u64, src: u64, n: u64): u64 {
    if dst == src { return dst }
    if dst < src {
        mem_forward(dst, src, n)
        return dst
    }
    var j = n
    loop {
        if j == 0 { break }
        j = j - 1
        teko::mem::store_u8(dst + j, teko::mem::load_u8(src + j))
    }
    dst
}

pub fn rt_memcmp(a: u64, b: u64, n: u64): i64 {
    var i: u64 = 0
    loop {
        if i >= n { break }
        var av = teko::mem::load_u8(a + i)
        var bv = teko::mem::load_u8(b + i)
        if av != bv { return (av to i64) - (bv to i64) }
        i++
    }
    0
}
