use teko::numeric::bigint

const RADIX: u64 = 10

const RADIX_PRIME_LO: u64 = 2

const RADIX_PRIME_HI: u64 = 5

/**
 * Arbitrary-precision base-10 decimal: the exact value `num / den`, where `den` is a non-negative
 * power of ten. Value-semantic and immutable. The compiler-known `dec` surface name resolves to this
 * struct.
 */
exp type Decimal = struct {
    num: bigint::BigInt
    den: bigint::BigInt
}

type FactorOut = struct {
    count: u64
    reduced: bigint::BigInt
}

fn pow_small(pow_base: u64, e: u64): bigint::BigInt {
    var b = bigint::of(pow_base to i64)
    var r = bigint::one()
    var i: u64 = 0
    loop {
        if i >= e { break }
        r = bigint::mul(r, b)
        i = i + 1
    }
    r
}

fn pow10(k: u64): bigint::BigInt {
    pow_small(RADIX, k)
}

fn big_gcd(a: bigint::BigInt, b: bigint::BigInt): bigint::BigInt {
    var x = bigint::abs(a)
    var y = bigint::abs(b)
    loop {
        if bigint::is_zero(y) { break }
        var r = bigint::rem(x, y)
        x = y
        y = r
    }
    x
}

fn extract_factor(x: bigint::BigInt, f: u64): FactorOut {
    var fb = bigint::of(f to i64)
    var cur = x
    var cnt: u64 = 0
    loop {
        if bigint::is_zero(cur) { break }
        if !bigint::is_zero(bigint::rem(cur, fb)) { break }
        cur = bigint::div(cur, fb)
        cnt = cnt + 1
    }
    FactorOut { count = cnt; reduced = cur }
}

fn max_u64(a: u64, b: u64): u64 {
    if a > b { return a }
    b
}

/** Normalize a decimal: trim shared factors of ten from `num`/`den`, canonicalize zero to `0 / 1`. */
exp fn normalize(d: Decimal): Decimal {
    if bigint::is_zero(d.num) { return Decimal { num = bigint::zero(); den = bigint::one() } }
    var ten = bigint::of(RADIX to i64)
    var num = d.num
    var den = d.den
    loop {
        if bigint::eq(den, bigint::one()) { break }
        if !bigint::is_zero(bigint::rem(num, ten)) { break }
        num = bigint::div(num, ten)
        den = bigint::div(den, ten)
    }
    Decimal { num = num; den = den }
}

/** The whole `Decimal` for a machine `i64` (denominator `1`). */
exp fn of(n: i64): Decimal {
    Decimal { num = bigint::of(n); den = bigint::one() }
}

/** The whole `Decimal` for a machine `u64` (denominator `1`). */
exp fn of_u64(n: u64): Decimal {
    Decimal { num = bigint::of_u64(n); den = bigint::one() }
}

/**
 * Parse a decimal string into a `Decimal`. Accepts `[-]int[.frac][e[+-]exp]` with `_` group
 * separators. Returns an error for malformed input.
 */
exp fn from_str(s: str): Decimal | error {
    if s.len == 0 { return error { message = "dec::from_str: empty string" } }
    var i: u64 = 0
    var neg = false
    if s[0] == b'-' { neg = true; i = 1 } else { if s[0] == b'+' { i = 1 } }
    var digits: [s.len]byte = []
    var ndigits: u64 = 0
    var scale: u64 = 0
    var seen_dot = false
    var saw_digit = false
    loop {
        if i >= s.len { break }
        var c = s[i]
        if c == b'_' { i = i + 1; continue }
        if c == b'e' || c == b'E' { break }
        if c == b'.' {
            if seen_dot { return error { message = "dec::from_str: multiple decimal points" } }
            seen_dot = true
            i = i + 1
            continue
        }
        if c < b'0' || c > b'9' { return error { message = "dec::from_str: invalid character" } }
        digits[ndigits] = c
        ndigits++
        if seen_dot { scale = scale + 1 }
        saw_digit = true
        i = i + 1
    }
    if !saw_digit { return error { message = "dec::from_str: no digits" } }
    var expv = match parse_exponent(s, i) { i64 as e => e; error as er => return er }
    var digstr = match teko::text::str_from_utf8(teko::collections::arr_slice(digits, 0, ndigits)) { str as ss => ss; error => return error { message = "dec::from_str: internal digit encoding" } }
    var num = match bigint::from_str(digstr) { bigint::BigInt as bb => bb; error as e => return e }
    if neg { num = bigint::neg(num) }
    var fscale: i64 = (scale to i64) - expv
    if fscale >= 0 { return normalize(Decimal { num = num; den = pow10(fscale to u64) }) }
    var scaled = bigint::mul(num, pow10((0 - fscale) to u64))
    normalize(Decimal { num = scaled; den = bigint::one() })
}

fn parse_exponent(s: str, i: u64): i64 | error {
    if i >= s.len { return 0 }
    if s[i] != b'e' && s[i] != b'E' { return 0 }
    var j = i + 1
    var eneg = false
    if j < s.len && s[j] == b'-' { eneg = true; j = j + 1 } else { if j < s.len && s[j] == b'+' { j = j + 1 } }
    var eval: i64 = 0
    var esaw = false
    loop {
        if j >= s.len { break }
        var c = s[j]
        if c == b'_' { j = j + 1; continue }
        if c < b'0' || c > b'9' { return error { message = "dec::from_str: invalid exponent" } }
        eval = eval * (RADIX to i64) + ((c to i64) - (b'0' to i64))
        esaw = true
        j = j + 1
    }
    if !esaw { return error { message = "dec::from_str: empty exponent" } }
    if eneg { return 0 - eval }
    eval
}

/** Parse a literal decimal string into a `Decimal`. Panics on malformed input (the lexer already validated it). */
exp fn of_lit(s: str): Decimal {
    match from_str(s) {
        Decimal as d => d
        error as e => panic(e.message)
    }
}

fn den_scale(den: bigint::BigInt): u64 {
    var s = bigint::to_str(den)
    s.len - 1
}

/** Render a `Decimal` to its canonical decimal string. */
exp fn to_str(x: Decimal): str {
    var nx = normalize(x)
    var k = den_scale(nx.den)
    var numabs = bigint::to_str(bigint::abs(nx.num))
    var sign = if bigint::is_neg(nx.num) { "-" } else { "" }
    if k == 0 { return teko::str::concat(sign, numabs) }
    var digits = numabs
    loop {
        if digits.len >= k + 1 { break }
        digits = teko::str::concat("0", digits)
    }
    var intpart = digits.slice_to(digits.len - k)
    var fracpart = digits.slice_from(digits.len - k)
    teko::str::concat(sign, intpart, ".", fracpart)
}

/** Negate a `Decimal`. */
exp fn neg(x: Decimal): Decimal {
    Decimal { num = bigint::neg(x.num); den = x.den }
}

/** Add two decimals exactly. */
exp fn add(a: Decimal, b: Decimal): Decimal {
    var num = bigint::add(bigint::mul(a.num, b.den), bigint::mul(b.num, a.den))
    var den = bigint::mul(a.den, b.den)
    normalize(Decimal { num = num; den = den })
}

/** Subtract `b` from `a` exactly. */
exp fn sub(a: Decimal, b: Decimal): Decimal {
    var num = bigint::sub(bigint::mul(a.num, b.den), bigint::mul(b.num, a.den))
    var den = bigint::mul(a.den, b.den)
    normalize(Decimal { num = num; den = den })
}

/** Multiply two decimals exactly. */
exp fn mul(a: Decimal, b: Decimal): Decimal {
    var num = bigint::mul(a.num, b.num)
    var den = bigint::mul(a.den, b.den)
    normalize(Decimal { num = num; den = den })
}

/**
 * Divide `a` by `b`, exact-or-panic: the result must terminate in base 10. A non-terminating
 * quotient (e.g. `1 / 3`) panics rather than silently rounding; a zero divisor panics.
 */
exp fn div(a: Decimal, b: Decimal): Decimal {
    var p = bigint::mul(a.num, b.den)
    var q = bigint::mul(a.den, b.num)
    if bigint::is_zero(q) { panic("dec::div: division by zero") }
    if bigint::is_neg(q) { p = bigint::neg(p); q = bigint::neg(q) }
    var g = big_gcd(p, q)
    p = bigint::div(p, g)
    q = bigint::div(q, g)
    var f2 = extract_factor(q, RADIX_PRIME_LO)
    var f5 = extract_factor(f2.reduced, RADIX_PRIME_HI)
    if !bigint::eq(f5.reduced, bigint::one()) { panic("dec::div: non-terminating quotient (not exact)") }
    var k = max_u64(f2.count, f5.count)
    var num = bigint::mul(p, bigint::mul(pow_small(RADIX_PRIME_LO, k - f2.count), pow_small(RADIX_PRIME_HI, k - f5.count)))
    normalize(Decimal { num = num; den = pow10(k) })
}

/** Three-way compare of two decimals. */
exp fn cmp(a: Decimal, b: Decimal): i64 {
    bigint::cmp(bigint::mul(a.num, b.den), bigint::mul(b.num, a.den))
}

/** Value equality of two decimals. */
exp fn eq(a: Decimal, b: Decimal): bool {
    cmp(a, b) == 0
}
