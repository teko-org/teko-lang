const LIMB_BITS: u64 = 32

const LIMB_BASE: u64 = 4294967296

const LIMB_MASK: u64 = 4294967295

const DEC_RADIX: u64 = 10

/**
 * Arbitrary-precision signed integer. Sign-magnitude, little-endian base-2^32 limbs, value-semantic
 * and immutable. The compiler-known `bigint` surface name resolves to this struct.
 */
exp type BigInt = struct {
    neg: bool
    limbs: []u64
}

type MagDivMod = struct {
    q: []u64
    r: []u64
}

type SmallDivMod = struct {
    q: []u64
    r: u64
}

fn zeros(n: u64): []u64 {
    var out: [n]u64 = []
    out
}

fn bit_mask(pos: u64): u64 {
    var one: u64 = 1
    one << pos
}

fn mag_norm(limbs: []u64): []u64 {
    var n = limbs.len
    loop {
        if n == 0 { break }
        if limbs[n - 1] != 0 { break }
        n = n - 1
    }
    if n == limbs.len { return limbs }
    teko::collections::arr_slice(limbs, 0, n)
}

fn mag_is_zero(a: []u64): bool {
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if a[i] != 0 { return false }
        i = i + 1
    }
    true
}

fn mag_cmp(a: []u64, b: []u64): i64 {
    if a.len != b.len {
        if a.len > b.len { return 1 }
        return -1
    }
    var i = a.len
    loop {
        if i == 0 { break }
        i = i - 1
        if a[i] != b[i] {
            if a[i] > b[i] { return 1 }
            return -1
        }
    }
    0
}

fn mag_add(a: []u64, b: []u64): []u64 {
    var n = if a.len > b.len { a.len } else { b.len }
    var out: [n + 1]u64 = []
    var count: u64 = 0
    var carry: u64 = 0
    var i: u64 = 0
    loop {
        if i >= n { break }
        var s = carry
        if i < a.len { s = s + a[i] }
        if i < b.len { s = s + b[i] }
        out[count] = s & LIMB_MASK
        count++
        carry = s >> LIMB_BITS
        i = i + 1
    }
    if carry != 0 {
        out[count] = carry
        count++
    }
    mag_norm(teko::collections::arr_slice(out, 0, count))
}

fn mag_sub(a: []u64, b: []u64): []u64 {
    var out: [a.len]u64 = []
    var borrow: u64 = 0
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        var ai = a[i]
        var sub = borrow
        if i < b.len { sub = sub + b[i] }
        if ai >= sub {
            out[i] = ai - sub
            borrow = 0
        } else {
            out[i] = ai + LIMB_BASE - sub
            borrow = 1
        }
        i = i + 1
    }
    mag_norm(out)
}

fn mag_mul(a: []u64, b: []u64): []u64 {
    if a.len == 0 { return [] }
    if b.len == 0 { return [] }
    var r = zeros(a.len + b.len)
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        var carry: u64 = 0
        var j: u64 = 0
        loop {
            if j >= b.len { break }
            var cur = r[i + j] + a[i] * b[j] + carry
            r[i + j] = cur & LIMB_MASK
            carry = cur >> LIMB_BITS
            j = j + 1
        }
        var k = i + b.len
        loop {
            if carry == 0 { break }
            var cur2 = r[k] + carry
            r[k] = cur2 & LIMB_MASK
            carry = cur2 >> LIMB_BITS
            k = k + 1
        }
        i = i + 1
    }
    mag_norm(r)
}

fn mag_bitlen(a: []u64): u64 {
    var n = mag_norm(a)
    if n.len == 0 { return 0 }
    var hi = n[n.len - 1]
    var bits: u64 = 0
    var v = hi
    loop {
        if v == 0 { break }
        bits = bits + 1
        v = v >> 1
    }
    (n.len - 1) * LIMB_BITS + bits
}

fn mag_bit(a: []u64, i: u64): u64 {
    var limb = i / LIMB_BITS
    var pos = i % LIMB_BITS
    if limb >= a.len { return 0 }
    (a[limb] >> pos) & 1
}

fn mag_shl1(a: []u64): []u64 {
    var out: [a.len + 1]u64 = []
    var count: u64 = 0
    var carry: u64 = 0
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        var v = ((a[i] << 1) & LIMB_MASK) | carry
        out[count] = v
        count++
        carry = (a[i] >> (LIMB_BITS - 1)) & 1
        i = i + 1
    }
    if carry != 0 {
        out[count] = carry
        count++
    }
    mag_norm(teko::collections::arr_slice(out, 0, count))
}

fn mag_setbit(a: []u64, i: u64): []u64 {
    var limb = i / LIMB_BITS
    var pos = i % LIMB_BITS
    var need = limb + 1
    var n = if a.len > need { a.len } else { need }
    var out = zeros(n)
    var j: u64 = 0
    loop {
        if j >= a.len { break }
        out[j] = a[j]
        j = j + 1
    }
    out[limb] = out[limb] | bit_mask(pos)
    mag_norm(out)
}

fn mag_divmod_small(a: []u64, d: u64): SmallDivMod {
    var q = zeros(a.len)
    var r: u64 = 0
    var i = a.len
    loop {
        if i == 0 { break }
        i = i - 1
        var cur = (r << LIMB_BITS) | a[i]
        q[i] = cur / d
        r = cur % d
    }
    SmallDivMod { q = mag_norm(q); r = r }
}

fn mag_divmod(a: []u64, b: []u64): MagDivMod {
    var n = mag_bitlen(a)
    var q: []u64 = []
    var r: []u64 = []
    var i = n
    loop {
        if i == 0 { break }
        i = i - 1
        r = mag_shl1(r)
        if mag_bit(a, i) == 1 { r = mag_setbit(r, 0) }
        if mag_cmp(r, b) >= 0 {
            r = mag_sub(r, b)
            q = mag_setbit(q, i)
        }
    }
    MagDivMod { q = mag_norm(q); r = mag_norm(r) }
}

fn one_limb(v: u64): []u64 {
    if v == 0 { return [] }
    var lo = v & LIMB_MASK
    var hi = v >> LIMB_BITS
    if hi != 0 { return [lo, hi] }
    [lo]
}

fn mk(neg: bool, limbs: []u64): BigInt {
    var n = mag_norm(limbs)
    if n.len == 0 { return BigInt { neg = false; limbs = n } }
    BigInt { neg = neg; limbs = n }
}

/** The zero `BigInt`. */
exp fn zero(): BigInt {
    BigInt { neg = false; limbs = [] }
}

/** The unit `BigInt`. */
exp fn one(): BigInt {
    mk(false, one_limb(1))
}

/** Is this value zero? */
exp fn is_zero(x: BigInt): bool {
    mag_is_zero(x.limbs)
}

/** Convert a machine `i64` to a `BigInt` (handles `i64::MIN` correctly). */
exp fn of(n: i64): BigInt {
    if n == 0 { return zero() }
    var neg = n < 0
    var mag: u64 = if neg { ((0 - (n + 1)) to u64) + 1 } else { n to u64 }
    mk(neg, one_limb(mag))
}

/** Convert a machine `u64` to a non-negative `BigInt`. */
exp fn of_u64(n: u64): BigInt {
    if n == 0 { return zero() }
    mk(false, one_limb(n))
}

/**
 * Parse a decimal string into a `BigInt`. Accepts an optional leading `+`/`-`, decimal digits, and
 * `_` group separators. Returns an error for an empty string or an invalid character.
 */
exp fn from_str(s: str): BigInt | error {
    if s.len == 0 { return error { message = "bigint::parse: empty string" } }
    var i: u64 = 0
    var neg = false
    if s[0] == b'-' { neg = true; i = 1 } else { if s[0] == b'+' { i = 1 } }
    var ten = one_limb(DEC_RADIX)
    var mag: []u64 = []
    var saw_digit = false
    loop {
        if i >= s.len { break }
        var c = s[i]
        if c == b'_' { i = i + 1; continue }
        if c < b'0' || c > b'9' { return error { message = "bigint::parse: invalid decimal digit" } }
        var d = (c to u64) - (b'0' to u64)
        mag = mag_add(mag_mul(mag, ten), one_limb(d))
        saw_digit = true
        i = i + 1
    }
    if !saw_digit { return error { message = "bigint::parse: no digits" } }
    mk(neg, mag)
}

/** Parse a literal digit string into a `BigInt`. Panics on malformed input (the lexer already validated it). */
exp fn of_lit(s: str): BigInt {
    match from_str(s) {
        BigInt as b => b
        error as e => panic(e.message)
    }
}

/** Render a `BigInt` to its canonical decimal string. */
exp fn to_str(x: BigInt): str {
    if is_zero(x) { return "0" }
    var digs: [x.limbs.len * 20]byte = []
    var ndigs: u64 = 0
    var m = x.limbs
    loop {
        if mag_is_zero(m) { break }
        var dm = mag_divmod_small(m, DEC_RADIX)
        digs[ndigs] = ((b'0' to u64) + dm.r) to byte
        ndigs++
        m = dm.q
    }
    var neg_len = if x.neg { 1 to u64 } else { 0 to u64 }
    var out: [ndigs + neg_len]byte = []
    var pos: u64 = 0
    if x.neg {
        out[pos] = b'-'
        pos++
    }
    var i = ndigs
    loop {
        if i == 0 { break }
        i = i - 1
        out[pos] = digs[i]
        pos++
    }
    match teko::text::str_from_utf8(out) {
        str as s => s
        error => ""
    }
}

/** Negate a `BigInt` (zero is unchanged). */
exp fn neg(x: BigInt): BigInt {
    if is_zero(x) { return zero() }
    mk(!x.neg, x.limbs)
}

/** The magnitude (absolute value) of a `BigInt`. */
exp fn abs(x: BigInt): BigInt {
    mk(false, x.limbs)
}

/** Add two `BigInt`s. */
exp fn add(a: BigInt, b: BigInt): BigInt {
    if a.neg == b.neg { return mk(a.neg, mag_add(a.limbs, b.limbs)) }
    var c = mag_cmp(a.limbs, b.limbs)
    if c == 0 { return zero() }
    if c > 0 { return mk(a.neg, mag_sub(a.limbs, b.limbs)) }
    mk(b.neg, mag_sub(b.limbs, a.limbs))
}

/** Subtract `b` from `a`. */
exp fn sub(a: BigInt, b: BigInt): BigInt {
    add(a, neg(b))
}

/** Multiply two `BigInt`s. */
exp fn mul(a: BigInt, b: BigInt): BigInt {
    mk(a.neg != b.neg, mag_mul(a.limbs, b.limbs))
}

/** Truncating integer division `a / b` (quotient rounded toward zero). Panics on a zero divisor. */
exp fn div(a: BigInt, b: BigInt): BigInt {
    if is_zero(b) { panic("bigint::div: division by zero") }
    var dm = mag_divmod(a.limbs, b.limbs)
    mk(a.neg != b.neg, dm.q)
}

/** Remainder `a % b`, with the sign of the dividend. Panics on a zero divisor. */
exp fn rem(a: BigInt, b: BigInt): BigInt {
    if is_zero(b) { panic("bigint::rem: division by zero") }
    var dm = mag_divmod(a.limbs, b.limbs)
    mk(a.neg, dm.r)
}

/** Three-way compare: `1` if `a > b`, `-1` if `a < b`, `0` if equal. */
exp fn cmp(a: BigInt, b: BigInt): i64 {
    if a.neg != b.neg {
        if a.neg { return -1 }
        return 1
    }
    var mc = mag_cmp(a.limbs, b.limbs)
    if a.neg { return 0 - mc }
    mc
}

/** Value equality of two `BigInt`s. */
exp fn eq(a: BigInt, b: BigInt): bool {
    cmp(a, b) == 0
}

/** Is this value strictly negative? */
exp fn is_neg(x: BigInt): bool {
    x.neg
}
