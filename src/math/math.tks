/** Ratio of a circle's circumference to its diameter. */
exp const PI: f64 = 3.14159265358979323846

/** `2 * PI`. */
exp const TAU: f64 = 6.28318530717958647692

/** Euler's number, the base of the natural logarithm. */
exp const E: f64 = 2.71828182845904523536

/** Square root of 2. */
exp const SQRT2: f64 = 1.41421356237309504880

/** Natural logarithm of 2. */
exp const LN2: f64 = 0.69314718055994530942

/** Natural logarithm of 10. */
exp const LN10: f64 = 2.30258509299404568402

const EXPONENT_MASK: u64 = 0x7FF0000000000000
const MANTISSA_MASK: u64 = 0x000FFFFFFFFFFFFF
const SIGN_MASK: u64 = 0x8000000000000000

/** Positive IEEE-754 infinity. */
exp fn inf(): f64 { teko::f64_from_bits(0x7FF0000000000000) }

/** A quiet NaN. */
exp fn nan(): f64 { teko::f64_from_bits(0x7FF8000000000000) }

/** True iff `v` is NaN. */
exp fn is_nan(v: f64): bool {
    var bits = teko::f64_bits(v)
    (bits & EXPONENT_MASK) == EXPONENT_MASK && (bits & MANTISSA_MASK) != 0
}

/** True iff `v` is positive or negative infinity. */
exp fn is_inf(v: f64): bool {
    var bits = teko::f64_bits(v)
    (bits & EXPONENT_MASK) == EXPONENT_MASK && (bits & MANTISSA_MASK) == 0
}

/** True iff `v` is neither NaN nor infinite. */
exp fn is_finite(v: f64): bool {
    (teko::f64_bits(v) & EXPONENT_MASK) != EXPONENT_MASK
}

/** True iff `v` is finite, nonzero, and not subnormal. */
exp fn is_normal(v: f64): bool {
    var exp_bits = teko::f64_bits(v) & EXPONENT_MASK
    exp_bits != 0 && exp_bits != EXPONENT_MASK
}

/** Absolute value; `i64::MIN` has no representable result. */
exp fn abs_i64(v: i64): i64 | error {
    if v == -9223372036854775807 - 1 {
        return error { message = "math::abs_i64: i64::MIN has no representable absolute value" }
    }
    if v < 0 { return -v }
    v
}

/** Absolute value (IEEE-754 fabs). */
exp fn abs_f64(v: f64): f64 {
    teko::f64_from_bits(teko::f64_bits(v) & ~SIGN_MASK)
}

/** Algebraic sign of `v`: -1, 0, or 1. */
exp fn sign_i64(v: i64): i64 {
    if v > 0 { return 1 }
    if v < 0 { return -1 }
    0
}

/** Algebraic sign of `v`: -1.0, 0.0, or 1.0; NaN returned as-is. */
exp fn sign_f64(v: f64): f64 {
    if is_nan(v) { return v }
    if v > 0.0 { return 1.0 }
    if v < 0.0 { return -1.0 }
    0.0
}

/** Magnitude of `magnitude` with the sign of `signed_value` (IEEE-754 copysign). */
exp fn copysign_f64(magnitude: f64, signed_value: f64): f64 {
    var mag_bits = teko::f64_bits(magnitude) & ~SIGN_MASK
    var sign_bit = teko::f64_bits(signed_value) & SIGN_MASK
    teko::f64_from_bits(mag_bits | sign_bit)
}

exp fn min_i64(a: i64, b: i64): i64 { if a < b { return a }; b }
exp fn max_i64(a: i64, b: i64): i64 { if a > b { return a }; b }

/** Smaller of `a`/`b`; if either is NaN, the other wins. */
exp fn min_f64(a: f64, b: f64): f64 {
    if is_nan(a) { return b }
    if is_nan(b) { return a }
    if a < b { return a }
    b
}
/** Larger of `a`/`b`; if either is NaN, the other wins. */
exp fn max_f64(a: f64, b: f64): f64 {
    if is_nan(a) { return b }
    if is_nan(b) { return a }
    if a > b { return a }
    b
}

/** Restricts `v` to `[lo, hi]`; errors if `lo > hi`. */
exp fn clamp_i64(v: i64, lo: i64, hi: i64): i64 | error {
    if lo > hi { return error { message = "math::clamp_i64: lo > hi" } }
    if v < lo { return lo }
    if v > hi { return hi }
    v
}

/** Restricts `v` to `[lo, hi]`; errors if `lo > hi`; NaN passes through. */
exp fn clamp_f64(v: f64, lo: f64, hi: f64): f64 | error {
    if lo > hi { return error { message = "math::clamp_f64: lo > hi" } }
    if is_nan(v) { return v }
    if v < lo { return lo }
    if v > hi { return hi }
    v
}

/** Greatest common divisor of two non-negative integers (Euclid's algorithm). */
exp fn gcd(a: i64, b: i64): i64 | error {
    if a < 0 || b < 0 { return error { message = "math::gcd: operands must be non-negative" } }
    var x = a
    var y = b
    loop {
        if y == 0 { break }
        var r = x % y
        x = y
        y = r
    }
    x
}

/** Least common multiple of two non-negative integers. */
exp fn lcm(a: i64, b: i64): i64 | error {
    if a < 0 || b < 0 { return error { message = "math::lcm: operands must be non-negative" } }
    if a == 0 || b == 0 { return error { message = "math::lcm: undefined for a zero operand" } }
    var g: i64 = 0
    match gcd(a, b) {
        i64 as v => { g = v }
        error as e => return e
    }
    var scaled = a / g
    if scaled != 0 && b > I64_MAX / scaled { return error { message = "math::lcm: result overflows i64" } }
    scaled * b
}

/** Integer square root: `floor(sqrt(n))` for `n >= 0`. */
exp fn isqrt(n: i64): i64 | error {
    if n < 0 { return error { message = "math::isqrt: n must be non-negative" } }
    if n == 0 { return 0 }
    if n < 4 { return 1 }
    var x = n
    var y = n / 2 + 1
    loop {
        if y >= x { break }
        x = y
        y = (x + n / x) / 2
    }
    x
}

/** Checked integer exponentiation: `pow_base^exponent` for `exponent >= 0`. */
exp fn ipow(pow_base: i64, exponent: i64): i64 | error {
    if exponent < 0 { return error { message = "math::ipow: negative exponent has no integer result" } }
    var result: i64 = 1
    var b = pow_base
    var e = exponent
    loop {
        if e == 0 { break }
        if e % 2 == 1 {
            match checked_mul_i64(result, b) {
                i64 as v => { result = v }
                error as err => return err
            }
        }
        e = e / 2
        if e != 0 {
            match checked_mul_i64(b, b) {
                i64 as v => { b = v }
                error as err => return err
            }
        }
    }
    result
}
