pub fn saturating_sub_i16(a: i16, b: i16): i16 {
    match checked_sub_i16(a, b) {
        i16 as v => v
        error => { if b < 0 { return I16_MAX }; i16_min() }
    }
}

pub fn saturating_mul_i16(a: i16, b: i16): i16 {
    match checked_mul_i16(a, b) {
        i16 as v => v
        error => { if (a > 0) == (b > 0) { return I16_MAX }; i16_min() }
    }
}

pub const I32_MAX: i32 = 2147483647

pub fn i32_min(): i32 {
    var m: i32 = -2147483647
    m - 1
}

fn u32_bits_of_i32(a: i32): u32 {
    if a >= 0 { return a to u32 }
    (a - i32_min()) to u32 + ((1 to u32) << 31)
}

fn i32_from_u32_bits(u: u32): i32 {
    if u < ((1 to u32) << 31) { return u to i32 }
    (u - ((1 to u32) << 31)) to i32 + i32_min()
}

pub fn checked_add_i32(a: i32, b: i32): i32 | error {
    if b > 0 && a > I32_MAX - b { return checked_error("math::checked_add_i32: overflow") }
    if b < 0 && a < i32_min() - b { return checked_error("math::checked_add_i32: overflow") }
    a + b
}

pub fn checked_sub_i32(a: i32, b: i32): i32 | error {
    if b < 0 && a > I32_MAX + b { return checked_error("math::checked_sub_i32: overflow") }
    if b > 0 && a < i32_min() + b { return checked_error("math::checked_sub_i32: overflow") }
    a - b
}

pub fn checked_mul_i32(a: i32, b: i32): i32 | error {
    if a == 0 || b == 0 { return (0 to i32) }
    if a == -1 {
        if b == i32_min() { return checked_error("math::checked_mul_i32: overflow") }
        return -b
    }
    if b == -1 {
        if a == i32_min() { return checked_error("math::checked_mul_i32: overflow") }
        return -a
    }
    if a > 0 {
        if b > 0 && a > I32_MAX / b { return checked_error("math::checked_mul_i32: overflow") }
        if b < 0 && b < i32_min() / a { return checked_error("math::checked_mul_i32: overflow") }
    } else {
        if b > 0 && a < i32_min() / b { return checked_error("math::checked_mul_i32: overflow") }
        if b < 0 && a < I32_MAX / b { return checked_error("math::checked_mul_i32: overflow") }
    }
    a * b
}

pub fn checked_div_i32(a: i32, b: i32): i32 | error {
    if b == 0 { return checked_error("math::checked_div_i32: divide by zero") }
    if a == i32_min() && b == -1 { return checked_error("math::checked_div_i32: overflow") }
    a / b
}

pub fn checked_rem_i32(a: i32, b: i32): i32 | error {
    if b == 0 { return checked_error("math::checked_rem_i32: divide by zero") }
    if a == i32_min() && b == -1 { return (0 to i32) }
    a % b
}

pub fn checked_neg_i32(a: i32): i32 | error {
    if a == i32_min() { return checked_error("math::checked_neg_i32: overflow") }
    -a
}

pub fn checked_pow_i32(pow_base: i32, power: u32): i32 | error {
    var result: i32 = (1 to i32)
    var b = pow_base
    var e = power
    loop {
        if e == 0 { break }
        if e % 2 == 1 {
            match checked_mul_i32(result, b) {
                i32 as v => { result = v }
                error as err => return err
            }
        }
        e = e / 2
        if e != 0 {
            match checked_mul_i32(b, b) {
                i32 as v => { b = v }
                error as err => return err
            }
        }
    }
    result
}

pub fn checked_shl_i32(a: i32, count: u32): i32 | error {
    if count >= 32 { return checked_error("math::checked_shl_i32: shift out of range") }
    a << (count to i32)
}

pub fn checked_shr_i32(a: i32, count: u32): i32 | error {
    if count >= 32 { return checked_error("math::checked_shr_i32: shift out of range") }
    a >> (count to i32)
}

pub fn wrapping_add_i32(a: i32, b: i32): i32 {
    i32_from_u32_bits(u32_bits_of_i32(a) + u32_bits_of_i32(b))
}

pub fn wrapping_sub_i32(a: i32, b: i32): i32 {
    i32_from_u32_bits(u32_bits_of_i32(a) - u32_bits_of_i32(b))
}

pub fn wrapping_mul_i32(a: i32, b: i32): i32 {
    i32_from_u32_bits(u32_bits_of_i32(a) * u32_bits_of_i32(b))
}

pub fn wrapping_neg_i32(a: i32): i32 {
    i32_from_u32_bits((0 to u32) - u32_bits_of_i32(a))
}

pub fn wrapping_shl_i32(a: i32, count: u32): i32 { a << ((count % 32) to i32) }

pub fn wrapping_shr_i32(a: i32, count: u32): i32 { a >> ((count % 32) to i32) }

pub fn saturating_add_i32(a: i32, b: i32): i32 {
    match checked_add_i32(a, b) {
        i32 as v => v
        error => { if b > 0 { return I32_MAX }; i32_min() }
    }
}

pub fn saturating_sub_i32(a: i32, b: i32): i32 {
    match checked_sub_i32(a, b) {
        i32 as v => v
        error => { if b < 0 { return I32_MAX }; i32_min() }
    }
}

pub fn saturating_mul_i32(a: i32, b: i32): i32 {
    match checked_mul_i32(a, b) {
        i32 as v => v
        error => { if (a > 0) == (b > 0) { return I32_MAX }; i32_min() }
    }
}

pub const I64_MAX: i64 = 9223372036854775807

pub fn i64_min(): i64 {
    var m: i64 = -9223372036854775807
    m - 1
}

fn u64_bits_of_i64(a: i64): u64 {
    if a >= 0 { return a to u64 }
    (a - i64_min()) to u64 + ((1 to u64) << 63)
}

fn i64_from_u64_bits(u: u64): i64 {
    if u < ((1 to u64) << 63) { return u to i64 }
    (u - ((1 to u64) << 63)) to i64 + i64_min()
}

pub fn checked_add_i64(a: i64, b: i64): i64 | error {
    if b > 0 && a > I64_MAX - b { return checked_error("math::checked_add_i64: overflow") }
    if b < 0 && a < i64_min() - b { return checked_error("math::checked_add_i64: overflow") }
    a + b
}

pub fn checked_sub_i64(a: i64, b: i64): i64 | error {
    if b < 0 && a > I64_MAX + b { return checked_error("math::checked_sub_i64: overflow") }
    if b > 0 && a < i64_min() + b { return checked_error("math::checked_sub_i64: overflow") }
    a - b
}

pub fn checked_mul_i64(a: i64, b: i64): i64 | error {
    if a == 0 || b == 0 { return (0) }
    if a == -1 {
        if b == i64_min() { return checked_error("math::checked_mul_i64: overflow") }
        return -b
    }
    if b == -1 {
        if a == i64_min() { return checked_error("math::checked_mul_i64: overflow") }
        return -a
    }
    if a > 0 {
        if b > 0 && a > I64_MAX / b { return checked_error("math::checked_mul_i64: overflow") }
        if b < 0 && b < i64_min() / a { return checked_error("math::checked_mul_i64: overflow") }
    } else {
        if b > 0 && a < i64_min() / b { return checked_error("math::checked_mul_i64: overflow") }
        if b < 0 && a < I64_MAX / b { return checked_error("math::checked_mul_i64: overflow") }
    }
    a * b
}

pub fn checked_div_i64(a: i64, b: i64): i64 | error {
    if b == 0 { return checked_error("math::checked_div_i64: divide by zero") }
    if a == i64_min() && b == -1 { return checked_error("math::checked_div_i64: overflow") }
    a / b
}

pub fn checked_rem_i64(a: i64, b: i64): i64 | error {
    if b == 0 { return checked_error("math::checked_rem_i64: divide by zero") }
    if a == i64_min() && b == -1 { return (0) }
    a % b
}

pub fn checked_neg_i64(a: i64): i64 | error {
    if a == i64_min() { return checked_error("math::checked_neg_i64: overflow") }
    -a
}

pub fn checked_pow_i64(pow_base: i64, power: u32): i64 | error {
    var result: i64 = (1)
    var b = pow_base
    var e = power
    loop {
        if e == 0 { break }
        if e % 2 == 1 {
            match checked_mul_i64(result, b) {
                i64 as v => { result = v }
                error as err => return err
            }
        }
        e = e / 2
        if e != 0 {
            match checked_mul_i64(b, b) {
                i64 as v => { b = v }
                error as err => return err
            }
        }
    }
    result
}

pub fn checked_shl_i64(a: i64, count: u32): i64 | error {
    if count >= 64 { return checked_error("math::checked_shl_i64: shift out of range") }
    a << (count to i64)
}

pub fn checked_shr_i64(a: i64, count: u32): i64 | error {
    if count >= 64 { return checked_error("math::checked_shr_i64: shift out of range") }
    a >> (count to i64)
}

pub fn wrapping_add_i64(a: i64, b: i64): i64 {
    i64_from_u64_bits(u64_bits_of_i64(a) + u64_bits_of_i64(b))
}

pub fn wrapping_sub_i64(a: i64, b: i64): i64 {
    i64_from_u64_bits(u64_bits_of_i64(a) - u64_bits_of_i64(b))
}

pub fn wrapping_mul_i64(a: i64, b: i64): i64 {
    i64_from_u64_bits(u64_bits_of_i64(a) * u64_bits_of_i64(b))
}

pub fn wrapping_neg_i64(a: i64): i64 {
    i64_from_u64_bits((0 to u64) - u64_bits_of_i64(a))
}

pub fn wrapping_shl_i64(a: i64, count: u32): i64 { a << ((count % 64) to i64) }

pub fn wrapping_shr_i64(a: i64, count: u32): i64 { a >> ((count % 64) to i64) }

pub fn saturating_add_i64(a: i64, b: i64): i64 {
    match checked_add_i64(a, b) {
        i64 as v => v
        error => { if b > 0 { return I64_MAX }; i64_min() }
    }
}

pub fn saturating_sub_i64(a: i64, b: i64): i64 {
    match checked_sub_i64(a, b) {
        i64 as v => v
        error => { if b < 0 { return I64_MAX }; i64_min() }
    }
}

pub fn saturating_mul_i64(a: i64, b: i64): i64 {
    match checked_mul_i64(a, b) {
        i64 as v => v
        error => { if (a > 0) == (b > 0) { return I64_MAX }; i64_min() }
    }
