use teko::checker
use teko::lexer
use teko::parser

fn const_rodata_symbol(name: str): str {
    teko::str::concat(".Lconst_", name)
}

fn const_leaf_symbol(const_name: str, field_name: str): str {
    teko::str::concat(const_rodata_symbol(const_name), teko::str::concat(".", field_name))
}

fn ltype_is_ptr(t: LType): bool {
    match t { Ptr => true; _ => false }
}

fn ltype_is_float(t: LType): bool {
    match t { F32 => true; F64 => true; _ => false }
}

fn lo_byte(v: i64, shift: u32): byte {
    if shift >= 64 { return if v < 0 { 0xFF to byte } else { 0 to byte } }
    ((v >> shift) & 0xFF) to byte
}

fn serialize_le(v: i64, nbytes: u32): []byte {
    var out: []byte = []
    var k: u32 = 0
    loop {
        if k >= nbytes { break }
        out = [..out, lo_byte(v, k * 8)]
        k++
    }
    out
}

fn const_fold_unary(op: lexer::TokenKind, v: i64): i64 | error {
    match op {
        lexer::TokenKind::Tilde => ((0) - v) - (1)
        lexer::TokenKind::Minus => (0) - v
        _ => error { message = "const aggregate: non-const unary operator in initializer" }
    }
}

fn const_fold_binary(op: lexer::TokenKind, a: i64, b: i64): i64 | error {
    match op {
        lexer::TokenKind::Plus => a + b
        lexer::TokenKind::Minus => a - b
        _ => error { message = "const aggregate: const-fold of this operator is not yet supported (only `+`/`-` today)" }
    }
}

fn const_fold_int(e: checker::TExpr): i64 | error {
    match e.kind {
        checker::TNumber as n => if n.is_float { error { message = "const aggregate: float value materialization is not yet supported" } } else { parser::numint_to_i64(n.value) }
        checker::TByteLit as b => b.value to i64
        checker::TBoolLit as bo => if bo.value { 1 } else { 0 }
        checker::TPathExpr as p => p.value to i64
        checker::TCharLit => error { message = "const aggregate: char value requires fat representation, not yet supported" }
        checker::TCast as c => const_fold_int(c.expr)
        checker::TUnary as u => const_fold_unary_expr(u)
        checker::TBinary as b => const_fold_binary_expr(b)
        _ => error { message = teko::str::concat("const aggregate: unsupported initializer form `", texpr_kind_name(e), "`") }
    }
}

fn const_fold_unary_expr(u: checker::TUnary): i64 | error {
    var v = match const_fold_int(u.operand) { i64 as x => x; error as e => return e }
    const_fold_unary(u.op, v)
}

fn const_fold_binary_expr(b: checker::TBinary): i64 | error {
    var a = match const_fold_int(b.left) { i64 as x => x; error as e => return e }
    var c = match const_fold_int(b.right) { i64 as x => x; error as e => return e }
    const_fold_binary(b.op, a, c)
}

fn const_is_flat_scalar(t: @Type()): bool {
    match t {
        checker::Prim => true
        checker::Byte => true
        _ => false
    }
}

fn zeros_bytes(n: u64): []byte {
    var out: []byte = []
    var i: u64 = 0
    loop {
        if i >= n { break }
        out = [..out, 0 to byte]
        i++
    }
    out
}

fn append_bytes(a: []byte, b: []byte): []byte {
    var out = a
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        out = [..out, b[i]]
        i++
    }
    out
}

fn write_bytes_at(buf: []byte, off: u64, src: []byte): []byte {
    var out: []byte = []
    var i: u64 = 0
    loop {
        if i >= buf.len { break }
        var within = i >= off && i < off + src.len
        out = [..out, if within { src[i - off] } else { buf[i] }]
        i++
    }
    out
}

fn const_str_bytes(init: checker::TExpr): []byte | error {
    match init.kind {
        checker::TStrLit as s => str_to_bytes(s.text)
        _ => error { message = "const str: initializer is not a string literal" }
    }
}

fn const_array_bytes(element: @Type(), a: checker::TArrayLit, enums: []LEnumInfo): []byte | error {
    var stride = elem_byte_stride(element, enums)
    var out: []byte = []
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        match const_reject_spread(a, i) { error as e => return e; null => { } }
        var v = match const_fold_int(a.elements[i].expr) { i64 as x => x; error as e => return e }
        out = append_bytes(out, serialize_le(v, stride))
        i++
    }
    out
}

fn const_reject_spread(a: checker::TArrayLit, i: u64): null | error {
    if a.elements[i].is_spread { return error { message = "const slice: spread element not statically materializable" } }
    null
}

fn const_elem_key(index: u64): str {
    teko::u64_to_str(index)
}

fn const_nested_owner(owner: str, member_key: str): str {
    teko::str::concat(owner, teko::str::concat(".", member_key))
}

fn const_array_literal(init: checker::TExpr): checker::TArrayLit | error {
    match init.kind {
        checker::TArrayLit as a => a
        _ => error { message = "const slice: initializer is not an array literal" }
    }
}

fn const_fat_array_image(const_name: str, element: @Type(), a: checker::TArrayLit, enums: []LEnumInfo): ConstImage | error {
    var img = const_image_flat([])
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        match const_reject_spread(a, i) { error as e => return e; null => { } }
        var slot_off = ptr_align_up(img.bytes.len to u32)
        var member = match const_fat_member(const_name, const_elem_key(i), slot_off, element, a.elements[i].expr, enums) { FatMemberImage as x => x; error as e => return e }
        img = const_image_absorb(img, member)
        i++
    }
    img
}

fn fat_slot_align(): u32 {
    ltype_size(LType::Ptr)
}

fn ptr_align_up(v: u32): u32 {
    align_up(v, fat_slot_align())
}

fn pad_bytes_to_ptr_align(bytes: []byte): []byte {
    zero_pad_to(bytes, ptr_align_up(bytes.len to u32))
}

fn const_image_absorb(img: ConstImage, member: FatMemberImage): ConstImage {
    ConstImage {
        bytes = append_bytes(pad_bytes_to_ptr_align(img.bytes), member.slot_bytes)
        relocs = [..img.relocs, member.reloc]
        leaves = append_rodata(img.leaves, member.leaves)
    }
}

fn append_rodata(a: []LRodata, b: []LRodata): []LRodata {
    var out = a
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        out = [..out, b[i]]
        i++
    }
    out
}

fn const_slice_image(const_name: str, element: @Type(), init: checker::TExpr, enums: []LEnumInfo): ConstImage | error {
    match init.kind {
        checker::TByteStrLit as bs => return const_image_flat(str_to_bytes(bs.text))
        _ => { }
    }
    var a = match const_array_literal(init) { checker::TArrayLit as x => x; error as e => return e }
    if const_is_flat_scalar(element) {
        return match const_array_bytes(element, a, enums) { []byte as b => const_image_flat(b); error as e => return e }
    }
    if is_fat_type(element) { return const_fat_array_image(const_name, element, a, enums) }
    error { message = "const aggregate: pointer/slice-bearing slice element is not yet supported" }
}

fn struct_init_value(si: checker::TStructInit, field: str): checker::TExpr | error {
    var i: u64 = 0
    loop {
        if i >= si.field_names.len { break }
        if si.field_names[i] == field { return si.field_vals[i] }
        i++
    }
    error { message = teko::str::concat("const struct: initializer binds no field `", field, "` (internal)") }
}

fn const_struct_field_bytes(layout: LStructLayout, si: checker::TStructInit, j: u64): []byte | error {
    var lt = layout.field_types[j]
    if ltype_is_ptr(lt) { return error { message = teko::str::concat("const aggregate: field `", layout.field_names[j], "` is pointer/slice-bearing, not yet supported") } }
    if ltype_is_float(lt) { return error { message = teko::str::concat("const aggregate: float field `", layout.field_names[j], "` materialization is not yet supported") } }
    var vexpr = match struct_init_value(si, layout.field_names[j]) { checker::TExpr as x => x; error as e => return e }
    var v = match const_fold_int(vexpr) { i64 as x => x; error as e => return e }
    serialize_le(v, ltype_size(lt))
}

fn const_fat_target_image(owner: str, member_ty: @Type(), vexpr: checker::TExpr, enums: []LEnumInfo): ConstImage | error {
    if is_str_type(member_ty) { return match const_str_bytes(vexpr) { []byte as b => const_image_flat(b); error as e => return e } }
    match member_ty {
        checker::Slice as s => const_slice_image(owner, s.element, vexpr, enums)
        _ => error { message = "const aggregate: fat member is neither str nor slice (internal)" }
    }
}

fn const_fat_member(owner: str, member_key: str, slot_off: u32, member_ty: @Type(), vexpr: checker::TExpr, enums: []LEnumInfo): FatMemberImage | error {
    var target = match const_fat_target_image(const_nested_owner(owner, member_key), member_ty, vexpr, enums) { ConstImage as x => x; error as e => return e }
    var count = match const_fat_len(member_ty, target.bytes.len to u32, enums) { u32 as c => c; error as e => return e }
    var leaf_sym = const_leaf_symbol(owner, member_key)
    var ptr_size = ltype_size(LType::Ptr)
    var slot = append_bytes(zeros_bytes(ptr_size to u64), serialize_le(count to i64, ptr_size))
    FatMemberImage {
        slot_bytes = slot
        reloc = data_reloc(slot_off, leaf_sym)
        leaves = [..target.leaves, LRodata { symbol = leaf_sym; bytes = target.bytes; relocs = target.relocs }]
    }
}

fn const_struct_blob(const_name: str, layout: LStructLayout, si: checker::TStructInit, enums: []LEnumInfo): ConstImage | error {
    var img = ConstImage { bytes = zeros_bytes(layout.size to u64); relocs = []; leaves = [] }
    var j: u64 = 0
    loop {
        if j >= layout.field_names.len { break }
        img = match const_struct_field_into(img, const_name, layout, si, j, enums) { ConstImage as x => x; error as e => return e }
        j++
    }
    img
}

fn const_hdr_field_into(img: ConstImage, fieldoff: u32): ConstImage {
    ConstImage {
        bytes = write_bytes_at(img.bytes, fieldoff to u64, zeros_bytes(ltype_size(LType::Ptr) to u64))
        relocs = img.relocs
        leaves = img.leaves
    }
}

fn const_struct_field_into(img: ConstImage, const_name: str, layout: LStructLayout, si: checker::TStructInit, j: u64, enums: []LEnumInfo): ConstImage | error {
    var field_name = layout.field_names[j]
    var fieldoff = layout.field_offsets[j]
    if field_name == struct_hdr_field_name() { return const_hdr_field_into(img, fieldoff) }
    var vexpr = match struct_init_value(si, field_name) { checker::TExpr as x => x; error as e => return e }
    if !is_fat_type(vexpr.type) {
        var fb = match const_struct_field_bytes(layout, si, j) { []byte as x => x; error as e => return e }
        return ConstImage { bytes = write_bytes_at(img.bytes, fieldoff to u64, fb); relocs = img.relocs; leaves = img.leaves }
    }
    var member = match const_fat_member(const_name, field_name, fieldoff, vexpr.type, vexpr, enums) { FatMemberImage as x => x; error as e => return e }
    ConstImage {
        bytes = write_bytes_at(img.bytes, fieldoff to u64, member.slot_bytes)
        relocs = [..img.relocs, member.reloc]
        leaves = append_rodata(img.leaves, member.leaves)
    }
}

fn const_struct_bytes(const_name: str, name: str, init: checker::TExpr, layouts: []LStructLayout, enums: []LEnumInfo): ConstImage | error {
    var layout = match find_struct_layout(layouts, name) { LStructLayout as l => l; error as e => return e }
    match init.kind {
        checker::TStructInit as si => const_struct_blob(const_name, layout, si, enums)
        _ => error { message = $"const struct: the initializer of '{const_name}' (type '{name}') at {init.line}:{init.col} is not a struct literal — the checker's const-constructor canonicalization (`canonicalize_const_ctors`) did not reduce it" }
    }
}

fn const_variant_tag_bytes(si: checker::TStructInit, index: u32): []byte | error {
    if si.field_names.len > 0 { return error { message = "const variant: non-empty payload case materialization is not yet supported" } }
    zero_pad_to(serialize_le(index to i64, ltype_size(LType::I32)), variant_wrapper_bytes())
}

fn zero_pad_to(bytes: []byte, width: u32): []byte {
    var out = bytes
    loop {
        if out.len >= width { break }
        out = [..out, 0 to byte]
    }
    out
}

fn find_variant_def(variants: []LVariantDef, name: str): LVariantDef | null {
    var bare = checker::name_last_segment(name)
    var i: u64 = 0
    loop {
        if i >= variants.len { break }
        if checker::name_last_segment(variants[i].name) == bare { return variants[i] }
        i++
    }
    null
}

/**
 * Serializes a const whose value constructs one empty-payload case of a nominal union.
 *
 * @param info  the union's variant definition, resolved through the variant-def registry by name
 * @param init  the const's initializer, a member construction of one of the union's cases
 * @return      the little-endian tag bytes for the constructed case, wrapper-padded
 * @throws      when the initializer is not a member construction, or the case carries a payload
 */
fn const_variant_bytes(info: LVariantDef, init: checker::TExpr): []byte | error {
    const_variant_from_members(info.ty.members, init)
}

/**
 * Serializes a const whose value constructs one empty-payload case of a union, given the union's
 * member types directly. Shared by the nominal path (`const_variant_bytes`, whose members come from
 * the variant-def registry) and the inlined `@Type()`-union path (`serialize_const`'s `Variant`
 * arm, whose members come straight off the resolved `checker::Variant`), so both compute the same
 * tag index over the same member ordering.
 *
 * @param members  the union's member types, in declaration order — the tag axis
 * @param init     the const's initializer, a member construction of one of `members`
 * @return         the little-endian tag bytes for the constructed case, wrapper-padded
 * @throws         when the initializer is not a member construction, or the case carries a payload
 */
fn const_variant_from_members(members: []@Type(), init: checker::TExpr): []byte | error {
    var case_name = match named_type_name(init.type) { str as s => s; error as e => return e }
    var vm = match find_variant_member(members, checker::name_last_segment(case_name)) { VariantMember as x => x; error as e => return e }
    match init.kind {
        checker::TStructInit as si => const_variant_tag_bytes(si, vm.index)
        _ => error { message = "const variant: initializer is not a member construction" }
    }
}

fn const_image_flat(bytes: []byte): ConstImage {
    ConstImage { bytes = bytes; relocs = []; leaves = [] }
}

fn const_named_bytes(const_name: str, name: str, init: checker::TExpr, layouts: []LStructLayout, variants: []LVariantDef, enums: []LEnumInfo): ConstImage | error {
    match find_variant_def(variants, name) {
        LVariantDef as info => match const_variant_bytes(info, init) { []byte as b => const_image_flat(b); error as e => return e }
        null => const_struct_bytes(const_name, name, init, layouts, enums)
    }
}

/**
 * Materializes a const declaration into its rodata image, dispatching on the const's resolved type.
 * A `Named` union routes its cases through the variant-def registry; an inlined `@Type()` union (a
 * §9.D macro union such as `@MInst()`) resolves to a structural `checker::Variant`, so its arm
 * serializes the constructed case straight from the type's member list. Both spellings of the same
 * union produce the identical tag over the identical member ordering.
 *
 * @param cd        the const declaration, with its resolved type and typed initializer
 * @param layouts   struct layouts, for aggregate const bodies
 * @param variants  variant definitions, for nominal-union cases
 * @param enums     enum infos, for enum-valued fields
 * @return          the const's rodata image (bytes, relocations, and leaf blobs)
 * @throws          when the const's value is a shape the native backend cannot yet materialize
 */
fn serialize_const(cd: checker::TConstDecl, layouts: []LStructLayout, variants: []LVariantDef, enums: []LEnumInfo): ConstImage | error {
    if is_str_type(cd.ty) { return match const_str_bytes(cd.init) { []byte as b => const_image_flat(b); error as e => return e } }
    match cd.ty {
        checker::Slice as s => const_slice_image(cd.name, s.element, cd.init, enums)
        checker::Named as n => const_named_bytes(cd.name, n.name, cd.init, layouts, variants, enums)
        checker::Variant as v => match const_variant_from_members(v.members, cd.init) { []byte as b => const_image_flat(b); error as e => return e }
        _ => error { message = "const aggregate: pointer/slice-bearing value is not yet supported" }
    }
}

fn const_size_check_enabled(): bool {
    match teko::env::var("TEKO_NATIVE_CONST_SIZE_CHECK") { str as v => v == "1"; error => false }
}

fn field_allotted_span(layout: LStructLayout, j: u64): u32 {
    if j + 1 < layout.field_names.len { return layout.field_offsets[j + 1] - layout.field_offsets[j] }
    layout.size - layout.field_offsets[j]
}

fn check_struct_fat_spans(const_name: str, layout: LStructLayout, si: checker::TStructInit): null | error {
    var j: u64 = 0
    loop {
        if j >= layout.field_names.len { break }
        match check_struct_fat_span_at(const_name, layout, si, j) { error as e => return e; null => { } }
        j++
    }
    null
}

fn check_struct_fat_span_at(const_name: str, layout: LStructLayout, si: checker::TStructInit, j: u64): null | error {
    var field_name = layout.field_names[j]
    var vexpr = match struct_init_value(si, field_name) { checker::TExpr as x => x; error => return null }
    if !fat_slot_underflows(layout, j, vexpr.type) { return null }
    error { message = $"TEKO_NATIVE_CONST_SIZE_CHECK: const '{const_name}' fat field '{field_name}' (type '{layout.name}') was allotted {field_allotted_span(layout, j)} bytes but a fat slot needs {fat_value_bytes(vexpr.type)} — its layout under-sized it (a typeexpr_is_fat / is_fat_type mismatch); the following fields shift and a pointer lands misaligned" }
}

fn fat_slot_underflows(layout: LStructLayout, j: u64, value_type: @Type()): bool {
    if !is_fat_type(value_type) { return false }
    field_allotted_span(layout, j) < fat_value_bytes(value_type)
}

fn field_index_of(layout: LStructLayout, field: str): u64 | null {
    var i: u64 = 0
    loop {
        if i >= layout.field_names.len { break }
        if layout.field_names[i] == field { return i }
        i++
    }
    null
}

fn check_store_fat_span(ctx: LowerCtx, layout: LStructLayout, field_name: str, decl: @Type() | null, value: checker::TExpr): null | error {
    match union_field_placement(ctx, decl) { (@Type()) as _gt1 => return null; null => { } }
    var j = match field_index_of(layout, field_name) { u64 as k => k; null => return null }
    if !fat_slot_underflows(layout, j, value.type) { return null }
    error { message = $"native fat-field store guard: struct '{layout.name}' fat field '{field_name}' was allotted {field_allotted_span(layout, j)} bytes but a fat slot needs {fat_value_bytes(value.type)} — its layout under-sized it (a typeexpr_is_fat / is_fat_type mismatch); the fat pointer/length store overruns the following field" }
}

fn check_struct_const_image(const_name: str, layout: LStructLayout, init: checker::TExpr, img: ConstImage): null | error {
    if (img.bytes.len to u32) != layout.size {
        return error { message = $"TEKO_NATIVE_CONST_SIZE_CHECK: const '{const_name}' (type '{layout.name}') serialized {img.bytes.len} bytes but its layout size is {layout.size} — the native ConstImage disagrees with the registered layout" }
    }
    match init.kind {
        checker::TStructInit as si => check_struct_fat_spans(const_name, layout, si)
        _ => null
    }
}

fn check_const_image_size(cd: checker::TConstDecl, img: ConstImage, layouts: []LStructLayout): null | error {
    if !const_size_check_enabled() { return null }
    match cd.ty {
        checker::Named as n => match find_struct_layout(layouts, n.name) {
            LStructLayout as layout => check_struct_const_image(cd.name, layout, cd.init, img)
            error => null
        }
        _ => null
    }
}

fn intern_aggregate_const_decl(m: LModule, cd: checker::TConstDecl, layouts: []LStructLayout, variants: []LVariantDef, enums: []LEnumInfo): LModule | error {
    if const_decl_is_scalar(cd.ty) { return m }
    var img = match serialize_const(cd, layouts, variants, enums) { ConstImage as x => x; error as e => return e }
    match check_const_image_size(cd, img, layouts) { error as e => return e; null => { } }
    var cur = m
    var i: u64 = 0
    loop {
        if i >= img.leaves.len { break }
        cur = add_rodata(cur, img.leaves[i])
        i++
    }
    add_rodata(cur, LRodata { symbol = const_rodata_symbol(cd.name); bytes = img.bytes; relocs = img.relocs })
}

fn intern_aggregate_const_item(m: LModule, it: @TItem(), layouts: []LStructLayout, variants: []LVariantDef, enums: []LEnumInfo): LModule | error {
    match it {
        checker::TConstDecl as cd => intern_aggregate_const_decl(m, cd, layouts, variants, enums)
        _ => m
    }
}

fn intern_aggregate_consts(m: LModule, items: []@TItem(), layouts: []LStructLayout, variants: []LVariantDef, enums: []LEnumInfo): LModule | error {
    var cur = m
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        cur = match intern_aggregate_const_item(cur, items[i], layouts, variants, enums) { LModule as x => x; error as e => return e }
        i++
    }
    cur
}

fn collect_variant_defs(prog: checker::TProgram): []LVariantDef {
    var table = declared_type_table(prog)
    var out: []LVariantDef = []
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        out = collect_variant_def_item(out, prog.items[i], table)
        i++
    }
    out
}

fn declared_type_table(prog: checker::TProgram): checker::TypeTable {
    var out = checker::tt_empty()
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        out = push_declared_type_reg(out, prog.items[i])
        i++
    }
    checker::tt_freeze(out)
}

fn push_declared_type_reg(acc: checker::TypeTable, it: @TItem()): checker::TypeTable {
    match it {
        parser::TypeDecl as td => checker::tt_push(acc, checker::TypeReg {
            name = checker::name_last_segment(td.name); namespace = checker::name_qualifier(td.name)
            file = ""; vis = td.vis; decl = td
        })
        _ => acc
    }
}

fn collect_variant_def_item(acc: []LVariantDef, it: @TItem(), table: checker::TypeTable): []LVariantDef {
    match it {
        parser::TypeDecl as td => collect_variant_def_decl(acc, td, table)
        _ => acc
    }
}

fn collect_variant_def_decl(acc: []LVariantDef, td: parser::TypeDecl, table: checker::TypeTable): []LVariantDef {
    match td.body {
        parser::VariantBody as vb => [..acc, LVariantDef { name = td.name; ty = variant_body_expanded(vb, checker::name_qualifier(td.name), table) }]
        _ => acc
    }
}

fn collect_field_decls(prog: checker::TProgram): []LFieldDecls | error {
    var dtable = declared_type_table(prog)
    var ctable = checker::type_table_of(prog)
    var out: []LFieldDecls = []
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        out = match collect_field_decls_item(out, prog.items[i], dtable, ctable) {
            []LFieldDecls as next => next
            error as e => return e
        }
        i++
    }
    out
}

fn collect_field_decls_item(acc: []LFieldDecls, it: @TItem(), dtable: checker::TypeTable, ctable: checker::TypeTable): []LFieldDecls | error {
    match it {
        parser::TypeDecl as td => collect_field_decls_decl(acc, td, dtable, ctable)
        _ => acc
    }
}

fn collect_field_decls_decl(acc: []LFieldDecls, td: parser::TypeDecl, dtable: checker::TypeTable, ctable: checker::TypeTable): []LFieldDecls | error {
    match td.body {
        parser::StructBody as sb => [..acc, field_decls_of(td.name, sb.fields, dtable)]
        parser::ClassBody as cb => {
            var fields = match class_instance_fields(td.name, cb, ctable) { []parser::Field as fs => fs; error as e => return e }
            [..acc, field_decls_of(td.name, fields, dtable)]
        }
        _ => acc
    }
}

fn field_decls_of(name: str, fields: []parser::Field, dtable: checker::TypeTable): LFieldDecls {
    var ns = checker::name_qualifier(name)
    var names: []str = []
    var types: []@Type() = []
    var i: u64 = 0
    loop {
        if i >= fields.len { break }
        names = [..names, fields[i].name]
        types = [..types, resolved_field_type(fields[i].type_ann, ns, dtable)]
        i++
    }
    LFieldDecls { name = name; field_names = names; field_types = types }
}

fn resolved_field_type(te: @TypeExpr(), ns: str, dtable: checker::TypeTable): @Type() {
    match checker::resolve_type(te, dtable, ns) {
        (@Type()) as t => t
        error => unresolved_named_fallback(te)
    }
}

fn unresolved_named_fallback(te: @TypeExpr()): @Type() {
    match te {
        parser::NamedType as nt => checker::Named { name = type_path_joined(nt.path) }
        _ => checker::Void { }
    }
}

fn type_path_joined(p: parser::Path): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= p.segments.len { break }
        if i > 0 { out = teko::str::concat(out, "::") }
        out = teko::str::concat(out, p.segments[i].name)
        i++
    }
    out
}

fn variant_body_expanded(vb: parser::VariantBody, ns: str, table: checker::TypeTable): checker::Variant {
    var resolved = match checker::resolve_type(vb.type_expr, table, ns) {
        (@Type()) as t => t
        error => return checker::Variant { members = nominal_member_types(vb.type_expr) }
    }
    match resolved {
        checker::Variant as v => v
        _ => checker::Variant { members = nominal_member_types(vb.type_expr) }
    }
}

fn nominal_member_types(te: @TypeExpr()): []@Type() {
    match te {
        parser::UnionType as ut => union_member_types(ut.members)
        _ => []
    }
}

fn union_member_types(members: []@TypeExpr()): []@Type() {
    var out: []@Type() = []
    var i: u64 = 0
    loop {
        if i >= members.len { break }
        out = [..out, checker::Named { name = union_member_name(members[i]) }]
        i++
    }
    out
}

fn union_member_name(te: @TypeExpr()): str {
    match te {
        parser::NamedType as nt => type_path_last_name(nt.path)
        _ => ""
    }
}

fn type_path_last_name(p: parser::Path): str {
    if p.segments.len == 0 { return "" }
    p.segments[p.segments.len - 1].name
}
