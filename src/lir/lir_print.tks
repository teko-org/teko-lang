fn hex_digit(n: u64): byte {
    if n < 10 { (b'0' to u64 + n) to byte } else { (b'a' to u64 + (n - 10)) to byte }
}

fn u64_hex(v: u64): str {
    if v == 0 { return "0x0" }
    var digits: []byte = []
    var n = v
    loop {
        if n == 0 { break }
        digits = [..digits, hex_digit(n % 16)]
        n = n / 16
    }
    var xs: []byte = []
    xs = [..xs, b'0']
    xs = [..xs, b'x']
    var k = digits.len
    loop { if k == 0 { break }; k = k - 1; xs = [..xs, digits[k]] }
    str(xs)
}

fn i64_dec(v: i64): str {
    if v == 0 { return "0" }
    var neg = v < 0
    var mag: u64 = if neg { u64_of_neg_i64(v) } else { v to u64 }
    var digits: []byte = []
    loop {
        if mag == 0 { break }
        digits = [..digits, (b'0' to u64 + mag % 10) to byte]
        mag = mag / 10
    }
    var xs: []byte = []
    if neg { xs = [..xs, b'-'] }
    var k = digits.len
    loop { if k == 0 { break }; k = k - 1; xs = [..xs, digits[k]] }
    str(xs)
}

fn u64_of_neg_i64(v: i64): u64 {
    ((-(v + 1)) to u64) + 1
}

fn ltype_name(t: LType): str {
    match t {
        I8 => "i8"
        I16 => "i16"
        I32 => "i32"
        I64 => "i64"
        F32 => "f32"
        F64 => "f64"
        Ptr => "ptr"
        Void => "void"
    }
}

fn binop_name(op: LBinOp): str {
    match op {
        IAdd => "iadd"; ISub => "isub"; IMul => "imul"
        IDivS => "idivs"; IDivU => "idivu"; IRemS => "irems"; IRemU => "iremu"
        IAnd => "iand"; IOr => "ior"; IXor => "ixor"
        IShl => "ishl"; IShrS => "ishrs"; IShrU => "ishru"
        ICmpEq => "icmpeq"; ICmpNe => "icmpne"
        ICmpLtS => "icmplts"; ICmpLtU => "icmpltu"; ICmpLeS => "icmples"; ICmpLeU => "icmpleu"
        ICmpGtS => "icmpgts"; ICmpGtU => "icmpgtu"; ICmpGeS => "icmpges"; ICmpGeU => "icmpgeu"
        FAdd => "fadd"; FSub => "fsub"; FMul => "fmul"; FDiv => "fdiv"
        FCmpEq => "fcmpeq"; FCmpNe => "fcmpne"; FCmpLt => "fcmplt"; FCmpLe => "fcmple"
        FCmpGt => "fcmpgt"; FCmpGe => "fcmpge"
    }
}

fn unop_name(op: LUnOp): str {
    match op {
        INeg => "ineg"; INot => "inot"; FNeg => "fneg"
        ZExt => "zext"; SExt => "sext"; Trunc => "trunc"
        IToF => "itof"; FToI => "ftoi"; FToF => "ftof"
        IToFBits => "itofbits"; FToIBits => "ftoibits"
    }
}

fn vreg_ref(v: u32): str {
    teko::str::concat("%", teko::u64_to_str(v to u64))
}

fn print_args(args: []u32): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= args.len { break }
        if i > 0 { out = teko::str::concat(out, ", ") }
        out = teko::str::concat(out, vreg_ref(args[i]))
        i++
    }
    out
}

fn result_prefix(inst: LInst): str {
    if !inst.has_result { return "" }
    teko::str::concat(vreg_ref(inst.result), " = ")
}

fn print_const_int(c: LConstInt): str {
    teko::str::concat("const ", i64_dec(c.val))
}

fn print_const_float(c: LConstFloat): str {
    teko::str::concat("const.f64 ", u64_hex(c.bits))
}

fn print_bin(b: LBin): str {
    teko::str::concat(binop_name(b.op), " ", vreg_ref(b.a), ", ", vreg_ref(b.b))
}

fn print_un(u: LUn): str {
    teko::str::concat(unop_name(u.op), " ", vreg_ref(u.a))
}

fn print_param(p: LParam): str {
    teko::str::concat("param ", teko::u64_to_str(p.index to u64))
}

fn print_call(c: LCall): str {
    teko::str::concat("call @", c.symbol, "(", print_args(c.args), ")")
}

fn print_ret(r: LRet): str {
    if r.has_value { teko::str::concat("ret ", vreg_ref(r.value)) } else { "ret" }
}

fn print_alloca(a: LAlloca): str {
    teko::str::concat("alloca ", teko::u64_to_str(a.bytes to u64), ", align ", teko::u64_to_str(a.align to u64))
}

fn print_field_addr(fa: LFieldAddr): str {
    teko::str::concat("field_addr ", vreg_ref(fa.base_vreg), ", ", teko::u64_to_str(fa.offset to u64))
}

fn print_load(l: LLoad): str {
    teko::str::concat("load.", ltype_name(l.ty), " ", vreg_ref(l.addr))
}

fn print_store(s: LStore): str {
    teko::str::concat("store.", ltype_name(s.ty), " ", vreg_ref(s.addr), ", ", vreg_ref(s.value))
}

fn print_global_addr(g: LGlobalAddr): str {
    teko::str::concat("global_addr @", g.symbol)
}

fn print_call_indirect(c: LCallIndirect): str {
    teko::str::concat("call.indirect ", vreg_ref(c.target), "(", print_args(c.args), ")")
}

fn print_func_addr(fa: LFuncAddr): str {
    teko::str::concat("funcaddr @", fa.symbol)
}

fn print_syscall(s: LSyscall): str {
    teko::str::concat("syscall(", print_args(s.args), ")")
}

fn atomic_kind_name(kind: LAtomicKind): str {
    match kind {
        Cas => "atomic_cas_u32"
        Xchg => "atomic_xchg_u32"
        Add => "atomic_add_u32"
        Load => "atomic_load_u32"
    }
}

fn print_atomic_rmw(a: LAtomicRmw): str {
    teko::str::concat(atomic_kind_name(a.kind), "(", print_args(a.args), ")")
}

fn print_jump(j: LJump): str {
    teko::str::concat("jump #B", teko::u64_to_str(j.target to u64), "(", print_args(j.args), ")")
}

fn print_branch(br: LBranch): str {
    teko::str::concat(
        "branch ", vreg_ref(br.cond),
        ", #B", teko::u64_to_str(br.t_target to u64), "(", print_args(br.t_args), ")",
        ", #B", teko::u64_to_str(br.f_target to u64), "(", print_args(br.f_args), ")"
    )
}

fn print_op(op: @LOp()): str {
    match op {
        LConstInt as c => print_const_int(c)
        LConstFloat as c => print_const_float(c)
        LBin as b => print_bin(b)
        LUn as u => print_un(u)
        LCall as c => print_call(c)
        LParam as p => print_param(p)
        LRet as r => print_ret(r)
        LJump as j => print_jump(j)
        LBranch as br => print_branch(br)
        LAlloca as a => print_alloca(a)
        LFieldAddr as fa => print_field_addr(fa)
        LLoad as l => print_load(l)
        LStore as s => print_store(s)
        LGlobalAddr as g => print_global_addr(g)
        LCallIndirect as ci => print_call_indirect(ci)
        LFuncAddr as fa => print_func_addr(fa)
        LSyscall as s => print_syscall(s)
        LAtomicRmw as a => print_atomic_rmw(a)
    }
}

fn print_inst(inst: LInst): str {
    teko::str::concat("    ", result_prefix(inst), print_op(inst.op))
}

fn print_block(b: LBlock): str {
    var out = teko::str::concat("  #B", teko::u64_to_str(b.id to u64))
    if b.params.len != 0 { out = teko::str::concat(out, "(", print_args(b.params), ")") }
    out = teko::str::concat(out, ":\n")
    var it = b.insts.iter()
    loop {
        match it.next() {
            LInst as inst => { out = teko::str::concat(out, print_inst(inst), "\n") }
            null => break
        }
    }
    out
}

fn print_sig_params(f: LFunc): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= f.param_types.len { break }
        if i > 0 { out = teko::str::concat(out, ", ") }
        out = teko::str::concat(out, vreg_ref(i to u32), ": ", ltype_name(f.param_types[i]))
        i++
    }
    out
}

fn print_func(f: LFunc): str {
    var out = teko::str::concat("func @", f.symbol, "(", print_sig_params(f), "): ", ltype_name(f.ret_type), " {\n")
    var it = f.blocks.iter()
    loop {
        match it.next() {
            LBlock as b => { out = teko::str::concat(out, print_block(b)) }
            null => break
        }
    }
    teko::str::concat(out, "}\n")
}

fn print_layout(l: LStructLayout): str {
    var out = teko::str::concat("layout ", l.name, ": size=", teko::u64_to_str(l.size to u64), " align=", teko::u64_to_str(l.align to u64), " {")
    var i: u64 = 0
    loop {
        if i >= l.field_names.len { break }
        if i > 0 { out = teko::str::concat(out, ", ") }
        out = teko::str::concat(out, l.field_names[i], "@", teko::u64_to_str(l.field_offsets[i] to u64))
        i++
    }
    teko::str::concat(out, "}\n")
}

fn print_layouts(m: LModule): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= m.layouts.len { break }
        out = teko::str::concat(out, print_layout(m.layouts[i]))
        i++
    }
    out
}

fn print_rodata_bytes(bytes: []byte): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= bytes.len { break }
        if i > 0 { out = teko::str::concat(out, ", ") }
        out = teko::str::concat(out, teko::u64_to_str(bytes[i] to u64))
        i++
    }
    out
}

fn print_rodata_entry(r: LRodata): str {
    teko::str::concat("rodata ", r.symbol, ": [", print_rodata_bytes(r.bytes), "]\n")
}

fn print_rodata_section(m: LModule): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= m.rodata.len { break }
        out = teko::str::concat(out, print_rodata_entry(m.rodata[i]))
        i++
    }
    out
}

fn print_global_entry(g: LGlobal): str {
    teko::str::concat("global ", g.symbol, ": ", ltype_name(g.ty), " [", print_rodata_bytes(g.bytes), "]\n")
}

fn print_globals_section(m: LModule): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= m.globals.len { break }
        out = teko::str::concat(out, print_global_entry(m.globals[i]))
        i++
    }
    out
}

pub fn print_lmodule(m: LModule): str {
    var out = print_layouts(m)
    out = teko::str::concat(out, print_rodata_section(m))
    out = teko::str::concat(out, print_globals_section(m))
    var i: u64 = 0
    var it = m.funcs.iter()
    loop {
        match it.next() {
            LFunc as f => {
                if i > 0 { out = teko::str::concat(out, "\n") }
                out = teko::str::concat(out, print_func(f))
                i++
            }
            null => break
        }
    }
    out
}
