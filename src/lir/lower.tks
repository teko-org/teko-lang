use teko::checker
use teko::lexer
use teko::parser

pub type LEnv = struct { names: []str; vregs: []u32; len_vregs: []u32; has_len: []bool; is_slot: []bool; is_scalar_slot: []bool; slot_ltype: []LType }

pub fn empty_lenv(): LEnv {
    LEnv {
        names = []; vregs = []; len_vregs = []
        has_len = []; is_slot = []
        is_scalar_slot = []; slot_ltype = []
    }
}

fn lenv_prefix(env: LEnv, n: u64): LEnv {
    var names: [n]str = []
    var vregs: [n]u32 = []
    var len_vregs: [n]u32 = []
    var has_len: [n]bool = []
    var is_slot: [n]bool = []
    var is_scalar_slot: [n]bool = []
    var slot_ltype: [n]LType = []
    var i: u64 = 0
    loop {
        if i >= n { break }
        names[i] = env.names[i]
        vregs[i] = env.vregs[i]
        len_vregs[i] = env.len_vregs[i]
        has_len[i] = env.has_len[i]
        is_slot[i] = env.is_slot[i]
        is_scalar_slot[i] = env.is_scalar_slot[i]
        slot_ltype[i] = env.slot_ltype[i]
        i++
    }
    LEnv {
        names = names; vregs = vregs; len_vregs = len_vregs; has_len = has_len
        is_slot = is_slot; is_scalar_slot = is_scalar_slot; slot_ltype = slot_ltype
    }
}

pub fn lenv_bind(env: LEnv, name: str, vreg: u32): LEnv {
    LEnv {
        names = [..env.names, name]; vregs = [..env.vregs, vreg]
        len_vregs = [..env.len_vregs, 0]; has_len = [..env.has_len, false]
        is_slot = [..env.is_slot, false]
        is_scalar_slot = [..env.is_scalar_slot, false]; slot_ltype = [..env.slot_ltype, LType::Void]
    }
}

pub fn lenv_bind_fat(env: LEnv, name: str, ptr: u32, len: u32): LEnv {
    LEnv {
        names = [..env.names, name]; vregs = [..env.vregs, ptr]
        len_vregs = [..env.len_vregs, len]; has_len = [..env.has_len, true]
        is_slot = [..env.is_slot, false]
        is_scalar_slot = [..env.is_scalar_slot, false]; slot_ltype = [..env.slot_ltype, LType::Void]
    }
}

pub fn lenv_bind_fat_slot(env: LEnv, name: str, slot: u32): LEnv {
    LEnv {
        names = [..env.names, name]; vregs = [..env.vregs, slot]
        len_vregs = [..env.len_vregs, 0]; has_len = [..env.has_len, false]
        is_slot = [..env.is_slot, true]
        is_scalar_slot = [..env.is_scalar_slot, false]; slot_ltype = [..env.slot_ltype, LType::Void]
    }
}

pub fn lenv_bind_scalar_slot(env: LEnv, name: str, slot: u32, ty: LType): LEnv {
    LEnv {
        names = [..env.names, name]; vregs = [..env.vregs, slot]
        len_vregs = [..env.len_vregs, 0]; has_len = [..env.has_len, false]
        is_slot = [..env.is_slot, false]
        is_scalar_slot = [..env.is_scalar_slot, true]; slot_ltype = [..env.slot_ltype, ty]
    }
}

pub type LSlotLookup = struct { found: bool; slot: u32 }

pub fn lenv_lookup_fat_slot(env: LEnv, name: str): LSlotLookup {
    var idx = lenv_newest_index(env, name)
    if idx == env.names.len { return LSlotLookup { found = false; slot = 0 } }
    if !env.is_slot[idx] { return LSlotLookup { found = false; slot = 0 } }
    LSlotLookup { found = true; slot = env.vregs[idx] }
}

pub type LScalarSlotLookup = struct { found: bool; slot: u32; ty: LType }

pub fn lenv_lookup_scalar_slot(env: LEnv, name: str): LScalarSlotLookup {
    var idx = lenv_newest_index(env, name)
    if idx == env.names.len { return LScalarSlotLookup { found = false; slot = 0; ty = LType::Void } }
    if !env.is_scalar_slot[idx] { return LScalarSlotLookup { found = false; slot = 0; ty = LType::Void } }
    LScalarSlotLookup { found = true; slot = env.vregs[idx]; ty = env.slot_ltype[idx] }
}

fn lenv_newest_index(env: LEnv, name: str): u64 {
    var i: u64 = env.names.len
    loop {
        if i == 0 { break }
        i = i - 1
        if env.names[i] == name { return i }
    }
    env.names.len
}

fn list_set_u32(xs: []u32, idx: u64, v: u32): []u32 {
    var out: [xs.len]u32 = []
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if i == idx { out[i] = v } else { out[i] = xs[i] }
        i++
    }
    out
}

pub fn lenv_reassign(env: LEnv, name: str, vreg: u32): LEnv {
    var idx = lenv_newest_index(env, name)
    if idx == env.names.len { return lenv_bind(env, name, vreg) }
    if env.has_len[idx] { return lenv_bind(env, name, vreg) }
    LEnv {
        names = env.names; vregs = list_set_u32(env.vregs, idx, vreg)
        len_vregs = env.len_vregs; has_len = env.has_len; is_slot = env.is_slot
        is_scalar_slot = env.is_scalar_slot; slot_ltype = env.slot_ltype
    }
}

pub type LLookup = struct { found: bool; vreg: u32 }

pub fn lenv_lookup(env: LEnv, name: str): LLookup {
    var i = env.names.len
    loop {
        if i == 0 { break }
        i = i - 1
        if env.names[i] == name { return LLookup { found = true; vreg = env.vregs[i] } }
    }
    LLookup { found = false; vreg = 0 }
}

pub type LFatLookup = struct { found: bool; has_len: bool; ptr: u32; len: u32 }

pub fn lenv_lookup_fat(env: LEnv, name: str): LFatLookup {
    var i = env.names.len
    loop {
        if i == 0 { break }
        i = i - 1
        if env.names[i] == name { return LFatLookup { found = true; has_len = env.has_len[i]; ptr = env.vregs[i]; len = env.len_vregs[i] } }
    }
    LFatLookup { found = false; has_len = false; ptr = 0; len = 0 }
}

fn enum_carrier_ltype(): LType { LType::I32 }

pub fn ltype_of(t: @Type(), enums: []LEnumInfo): LType {
    match t {
        checker::Prim as p => ltype_of_prim(p.kind)
        checker::Byte => LType::I8
        checker::Void => LType::Void
        checker::Named as n => ltype_of_named(n, enums)
        _ => LType::Ptr
    }
}

fn ltype_of_named(n: checker::Named, enums: []LEnumInfo): LType {
    match find_value_carrier(enums, n.name) {
        LEnumInfo as info => info.carrier
        null => LType::Ptr
    }
}

fn ltype_of_prim(k: checker::PrimKind): LType {
    if k == checker::PrimKind::F32 { return LType::F32 }
    if k == checker::PrimKind::F64 { return LType::F64 }
    ltype_of_int_prim(k)
}

fn ltype_of_int_prim(k: checker::PrimKind): LType {
    if prim_width_of(k) == 8 { return LType::I8 }
    if prim_width_of(k) == 16 { return LType::I16 }
    if prim_width_of(k) == 32 { return LType::I32 }
    if k == checker::PrimKind::Bool { return LType::I8 }
    LType::I64
}

pub fn ltype_of_typeexpr(te: @TypeExpr(), enums: []LEnumInfo): LType {
    match te {
        parser::NamedType as nt => ltype_of_named_path(nt.path, enums)
        _ => LType::Ptr
    }
}

fn ltype_of_named_path(p: parser::Path, enums: []LEnumInfo): LType {
    match find_value_carrier(enums, path_name_of(p)) {
        LEnumInfo as info => return info.carrier
        null => { }
    }
    if p.segments.len != 1 { return LType::Ptr }
    ltype_of_prim_name(p.segments[0].name)
}

fn path_name_of(p: parser::Path): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= p.segments.len { break }
        out = if i == 0 { p.segments[i].name } else { teko::str::concat(out, "::", p.segments[i].name) }
        i++
    }
    out
}

fn ltype_of_prim_name(name: str): LType {
    if name == "u8" { return LType::I8 }
    if name == "u16" { return LType::I16 }
    if name == "u32" { return LType::I32 }
    if name == "u64" { return LType::I64 }
    if name == "i8" { return LType::I8 }
    if name == "i16" { return LType::I16 }
    if name == "i32" { return LType::I32 }
    if name == "i64" { return LType::I64 }
    if name == "f32" { return LType::F32 }
    if name == "f64" { return LType::F64 }
    if name == "bool" { return LType::I8 }
    if name == "byte" { return LType::I8 }
    if name == "usize" { return LType::I64 }
    if name == "isize" { return LType::I64 }
    LType::Ptr
}

fn prim_is_signed_int(k: checker::PrimKind): bool {
    k == checker::PrimKind::I8 || k == checker::PrimKind::I16 || k == checker::PrimKind::I32 ||
    k == checker::PrimKind::I64 || k == checker::PrimKind::Isize
}

fn prim_is_float_kind(k: checker::PrimKind): bool {
    k == checker::PrimKind::F32 || k == checker::PrimKind::F64
}

pub fn lbinop_of(op: lexer::TokenKind, k: checker::PrimKind): LBinOp | error {
    if prim_is_float_kind(k) { return lbinop_float(op) }
    lbinop_int(op, prim_is_signed_int(k))
}

fn lbinop_float(op: lexer::TokenKind): LBinOp | error {
    match op {
        lexer::TokenKind::Plus => LBinOp::FAdd
        lexer::TokenKind::Minus => LBinOp::FSub
        lexer::TokenKind::Star => LBinOp::FMul
        lexer::TokenKind::Slash => LBinOp::FDiv
        _ => error { message = "native backend N1: float operator not yet lowered (N2)" }
    }
}

fn lbinop_int(op: lexer::TokenKind, signed: bool): LBinOp | error {
    match op {
        lexer::TokenKind::Plus => LBinOp::IAdd
        lexer::TokenKind::Minus => LBinOp::ISub
        lexer::TokenKind::Star => LBinOp::IMul
        lexer::TokenKind::Slash => if signed { LBinOp::IDivS } else { LBinOp::IDivU }
        lexer::TokenKind::Percent => if signed { LBinOp::IRemS } else { LBinOp::IRemU }
        lexer::TokenKind::Amp => LBinOp::IAnd
        lexer::TokenKind::Pipe => LBinOp::IOr
        lexer::TokenKind::Caret => LBinOp::IXor
        lexer::TokenKind::Shl => LBinOp::IShl
        lexer::TokenKind::Shr => if signed { LBinOp::IShrS } else { LBinOp::IShrU }
        _ => error { message = "native backend N1: integer operator not yet lowered (N2)" }
    }
}

fn is_int_div_or_rem(op: LBinOp): bool {
    op == LBinOp::IDivS || op == LBinOp::IDivU || op == LBinOp::IRemS || op == LBinOp::IRemU
}

fn lower_div_zero_guard(ctx: LowerCtx, divisor: u32, line: u32, col: u32): LowerCtx {
    var z = ctx_alloc(ctx)
    var with_zero = ctx_append(z.ctx, const_int_inst(z.vreg, 0, line, col))
    var c = ctx_alloc(with_zero)
    var with_cmp = ctx_append(c.ctx, bin_inst(c.vreg, LBinOp::ICmpNe, divisor, z.vreg, line, col))
    lower_trap_unless(with_cmp, c.vreg, "teko_teko__runtime__panic_div0", line, col)
}

fn lower_trap_unless(ctx: LowerCtx, cond: u32, panic_symbol: str, line: u32, col: u32): LowerCtx {
    lower_trap_unless_with(ctx, cond, panic_symbol, [], line, col)
}

fn lower_trap_unless_with(ctx: LowerCtx, cond: u32, panic_symbol: str, args: []u32, line: u32, col: u32): LowerCtx {
    var okb = alloc_block(ctx.func)
    var trapb = alloc_block(okb.func)
    var br = branch_inst(cond, okb.block_id, [], trapb.block_id, [], line, col)
    var branched = ctx_append(ctx_with(ctx, trapb.func, ctx.block_id, ctx.env), br)
    var trap_ctx = ctx_goto(branched, trapb.block_id)
    var called = ctx_append(trap_ctx, void_call_inst(panic_symbol, args, false, line, col))
    var trap_closed = ctx_append(called, jump_inst(trapb.block_id, [], line, col))
    ctx_with(trap_closed, trap_closed.func, okb.block_id, branched.env)
}

pub fn lunop_of(op: lexer::TokenKind, k: checker::PrimKind): LUnOp | error {
    match op {
        lexer::TokenKind::Minus => if prim_is_float_kind(k) { LUnOp::FNeg } else { LUnOp::INeg }
        lexer::TokenKind::Tilde => LUnOp::INot
        _ => error { message = "native backend N1: unary operator not yet lowered (N2)" }
    }
}

fn cast_unop_of(src: checker::PrimKind, dst: checker::PrimKind): LUnOp | error {
    var src_f = prim_is_float_kind(src)
    var dst_f = prim_is_float_kind(dst)
    if src_f && dst_f { return LUnOp::FToF }
    if src_f { return LUnOp::FToI }
    if dst_f { return LUnOp::IToF }
    error { message = "native backend: an int->int `to` cast carries no conversion opcode — it is lowered by `lower_int_cast` (the fit guard), never by `cast_unop_of`" }
}

const CAST_FLOOR_I8: i64 = -128
const CAST_CEIL_I8: i64 = 127
const CAST_FLOOR_I16: i64 = -32768
const CAST_CEIL_I16: i64 = 32767
const CAST_FLOOR_I32: i64 = -2147483648
const CAST_CEIL_I32: i64 = 2147483647
const CAST_CEIL_I64: i64 = 9223372036854775807
const CAST_FLOOR_UNSIGNED: i64 = 0
const CAST_CEIL_U8: i64 = 255
const CAST_CEIL_U16: i64 = 65535
const CAST_CEIL_U32: i64 = 4294967295

type CastFitBounds = struct {
    has_floor: bool
    floor: i64
    has_ceil: bool
    ceil: i64
}

fn cast_signed_dst_bounds(dst: checker::PrimKind): CastFitBounds {
    if dst == checker::PrimKind::I8 { return CastFitBounds { has_floor = true; floor = CAST_FLOOR_I8; has_ceil = true; ceil = CAST_CEIL_I8 } }
    if dst == checker::PrimKind::I16 { return CastFitBounds { has_floor = true; floor = CAST_FLOOR_I16; has_ceil = true; ceil = CAST_CEIL_I16 } }
    if dst == checker::PrimKind::I32 { return CastFitBounds { has_floor = true; floor = CAST_FLOOR_I32; has_ceil = true; ceil = CAST_CEIL_I32 } }
    CastFitBounds { has_floor = false; floor = 0; has_ceil = true; ceil = CAST_CEIL_I64 }
}

fn cast_unsigned_dst_bounds(dst: checker::PrimKind): CastFitBounds {
    if dst == checker::PrimKind::U8 { return CastFitBounds { has_floor = true; floor = CAST_FLOOR_UNSIGNED; has_ceil = true; ceil = CAST_CEIL_U8 } }
    if dst == checker::PrimKind::U16 { return CastFitBounds { has_floor = true; floor = CAST_FLOOR_UNSIGNED; has_ceil = true; ceil = CAST_CEIL_U16 } }
    if dst == checker::PrimKind::U32 { return CastFitBounds { has_floor = true; floor = CAST_FLOOR_UNSIGNED; has_ceil = true; ceil = CAST_CEIL_U32 } }
    CastFitBounds { has_floor = true; floor = CAST_FLOOR_UNSIGNED; has_ceil = false; ceil = 0 }
}

fn cast_fit_bounds(src: checker::PrimKind, dst: checker::PrimKind): CastFitBounds {
    var raw = if prim_is_signed_int(dst) { cast_signed_dst_bounds(dst) } else { cast_unsigned_dst_bounds(dst) }
    if prim_is_signed_int(src) { return raw }
    CastFitBounds { has_floor = false; floor = 0; has_ceil = raw.has_ceil; ceil = raw.ceil }
}

fn lower_cast_bound_guard(ctx: LowerCtx, value: u32, op: LBinOp, bound: i64, line: u32, col: u32): LowerCtx {
    var b = ctx_alloc(ctx)
    var with_bound = ctx_append(b.ctx, const_int_inst(b.vreg, bound, line, col))
    var lr = ctx_alloc(with_bound)
    var with_line = ctx_append(lr.ctx, const_int_inst(lr.vreg, line to i64, line, col))
    var cr = ctx_alloc(with_line)
    var with_col = ctx_append(cr.ctx, const_int_inst(cr.vreg, col to i64, line, col))
    var c = ctx_alloc(with_col)
    var with_cmp = ctx_append(c.ctx, bin_inst(c.vreg, op, value, b.vreg, line, col))
    lower_trap_unless_with(with_cmp, c.vreg, "teko_teko__runtime__panic_cast_at", two_args(lr.vreg, cr.vreg), line, col)
}

fn lower_cast_fit_guard(ctx: LowerCtx, value: u32, src: checker::PrimKind, dst: checker::PrimKind, line: u32, col: u32): LowerCtx {
    if checker::cast_is_lossless_widen(src, dst) { return ctx }
    var bounds = cast_fit_bounds(src, dst)
    var ceil_op = if prim_is_signed_int(src) { LBinOp::ICmpLeS } else { LBinOp::ICmpLeU }
    var floored = if bounds.has_floor { lower_cast_bound_guard(ctx, value, LBinOp::ICmpGeS, bounds.floor, line, col) } else { ctx }
    if !bounds.has_ceil { return floored }
    lower_cast_bound_guard(floored, value, ceil_op, bounds.ceil, line, col)
}

fn cast_widens_to_64(src: checker::PrimKind, dst: checker::PrimKind): bool {
    prim_width_of(dst) == (64 to u32) && prim_width_of(src) < (64 to u32)
}

fn lower_widen_to_64(operand: Lowered, line: u32, col: u32): Lowered {
    var z = ctx_alloc(operand.ctx)
    var with_zero = ctx_append(z.ctx, const_int_inst(z.vreg, 0, line, col))
    var r = ctx_alloc(with_zero)
    var widened = ctx_append(r.ctx, bin_inst(r.vreg, LBinOp::IOr, z.vreg, operand.vreg, line, col))
    Lowered { ctx = widened; vreg = r.vreg }
}

fn lower_int_cast(operand: Lowered, src: checker::PrimKind, dst: checker::PrimKind, line: u32, col: u32): Lowered {
    var guarded = lower_cast_fit_guard(operand.ctx, operand.vreg, src, dst, line, col)
    if cast_widens_to_64(src, dst) { return lower_widen_to_64(Lowered { ctx = guarded; vreg = operand.vreg }, line, col) }
    Lowered { ctx = guarded; vreg = operand.vreg }
}

fn prim_width_of(k: checker::PrimKind): u32 {
    if k == checker::PrimKind::U8 || k == checker::PrimKind::I8 { return 8 }
    if k == checker::PrimKind::U16 || k == checker::PrimKind::I16 { return 16 }
    if k == checker::PrimKind::U32 || k == checker::PrimKind::I32 { return 32 }
    if k == checker::PrimKind::U64 || k == checker::PrimKind::I64 { return 64 }
    if k == checker::PrimKind::Usize || k == checker::PrimKind::Isize { return 64 }
    if k == checker::PrimKind::F32 { return 32 }
    if k == checker::PrimKind::F64 { return 64 }
    1
}

const TEKO_USER_PREFIX: str = "teko_"

pub fn mangle_fn_symbol(ns: str, name: str, flat: bool = false, suffix: str = ""): str {
    var sym = if flat { "" } else { TEKO_USER_PREFIX }
    if ns.len != 0 { sym = teko::str::concat(sym, mangle_ns(ns), "__") }
    sym = teko::str::concat(sym, escape_c_keyword(name))
    if suffix.len != 0 { sym = teko::str::concat(sym, suffix) }
    sym
}

fn mangle_ns(ns: str): str {
    var xs: [ns.len]byte = []
    var i: u64 = 0
    loop {
        if i >= ns.len { break }
        var ch = if ns[i] == b':' { b'_' } else { ns[i] }
        xs[i] = ch
        i++
    }
    str(xs)
}

fn escape_c_keyword(name: str): str {
    if is_c_keyword(name) { return teko::str::concat(name, "_") }
    name
}

fn is_c_keyword(s: str): bool {
    s == "bool" || s == "int" || s == "char" || s == "short" || s == "long" ||
    s == "float" || s == "double" || s == "void" || s == "unsigned" || s == "signed" ||
    s == "const" || s == "volatile" || s == "register" || s == "auto" || s == "static" ||
    s == "struct" || s == "union" || s == "enum" || s == "return" || s == "default" ||
    s == "goto" || s == "break" || s == "continue" || s == "case" || s == "switch" ||
    s == "do" || s == "for" || s == "while" || s == "if" || s == "else" || s == "sizeof" ||
    s == "typedef" || s == "extern" || s == "inline" || s == "restrict"
}

pub type LEnumInfo = struct { name: str; members: []str; carrier: LType; is_register: bool; is_newtype: bool }

pub type LVariantDef = struct { name: str; ty: checker::Variant }

pub type LFieldDecls = struct { name: str; field_names: []str; field_types: []@Type() }

pub type LExternFn = struct { namespace: str; name: str; c_symbol: str }

pub type LoopTargets = struct { label: str; head: u32; exit: u32; defer_base: u64; names: []str; region_base: u64 }

pub type LowerCtx = struct {
    func: LFunc; block_id: u32; env: LEnv
    layouts: []LStructLayout; rodata: []LRodata; enums: []LEnumInfo; lifted: []LFunc
    defers: []checker::TDeferStmt; loop_targets: []LoopTargets; externs: []LExternFn
    flat_symbols: bool; ret_type: @Type()
    has_ret_len_slot: bool; ret_len_slot: u32
    variants: []LVariantDef
    ref_fns: []LRefFnInfo
    field_decls: []LFieldDecls
    addr_taken: []str
    table: checker::TypeTable
    region_stack: []NativeRegionFrame
    escaping: []str
    frees_old_names: []str
    bracket_depth: u32
    region_param: u32
    plan: checker::ResidencePlan
    rodata_base: u64
    const_rodata: []LRodata
    lifted_base: u64
}

pub type NativeRegionFrame = struct { region_vreg: u32; decl_name: str; is_loop: bool; elided: bool }

pub type Lowered = struct { ctx: LowerCtx; vreg: u32 }

pub type LowerStmtOut = struct { ctx: LowerCtx; terminated: bool }

fn ctx_with(ctx: LowerCtx, func: LFunc, block_id: u32, env: LEnv): LowerCtx {
    LowerCtx {
        func = func; block_id = block_id; env = env
        layouts = ctx.layouts; rodata = ctx.rodata; enums = ctx.enums; lifted = ctx.lifted
        variants = ctx.variants
        defers = ctx.defers; loop_targets = ctx.loop_targets; externs = ctx.externs
        flat_symbols = ctx.flat_symbols; ret_type = ctx.ret_type
        has_ret_len_slot = ctx.has_ret_len_slot; ret_len_slot = ctx.ret_len_slot
        ref_fns = ctx.ref_fns; field_decls = ctx.field_decls; addr_taken = ctx.addr_taken; table = ctx.table
        region_stack = ctx.region_stack; escaping = ctx.escaping; frees_old_names = ctx.frees_old_names; bracket_depth = ctx.bracket_depth
        region_param = ctx.region_param; plan = ctx.plan; rodata_base = ctx.rodata_base; const_rodata = ctx.const_rodata; lifted_base = ctx.lifted_base
    }
}

fn ctx_with_rodata(ctx: LowerCtx, rodata: []LRodata): LowerCtx {
    LowerCtx {
        func = ctx.func; block_id = ctx.block_id; env = ctx.env
        layouts = ctx.layouts; rodata = rodata; enums = ctx.enums; lifted = ctx.lifted
        variants = ctx.variants
        defers = ctx.defers; loop_targets = ctx.loop_targets; externs = ctx.externs
        flat_symbols = ctx.flat_symbols; ret_type = ctx.ret_type
        has_ret_len_slot = ctx.has_ret_len_slot; ret_len_slot = ctx.ret_len_slot
        ref_fns = ctx.ref_fns; field_decls = ctx.field_decls; addr_taken = ctx.addr_taken; table = ctx.table
        region_stack = ctx.region_stack; escaping = ctx.escaping; frees_old_names = ctx.frees_old_names; bracket_depth = ctx.bracket_depth
        region_param = ctx.region_param; plan = ctx.plan; rodata_base = ctx.rodata_base; const_rodata = ctx.const_rodata; lifted_base = ctx.lifted_base
    }
}

fn ctx_with_lifted(ctx: LowerCtx, lifted: []LFunc): LowerCtx {
    LowerCtx {
        func = ctx.func; block_id = ctx.block_id; env = ctx.env
        layouts = ctx.layouts; rodata = ctx.rodata; enums = ctx.enums; lifted = lifted
        variants = ctx.variants
        defers = ctx.defers; loop_targets = ctx.loop_targets; externs = ctx.externs
        flat_symbols = ctx.flat_symbols; ret_type = ctx.ret_type
        has_ret_len_slot = ctx.has_ret_len_slot; ret_len_slot = ctx.ret_len_slot
        ref_fns = ctx.ref_fns; field_decls = ctx.field_decls; addr_taken = ctx.addr_taken; table = ctx.table
        region_stack = ctx.region_stack; escaping = ctx.escaping; frees_old_names = ctx.frees_old_names; bracket_depth = ctx.bracket_depth
        region_param = ctx.region_param; plan = ctx.plan; rodata_base = ctx.rodata_base; const_rodata = ctx.const_rodata; lifted_base = ctx.lifted_base
    }
}

