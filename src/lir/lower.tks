fn ctx_alloc(ctx: LowerCtx): Lowered {
    var fresh = alloc_vreg(ctx.func)
    Lowered { ctx = ctx_with(ctx, fresh.func, ctx.block_id, ctx.env); vreg = fresh.vreg }
}

fn ctx_append(ctx: LowerCtx, inst: LInst): LowerCtx {
    ctx_with(ctx, append_inst(ctx.func, ctx.block_id, inst), ctx.block_id, ctx.env)
}

fn ctx_bind(ctx: LowerCtx, name: str, vreg: u32): LowerCtx {
    ctx_with(ctx, ctx.func, ctx.block_id, lenv_bind(ctx.env, name, vreg))
}

fn ctx_bind_fat(ctx: LowerCtx, name: str, ptr: u32, len: u32): LowerCtx {
    ctx_with(ctx, ctx.func, ctx.block_id, lenv_bind_fat(ctx.env, name, ptr, len))
}

fn ctx_bind_scalar_slot(ctx: LowerCtx, name: str, slot: u32, ty: LType): LowerCtx {
    ctx_with(ctx, ctx.func, ctx.block_id, lenv_bind_scalar_slot(ctx.env, name, slot, ty))
}

fn ctx_reassign(ctx: LowerCtx, name: str, vreg: u32): LowerCtx {
    ctx_with(ctx, ctx.func, ctx.block_id, lenv_reassign(ctx.env, name, vreg))
}

fn ctx_with_regions(ctx: LowerCtx, region_stack: []NativeRegionFrame): LowerCtx {
    LowerCtx {
        func = ctx.func; block_id = ctx.block_id; env = ctx.env
        layouts = ctx.layouts; rodata = ctx.rodata; enums = ctx.enums; lifted = ctx.lifted
        variants = ctx.variants
        defers = ctx.defers; loop_targets = ctx.loop_targets; externs = ctx.externs
        flat_symbols = ctx.flat_symbols; ret_type = ctx.ret_type
        has_ret_len_slot = ctx.has_ret_len_slot; ret_len_slot = ctx.ret_len_slot
        ref_fns = ctx.ref_fns; field_decls = ctx.field_decls; addr_taken = ctx.addr_taken; table = ctx.table
        region_stack = region_stack; escaping = ctx.escaping; frees_old_names = ctx.frees_old_names; bracket_depth = ctx.bracket_depth
        region_param = ctx.region_param; plan = ctx.plan; rodata_base = ctx.rodata_base; const_rodata = ctx.const_rodata; lifted_base = ctx.lifted_base
    }
}

fn region_from_param(ctx: LowerCtx): u32 {
    ctx.region_param
}

fn ctx_with_bracket_depth(ctx: LowerCtx, bracket_depth: u32): LowerCtx {
    LowerCtx {
        func = ctx.func; block_id = ctx.block_id; env = ctx.env
        layouts = ctx.layouts; rodata = ctx.rodata; enums = ctx.enums; lifted = ctx.lifted
        variants = ctx.variants
        defers = ctx.defers; loop_targets = ctx.loop_targets; externs = ctx.externs
        flat_symbols = ctx.flat_symbols; ret_type = ctx.ret_type
        has_ret_len_slot = ctx.has_ret_len_slot; ret_len_slot = ctx.ret_len_slot
        ref_fns = ctx.ref_fns; field_decls = ctx.field_decls; addr_taken = ctx.addr_taken; table = ctx.table
        region_stack = ctx.region_stack; escaping = ctx.escaping; frees_old_names = ctx.frees_old_names; bracket_depth = bracket_depth
        region_param = ctx.region_param; plan = ctx.plan; rodata_base = ctx.rodata_base; const_rodata = ctx.const_rodata; lifted_base = ctx.lifted_base
    }
}

fn one_region_arg(vreg: u32): []u32 {
    [vreg]
}

fn open_frame_region(ctx: LowerCtx, line: u32, col: u32): LowerCtx {
    var rr = ctx_alloc(ctx)
    var with_rr = ctx_append(rr.ctx, call_inst(rr.vreg, "tk_region_root_u", [], false, line, col))
    var fr = ctx_alloc(with_rr)
    var with_fr = ctx_append(fr.ctx, call_inst(fr.vreg, "tk_region_new_u", one_region_arg(rr.vreg), false, line, col))
    var entered = ctx_append(with_fr, void_call_inst("tk_region_enter_u", one_region_arg(fr.vreg), false, line, col))
    ctx_with_regions(entered, [..entered.region_stack, NativeRegionFrame { region_vreg = fr.vreg; decl_name = ""; is_loop = false; elided = false }])
}

fn emit_region_leaves(ctx: LowerCtx, line: u32, col: u32): LowerCtx {
    var cur = ctx
    var i = ctx.region_stack.len
    loop {
        if i == 0 { break }
        i = i - 1
        if !ctx.region_stack[i].elided {
            cur = ctx_append(cur, void_call_inst("tk_region_leave", [], false, line, col))
        }
    }
    cur
}

fn emit_region_enters(ctx: LowerCtx, line: u32, col: u32): LowerCtx {
    var cur = ctx
    var i: u64 = 0
    loop {
        if i >= ctx.region_stack.len { break }
        if !ctx.region_stack[i].elided {
            cur = ctx_append(cur, void_call_inst("tk_region_enter_u", one_region_arg(ctx.region_stack[i].region_vreg), false, line, col))
        }
        i++
    }
    cur
}

fn emit_region_drops(ctx: LowerCtx, line: u32, col: u32): LowerCtx {
    var cur = ctx
    var i = ctx.region_stack.len
    loop {
        if i == 0 { break }
        i = i - 1
        if !ctx.region_stack[i].elided {
            cur = ctx_append(cur, void_call_inst("tk_region_drop_u", one_region_arg(ctx.region_stack[i].region_vreg), false, line, col))
        }
    }
    cur
}

fn binding_conveys_escape(escaping: []str, name: str): bool {
    contains_str(escaping, name)
}

fn pop_region_stack(stack: []NativeRegionFrame): []NativeRegionFrame {
    if stack.len == 0 { return stack }
    teko::collections::arr_slice(stack, 0, stack.len - 1)
}

fn region_stack_with_top_decl(stack: []NativeRegionFrame, name: str): []NativeRegionFrame {
    if stack.len == 0 { return stack }
    var top = stack[stack.len - 1]
    var popped = pop_region_stack(stack)
    [..popped, NativeRegionFrame { region_vreg = top.region_vreg; decl_name = name; is_loop = top.is_loop; elided = top.elided }]
}

fn register_scope_decl_name(ctx: LowerCtx, name: str): LowerCtx {
    ctx_with_regions(ctx, region_stack_with_top_decl(ctx.region_stack, name))
}

fn region_current_vreg(ctx: LowerCtx): Lowered {
    if ctx.region_stack.len > 0 { return Lowered { ctx = ctx; vreg = ctx.region_stack[ctx.region_stack.len - 1].region_vreg } }
    var r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, call_inst(r.vreg, "tk_region_root_u", [], false, 0, 0)); vreg = r.vreg }
}

fn open_native_region(ctx: LowerCtx, decl_name: str, is_loop: bool, elide: bool, line: u32, col: u32): LowerCtx | error {
    if ctx.bracket_depth > 0 { return ctx }
    if elide {
        var inherited = region_current_vreg(ctx)
        return ctx_with_regions(inherited.ctx, [..inherited.ctx.region_stack, NativeRegionFrame { region_vreg = inherited.vreg; decl_name = decl_name; is_loop = is_loop; elided = true }])
    }
    var cur = region_current_vreg(ctx)
    var bl = ctx_alloc(cur.ctx)
    var with_new = ctx_append(bl.ctx, call_inst(bl.vreg, "tk_region_new_u", one_region_arg(cur.vreg), false, line, col))
    var entered = ctx_append(with_new, void_call_inst("tk_region_enter_u", one_region_arg(bl.vreg), false, line, col))
    ctx_with_regions(entered, [..entered.region_stack, NativeRegionFrame { region_vreg = bl.vreg; decl_name = decl_name; is_loop = is_loop; elided = false }])
}

fn close_native_region(ctx: LowerCtx, line: u32, col: u32): LowerCtx | error {
    if ctx.bracket_depth > 0 { return ctx }
    if ctx.region_stack.len == 0 {
        return error { message = "native backend N1: close_native_region with no open region (internal invariant break)" }
    }
    var top = ctx.region_stack[ctx.region_stack.len - 1]
    if top.elided { return ctx_with_regions(ctx, pop_region_stack(ctx.region_stack)) }
    var left = ctx_append(ctx, void_call_inst("tk_region_leave", [], false, line, col))
    var dropped = ctx_append(left, void_call_inst("tk_region_drop_u", one_region_arg(top.region_vreg), false, line, col))
    ctx_with_regions(dropped, pop_region_stack(ctx.region_stack))
}

fn close_native_regions_to(ctx: LowerCtx, floor: u64, line: u32, col: u32): LowerCtx | error {
    var cur = ctx
    loop {
        if cur.region_stack.len <= floor { break }
        cur = match close_native_region(cur, line, col) { LowerCtx as c => c; error as err => return err }
    }
    cur
}

pub fn lower_expr(ctx: LowerCtx, e: checker::TExpr): Lowered | error {
    match e.kind {
        checker::TNumber as n => lower_number(ctx, e, n)
        checker::TVar as v => lower_var(ctx, e, v)
        checker::TBinary as b => lower_binary(ctx, e, b)
        checker::TUnary as u => lower_unary(ctx, e, u)
        checker::TCast as c => lower_cast(ctx, e, c)
        checker::TCall as cl => lower_call(ctx, e, cl)
        checker::TCompare as cm => lower_compare(ctx, e, cm)
        checker::TIfExpr as f => lower_if_expr(ctx, e, f)
        checker::TStructInit as si => lower_struct_init(ctx, e, si)
        checker::TFieldAccess as fa => lower_field_access(ctx, e, fa)
        checker::TIndex as ix => lower_index(ctx, e, ix)
        checker::TArrayLit as al => lower_array_lit(ctx, e, al)
        checker::TSliceOfLen as sol => lower_slice_of_len(ctx, e, sol)
        checker::TZeroOf as z => lower_zero_of(ctx, e, z)
        checker::TByteLit as b => lower_byte_lit(ctx, e, b)
        checker::TCharLit as c => lower_char_lit(ctx, e, c)
        checker::TBoolLit as b => lower_bool_lit(ctx, e, b)
        checker::TNullLit as n => lower_null_lit(ctx, e, n)
        checker::TPathExpr as p => lower_path_expr(ctx, e, p)
        checker::TStrLit as s => lower_str_lit(ctx, e, s)
        checker::TByteStrLit as bs => lower_bytestr_lit(ctx, e, bs)
        checker::TInterp as ip => lower_interp(ctx, e, ip)
        checker::TInExpr as ine => lower_in_expr(ctx, e, ine)
        checker::TMatchExpr as mx => lower_match(ctx, e, mx)
        checker::TLambda as lam => lower_lambda(ctx, e, lam)
        checker::TBorrow as bw => lower_addr_of_place(ctx, bw.operand)
        checker::TBlockExpr as blk => lower_block_expr(ctx, e, blk)
        _ => error { message = teko::str::concat("native backend N1: ", texpr_kind_name(e), " not yet lowered (N2)") }
    }
}

fn lower_block_expr(ctx: LowerCtx, e: checker::TExpr, blk: checker::TBlockExpr): Lowered | error {
    if blk.body.len == 0 { return error { message = "native backend: a block used as a value must not be empty (internal)" } }
    var pre = match lower_block_prefix(ctx, blk.body) { LowerStmtOut as x => x; error as err => return err }
    if pre.terminated { return error { message = "native backend: a block used as a value must not diverge before its tail (internal)" } }
    var result_ty = ltype_of(e.type, ctx.enums)
    var tail = match lower_tail_stmt(pre.ctx, blk.body[blk.body.len - 1], result_ty, e.type) { LowerBlockValue as x => x; error as err => return err }
    if tail.terminated { return error { message = "native backend: a block used as a value must end in a value (internal)" } }
    var scoped = ctx_with(tail.ctx, tail.ctx.func, tail.ctx.block_id, lenv_prefix(tail.ctx.env, ctx.env.names.len))
    Lowered { ctx = scoped; vreg = tail.vreg }
}

fn float_literal_is_wide(ctx: LowerCtx, e: checker::TExpr): bool {
    match prim_kind_of(e.type, ctx.enums, "float literal") {
        checker::PrimKind as p => p != checker::PrimKind::F32
        error => true
    }
}

fn lower_number(ctx: LowerCtx, e: checker::TExpr, n: checker::TNumber): Lowered | error {
    var r = ctx_alloc(ctx)
    if n.is_float {
        var finst = const_float_inst(r.vreg, teko::f64_bits(n.fval), float_literal_is_wide(ctx, e), e.line, e.col)
        return Lowered { ctx = ctx_append(r.ctx, finst); vreg = r.vreg }
    }
    var inst = const_int_inst(r.vreg, parser::numint_to_i64(n.value), e.line, e.col)
    Lowered { ctx = ctx_append(r.ctx, inst); vreg = r.vreg }
}

fn lower_var(ctx: LowerCtx, e: checker::TExpr, v: checker::TVar): Lowered | error {
    if v.is_func { return lower_fn_value(ctx, e, v) }
    var slot = lenv_lookup_fat_slot(ctx.env, v.name)
    if slot.found { return load_fat_slot_ptr(ctx, slot.slot, e.line, e.col) }
    var sslot = lenv_lookup_scalar_slot(ctx.env, v.name)
    if sslot.found {
        var r = ctx_alloc(ctx)
        return Lowered { ctx = ctx_append(r.ctx, load_inst(r.vreg, sslot.slot, sslot.ty, e.line, e.col)); vreg = r.vreg }
    }
    var hit = lenv_lookup(ctx.env, v.name)
    if hit.found { return Lowered { ctx = ctx; vreg = hit.vreg } }
    match lookup_const_rodata(ctx, v.name) {
        LRodata as r => lower_const_addr(ctx, r.symbol, e.line, e.col)
        null => error { message = teko::str::concat("native backend N1: unbound local `", v.name, "` (internal)") }
    }
}

fn lower_const_addr(ctx: LowerCtx, symbol: str, line: u32, col: u32): Lowered {
    var r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, global_addr_inst(r.vreg, symbol, line, col)); vreg = r.vreg }
}

fn find_const_rodata(rodata: []LRodata, name: str): LRodata | null {
    var sym = const_rodata_symbol(name)
    var i: u64 = 0
    loop {
        if i >= rodata.len { break }
        if rodata[i].symbol == sym { return rodata[i] }
        i++
    }
    null
}

fn lookup_const_rodata(ctx: LowerCtx, name: str): LRodata | null {
    match find_const_rodata(ctx.const_rodata, name) {
        LRodata as r => return r
        null => { }
    }
    find_const_rodata(ctx.rodata, name)
}

fn is_short_circuit_op(op: lexer::TokenKind): bool {
    op == lexer::TokenKind::AndAnd || op == lexer::TokenKind::OrOr
}

fn short_circuit_value(op: lexer::TokenKind): i64 {
    if op == lexer::TokenKind::AndAnd { return 0 }
    1
}

fn lower_logical(ctx: LowerCtx, e: checker::TExpr, b: checker::TBinary): Lowered | error {
    var lo = match lower_expr(ctx, b.left) { Lowered as x => x; error as err => return err }
    var rhsb = alloc_block(lo.ctx.func)
    var shortb = alloc_block(rhsb.func)
    var mergeb = alloc_block(shortb.func)
    var mp = add_block_param(mergeb.func, mergeb.block_id)
    var is_and = b.op == lexer::TokenKind::AndAnd
    var t_target = if is_and { rhsb.block_id } else { shortb.block_id }
    var f_target = if is_and { shortb.block_id } else { rhsb.block_id }
    var br = branch_inst(lo.vreg, t_target, [], f_target, [], e.line, e.col)
    var ctx1 = ctx_append(ctx_with(lo.ctx, mp.func, lo.ctx.block_id, lo.ctx.env), br)
    var shortr = ctx_alloc(ctx_goto(ctx1, shortb.block_id))
    var with_const = ctx_append(shortr.ctx, const_int_inst(shortr.vreg, short_circuit_value(b.op), e.line, e.col))
    var short_args = [shortr.vreg]
    var short_func = close_arm_to(with_const, mergeb.block_id, short_args, e.line, e.col)
    var rhs_ctx = ctx_with(with_const, short_func, rhsb.block_id, ctx1.env)
    var ro = match lower_expr(rhs_ctx, b.right) { Lowered as x => x; error as err => return err }
    var rhs_args = [ro.vreg]
    var rhs_func = close_arm_to(ro.ctx, mergeb.block_id, rhs_args, e.line, e.col)
    Lowered { ctx = ctx_with(ro.ctx, rhs_func, mergeb.block_id, ctx1.env); vreg = mp.vreg }
}

fn lower_binary(ctx: LowerCtx, e: checker::TExpr, b: checker::TBinary): Lowered | error {
    if is_short_circuit_op(b.op) { return lower_logical(ctx, e, b) }
    var lo = match lower_expr(ctx, b.left) { Lowered as x => x; error as err => return err }
    var ro = match lower_expr(lo.ctx, b.right) { Lowered as x => x; error as err => return err }
    var k = match prim_kind_of(e.type, ctx.enums, "binary result") { checker::PrimKind as p => p; error as err => return err }
    var op = match lbinop_of(b.op, k) { LBinOp as o => o; error as err => return err }
    var guarded = if is_int_div_or_rem(op) { lower_div_zero_guard(ro.ctx, ro.vreg, e.line, e.col) } else { ro.ctx }
    var r = ctx_alloc(guarded)
    var inst = bin_inst(r.vreg, op, lo.vreg, ro.vreg, e.line, e.col)
    Lowered { ctx = ctx_append(r.ctx, inst); vreg = r.vreg }
}

fn lower_unary(ctx: LowerCtx, e: checker::TExpr, u: checker::TUnary): Lowered | error {
    var ao = match lower_expr(ctx, u.operand) { Lowered as x => x; error as err => return err }
    if is_logical_not(u.op) { return lower_logical_not(ao, e.line, e.col) }
    var k = match prim_kind_of(u.operand.type, ctx.enums, "unary operand") { checker::PrimKind as p => p; error as err => return err }
    var op = match lunop_of(u.op, k) { LUnOp as o => o; error as err => return err }
    var r = ctx_alloc(ao.ctx)
    var inst = un_inst(r.vreg, op, ao.vreg, e.line, e.col)
    var raw = Lowered { ctx = ctx_append(r.ctx, inst); vreg = r.vreg }
    narrow_unary_float_to_result(ctx, e, k, raw)
}

fn narrow_unary_float_to_result(ctx: LowerCtx, e: checker::TExpr, operand_kind: checker::PrimKind, done: Lowered): Lowered {
    if !prim_is_float_kind(operand_kind) { return done }
    if operand_kind == checker::PrimKind::F32 { return done }
    match prim_kind_of(e.type, ctx.enums, "unary result") {
        checker::PrimKind as p => if p == checker::PrimKind::F32 { narrow_float_to_f32(done, e) } else { done }
        error => done
    }
}

fn narrow_float_to_f32(ao: Lowered, e: checker::TExpr): Lowered {
    var narrow = ctx_alloc(ao.ctx)
    var to_f32 = un_inst(narrow.vreg, LUnOp::FToF, ao.vreg, e.line, e.col)
    Lowered { ctx = ctx_append(narrow.ctx, to_f32); vreg = narrow.vreg }
}

fn is_logical_not(op: lexer::TokenKind): bool {
    match op { lexer::TokenKind::Bang => true; _ => false }
}

fn lower_logical_not(ao: Lowered, line: u32, col: u32): Lowered {
    var z = ctx_alloc(ao.ctx)
    var with_zero = ctx_append(z.ctx, const_int_inst(z.vreg, 0, line, col))
    var r = ctx_alloc(with_zero)
    var inst = bin_inst(r.vreg, LBinOp::ICmpEq, ao.vreg, z.vreg, line, col)
    Lowered { ctx = ctx_append(r.ctx, inst); vreg = r.vreg }
}

fn lower_cast(ctx: LowerCtx, e: checker::TExpr, c: checker::TCast): Lowered | error {
    match variant_type_of(e.type, ctx.variants) {
        checker::Variant => return lower_value_into_type(ctx, e.type, c.expr)
        null => { }
    }
    if is_char_type(c.expr.type) && is_char_decode_dest(e.type) { return lower_char_decode_cast(ctx, e, c) }
    var ao = match lower_expr(ctx, c.expr) { Lowered as x => x; error as err => return err }
    if is_u64_ptr_byte_reinterpret_cast(c.expr.type, e.type) { return ao }
    var src = match prim_kind_of(c.expr.type, ctx.enums, "cast source") { checker::PrimKind as p => p; error as err => return err }
    var dst = match prim_kind_of(e.type, ctx.enums, "cast target") { checker::PrimKind as p => p; error as err => return err }
    if is_same_width_float_cast(src, dst) { return ao }
    if is_int_to_narrow_float_cast(src, dst) { return lower_int_to_f32(ao, e) }
    if !prim_is_float_kind(src) && !prim_is_float_kind(dst) { return lower_int_cast(ao, src, dst, e.line, e.col) }
    var op = match cast_unop_of(src, dst) { LUnOp as o => o; error as err => return err }
    var r = ctx_alloc(ao.ctx)
    var inst = un_inst(r.vreg, op, ao.vreg, e.line, e.col)
    Lowered { ctx = ctx_append(r.ctx, inst); vreg = r.vreg }
}

fn is_char_decode_dest(t: @Type()): bool {
    match t {
        checker::Prim as p => p.kind == checker::PrimKind::U32 || p.kind == checker::PrimKind::U64 || p.kind == checker::PrimKind::I64
        _ => false
    }
}

fn lower_const_int(ctx: LowerCtx, v: i64, line: u32, col: u32): Lowered {
    var r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, const_int_inst(r.vreg, v, line, col)); vreg = r.vreg }
}

fn lower_and_const(lo: Lowered, mask: i64, line: u32, col: u32): Lowered {
    var m = lower_const_int(lo.ctx, mask, line, col)
    var r = ctx_alloc(m.ctx)
    Lowered { ctx = ctx_append(r.ctx, bin_inst(r.vreg, LBinOp::IAnd, lo.vreg, m.vreg, line, col)); vreg = r.vreg }
}

fn lower_shl_const(lo: Lowered, amount: i64, line: u32, col: u32): Lowered {
    var a = lower_const_int(lo.ctx, amount, line, col)
    var r = ctx_alloc(a.ctx)
    Lowered { ctx = ctx_append(r.ctx, bin_inst(r.vreg, LBinOp::IShl, lo.vreg, a.vreg, line, col)); vreg = r.vreg }
}

fn lower_or_vreg(ctx: LowerCtx, a: u32, b: u32, line: u32, col: u32): Lowered {
    var r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, bin_inst(r.vreg, LBinOp::IOr, a, b, line, col)); vreg = r.vreg }
}

fn lower_len_eq(ctx: LowerCtx, len_vreg: u32, v: i64, line: u32, col: u32): Lowered {
    var c = lower_const_int(ctx, v, line, col)
    var r = ctx_alloc(c.ctx)
    Lowered { ctx = ctx_append(r.ctx, bin_inst(r.vreg, LBinOp::ICmpEq, len_vreg, c.vreg, line, col)); vreg = r.vreg }
}

fn char_load_masked(ctx: LowerCtx, ptr: u32, offset: u32, mask: i64, line: u32, col: u32): Lowered {
    var addr = ctx_alloc(ctx)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, ptr, offset, line, col))
    var bl = ctx_alloc(with_addr)
    var with_load = ctx_append(bl.ctx, load_inst(bl.vreg, addr.vreg, LType::I8, line, col))
    lower_and_const(Lowered { ctx = with_load; vreg = bl.vreg }, mask, line, col)
}

fn char_decode_two(ctx: LowerCtx, ptr: u32, b0m: u32, line: u32, col: u32): Lowered {
    var hi = lower_shl_const(lower_and_const(Lowered { ctx = ctx; vreg = b0m }, 0x1F, line, col), 6, line, col)
    var lo = char_load_masked(hi.ctx, ptr, 1, 0x3F, line, col)
    lower_or_vreg(lo.ctx, hi.vreg, lo.vreg, line, col)
}

fn char_decode_three(ctx: LowerCtx, ptr: u32, b0m: u32, line: u32, col: u32): Lowered {
    var hi = lower_shl_const(lower_and_const(Lowered { ctx = ctx; vreg = b0m }, 0x0F, line, col), 12, line, col)
    var mid = lower_shl_const(char_load_masked(hi.ctx, ptr, 1, 0x3F, line, col), 6, line, col)
    var lo = char_load_masked(mid.ctx, ptr, 2, 0x3F, line, col)
    var hm = lower_or_vreg(lo.ctx, hi.vreg, mid.vreg, line, col)
    lower_or_vreg(hm.ctx, hm.vreg, lo.vreg, line, col)
}

fn char_decode_four(ctx: LowerCtx, ptr: u32, b0m: u32, line: u32, col: u32): Lowered {
    var hi = lower_shl_const(lower_and_const(Lowered { ctx = ctx; vreg = b0m }, 0x07, line, col), 18, line, col)
    var c1 = lower_shl_const(char_load_masked(hi.ctx, ptr, 1, 0x3F, line, col), 12, line, col)
    var c2 = lower_shl_const(char_load_masked(c1.ctx, ptr, 2, 0x3F, line, col), 6, line, col)
    var c3 = char_load_masked(c2.ctx, ptr, 3, 0x3F, line, col)
    var o1 = lower_or_vreg(c3.ctx, hi.vreg, c1.vreg, line, col)
    var o2 = lower_or_vreg(o1.ctx, o1.vreg, c2.vreg, line, col)
    lower_or_vreg(o2.ctx, o2.vreg, c3.vreg, line, col)
}

type CharDecodeBlocks = struct {
    loadb0: u32
    multi: u32
    blk2: u32
    multi3: u32
    blk3: u32
    blk4: u32
    merge: u32
    result: u32
    func: LFunc
}

fn alloc_char_decode_blocks(f: LFunc): CharDecodeBlocks {
    var loadb0 = alloc_block(f)
    var multi = alloc_block(loadb0.func)
    var blk2 = alloc_block(multi.func)
    var multi3 = alloc_block(blk2.func)
    var blk3 = alloc_block(multi3.func)
    var blk4 = alloc_block(blk3.func)
    var mergeb = alloc_block(blk4.func)
    var mp = add_block_param(mergeb.func, mergeb.block_id)
    CharDecodeBlocks {
        loadb0 = loadb0.block_id; multi = multi.block_id; blk2 = blk2.block_id
        multi3 = multi3.block_id; blk3 = blk3.block_id; blk4 = blk4.block_id
        merge = mergeb.block_id; result = mp.vreg; func = mp.func
    }
}

fn lower_char_decode_cast(ctx: LowerCtx, e: checker::TExpr, c: checker::TCast): Lowered | error {
    var fat = match lower_fat_expr(ctx, c.expr) { LoweredFat as x => x; error as err => return err }
    var line = e.line
    var col = e.col
    var b = alloc_char_decode_blocks(fat.ctx.func)
    var entry = ctx_with(fat.ctx, b.func, fat.ctx.block_id, fat.ctx.env)
    var zero = lower_const_int(entry, 0, line, col)
    var is0 = lower_len_eq(zero.ctx, fat.len, 0, line, col)
    var entry_done = ctx_append(is0.ctx, branch_inst(is0.vreg, b.merge, [zero.vreg], b.loadb0, [], line, col))
    var l0 = char_load_masked(ctx_goto(entry_done, b.loadb0), fat.ptr, 0, 0xFF, line, col)
    var b0m = l0.vreg
    var m7f = lower_const_int(l0.ctx, 0x7F, line, col)
    var ascii = ctx_alloc(m7f.ctx)
    var with_cmp = ctx_append(ascii.ctx, bin_inst(ascii.vreg, LBinOp::ICmpLeU, b0m, m7f.vreg, line, col))
    var l0_done = ctx_append(with_cmp, branch_inst(ascii.vreg, b.merge, [b0m], b.multi, [], line, col))
    var is2 = lower_len_eq(ctx_goto(l0_done, b.multi), fat.len, 2, line, col)
    var multi_done = ctx_append(is2.ctx, branch_inst(is2.vreg, b.blk2, [], b.multi3, [], line, col))
    var v2 = char_decode_two(ctx_goto(multi_done, b.blk2), fat.ptr, b0m, line, col)
    var blk2_done = ctx_append(v2.ctx, jump_inst(b.merge, [v2.vreg], line, col))
    var is3 = lower_len_eq(ctx_goto(blk2_done, b.multi3), fat.len, 3, line, col)
    var multi3_done = ctx_append(is3.ctx, branch_inst(is3.vreg, b.blk3, [], b.blk4, [], line, col))
    var v3 = char_decode_three(ctx_goto(multi3_done, b.blk3), fat.ptr, b0m, line, col)
    var blk3_done = ctx_append(v3.ctx, jump_inst(b.merge, [v3.vreg], line, col))
    var v4 = char_decode_four(ctx_goto(blk3_done, b.blk4), fat.ptr, b0m, line, col)
    var blk4_done = ctx_append(v4.ctx, jump_inst(b.merge, [v4.vreg], line, col))
    Lowered { ctx = ctx_with(blk4_done, blk4_done.func, b.merge, entry.env); vreg = b.result }
}

fn is_int_to_narrow_float_cast(src: checker::PrimKind, dst: checker::PrimKind): bool {
    !prim_is_float_kind(src) && dst == checker::PrimKind::F32
}

fn lower_int_to_f32(ao: Lowered, e: checker::TExpr): Lowered {
    var wide = ctx_alloc(ao.ctx)
    var to_f64 = un_inst(wide.vreg, LUnOp::IToF, ao.vreg, e.line, e.col)
    narrow_float_to_f32(Lowered { ctx = ctx_append(wide.ctx, to_f64); vreg = wide.vreg }, e)
}

fn is_same_width_float_cast(src: checker::PrimKind, dst: checker::PrimKind): bool {
    prim_is_float_kind(src) && prim_is_float_kind(dst) && prim_width_of(src) == prim_width_of(dst)
}

fn is_u64_type(t: @Type()): bool {
    match t {
        checker::Prim as p => p.kind == checker::PrimKind::U64
        _ => false
    }
}

fn is_ptr_byte_type(t: @Type()): bool {
    match t {
        checker::Ptr => true
        _ => false
    }
}

fn is_u64_ptr_byte_reinterpret_cast(src: @Type(), dst: @Type()): bool {
    (is_u64_type(src) && is_ptr_byte_type(dst)) || (is_ptr_byte_type(src) && is_u64_type(dst))
}

fn prim_kind_of(t: @Type(), enums: []LEnumInfo, site: str = "expression"): checker::PrimKind | error {
    match t {
        checker::Prim as p => p.kind
        checker::Byte => checker::PrimKind::U8
        checker::Uptr => checker::PrimKind::U64
        checker::Named as n => enum_ordinal_kind_of(n, enums)
        _ => error { message = non_prim_stop(t, site) }
    }
}

fn non_prim_stop(t: @Type(), site: str): str {
    var msg = "native backend N1: `" ~ checker::type_render(t) ~ "` has no single PrimKind, asked by the " ~ site ~ " (N2)"
    teko::io::eprintln("teko: TRACE prim_kind_of stop: " ~ msg)
    msg
}

fn enum_ordinal_kind_of(n: checker::Named, enums: []LEnumInfo): checker::PrimKind | error {
    match find_enum_info(enums, n.name) {
        LEnumInfo => checker::PrimKind::I32
        null => error { message = "native backend N1: non-enum named-type (struct/class/flags) arithmetic operand not yet lowered (N2)" }
    }
}

fn cmp_lbinop_of(op: lexer::TokenKind, k: checker::PrimKind): LBinOp | error {
    if prim_is_float_kind(k) { return cmp_lbinop_float(op) }
    cmp_lbinop_int(op, prim_is_signed_int(k))
}

fn cmp_lbinop_float(op: lexer::TokenKind): LBinOp | error {
    match op {
        lexer::TokenKind::EqEq => LBinOp::FCmpEq
        lexer::TokenKind::Ne => LBinOp::FCmpNe
        lexer::TokenKind::Lt => LBinOp::FCmpLt
        lexer::TokenKind::Le => LBinOp::FCmpLe
        lexer::TokenKind::Gt => LBinOp::FCmpGt
        lexer::TokenKind::Ge => LBinOp::FCmpGe
        _ => error { message = "native backend N1: comparison operator not yet lowered (N2)" }
    }
}

fn cmp_lbinop_int(op: lexer::TokenKind, signed: bool): LBinOp | error {
    match op {
        lexer::TokenKind::EqEq => LBinOp::ICmpEq
        lexer::TokenKind::Ne => LBinOp::ICmpNe
        lexer::TokenKind::Lt => if signed { LBinOp::ICmpLtS } else { LBinOp::ICmpLtU }
        lexer::TokenKind::Le => if signed { LBinOp::ICmpLeS } else { LBinOp::ICmpLeU }
        lexer::TokenKind::Gt => if signed { LBinOp::ICmpGtS } else { LBinOp::ICmpGtU }
        lexer::TokenKind::Ge => if signed { LBinOp::ICmpGeS } else { LBinOp::ICmpGeU }
        _ => error { message = "native backend N1: comparison operator not yet lowered (N2)" }
    }
}

pub type CmpChain = struct { ctx: LowerCtx; bools: []u32 }

fn lower_compare_terms(ctx: LowerCtx, e: checker::TExpr, prev_type: @Type(), prev_vreg: u32, rest: []checker::TCmpTerm): CmpChain | error {
    var cur = ctx
    var pv = prev_vreg
    var pt = prev_type
    var bools: [rest.len]u32 = []
    var i: u64 = 0
    loop {
        if i >= rest.len { break }
        var term = rest[i]
        var ro = match lower_expr(cur, term.operand) { Lowered as x => x; error as err => return err }
        var k = match prim_kind_of(pt, ctx.enums, "comparison chain") { checker::PrimKind as p => p; error as err => return err }
        var op = match cmp_lbinop_of(term.op, k) { LBinOp as o => o; error as err => return err }
        var r = ctx_alloc(ro.ctx)
        cur = ctx_append(r.ctx, bin_inst(r.vreg, op, pv, ro.vreg, e.line, e.col))
        bools[i] = r.vreg
        pv = ro.vreg
        pt = term.operand.type
        i++
    }
    CmpChain { ctx = cur; bools = bools }
}

fn lower_bool_and(ctx: LowerCtx, a_vreg: u32, b_vreg: u32, line: u32, col: u32): Lowered {
    var thenb = alloc_block(ctx.func)
    var elseb = alloc_block(thenb.func)
    var mergeb = alloc_block(elseb.func)
    var mp = add_block_param(mergeb.func, mergeb.block_id)
    var br = branch_inst(a_vreg, thenb.block_id, [], elseb.block_id, [], line, col)
    var after_br = append_inst(mp.func, ctx.block_id, br)
    var then_args = [b_vreg]
    var after_then = append_inst(after_br, thenb.block_id, jump_inst(mergeb.block_id, then_args, line, col))
    var zc = alloc_vreg(after_then)
    var with_zero = append_inst(zc.func, elseb.block_id, const_int_inst(zc.vreg, 0, line, col))
    var else_args = [zc.vreg]
    var after_else = append_inst(with_zero, elseb.block_id, jump_inst(mergeb.block_id, else_args, line, col))
    Lowered { ctx = ctx_with(ctx, after_else, mergeb.block_id, ctx.env); vreg = mp.vreg }
}

fn is_str_type(t: @Type()): bool {
    match t {
        checker::Named as nm => nm.name == "teko::base::str"
        _ => false
    }
}

fn is_char_type(t: @Type()): bool {
    match t {
        checker::Char => true
        _ => false
    }
}

fn lower_str_compare(ctx: LowerCtx, e: checker::TExpr, cmp: checker::TCompare): Lowered | error {
    if cmp.rest.len != 1 { return error { message = "native backend N1: a CHAINED `str` comparison (`a == b == c`) is not lowered (N2)" } }
    var pred = match runtime_eq_predicate(cmp.rest[0].op, "str") { LBinOp as p => p; error as err => return err }
    var a = match lower_fat_expr(ctx, cmp.first) { LoweredFat as x => x; error as err => return err }
    var b = match lower_fat_expr(a.ctx, cmp.rest[0].operand) { LoweredFat as x => x; error as err => return err }
    var args = fat_eq_call_args(a, b)
    var called = ctx_alloc(b.ctx)
    var with_call = ctx_append(called.ctx, call_inst(called.vreg, "tk_str_eq", args, false, e.line, e.col))
    var clean = runtime_eq_narrow(Lowered { ctx = with_call; vreg = called.vreg }, e.line, e.col)
    var zero = ctx_alloc(clean.ctx)
    var with_zero = ctx_append(zero.ctx, const_int_inst(zero.vreg, 0, e.line, e.col))
    var r = ctx_alloc(with_zero)
    Lowered { ctx = ctx_append(r.ctx, bin_inst(r.vreg, pred, clean.vreg, zero.vreg, e.line, e.col)); vreg = r.vreg }
}

pub type LSliceEqPlan = struct {
    rtfn: str
    needs_size: bool
}

fn slice_elem_of(t: @Type()): @Type() {
    match t { checker::Slice as sl => sl.element; _ => checker::Void { } }
}

fn slice_eq_plan(elem: @Type()): LSliceEqPlan | error {
    if is_str_type(elem) { return LSliceEqPlan { rtfn = "tk_slice_str_eq"; needs_size = false } }
    match elem {
        checker::Char => LSliceEqPlan { rtfn = "tk_slice_eq_bytes"; needs_size = true }
        checker::Byte => LSliceEqPlan { rtfn = "tk_slice_eq_bytes"; needs_size = true }
        checker::Prim as p => slice_eq_plan_prim(p.kind)
        _ => error { message = teko::str::concat("native backend N1: `[]T == []T` is not lowered yet for element type `", checker::type_render(elem), "` (N2 — only numeric/bool/byte/char/str elements compare by value)") }
    }
}

fn slice_eq_plan_prim(k: checker::PrimKind): LSliceEqPlan {
    if k == checker::PrimKind::F32 { return LSliceEqPlan { rtfn = "tk_slice_f32_eq"; needs_size = false } }
    if k == checker::PrimKind::F64 { return LSliceEqPlan { rtfn = "tk_slice_f64_eq"; needs_size = false } }
    LSliceEqPlan { rtfn = "tk_slice_eq_bytes"; needs_size = true }
}

pub type SliceEqArgs = struct { ctx: LowerCtx; args: []u32 }

fn slice_eq_call_args(ctx: LowerCtx, a: LoweredFat, b: LoweredFat, elem: @Type(), plan: LSliceEqPlan, enums: []LEnumInfo, line: u32, col: u32): SliceEqArgs {
    var args: []u32 = [
        a.ptr, a.len, b.ptr, b.len
    ]
    if !plan.needs_size { return SliceEqArgs { ctx = ctx; args = args } }
    var esz = elem_byte_stride(elem, enums) to i64
    var r = ctx_alloc(ctx)
    var with_c = ctx_append(r.ctx, const_int_inst(r.vreg, esz, line, col))
    SliceEqArgs { ctx = with_c; args = [..args, r.vreg] }
}

fn lower_slice_compare(ctx: LowerCtx, e: checker::TExpr, cmp: checker::TCompare): Lowered | error {
    if cmp.rest.len != 1 { return error { message = "native backend N1: a CHAINED `[]T` comparison (`a == b == c`) is not lowered (N2)" } }
    var pred = match runtime_eq_predicate(cmp.rest[0].op, "[]T") { LBinOp as p => p; error as err => return err }
    var elem = slice_elem_of(cmp.first.type)
    var plan = match slice_eq_plan(elem) { LSliceEqPlan as p => p; error as err => return err }
    var a = match lower_fat_expr(ctx, cmp.first) { LoweredFat as x => x; error as err => return err }
    var b = match lower_fat_expr(a.ctx, cmp.rest[0].operand) { LoweredFat as x => x; error as err => return err }
    var built = slice_eq_call_args(b.ctx, a, b, elem, plan, ctx.enums, e.line, e.col)
    var called = ctx_alloc(built.ctx)
    var with_call = ctx_append(called.ctx, call_inst(called.vreg, plan.rtfn, built.args, false, e.line, e.col))
    var clean = runtime_eq_narrow(Lowered { ctx = with_call; vreg = called.vreg }, e.line, e.col)
    var zero = ctx_alloc(clean.ctx)
    var with_zero = ctx_append(zero.ctx, const_int_inst(zero.vreg, 0, e.line, e.col))
    var r = ctx_alloc(with_zero)
    Lowered { ctx = ctx_append(r.ctx, bin_inst(r.vreg, pred, clean.vreg, zero.vreg, e.line, e.col)); vreg = r.vreg }
}

fn runtime_eq_narrow(called: Lowered, line: u32, col: u32): Lowered {
    narrow_extern_return(called, ExternNarrow { width = 8; is_signed = false }, line, col)
}

fn runtime_eq_predicate(op: lexer::TokenKind, shape: str): LBinOp | error {
    match op {
        lexer::TokenKind::EqEq => LBinOp::ICmpNe
        lexer::TokenKind::Ne => LBinOp::ICmpEq
        _ => error { message = teko::str::concat("native backend N1: an ORDERED `", shape, "` comparison (`<`/`<=`/`>`/`>=`) is not lowered (N2)") }
    }
}

fn fat_eq_call_args(a: LoweredFat, b: LoweredFat): []u32 {
    [a.ptr, a.len, b.ptr, b.len]
}

fn variant_type_of(t: @Type(), variants: []LVariantDef): checker::Variant | null {
    match expand_named_variant(t, variants) {
        checker::Variant as v => v
        _ => null
    }
}

fn variant_cmp_member_matches(member: @Type(), ty: @Type(), variants: []LVariantDef): bool {
    match member {
        checker::Null => match ty { checker::Null => true; _ => false }
        _ => variant_member_type_matches(member, ty, variants)
    }
}

fn variant_index_of_member_type(members: []@Type(), member_ty: @Type(), variants: []LVariantDef): u32 | error {
    var i: u64 = 0
    loop {
        if i >= members.len { break }
        if variant_cmp_member_matches(members[i], member_ty, variants) { return i to u32 }
        i++
    }
    error { message = "native backend N1: comparison member's type is not a member of its variant (internal)" }
}

fn variant_cmp_payload_comparable(t: @Type()): bool {
    match t {
        checker::Prim as p => p.kind != checker::PrimKind::Bool
        checker::Byte => true
        _ => false
    }
}

fn lower_variant_payload_eq(ctx: LowerCtx, base_vreg: u32, member_expr: checker::TExpr, tag_eq: u32, line: u32, col: u32): Lowered | error {
    if !variant_cmp_payload_comparable(member_expr.type) {
        return error { message = "native backend N1: comparing a tagged union to a non-null, non-numeric member is not yet lowered (N2)" }
    }
    var lty = ltype_of(member_expr.type, ctx.enums)
    var addr = ctx_alloc(ctx)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base_vreg, variant_payload_offset(), line, col))
    var pr = ctx_alloc(with_addr)
    var with_load = ctx_append(pr.ctx, load_inst(pr.vreg, addr.vreg, lty, line, col))
    var mo = match lower_expr(with_load, member_expr) { Lowered as x => x; error as err => return err }
    var k = match prim_kind_of(member_expr.type, ctx.enums, "variant member comparison") { checker::PrimKind as p => p; error as err => return err }
    var op = match cmp_lbinop_of(lexer::TokenKind::EqEq, k) { LBinOp as o => o; error as err => return err }
    var r = ctx_alloc(mo.ctx)
    var with_cmp = ctx_append(r.ctx, bin_inst(r.vreg, op, pr.vreg, mo.vreg, line, col))
    lower_bool_and(with_cmp, tag_eq, r.vreg, line, col)
}

fn lower_variant_member_cmp(ctx: LowerCtx, e: checker::TExpr, variant_ty: checker::Variant, subj_expr: checker::TExpr, member_expr: checker::TExpr, eq: bool): Lowered | error {
    var subj = match lower_expr(ctx, subj_expr) { Lowered as x => x; error as err => return err }
    var index = match variant_index_of_member_type(variant_ty.members, member_expr.type, ctx.variants) { u32 as i => i; error as err => return err }
    var msubj = MatchSubj { ty = variant_ty; vreg = subj.vreg; is_fat = false; len = 0 }
    var tag_test = lower_variant_tag_eq_test(subj.ctx, msubj, index to i64, e.line, e.col)
    var is_null_member = match member_expr.type { checker::Null => true; _ => false }
    var eq_result = if is_null_member {
        Lowered { ctx = tag_test.ctx; vreg = tag_test.vreg }
    } else {
        match lower_variant_payload_eq(tag_test.ctx, subj.vreg, member_expr, tag_test.vreg, e.line, e.col) { Lowered as x => x; error as err => return err }
    }
    if eq { return eq_result }
    lower_logical_not(eq_result, e.line, e.col)
}

fn lower_variant_member_compare_dispatch(ctx: LowerCtx, e: checker::TExpr, cmp: checker::TCompare): Lowered | null | error {
    if cmp.rest.len != 1 { return null }
    var op = cmp.rest[0].op
    if op != lexer::TokenKind::EqEq && op != lexer::TokenKind::Ne { return null }
    var opnd = cmp.rest[0].operand
    var eq = op == lexer::TokenKind::EqEq
    var first_v = variant_type_of(cmp.first.type, ctx.variants)
    var opnd_v = variant_type_of(opnd.type, ctx.variants)
    match first_v {
        checker::Variant as v => {
            match opnd_v { checker::Variant => return null; null => { } }
            match lower_variant_member_cmp(ctx, e, v, cmp.first, opnd, eq) { Lowered as r => return r; error as err => return err }
        }
        null => { }
    }
    match opnd_v {
        checker::Variant as v => match lower_variant_member_cmp(ctx, e, v, opnd, cmp.first, eq) { Lowered as r => return r; error as err => return err }
        null => null
    }
}

fn lower_compare(ctx: LowerCtx, e: checker::TExpr, cmp: checker::TCompare): Lowered | error {
    if cmp.rest.len > 0 && is_str_type(cmp.first.type) { return lower_str_compare(ctx, e, cmp) }
    if cmp.rest.len > 0 && is_char_type(cmp.first.type) { return lower_str_compare(ctx, e, cmp) }
    if cmp.rest.len > 0 && is_fat_type(cmp.first.type) { return lower_slice_compare(ctx, e, cmp) }
    match lower_variant_member_compare_dispatch(ctx, e, cmp) {
        Lowered as r => return r
        error as err => return err
        null => { }
    }
    var lo = match lower_expr(ctx, cmp.first) { Lowered as x => x; error as err => return err }
    if cmp.rest.len == 0 { return Lowered { ctx = lo.ctx; vreg = lo.vreg } }
    var chain = match lower_compare_terms(lo.ctx, e, cmp.first.type, lo.vreg, cmp.rest) { CmpChain as c => c; error as err => return err }
    var cur = chain.ctx
    var acc = chain.bools[0]
    var i: u64 = 1
    loop {
        if i >= chain.bools.len { break }
        var merged = lower_bool_and(cur, acc, chain.bools[i], e.line, e.col)
        cur = merged.ctx
        acc = merged.vreg
        i++
    }
    Lowered { ctx = cur; vreg = acc }
}

fn is_capture_panic_call(callee: parser::Path): bool {
    var segs = callee.segments
    if segs.len == 0 { return false }
    if segs[segs.len - 1].name != "capture_panic" { return false }
    segs.len == 1 || segs[0].name == "teko"
}

fn lower_capture_frame(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    error { message = "native backend N1: `capture` frame graceful-stop (arm the per-task capture slot, invoke the body, then `if panicking() { take_panic } else { null }`, mirrored by a per-call `if panicking() { run frame defers/drops; return sentinel }` guard) not yet lowered (N2) — the C route emits this control flow directly; the native mirror is the same flag test + cleanup + return, no unwind primitive" }
}

fn type_abi_bytes(t: @Type(), ctx: LowerCtx): u32 {
    if is_fat_type(t) { return fat_slot_bytes() }
    if is_register_value_type(t, ctx.enums) { return ltype_size(ltype_of(t, ctx.enums)) }
    match aggregate_box_bytes(t, ctx) { u32 as n => n; null => ltype_size(ltype_of(t, ctx.enums)) }
}

fn type_abi_align(t: @Type(), ctx: LowerCtx): u32 {
    if is_fat_type(t) { return ltype_align(LType::Ptr) }
    if is_register_value_type(t, ctx.enums) { return ltype_align(ltype_of(t, ctx.enums)) }
    match aggregate_box_align(t, ctx) { u32 as a => a; null => ltype_align(ltype_of(t, ctx.enums)) }
}

fn lower_sizeof_intrinsic(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.type_args.len != 1 { return error { message = "native: sizeof expects one type argument" } }
    var r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, const_int_inst(r.vreg, type_abi_bytes(c.type_args[0], ctx) to i64, e.line, e.col)); vreg = r.vreg }
}

fn lower_alignof_intrinsic(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.type_args.len != 1 { return error { message = "native: alignof expects one type argument" } }
    var r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, const_int_inst(r.vreg, type_abi_align(c.type_args[0], ctx) to i64, e.line, e.col)); vreg = r.vreg }
}

fn lower_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.is_closure_call { return lower_closure_call(ctx, e, c) }
    if c.is_iface_dispatch { return lower_iface_call(ctx, e, c) }
    if c.call_ns == "teko::__sizeof" { return lower_sizeof_intrinsic(ctx, e, c) }
    if c.call_ns == "teko::__alignof" { return lower_alignof_intrinsic(ctx, e, c) }
    if c.call_ns.len == 0 && is_capture_panic_call(c.callee) { return lower_capture_frame(ctx, e, c) }
    if is_fat_type(e.type) { return lower_call_fat_as_scalar(ctx, e, c) }
    if c.call_ns.len == 0 && is_last_index_of_call(c.callee) { return lower_last_index_of_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_str_from_utf8_call(c.callee) { return lower_str_from_utf8_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_err_loc_call(c.callee) { return lower_err_loc_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_err_typed_call(c.callee) { return lower_err_typed_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_f64_bitcast_call(c.callee) { return lower_f64_bitcast_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_float_parse_call(c.callee) { return lower_float_parse_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_buf_ptr_call(c.callee) { return lower_buf_ptr_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_load_u64_call(c.callee) { return lower_load_u64_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_store_u64_call(c.callee) { return lower_store_u64_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_load_u8_call(c.callee) { return lower_load_u8_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_store_u8_call(c.callee) { return lower_store_u8_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_syscall_call(c.callee) { return lower_syscall_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_atomic_rmw_call(c.callee) { return lower_atomic_rmw_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_capture_longjmp_call(c.callee) { return lower_capture_longjmp_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_word_reinterpret_call(c.callee) { return lower_word_reinterpret_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_byte_ptr_call(c.callee) { return lower_byte_ptr_call(ctx, e, c) }
    if c.call_ns.len == 0 && is_as_cstr_call(c.callee) { return lower_as_cstr_call(ctx, e, c) }
    var sym = match call_symbol(c, ctx.externs, ctx.flat_symbols) { str as s => s; error as err => return err }
    if is_ffi_aggregate_return_symbol(sym) { return lower_ffi_aggregate_return_call(ctx, e, c, sym) }
    if is_str_arg_builtin(sym) { return lower_str_arg_call(ctx, e, sym, c) }
    var lo = match lower_call_args(ctx, c) { LoweredArgs as x => x; error as err => return err }
    var called = match lower_call_symbol(lo.ctx, e, sym, lo.vregs) { Lowered as x => x; error as err => return err }
    apply_native_c_return_narrow(called, ctx.externs, c, e)
}

pub type LRefFnInfo = struct { ns: str; name: str; ref_flags: []bool }

fn is_ref_param_ann(te: @TypeExpr()): bool {
    match named_type_name_of(te) { str as n => n == "Ref"; null => false }
}

fn fn_ref_flags(params: []parser::Param): []bool {
    var out: [params.len]bool = []
    var i: u64 = 0
    loop {
        if i >= params.len { break }
        out[i] = is_ref_param_ann(params[i].type_ann)
        i++
    }
    out
}

fn fn_has_ref_param(rf: []bool): bool {
    var i: u64 = 0
    loop {
        if i >= rf.len { break }
        if rf[i] { return true }
        i++
    }
    false
}

fn collect_ref_fns(prog: checker::TProgram): []LRefFnInfo {
    var out: [prog.items.len]LRefFnInfo = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                var rf = fn_ref_flags(f.params)
                if fn_has_ref_param(rf) {
                    out[count] = LRefFnInfo { ns = f.namespace; name = f.name; ref_flags = rf }
                    count++
                }
            }
            _ => { }
        }
        i++
    }
    out[0..count]
}

fn find_ref_flags(ref_fns: []LRefFnInfo, ns: str, name: str): []bool | null {
    var i: u64 = 0
    loop {
        if i >= ref_fns.len { break }
        if ref_fns[i].ns == ns && ref_fns[i].name == name { return ref_fns[i].ref_flags }
        i++
    }
    null
}

fn arg_needs_auto_ref(arg: checker::TExpr): bool {
    match arg.type { checker::Reference => false; _ => true }
}

fn lower_call_args(ctx: LowerCtx, c: checker::TCall): LoweredArgs | error {
    var params = callee_param_types(c)
    if c.callee.segments.len == 0 { return lower_args(ctx, c.args, params) }
    var last = c.callee.segments[c.callee.segments.len - 1].name
    match find_ref_flags(ctx.ref_fns, c.call_ns, last) {
        []bool as rf => lower_args_ref_aware(ctx, c.args, rf, params, 0)
        null => lower_args(ctx, c.args, params)
    }
}

fn callee_param_types(c: checker::TCall): []@Type() {
    match c.callee_type {
        checker::Func as f => if f.variadic { [] } else { f.params }
        _ => []
    }
}

fn param_type_at(params: []@Type(), i: u64): @Type() | null {
    if i >= params.len { return null }
    params[i]
}

fn lower_arg_into_param(ctx: LowerCtx, decl: @Type() | null, arg: checker::TExpr): LoweredArgs | error {
    match union_field_placement(ctx, decl) {
        (@Type()) as bound => {
            var lo = match lower_value_into_type(ctx, bound, arg) { Lowered as x => x; error as err => return err }
            LoweredArgs { ctx = lo.ctx; vregs = single_arg(lo.vreg) }
        }
        null => lower_fat_arg_into_param(ctx, decl, arg)
    }
}

fn lower_fat_arg_into_param(ctx: LowerCtx, decl: @Type() | null, arg: checker::TExpr): LoweredArgs | error {
    if !is_fat_type(arg.type) { return lower_arg_vregs(ctx, arg) }
    match decl {
        (@Type()) as d => {
            var fo = match lower_fat_expr_into_type(ctx, d, arg) { LoweredFat as x => x; error as err => return err }
            LoweredArgs { ctx = fo.ctx; vregs = two_args(fo.ptr, fo.len) }
        }
        null => lower_arg_vregs(ctx, arg)
    }
}

fn lower_args_ref_aware(ctx: LowerCtx, args: []checker::TExpr, rf: []bool, params: []@Type(), i: u64): LoweredArgs | error {
    if i >= args.len { return LoweredArgs { ctx = ctx; vregs = [] } }
    var is_ref_pos = i < rf.len && rf[i] && arg_needs_auto_ref(args[i])
    var one = match if is_ref_pos { lower_addr_of_arg(ctx, args[i]) } else { lower_arg_into_param(ctx, param_type_at(params, i), args[i]) } { LoweredArgs as x => x; error as err => return err }
    var rest = match lower_args_ref_aware(one.ctx, args, rf, params, i + 1) { LoweredArgs as x => x; error as err => return err }
    LoweredArgs { ctx = rest.ctx; vregs = append_vregs(one.vregs, rest.vregs) }
}

fn lower_addr_of_arg(ctx: LowerCtx, arg: checker::TExpr): LoweredArgs | error {
    var lo = match lower_addr_of_place(ctx, arg) { Lowered as x => x; error as err => return err }
    LoweredArgs { ctx = lo.ctx; vregs = single_arg(lo.vreg) }
}

fn lower_addr_of_place(ctx: LowerCtx, place: checker::TExpr): Lowered | error {
    var v = match place.kind { checker::TVar as vv => vv; _ => return error { message = "native backend N1: an address-of place must be a bound local (internal)" } }
    if is_fat_type(place.type) {
        var fslot = lenv_lookup_fat_slot(ctx.env, v.name)
        if !fslot.found { return error { message = teko::str::concat("native backend N1: `", teko::str::concat(v.name, "` is a fat `ref` target but is not a mutable fat local (internal)")) } }
        return Lowered { ctx = ctx; vreg = fslot.slot }
    }
    if !is_register_value_type(place.type, ctx.enums) { return lower_expr(ctx, place) }
    var slot = lenv_lookup_scalar_slot(ctx.env, v.name)
    if !slot.found { return error { message = teko::str::concat("native backend N1: `", teko::str::concat(v.name, "` is address-taken but was not reified to a slot (internal)")) } }
    Lowered { ctx = ctx; vreg = slot.slot }
}

fn lower_call_fat_as_scalar(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    var fo = match lower_call_fat(ctx, e, c) { LoweredFat as x => x; error as err => return err }
    Lowered { ctx = fo.ctx; vreg = fo.ptr }
}

fn is_last_index_of_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "last_index_of"
}

fn last_index_of_variant_members(e: checker::TExpr): []@Type() | error {
    match e.type {
        checker::Variant as v => v.members
        _ => error { message = "native backend N1: `last_index_of`'s result is not a variant (internal)" }
    }
}

fn lower_last_index_of_ok_arm(ctx: LowerCtx, wrapper: u32, index: i64, value: u32, line: u32, col: u32): LowerCtx {
    var tagged = store_variant_tag(ctx, wrapper, index, line, col)
    var addr = ctx_alloc(tagged.ctx)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, wrapper, variant_payload_offset(), line, col))
    ctx_append(with_addr, store_inst(addr.vreg, value, LType::I64, line, col))
}

fn lower_last_index_of_error_arm(ctx: LowerCtx, wrapper: u32, index: i64, e: checker::TExpr): LowerCtx | error {
    var tagged = store_variant_tag(ctx, wrapper, index, e.line, e.col)
    var layout = error_struct_layout()
    var slot = ctx_alloc(tagged.ctx)
    var with_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, layout.size, layout.align, e.line, e.col))
    var zero_ptr = ctx_alloc(with_alloca)
    var with_zero_ptr = ctx_append(zero_ptr.ctx, const_int_inst(zero_ptr.vreg, 0, e.line, e.col))
    var zero_len = ctx_alloc(with_zero_ptr)
    var with_zero_len = ctx_append(zero_len.ctx, const_int_inst(zero_len.vreg, 0, e.line, e.col))
    var empty_msg = LoweredFat { ctx = with_zero_len; ptr = zero_ptr.vreg; len = zero_len.vreg }
    var with_msg = store_fat_slot(empty_msg.ctx, slot.vreg, empty_msg, e.line, e.col)
    var with_zeroed = zero_error_diagnostics(with_msg, slot.vreg, layout, 1, e.line, e.col)
    var box_bytes = match variant_payload_box_bytes(checker::Error { }, with_zeroed) { u32 as n => n; error as err => return err }
    var owned = box_aggregate_value(Lowered { ctx = with_zeroed; vreg = slot.vreg }, box_bytes, e)
    var paddr = ctx_alloc(owned.ctx)
    var with_paddr = ctx_append(paddr.ctx, field_addr_inst(paddr.vreg, wrapper, variant_payload_offset(), e.line, e.col))
    ctx_append(with_paddr, store_inst(paddr.vreg, owned.vreg, LType::Ptr, e.line, e.col))
}

fn lower_last_index_of_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 2 {
        return error { message = "native backend N1: `last_index_of` expects exactly two str arguments (internal)" }
    }
    var members = match last_index_of_variant_members(e) { []@Type() as m => m; error as err => return err }
    var ok_index = match variant_member_index_of(members, checker::Prim { kind = checker::PrimKind::U64 }, ctx.variants) { u32 as x => x; error as err => return err }
    var err_index = match variant_member_index_of(members, checker::Error { }, ctx.variants) { u32 as x => x; error as err => return err }
    var hay = match lower_fat_expr(ctx, c.args[0]) { LoweredFat as x => x; error as err => return err }
    var needle = match lower_fat_expr(hay.ctx, c.args[1]) { LoweredFat as x => x; error as err => return err }
    var slot = ctx_alloc(needle.ctx)
    var with_slot = ctx_append(slot.ctx, alloca_inst(slot.vreg, ltype_size(LType::I64), ltype_align(LType::I64), e.line, e.col))
    var call_args = [..four_args(hay.ptr, hay.len, needle.ptr, needle.len), slot.vreg]
    var called = ctx_alloc(with_slot)
    var with_call = ctx_append(called.ctx, call_inst(called.vreg, "tk_rt_last_index_of_ok", call_args, false, e.line, e.col))
    var ok = narrow_extern_return(Lowered { ctx = with_call; vreg = called.vreg }, ExternNarrow { width = 8; is_signed = false }, e.line, e.col)
    var thenb = alloc_block(ok.ctx.func)
    var elseb = alloc_block(thenb.func)
    var mergeb = alloc_block(elseb.func)
    var mp = add_block_param(mergeb.func, mergeb.block_id)
    var br = branch_inst(ok.vreg, thenb.block_id, [], elseb.block_id, [], e.line, e.col)
    var ctx1 = ctx_append(ctx_with(ok.ctx, mp.func, ok.ctx.block_id, ok.ctx.env), br)
    var then_ctx = ctx_goto(ctx1, thenb.block_id)
    var loaded = ctx_alloc(then_ctx)
    var with_load = ctx_append(loaded.ctx, load_inst(loaded.vreg, slot.vreg, LType::I64, e.line, e.col))
    var then_base = ctx_alloc(with_load)
    var then_alloca = ctx_append(then_base.ctx, alloca_inst(then_base.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    var then_built = lower_last_index_of_ok_arm(then_alloca, then_base.vreg, ok_index to i64, loaded.vreg, e.line, e.col)
    var then_func = close_arm_to(then_built, mergeb.block_id, [then_base.vreg], e.line, e.col)
    var else_ctx = ctx_with(ctx1, then_func, elseb.block_id, ctx1.env)
    var err_base = ctx_alloc(else_ctx)
    var err_alloca = ctx_append(err_base.ctx, alloca_inst(err_base.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    var else_built = match lower_last_index_of_error_arm(err_alloca, err_base.vreg, err_index to i64, e) { LowerCtx as x => x; error as err2 => return err2 }
    var else_func = close_arm_to(else_built, mergeb.block_id, [err_base.vreg], e.line, e.col)
    Lowered { ctx = ctx_with(ctx1, else_func, mergeb.block_id, ctx1.env); vreg = mp.vreg }
}

fn is_str_from_utf8_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "str_from_utf8"
}

fn ffi_result_variant_members(e: checker::TExpr): []@Type() | error {
    match e.type {
        checker::Variant as v => v.members
        _ => error { message = "native backend N1: a host-FFI call's result is not a variant (internal)" }
    }
}

fn load_ptr_len_out_slots(ctx: LowerCtx, ptr_slot: u32, len_slot: u32, line: u32, col: u32): LoweredFat {
    var pr = ctx_alloc(ctx)
    var with_pr = ctx_append(pr.ctx, load_inst(pr.vreg, ptr_slot, LType::Ptr, line, col))
    var lr = ctx_alloc(with_pr)
    var with_lr = ctx_append(lr.ctx, load_inst(lr.vreg, len_slot, LType::I64, line, col))
    LoweredFat { ctx = with_lr; ptr = pr.vreg; len = lr.vreg }
}

fn lower_ffi_fat_ok_arm(ctx: LowerCtx, wrapper: u32, index: i64, ptr: u32, len: u32, line: u32, col: u32): LowerCtx {
    var tagged = store_variant_tag(ctx, wrapper, index, line, col)
    store_fat_variant_payload_pair(tagged.ctx, wrapper, ptr, len, line, col)
}

fn lower_ffi_error_arm(ctx: LowerCtx, wrapper: u32, index: i64, msg_ptr: u32, msg_len: u32, e: checker::TExpr): LowerCtx | error {
    var tagged = store_variant_tag(ctx, wrapper, index, e.line, e.col)
    var layout = error_struct_layout()
    var slot = ctx_alloc(tagged.ctx)
    var with_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, layout.size, layout.align, e.line, e.col))
    var msg = LoweredFat { ctx = with_alloca; ptr = msg_ptr; len = msg_len }
    var with_msg = store_fat_slot(with_alloca, slot.vreg, msg, e.line, e.col)
    var with_zeroed = zero_error_diagnostics(with_msg, slot.vreg, layout, 1, e.line, e.col)
    var box_bytes = match variant_payload_box_bytes(checker::Error { }, with_zeroed) { u32 as n => n; error as err => return err }
    var owned = box_aggregate_value(Lowered { ctx = with_zeroed; vreg = slot.vreg }, box_bytes, e)
    var paddr = ctx_alloc(owned.ctx)
    var with_paddr = ctx_append(paddr.ctx, field_addr_inst(paddr.vreg, wrapper, variant_payload_offset(), e.line, e.col))
    ctx_append(with_paddr, store_inst(paddr.vreg, owned.vreg, LType::Ptr, e.line, e.col))
}

fn lower_str_from_utf8_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 1 {
        return error { message = "native backend N1: `str_from_utf8` expects exactly one []byte argument (internal)" }
    }
    lower_ffi_fat_or_error_call(ctx, e, c, "tk_rt_str_from_utf8_ok", checker::Named { name = "teko::base::str" })
}

fn is_ffi_aggregate_return_symbol(sym: str): bool {
    sym == "tk_rt_getenv" || sym == "tk_rt_getcwd" || sym == "tk_rt_read_file" ||
    sym == "tk_rt_list_dir" || sym == "tk_rt_setenv" || sym == "tk_rt_chdir" ||
    sym == "tk_rt_mkdir" || sym == "tk_rt_remove_file" || sym == "tk_rt_write_file" ||
    sym == "tk_rt_write_file_bytes"
}

fn lower_ffi_aggregate_return_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall, sym: str): Lowered | error {
    if sym == "tk_rt_getenv" { return lower_ffi_fat_or_error_call(ctx, e, c, "tk_rt_getenv_ok", checker::Named { name = "teko::base::str" }) }
    if sym == "tk_rt_getcwd" { return lower_ffi_fat_or_error_call(ctx, e, c, "tk_rt_getcwd_ok", checker::Named { name = "teko::base::str" }) }
    if sym == "tk_rt_list_dir" { return lower_ffi_fat_or_error_call(ctx, e, c, "tk_rt_list_dir_ok", checker::Slice { element = checker::Named { name = "teko::base::str" } }) }
    if sym == "tk_rt_setenv" { return lower_ffi_ures_call(ctx, e, c, "tk_rt_setenv_ok") }
    if sym == "tk_rt_chdir" { return lower_ffi_ures_call(ctx, e, c, "tk_rt_chdir_ok") }
    if sym == "tk_rt_mkdir" { return lower_ffi_ures_call(ctx, e, c, "tk_rt_mkdir_ok") }
    if sym == "tk_rt_remove_file" { return lower_ffi_ures_call(ctx, e, c, "tk_rt_remove_file_ok") }
    error { message = "native backend N1: unroutable aggregate-return host symbol (internal)" }
}

type FfiArgs = struct {
    ctx: LowerCtx
    vregs: []u32
}

fn lower_ffi_fat_args(ctx: LowerCtx, c: checker::TCall): FfiArgs | error {
    var cur = ctx
    var vregs: [c.args.len * 2]u32 = []
    var i: u64 = 0
    loop {
        if i >= c.args.len { break }
        var f = match lower_fat_expr(cur, c.args[i]) { LoweredFat as x => x; error as err => return err }
        cur = f.ctx
        vregs[i * 2] = f.ptr
        vregs[i * 2 + 1] = f.len
        i++
    }
    FfiArgs { ctx = cur; vregs = vregs }
}

type FfiOutSlots = struct {
    ok: Lowered
    out_ptr: u32
    out_len: u32
}

fn lower_ffi_twin_call(ctx: LowerCtx, c: checker::TCall, symbol: str, line: u32, col: u32): FfiOutSlots | error {
    var lo = match lower_ffi_fat_args(ctx, c) { FfiArgs as x => x; error as err => return err }
    var out_ptr = ctx_alloc(lo.ctx)
    var with_out_ptr = ctx_append(out_ptr.ctx, alloca_inst(out_ptr.vreg, ltype_size(LType::Ptr), ltype_align(LType::Ptr), line, col))
    var out_len = ctx_alloc(with_out_ptr)
    var with_out_len = ctx_append(out_len.ctx, alloca_inst(out_len.vreg, ltype_size(LType::I64), ltype_align(LType::I64), line, col))
    var call_args = [..lo.vregs, out_ptr.vreg, out_len.vreg]
    var called = ctx_alloc(with_out_len)
    var with_call = ctx_append(called.ctx, call_inst(called.vreg, symbol, call_args, false, line, col))
    var ok = narrow_extern_return(Lowered { ctx = with_call; vreg = called.vreg }, ExternNarrow { width = 8; is_signed = false }, line, col)
    FfiOutSlots { ok = ok; out_ptr = out_ptr.vreg; out_len = out_len.vreg }
}

type FfiBranch = struct {
    ctx1: LowerCtx
    thenb: u32
    elseb: u32
    mergeb: u32
    merge_param: u32
}

fn lower_ffi_open_branch(ok: Lowered, line: u32, col: u32): FfiBranch {
    var thenb = alloc_block(ok.ctx.func)
    var elseb = alloc_block(thenb.func)
    var mergeb = alloc_block(elseb.func)
    var mp = add_block_param(mergeb.func, mergeb.block_id)
    var br = branch_inst(ok.vreg, thenb.block_id, [], elseb.block_id, [], line, col)
    var ctx1 = ctx_append(ctx_with(ok.ctx, mp.func, ok.ctx.block_id, ok.ctx.env), br)
    FfiBranch { ctx1 = ctx1; thenb = thenb.block_id; elseb = elseb.block_id; mergeb = mergeb.block_id; merge_param = mp.vreg }
}

fn lower_ffi_error_else_arm(br: FfiBranch, out_ptr: u32, out_len: u32, err_index: u32, e: checker::TExpr): LFunc | error {
    var else_ctx = ctx_with(br.ctx1, br.ctx1.func, br.elseb, br.ctx1.env)
    var loaded = load_ptr_len_out_slots(else_ctx, out_ptr, out_len, e.line, e.col)
    var slot = ctx_alloc(loaded.ctx)
    var alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    var built = match lower_ffi_error_arm(alloca, slot.vreg, err_index to i64, loaded.ptr, loaded.len, e) { LowerCtx as x => x; error as err => return err }
    close_arm_to(built, br.mergeb, [slot.vreg], e.line, e.col)
}

fn lower_ffi_fat_or_error_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall, ok_symbol: str, ok_member: @Type()): Lowered | error {
    var members = match ffi_result_variant_members(e) { []@Type() as m => m; error as err => return err }
    var ok_index = match variant_member_index_of(members, ok_member, ctx.variants) { u32 as x => x; error as err => return err }
    var err_index = match variant_member_index_of(members, checker::Error { }, ctx.variants) { u32 as x => x; error as err => return err }
    var slots = match lower_ffi_twin_call(ctx, c, ok_symbol, e.line, e.col) { FfiOutSlots as x => x; error as err => return err }
    var br = lower_ffi_open_branch(slots.ok, e.line, e.col)
    var then_ctx = ctx_goto(br.ctx1, br.thenb)
    var then_loaded = load_ptr_len_out_slots(then_ctx, slots.out_ptr, slots.out_len, e.line, e.col)
    var then_base = ctx_alloc(then_loaded.ctx)
    var then_alloca = ctx_append(then_base.ctx, alloca_inst(then_base.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    var then_built = lower_ffi_fat_ok_arm(then_alloca, then_base.vreg, ok_index to i64, then_loaded.ptr, then_loaded.len, e.line, e.col)
    var then_func = close_arm_to(then_built, br.mergeb, [then_base.vreg], e.line, e.col)
    var after_then = ctx_with(br.ctx1, then_func, br.ctx1.block_id, br.ctx1.env)
    var br_then = FfiBranch { ctx1 = after_then; thenb = br.thenb; elseb = br.elseb; mergeb = br.mergeb; merge_param = br.merge_param }
    var else_func = match lower_ffi_error_else_arm(br_then, slots.out_ptr, slots.out_len, err_index, e) { LFunc as x => x; error as err => return err }
    Lowered { ctx = ctx_with(after_then, else_func, br.mergeb, after_then.env); vreg = br.merge_param }
}

fn lower_ffi_ures_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall, ok_symbol: str): Lowered | error {
    var v = match e.type { checker::Variant as x => x; _ => return error { message = "native backend N1: a host-FFI `error | null` call's result is not a variant (internal)" } }
    var null_index = match variant_null_member_index(v) { u32 as x => x; null => return error { message = "native backend N1: a host-FFI `error | null` call declares no `null` member (internal)" } }
    var err_index = match variant_member_index_of(v.members, checker::Error { }, ctx.variants) { u32 as x => x; error as err => return err }
    var slots = match lower_ffi_twin_call(ctx, c, ok_symbol, e.line, e.col) { FfiOutSlots as x => x; error as err => return err }
    var br = lower_ffi_open_branch(slots.ok, e.line, e.col)
    var then_ctx = ctx_goto(br.ctx1, br.thenb)
    var then_absent = lower_variant_absent(then_ctx, null_index to i64, e)
    var then_func = close_arm_to(then_absent.ctx, br.mergeb, [then_absent.vreg], e.line, e.col)
    var after_then = ctx_with(br.ctx1, then_func, br.ctx1.block_id, br.ctx1.env)
    var br_then = FfiBranch { ctx1 = after_then; thenb = br.thenb; elseb = br.elseb; mergeb = br.mergeb; merge_param = br.merge_param }
    var else_func = match lower_ffi_error_else_arm(br_then, slots.out_ptr, slots.out_len, err_index, e) { LFunc as x => x; error as err => return err }
    Lowered { ctx = ctx_with(after_then, else_func, br.mergeb, after_then.env); vreg = br.merge_param }
}

fn is_err_loc_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "err_loc"
}

fn is_err_typed_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "err_typed"
}

fn store_error_scalar_field(base_vreg: u32, layout: LStructLayout, field: str, value: Lowered, line: u32, col: u32): LowerCtx | error {
    var off = match field_offset_of(layout, field) { u32 as o => o; error as err => return err }
    var ty = match field_type_of(layout, field) { LType as t => t; error as err => return err }
    var addr = ctx_alloc(value.ctx)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base_vreg, off, line, col))
    ctx_append(with_addr, store_inst(addr.vreg, value.vreg, ty, line, col))
}

fn store_error_fat_field(base_vreg: u32, layout: LStructLayout, field: str, fo: LoweredFat, line: u32, col: u32): LowerCtx | error {
    var off = match field_offset_of(layout, field) { u32 as o => o; error as err => return err }
    var addr = ctx_alloc(fo.ctx)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base_vreg, off, line, col))
    store_fat_slot(with_addr, addr.vreg, fo, line, col)
}

fn lower_err_loc_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 3 {
        return error { message = "native backend N1: `err_loc` expects exactly three arguments (internal)" }
    }
    var src = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    var layout = error_struct_layout()
    var dst = copy_error_value(src.ctx, src.vreg, layout, e)
    var lo = match lower_expr(dst.ctx, c.args[1]) { Lowered as x => x; error as err => return err }
    var with_line = match store_error_scalar_field(dst.vreg, layout, "line", lo, e.line, e.col) { LowerCtx as x => x; error as err => return err }
    var co = match lower_expr(with_line, c.args[2]) { Lowered as x => x; error as err => return err }
    var with_col = match store_error_scalar_field(dst.vreg, layout, "col", co, e.line, e.col) { LowerCtx as x => x; error as err => return err }
    Lowered { ctx = with_col; vreg = dst.vreg }
}

fn lower_err_typed_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 3 {
        return error { message = "native backend N1: `err_typed` expects exactly three arguments (internal)" }
    }
    var src = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    var layout = error_struct_layout()
    var dst = copy_error_value(src.ctx, src.vreg, layout, e)
    var expected = match lower_fat_expr(dst.ctx, c.args[1]) { LoweredFat as x => x; error as err => return err }
    var with_expected = match store_error_fat_field(dst.vreg, layout, "expected", expected, e.line, e.col) { LowerCtx as x => x; error as err => return err }
    var actual = match lower_fat_expr(with_expected, c.args[2]) { LoweredFat as x => x; error as err => return err }
    var with_actual = match store_error_fat_field(dst.vreg, layout, "actual", actual, e.line, e.col) { LowerCtx as x => x; error as err => return err }
    Lowered { ctx = with_actual; vreg = dst.vreg }
}

fn is_f64_bitcast_call(callee: parser::Path): bool {
    var segs = callee.segments
    if segs.len == 0 { return false }
    var last = segs[segs.len - 1].name
    last == "f64_bits" || last == "f64_from_bits"
}

fn lower_f64_bitcast_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 1 {
        return error { message = "native backend N1: `f64_bits`/`f64_from_bits` expects exactly one argument (internal)" }
    }
    var ao = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    var segs = c.callee.segments
    var op = if segs.len > 0 && segs[segs.len - 1].name == "f64_from_bits" { LUnOp::IToFBits } else { LUnOp::FToIBits }
    var r = ctx_alloc(ao.ctx)
    var inst = un_inst(r.vreg, op, ao.vreg, e.line, e.col)
    Lowered { ctx = ctx_append(r.ctx, inst); vreg = r.vreg }
}

fn is_float_parse_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "parse"
}

fn lower_float_parse_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 1 {
        return error { message = "native backend N1: `float::parse` expects exactly one argument (internal)" }
    }
    var fo = match lower_fat_expr(ctx, c.args[0]) { LoweredFat as x => x; error as err => return err }
    var rr = ctx_alloc(fo.ctx)
    var with_call = ctx_append(rr.ctx, call_inst(rr.vreg, "tk_rt_float_parse_bits", two_args(fo.ptr, fo.len), false, e.line, e.col))
    Lowered { ctx = with_call; vreg = rr.vreg }
}

fn is_bytes_from_ptr_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "bytes_from_ptr"
}

fn lower_bytes_from_ptr_call(ctx: LowerCtx, c: checker::TCall): LoweredFat | error {
    if c.args.len != 2 {
        return error { message = "native backend N1: `bytes_from_ptr` expects exactly two arguments (internal)" }
    }
    var ptr_lowered = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    var len_lowered = match lower_expr(ptr_lowered.ctx, c.args[1]) { Lowered as x => x; error as err => return err }
    LoweredFat { ctx = len_lowered.ctx; ptr = ptr_lowered.vreg; len = len_lowered.vreg }
}

fn is_slice_view_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "slice_view"
}

fn slice_view_stride(t: @Type(), enums: []LEnumInfo): u32 {
    if is_str_type(t) { return 1 to u32 }
    match slice_element_of(t) {
        (@Type()) as et => elem_byte_stride(et, enums)
        null => 1 to u32
    }
}

fn lower_slice_view_call(ctx: LowerCtx, c: checker::TCall): LoweredFat | error {
    if c.args.len != 3 {
        return error { message = "native backend N1: `slice_view` expects a slice, a start and an end (internal)" }
    }
    var fatb = match lower_fat_expr(ctx, c.args[0]) { LoweredFat as x => x; error as err => return err }
    var lo = match lower_expr(fatb.ctx, c.args[1]) { Lowered as x => x; error as err => return err }
    var hi = match lower_expr(lo.ctx, c.args[2]) { Lowered as x => x; error as err => return err }
    var stride = slice_view_stride(c.args[0].type, hi.ctx.enums)
    var strv = ctx_alloc(hi.ctx)
    var with_strv = ctx_append(strv.ctx, const_int_inst(strv.vreg, stride to i64, c.args[0].line, c.args[0].col))
    var off = ctx_alloc(with_strv)
    var with_off = ctx_append(off.ctx, bin_inst(off.vreg, LBinOp::IMul, lo.vreg, strv.vreg, c.args[0].line, c.args[0].col))
    var np = ctx_alloc(with_off)
    var with_np = ctx_append(np.ctx, bin_inst(np.vreg, LBinOp::IAdd, fatb.ptr, off.vreg, c.args[0].line, c.args[0].col))
    var nl = ctx_alloc(with_np)
    var with_nl = ctx_append(nl.ctx, bin_inst(nl.vreg, LBinOp::ISub, hi.vreg, lo.vreg, c.args[0].line, c.args[0].col))
    LoweredFat { ctx = with_nl; ptr = np.vreg; len = nl.vreg }
}

fn is_buf_ptr_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "buf_ptr"
}

fn lower_buf_ptr_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 1 {
        return error { message = "native backend N1: `buf_ptr` expects exactly one u64 argument (internal)" }
    }
    var len_lowered = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }

    var region_vreg = ctx_alloc(len_lowered.ctx)
    var with_region_call = ctx_append(region_vreg.ctx, call_inst(region_vreg.vreg, "tk_region_root_u", [], false, e.line, e.col))

    var result_vreg = ctx_alloc(with_region_call)
    var alloc_args = two_args(region_vreg.vreg, len_lowered.vreg)
    var with_alloc_call = ctx_append(result_vreg.ctx, call_inst(result_vreg.vreg, "tk_region_alloc", alloc_args, false, e.line, e.col))

    Lowered { ctx = with_alloc_call; vreg = result_vreg.vreg }
}

fn is_load_u64_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "load_u64"
}

fn lower_load_u64_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 1 {
        return error { message = "native backend N1: `load_u64` expects exactly one u64 argument (internal)" }
    }
    var addr = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    var r = ctx_alloc(addr.ctx)
    var with_load = ctx_append(r.ctx, load_inst(r.vreg, addr.vreg, LType::I64, e.line, e.col))
    Lowered { ctx = with_load; vreg = r.vreg }
}

fn is_store_u64_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "store_u64"
}

fn lower_store_u64_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 2 {
        return error { message = "native backend N1: `store_u64` expects exactly two u64 arguments (internal)" }
    }
    var addr = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    var value = match lower_expr(addr.ctx, c.args[1]) { Lowered as x => x; error as err => return err }
    var with_store = ctx_append(value.ctx, store_inst(addr.vreg, value.vreg, LType::I64, e.line, e.col))
    Lowered { ctx = with_store; vreg = 0 to u32 }
}

fn is_load_u8_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "load_u8"
}

fn lower_load_u8_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 1 {
        return error { message = "native backend N1: `load_u8` expects exactly one u64 argument (internal)" }
    }
    var addr = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    var r = ctx_alloc(addr.ctx)
    var with_load = ctx_append(r.ctx, load_inst(r.vreg, addr.vreg, LType::I8, e.line, e.col))
    Lowered { ctx = with_load; vreg = r.vreg }
}

fn is_store_u8_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "store_u8"
}

fn lower_store_u8_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 2 {
        return error { message = "native backend N1: `store_u8` expects exactly two u64 arguments (internal)" }
    }
    var addr = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    var value = match lower_expr(addr.ctx, c.args[1]) { Lowered as x => x; error as err => return err }
    var with_store = ctx_append(value.ctx, store_inst(addr.vreg, value.vreg, LType::I8, e.line, e.col))
    Lowered { ctx = with_store; vreg = 0 to u32 }
}

fn is_syscall_call(callee: parser::Path): bool {
    var segs = callee.segments
    if segs.len == 0 { return false }
    var name = segs[segs.len - 1].name
    name == "syscall0" || name == "syscall1" || name == "syscall2" || name == "syscall3" ||
    name == "syscall4" || name == "syscall5" || name == "syscall6"
}

fn lower_syscall_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    var n = c.args.len
    var vregs: [n]u32 = []
    var cur = ctx
    var i: u64 = 0
    loop {
        if i >= n { break }
        var lo = match lower_expr(cur, c.args[i]) { Lowered as x => x; error as err => return err }
        cur = lo.ctx
        vregs[i] = lo.vreg
        i++
    }
    var r = ctx_alloc(cur)
    var with_syscall = ctx_append(r.ctx, syscall_inst(r.vreg, vregs, e.line, e.col))
    Lowered { ctx = with_syscall; vreg = r.vreg }
}

fn atomic_rmw_kind(name: str): LAtomicKind | null {
    if name == "atomic_cas_u32" { return LAtomicKind::Cas }
    if name == "atomic_xchg_u32" { return LAtomicKind::Xchg }
    if name == "atomic_add_u32" { return LAtomicKind::Add }
    if name == "atomic_load_u32" { return LAtomicKind::Load }
    null
}

fn is_atomic_rmw_call(callee: parser::Path): bool {
    var segs = callee.segments
    if segs.len == 0 { return false }
    match atomic_rmw_kind(segs[segs.len - 1].name) { LAtomicKind => true; null => false }
}

fn lower_atomic_rmw_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    var segs = c.callee.segments
    var kind = match atomic_rmw_kind(segs[segs.len - 1].name) { LAtomicKind as k => k; null => return error { message = "native backend N1: unknown atomic RMW builtin (internal)" } }
    var n = c.args.len
    var vregs: [n]u32 = []
    var cur = ctx
    var i: u64 = 0
    loop {
        if i >= n { break }
        var lo = match lower_expr(cur, c.args[i]) { Lowered as x => x; error as err => return err }
        cur = lo.ctx
        vregs[i] = lo.vreg
        i++
    }
    var r = ctx_alloc(cur)
    var with_atomic = ctx_append(r.ctx, atomic_rmw_inst(r.vreg, kind, vregs, e.line, e.col))
    Lowered { ctx = with_atomic; vreg = r.vreg }
}

fn is_capture_longjmp_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "capture_longjmp"
}

fn lower_capture_longjmp_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    var sym = mangle_fn_symbol("teko::runtime", "panic_raise", ctx.flat_symbols)
    lower_call_symbol(ctx, e, sym, [])
}

fn is_word_reinterpret_call(callee: parser::Path): bool {
    var segs = callee.segments
    if segs.len == 0 { return false }
    var name = segs[segs.len - 1].name
    name == "ptr_word" || name == "word_ptr"
}

fn lower_word_reinterpret_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 1 {
        return error { message = "native backend N1: `ptr_word`/`word_ptr` expects exactly one argument (internal)" }
    }
    lower_expr(ctx, c.args[0])
}

fn is_byte_ptr_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "byte_ptr"
}

fn lower_byte_ptr_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 2 {
        return error { message = "native backend N1: `byte_ptr` expects a []byte and an index (internal)" }
    }
    var fatb = match lower_fat_expr(ctx, c.args[0]) { LoweredFat as x => x; error as err => return err }
    var idx = match lower_expr(fatb.ctx, c.args[1]) { Lowered as x => x; error as err => return err }
    var r = ctx_alloc(idx.ctx)
    var with_add = ctx_append(r.ctx, bin_inst(r.vreg, LBinOp::IAdd, fatb.ptr, idx.vreg, e.line, e.col))
    Lowered { ctx = with_add; vreg = r.vreg }
}

fn is_as_cstr_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "as_cstr"
}

fn lower_as_cstr_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if c.args.len != 1 {
        return error { message = "native backend N1: `as_cstr` expects exactly one str argument (internal)" }
    }
    var src = match lower_fat_expr(ctx, c.args[0]) { LoweredFat as x => x; error as err => return err }
    var one_r = ctx_alloc(src.ctx)
    var with_one = ctx_append(one_r.ctx, const_int_inst(one_r.vreg, 1, e.line, e.col))
    var total_r = ctx_alloc(with_one)
    var with_total = ctx_append(total_r.ctx, bin_inst(total_r.vreg, LBinOp::IAdd, src.len, one_r.vreg, e.line, e.col))
    var region = region_current_vreg(with_total)
    var dst_r = ctx_alloc(region.ctx)
    var with_alloc = ctx_append(dst_r.ctx, call_inst(dst_r.vreg, "tk_region_alloc", two_args(region.vreg, total_r.vreg), false, e.line, e.col))
    var with_copy = ctx_append(with_alloc, void_call_inst("tk_mem_copy", [..two_args(dst_r.vreg, src.ptr), src.len], false, e.line, e.col))
    var end_r = ctx_alloc(with_copy)
    var with_end = ctx_append(end_r.ctx, bin_inst(end_r.vreg, LBinOp::IAdd, dst_r.vreg, src.len, e.line, e.col))
    var zero_r = ctx_alloc(with_end)
    var with_zero = ctx_append(zero_r.ctx, const_int_inst(zero_r.vreg, 0, e.line, e.col))
    var with_store = ctx_append(with_zero, store_inst(end_r.vreg, zero_r.vreg, LType::I8, e.line, e.col))
    Lowered { ctx = with_store; vreg = dst_r.vreg }
}

pub fn is_str_arg_builtin(sym: str): bool {
    sym == "tk_print" || sym == "tk_println" || sym == "tk_eprint" ||
    sym == "tk_eprintln" || sym == "tk_write" || sym == "tk_ewrite" ||
    sym == "tk_panic_str"
}

pub fn fat_arg_builtin_arity(sym: str): u64 {
    if takes_one_str_by_value(sym) { return 1 }
    if takes_two_strs_by_value(sym) { return 2 }
    assert_seed_fat_arity(sym)
}

const ASSERT_SEED_PREFIX: str = "teko_teko__assert__"

fn assert_seed_fat_arity(sym: str): u64 {
    if !has_assert_seed_prefix(sym) { return 0 }
    checker::assert_fat_arg_arity(sym.slice_from(ASSERT_SEED_PREFIX.len))
}

fn has_assert_seed_prefix(sym: str): bool {
    if sym.len <= ASSERT_SEED_PREFIX.len { return false }
    var i: u64 = 0
    loop {
        if i >= ASSERT_SEED_PREFIX.len { break }
        if sym[i] != ASSERT_SEED_PREFIX[i] { return false }
        i++
    }
    true
}

fn takes_one_str_by_value(sym: str): bool {
    sym == "tk_print" || sym == "tk_println" || sym == "tk_eprint" || sym == "tk_eprintln" ||
    sym == "tk_write" || sym == "tk_ewrite" || sym == "tk_panic_str" ||
    sym == "tk_assert_scenario_set" || sym == "tk_test_begin" ||
    sym == "tk_rt_spawn_redirected" || sym == "tk_float_parse" ||
    sym == "tk_cstr_dup" || sym == "tk_str_len" || sym == "tk_str_hash" ||
    sym == "tk_str_of_bytes" || sym == "teko_teko__runtime__intern_get" ||
    sym == "tk_rt_read_file" || sym == "tk_rt_getenv" ||
    sym == "tk_rt_chdir" || sym == "tk_rt_mkdir" || sym == "tk_rt_remove_file" ||
    sym == "tk_rt_list_dir" || sym == "tk_rt_write_file_bytes" ||
    sym == "tk_journal_open" || sym == "tk_journal_append" || sym == "tk_journal_arm"
}

fn takes_two_strs_by_value(sym: str): bool {
    sym == "tk_str_eq" || sym == "tk_str_contains" || sym == "tk_str_ends_with" ||
    sym == "tk_rt_last_index_of_ok" || sym == "tk_str_cmp" || sym == "tk_str_concat" ||
    sym == "teko_teko__runtime__intern_put" || sym == "tk_rt_write_file" || sym == "tk_rt_append_file" ||
    sym == "tk_rt_setenv" || sym == "tk_rt_last_index_of" || sym == "tk_rt_rename"
}

fn lower_str_arg_call(ctx: LowerCtx, e: checker::TExpr, sym: str, c: checker::TCall): Lowered | error {
    if c.args.len != 1 {
        return error { message = teko::str::concat("native backend N1: `", sym, "` expects exactly one str argument (internal)") }
    }
    var fo = match lower_fat_expr(ctx, c.args[0]) { LoweredFat as x => x; error as err => return err }
    var inst = void_call_inst(sym, two_args(fo.ptr, fo.len), false, e.line, e.col)
    Lowered { ctx = ctx_append(fo.ctx, inst); vreg = 0 }
}

pub type LoweredArgs = struct { ctx: LowerCtx; vregs: []u32 }

fn lower_args(ctx: LowerCtx, args: []checker::TExpr, params: []@Type()): LoweredArgs | error {
    lower_args_from(ctx, args, params, 0)
}

fn lower_args_from(ctx: LowerCtx, args: []checker::TExpr, params: []@Type(), start: u64): LoweredArgs | error {
    var cur = ctx
    var vregs: []u32 = []
    var i: u64 = start
    loop {
        if i >= args.len { break }
        var one = match lower_arg_into_param(cur, param_type_at(params, i), args[i]) { LoweredArgs as x => x; error as err => return err }
        cur = one.ctx
        vregs = append_vregs(vregs, one.vregs)
        i++
    }
    LoweredArgs { ctx = cur; vregs = vregs }
}

fn append_vregs(xs: []u32, more: []u32): []u32 {
    var out: [xs.len + more.len]u32 = []
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        out[i] = xs[i]
        i++
    }
    var j: u64 = 0
    loop {
        if j >= more.len { break }
        out[xs.len + j] = more[j]
        j++
    }
    out
}

fn lower_arg_vregs(ctx: LowerCtx, arg: checker::TExpr): LoweredArgs | error {
    if is_fat_type(arg.type) {
        var fo = match lower_fat_expr(ctx, arg) { LoweredFat as x => x; error as err => return err }
        return LoweredArgs { ctx = fo.ctx; vregs = two_args(fo.ptr, fo.len) }
    }
    var lo = match lower_expr(ctx, arg) { Lowered as x => x; error as err => return err }
    LoweredArgs { ctx = lo.ctx; vregs = single_arg(lo.vreg) }
}

fn lower_call_symbol(ctx: LowerCtx, e: checker::TExpr, sym: str, vregs: []u32): Lowered | error {
    if type_is_void(e.type) {
        var inst = void_call_inst(sym, vregs, false, e.line, e.col)
        return Lowered { ctx = ctx_append(ctx, inst); vreg = 0 }
    }
    var r = ctx_alloc(ctx)
    var inst = call_inst(r.vreg, sym, vregs, false, e.line, e.col, ltype_of(e.type, ctx.enums))
    Lowered { ctx = ctx_append(r.ctx, inst); vreg = r.vreg }
}

type ExternNarrow = struct { width: u32; is_signed: bool }

fn extern_return_narrow(t: @Type()): ExternNarrow | null {
    match t {
        checker::Prim as p => extern_return_narrow_of_prim(p.kind)
        checker::Byte => ExternNarrow { width = 8; is_signed = false }
        _ => null
    }
}

fn extern_return_narrow_of_prim(k: checker::PrimKind): ExternNarrow | null {
    if prim_is_float_kind(k) { return null }
    if k == checker::PrimKind::Bool { return ExternNarrow { width = 8; is_signed = false } }
    var w = prim_width_of(k)
    if w >= 64 { return null }
    ExternNarrow { width = w; is_signed = prim_is_signed_int(k) }
}

fn narrow_extern_return(lo: Lowered, n: ExternNarrow, line: u32, col: u32): Lowered {
    var width: i64 = n.width to i64
    var amount: i64 = 64 - width
    var sc = ctx_alloc(lo.ctx)
    var with_amount = ctx_append(sc.ctx, const_int_inst(sc.vreg, amount, line, col))
    var shl = ctx_alloc(with_amount)
    var with_shl = ctx_append(shl.ctx, bin_inst(shl.vreg, LBinOp::IShl, lo.vreg, sc.vreg, line, col))
    var shr_op = if n.is_signed { LBinOp::IShrS } else { LBinOp::IShrU }
    var shr = ctx_alloc(with_shl)
    var with_shr = ctx_append(shr.ctx, bin_inst(shr.vreg, shr_op, shl.vreg, sc.vreg, line, col))
    Lowered { ctx = with_shr; vreg = shr.vreg }
}

fn calls_native_c(c: checker::TCall, externs: []LExternFn): bool {
    if c.call_ns.len == 0 { return true }
    var segs = c.callee.segments
    var last = segs[segs.len - 1].name
    match find_extern_symbol(externs, c.call_ns, last) { str as _ => true; null => false }
}

fn apply_native_c_return_narrow(lo: Lowered, externs: []LExternFn, c: checker::TCall, e: checker::TExpr): Lowered {
    if type_is_void(e.type) { return lo }
    if !calls_native_c(c, externs) { return lo }
    match extern_return_narrow(e.type) {
        ExternNarrow as n => narrow_extern_return(lo, n, e.line, e.col)
        null => lo
    }
}

fn type_is_void(t: @Type()): bool {
    match t { checker::Void => true; _ => false }
}

fn builtin_arena_symbol(last: str): str | null {
    if last == "arena_push" { return "tk_arena_push" }
    if last == "arena_pop" { return "tk_arena_pop" }
    if last == "arena_commit" { return "tk_arena_commit" }
    if last == "task_reset" { return "tk_task_reset" }
    null
}

fn assert_seed_symbol(callee: parser::Path): str | null {
    var segs = callee.segments
    if segs.len < 2 { return null }
    if segs[0].name != "teko" { return null }
    if segs[segs.len - 2].name != "assert" { return null }
    var last = segs[segs.len - 1].name
    if checker::assert_builtin_name(last) {
        return teko::str::concat(ASSERT_SEED_PREFIX, last)
    }
    null
}

fn builtin_int_to_str_symbol(last: str): str | null {
    if last == "i64_to_str" { return "teko_teko__runtime__i64_to_str_len" }
    if last == "u64_to_str" { return "teko_teko__runtime__u64_to_str_len" }
    null
}

fn builtin_float_to_str_symbol(last: str): str | null {
    if last == "ftoa" { return "teko_teko__runtime__ftoa_len" }
    null
}

fn builtin_str_of_bytes_symbol(last: str): str | null {
    if last == "str" { return "tk_str_of_bytes_len" }
    if last == "str_of_bytes" { return "tk_str_of_bytes_len" }
    null
}

fn builtin_one_byte_symbol(last: str): str | null {
    if last == "one_byte" { return "teko_teko__runtime__one_byte_len" }
    null
}

fn builtin_host_info_symbol(last: str): str | null {
    if last == "version" { return "tk_rt_version_len" }
    null
}

fn builtin_peak_rss_symbol(last: str): str | null {
    if last == "peak_rss" { return "tk_peak_rss" }
    null
}

fn native_builtin_symbol(last: str): str | null {
    match builtin_arena_symbol(last) { str as s => return s; null => { } }
    match builtin_int_to_str_symbol(last) { str as s => return s; null => { } }
    match builtin_float_to_str_symbol(last) { str as s => return s; null => { } }
    match builtin_str_of_bytes_symbol(last) { str as s => return s; null => { } }
    match builtin_one_byte_symbol(last) { str as s => return s; null => { } }
    match builtin_host_info_symbol(last) { str as s => return s; null => { } }
    match builtin_peak_rss_symbol(last) { str as s => return s; null => { } }
    match builtin_hostffi_variant_symbol(last) { str as s => return s; null => { } }
    builtin_env_symbol(last)
}

fn builtin_hostffi_variant_symbol(last: str): str | null {
    if last == "var" { return "tk_rt_getenv" }
    if last == "cwd" { return "tk_rt_getcwd" }
    if last == "list_dir" { return "tk_rt_list_dir" }
    null
}

fn builtin_env_symbol(last: str): str | null {
    if last == "args" { return "tk_rt_args" }
    null
}

fn call_symbol(c: checker::TCall, externs: []LExternFn, flat: bool = false): str | error {
    var segs = c.callee.segments
    if segs.len == 0 { return error { message = "native backend N1: empty call path (internal)" } }
    var last = segs[segs.len - 1].name
    if c.call_ns.len == 0 {
        match assert_seed_symbol(c.callee) { str as s => return s; null => { } }
        if is_mem_value_call(c.callee) { return unresolved_builtin_stop(last) }
        match native_builtin_symbol(last) { str as s => return s; null => { } }
        if is_list_builtin_call(c.callee) {
            return error { message = "native backend N1: the generic `teko::list::*`/`teko::mem::push_fo` growth builtin has no native runtime backing yet (N2)" }
        }
        if last == "parse" { return float_parse_result_stop() }
        return unresolved_builtin_stop(last)
    }
    match find_extern_symbol(externs, c.call_ns, last) {
        str as foreign => foreign
        null => mangle_fn_symbol(c.call_ns, last, flat, c.overload_suffix)
    }
}

fn float_parse_result_stop(): error {
    error { message = "native backend N1: builtin `parse` (`teko::float::parse(str): f64`) not yet lowered (N2) — its `double` result comes back in XMM0/D0 and `LCall` records no result class, so `select_call_result_*` would capture the integer register instead and hand back a silently wrong float" }
}

fn unresolved_builtin_stop(last: str): error {
    error { message = teko::str::concat("native backend N1: builtin `", last, "` not yet lowered (N2)") }
}

fn is_list_builtin_call(callee: parser::Path): bool {
    var segs = callee.segments
    if segs.len < 2 { return false }
    var last = segs[segs.len - 1].name
    var prev = segs[segs.len - 2].name
    var is_pushfo = prev == "mem" && last == "push_fo"
    if prev != "list" && !is_pushfo { return false }
    segs.len == 2 || segs[0].name == "teko"
}

fn is_mem_value_call(callee: parser::Path): bool {
    var segs = callee.segments
    if segs.len < 2 { return false }
    var last = segs[segs.len - 1].name
    var prev = segs[segs.len - 2].name
    if prev != "mem" { return false }
    var rooted = segs.len == 2 || segs[0].name == "teko"
    rooted && (last == "place" || last == "read" || last == "write")
}

fn find_extern_symbol(externs: []LExternFn, ns: str, name: str): str | null {
    var i: u64 = 0
    loop {
        if i >= externs.len { break }
        if externs[i].namespace == ns && externs[i].name == name { return externs[i].c_symbol }
        i++
    }
    null
}

pub type IfaceFatPtr = struct { ctx: LowerCtx; data: u32; vtable: u32 }

fn lower_iface_fatptr(ctx: LowerCtx, base_vreg: u32, line: u32, col: u32): IfaceFatPtr {
    var ptr_size = ltype_size(LType::Ptr)
    var data_addr = ctx_alloc(ctx)
    var with_data_addr = ctx_append(data_addr.ctx, field_addr_inst(data_addr.vreg, base_vreg, 0, line, col))
    var data = ctx_alloc(with_data_addr)
    var with_data = ctx_append(data.ctx, load_inst(data.vreg, data_addr.vreg, LType::Ptr, line, col))
    var vt_addr = ctx_alloc(with_data)
    var with_vt_addr = ctx_append(vt_addr.ctx, field_addr_inst(vt_addr.vreg, base_vreg, ptr_size, line, col))
    var vt = ctx_alloc(with_vt_addr)
    var with_vt = ctx_append(vt.ctx, load_inst(vt.vreg, vt_addr.vreg, LType::Ptr, line, col))
    IfaceFatPtr { ctx = with_vt; data = data.vreg; vtable = vt.vreg }
}

fn lower_iface_slot(ctx: LowerCtx, vtable: u32, slot: u32, line: u32, col: u32): Lowered {
    var ptr_size = ltype_size(LType::Ptr)
    var slot_addr = ctx_alloc(ctx)
    var with_slot_addr = ctx_append(slot_addr.ctx, field_addr_inst(slot_addr.vreg, vtable, slot * ptr_size, line, col))
    var target = ctx_alloc(with_slot_addr)
    Lowered { ctx = ctx_append(target.ctx, load_inst(target.vreg, slot_addr.vreg, LType::Ptr, line, col)); vreg = target.vreg }
}

fn iface_call_args(data: u32, rest: []u32): []u32 {
    [data, ..rest]
}

fn lower_call_indirect(ctx: LowerCtx, e: checker::TExpr, target: u32, args: []u32): Lowered | error {
    if type_is_void(e.type) {
        var inst = void_call_indirect_inst(target, args, false, e.line, e.col)
        return Lowered { ctx = ctx_append(ctx, inst); vreg = 0 }
    }
    var r = ctx_alloc(ctx)
    var inst = call_indirect_inst(r.vreg, target, args, false, e.line, e.col, ltype_of(e.type, ctx.enums))
    Lowered { ctx = ctx_append(r.ctx, inst); vreg = r.vreg }
}

fn lower_iface_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if is_fat_type(e.type) { return error { message = "native backend N1: fat-pointer interface-dispatch result not yet lowered (N2)" } }
    if c.args.len == 0 { return error { message = "native backend N1: malformed interface-dispatch call (internal)" } }
    match aggregate_receiver_dispatch_stop(ctx, c.args[0].type) { error as stop => return stop; null => { } }
    var ro = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    var fp = lower_iface_fatptr(ro.ctx, ro.vreg, e.line, e.col)
    var tgt = lower_iface_slot(fp.ctx, fp.vtable, c.iface_slot, e.line, e.col)
    var rest = match lower_args_from(tgt.ctx, c.args, callee_param_types(c), 1) { LoweredArgs as x => x; error as err => return err }
    lower_call_indirect(rest.ctx, e, tgt.vreg, iface_call_args(fp.data, rest.vregs))
}

fn aggregate_receiver_dispatch_stop(ctx: LowerCtx, t: @Type()): error | null {
    var name = match t { checker::Named as n => n.name; _ => return null }
    match find_struct_layout(ctx.layouts, name) {
        LStructLayout => error { message = teko::str::concat("native backend N1: dynamic dispatch through the polymorphic base class `", name, "` is not yet lowered — a class instance carries no vtable (N2)") }
        error => null
    }
}

fn func_type_of(t: @Type()): checker::Func | error {
    match t {
        checker::Func as f => f
        _ => error { message = "native backend N1: function-value reference is not Func-typed (internal)" }
    }
}

fn types_to_ltypes(ts: []@Type(), enums: []LEnumInfo): []LType {
    var out: [ts.len]LType = []
    var i: u64 = 0
    loop {
        if i >= ts.len { break }
        out[i] = ltype_of(ts[i], enums)
        i++
    }
    out
}

fn ltype_is_void(t: LType): bool {
    match t { Void => true; _ => false }
}

fn env_first_param_types(rest: []LType): []LType {
    [LType::Ptr, ..rest]
}

fn lift_thunk_symbol(id: u64): str {
    teko::str::concat(".Lclofn", teko::u64_to_str(id))
}

fn lift_lambda_symbol(id: u64): str {
    teko::str::concat(".Lclo", teko::u64_to_str(id))
}

fn materialize_thunk_params(f0: LFunc, line: u32, col: u32): LFunc {
    var f = f0
    var i: u64 = 0
    loop {
        if i >= f.n_params { break }
        f = append_inst(f, 0, param_inst(i to u32, i to u32, line, col))
        i++
    }
    f
}

fn thunk_forward_args(n: u64, has_ret_len_slot: bool): []u32 {
    var total = n + (if has_ret_len_slot { 1 } else { 0 })
    var out: [total]u32 = []
    loop var i in 0..total {
        out[i] = (i + 1) to u32
    }
    out
}

fn build_closure_thunk(symbol: str, target_sym: str, ptypes: []LType, ret_ty: LType, fat_ret: bool, line: u32, col: u32): LFunc {
    var env_first = env_first_param_types(ptypes)
    var all_ptypes = if fat_ret { [..env_first, LType::Ptr] } else { env_first }
    var f0 = new_func(symbol, all_ptypes.len to u32, all_ptypes, ret_ty)
    var f1 = materialize_thunk_params(f0, line, col)
    var args = thunk_forward_args(ptypes.len, fat_ret)
    if ltype_is_void(ret_ty) {
        var f2 = append_inst(f1, 0, void_call_inst(target_sym, args, false, line, col))
        return append_inst(f2, 0, ret_void_inst(line, col))
    }
    var r = alloc_vreg(f1)
    var f2 = append_inst(r.func, 0, call_inst(r.vreg, target_sym, args, false, line, col, ret_ty))
    append_inst(f2, 0, ret_inst(r.vreg, line, col))
}

fn build_closure_literal(ctx: LowerCtx, fn_symbol: str, env_vreg: u32, line: u32, col: u32): Lowered {
    var ptr_size = ltype_size(LType::Ptr)
    var fnaddr = ctx_alloc(ctx)
    var with_fnaddr = ctx_append(fnaddr.ctx, func_addr_inst(fnaddr.vreg, fn_symbol, line, col))
    var slot = ctx_alloc(with_fnaddr)
    var with_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, ptr_size * 2, ptr_size, line, col))
    var fslot = ctx_alloc(with_alloca)
    var with_fslot_addr = ctx_append(fslot.ctx, field_addr_inst(fslot.vreg, slot.vreg, 0, line, col))
    var with_fn_store = ctx_append(with_fslot_addr, store_inst(fslot.vreg, fnaddr.vreg, LType::Ptr, line, col))
    var eslot = ctx_alloc(with_fn_store)
    var with_eslot_addr = ctx_append(eslot.ctx, field_addr_inst(eslot.vreg, slot.vreg, ptr_size, line, col))
    var with_env_store = ctx_append(with_eslot_addr, store_inst(eslot.vreg, env_vreg, LType::Ptr, line, col))
    emit_elem_box(Lowered { ctx = with_env_store; vreg = slot.vreg }, ptr_size * 2, line, col)
}

fn lower_fn_value(ctx: LowerCtx, e: checker::TExpr, v: checker::TVar): Lowered | error {
    var sig = match func_type_of(e.type) { checker::Func as f => f; error as err => return err }
    var target_sym = mangle_fn_symbol(v.func_ns, v.name, ctx.flat_symbols)
    var ptypes = types_to_ltypes(sig.params, ctx.enums)
    var ret_ty = ltype_of(sig.ret, ctx.enums)
    var fat_ret = is_fat_type(sig.ret)
    var id = ctx.lifted_base + ctx.lifted.len
    var thunk_sym = lift_thunk_symbol(id)
    var thunk = build_closure_thunk(thunk_sym, target_sym, ptypes, ret_ty, fat_ret, e.line, e.col)
    var ctx2 = ctx_with_lifted(ctx, [..ctx.lifted, thunk])
    var nullo = ctx_alloc(ctx2)
    var with_null = ctx_append(nullo.ctx, const_int_inst(nullo.vreg, 0, e.line, e.col))
    build_closure_literal(with_null, thunk_sym, nullo.vreg, e.line, e.col)
}

pub type ClosureFatPtr = struct { ctx: LowerCtx; target: u32; env: u32 }

fn lower_closure_fatptr(ctx: LowerCtx, base_vreg: u32, line: u32, col: u32): ClosureFatPtr {
    var fp = lower_iface_fatptr(ctx, base_vreg, line, col)
    ClosureFatPtr { ctx = fp.ctx; target = fp.data; env = fp.vtable }
}

fn closure_call_args(env: u32, rest: []u32): []u32 {
    [env, ..rest]
}

fn lower_closure_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): Lowered | error {
    if is_fat_type(e.type) { return error { message = "native backend N1: fat-pointer closure-call result not yet lowered (N2)" } }
    if c.callee.segments.len == 0 { return error { message = "native backend N1: empty closure-call path (internal)" } }
    var name = c.callee.segments[c.callee.segments.len - 1].name
    var hit = lenv_lookup(ctx.env, name)
    if !hit.found { return error { message = teko::str::concat("native backend N1: unbound closure local `", name, "` (internal)") } }
    var fp = lower_closure_fatptr(ctx, hit.vreg, e.line, e.col)
    var rest = match lower_args(fp.ctx, c.args, callee_param_types(c)) { LoweredArgs as x => x; error as err => return err }
    lower_call_indirect(rest.ctx, e, fp.target, closure_call_args(fp.env, rest.vregs))
}

fn lower_closure_call_fat(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall): LoweredFat | error {
    if c.callee.segments.len == 0 { return error { message = "native backend N1: empty closure-call path (internal)" } }
    var name = c.callee.segments[c.callee.segments.len - 1].name
    var hit = lenv_lookup(ctx.env, name)
    if !hit.found { return error { message = teko::str::concat("native backend N1: unbound closure local `", name, "` (internal)") } }
    var fp = lower_closure_fatptr(ctx, hit.vreg, e.line, e.col)
    var rest = match lower_args(fp.ctx, c.args, callee_param_types(c)) { LoweredArgs as x => x; error as err => return err }
    lower_len_out_call_indirect(rest.ctx, fp.target, closure_call_args(fp.env, rest.vregs), e)
}

fn lambda_capture_names(captures: []checker::TCapture): []str {
    var out: [captures.len]str = []
    var i: u64 = 0
    loop {
        if i >= captures.len { break }
        out[i] = captures[i].name
        i++
    }
    out
}

fn lambda_capture_types(captures: []checker::TCapture, enums: []LEnumInfo): []LType {
    var out: [captures.len]LType = []
    var i: u64 = 0
    loop {
        if i >= captures.len { break }
        out[i] = ltype_of(captures[i].type, enums)
        i++
    }
    out
}

fn lambda_env_layout(captures: []checker::TCapture, enums: []LEnumInfo): LStructLayout {
    layout_of("<closure-env>", lambda_capture_names(captures), lambda_capture_types(captures, enums))
}

fn store_lambda_captures(ctx: LowerCtx, base_vreg: u32, layout: LStructLayout, captures: []checker::TCapture, line: u32, col: u32): Lowered | error {
    var cur = ctx
    var i: u64 = 0
    loop {
        if i >= captures.len { break }
        var hit = lenv_lookup(cur.env, captures[i].name)
        if !hit.found { return error { message = teko::str::concat("native backend N1: unbound capture `", captures[i].name, "` (internal)") } }
        if lenv_lookup_fat_slot(cur.env, captures[i].name).found {
            return error { message = teko::str::concat("native backend N1: capturing the MUTABLE str/slice local `", captures[i].name, "` needs the env slot to carry both halves of its pair, not the address of its frame slot (N2)") }
        }
        var off = match field_offset_of(layout, captures[i].name) { u32 as o => o; error as err => return err }
        var ty = match field_type_of(layout, captures[i].name) { LType as t => t; error as err => return err }
        if ty == LType::Ptr && is_fat_type(captures[i].type) {
            var ptr_addr = ctx_alloc(cur)
            var ptr_addr_inst = ctx_append(ptr_addr.ctx, field_addr_inst(ptr_addr.vreg, base_vreg, off, line, col))
            var len_hit = lenv_lookup_fat(cur.env, captures[i].name)
            if !len_hit.found { return error { message = teko::str::concat("native backend N1: fat capture `", captures[i].name, "` not a fat binding (internal)") } }
            var ptr_store = ctx_append(ptr_addr_inst, store_inst(ptr_addr.vreg, len_hit.ptr, LType::Ptr, line, col))
            var len_addr = ctx_alloc(ptr_store)
            var len_addr_inst = ctx_append(len_addr.ctx, field_addr_inst(len_addr.vreg, base_vreg, off + ltype_size(LType::Ptr), line, col))
            cur = ctx_append(len_addr_inst, store_inst(len_addr.vreg, len_hit.len, LType::I64, line, col))
        } else {
            var addr = ctx_alloc(cur)
            var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base_vreg, off, line, col))
            cur = ctx_append(with_addr, store_inst(addr.vreg, hit.vreg, ltype_of(captures[i].type, cur.enums), line, col))
        }
        i++
    }
    Lowered { ctx = cur; vreg = base_vreg }
}

fn build_lambda_env(ctx: LowerCtx, layout: LStructLayout, captures: []checker::TCapture, line: u32, col: u32): Lowered | error {
    if captures.len == 0 {
        var r = ctx_alloc(ctx)
        return Lowered { ctx = ctx_append(r.ctx, const_int_inst(r.vreg, 0, line, col)); vreg = r.vreg }
    }
    var slot = ctx_alloc(ctx)
    var with_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, layout.size, layout.align, line, col))
    var filled = match store_lambda_captures(with_alloca, slot.vreg, layout, captures, line, col) { Lowered as x => x; error as err => return err }
    emit_elem_box(filled, layout.size, line, col)
}

fn lambda_param_ltypes(params: []checker::TLambdaParam, enums: []LEnumInfo): []LType {
    var out: [params.len]LType = []
    var i: u64 = 0
    loop {
        if i >= params.len { break }
        out[i] = ltype_of(params[i].type, enums)
        i++
    }
    out
}

pub type ParamSeed = struct { func: LFunc; env: LEnv }

fn materialize_lambda_params(f0: LFunc, lam: checker::TLambda, line: u32, col: u32): ParamSeed {
    var f = append_inst(f0, 0, param_inst(0, 0, line, col))
    var env = empty_lenv()
    var i: u64 = 0
    loop {
        if i >= lam.params.len { break }
        var idx = (i + 1) to u32
        f = append_inst(f, 0, param_inst(idx, idx, line, col))
        env = lenv_bind(env, lam.params[i].name, idx)
        i++
    }
    ParamSeed { func = f; env = env }
}

fn bind_lambda_captures(ctx: LowerCtx, layout: LStructLayout, captures: []checker::TCapture, line: u32, col: u32): LowerCtx | error {
    var cur = ctx
    var i: u64 = 0
    loop {
        if i >= captures.len { break }
        var off = match field_offset_of(layout, captures[i].name) { u32 as o => o; error as err => return err }
        var ty = match field_type_of(layout, captures[i].name) { LType as t => t; error as err => return err }
        var addr = ctx_alloc(cur)
        var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, 0, off, line, col))
        if ty == LType::Ptr && is_fat_type(captures[i].type) {
            var ptr_val = ctx_alloc(with_addr)
            var ptr_with_val = ctx_append(ptr_val.ctx, load_inst(ptr_val.vreg, addr.vreg, LType::Ptr, line, col))
            var len_addr_vreg = ctx_alloc(ptr_with_val)
            var len_addr = ctx_append(len_addr_vreg.ctx, field_addr_inst(len_addr_vreg.vreg, 0, off + ltype_size(LType::Ptr), line, col))
            var len_val = ctx_alloc(len_addr)
            var len_with_val = ctx_append(len_val.ctx, load_inst(len_val.vreg, len_addr_vreg.vreg, LType::I64, line, col))
            cur = ctx_bind_fat(len_with_val, captures[i].name, ptr_val.vreg, len_val.vreg)
        } else {
            var val = ctx_alloc(with_addr)
            var with_val = ctx_append(val.ctx, load_inst(val.vreg, addr.vreg, ty, line, col))
            cur = ctx_bind(with_val, captures[i].name, val.vreg)
        }
        i++
    }
    cur
}

fn close_lambda_body(ctx: LowerCtx, line: u32, col: u32): LowerCtx | error {
    if block_terminated(ctx.func, ctx.block_id) { return ctx }
    var replayed = match replay_defers(ctx, 0) { LowerCtx as c => c; error as err => return err }
    ctx_append(replayed, ret_void_inst(line, col))
}

pub type LoweredLambda = struct { func: LFunc; rodata: []LRodata; lifted: []LFunc }

fn build_lambda_lfunc(lam: checker::TLambda, env_layout: LStructLayout, ctx: LowerCtx, line: u32, col: u32): LoweredLambda | error {
    var fat_ret = is_fat_type(lam.ret)
    var ptypes = lambda_param_ltypes(lam.params, ctx.enums)
    var env_first = env_first_param_types(ptypes)
    var all_ptypes = if fat_ret { [..env_first, LType::Ptr] } else { env_first }
    var seed0 = new_func("", all_ptypes.len to u32, all_ptypes, ltype_of(lam.ret, ctx.enums))
    var seed = materialize_lambda_params(seed0, lam, line, col)
    var slot_reg = (lam.params.len + 1) to u32
    var seeded = if fat_ret {
        ParamSeed { func = append_inst(seed.func, 0, param_inst(slot_reg, slot_reg, line, col)); env = seed.env }
    } else {
        seed
    }
    var ctx0 = LowerCtx {
        func = seeded.func; block_id = 0; env = seeded.env
        layouts = ctx.layouts; rodata = ctx.rodata; enums = ctx.enums; lifted = ctx.lifted
        variants = ctx.variants
        defers = []; loop_targets = []; externs = ctx.externs
        flat_symbols = ctx.flat_symbols; ret_type = lam.ret
        has_ret_len_slot = fat_ret; ret_len_slot = if fat_ret { slot_reg } else { 0 }
        ref_fns = ctx.ref_fns; field_decls = ctx.field_decls; addr_taken = collect_addr_taken_locals(lam.body, ctx.ref_fns, ctx.enums); table = ctx.table
        region_stack = []; escaping = []; frees_old_names = []; bracket_depth = 0
        region_param = ctx.region_param; plan = ctx.plan; rodata_base = ctx.rodata_base; const_rodata = ctx.const_rodata; lifted_base = ctx.lifted_base
    }
    var with_captures = match bind_lambda_captures(ctx0, env_layout, lam.captures, line, col) { LowerCtx as c => c; error as err => return err }
    var done = match lower_fn_body(with_captures, lam.body, ltype_of(lam.ret, ctx.enums), line, col) { LowerCtx as c => c; error as err => return err }
    var closed = match close_lambda_body(done, line, col) { LowerCtx as c => c; error as err => return err }
    LoweredLambda { func = closed.func; rodata = closed.rodata; lifted = closed.lifted }
}

fn lower_lambda(ctx: LowerCtx, e: checker::TExpr, lam: checker::TLambda): Lowered | error {
    var env_layout = lambda_env_layout(lam.captures, ctx.enums)
    var envo = match build_lambda_env(ctx, env_layout, lam.captures, e.line, e.col) { Lowered as x => x; error as err => return err }
    var built = match build_lambda_lfunc(lam, env_layout, envo.ctx, e.line, e.col) { LoweredLambda as x => x; error as err => return err }
    var id = ctx.lifted_base + built.lifted.len
    var fn_sym = lift_lambda_symbol(id)
    var named = rename_lfunc(built.func, fn_sym)
    var ctx2 = ctx_with_lifted(ctx_with_rodata(envo.ctx, built.rodata), [..built.lifted, named])
    build_closure_literal(ctx2, fn_sym, envo.vreg, e.line, e.col)
}

pub fn lower_stmt(ctx: LowerCtx, s: @TStatement()): LowerStmtOut | error {
    match s {
        checker::TBinding as b => lower_binding(ctx, b)
        checker::TAssign as a => lower_assign(ctx, a)
        checker::TReturn as r => lower_return(ctx, r)
        checker::TExprStmt as es => lower_expr_stmt(ctx, es)
        checker::TLoopStmt as l => lower_loop(ctx, l)
        checker::TBreakStmt as b => lower_break(ctx, b)
        checker::TContinueStmt as c => lower_continue(ctx, c)
        checker::TDeferStmt as d => lower_defer(ctx, d)
        _ => error { message = teko::str::concat("native backend N1: ", tstmt_kind_name(s), " not yet lowered (N2)") }
    }
}

fn lower_binding(ctx: LowerCtx, b: checker::TBinding): LowerStmtOut | error {
    var name = match bind_target_name(b.target) { str as s => s; error as err => return err }
    match b.bound { checker::Reference => return bind_reference_local(ctx, b, name); _ => { } }
    if binding_conveys_escape(ctx.escaping, name) { return lower_binding_conveyed(ctx, b, name) }
    lower_binding_direct(register_scope_decl_name(ctx, name), b, name)
}

fn lower_binding_conveyed(ctx: LowerCtx, b: checker::TBinding, name: str): LowerStmtOut | error {
    if ctx.bracket_depth > 0 { return lower_binding_direct(ctx, b, name) }
    var left = emit_region_leaves(ctx, b.value.line, b.value.col)
    var marked = ctx_with_bracket_depth(left, 1)
    var out = match lower_binding_direct(marked, b, name) { LowerStmtOut as x => x; error as err => return err }
    var entered = emit_region_enters(out.ctx, b.value.line, b.value.col)
    LowerStmtOut { ctx = ctx_with_bracket_depth(entered, ctx.bracket_depth); terminated = out.terminated }
}

type SliceWidenPlan = struct {
    mode: i32
    stride: u64
    pcopy: u64
}

fn slice_widen_plan(u: @Type(), ctx: LowerCtx): SliceWidenPlan | error {
    match u {
        checker::Null => return SliceWidenPlan { mode = 3 to i32; stride = ltype_size(ltype_of(u, ctx.enums)) to u64; pcopy = 0 to u64 }
        _ => { }
    }
    if is_fat_type(u) {
        return SliceWidenPlan { mode = 1 to i32; stride = 16 to u64; pcopy = 16 to u64 }
    }
    if is_register_value_type(u, ctx.enums) {
        var w = ltype_size(ltype_of(u, ctx.enums)) to u64
        return SliceWidenPlan { mode = 0 to i32; stride = w; pcopy = w }
    }
    match aggregate_box_bytes(u, ctx) {
        u32 as n => SliceWidenPlan { mode = 2 to i32; stride = 8 to u64; pcopy = n to u64 }
        null => unsized_aggregate_push_stop(aggregate_form_name(u))
    }
}

fn slice_element_of(t: @Type()): @Type() | null {
    match t {
        checker::Slice as s => match s.element { checker::Void => null; _ => s.element }
        _ => null
    }
}

fn slice_widen_member_tag(vwide: checker::Variant, u: @Type()): u32 | null {
    match u {
        checker::Null => variant_null_member_index(vwide)
        _ => direct_variant_member_index(vwide.members, u)
    }
}

fn lower_fat_expr_into_type(ctx: LowerCtx, bound: @Type(), value: checker::TExpr): LoweredFat | error {
    var bel = match slice_element_of(bound) { (@Type()) as t => t; null => return lower_fat_expr(ctx, value) }
    var uel = match slice_element_of(value.type) { (@Type()) as t => t; null => return lower_fat_expr(ctx, value) }
    var vwide = match expand_named_variant(bel, ctx.variants) { checker::Variant as v => v; _ => return lower_fat_expr(ctx, value) }
    var tag = match slice_widen_member_tag(vwide, uel) { u32 as ix => ix; null => return lower_fat_expr(ctx, value) }
    var plan = match slice_widen_plan(uel, ctx) { SliceWidenPlan as p => p; error as err => return err }
    var fat = match lower_fat_expr(ctx, value) { LoweredFat as x => x; error as err => return err }
    var sc = ctx_alloc(fat.ctx)
    var with_stride = ctx_append(sc.ctx, const_int_inst(sc.vreg, plan.stride to i64, value.line, value.col))
    var tc = ctx_alloc(with_stride)
    var with_tag = ctx_append(tc.ctx, const_int_inst(tc.vreg, tag to i64, value.line, value.col))
    var mc = ctx_alloc(with_tag)
    var with_mode = ctx_append(mc.ctx, const_int_inst(mc.vreg, plan.mode to i64, value.line, value.col))
    var pc = ctx_alloc(with_mode)
    var with_pcopy = ctx_append(pc.ctx, const_int_inst(pc.vreg, plan.pcopy to i64, value.line, value.col))
    var rc = ctx_alloc(with_pcopy)
    var args: []u32 = []
    args = [..args, fat.ptr]
    args = [..args, fat.len]
    args = [..args, sc.vreg]
    args = [..args, tc.vreg]
    args = [..args, mc.vreg]
    args = [..args, pc.vreg]
    var with_call = ctx_append(rc.ctx, call_inst(rc.vreg, "tk_slice_variant_widen", args, false, value.line, value.col))
    LoweredFat { ctx = with_call; ptr = rc.vreg; len = fat.len }
}

fn lower_binding_direct(ctx: LowerCtx, b: checker::TBinding, name: str): LowerStmtOut | error {
    if is_fat_type(b.bound) {
        var fo = match lower_fat_expr_into_type(ctx, b.bound, b.value) { LoweredFat as x => x; error as err => return err }
        if b.kind == parser::BindKind::Var { return bind_mutable_fat(fo, name, b.value.line, b.value.col) }
        return LowerStmtOut { ctx = ctx_bind_fat(fo.ctx, name, fo.ptr, fo.len); terminated = false }
    }
    var raw = match lower_value_into_type(ctx, b.bound, b.value) { Lowered as x => x; error as err => return err }
    var lo = own_bound_value(raw, b.value)
    if needs_scalar_slot(lo.ctx, name, b.bound) { return bind_addr_taken_scalar(lo, name, b.bound, b.value.line, b.value.col) }
    LowerStmtOut { ctx = ctx_bind(lo.ctx, name, lo.vreg); terminated = false }
}

fn needs_scalar_slot(ctx: LowerCtx, name: str, ty: @Type()): bool {
    contains_str(ctx.addr_taken, name) && is_register_value_type(ty, ctx.enums)
}

fn bind_reference_local(ctx: LowerCtx, b: checker::TBinding, name: str): LowerStmtOut | error {
    var lo = match lower_value_into_reference(ctx, b.value) { Lowered as x => x; error as err => return err }
    LowerStmtOut { ctx = ctx_bind(lo.ctx, name, lo.vreg); terminated = false }
}

fn bind_addr_taken_scalar(lo: Lowered, name: str, ty: @Type(), line: u32, col: u32): LowerStmtOut {
    var lt = ltype_of(ty, lo.ctx.enums)
    var slot = ctx_alloc(lo.ctx)
    var with_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, ltype_size(lt), ltype_align(lt), line, col))
    var with_store = ctx_append(with_alloca, store_inst(slot.vreg, lo.vreg, lt, line, col))
    LowerStmtOut { ctx = ctx_bind_scalar_slot(with_store, name, slot.vreg, lt); terminated = false }
}

fn bind_mutable_fat(fo: LoweredFat, name: str, line: u32, col: u32): LowerStmtOut {
    var slot = alloc_fat_slot(fo.ctx, fo, line, col)
    var bound = ctx_with(slot.ctx, slot.ctx.func, slot.ctx.block_id, lenv_bind_fat_slot(slot.ctx.env, name, slot.vreg))
    LowerStmtOut { ctx = bound; terminated = false }
}

fn lower_value_into_type(ctx: LowerCtx, bound: @Type(), value: checker::TExpr): Lowered | error {
    match bound { checker::Reference => return lower_value_into_reference(ctx, value); _ => { } }
    match expand_named_variant(bound, ctx.variants) {
        checker::Variant as v => {
            match arm_join_retag_into(bound, v, value, ctx) {
                checker::TExpr as retagged => return lower_expr(ctx, retagged)
                null => { }
            }
            match null_union_shape(v) {
                NullUnionShape as shape => lower_value_into_null_union(ctx, shape, value)
                null => lower_value_into_variant(ctx, v, value)
            }
        }
        _ => lower_expr(ctx, value)
    }
}

fn arm_join_retag_into(bound: @Type(), v: checker::Variant, value: checker::TExpr, ctx: LowerCtx): checker::TExpr | null {
    var is_join = match value.kind { checker::TMatchExpr => true; checker::TIfExpr => true; _ => false }
    if !is_join { return null }
    match expand_named_variant(value.type, ctx.variants) {
        checker::Variant as nt => {
            if variant_tag_layout_matches(nt, v, ctx.variants) { return null }
            if !variant_all_members_reach(nt.members, v, ctx.variants) { return null }
            checker::TExpr { kind = value.kind; type = bound; line = value.line; col = value.col }
        }
        _ => null
    }
}

fn variant_tag_layout_matches(nt: checker::Variant, v: checker::Variant, variants: []LVariantDef): bool {
    if nt.members.len != v.members.len { return false }
    var j: u64 = 0
    loop {
        if j >= nt.members.len { break }
        if !variant_member_type_matches(v.members[j], nt.members[j], variants) { return false }
        j++
    }
    true
}

fn variant_all_members_reach(members: []@Type(), v: checker::Variant, variants: []LVariantDef): bool {
    var j: u64 = 0
    loop {
        if j >= members.len { break }
        if !variant_any_member_matches(v.members, members[j], variants) { return false }
        j++
    }
    true
}

fn lower_value_into_reference(ctx: LowerCtx, value: checker::TExpr): Lowered | error {
    match value.type { checker::Reference => return lower_expr(ctx, value); _ => { } }
    lower_addr_of_place(ctx, value)
}

fn lower_value_into_null_union(ctx: LowerCtx, shape: NullUnionShape, value: checker::TExpr): Lowered | error {
    match expand_named_variant(value.type, ctx.variants) {
        checker::Variant => {
            if variant_member_type_matches(shape.payload, value.type, ctx.variants) {
                return lower_null_union_construct(ctx, shape, value)
            }
            lower_expr(ctx, value)
        }
        _ => lower_null_union_construct(ctx, shape, value)
    }
}

fn lower_value_into_variant(ctx: LowerCtx, v: checker::Variant, value: checker::TExpr): Lowered | error {
    match value.type {
        checker::Null => return lower_variant_null_construct(ctx, v, value)
        _ => { }
    }
    if variant_any_member_matches(v.members, value.type, ctx.variants) {
        return lower_variant_construct(ctx, v, value)
    }
    match expand_named_variant(value.type, ctx.variants) {
        checker::Variant as nt => {
            if nt.members.len < v.members.len && variant_all_members_in(nt.members, v, ctx.variants) {
                return lower_subset_variant_widen(ctx, v, nt, value)
            }
            lower_expr(ctx, value)
        }
        _ => lower_variant_construct(ctx, v, value)
    }
}

fn variant_all_members_in(nt_members: []@Type(), v: checker::Variant, variants: []LVariantDef): bool {
    var i: u64 = 0
    loop {
        if i >= nt_members.len { break }
        match variant_index_of_member_type(v.members, nt_members[i], variants) {
            u32 => { }
            error => return false
        }
        i++
    }
    true
}

fn lower_subset_variant_widen(ctx: LowerCtx, v: checker::Variant, nt: checker::Variant, value: checker::TExpr): Lowered | error {
    var line = value.line
    var col = value.col
    var nw = match lower_expr(ctx, value) { Lowered as x => x; error as err => return err }
    var ta = ctx_alloc(nw.ctx)
    var c_ta = ctx_append(ta.ctx, field_addr_inst(ta.vreg, nw.vreg, 0, line, col))
    var tg = ctx_alloc(c_ta)
    var c_tg = ctx_append(tg.ctx, load_inst(tg.vreg, ta.vreg, LType::I32, line, col))
    var p8a = ctx_alloc(c_tg)
    var c_p8a = ctx_append(p8a.ctx, field_addr_inst(p8a.vreg, nw.vreg, variant_payload_offset(), line, col))
    var p8 = ctx_alloc(c_p8a)
    var c_p8 = ctx_append(p8.ctx, load_inst(p8.vreg, p8a.vreg, LType::Ptr, line, col))
    var p16a = ctx_alloc(c_p8)
    var c_p16a = ctx_append(p16a.ctx, field_addr_inst(p16a.vreg, nw.vreg, variant_payload_len_offset(), line, col))
    var p16 = ctx_alloc(c_p16a)
    var c_p16 = ctx_append(p16.ctx, load_inst(p16.vreg, p16a.vreg, LType::Ptr, line, col))
    var slot = ctx_alloc(c_p16)
    var c_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, variant_wrapper_bytes(), variant_wrapper_align(), line, col))
    var w8a = ctx_alloc(c_alloca)
    var c_w8a = ctx_append(w8a.ctx, field_addr_inst(w8a.vreg, slot.vreg, variant_payload_offset(), line, col))
    var c_w8 = ctx_append(c_w8a, store_inst(w8a.vreg, p8.vreg, LType::Ptr, line, col))
    var w16a = ctx_alloc(c_w8)
    var c_w16a = ctx_append(w16a.ctx, field_addr_inst(w16a.vreg, slot.vreg, variant_payload_len_offset(), line, col))
    var c_w16 = ctx_append(c_w16a, store_inst(w16a.vreg, p16.vreg, LType::Ptr, line, col))
    var wt = match compute_widened_tag(c_w16, nt, v, tg.vreg, line, col) { Lowered as x => x; error as err => return err }
    var wta = ctx_alloc(wt.ctx)
    var c_wta = ctx_append(wta.ctx, field_addr_inst(wta.vreg, slot.vreg, 0, line, col))
    var c_wtag = ctx_append(c_wta, store_inst(wta.vreg, wt.vreg, LType::I32, line, col))
    Lowered { ctx = c_wtag; vreg = slot.vreg }
}

fn compute_widened_tag(ctx: LowerCtx, nt: checker::Variant, v: checker::Variant, tag_vreg: u32, line: u32, col: u32): Lowered | error {
    var z = ctx_alloc(ctx)
    var cur = ctx_append(z.ctx, const_int_inst(z.vreg, 0, line, col))
    var acc = z.vreg
    var j: u64 = 0
    loop {
        if j >= nt.members.len { break }
        var k = match variant_index_of_member_type(v.members, nt.members[j], cur.variants) { u32 as x => x to i64; error as err => return err }
        var jc = ctx_alloc(cur)
        var c_jc = ctx_append(jc.ctx, const_int_inst(jc.vreg, j to i64, line, col))
        var eq = ctx_alloc(c_jc)
        var c_eq = ctx_append(eq.ctx, bin_inst(eq.vreg, LBinOp::ICmpEq, tag_vreg, jc.vreg, line, col))
        var kc = ctx_alloc(c_eq)
        var c_kc = ctx_append(kc.ctx, const_int_inst(kc.vreg, k, line, col))
        var term = ctx_alloc(c_kc)
        var c_term = ctx_append(term.ctx, bin_inst(term.vreg, LBinOp::IMul, eq.vreg, kc.vreg, line, col))
        var nacc = ctx_alloc(c_term)
        cur = ctx_append(nacc.ctx, bin_inst(nacc.vreg, LBinOp::IAdd, acc, term.vreg, line, col))
        acc = nacc.vreg
        j++
    }
    Lowered { ctx = cur; vreg = acc }
}

fn lower_variant_null_construct(ctx: LowerCtx, v: checker::Variant, e: checker::TExpr): Lowered | error {
    match variant_null_member_index(v) {
        u32 as index => lower_null_absent_widened(ctx, index, e)
        null => error { message = "native backend N1: a `null` value placed into a union that declares no `null` member (internal)" }
    }
}

fn bind_target_name(t: @BindTarget()): str | error {
    match t {
        parser::SimpleName as sn => sn.name
        _ => error { message = "native backend N1: destructuring binding not yet lowered (N2)" }
    }
}

fn lower_return(ctx: LowerCtx, r: checker::TReturn): LowerStmtOut | error {
    var replayed = match replay_defers(ctx, 0) { LowerCtx as c => c; error as err => return err }
    var left = emit_region_leaves(replayed, r.value.line, r.value.col)
    if !r.has_value {
        var dropped = emit_region_drops(left, r.value.line, r.value.col)
        var vinst = ret_void_inst(r.value.line, r.value.col)
        return LowerStmtOut { ctx = ctx_append(dropped, vinst); terminated = true }
    }
    if is_fat_type(left.ret_type) { return lower_return_fat(left, r) }
    var marked = ctx_with_bracket_depth(left, 1)
    var lo = match lower_return_value(marked, r.value) { Lowered as x => x; error as err => return err }
    var owned = own_returned_value(lo, r.value.line, r.value.col)
    var restored = ctx_with_bracket_depth(owned.ctx, ctx.bracket_depth)
    var dropped = emit_region_drops(restored, r.value.line, r.value.col)
    var inst = ret_inst(owned.vreg, r.value.line, r.value.col)
    LowerStmtOut { ctx = ctx_append(dropped, inst); terminated = true }
}

fn lower_return_fat(ctx: LowerCtx, r: checker::TReturn): LowerStmtOut | error {
    if !ctx.has_ret_len_slot { return error { message = "native backend N1: a fat-typed lambda return is not yet lowered (N2)" } }
    var marked = ctx_with_bracket_depth(ctx, 1)
    var fo = match lower_fat_expr_into_type(marked, marked.ret_type, r.value) { LoweredFat as x => x; error as err => return err }
    var restored = ctx_with_bracket_depth(fo.ctx, ctx.bracket_depth)
    var stored = ctx_append(restored, store_inst(restored.ret_len_slot, fo.len, LType::I64, r.value.line, r.value.col))
    var dropped = emit_region_drops(stored, r.value.line, r.value.col)
    LowerStmtOut { ctx = ctx_append(dropped, ret_inst(fo.ptr, r.value.line, r.value.col)); terminated = true }
}

fn lower_return_value(ctx: LowerCtx, value: checker::TExpr): Lowered | error {
    if type_is_void(value.type) { return lower_expr(ctx, value) }
    lower_value_into_type(ctx, ctx.ret_type, value)
}

fn lower_expr_stmt(ctx: LowerCtx, es: checker::TExprStmt): LowerStmtOut | error {
    if checker::texpr_diverges(es.expr) {
        var replayed = match replay_defers(ctx, 0) { LowerCtx as c => c; error as err => return err }
        var lo = match lower_expr(replayed, es.expr) { Lowered as x => x; error as err => return err }
        var closed = match terminate_diverging_stmt(lo.ctx, es.expr.line, es.expr.col) { LowerCtx as c => c; error as err => return err }
        return LowerStmtOut { ctx = closed; terminated = true }
    }
    var lo = match lower_expr(ctx, es.expr) { Lowered as x => x; error as err => return err }
    LowerStmtOut { ctx = lo.ctx; terminated = false }
}

fn terminate_diverging_stmt(ctx: LowerCtx, line: u32, col: u32): LowerCtx | error {
    if is_fat_type(ctx.ret_type) { return terminate_diverging_fat(ctx, line, col) }
    var ret_ty = ltype_of(ctx.ret_type, ctx.enums)
    if ltype_is_void(ret_ty) { return ctx_append(ctx, ret_void_inst(line, col)) }
    var r = ctx_alloc(ctx)
    var with_const = ctx_append(r.ctx, const_int_inst(r.vreg, lfallback_const(ret_ty), line, col))
    ctx_append(with_const, ret_inst(r.vreg, line, col))
}

fn terminate_diverging_fat(ctx: LowerCtx, line: u32, col: u32): LowerCtx | error {
    if !ctx.has_ret_len_slot { return error { message = "native backend N1: a fat-typed lambda return is not yet lowered (N2)" } }
    var fv = diverging_tail_value_fat(ctx)
    var stored = ctx_append(fv.ctx, store_inst(fv.ctx.ret_len_slot, fv.len, LType::I64, line, col))
    ctx_append(stored, ret_inst(fv.ptr, line, col))
}

fn lower_defer(ctx: LowerCtx, d: checker::TDeferStmt): LowerStmtOut {
    LowerStmtOut { ctx = ctx_with_defers(ctx, [..ctx.defers, d]); terminated = false }
}

fn replay_defers(ctx: LowerCtx, floor: u64): LowerCtx | error {
    var cur = ctx
    var i: u64 = ctx.defers.len
    loop {
        if i <= floor { break }
        i = i - 1
        cur = match lower_block(cur, ctx.defers[i].body) { LowerCtx as c => c; error as err => return err }
    }
    cur
}

pub type PromotedEnv = struct { func: LFunc; env: LEnv; names: []str }

fn promote_env(f: LFunc, block_id: u32, env: LEnv): PromotedEnv {
    var cur_f = f
    var new_env = empty_lenv()
    var names: [env.names.len]str = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= env.names.len { break }
        if env.has_len[i] {
            new_env = lenv_bind_fat(new_env, env.names[i], env.vregs[i], env.len_vregs[i])
        } else {
            var bp = add_block_param(cur_f, block_id)
            cur_f = bp.func
            new_env = rebind_promoted(new_env, env, i, bp.vreg)
            names[count] = env.names[i]
            count++
        }
        i++
    }
    PromotedEnv { func = cur_f; env = new_env; names = names[0..count] }
}

fn rebind_promoted(out: LEnv, env: LEnv, i: u64, vreg: u32): LEnv {
    if env.is_slot[i] { return lenv_bind_fat_slot(out, env.names[i], vreg) }
    if env.is_scalar_slot[i] { return lenv_bind_scalar_slot(out, env.names[i], vreg, env.slot_ltype[i]) }
    lenv_bind(out, env.names[i], vreg)
}

fn env_scalar_vregs(env: LEnv): []u32 {
    var out: [env.names.len]u32 = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= env.names.len { break }
        if !env.has_len[i] {
            out[count] = env.vregs[i]
            count++
        }
        i++
    }
    out[0..count]
}

fn jump_args_for_names(env: LEnv, names: []str): []u32 {
    var out: [names.len]u32 = []
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        out[i] = lenv_lookup(env, names[i]).vreg
        i++
    }
    out
}

fn merge_scalar_indices(env: LEnv, names: []str): []u64 {
    var out: [names.len]u64 = []
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        out[i] = lenv_newest_index(env, names[i])
        i++
    }
    out
}

fn arm_scalar_args(arm_env: LEnv, indices: []u64): []u32 {
    var out: [indices.len]u32 = []
    var i: u64 = 0
    loop {
        if i >= indices.len { break }
        out[i] = arm_env.vregs[indices[i]]
        i++
    }
    out
}

fn contains_str(xs: []str, s: str): bool {
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == s { return true }
        i++
    }
    false
}

fn collect_reassigned_stmts(stmts: []@TStatement(), acc: []str): []str {
    var out = acc
    var i: u64 = 0
    loop {
        if i >= stmts.len { break }
        out = collect_reassigned_stmt(stmts[i], out)
        i++
    }
    out
}

fn collect_reassigned_stmt(s: @TStatement(), acc: []str): []str {
    match s {
        checker::TAssign as a => match a.kind { parser::AssignKind::Simple => [..acc, a.name]; _ => acc }
        checker::TBinding as b => collect_reassigned_value_expr(b.value, acc)
        checker::TExprStmt as es => collect_reassigned_expr_stmt(es.expr, acc)
        checker::TLoopStmt as l => collect_reassigned_stmts(l.body, collect_reassigned_stmts(l.init, acc))
        checker::TDeferStmt as d => collect_reassigned_stmts(d.body, acc)
        _ => acc
    }
}

fn collect_reassigned_expr_stmt(e: checker::TExpr, acc: []str): []str {
    match e.kind {
        checker::TIfExpr as f => collect_reassigned_if(f, acc)
        checker::TMatchExpr as m => collect_reassigned_match(m, acc)
        _ => acc
    }
}

fn collect_reassigned_value_expr(e: checker::TExpr, acc: []str): []str {
    match e.kind {
        checker::TIfExpr as f => collect_reassigned_if(f, acc)
        checker::TMatchExpr as m => collect_reassigned_match(m, acc)
        _ => acc
    }
}

fn collect_reassigned_if(f: checker::TIfExpr, acc: []str): []str {
    var after_then = collect_reassigned_stmts(f.then_blk, acc)
    if f.has_else { return collect_reassigned_stmts(f.else_blk, after_then) }
    after_then
}

fn collect_reassigned_match(m: checker::TMatchExpr, acc: []str): []str {
    var out = acc
    var i: u64 = 0
    loop {
        if i >= m.arms.len { break }
        out = collect_reassigned_stmts(m.arms[i].body, out)
        i++
    }
    out
}

fn collect_addr_taken_locals(body: []@TStatement(), ref_fns: []LRefFnInfo, enums: []LEnumInfo): []str {
    addr_taken_stmts(body, ref_fns, enums, [])
}

fn arg_needs_addr_slot(arg: checker::TExpr, enums: []LEnumInfo): bool {
    if !arg_needs_auto_ref(arg) { return false }
    var is_var = match arg.kind { checker::TVar => true; _ => false }
    is_var && is_register_value_type(arg.type, enums)
}

fn addr_taken_stmts(stmts: []@TStatement(), ref_fns: []LRefFnInfo, enums: []LEnumInfo, acc: []str): []str {
    var out = acc
    var i: u64 = 0
    loop {
        if i >= stmts.len { break }
        out = addr_taken_stmt(stmts[i], ref_fns, enums, out)
        i++
    }
    out
}

fn addr_taken_stmt(s: @TStatement(), ref_fns: []LRefFnInfo, enums: []LEnumInfo, acc: []str): []str {
    match s {
        checker::TBinding as b => addr_taken_expr(b.value, ref_fns, enums, addr_taken_ref_binding(b, acc))
        checker::TAssign as a => addr_taken_expr(a.value, ref_fns, enums, acc)
        checker::TReturn as r => if r.has_value { addr_taken_expr(r.value, ref_fns, enums, acc) } else { acc }
        checker::TExprStmt as es => addr_taken_expr(es.expr, ref_fns, enums, acc)
        checker::TLoopStmt as l => addr_taken_stmts(l.body, ref_fns, enums, addr_taken_stmts(l.init, ref_fns, enums, acc))
        checker::TDeferStmt as d => addr_taken_stmts(d.body, ref_fns, enums, acc)
        checker::TAdoptStmt as ad => addr_taken_stmts(ad.body, ref_fns, enums, acc)
        checker::TBlockStmt as b => addr_taken_stmts(b.body, ref_fns, enums, acc)
        _ => acc
    }
}

fn addr_taken_expr(e: checker::TExpr, ref_fns: []LRefFnInfo, enums: []LEnumInfo, acc: []str): []str {
    match e.kind {
        checker::TBinary as b => addr_taken_expr(b.right, ref_fns, enums, addr_taken_expr(b.left, ref_fns, enums, acc))
        checker::TUnary as u => addr_taken_expr(u.operand, ref_fns, enums, acc)
        checker::TCompare as c => addr_taken_compare(c, ref_fns, enums, addr_taken_expr(c.first, ref_fns, enums, acc))
        checker::TCall as c => addr_taken_call_args(c.args, ref_fns, enums, addr_taken_call(c, ref_fns, enums, acc))
        checker::TIfExpr as f => addr_taken_if(f, ref_fns, enums, addr_taken_expr(f.cond, ref_fns, enums, acc))
        checker::TMatchExpr as m => addr_taken_match(m, ref_fns, enums, addr_taken_expr(m.subject, ref_fns, enums, acc))
        checker::TCast as c => addr_taken_expr(c.expr, ref_fns, enums, acc)
        checker::TFieldAccess as fa => addr_taken_expr(fa.receiver, ref_fns, enums, acc)
        checker::TStructInit as si => addr_taken_expr_list(si.field_vals, ref_fns, enums, acc)
        checker::TIndex as ix => addr_taken_expr(ix.index, ref_fns, enums, addr_taken_expr(ix.receiver, ref_fns, enums, acc))
        checker::TInterp as ip => addr_taken_interp(ip, ref_fns, enums, addr_taken_expr_list(ip.holes, ref_fns, enums, acc))
        checker::TInExpr as ine => addr_taken_expr_list(ine.elems, ref_fns, enums, addr_taken_expr(ine.lhs, ref_fns, enums, acc))
        checker::TArrayLit as al => addr_taken_array_elems(al.elements, ref_fns, enums, acc)
        checker::TLambda as lam => addr_taken_stmts(lam.body, ref_fns, enums, acc)
        checker::TBlockExpr as blk => addr_taken_stmts(blk.body, ref_fns, enums, acc)
        _ => acc
    }
}

fn addr_taken_expr_list(es: []checker::TExpr, ref_fns: []LRefFnInfo, enums: []LEnumInfo, acc: []str): []str {
    var out = acc
    var i: u64 = 0
    loop {
        if i >= es.len { break }
        out = addr_taken_expr(es[i], ref_fns, enums, out)
        i++
    }
    out
}

fn addr_taken_call(c: checker::TCall, ref_fns: []LRefFnInfo, enums: []LEnumInfo, acc: []str): []str {
    if c.callee.segments.len == 0 { return acc }
    var last = c.callee.segments[c.callee.segments.len - 1].name
    match find_ref_flags(ref_fns, c.call_ns, last) {
        []bool as rf => addr_taken_call_ref_args(c.args, rf, enums, 0, acc)
        null => acc
    }
}

fn addr_taken_call_ref_args(args: []checker::TExpr, rf: []bool, enums: []LEnumInfo, i: u64, acc: []str): []str {
    if i >= args.len || i >= rf.len { return acc }
    if !rf[i] || !arg_needs_addr_slot(args[i], enums) { return addr_taken_call_ref_args(args, rf, enums, i + 1, acc) }
    var name = match args[i].kind { checker::TVar as v => v.name; _ => "" }
    var out = if name.len > 0 && !contains_str(acc, name) { [..acc, name] } else { acc }
    addr_taken_call_ref_args(args, rf, enums, i + 1, out)
}

fn addr_taken_ref_binding(b: checker::TBinding, acc: []str): []str {
    if !ref_binding_takes_address(b) { return acc }
    var name = match b.value.kind { checker::TVar as v => v.name; _ => "" }
    if name.len == 0 || contains_str(acc, name) { return acc }
    [..acc, name]
}

fn ref_binding_takes_address(b: checker::TBinding): bool {
    match b.bound { checker::Reference => { }; _ => return false }
    match b.value.type { checker::Reference => return false; _ => { } }
    if is_fat_type(b.value.type) { return false }
    match b.value.kind { checker::TVar => true; _ => false }
}

fn addr_taken_call_args(args: []checker::TExpr, ref_fns: []LRefFnInfo, enums: []LEnumInfo, acc: []str): []str {
    addr_taken_expr_list(args, ref_fns, enums, acc)
}

fn addr_taken_compare(c: checker::TCompare, ref_fns: []LRefFnInfo, enums: []LEnumInfo, acc: []str): []str {
    var out = acc
    var i: u64 = 0
    loop {
        if i >= c.rest.len { break }
        out = addr_taken_expr(c.rest[i].operand, ref_fns, enums, out)
        i++
    }
    out
}

fn addr_taken_if(f: checker::TIfExpr, ref_fns: []LRefFnInfo, enums: []LEnumInfo, acc: []str): []str {
    var after_then = addr_taken_stmts(f.then_blk, ref_fns, enums, acc)
    if f.has_else { return addr_taken_stmts(f.else_blk, ref_fns, enums, after_then) }
    after_then
}

fn addr_taken_match(m: checker::TMatchExpr, ref_fns: []LRefFnInfo, enums: []LEnumInfo, acc: []str): []str {
    var out = acc
    var i: u64 = 0
    loop {
        if i >= m.arms.len { break }
        var arm = m.arms[i]
        if arm.has_when { out = addr_taken_expr(arm.guard, ref_fns, enums, out) }
        out = addr_taken_stmts(arm.body, ref_fns, enums, out)
        i++
    }
    out
}

fn addr_taken_array_elems(elems: []checker::TArrayElem, ref_fns: []LRefFnInfo, enums: []LEnumInfo, acc: []str): []str {
    var out = acc
    var i: u64 = 0
    loop {
        if i >= elems.len { break }
        out = addr_taken_expr(elems[i].expr, ref_fns, enums, out)
        i++
    }
    out
}

fn addr_taken_interp(ip: checker::TInterp, ref_fns: []LRefFnInfo, enums: []LEnumInfo, acc: []str): []str {
    var out = acc
    var i: u64 = 0
    loop {
        if i >= ip.specs.len { break }
        match ip.specs[i].kind {
            checker::TFSpecDynamic as d => out = addr_taken_expr_list(d.args, ref_fns, enums, out)
            _ => { }
        }
        i++
    }
    out
}

fn append_all_u32(acc: []u32, xs: []u32): []u32 {
    var out: [acc.len + xs.len]u32 = []
    var i: u64 = 0
    loop {
        if i >= acc.len { break }
        out[i] = acc[i]
        i++
    }
    var j: u64 = 0
    loop {
        if j >= xs.len { break }
        out[acc.len + j] = xs[j]
        j++
    }
    out
}

fn reassigned_scalars(arms: []@TStatement(), env: LEnv): []str {
    var raw = collect_reassigned_stmts(arms, [])
    var out: [env.names.len]str = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= env.names.len { break }
        if !env.has_len[i] && contains_str(raw, env.names[i]) && !contains_str(out[0..count], env.names[i]) {
            out[count] = env.names[i]
            count++
        }
        i++
    }
    out[0..count]
}

fn reassigned_scalars_for_match(arms: []checker::TArm, env: LEnv): []str {
    reassigned_scalars(match_arm_stmts(arms), env)
}

fn merge_param_for(names: []str, vregs: []u32, name: str): LLookup {
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        if names[i] == name { return LLookup { found = true; vreg = vregs[i] } }
        i++
    }
    LLookup { found = false; vreg = 0 }
}

fn rebind_scalars(env: LEnv, names: []str, vregs: []u32): LEnv {
    var out = empty_lenv()
    var i: u64 = 0
    loop {
        if i >= env.names.len { break }
        if env.has_len[i] {
            out = lenv_bind_fat(out, env.names[i], env.vregs[i], env.len_vregs[i])
        } else {
            var p = merge_param_for(names, vregs, env.names[i])
            out = rebind_promoted(out, env, i, if p.found { p.vreg } else { env.vregs[i] })
        }
        i++
    }
    out
}

fn add_merge_scalar_params(f: LFunc, block_id: u32, env: LEnv, names: []str): PromotedEnv {
    var cur_f = f
    var param_vregs: [names.len]u32 = []
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        var bp = add_block_param(cur_f, block_id)
        cur_f = bp.func
        param_vregs[i] = bp.vreg
        i++
    }
    PromotedEnv { func = cur_f; env = rebind_scalars(env, names, param_vregs); names = names }
}

fn merge_value_args(value: u32, scalars: []u32): []u32 {
    var out: [1 + scalars.len]u32 = []
    out[0] = value
    var i: u64 = 0
    loop {
        if i >= scalars.len { break }
        out[1 + i] = scalars[i]
        i++
    }
    out
}

fn if_arm_stmts(f: checker::TIfExpr): []@TStatement() {
    if !f.has_else { return f.then_blk }
    var out: [f.then_blk.len + f.else_blk.len]@TStatement() = []
    var i: u64 = 0
    loop {
        if i >= f.then_blk.len { break }
        out[i] = f.then_blk[i]
        i++
    }
    var j: u64 = 0
    loop {
        if j >= f.else_blk.len { break }
        out[f.then_blk.len + j] = f.else_blk[j]
        j++
    }
    out
}

fn match_arm_stmts(arms: []checker::TArm): []@TStatement() {
    var total: u64 = 0
    var c: u64 = 0
    loop {
        if c >= arms.len { break }
        total = total + arms[c].body.len
        c++
    }
    var out: [total]@TStatement() = []
    var k: u64 = 0
    var i: u64 = 0
    loop {
        if i >= arms.len { break }
        var body = arms[i].body
        var j: u64 = 0
        loop {
            if j >= body.len { break }
            out[k] = body[j]
            k++
            j++
        }
        i++
    }
    out
}

fn find_loop_target(loops: []LoopTargets, label: str): LoopTargets | error {
    var i: u64 = loops.len
    loop {
        if i == 0 { break }
        i = i - 1
        var lt = loops[i]
        if label.len == 0 || lt.label == label { return lt }
    }
    error { message = "native backend N1: break/continue outside a loop (internal)" }
}

fn lower_break(ctx: LowerCtx, b: checker::TBreakStmt): LowerStmtOut | error {
    var target = match find_loop_target(ctx.loop_targets, b.label) { LoopTargets as t => t; error as err => return err }
    var replayed = match replay_defers(ctx, target.defer_base) { LowerCtx as c => c; error as err => return err }
    var unwound = match close_native_regions_to(replayed, target.region_base, 0, 0) { LowerCtx as c => c; error as err => return err }
    var args = jump_args_for_names(unwound.env, target.names)
    LowerStmtOut { ctx = ctx_append(unwound, jump_inst(target.exit, args, 0, 0)); terminated = true }
}

fn lower_continue(ctx: LowerCtx, c: checker::TContinueStmt): LowerStmtOut | error {
    var target = match find_loop_target(ctx.loop_targets, c.label) { LoopTargets as t => t; error as err => return err }
    var replayed = match replay_defers(ctx, target.defer_base) { LowerCtx as c2 => c2; error as err => return err }
    var unwound = match close_native_regions_to(replayed, target.region_base, 0, 0) { LowerCtx as c2 => c2; error as err => return err }
    var args = jump_args_for_names(unwound.env, target.names)
    LowerStmtOut { ctx = ctx_append(unwound, jump_inst(target.head, args, 0, 0)); terminated = true }
}

fn close_loop_body(ctx: LowerCtx, head: u32, names: []str, defer_base: u64): LowerCtx | error {
    if block_terminated(ctx.func, ctx.block_id) { return ctx }
    var replayed = match replay_defers(ctx, defer_base) { LowerCtx as c => c; error as err => return err }
    var closed = match close_native_region(replayed, 0, 0) { LowerCtx as c => c; error as err => return err }
    var args = jump_args_for_names(closed.env, names)
    ctx_append(closed, jump_inst(head, args, 0, 0))
}

fn close_loop(outer: LowerCtx, body_done: LowerCtx, exit_block: u32, exit_env: LEnv): LowerCtx {
    LowerCtx {
        func = body_done.func; block_id = exit_block; env = exit_env
        layouts = body_done.layouts; rodata = body_done.rodata; enums = body_done.enums; lifted = body_done.lifted
        variants = body_done.variants
        defers = outer.defers; loop_targets = outer.loop_targets; externs = body_done.externs
        flat_symbols = body_done.flat_symbols; ret_type = body_done.ret_type
        has_ret_len_slot = body_done.has_ret_len_slot; ret_len_slot = body_done.ret_len_slot
        ref_fns = body_done.ref_fns; field_decls = body_done.field_decls; addr_taken = body_done.addr_taken; table = body_done.table
        region_stack = outer.region_stack; escaping = body_done.escaping; frees_old_names = body_done.frees_old_names; bracket_depth = body_done.bracket_depth
        region_param = body_done.region_param; plan = body_done.plan; rodata_base = body_done.rodata_base; const_rodata = body_done.const_rodata; lifted_base = body_done.lifted_base
    }
}

fn lower_loop(ctx: LowerCtx, l: checker::TLoopStmt): LowerStmtOut | error {
    var ictx = match lower_block(ctx, l.init) { LowerCtx as c => c; error as err => return err }
    var headb = alloc_block(ictx.func)
    var exitb = alloc_block(headb.func)
    var head_seed = promote_env(exitb.func, headb.block_id, ictx.env)
    var exit_seed = promote_env(head_seed.func, exitb.block_id, ictx.env)
    var entry_args = env_scalar_vregs(ictx.env)
    var entered = append_inst(exit_seed.func, ictx.block_id, jump_inst(headb.block_id, entry_args, 0, 0))
    var defer_base = ictx.defers.len
    var target = LoopTargets { label = l.label; head = headb.block_id; exit = exitb.block_id; defer_base = defer_base; names = head_seed.names; region_base = ictx.region_stack.len }
    var body_seed = ctx_with_loops(ctx_with(ictx, entered, headb.block_id, head_seed.env), [..ictx.loop_targets, target])
    var region_opened = match open_native_region(body_seed, "", true, checker::scope_slot_count(l.body) == 0, 0, 0) { LowerCtx as c => c; error as err => return err }
    var body_done = match lower_block(region_opened, l.body) { LowerCtx as c => c; error as err => return err }
    var closed = match close_loop_body(body_done, headb.block_id, head_seed.names, defer_base) { LowerCtx as c => c; error as err => return err }
    LowerStmtOut { ctx = close_loop(ictx, closed, exitb.block_id, exit_seed.env); terminated = false }
}

fn ctx_goto(ctx: LowerCtx, block_id: u32): LowerCtx {
    ctx_with(ctx, ctx.func, block_id, ctx.env)
}

fn close_arm_to(ctx: LowerCtx, target: u32, args: []u32, line: u32, col: u32): LFunc {
    if block_terminated(ctx.func, ctx.block_id) { return ctx.func }
    append_inst(ctx.func, ctx.block_id, jump_inst(target, args, line, col))
}

pub type ClosedArm = struct { ctx: LowerCtx; func: LFunc }

fn close_arm_replaying_defers(ctx: LowerCtx, pre_arm_defers: []checker::TDeferStmt, pre_arm_regions: []NativeRegionFrame, target: u32, value_args: []u32, indices: []u64, line: u32, col: u32): ClosedArm | error {
    if block_terminated(ctx.func, ctx.block_id) {
        var reset_terminated = ctx_with_regions(ctx_with_defers(ctx, pre_arm_defers), pre_arm_regions)
        return ClosedArm { ctx = reset_terminated; func = ctx.func }
    }
    var replayed = match replay_defers(ctx, pre_arm_defers.len) { LowerCtx as c => c; error as err => return err }
    var region_closed = match close_native_region(replayed, line, col) { LowerCtx as c => c; error as err => return err }
    var reset = ctx_with_regions(ctx_with_defers(region_closed, pre_arm_defers), pre_arm_regions)
    var args = append_all_u32(value_args, arm_scalar_args(reset.env, indices))
    ClosedArm { ctx = reset; func = close_arm_to(reset, target, args, line, col) }
}

pub type LowerBlockValue = struct { ctx: LowerCtx; terminated: bool; vreg: u32 }

fn lower_block_prefix(ctx: LowerCtx, body: []@TStatement()): LowerStmtOut | error {
    var cur = ctx
    var i: u64 = 0
    loop {
        if i + 1 >= body.len { break }
        var out = match lower_stmt(cur, body[i]) { LowerStmtOut as x => x; error as err => return err }
        cur = out.ctx
        if out.terminated { return LowerStmtOut { ctx = cur; terminated = true } }
        i++
    }
    LowerStmtOut { ctx = cur; terminated = false }
}

fn lower_block_value(ctx: LowerCtx, body: []@TStatement(), result_ty: LType, target_ty: @Type()): LowerBlockValue | error {
    if body.len == 0 { return error { message = "native backend N1: empty if-expression arm (internal)" } }
    var pre = match lower_block_prefix(ctx, body) { LowerStmtOut as x => x; error as err => return err }
    if pre.terminated { return LowerBlockValue { ctx = pre.ctx; terminated = true; vreg = 0 } }
    lower_tail_stmt(pre.ctx, body[body.len - 1], result_ty, target_ty)
}

fn lower_tail_stmt(ctx: LowerCtx, s: @TStatement(), result_ty: LType, target_ty: @Type()): LowerBlockValue | error {
    match s {
        checker::TExprStmt as es => lower_tail_expr_stmt(ctx, es, result_ty, target_ty)
        _ => lower_tail_non_expr(ctx, s, result_ty)
    }
}

fn lower_fn_tail(ctx: LowerCtx, s: @TStatement(), result_ty: LType, target_ty: @Type(), line: u32, col: u32): LowerBlockValue | error {
    match s {
        checker::TExprStmt as es => lower_conveyed_tail_expr_stmt(ctx, es, result_ty, target_ty, line, col)
        _ => lower_tail_non_expr(ctx, s, result_ty)
    }
}

fn lower_conveyed_tail_expr_stmt(ctx: LowerCtx, es: checker::TExprStmt, result_ty: LType, target_ty: @Type(), line: u32, col: u32): LowerBlockValue | error {
    if ctx.bracket_depth > 0 { return lower_tail_expr_stmt(ctx, es, result_ty, target_ty) }
    var left = emit_region_leaves(ctx, line, col)
    var marked = ctx_with_bracket_depth(left, 1)
    var out = match lower_tail_expr_stmt(marked, es, result_ty, target_ty) { LowerBlockValue as x => x; error as err => return err }
    var entered = emit_region_enters(out.ctx, line, col)
    LowerBlockValue { ctx = ctx_with_bracket_depth(entered, ctx.bracket_depth); terminated = out.terminated; vreg = out.vreg }
}

fn lower_tail_expr_stmt(ctx: LowerCtx, es: checker::TExprStmt, result_ty: LType, target_ty: @Type()): LowerBlockValue | error {
    if type_is_void(es.expr.type) {
        var diverging = match lower_expr(ctx, es.expr) { Lowered as x => x; error as err => return err }
        return diverging_tail_value(diverging.ctx, result_ty)
    }
    var lo = match lower_value_into_type(ctx, target_ty, es.expr) { Lowered as x => x; error as err => return err }
    LowerBlockValue { ctx = lo.ctx; terminated = false; vreg = lo.vreg }
}

fn diverging_tail_value(ctx: LowerCtx, result_ty: LType): LowerBlockValue {
    var r = ctx_alloc(ctx)
    var with_const = ctx_append(r.ctx, const_int_inst(r.vreg, lfallback_const(result_ty), 0, 0))
    LowerBlockValue { ctx = with_const; terminated = false; vreg = r.vreg }
}

fn lower_tail_non_expr(ctx: LowerCtx, s: @TStatement(), result_ty: LType): LowerBlockValue | error {
    var out = match lower_stmt(ctx, s) { LowerStmtOut as x => x; error as err => return err }
    if out.terminated { return LowerBlockValue { ctx = out.ctx; terminated = true; vreg = 0 } }
    diverging_tail_value(out.ctx, result_ty)
}

fn lower_if_expr(ctx: LowerCtx, e: checker::TExpr, f: checker::TIfExpr): Lowered | error {
    var co = match lower_expr(ctx, f.cond) { Lowered as x => x; error as err => return err }
    if type_is_void(e.type) { return lower_if_stmt(co.ctx, e, f, co.vreg) }
    lower_if_value(co.ctx, e, f, co.vreg)
}

fn lower_if_stmt(ctx: LowerCtx, e: checker::TExpr, f: checker::TIfExpr, cond_vreg: u32): Lowered | error {
    var names = reassigned_scalars(if_arm_stmts(f), ctx.env)
    var indices = merge_scalar_indices(ctx.env, names)
    var thenb = alloc_block(ctx.func)
    var elseb = alloc_block(thenb.func)
    var mergeblk = alloc_block(elseb.func)
    var merged = add_merge_scalar_params(mergeblk.func, mergeblk.block_id, ctx.env, names)
    var br = branch_inst(cond_vreg, thenb.block_id, [], elseb.block_id, [], e.line, e.col)
    var ctx1 = ctx_append(ctx_with(ctx, merged.func, ctx.block_id, ctx.env), br)
    var then_opened = match open_native_region(ctx_goto(ctx1, thenb.block_id), "", false, checker::scope_slot_count(f.then_blk) == 0, e.line, e.col) { LowerCtx as c => c; error as err => return err }
    var then_done = match lower_block(then_opened, f.then_blk) { LowerCtx as c => c; error as err => return err }
    var then_closed = match close_arm_replaying_defers(then_done, ctx1.defers, ctx1.region_stack, mergeblk.block_id, [], indices, e.line, e.col) { ClosedArm as c => c; error as err => return err }
    var else_ctx = ctx_with(then_closed.ctx, then_closed.func, elseb.block_id, ctx.env)
    var else_opened = match open_native_region(else_ctx, "", false, checker::scope_slot_count(f.else_blk) == 0, e.line, e.col) { LowerCtx as c => c; error as err => return err }
    var else_done = if f.has_else { match lower_block(else_opened, f.else_blk) { LowerCtx as c => c; error as err => return err } } else { else_opened }
    var else_closed = match close_arm_replaying_defers(else_done, ctx1.defers, ctx1.region_stack, mergeblk.block_id, [], indices, e.line, e.col) { ClosedArm as c => c; error as err => return err }
    Lowered { ctx = ctx_with(else_closed.ctx, else_closed.func, mergeblk.block_id, merged.env); vreg = 0 }
}

fn lower_if_value(ctx: LowerCtx, e: checker::TExpr, f: checker::TIfExpr, cond_vreg: u32): Lowered | error {
    if !f.has_else { return error { message = "native backend N1: if-without-else used as a value not yet lowered (N2)" } }
    var names = reassigned_scalars(if_arm_stmts(f), ctx.env)
    var indices = merge_scalar_indices(ctx.env, names)
    var thenb = alloc_block(ctx.func)
    var elseb = alloc_block(thenb.func)
    var mergeblk = alloc_block(elseb.func)
    var mp = add_block_param(mergeblk.func, mergeblk.block_id)
    var merged = add_merge_scalar_params(mp.func, mergeblk.block_id, ctx.env, names)
    var br = branch_inst(cond_vreg, thenb.block_id, [], elseb.block_id, [], e.line, e.col)
    var ctx1 = ctx_append(ctx_with(ctx, merged.func, ctx.block_id, ctx.env), br)
    var result_ty = ltype_of(e.type, ctx.enums)
    var then_opened = match open_native_region(ctx_goto(ctx1, thenb.block_id), "", false, checker::scope_slot_count(f.then_blk) == 0, e.line, e.col) { LowerCtx as c => c; error as err => return err }
    var then_val = match lower_block_value(then_opened, f.then_blk, result_ty, e.type) { LowerBlockValue as x => x; error as err => return err }
    var then_closed = match close_arm_replaying_defers(then_val.ctx, ctx1.defers, ctx1.region_stack, mergeblk.block_id, [then_val.vreg], indices, e.line, e.col) { ClosedArm as c => c; error as err => return err }
    var else_ctx = ctx_with(then_closed.ctx, then_closed.func, elseb.block_id, ctx.env)
    var else_opened = match open_native_region(else_ctx, "", false, checker::scope_slot_count(f.else_blk) == 0, e.line, e.col) { LowerCtx as c => c; error as err => return err }
    var else_val = match lower_block_value(else_opened, f.else_blk, result_ty, e.type) { LowerBlockValue as x => x; error as err => return err }
    var else_closed = match close_arm_replaying_defers(else_val.ctx, ctx1.defers, ctx1.region_stack, mergeblk.block_id, [else_val.vreg], indices, e.line, e.col) { ClosedArm as c => c; error as err => return err }
    Lowered { ctx = ctx_with(else_closed.ctx, else_closed.func, mergeblk.block_id, merged.env); vreg = mp.vreg }
}

type MatchSubj = struct { ty: @Type(); vreg: u32; is_fat: bool; len: u32 }

type MatchSubjOut = struct { ctx: LowerCtx; subj: MatchSubj }

fn lower_match_subject(ctx: LowerCtx, subject: checker::TExpr): MatchSubjOut | error {
    var sty = expand_named_variant(subject.type, ctx.variants)
    if is_fat_type(sty) {
        var fo = match lower_fat_expr(ctx, subject) { LoweredFat as x => x; error as err => return err }
        return MatchSubjOut { ctx = fo.ctx; subj = MatchSubj { ty = sty; vreg = fo.ptr; is_fat = true; len = fo.len } }
    }
    var lo = match lower_expr(ctx, subject) { Lowered as x => x; error as err => return err }
    MatchSubjOut { ctx = lo.ctx; subj = MatchSubj { ty = sty; vreg = lo.vreg; is_fat = false; len = 0 } }
}

type VariantMember = struct { index: u32; ty: @Type() }

fn find_variant_member(members: []@Type(), case_name: str): VariantMember | error {
    var i: u64 = 0
    var first: i64 = -1
    loop {
        if i >= members.len { break }
        if variant_member_named(members[i], case_name) {
            if first >= 0 && generic_case_ambiguous(members[first to u64], members[i]) {
                return error { message = teko::str::concat("native backend N1: ambiguous variant case `", case_name, "` — more than one member shares this generic base (internal)") }
            }
            if first < 0 { first = i to i64 }
        }
        i++
    }
    if first >= 0 { return VariantMember { index = first to u32; ty = members[first to u64] } }
    error { message = teko::str::concat("native backend N1: unknown variant case `", case_name, "` (internal)") }
}

fn generic_case_ambiguous(a: @Type(), b: @Type()): bool {
    match a {
        checker::Named as an => match b {
            checker::Named as bn => an.name != bn.name && (checker::split_generic_instance_name(an.name).is_generic || checker::split_generic_instance_name(bn.name).is_generic)
            _ => false
        }
        _ => false
    }
}

fn variant_member_named(member: @Type(), case_name: str): bool {
    match member {
        checker::Named as n => checker::named_case_name(n.name) == case_name
        checker::Error => case_name == error_struct_name()
        _ => {
            var spelling = checker::builtin_case_name(member)
            spelling != "" && spelling == case_name
        }
    }
}

fn variant_case_key(member: @Type()): str | error {
    match member {
        checker::Named as n => checker::named_case_name(n.name)
        checker::Error => error_struct_name()
        checker::Variant as v => variant_case_key_list(v.members)
        _ => {
            var spelling = checker::builtin_case_name(member)
            if spelling == "" { return error { message = "native backend N1: grouped bind match pattern over a variant member with no case spelling (internal)" } }
            spelling
        }
    }
}

fn variant_case_key_list(members: []@Type()): str | error {
    var out = "u"
    var i: u64 = 0
    loop {
        if i >= members.len { break }
        var k = match variant_case_key(members[i]) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

fn group_option_key(p: @Pattern()): str | error {
    match p {
        parser::BindPattern as bp => if bp.is_slice { error { message = "native backend N1: a grouped bind option cannot be a slice pattern (internal)" } } else { bind_pattern_case_name(bp) }
        parser::GroupBindPattern as gp => group_bind_key(gp)
        _ => error { message = "native backend N1: a grouped bind option must be a bare case name (internal)" }
    }
}

fn group_bind_key(gp: parser::GroupBindPattern): str | error {
    var out = "u"
    var i: u64 = 0
    loop {
        if i >= gp.options.len { break }
        var k = match group_option_key(gp.options[i]) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

fn find_variant_group_member(members: []@Type(), gp: parser::GroupBindPattern): VariantMember | error {
    var want = match group_bind_key(gp) { str as s => s; error as e => return e }
    var i: u64 = 0
    loop {
        if i >= members.len { break }
        var mk = match variant_case_key(members[i]) { str as s => s; error => "" }
        if mk == want { return VariantMember { index = i to u32; ty = members[i] } }
        i++
    }
    error { message = "native backend N1: grouped bind (`(A | B) as v`) match pattern does not match a nested union member of the subject (internal)" }
}

fn variant_member_index_of(members: []@Type(), value_ty: @Type(), variants: []LVariantDef): u32 | error {
    var i: u64 = 0
    loop {
        if i >= members.len { break }
        if variant_member_type_matches(members[i], value_ty, variants) { return i to u32 }
        i++
    }
    error { message = "native backend N1: value's type is not a member of its declared variant (internal)" }
}

fn variant_member_type_matches(member: @Type(), value_ty: @Type(), variants: []LVariantDef): bool {
    if is_str_type(member) { return is_str_type(value_ty) }
    match member {
        checker::Named as mn => variant_named_member_matches(mn.name, value_ty, variants)
        checker::Error => match value_ty { checker::Error => true; _ => false }
        checker::Prim as mp => match value_ty { checker::Prim as vp => mp.kind == vp.kind; _ => false }
        checker::Byte => match value_ty { checker::Byte => true; _ => false }
        checker::Char => match value_ty { checker::Char => true; _ => false }
        checker::Slice => match value_ty { checker::Slice => true; _ => false }
        checker::Null => match value_ty { checker::Null => true; _ => false }
        checker::Func => match value_ty { checker::Func => true; _ => false }
        checker::Void => match value_ty { checker::Void => true; _ => false }
        _ => variant_member_aggregate_matches(member, value_ty)
    }
}

fn variant_member_aggregate_matches(member: @Type(), value_ty: @Type()): bool {
    checker::type_eq(member, value_ty)
}

fn variant_named_member_matches(member_name: str, value_ty: @Type(), variants: []LVariantDef): bool {
    if variant_named_directly(member_name, value_ty) { return true }
    match find_variant_def(variants, member_name) {
        LVariantDef as def => variant_any_member_matches(def.ty.members, value_ty, variants)
        null => false
    }
}

fn variant_named_directly(member_name: str, value_ty: @Type()): bool {
    match value_ty {
        checker::Named as vn => vn.name == member_name
        _ => false
    }
}

fn variant_any_member_matches(members: []@Type(), value_ty: @Type(), variants: []LVariantDef): bool {
    var i: u64 = 0
    loop {
        if i >= members.len { break }
        if variant_member_type_matches(members[i], value_ty, variants) { return true }
        i++
    }
    false
}

fn variant_null_member_index(v: checker::Variant): u32 | null {
    var i: u64 = 0
    loop {
        if i >= v.members.len { break }
        match v.members[i] {
            checker::Null => return i to u32
            _ => { }
        }
        i++
    }
    null
}

type NullUnionShape = struct {
    payload: @Type()

    payload_index: u32

    null_index: u32
}

fn null_union_shape(v: checker::Variant): NullUnionShape | null {
    if v.members.len != 2 { return null }
    match v.members[0] {
        checker::Null => match v.members[1] {
            checker::Null => null
            _ => NullUnionShape { payload = v.members[1]; payload_index = 1; null_index = 0 }
        }
        _ => match v.members[1] {
            checker::Null => NullUnionShape { payload = v.members[0]; payload_index = 0; null_index = 1 }
            _ => null
        }
    }
}

fn lower_variant_tag_eq_test(ctx: LowerCtx, subj: MatchSubj, index: i64, line: u32, col: u32): PatternTest {
    var addr = ctx_alloc(ctx)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, subj.vreg, 0, line, col))
    var tagr = ctx_alloc(with_addr)
    var with_tag = ctx_append(tagr.ctx, load_inst(tagr.vreg, addr.vreg, LType::I32, line, col))
    var cr = ctx_alloc(with_tag)
    var with_const = ctx_append(cr.ctx, const_int_inst(cr.vreg, index, line, col))
    var eqr = ctx_alloc(with_const)
    PatternTest { ctx = ctx_append(eqr.ctx, bin_inst(eqr.vreg, LBinOp::ICmpEq, tagr.vreg, cr.vreg, line, col)); always = false; vreg = eqr.vreg }
}

fn bind_case_payload(ctx: LowerCtx, base_vreg: u32, ty: @Type(), binding: str): LowerCtx {
    if is_fat_type(ty) { return bind_fat_case_payload(ctx, base_vreg, binding) }
    bind_scalar_case_payload(ctx, base_vreg, ltype_of(ty, ctx.enums), binding)
}

fn bind_scalar_case_payload(ctx: LowerCtx, base_vreg: u32, ty: LType, binding: str): LowerCtx {
    var addr = ctx_alloc(ctx)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base_vreg, variant_payload_offset(), 0, 0))
    var r = ctx_alloc(with_addr)
    var with_load = ctx_append(r.ctx, load_inst(r.vreg, addr.vreg, ty, 0, 0))
    ctx_bind(with_load, binding, r.vreg)
}

fn bind_fat_case_payload(ctx: LowerCtx, base_vreg: u32, binding: str): LowerCtx {
    var pa = ctx_alloc(ctx)
    var with_pa = ctx_append(pa.ctx, field_addr_inst(pa.vreg, base_vreg, variant_payload_offset(), 0, 0))
    var pr = ctx_alloc(with_pa)
    var with_pr = ctx_append(pr.ctx, load_inst(pr.vreg, pa.vreg, LType::Ptr, 0, 0))
    var la = ctx_alloc(with_pr)
    var with_la = ctx_append(la.ctx, field_addr_inst(la.vreg, base_vreg, variant_payload_len_offset(), 0, 0))
    var lr = ctx_alloc(with_la)
    var with_lr = ctx_append(lr.ctx, load_inst(lr.vreg, la.vreg, LType::I64, 0, 0))
    ctx_bind_fat(with_lr, binding, pr.vreg, lr.vreg)
}

fn bind_null_union_payload(ctx: LowerCtx, subj: MatchSubj, payload: @Type(), binding: str): LowerCtx {
    bind_case_payload(ctx, subj.vreg, payload, binding)
}

fn lower_null_pattern_test(ctx: LowerCtx, subj: MatchSubj, line: u32, col: u32): PatternTest | error {
    match subj.ty {
        checker::Variant as v => match variant_null_member_index(v) {
            u32 as index => lower_variant_tag_eq_test(ctx, subj, index to i64, line, col)
            null => error { message = "native backend N1: `null` match pattern over a union that declares no `null` member (internal)" }
        }
        _ => error { message = "native backend N1: `null` match pattern over a non-union subject (internal)" }
    }
}

fn lower_null_union_construct(ctx: LowerCtx, shape: NullUnionShape, e: checker::TExpr): Lowered | error {
    match e.type {
        checker::Null => return lower_null_absent_widened(ctx, shape.null_index, e)
        _ => { }
    }
    if payload_needs_inner_wrapper(ctx, shape.payload, e) { return lower_null_union_nested_present(ctx, shape, e) }
    var slot = ctx_alloc(ctx)
    var with_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    store_variant_payload(with_alloca, slot.vreg, shape.payload_index to i64, shape.payload, e)
}

fn lower_variant_absent(ctx: LowerCtx, index: i64, e: checker::TExpr): Lowered {
    var slot = ctx_alloc(ctx)
    var with_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    store_variant_tag(with_alloca, slot.vreg, index, e.line, e.col)
}

fn lower_null_absent_widened(ctx: LowerCtx, index: u32, e: checker::TExpr): Lowered | error {
    match e.kind {
        checker::TNullLit => lower_variant_absent(ctx, index to i64, e)
        _ => {
            var lowered = match lower_expr(ctx, e) { Lowered as x => x; error as err => return err }
            lower_variant_absent(lowered.ctx, index to i64, e)
        }
    }
}

fn payload_needs_inner_wrapper(ctx: LowerCtx, payload: @Type(), e: checker::TExpr): bool {
    match expand_named_variant(payload, ctx.variants) {
        checker::Variant => match expand_named_variant(e.type, ctx.variants) { checker::Variant => false; _ => true }
        _ => false
    }
}

fn lower_null_union_nested_present(ctx: LowerCtx, shape: NullUnionShape, e: checker::TExpr): Lowered | error {
    var inner = match lower_value_into_type(ctx, shape.payload, e) { Lowered as x => x; error as err => return err }
    var slot = ctx_alloc(inner.ctx)
    var with_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    var tagged = store_variant_tag(with_alloca, slot.vreg, shape.payload_index to i64, e.line, e.col)
    store_scalar_variant_payload_value(slot.vreg, shape.payload, Lowered { ctx = tagged.ctx; vreg = inner.vreg }, e)
}

fn lower_variant_construct(ctx: LowerCtx, v: checker::Variant, value: checker::TExpr): Lowered | error {
    match direct_variant_member_index(v.members, value.type) {
        u32 as index => build_variant_wrapper(ctx, index to i64, value.type, value)
        null => lower_nested_variant_construct(ctx, v, value)
    }
}

fn build_variant_wrapper(ctx: LowerCtx, index: i64, pty: @Type(), value: checker::TExpr): Lowered | error {
    var slot = ctx_alloc(ctx)
    var with_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, variant_wrapper_bytes(), variant_wrapper_align(), value.line, value.col))
    store_variant_payload(with_alloca, slot.vreg, index, pty, value)
}

fn direct_variant_member_index(members: []@Type(), value_ty: @Type()): u32 | null {
    var i: u64 = 0
    loop {
        if i >= members.len { break }
        if variant_member_direct_match(members[i], value_ty) { return i to u32 }
        i++
    }
    null
}

fn variant_member_direct_match(member: @Type(), value_ty: @Type()): bool {
    if is_str_type(member) { return is_str_type(value_ty) }
    match member {
        checker::Named as mn => variant_named_directly(mn.name, value_ty)
        checker::Error => match value_ty { checker::Error => true; _ => false }
        checker::Prim as mp => match value_ty { checker::Prim as vp => mp.kind == vp.kind; _ => false }
        checker::Byte => match value_ty { checker::Byte => true; _ => false }
        checker::Slice => match value_ty { checker::Slice => true; _ => false }
        checker::Variant => variant_member_aggregate_matches(member, value_ty)
        _ => false
    }
}

type NestedAliasMember = struct {
    index: u32
    name: str
    expansion: checker::Variant
}

fn lower_nested_variant_construct(ctx: LowerCtx, v: checker::Variant, value: checker::TExpr): Lowered | error {
    match find_nested_alias_member(v.members, value.type, ctx.variants) {
        NestedAliasMember as nm => {
            var inner = match lower_variant_construct(ctx, nm.expansion, value) { Lowered as x => x; error as e => return e }
            var slot = ctx_alloc(inner.ctx)
            var with_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, variant_wrapper_bytes(), variant_wrapper_align(), value.line, value.col))
            var tagged = store_variant_tag(with_alloca, slot.vreg, nm.index to i64, value.line, value.col)
            store_scalar_variant_payload_value(slot.vreg, checker::Named { name = nm.name }, Lowered { ctx = tagged.ctx; vreg = inner.vreg }, value)
        }
        null => error { message = "native backend N1: value's type is not a member of its declared variant (internal)" }
    }
}

fn find_nested_alias_member(members: []@Type(), value_ty: @Type(), variants: []LVariantDef): NestedAliasMember | null {
    var i: u64 = 0
    loop {
        if i >= members.len { break }
        match nested_alias_member_at(members[i], i to u32, value_ty, variants) {
            NestedAliasMember as nm => return nm
            null => { }
        }
        i++
    }
    null
}

fn nested_alias_member_at(member: @Type(), index: u32, value_ty: @Type(), variants: []LVariantDef): NestedAliasMember | null {
    match member {
        checker::Named as mn => match find_variant_def(variants, mn.name) {
            LVariantDef as def => nested_alias_member_if_covers(index, mn.name, def.ty, value_ty, variants)
            null => null
        }
        _ => null
    }
}

fn nested_alias_member_if_covers(index: u32, name: str, inner: checker::Variant, value_ty: @Type(), variants: []LVariantDef): NestedAliasMember | null {
    if variant_any_member_matches(inner.members, value_ty, variants) { return NestedAliasMember { index = index; name = name; expansion = inner } }
    null
}

fn store_scalar_variant_payload_value(base_vreg: u32, pty: @Type(), vo: Lowered, pos: checker::TExpr): Lowered | error {
    var box_bytes = match variant_payload_box_bytes(pty, vo.ctx) { u32 as n => n; error as err => return err }
    var owned = box_aggregate_value(vo, box_bytes, pos)
    var paddr = ctx_alloc(owned.ctx)
    var with_paddr = ctx_append(paddr.ctx, field_addr_inst(paddr.vreg, base_vreg, variant_payload_offset(), pos.line, pos.col))
    var with_pstore = ctx_append(with_paddr, store_inst(paddr.vreg, owned.vreg, ltype_of(pty, vo.ctx.enums), pos.line, pos.col))
    Lowered { ctx = with_pstore; vreg = base_vreg }
}

fn variant_wrapper_bytes(): u32 { 24 to u32 }

fn variant_payload_offset(): u32 { 8 to u32 }

fn variant_payload_len_offset(): u32 { 16 to u32 }

fn variant_wrapper_align(): u32 { ltype_align(LType::Ptr) }

fn store_variant_tag(ctx: LowerCtx, base_vreg: u32, index: i64, line: u32, col: u32): Lowered {
    var tagr = ctx_alloc(ctx)
    var with_tag = ctx_append(tagr.ctx, const_int_inst(tagr.vreg, index, line, col))
    var addr = ctx_alloc(with_tag)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base_vreg, 0, line, col))
    var with_store = ctx_append(with_addr, store_inst(addr.vreg, tagr.vreg, LType::I32, line, col))
    Lowered { ctx = with_store; vreg = base_vreg }
}

fn store_variant_payload(ctx: LowerCtx, base_vreg: u32, index: i64, pty: @Type(), e: checker::TExpr): Lowered | error {
    var tagged = store_variant_tag(ctx, base_vreg, index, e.line, e.col)
    if is_fat_type(pty) { return store_fat_variant_payload(tagged.ctx, base_vreg, e) }
    store_scalar_variant_payload(tagged.ctx, base_vreg, pty, e)
}

fn variant_payload_box_bytes(pty: @Type(), ctx: LowerCtx): u32 | error {
    if is_register_value_type(pty, ctx.enums) { return 0 to u32 }
    match aggregate_box_bytes(pty, ctx) {
        u32 as n => n
        null => unsized_aggregate_push_stop(aggregate_form_name(pty))
    }
}

fn store_scalar_variant_payload(ctx: LowerCtx, base_vreg: u32, pty: @Type(), e: checker::TExpr): Lowered | error {
    var vo = match lower_expr(ctx, e) { Lowered as x => x; error as err => return err }
    var box_bytes = match variant_payload_box_bytes(pty, ctx) { u32 as n => n; error as err => return err }
    var owned = box_aggregate_value(vo, box_bytes, e)
    var paddr = ctx_alloc(owned.ctx)
    var with_paddr = ctx_append(paddr.ctx, field_addr_inst(paddr.vreg, base_vreg, variant_payload_offset(), e.line, e.col))
    var with_pstore = ctx_append(with_paddr, store_inst(paddr.vreg, owned.vreg, ltype_of(pty, ctx.enums), e.line, e.col))
    Lowered { ctx = with_pstore; vreg = base_vreg }
}

fn store_fat_variant_payload(ctx: LowerCtx, base_vreg: u32, e: checker::TExpr): Lowered | error {
    var fo = match lower_fat_expr(ctx, e) { LoweredFat as x => x; error as err => return err }
    Lowered { ctx = store_fat_variant_payload_pair(fo.ctx, base_vreg, fo.ptr, fo.len, e.line, e.col); vreg = base_vreg }
}

fn store_fat_variant_payload_pair(ctx: LowerCtx, base_vreg: u32, ptr: u32, len: u32, line: u32, col: u32): LowerCtx {
    var paddr = ctx_alloc(ctx)
    var with_paddr = ctx_append(paddr.ctx, field_addr_inst(paddr.vreg, base_vreg, variant_payload_offset(), line, col))
    var with_pstore = ctx_append(with_paddr, store_inst(paddr.vreg, ptr, LType::Ptr, line, col))
    var laddr = ctx_alloc(with_pstore)
    var with_laddr = ctx_append(laddr.ctx, field_addr_inst(laddr.vreg, base_vreg, variant_payload_len_offset(), line, col))
    ctx_append(with_laddr, store_inst(laddr.vreg, len, LType::I64, line, col))
}

fn find_enum_info(enums: []LEnumInfo, name: str): LEnumInfo | null {
    var bare = checker::name_last_segment(name)
    var i: u64 = 0
    loop {
        if i >= enums.len { break }
        if !enums[i].is_newtype && checker::name_last_segment(enums[i].name) == bare { return enums[i] }
        i++
    }
    null
}

fn find_value_carrier(enums: []LEnumInfo, name: str): LEnumInfo | null {
    var bare = checker::name_last_segment(name)
    var i: u64 = 0
    loop {
        if i >= enums.len { break }
        if checker::name_last_segment(enums[i].name) == bare { return enums[i] }
        i++
    }
    null
}

fn expand_named_variant(t: @Type(), variants: []LVariantDef): @Type() {
    var name = match t {
        checker::Named as n => n.name
        _ => return t
    }
    match find_variant_def(variants, name) {
        LVariantDef as def => def.ty
        null => t
    }
}

fn enum_member_ordinal(ei: LEnumInfo, member: str): u32 | error {
    var i: u64 = 0
    loop {
        if i >= ei.members.len { break }
        if ei.members[i] == member { return i to u32 }
        i++
    }
    error { message = teko::str::concat("native backend N1: unknown enum member `", member, "` (internal)") }
}

fn bind_pattern_case_name(bp: parser::BindPattern): str {
    var segs = bp.type_name.segments
    segs[segs.len - 1].name
}

fn field_pattern_case_name(fp: parser::FieldPattern): str {
    var segs = fp.type_name.segments
    segs[segs.len - 1].name
}

type PatternTest = struct { ctx: LowerCtx; always: bool; vreg: u32 }

fn lower_pattern_test(ctx: LowerCtx, subj: MatchSubj, pat: @Pattern(), line: u32, col: u32): PatternTest | error {
    match pat {
        parser::WildcardPattern => PatternTest { ctx = ctx; always = true; vreg = 0 }
        parser::LiteralPattern as lp => lower_literal_pattern_test(ctx, subj, lp, line, col)
        parser::BindPattern as bp => lower_bind_pattern_test(ctx, subj, bp, line, col)
        parser::FieldPattern as fp => lower_field_pattern_test(ctx, subj, fp, line, col)
        parser::RangePattern as rp => lower_range_pattern_test(ctx, subj, rp, line, col)
        parser::AltPattern as ap => lower_alt_pattern_test(ctx, subj, ap, line, col)
        parser::GroupBindPattern as gp => lower_group_bind_pattern_test(ctx, subj, gp, line, col)
        parser::NullPattern => lower_null_pattern_test(ctx, subj, line, col)
        parser::MacroPattern => error { message = "internal: an unexpanded @Type() macro reached native lowering — it should be expanded by the Family-A pre-pass" }
    }
}

fn pattern_bound_i64(e: parser::Expr): i64 | error {
    match e.kind {
        parser::Number as n => if n.is_float { error { message = "native backend N1: a float range match bound is not lowered (N2)" } } else { parser::numint_to_i64(n.value) }
        parser::ByteLit as b => b.value to i64
        _ => error { message = "native backend N1: unsupported range match bound (internal)" }
    }
}

fn range_subject_signed(ty: @Type()): bool {
    match ty {
        checker::Prim as p => prim_is_signed_int(p.kind)
        _ => false
    }
}

fn lower_range_pattern_test(ctx: LowerCtx, subj: MatchSubj, rp: parser::RangePattern, line: u32, col: u32): PatternTest | error {
    var lo = match pattern_bound_i64(rp.lo) { i64 as x => x; error as err => return err }
    var hi = match pattern_bound_i64(rp.hi) { i64 as x => x; error as err => return err }
    var signed = range_subject_signed(subj.ty)
    var ge_op = if signed { LBinOp::ICmpGeS } else { LBinOp::ICmpGeU }
    var le_op = if signed { LBinOp::ICmpLeS } else { LBinOp::ICmpLeU }
    var lor = ctx_alloc(ctx)
    var with_lo = ctx_append(lor.ctx, const_int_inst(lor.vreg, lo, line, col))
    var ge = ctx_alloc(with_lo)
    var with_ge = ctx_append(ge.ctx, bin_inst(ge.vreg, ge_op, subj.vreg, lor.vreg, line, col))
    var hir = ctx_alloc(with_ge)
    var with_hi = ctx_append(hir.ctx, const_int_inst(hir.vreg, hi, line, col))
    var le = ctx_alloc(with_hi)
    var with_le = ctx_append(le.ctx, bin_inst(le.vreg, le_op, subj.vreg, hir.vreg, line, col))
    var anded = ctx_alloc(with_le)
    var with_and = ctx_append(anded.ctx, bin_inst(anded.vreg, LBinOp::IAnd, ge.vreg, le.vreg, line, col))
    PatternTest { ctx = with_and; always = false; vreg = anded.vreg }
}

fn lower_alt_pattern_test(ctx: LowerCtx, subj: MatchSubj, ap: parser::AltPattern, line: u32, col: u32): PatternTest | error {
    if ap.options.len == 0 { return error { message = "native backend N1: an empty alternation match pattern (internal)" } }
    var cur = ctx
    var acc: u32 = 0
    var have = false
    var i: u64 = 0
    loop {
        if i >= ap.options.len { break }
        var t = match lower_pattern_test(cur, subj, ap.options[i], line, col) { PatternTest as x => x; error as err => return err }
        if t.always { return PatternTest { ctx = t.ctx; always = true; vreg = 0 } }
        cur = t.ctx
        if !have {
            acc = t.vreg
            have = true
        } else {
            var r = ctx_alloc(cur)
            cur = ctx_append(r.ctx, bin_inst(r.vreg, LBinOp::IOr, acc, t.vreg, line, col))
            acc = r.vreg
        }
        i++
    }
    PatternTest { ctx = cur; always = false; vreg = acc }
}

fn lower_literal_pattern_test(ctx: LowerCtx, subj: MatchSubj, lp: parser::LiteralPattern, line: u32, col: u32): PatternTest | error {
    match lp.value.kind {
        parser::StrLit as sl => lower_str_literal_pattern_test(ctx, subj, sl.text, line, col)
        parser::Number as n => lower_number_literal_pattern_test(ctx, subj, n, line, col)
        parser::ByteLit as b => lower_scalar_literal_pattern_test(ctx, subj, b.value to i64, line, col)
        _ => error { message = "native backend N1: unsupported literal match pattern (internal)" }
    }
}

fn lower_number_literal_pattern_test(ctx: LowerCtx, subj: MatchSubj, n: parser::Number, line: u32, col: u32): PatternTest | error {
    if n.is_float { return error { message = "native backend N1: float match pattern not yet lowered (N2)" } }
    lower_scalar_literal_pattern_test(ctx, subj, parser::numint_to_i64(n.value), line, col)
}

fn lower_scalar_literal_pattern_test(ctx: LowerCtx, subj: MatchSubj, value: i64, line: u32, col: u32): PatternTest {
    var r = ctx_alloc(ctx)
    var with_const = ctx_append(r.ctx, const_int_inst(r.vreg, value, line, col))
    var cr = ctx_alloc(with_const)
    var with_cmp = ctx_append(cr.ctx, bin_inst(cr.vreg, LBinOp::ICmpEq, subj.vreg, r.vreg, line, col))
    PatternTest { ctx = with_cmp; always = false; vreg = cr.vreg }
}

fn lower_str_literal_pattern_test(ctx: LowerCtx, subj: MatchSubj, text: str, line: u32, col: u32): PatternTest | error {
    if !subj.is_fat { return error { message = "native backend N1: string match pattern over a non-string subject (internal)" } }
    var lenr = ctx_alloc(ctx)
    var with_lenconst = ctx_append(lenr.ctx, const_int_inst(lenr.vreg, text.len to i64, line, col))
    var lcmp = ctx_alloc(with_lenconst)
    var with_lcmp = ctx_append(lcmp.ctx, bin_inst(lcmp.vreg, LBinOp::ICmpEq, subj.len, lenr.vreg, line, col))
    var bytes_test = str_pattern_bytes_test(with_lcmp, subj, text, lcmp.vreg, line, col)
    PatternTest { ctx = bytes_test.ctx; always = false; vreg = bytes_test.vreg }
}

fn str_pattern_bytes_test(ctx: LowerCtx, subj: MatchSubj, text: str, acc0: u32, line: u32, col: u32): Lowered {
    var cur = ctx
    var acc = acc0
    var i: u64 = 0
    loop {
        if i >= text.len { break }
        var eq = str_pattern_byte_eq(cur, subj, text[i], i to u32, line, col)
        var merged = lower_bool_and(eq.ctx, acc, eq.vreg, line, col)
        cur = merged.ctx
        acc = merged.vreg
        i++
    }
    Lowered { ctx = cur; vreg = acc }
}

fn str_pattern_byte_eq(ctx: LowerCtx, subj: MatchSubj, want: byte, index: u32, line: u32, col: u32): Lowered {
    var addr = ctx_alloc(ctx)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, subj.vreg, index, line, col))
    var bl = ctx_alloc(with_addr)
    var with_load = ctx_append(bl.ctx, load_inst(bl.vreg, addr.vreg, LType::I8, line, col))
    var bc = ctx_alloc(with_load)
    var with_bconst = ctx_append(bc.ctx, const_int_inst(bc.vreg, want to i64, line, col))
    var eqr = ctx_alloc(with_bconst)
    Lowered { ctx = ctx_append(eqr.ctx, bin_inst(eqr.vreg, LBinOp::ICmpEq, bl.vreg, bc.vreg, line, col)); vreg = eqr.vreg }
}

fn lower_bind_pattern_test(ctx: LowerCtx, subj: MatchSubj, bp: parser::BindPattern, line: u32, col: u32): PatternTest | error {
    match subj.ty {
        checker::Variant as v => lower_variant_bind_pattern_test(ctx, subj, v, bp, line, col)
        checker::Named as n => lower_named_bind_pattern_test(ctx, subj, n, bp, line, col)
        _ => non_variant_bind_pattern_test(ctx, bp)
    }
}

fn non_variant_bind_pattern_test(ctx: LowerCtx, bp: parser::BindPattern): PatternTest | error {
    if bp.is_slice { return error { message = "native backend N1: slice match pattern over a non-variant subject not yet lowered (N2)" } }
    PatternTest { ctx = ctx; always = true; vreg = 0 }
}

fn lower_variant_bind_pattern_test(ctx: LowerCtx, subj: MatchSubj, v: checker::Variant, bp: parser::BindPattern, line: u32, col: u32): PatternTest | error {
    match null_union_shape(v) {
        NullUnionShape as shape => lower_variant_tag_eq_test(ctx, subj, shape.payload_index to i64, line, col)
        null => {
            var vm = match variant_case_of_bind_pattern(v.members, bp) { VariantMember as x => x; error as err => return err }
            lower_variant_tag_eq_test(ctx, subj, vm.index to i64, line, col)
        }
    }
}

fn lower_named_bind_pattern_test(ctx: LowerCtx, subj: MatchSubj, n: checker::Named, bp: parser::BindPattern, line: u32, col: u32): PatternTest | error {
    match find_enum_info(ctx.enums, n.name) {
        LEnumInfo as ei => {
            var ord = match enum_member_ordinal(ei, bind_pattern_case_name(bp)) { u32 as o => o; error as err => return err }
            lower_scalar_literal_pattern_test(ctx, subj, ord to i64, line, col)
        }
        null => PatternTest { ctx = ctx; always = true; vreg = 0 }
    }
}

fn lower_variant_case_test(ctx: LowerCtx, subj: MatchSubj, members: []@Type(), case_name: str, line: u32, col: u32): PatternTest | error {
    var vm = match find_variant_member(members, case_name) { VariantMember as x => x; error as err => return err }
    lower_variant_tag_eq_test(ctx, subj, vm.index to i64, line, col)
}

fn lower_field_pattern_test(ctx: LowerCtx, subj: MatchSubj, fp: parser::FieldPattern, line: u32, col: u32): PatternTest | error {
    match subj.ty {
        checker::Variant as v => lower_variant_case_test(ctx, subj, v.members, field_pattern_case_name(fp), line, col)
        _ => error { message = "native backend N1: field match pattern over a non-variant subject not yet lowered (N2)" }
    }
}

fn lower_group_bind_pattern_test(ctx: LowerCtx, subj: MatchSubj, gp: parser::GroupBindPattern, line: u32, col: u32): PatternTest | error {
    match subj.ty {
        checker::Variant as v => {
            var vm = match find_variant_group_member(v.members, gp) { VariantMember as x => x; error as err => return err }
            lower_variant_tag_eq_test(ctx, subj, vm.index to i64, line, col)
        }
        _ => error { message = "native backend N1: grouped bind match pattern over a non-variant subject not yet lowered (N2)" }
    }
}

fn lower_pattern_binds(ctx: LowerCtx, subj: MatchSubj, pat: @Pattern()): LowerCtx | error {
    match pat {
        parser::BindPattern as bp => lower_bind_pattern_binds(ctx, subj, bp)
        parser::FieldPattern as fp => lower_field_pattern_binds(ctx, subj, fp)
        parser::GroupBindPattern as gp => lower_group_bind_pattern_binds(ctx, subj, gp)
        _ => ctx
    }
}

fn lower_bind_pattern_binds(ctx: LowerCtx, subj: MatchSubj, bp: parser::BindPattern): LowerCtx | error {
    if !bp.has_binding { return ctx }
    match subj.ty {
        checker::Variant as v => lower_variant_bind_pattern_binds(ctx, subj, v, bp)
        _ => bind_whole_subject(ctx, subj, bp.binding)
    }
}

fn lower_variant_bind_pattern_binds(ctx: LowerCtx, subj: MatchSubj, v: checker::Variant, bp: parser::BindPattern): LowerCtx | error {
    match null_union_shape(v) {
        NullUnionShape as shape => bind_null_union_payload(ctx, subj, shape.payload, bp.binding)
        null => {
            var vm = match variant_case_of_bind_pattern(v.members, bp) { VariantMember as x => x; error as err => return err }
            bind_case_payload(ctx, subj.vreg, vm.ty, bp.binding)
        }
    }
}

fn bind_whole_subject(ctx: LowerCtx, subj: MatchSubj, name: str): LowerCtx {
    if subj.is_fat { return ctx_bind_fat(ctx, name, subj.vreg, subj.len) }
    ctx_bind(ctx, name, subj.vreg)
}

fn variant_case_of_bind_pattern(members: []@Type(), bp: parser::BindPattern): VariantMember | error {
    if bp.is_slice { return find_variant_slice_member(members) }
    find_variant_member(members, bind_pattern_case_name(bp))
}

fn find_variant_slice_member(members: []@Type()): VariantMember | error {
    var i: u64 = 0
    loop {
        if i >= members.len { break }
        match members[i] {
            checker::Slice => return VariantMember { index = i to u32; ty = members[i] }
            _ => { }
        }
        i++
    }
    error { message = "native backend N1: a `[]T` match pattern over a variant with no slice member (internal)" }
}

fn lower_field_pattern_binds(ctx: LowerCtx, subj: MatchSubj, fp: parser::FieldPattern): LowerCtx | error {
    match subj.ty {
        checker::Variant as v => lower_variant_field_binds(ctx, subj, v.members, fp)
        _ => error { message = "native backend N1: field match pattern over a non-variant subject not yet lowered (N2)" }
    }
}

fn lower_group_bind_pattern_binds(ctx: LowerCtx, subj: MatchSubj, gp: parser::GroupBindPattern): LowerCtx | error {
    match subj.ty {
        checker::Variant as v => {
            var vm = match find_variant_group_member(v.members, gp) { VariantMember as x => x; error as err => return err }
            bind_case_payload(ctx, subj.vreg, vm.ty, gp.binding)
        }
        _ => error { message = "native backend N1: grouped bind match pattern over a non-variant subject not yet lowered (N2)" }
    }
}

fn lower_variant_field_binds(ctx: LowerCtx, subj: MatchSubj, members: []@Type(), fp: parser::FieldPattern): LowerCtx | error {
    var vm = match find_variant_member(members, field_pattern_case_name(fp)) { VariantMember as x => x; error as err => return err }
    var sname = match vm.ty { checker::Named as n => n.name; _ => return error { message = "native backend N1: field match pattern requires a struct case (internal)" } }
    var layout = match find_struct_layout(ctx.layouts, sname) { LStructLayout as l => l; error as err => return err }
    var paddr = ctx_alloc(ctx)
    var with_paddr = ctx_append(paddr.ctx, field_addr_inst(paddr.vreg, subj.vreg, 8, 0, 0))
    var slot = ctx_alloc(with_paddr)
    var with_base = ctx_append(slot.ctx, load_inst(slot.vreg, paddr.vreg, LType::Ptr, 0, 0))
    bind_variant_fields(with_base, slot.vreg, layout, fp.fields)
}

fn bind_variant_fields(ctx: LowerCtx, base_vreg: u32, layout: LStructLayout, fields: []str): LowerCtx | error {
    var cur = ctx
    var i: u64 = 0
    loop {
        if i >= fields.len { break }
        var off = match field_offset_of(layout, fields[i]) { u32 as o => o; error as err => return err }
        var fty = match field_type_of(layout, fields[i]) { LType as t => t; error as err => return err }
        var addr = ctx_alloc(cur)
        var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base_vreg, off, 0, 0))
        var r = ctx_alloc(with_addr)
        var with_load = ctx_append(r.ctx, load_inst(r.vreg, addr.vreg, fty, 0, 0))
        cur = ctx_bind(with_load, fields[i], r.vreg)
        i++
    }
    cur
}

type MatchArmEntry = struct { ctx: LowerCtx; next_block: u32 }

fn close_test_to(ctx: LowerCtx, test: PatternTest, arm_block: u32, next_block: u32, line: u32, col: u32): LowerCtx {
    if test.always { return ctx_append(ctx, jump_inst(arm_block, [], line, col)) }
    ctx_append(ctx, branch_inst(test.vreg, arm_block, [], next_block, [], line, col))
}

fn lower_match_arm_entry(ctx: LowerCtx, e: checker::TExpr, arm: checker::TArm, subj: MatchSubj): MatchArmEntry | error {
    var test = match lower_pattern_test(ctx, subj, arm.pattern, e.line, e.col) { PatternTest as x => x; error as err => return err }
    var armb = alloc_block(test.ctx.func)
    var nextb = alloc_block(armb.func)
    var gated = close_test_to(ctx_with(test.ctx, nextb.func, test.ctx.block_id, test.ctx.env), test, armb.block_id, nextb.block_id, e.line, e.col)
    var arm_ctx = match lower_pattern_binds(ctx_goto(gated, armb.block_id), subj, arm.pattern) { LowerCtx as c => c; error as err => return err }
    if !arm.has_when { return MatchArmEntry { ctx = arm_ctx; next_block = nextb.block_id } }
    lower_match_guard(arm_ctx, arm, nextb.block_id)
}

fn lower_match_guard(ctx: LowerCtx, arm: checker::TArm, next_block: u32): MatchArmEntry | error {
    var guardo = match lower_expr(ctx, arm.guard) { Lowered as x => x; error as err => return err }
    var guardb = alloc_block(guardo.ctx.func)
    var guarded = append_inst(guardb.func, guardo.ctx.block_id, branch_inst(guardo.vreg, guardb.block_id, [], next_block, [], arm.guard.line, arm.guard.col))
    MatchArmEntry { ctx = ctx_with(guardo.ctx, guarded, guardb.block_id, guardo.ctx.env); next_block = next_block }
}

fn lower_match_arm_value(ctx: LowerCtx, e: checker::TExpr, arm: checker::TArm, subj: MatchSubj, merge_id: u32, names: []str): LowerCtx | error {
    var indices = merge_scalar_indices(ctx.env, names)
    var step = match lower_match_arm_entry(ctx, e, arm, subj) { MatchArmEntry as x => x; error as err => return err }
    var opened = match open_native_region(step.ctx, "", false, checker::scope_slot_count(arm.body) == 0, e.line, e.col) { LowerCtx as c => c; error as err => return err }
    var bv = match lower_block_value(opened, arm.body, ltype_of(e.type, ctx.enums), e.type) { LowerBlockValue as x => x; error as err => return err }
    var closed = match close_arm_replaying_defers(bv.ctx, ctx.defers, step.ctx.region_stack, merge_id, [bv.vreg], indices, e.line, e.col) { ClosedArm as c => c; error as err => return err }
    ctx_with(closed.ctx, closed.func, step.next_block, ctx.env)
}

fn lower_match_arms_value(ctx: LowerCtx, e: checker::TExpr, arms: []checker::TArm, subj: MatchSubj, merge_id: u32, names: []str): LowerCtx | error {
    var cur = ctx
    var i: u64 = 0
    loop {
        if i >= arms.len { break }
        cur = match lower_match_arm_value(cur, e, arms[i], subj, merge_id, names) { LowerCtx as c => c; error as err => return err }
        i++
    }
    cur
}

fn lower_match_value(ctx: LowerCtx, e: checker::TExpr, m: checker::TMatchExpr, subj: MatchSubj): Lowered | error {
    var names = reassigned_scalars_for_match(m.arms, ctx.env)
    var indices = merge_scalar_indices(ctx.env, names)
    var mergeb = alloc_block(ctx.func)
    var mp = add_block_param(mergeb.func, mergeb.block_id)
    var merged = add_merge_scalar_params(mp.func, mergeb.block_id, ctx.env, names)
    var base_ctx = ctx_with(ctx, merged.func, ctx.block_id, ctx.env)
    var chain = match lower_match_arms_value(base_ctx, e, m.arms, subj, mergeb.block_id, names) { LowerCtx as c => c; error as err => return err }
    var fb = ctx_alloc(chain)
    var with_zero = ctx_append(fb.ctx, const_int_inst(fb.vreg, lfallback_const(ltype_of(e.type, ctx.enums)), e.line, e.col))
    var fallback_args = merge_value_args(fb.vreg, arm_scalar_args(with_zero.env, indices))
    var closed = append_inst(with_zero.func, with_zero.block_id, jump_inst(mergeb.block_id, fallback_args, e.line, e.col))
    Lowered { ctx = ctx_with(with_zero, closed, mergeb.block_id, merged.env); vreg = mp.vreg }
}

fn lfallback_const(rt: LType): i64 {
    match rt {
        I64 => 2147483648
        _ => 0
    }
}

fn lower_match_arm_stmt(ctx: LowerCtx, e: checker::TExpr, arm: checker::TArm, subj: MatchSubj, merge_id: u32, names: []str): LowerCtx | error {
    var indices = merge_scalar_indices(ctx.env, names)
    var step = match lower_match_arm_entry(ctx, e, arm, subj) { MatchArmEntry as x => x; error as err => return err }
    var opened = match open_native_region(step.ctx, "", false, checker::scope_slot_count(arm.body) == 0, e.line, e.col) { LowerCtx as c => c; error as err => return err }
    var done = match lower_block(opened, arm.body) { LowerCtx as c => c; error as err => return err }
    var closed = match close_arm_replaying_defers(done, ctx.defers, step.ctx.region_stack, merge_id, [], indices, e.line, e.col) { ClosedArm as c => c; error as err => return err }
    ctx_with(closed.ctx, closed.func, step.next_block, ctx.env)
}

fn lower_match_arms_stmt(ctx: LowerCtx, e: checker::TExpr, arms: []checker::TArm, subj: MatchSubj, merge_id: u32, names: []str): LowerCtx | error {
    var cur = ctx
    var i: u64 = 0
    loop {
        if i >= arms.len { break }
        cur = match lower_match_arm_stmt(cur, e, arms[i], subj, merge_id, names) { LowerCtx as c => c; error as err => return err }
        i++
    }
    cur
}

fn lower_match_stmt(ctx: LowerCtx, e: checker::TExpr, m: checker::TMatchExpr, subj: MatchSubj): Lowered | error {
    var names = reassigned_scalars_for_match(m.arms, ctx.env)
    var indices = merge_scalar_indices(ctx.env, names)
    var mergeb = alloc_block(ctx.func)
    var merged = add_merge_scalar_params(mergeb.func, mergeb.block_id, ctx.env, names)
    var base_ctx = ctx_with(ctx, merged.func, ctx.block_id, ctx.env)
    var chain = match lower_match_arms_stmt(base_ctx, e, m.arms, subj, mergeb.block_id, names) { LowerCtx as c => c; error as err => return err }
    var closed = append_inst(chain.func, chain.block_id, jump_inst(mergeb.block_id, arm_scalar_args(chain.env, indices), e.line, e.col))
    Lowered { ctx = ctx_with(chain, closed, mergeb.block_id, merged.env); vreg = 0 }
}

fn lower_match(ctx: LowerCtx, e: checker::TExpr, m: checker::TMatchExpr): Lowered | error {
    var so = match lower_match_subject_conveyed(ctx, m) { MatchSubjOut as x => x; error as err => return err }
    if type_is_void(e.type) { return lower_match_stmt(so.ctx, e, m, so.subj) }
    lower_match_value(so.ctx, e, m, so.subj)
}

fn match_arm_binds_escaping(arms: []checker::TArm, escaping: []str): bool {
    var i: u64 = 0
    loop {
        if i >= arms.len { break }
        match arms[i].pattern {
            parser::BindPattern as bp => { if bp.has_binding && contains_str(escaping, bp.binding) { return true } }
            parser::FieldPattern as fp => {
                var j: u64 = 0
                loop { if j >= fp.fields.len { break }; if contains_str(escaping, fp.fields[j]) { return true }; j++ }
            }
            _ => { }
        }
        i++
    }
    false
}

fn lower_match_subject_conveyed(ctx: LowerCtx, m: checker::TMatchExpr): MatchSubjOut | error {
    if ctx.bracket_depth > 0 || !match_arm_binds_escaping(m.arms, ctx.escaping) {
        return lower_match_subject(ctx, m.subject)
    }
    var left = emit_region_leaves(ctx, m.subject.line, m.subject.col)
    var marked = ctx_with_bracket_depth(left, 1)
    var s = match lower_match_subject(marked, m.subject) { MatchSubjOut as x => x; error as err => return err }
    var entered = emit_region_enters(s.ctx, m.subject.line, m.subject.col)
    MatchSubjOut { ctx = ctx_with_bracket_depth(entered, ctx.bracket_depth); subj = s.subj }
}

fn is_fat_type(t: @Type()): bool {
    if is_str_type(t) { return true }
    if is_char_type(t) { return true }
    match t {
        checker::Slice => true
        _ => false
    }
}

pub type LoweredFat = struct { ctx: LowerCtx; ptr: u32; len: u32 }

pub fn lower_fat_expr(ctx: LowerCtx, e: checker::TExpr): LoweredFat | error {
    match e.kind {
        checker::TStrLit as s => lower_str_lit_fat(ctx, e, s)
        checker::TCharLit as c => lower_char_lit_fat(ctx, e, c)
        checker::TByteStrLit as bs => lower_bytestr_lit_fat(ctx, e, bs)
        checker::TCast as c => lower_fat_cast(ctx, e, c)
        checker::TArrayLit as al => lower_array_lit_fat(ctx, e, al)
        checker::TSliceOfLen as sol => lower_slice_of_len_fat(ctx, e, sol)
        checker::TZeroOf as z => lower_zero_of_fat(ctx, e, z)
        checker::TVar as v => lower_var_fat(ctx, e, v)
        checker::TFieldAccess as fa => lower_fat_field(ctx, fa)
        checker::TIfExpr as f => lower_if_fat(ctx, e, f)
        checker::TMatchExpr as mx => lower_match_fat(ctx, e, mx)
        checker::TCall as cl => lower_call_fat(ctx, e, cl)
        checker::TInterp as ip => lower_interp_fat(ctx, e, ip)
        checker::TIndex as ix => lower_index_fat(ctx, e, ix)
        _ => error { message = teko::str::concat("native backend N1: fat-pointer receiver `", texpr_kind_name(e), "` not yet lowered (N2)") }
    }
}

fn lower_call_fat(ctx: LowerCtx, e: checker::TExpr, cl: checker::TCall): LoweredFat | error {
    if cl.is_closure_call { return lower_closure_call_fat(ctx, e, cl) }
    if cl.is_iface_dispatch { return error { message = "native backend N1: fat-pointer interface-dispatch result not yet lowered (N2)" } }
    if cl.call_ns.len == 0 && is_list_builtin_call(cl.callee) { return lower_list_builtin(ctx, e, cl) }
    if cl.call_ns.len == 0 && is_concat_builtin_call(cl.callee) { return lower_concat_call(ctx, e, cl) }
    if cl.call_ns.len == 0 && is_append_fo_call(cl.callee) { return lower_append_fo_call(ctx, e, cl) }
    if cl.call_ns.len == 0 && is_bytes_from_ptr_call(cl.callee) { return lower_bytes_from_ptr_call(ctx, cl) }
    if cl.call_ns.len == 0 && is_slice_view_call(cl.callee) { return lower_slice_view_call(ctx, cl) }
    var sym = match call_symbol(cl, ctx.externs, ctx.flat_symbols) { str as s => s; error as err => return err }
    var effective = match fat_extern_len_twin(sym) { str as t => t; null => sym }
    var lo = match lower_args(ctx, cl.args, callee_param_types(cl)) { LoweredArgs as x => x; error as err => return err }
    lower_len_out_call(lo.ctx, effective, lo.vregs, e)
}

fn fat_extern_len_twin(sym: str): str | null {
    if sym == "tk_rt_version" { return "tk_rt_version_len" }
    if sym == "tk_rt_read_line" { return "tk_rt_read_line_len" }
    if sym == "tk_rt_read_stdin" { return "tk_rt_read_stdin_len" }
    if sym == "tk_assert_scenario_prefix" { return "tk_assert_scenario_prefix_len" }
    if sym == "tk_test_scope" { return "tk_test_scope_len" }
    null
}

fn is_concat_builtin_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "concat"
}

fn lower_concat_call(ctx: LowerCtx, e: checker::TExpr, cl: checker::TCall): LoweredFat | error {
    if cl.args.len == 0 { return lower_list_empty(ctx, e) }
    match cl.args[0].kind {
        checker::TArrayLit as al => lower_concat_elements(ctx, e, al.elements)
        _ => error { message = "native backend N1: `teko::str::concat` over an existing []str slice is not yet lowered (N2)" }
    }
}

fn lower_concat_elements(ctx: LowerCtx, e: checker::TExpr, elements: []checker::TArrayElem): LoweredFat | error {
    if elements.len == 0 { return lower_list_empty(ctx, e) }
    var acc = match concat_seed(ctx, e, elements) { LoweredFat as x => x; error as err => return err }
    var i: u64 = if elements[0].is_spread { 0 } else { 1 }
    loop {
        if i >= elements.len { break }
        if elements[i].is_spread {
            acc = match fold_spread_concat(acc, elements[i].expr, e) { LoweredFat as x => x; error as err => return err }
        } else {
            var arg = match lower_fat_expr(acc.ctx, elements[i].expr) { LoweredFat as x => x; error as err => return err }
            acc = lower_len_out_call(arg.ctx, "tk_str_concat_len", four_args(acc.ptr, acc.len, arg.ptr, arg.len), e)
        }
        i++
    }
    acc
}

fn concat_seed(ctx: LowerCtx, e: checker::TExpr, elements: []checker::TArrayElem): LoweredFat | error {
    if elements[0].is_spread { return lower_list_empty(ctx, e) }
    lower_fat_expr(ctx, elements[0].expr)
}

fn fold_spread_concat(acc: LoweredFat, xs_expr: checker::TExpr, e: checker::TExpr): LoweredFat | error {
    var xs = match lower_fat_expr(acc.ctx, xs_expr) { LoweredFat as x => x; error as err => return err }
    var ctx0 = xs.ctx
    var headb = alloc_block(ctx0.func)
    var bodyb = alloc_block(headb.func)
    var exitb = alloc_block(bodyb.func)
    var pj = add_block_param(exitb.func, headb.block_id)
    var pap = add_block_param(pj.func, headb.block_id)
    var pal = add_block_param(pap.func, headb.block_id)
    var xrp = add_block_param(pal.func, exitb.block_id)
    var xrl = add_block_param(xrp.func, exitb.block_id)
    var j0 = alloc_vreg(xrl.func)
    var f1 = append_inst(j0.func, ctx0.block_id, const_int_inst(j0.vreg, 0, e.line, e.col))
    var f2 = append_inst(f1, ctx0.block_id, jump_inst(headb.block_id, [j0.vreg, acc.ptr, acc.len], e.line, e.col))
    var cmp = alloc_vreg(f2)
    var f3 = append_inst(cmp.func, headb.block_id, bin_inst(cmp.vreg, LBinOp::ICmpLtU, pj.vreg, xs.len, e.line, e.col))
    var f4 = append_inst(f3, headb.block_id, branch_inst(cmp.vreg, bodyb.block_id, [pj.vreg, pap.vreg, pal.vreg], exitb.block_id, [pap.vreg, pal.vreg], e.line, e.col))
    var bodyctx = ctx_with(ctx0, f4, bodyb.block_id, ctx0.env)
    var addr = element_addr_at(bodyctx, xs.ptr, pj.vreg, str_fat_value_bytes(), e.line, e.col)
    var s = load_fat_slot(addr.ctx, addr.vreg, e.line, e.col)
    var joined = lower_len_out_call(s.ctx, "tk_str_concat_len", four_args(pap.vreg, pal.vreg, s.ptr, s.len), e)
    var one = ctx_alloc(joined.ctx)
    var withone = ctx_append(one.ctx, const_int_inst(one.vreg, 1, e.line, e.col))
    var j2 = ctx_alloc(withone)
    var withj2 = ctx_append(j2.ctx, bin_inst(j2.vreg, LBinOp::IAdd, pj.vreg, one.vreg, e.line, e.col))
    var looped = ctx_append(withj2, jump_inst(headb.block_id, [j2.vreg, joined.ptr, joined.len], e.line, e.col))
    LoweredFat { ctx = ctx_with(looped, looped.func, exitb.block_id, ctx0.env); ptr = xrp.vreg; len = xrl.vreg }
}

fn is_append_fo_call(callee: parser::Path): bool {
    var segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "append_fo"
}

fn lower_append_fo_call(ctx: LowerCtx, e: checker::TExpr, cl: checker::TCall): LoweredFat | error {
    if cl.args.len != 2 { return error { message = "native backend N1: `teko::mem::append_fo` expects (bytes, str) (internal)" } }
    var dst = match lower_fat_expr(ctx, cl.args[0]) { LoweredFat as x => x; error as err => return err }
    var src = match lower_fat_expr(dst.ctx, cl.args[1]) { LoweredFat as x => x; error as err => return err }
    lower_len_out_call(src.ctx, "tk_append_bytes_fo", four_args(dst.ptr, dst.len, src.ptr, src.len), e)
}

fn lower_list_builtin(ctx: LowerCtx, e: checker::TExpr, cl: checker::TCall): LoweredFat | error {
    var last = cl.callee.segments[cl.callee.segments.len - 1].name
    if last == "empty" { return lower_list_empty(ctx, e) }
    error { message = teko::str::concat("native backend: `teko::list::", last, "`/`teko::mem::push_fo` slice-grow builtin is retired (NO PUSHES) — build with a sized `[]T` literal + index-fill instead") }
}

fn lower_list_empty(ctx: LowerCtx, e: checker::TExpr): LoweredFat {
    var p = ctx_alloc(ctx)
    var with_ptr = ctx_append(p.ctx, const_int_inst(p.vreg, 0, e.line, e.col))
    var l = ctx_alloc(with_ptr)
    var with_len = ctx_append(l.ctx, const_int_inst(l.vreg, 0, e.line, e.col))
    LoweredFat { ctx = with_len; ptr = p.vreg; len = l.vreg }
}

fn aggregate_box_bytes(t: @Type(), ctx: LowerCtx): u32 | null {
    if is_register_value_type(t, ctx.enums) { return null }
    match expand_named_variant(t, ctx.variants) {
        checker::Named as n => named_layout_bytes(n, ctx)
        checker::Variant => variant_wrapper_bytes()
        checker::Error => error_struct_layout().size
        _ => null
    }
}

fn named_layout_bytes(n: checker::Named, ctx: LowerCtx): u32 | null {
    match find_known_struct_layout(ctx.layouts, n.name) {
        LStructLayout as l => l.size
        null => null
    }
}

fn aggregate_form_name(t: @Type()): str {
    match t {
        checker::Named as n => teko::str::concat("the nominal type `", teko::str::concat(n.name, "`, which has no registered layout"))
        checker::Func => "a CLOSURE, whose captured environment is a second allocation this copy would alias"
        _ => "an aggregate this backend assigns no whole-type byte width"
    }
}

fn unsized_aggregate_push_stop(form: str): error {
    error { message = teko::str::concat("native backend N1: a push whose element is ", teko::str::concat(form, " — this backend holds aggregate slice elements BY ADDRESS and boxes each pushed item into fresh storage, which needs a byte width the element type alone fixes (N2)")) }
}

fn box_aggregate_value(v: Lowered, box_bytes: u32, e: checker::TExpr): Lowered {
    box_aggregate_value_at(v, box_bytes, e.line, e.col)
}

fn box_aggregate_value_at(v: Lowered, box_bytes: u32, line: u32, col: u32): Lowered {
    if box_bytes == 0 { return v }
    emit_elem_box(v, box_bytes, line, col)
}

fn emit_elem_box(v: Lowered, bytes: u32, line: u32, col: u32): Lowered {
    var size = ctx_alloc(v.ctx)
    var with_size = ctx_append(size.ctx, const_int_inst(size.vreg, bytes to i64, line, col))
    var args: []u32 = [v.vreg]
    args = [..args, size.vreg]
    var boxed = ctx_alloc(with_size)
    Lowered { ctx = ctx_append(boxed.ctx, call_inst(boxed.vreg, "tk_slice_elem_box", args, false, line, col)); vreg = boxed.vreg }
}

fn returned_aggregate_box_bytes(t: @Type(), ctx: LowerCtx): u32 {
    if is_fat_type(t) { return 0 to u32 }
    match aggregate_box_bytes(t, ctx) {
        u32 as n => n
        null => 0 to u32
    }
}

fn own_returned_value(v: Lowered, line: u32, col: u32): Lowered {
    box_aggregate_value_at(v, returned_aggregate_box_bytes(v.ctx.ret_type, v.ctx), line, col)
}

fn aggregate_box_align(t: @Type(), ctx: LowerCtx): u32 | null {
    if is_register_value_type(t, ctx.enums) { return null }
    match expand_named_variant(t, ctx.variants) {
        checker::Named as n => named_layout_align(n, ctx)
        checker::Variant => variant_wrapper_align()
        checker::Error => error_struct_layout().align
        _ => null
    }
}

fn named_layout_align(n: checker::Named, ctx: LowerCtx): u32 | null {
    match find_known_struct_layout(ctx.layouts, n.name) {
        LStructLayout as l => l.align
        null => null
    }
}

fn expr_is_aggregate_place(e: checker::TExpr): bool {
    match e.kind {
        checker::TVar => true
        checker::TFieldAccess => true
        checker::TIndex => true
        checker::TPathExpr => true
        _ => false
    }
}

fn aggregate_place_copy_bytes(e: checker::TExpr, ctx: LowerCtx): u32 {
    if !expr_is_aggregate_place(e) { return 0 to u32 }
    match aggregate_box_bytes(e.type, ctx) {
        u32 as n => n
        null => 0 to u32
    }
}

fn copy_aggregate_place(ctx: LowerCtx, v: u32, bytes: u32, align: u32, line: u32, col: u32): Lowered {
    var dst = ctx_alloc(ctx)
    var with_alloca = ctx_append(dst.ctx, alloca_inst(dst.vreg, bytes, align, line, col))
    var width = ctx_alloc(with_alloca)
    var with_width = ctx_append(width.ctx, const_int_inst(width.vreg, bytes to i64, line, col))
    var args = [..two_args(dst.vreg, v), width.vreg]
    Lowered { ctx = ctx_append(with_width, void_call_inst("tk_mem_copy", args, false, line, col)); vreg = dst.vreg }
}

fn own_bound_value(v: Lowered, e: checker::TExpr): Lowered {
    var bytes = aggregate_place_copy_bytes(e, v.ctx)
    if bytes == 0 { return v }
    match aggregate_box_align(e.type, v.ctx) {
        u32 as align => copy_aggregate_place(v.ctx, v.vreg, bytes, align, e.line, e.col)
        null => v
    }
}

fn embedded_aggregate_box_bytes(t: @Type(), ctx: LowerCtx): u32 {
    if is_fat_type(t) { return 0 to u32 }
    match aggregate_box_bytes(t, ctx) {
        u32 as n => n
        null => 0 to u32
    }
}

fn own_embedded_value(v: Lowered, e: checker::TExpr): Lowered {
    box_aggregate_value(v, embedded_aggregate_box_bytes(e.type, v.ctx), e)
}

fn is_register_value_type(t: @Type(), enums: []LEnumInfo): bool {
    match t {
        checker::Prim => true
        checker::Byte => true
        checker::Named as n => match find_value_carrier(enums, n.name) { LEnumInfo as info => info.is_register; null => false }
        _ => false
    }
}

fn merge_fat_value_args(ptr: u32, len: u32): []u32 {
    [ptr, len]
}

pub type LowerBlockValueFat = struct { ctx: LowerCtx; terminated: bool; ptr: u32; len: u32 }

fn lower_block_value_fat(ctx: LowerCtx, body: []@TStatement()): LowerBlockValueFat | error {
    if body.len == 0 { return error { message = "native backend N1: empty if-expression arm (internal)" } }
    var pre = match lower_block_prefix_fat(ctx, body) { LowerStmtOut as x => x; error as err => return err }
    if pre.terminated { return LowerBlockValueFat { ctx = pre.ctx; terminated = true; ptr = 0; len = 0 } }
    lower_tail_stmt_fat(pre.ctx, body[body.len - 1])
}

fn lower_block_prefix_fat(ctx: LowerCtx, body: []@TStatement()): LowerStmtOut | error {
    var cur = ctx
    var i: u64 = 0
    loop {
        if i + 1 >= body.len { break }
        var out = match lower_stmt(cur, body[i]) { LowerStmtOut as x => x; error as err => return err }
        cur = out.ctx
        if out.terminated { return LowerStmtOut { ctx = cur; terminated = true } }
        i++
    }
    LowerStmtOut { ctx = cur; terminated = false }
}

fn lower_fn_tail_fat(ctx: LowerCtx, s: @TStatement(), line: u32, col: u32): LowerBlockValueFat | error {
    match s {
        checker::TExprStmt as es => lower_conveyed_tail_expr_stmt_fat(ctx, es, line, col)
        _ => lower_tail_non_expr_fat(ctx, s)
    }
}

fn lower_conveyed_tail_expr_stmt_fat(ctx: LowerCtx, es: checker::TExprStmt, line: u32, col: u32): LowerBlockValueFat | error {
    if ctx.bracket_depth > 0 { return lower_body_tail_expr_stmt_fat(ctx, es) }
    var left = emit_region_leaves(ctx, line, col)
    var marked = ctx_with_bracket_depth(left, 1)
    var out = match lower_body_tail_expr_stmt_fat(marked, es) { LowerBlockValueFat as x => x; error as err => return err }
    var entered = emit_region_enters(out.ctx, line, col)
    LowerBlockValueFat { ctx = ctx_with_bracket_depth(entered, ctx.bracket_depth); terminated = out.terminated; ptr = out.ptr; len = out.len }
}

fn lower_body_tail_expr_stmt_fat(ctx: LowerCtx, es: checker::TExprStmt): LowerBlockValueFat | error {
    if type_is_void(es.expr.type) { return lower_tail_expr_stmt_fat(ctx, es) }
    var fo = match lower_fat_expr_into_type(ctx, ctx.ret_type, es.expr) { LoweredFat as x => x; error as err => return err }
    LowerBlockValueFat { ctx = fo.ctx; terminated = false; ptr = fo.ptr; len = fo.len }
}

fn lower_tail_stmt_fat(ctx: LowerCtx, s: @TStatement()): LowerBlockValueFat | error {
    match s {
        checker::TExprStmt as es => lower_tail_expr_stmt_fat(ctx, es)
        _ => lower_tail_non_expr_fat(ctx, s)
    }
}

fn lower_tail_expr_stmt_fat(ctx: LowerCtx, es: checker::TExprStmt): LowerBlockValueFat | error {
    var fo = match lower_fat_expr(ctx, es.expr) { LoweredFat as x => x; error as err => return err }
    LowerBlockValueFat { ctx = fo.ctx; terminated = false; ptr = fo.ptr; len = fo.len }
}

fn diverging_tail_value_fat(ctx: LowerCtx): LowerBlockValueFat {
    var p = ctx_alloc(ctx)
    var with_ptr = ctx_append(p.ctx, const_int_inst(p.vreg, 0, 0, 0))
    var l = ctx_alloc(with_ptr)
    var with_len = ctx_append(l.ctx, const_int_inst(l.vreg, 0, 0, 0))
    LowerBlockValueFat { ctx = with_len; terminated = false; ptr = p.vreg; len = l.vreg }
}

fn lower_tail_non_expr_fat(ctx: LowerCtx, s: @TStatement()): LowerBlockValueFat | error {
    var out = match lower_stmt(ctx, s) { LowerStmtOut as x => x; error as err => return err }
    if out.terminated { return LowerBlockValueFat { ctx = out.ctx; terminated = true; ptr = 0; len = 0 } }
    diverging_tail_value_fat(out.ctx)
}

fn lower_if_fat(ctx: LowerCtx, e: checker::TExpr, f: checker::TIfExpr): LoweredFat | error {
    if !f.has_else { return error { message = "native backend N1: if-without-else used as a fat value not yet lowered (N2)" } }
    var co = match lower_expr(ctx, f.cond) { Lowered as x => x; error as err => return err }
    var names = reassigned_scalars(if_arm_stmts(f), co.ctx.env)
    var indices = merge_scalar_indices(co.ctx.env, names)
    var thenb = alloc_block(co.ctx.func)
    var elseb = alloc_block(thenb.func)
    var mergeb = alloc_block(elseb.func)
    var mpp = add_block_param(mergeb.func, mergeb.block_id)
    var mpl = add_block_param(mpp.func, mergeb.block_id)
    var merged = add_merge_scalar_params(mpl.func, mergeb.block_id, co.ctx.env, names)
    var br = branch_inst(co.vreg, thenb.block_id, [], elseb.block_id, [], e.line, e.col)
    var ctx1 = ctx_append(ctx_with(co.ctx, merged.func, co.ctx.block_id, co.ctx.env), br)
    var then_opened = match open_native_region(ctx_goto(ctx1, thenb.block_id), "", false, checker::scope_slot_count(f.then_blk) == 0, e.line, e.col) { LowerCtx as c => c; error as err => return err }
    var then_fat = match lower_block_value_fat(then_opened, f.then_blk) { LowerBlockValueFat as x => x; error as err => return err }
    var then_closed = match close_arm_replaying_defers(then_fat.ctx, ctx1.defers, ctx1.region_stack, mergeb.block_id, merge_fat_value_args(then_fat.ptr, then_fat.len), indices, e.line, e.col) { ClosedArm as c => c; error as err => return err }
    var else_ctx = ctx_with(then_closed.ctx, then_closed.func, elseb.block_id, co.ctx.env)
    var else_opened = match open_native_region(else_ctx, "", false, checker::scope_slot_count(f.else_blk) == 0, e.line, e.col) { LowerCtx as c => c; error as err => return err }
    var else_fat = match lower_block_value_fat(else_opened, f.else_blk) { LowerBlockValueFat as x => x; error as err => return err }
    var else_closed = match close_arm_replaying_defers(else_fat.ctx, ctx1.defers, ctx1.region_stack, mergeb.block_id, merge_fat_value_args(else_fat.ptr, else_fat.len), indices, e.line, e.col) { ClosedArm as c => c; error as err => return err }
    LoweredFat { ctx = ctx_with(else_closed.ctx, else_closed.func, mergeb.block_id, merged.env); ptr = mpp.vreg; len = mpl.vreg }
}

fn lower_match_fat(ctx: LowerCtx, e: checker::TExpr, m: checker::TMatchExpr): LoweredFat | error {
    var so = match lower_match_subject_conveyed(ctx, m) { MatchSubjOut as x => x; error as err => return err }
    var names = reassigned_scalars_for_match(m.arms, so.ctx.env)
    var indices = merge_scalar_indices(so.ctx.env, names)
    var mergeb = alloc_block(so.ctx.func)
    var mpp = add_block_param(mergeb.func, mergeb.block_id)
    var mpl = add_block_param(mpp.func, mergeb.block_id)
    var merged = add_merge_scalar_params(mpl.func, mergeb.block_id, so.ctx.env, names)
    var base_ctx = ctx_with(so.ctx, merged.func, so.ctx.block_id, so.ctx.env)
    var chain = match lower_match_arms_fat(base_ctx, e, m.arms, so.subj, mergeb.block_id, names) { LowerCtx as c => c; error as err => return err }
    var closed = close_dead_fat_fallthrough(chain, mergeb.block_id, indices, e)
    LoweredFat { ctx = ctx_with(closed, closed.func, mergeb.block_id, merged.env); ptr = mpp.vreg; len = mpl.vreg }
}

fn close_dead_fat_fallthrough(ctx: LowerCtx, merge_id: u32, indices: []u64, e: checker::TExpr): LowerCtx {
    var zp = ctx_alloc(ctx)
    var with_zp = ctx_append(zp.ctx, const_int_inst(zp.vreg, lfallback_const(LType::Ptr), e.line, e.col))
    var zl = ctx_alloc(with_zp)
    var with_zl = ctx_append(zl.ctx, const_int_inst(zl.vreg, lfallback_const(LType::I64), e.line, e.col))
    var args = append_all_u32(merge_fat_value_args(zp.vreg, zl.vreg), arm_scalar_args(with_zl.env, indices))
    var jumped = append_inst(with_zl.func, with_zl.block_id, jump_inst(merge_id, args, e.line, e.col))
    ctx_with(with_zl, jumped, with_zl.block_id, with_zl.env)
}

fn lower_match_arms_fat(ctx: LowerCtx, e: checker::TExpr, arms: []checker::TArm, subj: MatchSubj, merge_id: u32, names: []str): LowerCtx | error {
    var cur = ctx
    var i: u64 = 0
    loop {
        if i >= arms.len { break }
        cur = match lower_match_arm_fat(cur, e, arms[i], subj, merge_id, names) { LowerCtx as c => c; error as err => return err }
        i++
    }
    cur
}

fn lower_match_arm_fat(ctx: LowerCtx, e: checker::TExpr, arm: checker::TArm, subj: MatchSubj, merge_id: u32, names: []str): LowerCtx | error {
    var indices = merge_scalar_indices(ctx.env, names)
    var step = match lower_match_arm_entry(ctx, e, arm, subj) { MatchArmEntry as x => x; error as err => return err }
    var opened = match open_native_region(step.ctx, "", false, checker::scope_slot_count(arm.body) == 0, e.line, e.col) { LowerCtx as c => c; error as err => return err }
    var bv = match lower_block_value_fat(opened, arm.body) { LowerBlockValueFat as x => x; error as err => return err }
    var closed = match close_arm_replaying_defers(bv.ctx, ctx.defers, step.ctx.region_stack, merge_id, merge_fat_value_args(bv.ptr, bv.len), indices, e.line, e.col) { ClosedArm as c => c; error as err => return err }
    ctx_with(closed.ctx, closed.func, step.next_block, ctx.env)
}

fn lower_fat_field(ctx: LowerCtx, fa: checker::TFieldAccess): LoweredFat | error {
    if is_ref_deref(fa) { return lower_ref_deref_read_fat(ctx, fa) }
    var ro = match lower_expr(ctx, fa.receiver) { Lowered as x => x; error as e => return e }
    var name = match named_type_name(fa.receiver.type) { str as s => s; error as e => return e }
    var layout = match find_struct_layout(ro.ctx.layouts, name) { LStructLayout as l => l; error as e => return e }
    var off = match field_offset_of(layout, fa.field) { u32 as o => o; error as e => return e }
    var pa = ctx_alloc(ro.ctx)
    var with_pa = ctx_append(pa.ctx, field_addr_inst(pa.vreg, ro.vreg, off, fa.receiver.line, fa.receiver.col))
    var pr = ctx_alloc(with_pa)
    var with_pr = ctx_append(pr.ctx, load_inst(pr.vreg, pa.vreg, LType::Ptr, fa.receiver.line, fa.receiver.col))
    var la = ctx_alloc(with_pr)
    var with_la = ctx_append(la.ctx, field_addr_inst(la.vreg, ro.vreg, off + ltype_size(LType::Ptr), fa.receiver.line, fa.receiver.col))
    var lr = ctx_alloc(with_la)
    LoweredFat { ctx = ctx_append(lr.ctx, load_inst(lr.vreg, la.vreg, LType::I64, fa.receiver.line, fa.receiver.col)); ptr = pr.vreg; len = lr.vreg }
}

fn lower_ref_deref_read_fat(ctx: LowerCtx, fa: checker::TFieldAccess): LoweredFat | error {
    var ro = match lower_expr(ctx, fa.receiver) { Lowered as x => x; error as e => return e }
    load_fat_slot(ro.ctx, ro.vreg, fa.receiver.line, fa.receiver.col)
}

fn lower_var_fat(ctx: LowerCtx, e: checker::TExpr, v: checker::TVar): LoweredFat | error {
    var slot = lenv_lookup_fat_slot(ctx.env, v.name)
    if slot.found { return load_fat_slot(ctx, slot.slot, e.line, e.col) }
    var hit = lenv_lookup_fat(ctx.env, v.name)
    if hit.found && hit.has_len { return LoweredFat { ctx = ctx; ptr = hit.ptr; len = hit.len } }
    match lookup_const_rodata(ctx, v.name) {
        LRodata as r => lower_const_fat(ctx, e, r)
        null => error { message = teko::str::concat("native backend N1: `", v.name, "` is not a fat-pointer local (internal)") }
    }
}

fn fat_value_bytes(t: @Type()): u32 {
    if is_str_type(t) { return str_fat_value_bytes() }
    slice_fat_value_bytes()
}

fn str_fat_value_bytes(): u32 { ltype_size(LType::Ptr) + ltype_size(LType::I64) }

fn slice_fat_value_bytes(): u32 { ltype_size(LType::Ptr) + ltype_size(LType::I64) }

fn fat_slot_bytes(): u32 { str_fat_value_bytes() }

fn alloc_fat_slot(ctx: LowerCtx, fo: LoweredFat, line: u32, col: u32): Lowered {
    var slot = ctx_alloc(fo.ctx)
    var with_slot = ctx_append(slot.ctx, alloca_inst(slot.vreg, fat_slot_bytes(), ltype_align(LType::Ptr), line, col))
    Lowered { ctx = store_fat_slot(with_slot, slot.vreg, fo, line, col); vreg = slot.vreg }
}

fn store_fat_image(ctx: LowerCtx, addr: u32, fo: LoweredFat, carries_cap: bool, line: u32, col: u32): LowerCtx {
    var with_ptr = ctx_append(ctx, store_inst(addr, fo.ptr, LType::Ptr, line, col))
    var la = ctx_alloc(with_ptr)
    var with_la = ctx_append(la.ctx, field_addr_inst(la.vreg, addr, ltype_size(LType::Ptr), line, col))
    var with_len = ctx_append(with_la, store_inst(la.vreg, fo.len, LType::I64, line, col))
    store_fat_image_cap(with_len, addr, fo.len, carries_cap, line, col)
}

fn store_fat_image_cap(ctx: LowerCtx, addr: u32, len: u32, carries_cap: bool, line: u32, col: u32): LowerCtx {
    if !carries_cap { return ctx }
    match slice_cap_word_offset() {
        u32 as off => {
            var ca = ctx_alloc(ctx)
            var with_ca = ctx_append(ca.ctx, field_addr_inst(ca.vreg, addr, off, line, col))
            ctx_append(with_ca, store_inst(ca.vreg, len, LType::I64, line, col))
        }
        null => ctx
    }
}

fn slice_cap_word_offset(): u32 | null {
    if slice_fat_value_bytes() <= str_fat_value_bytes() { return null }
    str_fat_value_bytes()
}

fn store_fat_slot(ctx: LowerCtx, slot: u32, fo: LoweredFat, line: u32, col: u32): LowerCtx {
    store_fat_image(ctx, slot, fo, false, line, col)
}

fn load_fat_image(ctx: LowerCtx, addr: u32, line: u32, col: u32): LoweredFat {
    var pr = load_fat_slot_ptr(ctx, addr, line, col)
    var la = ctx_alloc(pr.ctx)
    var with_la = ctx_append(la.ctx, field_addr_inst(la.vreg, addr, ltype_size(LType::Ptr), line, col))
    var lr = ctx_alloc(with_la)
    LoweredFat { ctx = ctx_append(lr.ctx, load_inst(lr.vreg, la.vreg, LType::I64, line, col)); ptr = pr.vreg; len = lr.vreg }
}

fn load_fat_slot(ctx: LowerCtx, slot: u32, line: u32, col: u32): LoweredFat {
    load_fat_image(ctx, slot, line, col)
}

fn load_fat_slot_ptr(ctx: LowerCtx, slot: u32, line: u32, col: u32): Lowered {
    var pr = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(pr.ctx, load_inst(pr.vreg, slot, LType::Ptr, line, col)); vreg = pr.vreg }
}

fn lower_const_fat(ctx: LowerCtx, e: checker::TExpr, r: LRodata): LoweredFat | error {
    var n = match const_fat_len(e.type, r.bytes.len to u32, ctx.enums) { u32 as x => x; error as err => return err }
    var ptr = ctx_alloc(ctx)
    var with_ptr = ctx_append(ptr.ctx, global_addr_inst(ptr.vreg, r.symbol, e.line, e.col))
    var lenr = ctx_alloc(with_ptr)
    var with_len = ctx_append(lenr.ctx, const_int_inst(lenr.vreg, n to i64, e.line, e.col))
    LoweredFat { ctx = with_len; ptr = ptr.vreg; len = lenr.vreg }
}

fn const_fat_len(t: @Type(), byte_len: u32, enums: []LEnumInfo): u32 | error {
    if is_str_type(t) { return byte_len }
    match t {
        checker::Slice as s => const_slice_len(s.element, byte_len, enums)
        _ => error { message = "native backend N1: aggregate const fat receiver is not a str/slice (internal)" }
    }
}

fn const_slice_len(element: @Type(), byte_len: u32, enums: []LEnumInfo): u32 | error {
    var stride = elem_byte_stride(element, enums)
    if stride == 0 { return error { message = "native backend N1: aggregate const slice has a zero-stride element (internal)" } }
    byte_len / stride
}

fn rodata_symbol(index: u64): str {
    teko::str::concat(".Lstr", teko::u64_to_str(index))
}

fn str_to_bytes(s: str): []byte {
    var out: [s.len]byte = []
    var i: u64 = 0
    loop {
        if i >= s.len { break }
        out[i] = s[i]
        i++
    }
    out
}

pub type InternedRodata = struct { ctx: LowerCtx; symbol: str }

fn intern_rodata(ctx: LowerCtx, text: str): InternedRodata {
    var sym = rodata_symbol(ctx.rodata_base + ctx.rodata.len)
    var entry = LRodata { symbol = sym; bytes = str_to_bytes(text); relocs = [] }
    InternedRodata { ctx = ctx_with_rodata(ctx, [..ctx.rodata, entry]); symbol = sym }
}

fn lower_str_bytes_fat(ctx: LowerCtx, text: str, line: u32, col: u32): LoweredFat {
    var interned = intern_rodata(ctx, text)
    var ptr = ctx_alloc(interned.ctx)
    var with_ptr = ctx_append(ptr.ctx, global_addr_inst(ptr.vreg, interned.symbol, line, col))
    var lenr = ctx_alloc(with_ptr)
    var with_len = ctx_append(lenr.ctx, const_int_inst(lenr.vreg, text.len to i64, line, col))
    LoweredFat { ctx = with_len; ptr = ptr.vreg; len = lenr.vreg }
}

fn lower_str_lit_fat(ctx: LowerCtx, e: checker::TExpr, s: checker::TStrLit): LoweredFat {
    lower_str_bytes_fat(ctx, s.text, e.line, e.col)
}

fn lower_str_lit(ctx: LowerCtx, e: checker::TExpr, s: checker::TStrLit): Lowered {
    var f = lower_str_lit_fat(ctx, e, s)
    Lowered { ctx = f.ctx; vreg = f.ptr }
}

fn lower_bytestr_lit_fat(ctx: LowerCtx, e: checker::TExpr, s: checker::TByteStrLit): LoweredFat {
    lower_str_bytes_fat(ctx, s.text, e.line, e.col)
}

fn lower_is_str_or_byte_slice(t: @Type()): bool {
    if is_str_type(t) { return true }
    if is_char_type(t) { return true }
    match t {
        checker::Slice as sl => match sl.element { checker::Byte => true; _ => false }
        _ => false
    }
}

fn lower_fat_cast(ctx: LowerCtx, e: checker::TExpr, c: checker::TCast): LoweredFat | error {
    if lower_is_str_or_byte_slice(e.type) && lower_is_str_or_byte_slice(c.expr.type) {
        return lower_fat_expr(ctx, c.expr)
    }
    error { message = teko::str::concat("native backend N1: fat-pointer cast `", texpr_kind_name(e), "` not yet lowered (N2)") }
}

fn lower_bytestr_lit(ctx: LowerCtx, e: checker::TExpr, s: checker::TByteStrLit): Lowered {
    var f = lower_bytestr_lit_fat(ctx, e, s)
    Lowered { ctx = f.ctx; vreg = f.ptr }
}

fn two_args(a: u32, b: u32): []u32 {
    [a, b]
}

fn single_arg(a: u32): []u32 {
    [a]
}

fn four_args(a_ptr: u32, a_len: u32, b_ptr: u32, b_len: u32): []u32 {
    [..two_args(a_ptr, a_len), b_ptr, b_len]
}

fn three_args(a: u32, b_ptr: u32, b_len: u32): []u32 {
    [..two_args(a, b_ptr), b_len]
}

fn lower_len_out_call(ctx: LowerCtx, sym: str, args: []u32, e: checker::TExpr): LoweredFat {
    var slot = ctx_alloc(ctx)
    var with_slot = ctx_append(slot.ctx, alloca_inst(slot.vreg, ltype_size(LType::I64), ltype_align(LType::I64), e.line, e.col))
    var all_args = [..args, slot.vreg]
    var called = ctx_alloc(with_slot)
    var with_call = ctx_append(called.ctx, call_inst(called.vreg, sym, all_args, false, e.line, e.col))
    var lenr = ctx_alloc(with_call)
    var with_len = ctx_append(lenr.ctx, load_inst(lenr.vreg, slot.vreg, LType::I64, e.line, e.col))
    LoweredFat { ctx = with_len; ptr = called.vreg; len = lenr.vreg }
}

fn lower_len_out_call_indirect(ctx: LowerCtx, target: u32, args: []u32, e: checker::TExpr): LoweredFat {
    var slot = ctx_alloc(ctx)
    var with_slot = ctx_append(slot.ctx, alloca_inst(slot.vreg, ltype_size(LType::I64), ltype_align(LType::I64), e.line, e.col))
    var all_args = [..args, slot.vreg]
    var called = ctx_alloc(with_slot)
    var with_call = ctx_append(called.ctx, call_indirect_inst(called.vreg, target, all_args, false, e.line, e.col, ltype_of(e.type, ctx.enums)))
    var lenr = ctx_alloc(with_call)
    var with_len = ctx_append(lenr.ctx, load_inst(lenr.vreg, slot.vreg, LType::I64, e.line, e.col))
    LoweredFat { ctx = with_len; ptr = called.vreg; len = lenr.vreg }
}

fn widen_hole_to_f64(ho: Lowered, k: checker::PrimKind, h: checker::TExpr): Lowered {
    if k != checker::PrimKind::F32 { return ho }
    var wide = ctx_alloc(ho.ctx)
    var to_f64 = un_inst(wide.vreg, LUnOp::FToF, ho.vreg, h.line, h.col)
    Lowered { ctx = ctx_append(wide.ctx, to_f64); vreg = wide.vreg }
}

fn lower_interp_hole_value_f64(ctx: LowerCtx, h: checker::TExpr): Lowered | error {
    var ho = match lower_expr(ctx, h) { Lowered as x => x; error as err => return err }
    var k = match h.type { checker::Prim as p => p.kind; _ => return error { message = "native backend N1: a float interpolation hole must have a primitive float type (internal)" } }
    widen_hole_to_f64(ho, k, h)
}

fn lower_interp_hole_scalar(ctx: LowerCtx, h: checker::TExpr, is_flt: bool): Lowered | error {
    if is_flt { return lower_interp_hole_value_f64(ctx, h) }
    lower_expr(ctx, h)
}

fn lower_interp_hole_prim_fat(ctx: LowerCtx, h: checker::TExpr, k: checker::PrimKind): LoweredFat | error {
    if k == checker::PrimKind::Bool { return error { message = "native backend N1: bool interpolation hole not yet lowered (N2) — the C route renders it as a ternary over two static `tk_str` literals, not through a runtime call" } }
    var is_flt = prim_is_float_kind(k)
    var ho = match lower_interp_hole_scalar(ctx, h, is_flt) { Lowered as x => x; error as err => return err }
    lower_len_out_call(ho.ctx, interp_hole_none_symbol(k, is_flt), single_arg(ho.vreg), h)
}

fn interp_hole_none_symbol(k: checker::PrimKind, is_flt: bool): str {
    if is_flt { return "teko_teko__runtime__ftoa_len" }
    if prim_is_signed_int(k) { return "teko_teko__runtime__i64_to_str_len" }
    "teko_teko__runtime__u64_to_str_len"
}

fn lower_interp_hole_none_fat(ctx: LowerCtx, h: checker::TExpr): LoweredFat | error {
    if is_str_type(h.type) { return lower_fat_expr(ctx, h) }
    match h.type {
        checker::Prim as p => lower_interp_hole_prim_fat(ctx, h, p.kind)
        _ => error { message = "native backend N1: interpolation hole of this type not yet lowered (N2)" }
    }
}

fn fmt_static_lead_low(spec: str): byte {
    var fc0 = if spec.len > 0 { spec[0] } else { b'f' }
    if fc0 >= b'A' && fc0 <= b'Z' { (fc0 to u64 + 32) to byte } else { fc0 }
}

fn fmt_static_prec(spec: str, fc_low: byte): i64 {
    var prec: i64 = 0
    var has_prec = false
    var si: u64 = 1
    loop {
        if si >= spec.len { break }
        var ch = spec[si]
        if ch >= b'0' && ch <= b'9' { prec = prec * 10 + (ch to i64 - 48); has_prec = true }
        si++
    }
    if has_prec { return prec }
    if fc_low == b'd' { 1 } else { 6 }
}

fn fmt_static_takes_prec(fc_low: byte, is_flt: bool): bool {
    if fc_low == b'x' { return false }
    if fc_low == b'b' { return false }
    if fc_low == b'n' && !is_flt { return false }
    true
}

fn fmt_static_symbol(spec: str, fc_low: byte, is_flt: bool): str | error {
    if fc_low == b'f' { return "teko_teko__runtime__fmt_f_len" }
    if fc_low == b'e' { return "teko_teko__runtime__fmt_e_len" }
    if fc_low == b'g' { return "teko_teko__runtime__fmt_g_len" }
    if fc_low == b'p' { return "teko_teko__runtime__fmt_p_len" }
    if fc_low == b'd' { return "teko_teko__runtime__fmt_d_len" }
    if fc_low == b'x' { return if spec.len > 0 && spec[0] == b'X' { "teko_teko__runtime__fmt_x_upper_len" } else { "teko_teko__runtime__fmt_x_lower_len" } }
    if fc_low == b'b' { return "teko_teko__runtime__fmt_b_len" }
    if fc_low == b'n' { return if is_flt { "teko_teko__runtime__fmt_n_f_len" } else { "teko_teko__runtime__fmt_n_i_len" } }
    error { message = "native backend N1: unrecognized format spec (internal)" }
}

fn hole_is_float(h: checker::TExpr): bool {
    match h.type { checker::Prim as p => prim_is_float_kind(p.kind); _ => false }
}

fn lower_interp_hole_static_fat(ctx: LowerCtx, h: checker::TExpr, fs: checker::TFSpecStatic): LoweredFat | error {
    var is_flt = hole_is_float(h)
    var ho = match lower_interp_hole_scalar(ctx, h, is_flt) { Lowered as x => x; error as err => return err }
    var fc_low = fmt_static_lead_low(fs.s)
    var sym = match fmt_static_symbol(fs.s, fc_low, is_flt) { str as s => s; error as err => return err }
    if !fmt_static_takes_prec(fc_low, is_flt) {
        return lower_len_out_call(ho.ctx, sym, single_arg(ho.vreg), h)
    }
    var precr = ctx_alloc(ho.ctx)
    var with_prec = ctx_append(precr.ctx, const_int_inst(precr.vreg, fmt_static_prec(fs.s, fc_low), h.line, h.col))
    lower_len_out_call(with_prec, sym, two_args(ho.vreg, precr.vreg), h)
}

fn lower_interp_hole_dynamic_fat(ctx: LowerCtx, h: checker::TExpr, fd: checker::TFSpecDynamic): LoweredFat | error {
    var ho = match lower_interp_hole_scalar(ctx, h, hole_is_float(h)) { Lowered as x => x; error as err => return err }
    var spec = match lower_fat_expr(ho.ctx, fd.args[0]) { LoweredFat as x => x; error as err => return err }
    var sym = dynamic_fmt_symbol(h)
    lower_len_out_call(spec.ctx, sym, three_args(ho.vreg, spec.ptr, spec.len), h)
}

fn dynamic_fmt_symbol(h: checker::TExpr): str {
    if hole_is_float(h) { return "teko_teko__runtime__fmt_dyn_f64_len" }
    var is_sint = match h.type { checker::Prim as p => prim_is_signed_int(p.kind); _ => false }
    if is_sint { "teko_teko__runtime__fmt_dyn_i64_len" } else { "teko_teko__runtime__fmt_dyn_u64_len" }
}

fn lower_interp_hole_fat(ctx: LowerCtx, h: checker::TExpr, spec: checker::TFSpec): LoweredFat | error {
    match spec.kind {
        checker::TFSpecNone => lower_interp_hole_none_fat(ctx, h)
        checker::TFSpecStatic as fs => lower_interp_hole_static_fat(ctx, h, fs)
        checker::TFSpecDynamic as fd => lower_interp_hole_dynamic_fat(ctx, h, fd)
    }
}

fn lower_interp_fat(ctx: LowerCtx, e: checker::TExpr, ip: checker::TInterp): LoweredFat | error {
    var seg0 = lower_str_bytes_fat(ctx, ip.pieces[0], e.line, e.col)
    var cur = seg0.ctx
    var acc_ptr = seg0.ptr
    var acc_len = seg0.len
    var i: u64 = 0
    loop {
        if i >= ip.holes.len { break }
        var spec = if i < ip.specs.len { ip.specs[i] } else { checker::TFSpec { kind = checker::TFSpecNone { } } }
        var ho = match lower_interp_hole_fat(cur, ip.holes[i], spec) { LoweredFat as x => x; error as err => return err }
        var with_hole = lower_len_out_call(ho.ctx, "tk_str_concat_len", four_args(acc_ptr, acc_len, ho.ptr, ho.len), e)
        var piece = lower_str_bytes_fat(with_hole.ctx, ip.pieces[i + 1], e.line, e.col)
        var with_piece = lower_len_out_call(piece.ctx, "tk_str_concat_len", four_args(with_hole.ptr, with_hole.len, piece.ptr, piece.len), e)
        cur = with_piece.ctx
        acc_ptr = with_piece.ptr
        acc_len = with_piece.len
        i++
    }
    LoweredFat { ctx = cur; ptr = acc_ptr; len = acc_len }
}

fn lower_interp(ctx: LowerCtx, e: checker::TExpr, ip: checker::TInterp): Lowered | error {
    var fo = match lower_interp_fat(ctx, e, ip) { LoweredFat as x => x; error as err => return err }
    Lowered { ctx = fo.ctx; vreg = fo.ptr }
}

fn lower_in_expr(ctx: LowerCtx, e: checker::TExpr, ine: checker::TInExpr): Lowered | error {
    if ine.elems.len == 0 { return error { message = "native backend N1: empty `in`-expression not yet lowered (N2)" } }
    var lo = match lower_expr(ctx, ine.lhs) { Lowered as x => x; error as err => return err }
    var k = match prim_kind_of(ine.lhs.type, ctx.enums, "in-expression lhs") { checker::PrimKind as p => p; error as err => return err }
    var eq = if prim_is_float_kind(k) { LBinOp::FCmpEq } else { LBinOp::ICmpEq }
    var cur = lo.ctx
    var acc: u32 = 0
    var i: u64 = 0
    loop {
        if i >= ine.elems.len { break }
        var eo = match lower_expr(cur, ine.elems[i]) { Lowered as x => x; error as err => return err }
        var cr = ctx_alloc(eo.ctx)
        var with_cmp = ctx_append(cr.ctx, bin_inst(cr.vreg, eq, lo.vreg, eo.vreg, e.line, e.col))
        if i == 0 {
            acc = cr.vreg
            cur = with_cmp
        } else {
            var orr = ctx_alloc(with_cmp)
            cur = ctx_append(orr.ctx, bin_inst(orr.vreg, LBinOp::IOr, acc, cr.vreg, e.line, e.col))
            acc = orr.vreg
        }
        i++
    }
    Lowered { ctx = cur; vreg = acc }
}

fn named_type_name(t: @Type()): str | error {
    match t {
        checker::Named as n => n.name
        checker::Error => error_struct_name()
        _ => error { message = "native backend N1: field/index access on a non-struct receiver not yet lowered (N2)" }
    }
}

fn error_struct_name(): str { "error" }

const ERROR_FIELD_NAMES: []str = ["message", "file", "line", "col", "expected", "actual"]

fn error_field_types(): []LType {
    [LType::Ptr, LType::Ptr, LType::I32, LType::I32, LType::Ptr, LType::Ptr]
}

fn error_field_sizes(types: []LType): []u32 {
    var sizes: [types.len]u32 = []
    var i: u64 = 0
    loop {
        if i >= types.len { break }
        sizes[i] = error_field_size_of(types[i])
        i++
    }
    sizes
}

fn error_field_size_of(t: LType): u32 {
    match t {
        Ptr => fat_value_bytes(checker::Named { name = "teko::base::str" })
        _ => ltype_size(t)
    }
}

fn error_field_aligns(types: []LType): []u32 {
    var aligns: [types.len]u32 = []
    var i: u64 = 0
    loop {
        if i >= types.len { break }
        aligns[i] = ltype_align(types[i])
        i++
    }
    aligns
}

fn error_struct_layout(): LStructLayout {
    var names = ERROR_FIELD_NAMES
    var types = error_field_types()
    layout_of_sized(error_struct_name(), names, types, error_field_sizes(types), error_field_aligns(types))
}

fn zero_error_diagnostics(ctx: LowerCtx, base_vreg: u32, layout: LStructLayout, from_index: u64, line: u32, col: u32): LowerCtx {
    var cur = ctx
    var i = from_index
    loop {
        if i >= layout.field_types.len { break }
        cur = zero_error_field(cur, base_vreg, layout, i, line, col)
        i++
    }
    cur
}

fn zero_error_field(ctx: LowerCtx, base_vreg: u32, layout: LStructLayout, i: u64, line: u32, col: u32): LowerCtx {
    var off = layout.field_offsets[i]
    match layout.field_types[i] {
        Ptr => zero_fat_field_at(ctx, base_vreg, off, line, col)
        _ => zero_scalar_field_at(ctx, base_vreg, off, layout.field_types[i], line, col)
    }
}

fn zero_fat_field_at(ctx: LowerCtx, base_vreg: u32, offset: u32, line: u32, col: u32): LowerCtx {
    var zp = ctx_alloc(ctx)
    var with_zp = ctx_append(zp.ctx, const_int_inst(zp.vreg, 0, line, col))
    var zl = ctx_alloc(with_zp)
    var with_zl = ctx_append(zl.ctx, const_int_inst(zl.vreg, 0, line, col))
    var addr = ctx_alloc(with_zl)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base_vreg, offset, line, col))
    store_fat_slot(with_addr, addr.vreg, LoweredFat { ctx = with_addr; ptr = zp.vreg; len = zl.vreg }, line, col)
}

fn zero_scalar_field_at(ctx: LowerCtx, base_vreg: u32, offset: u32, ty: LType, line: u32, col: u32): LowerCtx {
    var z = ctx_alloc(ctx)
    var with_z = ctx_append(z.ctx, const_int_inst(z.vreg, 0, line, col))
    var addr = ctx_alloc(with_z)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base_vreg, offset, line, col))
    ctx_append(with_addr, store_inst(addr.vreg, z.vreg, ty, line, col))
}

fn copy_error_value(ctx: LowerCtx, src: u32, layout: LStructLayout, e: checker::TExpr): Lowered {
    var dst = ctx_alloc(ctx)
    var with_alloca = ctx_append(dst.ctx, alloca_inst(dst.vreg, layout.size, layout.align, e.line, e.col))
    var width = ctx_alloc(with_alloca)
    var with_width = ctx_append(width.ctx, const_int_inst(width.vreg, layout.size to i64, e.line, e.col))
    var args = [..two_args(dst.vreg, src), width.vreg]
    var with_copy = ctx_append(with_width, void_call_inst("tk_mem_copy", args, false, e.line, e.col))
    Lowered { ctx = with_copy; vreg = dst.vreg }
}

fn find_struct_layout(layouts: []LStructLayout, name: str): LStructLayout | error {
    var i: u64 = 0
    loop {
        if i >= layouts.len { break }
        if layouts[i].name == name { return layouts[i] }
        i++
    }
    error { message = teko::str::concat("native backend N1: no layout registered for struct `", name, "` (internal)") }
}

fn field_offset_of(layout: LStructLayout, field: str): u32 | error {
    var i: u64 = 0
    loop {
        if i >= layout.field_names.len { break }
        if layout.field_names[i] == field { return layout.field_offsets[i] }
        i++
    }
    error { message = teko::str::concat("native backend N1: unknown field `", field, "` on struct `", layout.name, "` (internal)") }
}

fn field_type_of(layout: LStructLayout, field: str): LType | error {
    var i: u64 = 0
    loop {
        if i >= layout.field_names.len { break }
        if layout.field_names[i] == field { return layout.field_types[i] }
        i++
    }
    error { message = teko::str::concat("native backend N1: unknown field `", field, "` on struct `", layout.name, "` (internal)") }
}

fn lower_struct_init(ctx: LowerCtx, e: checker::TExpr, si: checker::TStructInit): Lowered | error {
    var name = match named_type_name(e.type) { str as s => s; error as err => return err }
    var layout = match find_struct_layout(ctx.layouts, name) { LStructLayout as l => l; error as err => return err }
    var slot = ctx_alloc(ctx)
    var with_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, layout.size, layout.align, e.line, e.col))
    var stored = match store_struct_fields(with_alloca, slot.vreg, layout, si.field_names, si.field_vals, e.line, e.col) { Lowered as l => l; error as err => return err }
    match e.type {
        checker::Error => Lowered { ctx = zero_error_diagnostics(stored.ctx, slot.vreg, layout, si.field_names.len, e.line, e.col); vreg = slot.vreg }
        _ => stored
    }
}

fn store_struct_fields(ctx: LowerCtx, base_vreg: u32, layout: LStructLayout, field_names: []str, field_vals: []checker::TExpr, line: u32, col: u32): Lowered | error {
    var cur = ctx
    var i: u64 = 0
    loop {
        if i >= field_names.len { break }
        var off = match field_offset_of(layout, field_names[i]) { u32 as o => o; error as err => return err }
        var decl = find_field_decl_type(ctx.field_decls, layout.name, field_names[i])
        match check_store_fat_span(cur, layout, field_names[i], decl, field_vals[i]) { error as err => return err; null => { } }
        cur = match store_struct_field(cur, base_vreg, off, decl, field_vals[i], line, col) { LowerCtx as c => c; error as err => return err }
        i++
    }
    Lowered { ctx = cur; vreg = base_vreg }
}

fn find_field_decl_type(decls: []LFieldDecls, sname: str, field: str): @Type() | null {
    var i: u64 = 0
    loop {
        if i >= decls.len { break }
        if decls[i].name == sname { return field_type_in_decls(decls[i], field) }
        i++
    }
    null
}

fn field_type_in_decls(fd: LFieldDecls, field: str): @Type() | null {
    var i: u64 = 0
    loop {
        if i >= fd.field_names.len { break }
        if fd.field_names[i] == field {
            match fd.field_types[i] { checker::Void => return null; _ => return fd.field_types[i] }
        }
        i++
    }
    null
}

fn union_field_placement(ctx: LowerCtx, decl: @Type() | null): @Type() | null {
    var d = match decl { (@Type()) as t => t; null => return null }
    match expand_named_variant(d, ctx.variants) { checker::Variant => d; _ => null }
}

fn store_field_fat_value(ctx: LowerCtx, decl: @Type() | null, value: checker::TExpr): LoweredFat | error {
    match decl {
        (@Type()) as d => lower_fat_expr_into_type(ctx, d, value)
        null => lower_fat_expr(ctx, value)
    }
}

fn store_struct_field(ctx: LowerCtx, base_vreg: u32, offset: u32, decl: @Type() | null, value: checker::TExpr, line: u32, col: u32): LowerCtx | error {
    match union_field_placement(ctx, decl) {
        (@Type()) as bound => {
            var uo = match lower_value_into_type(ctx, bound, value) { Lowered as x => x; error as err => return err }
            var owned = box_aggregate_value_at(uo, variant_wrapper_bytes(), line, col)
            var uaddr = ctx_alloc(owned.ctx)
            var with_uaddr = ctx_append(uaddr.ctx, field_addr_inst(uaddr.vreg, base_vreg, offset, line, col))
            return ctx_append(with_uaddr, store_inst(uaddr.vreg, owned.vreg, LType::Ptr, line, col))
        }
        null => { }
    }
    if is_fat_type(value.type) {
        var fo = match store_field_fat_value(ctx, decl, value) { LoweredFat as x => x; error as err => return err }
        var addr = ctx_alloc(fo.ctx)
        var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base_vreg, offset, line, col))
        return store_fat_slot(with_addr, addr.vreg, fo, line, col)
    }
    var raw = match lower_expr(ctx, value) { Lowered as x => x; error as err => return err }
    var vo = own_embedded_value(raw, value)
    var addr = ctx_alloc(vo.ctx)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base_vreg, offset, line, col))
    ctx_append(with_addr, store_inst(addr.vreg, vo.vreg, ltype_of(value.type, vo.ctx.enums), line, col))
}

fn lower_field_access(ctx: LowerCtx, e: checker::TExpr, fa: checker::TFieldAccess): Lowered | error {
    if fa.field == "len" && is_fat_type(fa.receiver.type) { return lower_len_field(ctx, fa) }
    if is_ref_deref(fa) { return lower_ref_deref_read(ctx, e, fa) }
    var ro = match lower_expr(ctx, fa.receiver) { Lowered as x => x; error as err => return err }
    var name = match named_type_name(fa.receiver.type) { str as s => s; error as err => return err }
    var layout = match find_struct_layout(ro.ctx.layouts, name) { LStructLayout as l => l; error as err => return err }
    var off = match field_offset_of(layout, fa.field) { u32 as o => o; error as err => return err }
    var addr = ctx_alloc(ro.ctx)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, ro.vreg, off, e.line, e.col))
    var r = ctx_alloc(with_addr)
    Lowered { ctx = ctx_append(r.ctx, load_inst(r.vreg, addr.vreg, ltype_of(e.type, r.ctx.enums), e.line, e.col)); vreg = r.vreg }
}

fn is_ref_deref(fa: checker::TFieldAccess): bool {
    fa.field == "value" && match fa.receiver.type { checker::Reference => true; _ => false }
}

fn lower_ref_deref_read(ctx: LowerCtx, e: checker::TExpr, fa: checker::TFieldAccess): Lowered | error {
    var ro = match lower_expr(ctx, fa.receiver) { Lowered as x => x; error as err => return err }
    if !is_register_value_type(e.type, ro.ctx.enums) { return Lowered { ctx = ro.ctx; vreg = ro.vreg } }
    var r = ctx_alloc(ro.ctx)
    Lowered { ctx = ctx_append(r.ctx, load_inst(r.vreg, ro.vreg, ltype_of(e.type, r.ctx.enums), e.line, e.col)); vreg = r.vreg }
}

fn lower_len_field(ctx: LowerCtx, fa: checker::TFieldAccess): Lowered | error {
    var fo = match lower_fat_expr(ctx, fa.receiver) { LoweredFat as x => x; error as err => return err }
    Lowered { ctx = fo.ctx; vreg = fo.len }
}

fn slice_element_type(t: @Type()): @Type() | error {
    match t {
        checker::Slice as s => s.element
        _ => error { message = "native backend N1: index receiver is not a slice (N2)" }
    }
}

fn const_index_addr(ctx: LowerCtx, base_vreg: u32, idx_value: i64, stride: u32, line: u32, col: u32): Lowered {
    var offset = (idx_value * stride) to u32
    var r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, field_addr_inst(r.vreg, base_vreg, offset, line, col)); vreg = r.vreg }
}

fn element_addr_at(ctx: LowerCtx, base_vreg: u32, index: u32, stride: u32, line: u32, col: u32): Lowered {
    var sc = ctx_alloc(ctx)
    var with_stride = ctx_append(sc.ctx, const_int_inst(sc.vreg, stride to i64, line, col))
    var mr = ctx_alloc(with_stride)
    var with_mul = ctx_append(mr.ctx, bin_inst(mr.vreg, LBinOp::IMul, index, sc.vreg, line, col))
    var ar = ctx_alloc(with_mul)
    Lowered { ctx = ctx_append(ar.ctx, bin_inst(ar.vreg, LBinOp::IAdd, base_vreg, mr.vreg, line, col)); vreg = ar.vreg }
}

fn index_addr(ctx: LowerCtx, base_vreg: u32, index: checker::TExpr, index_vreg: u32, stride: u32, line: u32, col: u32): Lowered {
    match index.kind {
        checker::TNumber as n => if n.is_float { element_addr_at(ctx, base_vreg, index_vreg, stride, line, col) } else { const_index_addr(ctx, base_vreg, parser::numint_to_i64(n.value), stride, line, col) }
        _ => element_addr_at(ctx, base_vreg, index_vreg, stride, line, col)
    }
}

fn guarded_index_addr(ctx: LowerCtx, base_vreg: u32, len: u32, index: checker::TExpr, stride: u32, line: u32, col: u32): Lowered | error {
    var io = match lower_expr(ctx, index) { Lowered as x => x; error as err => return err }
    var checked = lower_index_bounds_guard(io.ctx, io.vreg, len, line, col)
    index_addr(checked, base_vreg, index, io.vreg, stride, line, col)
}

fn lower_index(ctx: LowerCtx, e: checker::TExpr, ix: checker::TIndex): Lowered | error {
    if is_str_type(ix.receiver.type) { return lower_index_str(ctx, e, ix) }
    lower_index_slice(ctx, e, ix)
}

fn lower_index_str(ctx: LowerCtx, e: checker::TExpr, ix: checker::TIndex): Lowered | error {
    var ro = match lower_fat_expr(ctx, ix.receiver) { LoweredFat as x => x; error as err => return err }
    var elem_ty = LType::I8
    var addr_out = match guarded_index_addr(ro.ctx, ro.ptr, ro.len, ix.index, ltype_size(elem_ty), e.line, e.col) { Lowered as x => x; error as err => return err }
    var r = ctx_alloc(addr_out.ctx)
    Lowered { ctx = ctx_append(r.ctx, load_inst(r.vreg, addr_out.vreg, elem_ty, e.line, e.col)); vreg = r.vreg }
}

fn elem_byte_stride(t: @Type(), enums: []LEnumInfo): u32 {
    if is_fat_type(t) { return fat_value_bytes(t) }
    ltype_size(ltype_of(t, enums))
}

fn elem_byte_align(t: @Type(), enums: []LEnumInfo): u32 {
    if is_fat_type(t) { return ltype_align(LType::Ptr) }
    ltype_align(ltype_of(t, enums))
}

fn lower_index_fat(ctx: LowerCtx, e: checker::TExpr, ix: checker::TIndex): LoweredFat | error {
    var ro = match lower_fat_expr(ctx, ix.receiver) { LoweredFat as x => x; error as err => return err }
    var et = match slice_element_type(ix.receiver.type) { (@Type()) as t => t; error as err => return err }
    var addr_out = match guarded_index_addr(ro.ctx, ro.ptr, ro.len, ix.index, fat_value_bytes(et), e.line, e.col) { Lowered as x => x; error as err => return err }
    load_fat_slot(addr_out.ctx, addr_out.vreg, e.line, e.col)
}

fn lower_index_slice(ctx: LowerCtx, e: checker::TExpr, ix: checker::TIndex): Lowered | error {
    var ro = match lower_fat_expr(ctx, ix.receiver) { LoweredFat as x => x; error as err => return err }
    match slice_element_type(ix.receiver.type) { (@Type()) as _gt2 => { }; error as err => return err }
    var elem_ty = ltype_of(e.type, ro.ctx.enums)
    var addr_out = match guarded_index_addr(ro.ctx, ro.ptr, ro.len, ix.index, elem_byte_stride(e.type, ro.ctx.enums), e.line, e.col) { Lowered as x => x; error as err => return err }
    var r = ctx_alloc(addr_out.ctx)
    Lowered { ctx = ctx_append(r.ctx, load_inst(r.vreg, addr_out.vreg, elem_ty, e.line, e.col)); vreg = r.vreg }
}

fn lower_array_lit(ctx: LowerCtx, e: checker::TExpr, al: checker::TArrayLit): Lowered | error {
    if array_has_spread(al) {
        var f = match lower_array_lit_spread_fat(ctx, e, al) { LoweredFat as x => x; error as err => return err }
        return Lowered { ctx = f.ctx; vreg = f.ptr }
    }
    var elem_t = match slice_element_type(e.type) { (@Type()) as t => t; error as err => return err }
    var stride = elem_byte_stride(elem_t, ctx.enums)
    var total = (al.elements.len to u32) * stride
    var slot = ctx_alloc(ctx)
    var with_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, total, elem_byte_align(elem_t, ctx.enums), e.line, e.col))
    var filled = match store_array_elements(with_alloca, slot.vreg, elem_t, al.elements, stride, e.line, e.col) { Lowered as x => x; error as err => return err }
    emit_elem_box(filled, total, e.line, e.col)
}

fn store_array_elements(ctx: LowerCtx, base_vreg: u32, elem_t: @Type(), elements: []checker::TArrayElem, stride: u32, line: u32, col: u32): Lowered | error {
    var cur = ctx
    var i: u64 = 0
    loop {
        if i >= elements.len { break }
        var elem = elements[i]
        if elem.is_spread { return error { message = "native backend: spread reached scalar array fill (internal)" } }
        var offset = (i to u32) * stride
        cur = match store_array_elem(cur, base_vreg, offset, elem_t, elem.expr, line, col) { LowerCtx as c => c; error as err => return err }
        i++
    }
    Lowered { ctx = cur; vreg = base_vreg }
}

fn store_array_elem(ctx: LowerCtx, base_vreg: u32, offset: u32, elem_t: @Type(), expr: checker::TExpr, line: u32, col: u32): LowerCtx | error {
    if is_fat_type(elem_t) {
        var fo = match lower_fat_expr(ctx, expr) { LoweredFat as x => x; error as err => return err }
        var addr = ctx_alloc(fo.ctx)
        var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base_vreg, offset, line, col))
        return store_fat_slot(with_addr, addr.vreg, fo, line, col)
    }
    var vo = match lower_expr(ctx, expr) { Lowered as x => x; error as err => return err }
    var addr = ctx_alloc(vo.ctx)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base_vreg, offset, line, col))
    ctx_append(with_addr, store_inst(addr.vreg, vo.vreg, ltype_of(expr.type, vo.ctx.enums), line, col))
}

fn lower_array_lit_fat(ctx: LowerCtx, e: checker::TExpr, al: checker::TArrayLit): LoweredFat | error {
    if array_has_spread(al) { return lower_array_lit_spread_fat(ctx, e, al) }
    var slot = match lower_array_lit(ctx, e, al) { Lowered as x => x; error as err => return err }
    var lenr = ctx_alloc(slot.ctx)
    var with_len = ctx_append(lenr.ctx, const_int_inst(lenr.vreg, al.elements.len to i64, e.line, e.col))
    LoweredFat { ctx = with_len; ptr = slot.vreg; len = lenr.vreg }
}

fn array_has_spread(al: checker::TArrayLit): bool {
    var i: u64 = 0
    loop {
        if i >= al.elements.len { break }
        if al.elements[i].is_spread { return true }
        i++
    }
    false
}

fn array_plain_count(al: checker::TArrayLit): u64 {
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i >= al.elements.len { break }
        if !al.elements[i].is_spread { n = n + 1 }
        i++
    }
    n
}

type SpreadFill = struct { ctx: LowerCtx; pos: u32 }

fn lower_array_lit_spread_fat(ctx: LowerCtx, e: checker::TExpr, al: checker::TArrayLit): LoweredFat | error {
    var elem_t = match slice_element_type(e.type) { (@Type()) as t => t; error as err => return err }
    var stride = elem_byte_stride(elem_t, ctx.enums)
    var elem_is_fat = is_fat_type(elem_t)
    var n = al.elements.len
    var kind: [n]u32 = []
    var av: [n]u32 = []
    var bv: [n]u32 = []
    var cur = ctx
    var i: u64 = 0
    loop {
        if i >= n { break }
        var ae = al.elements[i]
        if ae.is_spread || elem_is_fat {
            var fo = match lower_fat_expr(cur, ae.expr) { LoweredFat as x => x; error as err => return err }
            cur = fo.ctx
            kind[i] = if ae.is_spread { 2 } else { 1 }
            av[i] = fo.ptr
            bv[i] = fo.len
        } else {
            var vo = match lower_expr(cur, ae.expr) { Lowered as x => x; error as err => return err }
            cur = vo.ctx
            kind[i] = 0
            av[i] = vo.vreg
            bv[i] = 0
        }
        i++
    }
    var strider = ctx_alloc(cur)
    var cur1 = ctx_append(strider.ctx, const_int_inst(strider.vreg, stride to i64, e.line, e.col))
    var totlen = ctx_alloc(cur1)
    var cur2 = ctx_append(totlen.ctx, const_int_inst(totlen.vreg, array_plain_count(al) to i64, e.line, e.col))
    var total_vreg = totlen.vreg
    i = 0
    loop {
        if i >= n { break }
        if kind[i] == 2 {
            var acc = ctx_alloc(cur2)
            cur2 = ctx_append(acc.ctx, bin_inst(acc.vreg, LBinOp::IAdd, total_vreg, bv[i], e.line, e.col))
            total_vreg = acc.vreg
        }
        i++
    }
    var tbytes = ctx_alloc(cur2)
    var cur3 = ctx_append(tbytes.ctx, bin_inst(tbytes.vreg, LBinOp::IMul, total_vreg, strider.vreg, e.line, e.col))
    var region = region_current_vreg(cur3)
    var bufr = ctx_alloc(region.ctx)
    var cur4 = ctx_append(bufr.ctx, call_inst(bufr.vreg, "tk_region_alloc", two_args(region.vreg, tbytes.vreg), false, e.line, e.col))
    var posr = ctx_alloc(cur4)
    var cur5 = ctx_append(posr.ctx, const_int_inst(posr.vreg, 0, e.line, e.col))
    var pos_vreg = posr.vreg
    i = 0
    loop {
        if i >= n { break }
        var filled = match fill_spread_operand(cur5, bufr.vreg, pos_vreg, kind[i], av[i], bv[i], strider.vreg, elem_t, e.line, e.col) { SpreadFill as x => x; error as err => return err }
        cur5 = filled.ctx
        pos_vreg = filled.pos
        i++
    }
    LoweredFat { ctx = cur5; ptr = bufr.vreg; len = total_vreg }
}

fn fill_spread_operand(ctx: LowerCtx, buf: u32, pos: u32, kind: u32, a: u32, b: u32, stride_vreg: u32, elem_t: @Type(), line: u32, col: u32): SpreadFill | error {
    var addr = ctx_alloc(ctx)
    var cur = ctx_append(addr.ctx, bin_inst(addr.vreg, LBinOp::IAdd, buf, pos, line, col))
    if kind == 2 {
        var byr = ctx_alloc(cur)
        var c2 = ctx_append(byr.ctx, bin_inst(byr.vreg, LBinOp::IMul, b, stride_vreg, line, col))
        var c3 = ctx_append(c2, void_call_inst("tk_mem_copy", [..two_args(addr.vreg, a), byr.vreg], false, line, col))
        var np = ctx_alloc(c3)
        var c4 = ctx_append(np.ctx, bin_inst(np.vreg, LBinOp::IAdd, pos, byr.vreg, line, col))
        return SpreadFill { ctx = c4; pos = np.vreg }
    }
    if kind == 1 {
        var stored = store_fat_slot(cur, addr.vreg, LoweredFat { ctx = cur; ptr = a; len = b }, line, col)
        var np = ctx_alloc(stored)
        var c3 = ctx_append(np.ctx, bin_inst(np.vreg, LBinOp::IAdd, pos, stride_vreg, line, col))
        return SpreadFill { ctx = c3; pos = np.vreg }
    }
    var stored = ctx_append(cur, store_inst(addr.vreg, a, ltype_of(elem_t, cur.enums), line, col))
    var np = ctx_alloc(stored)
    var c3 = ctx_append(np.ctx, bin_inst(np.vreg, LBinOp::IAdd, pos, stride_vreg, line, col))
    SpreadFill { ctx = c3; pos = np.vreg }
}

fn zero_fill_bytes(ctx: LowerCtx, ptr_vreg: u32, count_vreg: u32, line: u32, col: u32): LowerCtx {
    var headb = alloc_block(ctx.func)
    var bodyb = alloc_block(headb.func)
    var exitb = alloc_block(bodyb.func)
    var ip = add_block_param(exitb.func, headb.block_id)
    var i0 = alloc_vreg(ip.func)
    var with_i0 = append_inst(i0.func, ctx.block_id, const_int_inst(i0.vreg, 0, line, col))
    var entered = append_inst(with_i0, ctx.block_id, jump_inst(headb.block_id, single_arg(i0.vreg), line, col))
    var cmp = alloc_vreg(entered)
    var with_cmp = append_inst(cmp.func, headb.block_id, bin_inst(cmp.vreg, LBinOp::ICmpLtU, ip.vreg, count_vreg, line, col))
    var with_branch = append_inst(with_cmp, headb.block_id, branch_inst(cmp.vreg, bodyb.block_id, [], exitb.block_id, [], line, col))
    var addr = alloc_vreg(with_branch)
    var with_addr = append_inst(addr.func, bodyb.block_id, bin_inst(addr.vreg, LBinOp::IAdd, ptr_vreg, ip.vreg, line, col))
    var zero_byte = alloc_vreg(with_addr)
    var with_zero = append_inst(zero_byte.func, bodyb.block_id, const_int_inst(zero_byte.vreg, 0, line, col))
    var with_store = append_inst(with_zero, bodyb.block_id, store_inst(addr.vreg, zero_byte.vreg, LType::I8, line, col))
    var one = alloc_vreg(with_store)
    var with_one = append_inst(one.func, bodyb.block_id, const_int_inst(one.vreg, 1, line, col))
    var nexti = alloc_vreg(with_one)
    var with_next = append_inst(nexti.func, bodyb.block_id, bin_inst(nexti.vreg, LBinOp::IAdd, ip.vreg, one.vreg, line, col))
    var with_loop = append_inst(with_next, bodyb.block_id, jump_inst(headb.block_id, single_arg(nexti.vreg), line, col))
    ctx_with(ctx, with_loop, exitb.block_id, ctx.env)
}

fn lower_slice_of_len_fat(ctx: LowerCtx, e: checker::TExpr, s: checker::TSliceOfLen): LoweredFat | error {
    var szo = match lower_expr(ctx, s.size) { Lowered as x => x; error as err => return err }
    var stride = elem_byte_stride(s.element, szo.ctx.enums)
    var stride_r = ctx_alloc(szo.ctx)
    var with_stride = ctx_append(stride_r.ctx, const_int_inst(stride_r.vreg, stride to i64, e.line, e.col))
    var total_r = ctx_alloc(with_stride)
    var with_total = ctx_append(total_r.ctx, bin_inst(total_r.vreg, LBinOp::IMul, szo.vreg, stride_r.vreg, e.line, e.col))
    var region = region_current_vreg(with_total)
    var ptr_r = ctx_alloc(region.ctx)
    var with_alloc = ctx_append(ptr_r.ctx, call_inst(ptr_r.vreg, "tk_region_alloc", two_args(region.vreg, total_r.vreg), false, e.line, e.col))
    var zeroed = zero_fill_bytes(with_alloc, ptr_r.vreg, total_r.vreg, e.line, e.col)
    LoweredFat { ctx = zeroed; ptr = ptr_r.vreg; len = szo.vreg }
}

fn lower_slice_of_len(ctx: LowerCtx, e: checker::TExpr, s: checker::TSliceOfLen): Lowered | error {
    var f = match lower_slice_of_len_fat(ctx, e, s) { LoweredFat as x => x; error as err => return err }
    Lowered { ctx = f.ctx; vreg = f.ptr }
}

fn zero_of_not_lowered(): error {
    error { message = "native backend N1: `zero<T>` for this element type is not yet lowered (N2)" }
}

fn lower_zero_of_fat(ctx: LowerCtx, e: checker::TExpr, z: checker::TZeroOf): LoweredFat {
    lower_list_empty(ctx, e)
}

fn lower_zero_of_int_scalar(ctx: LowerCtx, e: checker::TExpr): Lowered {
    var r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, const_int_inst(r.vreg, 0, e.line, e.col)); vreg = r.vreg }
}

fn lower_zero_of_float_scalar(ctx: LowerCtx, e: checker::TExpr, wide: bool): Lowered {
    var r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, const_float_inst(r.vreg, teko::f64_bits(0.0), wide, e.line, e.col)); vreg = r.vreg }
}

fn lower_zero_of_prim(ctx: LowerCtx, e: checker::TExpr, p: checker::Prim): Lowered {
    if prim_is_float_kind(p.kind) { return lower_zero_of_float_scalar(ctx, e, float_literal_is_wide(ctx, e)) }
    lower_zero_of_int_scalar(ctx, e)
}

fn lower_zero_of_named_register(ctx: LowerCtx, e: checker::TExpr, n: checker::Named): Lowered {
    var carrier = match find_value_carrier(ctx.enums, n.name) { LEnumInfo as info => info.carrier; null => enum_carrier_ltype() }
    if carrier == LType::F32 || carrier == LType::F64 { return lower_zero_of_float_scalar(ctx, e, carrier == LType::F64) }
    lower_zero_of_int_scalar(ctx, e)
}

fn lower_zero_of_register(ctx: LowerCtx, e: checker::TExpr, t: @Type()): Lowered | error {
    match t {
        checker::Prim as p => lower_zero_of_prim(ctx, e, p)
        checker::Byte => lower_zero_of_int_scalar(ctx, e)
        checker::Named as n => lower_zero_of_named_register(ctx, e, n)
        _ => zero_of_not_lowered()
    }
}

fn lower_zero_of_aggregate(ctx: LowerCtx, e: checker::TExpr, t: @Type()): Lowered | error {
    var bytes = match aggregate_box_bytes(t, ctx) { u32 as n => n; null => return zero_of_not_lowered() }
    var align = match aggregate_box_align(t, ctx) { u32 as a => a; null => 1 to u32 }
    var slot = ctx_alloc(ctx)
    var with_alloca = ctx_append(slot.ctx, alloca_inst(slot.vreg, bytes, align, e.line, e.col))
    var count = ctx_alloc(with_alloca)
    var with_count = ctx_append(count.ctx, const_int_inst(count.vreg, bytes to i64, e.line, e.col))
    var zeroed = zero_fill_bytes(with_count, slot.vreg, count.vreg, e.line, e.col)
    Lowered { ctx = zeroed; vreg = slot.vreg }
}

fn lower_zero_of(ctx: LowerCtx, e: checker::TExpr, z: checker::TZeroOf): Lowered | error {
    if is_fat_type(z.element) {
        var f = lower_zero_of_fat(ctx, e, z)
        return Lowered { ctx = f.ctx; vreg = f.ptr }
    }
    if is_register_value_type(z.element, ctx.enums) { return lower_zero_of_register(ctx, e, z.element) }
    lower_zero_of_aggregate(ctx, e, z.element)
}

fn bool_lit_value(v: bool): i64 { if v { 1 } else { 0 } }

fn lower_byte_lit(ctx: LowerCtx, e: checker::TExpr, b: checker::TByteLit): Lowered {
    var r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, const_int_inst(r.vreg, b.value to i64, e.line, e.col)); vreg = r.vreg }
}

fn lower_bool_lit(ctx: LowerCtx, e: checker::TExpr, b: checker::TBoolLit): Lowered {
    var r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, const_int_inst(r.vreg, bool_lit_value(b.value), e.line, e.col)); vreg = r.vreg }
}

fn lower_null_lit(ctx: LowerCtx, e: checker::TExpr, n: checker::TNullLit): Lowered {
    var r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, const_int_inst(r.vreg, 0, e.line, e.col)); vreg = r.vreg }
}

fn lower_path_expr(ctx: LowerCtx, e: checker::TExpr, p: checker::TPathExpr): Lowered {
    var r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, const_int_inst(r.vreg, p.value to i64, e.line, e.col)); vreg = r.vreg }
}

fn lower_char_lit(ctx: LowerCtx, e: checker::TExpr, c: checker::TCharLit): Lowered {
    var f = lower_char_lit_fat(ctx, e, c)
    Lowered { ctx = f.ctx; vreg = f.ptr }
}

fn lower_char_lit_fat(ctx: LowerCtx, e: checker::TExpr, c: checker::TCharLit): LoweredFat {
    lower_str_bytes_fat(ctx, c.bytes, e.line, e.col)
}

fn plain_op_of_compound(op: lexer::TokenKind): lexer::TokenKind | error {
    match op {
        lexer::TokenKind::PlusEq => lexer::TokenKind::Plus
        lexer::TokenKind::MinusEq => lexer::TokenKind::Minus
        lexer::TokenKind::StarEq => lexer::TokenKind::Star
        lexer::TokenKind::SlashEq => lexer::TokenKind::Slash
        lexer::TokenKind::PercentEq => lexer::TokenKind::Percent
        _ => error { message = "native backend N1: compound assignment operator not yet lowered (N2)" }
    }
}

fn assign_escape_target_name(a: checker::TAssign): str {
    match a.kind {
        parser::AssignKind::Index => texpr_root_var_name(a.target)
        parser::AssignKind::Field => texpr_root_var_name(a.target)
        _ => a.name
    }
}

fn texpr_root_var_name(e: checker::TExpr): str {
    match e.kind {
        checker::TVar as v => v.name
        checker::TFieldAccess as fa => texpr_root_var_name(fa.receiver)
        checker::TIndex as ix => texpr_root_var_name(ix.receiver)
        _ => ""
    }
}

fn lower_assign(ctx: LowerCtx, a: checker::TAssign): LowerStmtOut | error {
    if binding_conveys_escape(ctx.escaping, assign_escape_target_name(a)) { return lower_assign_conveyed(ctx, a) }
    lower_assign_dispatch(ctx, a)
}

fn lower_assign_conveyed(ctx: LowerCtx, a: checker::TAssign): LowerStmtOut | error {
    if ctx.bracket_depth > 0 { return lower_assign_dispatch(ctx, a) }
    var left = emit_region_leaves(ctx, a.value.line, a.value.col)
    var marked = ctx_with_bracket_depth(left, 1)
    var out = match lower_assign_dispatch(marked, a) { LowerStmtOut as x => x; error as err => return err }
    var entered = emit_region_enters(out.ctx, a.value.line, a.value.col)
    LowerStmtOut { ctx = ctx_with_bracket_depth(entered, ctx.bracket_depth); terminated = out.terminated }
}

fn lower_assign_dispatch(ctx: LowerCtx, a: checker::TAssign): LowerStmtOut | error {
    match a.kind {
        parser::AssignKind::Simple => lower_assign_simple(ctx, a)
        parser::AssignKind::Field => lower_assign_field(ctx, a)
        parser::AssignKind::RefDeref => lower_assign_ref_deref(ctx, a)
        parser::AssignKind::Index => lower_assign_index(ctx, a)
    }
}

fn lower_assign_ref_deref(ctx: LowerCtx, a: checker::TAssign): LowerStmtOut | error {
    var cur = lenv_lookup(ctx.env, a.name)
    if !cur.found { return error { message = teko::str::concat("native backend N1: unbound reference `", a.name, "` (internal)") } }
    if is_fat_type(a.bound) { return store_fat_through_addr(ctx, cur.vreg, a, "a str/slice reference") }
    if is_register_value_type(a.bound, ctx.enums) { return store_assign_value(ctx, cur.vreg, ltype_of(a.bound, ctx.enums), a) }
    store_assign_aggregate_ref(ctx, cur.vreg, a)
}

fn store_assign_aggregate_ref(ctx: LowerCtx, addr: u32, a: checker::TAssign): LowerStmtOut | error {
    if a.op != lexer::TokenKind::Assign {
        return error { message = "native backend N1: compound assignment to an aggregate reference has no arithmetic form (internal)" }
    }
    var width = match aggregate_box_bytes(a.bound, ctx) { u32 as n => n; null => return unsized_aggregate_ref_stop(a.bound) }
    var vo = match lower_value_into_type(ctx, a.bound, a.value) { Lowered as x => x; error as err => return err }
    var wr = ctx_alloc(vo.ctx)
    var with_width = ctx_append(wr.ctx, const_int_inst(wr.vreg, width to i64, a.value.line, a.value.col))
    var args = [..two_args(addr, vo.vreg), wr.vreg]
    var inst = void_call_inst("tk_mem_copy", args, false, a.value.line, a.value.col)
    LowerStmtOut { ctx = ctx_append(with_width, inst); terminated = false }
}

fn unsized_aggregate_ref_stop(t: @Type()): error {
    error { message = teko::str::concat("native backend N1: a reference deref-assignment whose target is ", teko::str::concat(aggregate_form_name(t), " — this copies the new value's bytes directly into the handle's pointee storage, which needs a byte width the type alone fixes (N2)")) }
}

fn fat_compound_stop(target: str): error {
    error { message = teko::str::concat("native backend N1: compound assignment to ", teko::str::concat(target, " has no arithmetic form (internal)")) }
}

fn store_fat_through_addr(ctx: LowerCtx, addr: u32, a: checker::TAssign, target: str): LowerStmtOut | error {
    if a.op != lexer::TokenKind::Assign { return fat_compound_stop(target) }
    var fo = match lower_fat_expr(ctx, a.value) { LoweredFat as x => x; error as err => return err }
    LowerStmtOut { ctx = store_fat_slot(fo.ctx, addr, fo, a.value.line, a.value.col); terminated = false }
}

fn lower_assign_simple(ctx: LowerCtx, a: checker::TAssign): LowerStmtOut | error {
    if is_fat_type(a.bound) { return lower_assign_fat(ctx, a) }
    var slot = lenv_lookup_scalar_slot(ctx.env, a.name)
    if slot.found { return store_assign_value(ctx, slot.slot, slot.ty, a) }
    if aggregate_local_is_aliased(ctx, a) { return aliased_aggregate_write_through(ctx, a) }
    if a.op == lexer::TokenKind::Assign {
        var raw = match lower_value_into_type(ctx, a.bound, a.value) { Lowered as x => x; error as err => return err }
        var vo = own_bound_value(raw, a.value)
        return LowerStmtOut { ctx = ctx_reassign(vo.ctx, a.name, vo.vreg); terminated = false }
    }
    var cur = lenv_lookup(ctx.env, a.name)
    if !cur.found { return error { message = teko::str::concat("native backend N1: unbound local `", a.name, "` (internal)") } }
    var vo = match lower_expr(ctx, a.value) { Lowered as x => x; error as err => return err }
    var k = match prim_kind_of(a.bound, ctx.enums, "range bound") { checker::PrimKind as p => p; error as err => return err }
    var plain = match plain_op_of_compound(a.op) { lexer::TokenKind as t => t; error as err => return err }
    var op = match lbinop_of(plain, k) { LBinOp as o => o; error as err => return err }
    var guarded = if is_int_div_or_rem(op) { lower_div_zero_guard(vo.ctx, vo.vreg, a.value.line, a.value.col) } else { vo.ctx }
    var r = ctx_alloc(guarded)
    var inst = bin_inst(r.vreg, op, cur.vreg, vo.vreg, a.value.line, a.value.col)
    LowerStmtOut { ctx = ctx_reassign(ctx_append(r.ctx, inst), a.name, r.vreg); terminated = false }
}

fn aggregate_local_is_aliased(ctx: LowerCtx, a: checker::TAssign): bool {
    contains_str(ctx.addr_taken, a.name) && !is_register_value_type(a.bound, ctx.enums)
}

fn aliased_aggregate_write_through(ctx: LowerCtx, a: checker::TAssign): LowerStmtOut | error {
    var cur = lenv_lookup(ctx.env, a.name)
    if !cur.found { return error { message = teko::str::concat("native backend N1: unbound aliased local `", a.name, "` (internal)") } }
    store_assign_aggregate_ref(ctx, cur.vreg, a)
}

fn lower_assign_fat(ctx: LowerCtx, a: checker::TAssign): LowerStmtOut | error {
    var slot = lenv_lookup_fat_slot(ctx.env, a.name)
    if !slot.found {
        return error { message = teko::str::concat("native backend N1: `", a.name, "` is assigned but is not a mutable fat local (internal)") }
    }
    if is_frees_old_self_append(ctx, a) { return lower_assign_frees_old(ctx, slot.slot, a) }
    if checker::assign_is_self_append(a) { return lower_assign_plain_self_append(ctx, slot.slot, a) }
    store_fat_through_addr(ctx, slot.slot, a, teko::str::concat("the str/slice local `", a.name, "`"))
}

fn lower_assign_plain_self_append(ctx: LowerCtx, slot: u32, a: checker::TAssign): LowerStmtOut | error {
    store_fat_through_addr(ctx, slot, a, teko::str::concat("the str/slice local `", a.name, "`"))
}

fn is_frees_old_self_append(ctx: LowerCtx, a: checker::TAssign): bool {
    checker::assign_is_self_append(a) && contains_str(ctx.frees_old_names, a.name)
}

fn lower_assign_frees_old(ctx: LowerCtx, slot: u32, a: checker::TAssign): LowerStmtOut | error {
    var elemt = if is_str_type(a.bound) { checker::Byte { } } else { match a.bound {
        checker::Slice as sl => sl.element
        _ => return store_fat_through_addr(ctx, slot, a, teko::str::concat("the str/slice local `", a.name, "`"))
    } }
    var stride = elem_byte_stride(elemt, ctx.enums)
    var avar = checker::TExpr { kind = checker::TVar { name = a.name; is_func = false; func_ns = "" }; type = a.bound; line = a.target.line; col = a.target.col }
    var old = match lower_fat_expr(ctx, avar) { LoweredFat as x => x; error as err => return err }
    var strider = ctx_alloc(old.ctx)
    var c1 = ctx_append(strider.ctx, const_int_inst(strider.vreg, stride to i64, a.target.line, a.target.col))
    var bytes = ctx_alloc(c1)
    var c2 = ctx_append(bytes.ctx, bin_inst(bytes.vreg, LBinOp::IMul, old.len, strider.vreg, a.target.line, a.target.col))
    var stored = match store_fat_through_addr(c2, slot, a, teko::str::concat("the str/slice local `", a.name, "`")) { LowerStmtOut as x => x; error as err => return err }
    var freed = ctx_append(stored.ctx, void_call_inst("tk_free_block", two_args(old.ptr, bytes.vreg), false, a.target.line, a.target.col))
    LowerStmtOut { ctx = freed; terminated = false }
}

fn lower_assign_field(ctx: LowerCtx, a: checker::TAssign): LowerStmtOut | error {
    var fa = match a.target.kind { checker::TFieldAccess as f => f; _ => return error { message = "native backend N1: field-assignment target is not a field access (internal)" } }
    var ro = match lower_expr(ctx, fa.receiver) { Lowered as x => x; error as err => return err }
    var name = match named_type_name(fa.receiver.type) { str as s => s; error as err => return err }
    var layout = match find_struct_layout(ro.ctx.layouts, name) { LStructLayout as l => l; error as err => return err }
    var off = match field_offset_of(layout, fa.field) { u32 as o => o; error as err => return err }
    var addr = ctx_alloc(ro.ctx)
    var with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, ro.vreg, off, a.target.line, a.target.col))
    if is_fat_type(a.bound) {
        var decl = find_field_decl_type(with_addr.field_decls, layout.name, fa.field)
        match check_store_fat_span(with_addr, layout, fa.field, decl, a.value) { error as err => return err; null => { } }
        return store_fat_through_addr(with_addr, addr.vreg, a, "a str/slice field")
    }
    store_assign_value(with_addr, addr.vreg, ltype_of(a.bound, ro.ctx.enums), a)
}

fn store_assign_value(ctx: LowerCtx, addr: u32, field_ty: LType, a: checker::TAssign): LowerStmtOut | error {
    if a.op == lexer::TokenKind::Assign {
        var raw = match lower_value_into_type(ctx, a.bound, a.value) { Lowered as x => x; error as err => return err }
        var vo = own_embedded_value(raw, a.value)
        return LowerStmtOut { ctx = ctx_append(vo.ctx, store_inst(addr, vo.vreg, field_ty, a.value.line, a.value.col)); terminated = false }
    }
    var cr = ctx_alloc(ctx)
    var with_load = ctx_append(cr.ctx, load_inst(cr.vreg, addr, field_ty, a.value.line, a.value.col))
    var vo = match lower_expr(with_load, a.value) { Lowered as x => x; error as err => return err }
    var k = match prim_kind_of(a.bound, ctx.enums, "range bound") { checker::PrimKind as p => p; error as err => return err }
    var plain = match plain_op_of_compound(a.op) { lexer::TokenKind as t => t; error as err => return err }
    var op = match lbinop_of(plain, k) { LBinOp as o => o; error as err => return err }
    var guarded = if is_int_div_or_rem(op) { lower_div_zero_guard(vo.ctx, vo.vreg, a.value.line, a.value.col) } else { vo.ctx }
    var rr = ctx_alloc(guarded)
    var with_bin = ctx_append(rr.ctx, bin_inst(rr.vreg, op, cr.vreg, vo.vreg, a.value.line, a.value.col))
    LowerStmtOut { ctx = ctx_append(with_bin, store_inst(addr, rr.vreg, field_ty, a.value.line, a.value.col)); terminated = false }
}

fn lower_assign_index(ctx: LowerCtx, a: checker::TAssign): LowerStmtOut | error {
    var ix = match a.target.kind { checker::TIndex as ti => ti; _ => return error { message = "native backend N1: index-assignment target is not a subscript (internal)" } }
    match slice_element_type(ix.receiver.type) { (@Type()) as _gt3 => { }; error as err => return err }
    var ro = match lower_fat_expr(ctx, ix.receiver) { LoweredFat as x => x; error as err => return err }
    var io = match lower_expr(ro.ctx, ix.index) { Lowered as x => x; error as err => return err }
    var checked = lower_index_bounds_guard(io.ctx, io.vreg, ro.len, a.target.line, a.target.col)
    var stride = elem_byte_stride(a.bound, checked.enums)
    var addr = element_addr_at(checked, ro.ptr, io.vreg, stride, a.target.line, a.target.col)
    store_assign_elem(addr.ctx, addr.vreg, a)
}

fn lower_index_bounds_guard(ctx: LowerCtx, index: u32, len: u32, line: u32, col: u32): LowerCtx {
    var lr = ctx_alloc(ctx)
    var with_line = ctx_append(lr.ctx, const_int_inst(lr.vreg, line to i64, line, col))
    var cr = ctx_alloc(with_line)
    var with_col = ctx_append(cr.ctx, const_int_inst(cr.vreg, col to i64, line, col))
    var ok = ctx_alloc(with_col)
    var with_cmp = ctx_append(ok.ctx, bin_inst(ok.vreg, LBinOp::ICmpLtU, index, len, line, col))
    lower_trap_unless_with(with_cmp, ok.vreg, "teko_teko__runtime__panic_oob_at", two_args(lr.vreg, cr.vreg), line, col)
}

fn store_assign_elem(ctx: LowerCtx, addr: u32, a: checker::TAssign): LowerStmtOut | error {
    if is_fat_type(a.bound) { return store_fat_through_addr(ctx, addr, a, "a str/slice element") }
    if is_register_value_type(a.bound, ctx.enums) { return store_assign_value(ctx, addr, ltype_of(a.bound, ctx.enums), a) }
    store_assign_aggregate_elem(ctx, addr, a)
}

fn store_assign_aggregate_elem(ctx: LowerCtx, addr: u32, a: checker::TAssign): LowerStmtOut | error {
    if a.op != lexer::TokenKind::Assign {
        return error { message = "native backend N1: compound assignment to an aggregate slice element has no arithmetic form (internal)" }
    }
    var width = match aggregate_box_bytes(a.bound, ctx) { u32 as n => n; null => return unsized_aggregate_elem_stop(a.bound) }
    var vo = match lower_value_into_type(ctx, a.bound, a.value) { Lowered as x => x; error as err => return err }
    var boxed = box_aggregate_value(vo, width, a.value)
    var elem_lt = ltype_of(a.bound, ctx.enums)
    LowerStmtOut { ctx = ctx_append(boxed.ctx, store_inst(addr, boxed.vreg, elem_lt, a.value.line, a.value.col)); terminated = false }
}

fn unsized_aggregate_elem_stop(t: @Type()): error {
    error { message = teko::str::concat("native backend N1: an element write whose element is ", aggregate_form_name(t), " — this backend holds aggregate slice elements BY ADDRESS and boxes the written value into fresh storage, which needs a byte width the element type alone fixes (N2)") }
}

fn texpr_kind_name(e: checker::TExpr): str {
    match e.kind {
        checker::TNumber => "number"
        checker::TVar => "variable"
        checker::TStrLit => "string literal"
        checker::TByteStrLit => "byte string literal"
        checker::TByteLit => "byte literal"
        checker::TCharLit => "char literal"
        checker::TBoolLit => "bool literal"
        checker::TNullLit => "null literal"
        checker::TBinary => "binary op"
        checker::TUnary => "unary op"
        checker::TCompare => "comparison"
        checker::TCall => "call"
        checker::TIfExpr => "if-expression"
        checker::TMatchExpr => "match-expression"
        checker::TCast => "cast"
        checker::TFieldAccess => "field access"
        checker::TStructInit => "struct literal"
        checker::TIndex => "index"
        checker::TInterp => "string interpolation"
        checker::TInExpr => "in-expression"
        checker::TPathExpr => "enum member"
        checker::TArrayLit => "array literal"
        checker::TSliceOfLen => "sized array"
        checker::TZeroOf => "zero-value primitive"
        checker::TLambda => "lambda"
        checker::TBorrow => "borrow"
        checker::TBlockExpr => "block expression"
    }
}

fn tstmt_kind_name(s: @TStatement()): str {
    match s {
        checker::TBinding => "binding"
        checker::TAssign => "assignment"
        checker::TReturn => "return"
        checker::TLoopStmt => "loop"
        checker::TBreakStmt => "break"
        checker::TContinueStmt => "continue"
        checker::TExprStmt => "expression statement"
        checker::TDeferStmt => "defer"
        checker::TAdoptStmt => "adopt"
        checker::TBlockStmt => "block"
        checker::TSpawn => "spawn"
    }
}

fn lower_block(ctx: LowerCtx, body: []@TStatement()): LowerCtx | error {
    var cur = ctx
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        var out = match lower_stmt(cur, body[i]) { LowerStmtOut as x => x; error as err => return err }
        cur = out.ctx
        if out.terminated { return cur }
        i++
    }
    cur
}

fn lower_fn_body(ctx: LowerCtx, body: []@TStatement(), ret_ty: LType, line: u32, col: u32): LowerCtx | error {
    if body.len == 0 || ltype_is_void(ret_ty) { return lower_block(ctx, body) }
    if is_fat_type(ctx.ret_type) { return lower_fn_body_fat(ctx, body, line, col) }
    var pre = match lower_block_prefix(ctx, body) { LowerStmtOut as x => x; error as err => return err }
    if pre.terminated { return pre.ctx }
    var tail = match lower_fn_tail(pre.ctx, body[body.len - 1], ret_ty, ctx.ret_type, line, col) { LowerBlockValue as x => x; error as err => return err }
    if tail.terminated { return tail.ctx }
    var replayed = match replay_defers(tail.ctx, 0) { LowerCtx as c => c; error as err => return err }
    var left = emit_region_leaves(replayed, line, col)
    var owned = own_returned_value(Lowered { ctx = left; vreg = tail.vreg }, line, col)
    var dropped = emit_region_drops(owned.ctx, line, col)
    ctx_append(dropped, ret_inst(owned.vreg, line, col))
}

fn lower_fn_body_fat(ctx: LowerCtx, body: []@TStatement(), line: u32, col: u32): LowerCtx | error {
    if !ctx.has_ret_len_slot { return error { message = "native backend N1: a fat-typed lambda return is not yet lowered (N2)" } }
    var pre = match lower_block_prefix_fat(ctx, body) { LowerStmtOut as x => x; error as err => return err }
    if pre.terminated { return pre.ctx }
    var tail = match lower_fn_tail_fat(pre.ctx, body[body.len - 1], line, col) { LowerBlockValueFat as x => x; error as err => return err }
    if tail.terminated { return tail.ctx }
    var replayed = match replay_defers(tail.ctx, 0) { LowerCtx as c => c; error as err => return err }
    var left = emit_region_leaves(replayed, line, col)
    var stored = ctx_append(left, store_inst(left.ret_len_slot, tail.len, LType::I64, line, col))
    var dropped = emit_region_drops(stored, line, col)
    ctx_append(dropped, ret_inst(tail.ptr, line, col))
}

type ParamBind = struct {
    func: LFunc
    env: LEnv
    next_reg: u32
}

fn bind_fn_params(func: LFunc, params: []parser::Param, line: u32, col: u32, table: checker::TypeTable): ParamBind {
    var cur = ParamBind { func = func; env = empty_lenv(); next_reg = 0 }
    var i: u64 = 0
    loop {
        if i >= params.len { break }
        cur = bind_param(cur.func, cur.env, cur.next_reg, params[i], line, col, table)
        i++
    }
    cur
}

fn bind_param(func: LFunc, env: LEnv, next_reg: u32, p: parser::Param, line: u32, col: u32, table: checker::TypeTable): ParamBind {
    if typeexpr_is_fat(p.type_ann, table) { return bind_fat_param(func, env, next_reg, p, line, col) }
    var with_inst = append_inst(func, 0, param_inst(next_reg, next_reg, line, col))
    ParamBind { func = with_inst; env = lenv_bind(env, p.name, next_reg); next_reg = next_reg + 1 }
}

fn bind_fat_param(func: LFunc, env: LEnv, next_reg: u32, p: parser::Param, line: u32, col: u32): ParamBind {
    var ptr_reg = next_reg
    var len_reg = next_reg + 1
    var with_ptr = append_inst(func, 0, param_inst(ptr_reg, ptr_reg, line, col))
    var with_len = append_inst(with_ptr, 0, param_inst(len_reg, len_reg, line, col))
    ParamBind { func = with_len; env = lenv_bind_fat(env, p.name, ptr_reg, len_reg); next_reg = len_reg + 1 }
}

fn bind_ret_len_slot(bound: ParamBind, line: u32, col: u32): ParamBind {
    var reg = bound.next_reg
    var with_inst = append_inst(bound.func, 0, param_inst(reg, reg, line, col))
    ParamBind { func = with_inst; env = bound.env; next_reg = reg + 1 }
}

pub fn lower_function(f: checker::TFunction, table: checker::TypeTable, layouts: []LStructLayout = [], rodata: []LRodata = [], enums: []LEnumInfo = [], lifted: []LFunc = [], externs: []LExternFn = [], flat_symbols: bool = false, variants: []LVariantDef = [], ref_fns: []LRefFnInfo = [], field_decls: []LFieldDecls = [], rodata_base: u64 = 0, const_rodata: []LRodata = [], lifted_base: u64 = 0): LoweredFunction | error {
    if f.type_params.len != 0 { return error { message = "native backend N1: generic function not yet lowered (N2)" } }
    if f.is_extern { return error { message = "native backend N1: extern function has no body to lower" } }
    var fat_ret = is_fat_type(f.return_type)
    var ptypes = param_ltypes(f.params, enums, table)
    var all_ptypes = if fat_ret { [..ptypes, LType::Ptr] } else { ptypes }
    var fn0 = new_func(mangle_fn_symbol(f.namespace, f.name, flat_symbols, f.overload_suffix), all_ptypes.len to u32, all_ptypes, ltype_of(f.return_type, enums))
    var bound = bind_fn_params(fn0, f.params, f.line, f.col, table)
    var slot_reg = bound.next_reg
    var with_slot = if fat_ret { bind_ret_len_slot(bound, f.line, f.col) } else { bound }
    var ctx0 = LowerCtx {
        func = with_slot.func; block_id = 0; env = with_slot.env
        layouts = layouts; rodata = rodata; enums = enums; lifted = lifted
        variants = variants
        defers = []; loop_targets = []; externs = externs
        flat_symbols = flat_symbols; ret_type = f.return_type
        has_ret_len_slot = fat_ret; ret_len_slot = if fat_ret { slot_reg } else { 0 }
        ref_fns = ref_fns; field_decls = field_decls; addr_taken = collect_addr_taken_locals(f.body, ref_fns, enums); table = table
        region_stack = []; escaping = checker::fn_escaping_vars(f); frees_old_names = checker::fn_frees_old_vars(f); bracket_depth = 0
        region_param = 0; plan = checker::residence_plan(f, table); rodata_base = rodata_base; const_rodata = const_rodata; lifted_base = lifted_base
    }
    var framed = open_frame_region(ctx0, f.line, f.col)
    var done = match lower_fn_body(framed, f.body, ltype_of(f.return_type, enums), f.line, f.col) { LowerCtx as c => c; error as err => return stop_in_function(err, f) }
    var closed = match close_function(done, f) { LowerCtx as c => c; error as err => return stop_in_function(err, f) }
    LoweredFunction { func = closed.func; rodata = closed.rodata; lifted = closed.lifted }
}

fn stop_in_function(err: error, f: checker::TFunction): error {
    error { message = err.message ~ " [in `" ~ f.namespace ~ "::" ~ f.name ~ "`]" }
}

pub type LoweredFunction = struct { func: LFunc; rodata: []LRodata; lifted: []LFunc }

fn close_function(ctx: LowerCtx, f: checker::TFunction): LowerCtx | error {
    if block_terminated(ctx.func, ctx.block_id) { return ctx }
    var replayed = match replay_defers(ctx, 0) { LowerCtx as c => c; error as err => return err }
    var left = emit_region_leaves(replayed, f.line, f.col)
    var dropped = emit_region_drops(left, f.line, f.col)
    ctx_append(dropped, ret_void_inst(f.line, f.col))
}

fn block_terminated(f: LFunc, block_id: u32): bool {
    var it = f.blocks.iter()
    loop {
        match it.next() {
            LBlock as b => {
                if b.id == block_id { return block_ends_in_terminator(b) }
            }
            null => break
        }
    }
    false
}

fn block_ends_in_terminator(b: LBlock): bool {
    if b.insts.is_empty() { return false }
    inst_is_terminator(b.insts.last())
}

fn inst_is_terminator(inst: LInst): bool {
    match inst.op {
        LRet => true
        LJump => true
        LBranch => true
        _ => false
    }
}

fn param_ltype_width(p: parser::Param, table: checker::TypeTable): u64 {
    if typeexpr_is_fat(p.type_ann, table) { return 2 }
    1
}

fn param_ltypes(params: []parser::Param, enums: []LEnumInfo, table: checker::TypeTable): []LType {
    var total: u64 = 0
    var c: u64 = 0
    loop {
        if c >= params.len { break }
        total = total + param_ltype_width(params[c], table)
        c++
    }
    var out: [total]LType = []
    var k: u64 = 0
    var i: u64 = 0
    loop {
        if i >= params.len { break }
        if typeexpr_is_fat(params[i].type_ann, table) {
            out[k] = LType::Ptr
            k++
            out[k] = LType::I64
            k++
        } else {
            out[k] = ltype_of_typeexpr(params[i].type_ann, enums)
            k++
        }
        i++
    }
    out
}

pub type LowerPrelude = struct {
    module: LModule
    layouts: []LStructLayout
    enums: []LEnumInfo
    externs: []LExternFn
    variants: []LVariantDef
    ref_fns: []LRefFnInfo
    field_decls: []LFieldDecls
    table: checker::TypeTable
}

pub fn lower_prelude(prog: checker::TProgram, flat_symbols: bool): LowerPrelude | error {
    var table = checker::type_table_of(prog)
    match fat_divergence_guard(prog, table, checker::type_table_rekeyed(table)) { error as e => return e; null => { } }
    var enums = collect_enums(prog)
    var dtable = declared_type_table(prog)
    var layouts = match collect_struct_layouts(prog, enums, table, dtable) { []LStructLayout as ls => ls; error as e => return e }
    var externs = collect_externs(prog)
    var variants = collect_variant_defs(prog)
    var ref_fns = collect_ref_fns(prog)
    var field_decls = match collect_field_decls(prog) { []LFieldDecls as fd => fd; error as e => return e }
    var cprog = match checker::collapse_agg_const_decls(prog) { checker::TProgram as p => p; error as e => return e }
    var m = match intern_aggregate_consts(register_layouts(empty_module(), layouts), cprog.items, layouts, variants, enums) { LModule as x => x; error as e => return e }
    LowerPrelude { module = m; layouts = layouts; enums = enums; externs = externs; variants = variants; ref_fns = ref_fns; field_decls = field_decls; table = table }
}

pub fn lower_program(prog: checker::TProgram, flat_symbols: bool = false): LModule | error {
    var prelude = match lower_prelude(prog, flat_symbols) { LowerPrelude as x => x; error as e => return e }
    var m = prelude.module
    var loose: []@TStatement() = []
    var lifted: []LFunc = []
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        var step = match lower_item(m, loose, prog.items[i], prelude.layouts, prelude.enums, lifted, prelude.externs, flat_symbols, prelude.variants, prelude.table, prelude.ref_fns, prelude.field_decls) { LowerItemOut as x => x; error as err => return err }
        m = step.module
        loose = step.loose
        lifted = step.lifted
        i++
    }
    var vmain = match lower_virtual_main(loose, prelude.layouts, prelude.enums, m.rodata, lifted, prelude.externs, flat_symbols, prelude.variants, prelude.ref_fns, prelude.field_decls, prelude.table) { LoweredFunction as x => x; error as err => return err }
    var whole = fold_lifted_funcs(add_func(with_rodata(m, vmain.rodata), vmain.func), vmain.lifted)
    match frame_escape_guard(whole) { error as e => return e; null => { } }
    whole
}

const FAT_DIVERGENCE_LIMIT: u64 = 20

fn fat_divergence_guard(prog: checker::TProgram, table: checker::TypeTable, rtable: checker::TypeTable): null | error {
    var found = fat_divergences(prog, table, rtable)
    if found.len == 0 { return null }
    error { message = teko::str::concat("native backend N1: the syntactic fat-pointer predicate disagrees with the checker on ", teko::u64_to_str(found.len), " annotation(s) (internal) — ", fat_divergence_lines(found)) }
}

fn fat_divergences(prog: checker::TProgram, table: checker::TypeTable, rtable: checker::TypeTable): []str {
    var out: []str = []
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        out = fat_divergences_of_item(out, prog.items[i], table, rtable)
        i++
    }
    out
}

fn fat_divergences_of_item(acc: []str, it: @TItem(), table: checker::TypeTable, rtable: checker::TypeTable): []str {
    match it {
        checker::TFunction as f => fat_divergences_of_params(acc, f, table, rtable)
        parser::TypeDecl as td => fat_divergences_of_decl(acc, td, table, rtable)
        _ => acc
    }
}

fn fat_divergences_of_params(acc: []str, f: checker::TFunction, table: checker::TypeTable, rtable: checker::TypeTable): []str {
    var out = acc
    var i: u64 = 0
    loop {
        if i >= f.params.len { break }
        out = fat_divergence_line_of(out, f.params[i].type_ann, table, rtable, f.namespace, "parameter", f.name, f.params[i].name)
        i++
    }
    out
}

fn fat_divergences_of_decl(acc: []str, td: parser::TypeDecl, table: checker::TypeTable, rtable: checker::TypeTable): []str {
    var fields = match td.body {
        parser::StructBody as sb => sb.fields
        parser::ClassBody as cb => cb.fields
        _ => return acc
    }
    var ns = checker::name_qualifier(td.name)
    var out = acc
    var i: u64 = 0
    loop {
        if i >= fields.len { break }
        out = fat_divergence_line_of(out, fields[i].type_ann, table, rtable, ns, "field", td.name, fields[i].name)
        i++
    }
    out
}

fn fat_divergence_line_of(acc: []str, te: @TypeExpr(), table: checker::TypeTable, rtable: checker::TypeTable, ns: str, place: str, owner: str, name: str): []str {
    var truth = match checker::resolve_type(te, rtable, ns) { (@Type()) as t => t; error => return acc }
    var semantic = is_fat_type(truth)
    if typeexpr_is_fat(te, table) == semantic { return acc }
    [..acc, teko::str::concat(place, " `", name, "` of `", owner, "`: syntax says ", fat_word(!semantic), ", the checker says ", fat_word(semantic))]
}

fn fat_word(fat: bool): str {
    if fat { return "fat" }
    "scalar"
}

fn fat_divergence_lines(found: []str): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= found.len { break }
        if i >= FAT_DIVERGENCE_LIMIT { return teko::str::concat(out, "; and ", teko::u64_to_str(found.len - FAT_DIVERGENCE_LIMIT), " more") }
        out = if i == 0 { found[i] } else { teko::str::concat(out, "; ", found[i]) }
        i++
    }
    out
}

fn fold_lifted_funcs(m: LModule, lifted: []LFunc): LModule {
    var cur = m
    var i: u64 = 0
    loop {
        if i >= lifted.len { break }
        cur = add_func(cur, lifted[i])
        i++
    }
    cur
}

fn register_layouts(m: LModule, layouts: []LStructLayout): LModule {
    var cur = m
    var i: u64 = 0
    loop {
        if i >= layouts.len { break }
        cur = add_layout(cur, layouts[i])
        i++
    }
    cur
}

fn collect_struct_layouts(prog: checker::TProgram, enums: []LEnumInfo, table: checker::TypeTable, dtable: checker::TypeTable): []LStructLayout | error {
    var out: []LStructLayout = [error_struct_layout()]
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        out = match collect_struct_layout_item(out, prog.items[i], table, enums, dtable) {
            []LStructLayout as next => next
            error as e => return e
        }
        i++
    }
    out
}

fn collect_struct_layout_item(acc: []LStructLayout, it: @TItem(), table: checker::TypeTable, enums: []LEnumInfo, dtable: checker::TypeTable): []LStructLayout | error {
    match it {
        parser::TypeDecl as td => collect_struct_layout_decl(acc, td, table, enums, dtable)
        _ => acc
    }
}

fn collect_struct_layout_decl(acc: []LStructLayout, td: parser::TypeDecl, table: checker::TypeTable, enums: []LEnumInfo, dtable: checker::TypeTable): []LStructLayout | error {
    match td.body {
        parser::StructBody as sb => [..acc, layout_of_fields(td.name, sb.fields, acc, enums, table, dtable, true)]
        parser::ClassBody as cb => push_class_layout(acc, td.name, cb, table, enums, dtable)
        _ => acc
    }
}

fn push_class_layout(acc: []LStructLayout, name: str, cb: parser::ClassBody, table: checker::TypeTable, enums: []LEnumInfo, dtable: checker::TypeTable): []LStructLayout | error {
    var fields = match class_instance_fields(name, cb, table) {
        []parser::Field as fs => fs
        error as e => return e
    }
    [..acc, layout_of_fields(name, fields, acc, enums, table, dtable, false)]
}

fn class_instance_fields(name: str, cb: parser::ClassBody, table: checker::TypeTable): []parser::Field | error {
    match checker::effective_class_fields(cb, table) {
        []parser::Field as fs => fs
        error as e => error { message = teko::str::concat("native backend N1: no layout for class `", name, "`: ", e.message, " (internal)") }
    }
}

fn layout_of_fields(name: str, fields: []parser::Field, known: []LStructLayout, enums: []LEnumInfo, table: checker::TypeTable, dtable: checker::TypeTable, with_hdr: bool): LStructLayout {
    var ns = checker::name_qualifier(name)
    var hdr: u64 = if with_hdr { 1 } else { 0 }
    var total = hdr + fields.len
    var field_names: [total]str = []
    var field_types: [total]LType = []
    var field_sizes: [total]u32 = []
    var field_aligns: [total]u32 = []
    if with_hdr {
        field_names[0] = struct_hdr_field_name()
        field_types[0] = LType::Ptr
        field_sizes[0] = ltype_size(LType::Ptr)
        field_aligns[0] = ltype_align(LType::Ptr)
    }
    var i: u64 = 0
    loop {
        if i >= fields.len { break }
        var te = fields[i].type_ann
        var ft = ltype_of_typeexpr(te, enums)
        var rft = resolved_field_type(te, ns, dtable)
        var nested = struct_layout_of_resolved(rft, te, known)
        field_names[hdr + i] = fields[i].name
        field_types[hdr + i] = ft
        field_sizes[hdr + i] = field_layout_size(te, ft, nested, table, rft)
        field_aligns[hdr + i] = field_layout_align(te, ft, nested, table, rft)
        i++
    }
    layout_of_sized(name, field_names, field_types, field_sizes, field_aligns)
}

fn struct_layout_of_resolved(rft: @Type(), te: @TypeExpr(), known: []LStructLayout): LStructLayout | null {
    match rft {
        checker::Named as n => match find_known_struct_layout(known, n.name) {
            LStructLayout as l => return l
            null => { }
        }
        _ => { }
    }
    struct_layout_of_field(te, known)
}

fn struct_layout_of_field(te: @TypeExpr(), known: []LStructLayout): LStructLayout | null {
    match te {
        parser::NamedType as nt => match find_known_struct_layout(known, path_name_of(nt.path)) {
            LStructLayout as l => l
            null => match single_segment_name(nt.path) {
                str as bare => find_known_struct_layout(known, bare)
                null => null
            }
        }
        _ => null
    }
}

fn named_type_name_of(te: @TypeExpr()): str | null {
    match te {
        parser::NamedType as nt => single_segment_name(nt.path)
        _ => null
    }
}

fn single_segment_name(p: parser::Path): str | null {
    if p.segments.len != 1 { return null }
    p.segments[0].name
}

fn path_last_segment_name(p: parser::Path): str | null {
    if p.segments.len == 0 { return null }
    p.segments[p.segments.len - 1].name
}

fn path_qualifier_of(p: parser::Path): str {
    if p.segments.len < 2 { return "" }
    var out = p.segments[0].name
    var i: u64 = 1
    loop {
        if i + 1 >= p.segments.len { break }
        out = teko::str::concat(out, "::", p.segments[i].name)
        i++
    }
    out
}

fn find_known_struct_layout(layouts: []LStructLayout, name: str): LStructLayout | null {
    var i: u64 = 0
    loop {
        if i >= layouts.len { break }
        if layouts[i].name == name { return layouts[i] }
        i++
    }
    null
}

fn field_size_of(ft: LType, nested: LStructLayout | null): u32 {
    match nested {
        LStructLayout as l => nested_by_address_size(l)
        null => ltype_size(ft)
    }
}

fn nested_by_address_size(l: LStructLayout): u32 {
    ltype_size(LType::Ptr)
}

fn field_align_of(ft: LType, nested: LStructLayout | null): u32 {
    match nested {
        LStructLayout as l => nested_by_address_align(l)
        null => ltype_align(ft)
    }
}

fn nested_by_address_align(l: LStructLayout): u32 {
    ltype_align(LType::Ptr)
}

fn visited_name_has(visited: []str, name: str): bool {
    var i: u64 = 0
    loop {
        if i >= visited.len { break }
        if visited[i] == name { return true }
        i++
    }
    false
}

fn typeexpr_is_fat_named(nt: parser::NamedType, table: checker::TypeTable, visited: []str): bool {
    var name = match path_last_segment_name(nt.path) { str as s => s; null => return false }
    if name == "str" { return true }
    if name == "char" { return true }
    if visited_name_has(visited, name) { return false }
    match checker::type_table_find_path(table, path_qualifier_of(nt.path), name) {
        parser::TypeDecl as td => typeexpr_is_fat_decl_body(td.body, table, [..visited, name])
        error => false
    }
}

fn typeexpr_is_fat_decl_body(body: @TypeBody(), table: checker::TypeTable, visited: []str): bool {
    match body {
        parser::AliasBody as ab => typeexpr_is_fat_walk(ab.alias, table, visited)
        _ => false
    }
}

fn typeexpr_is_fat_walk(te: @TypeExpr(), table: checker::TypeTable, visited: []str): bool {
    match te {
        parser::SliceType => true
        parser::NamedType as nt => typeexpr_is_fat_named(nt, table, visited)
        _ => false
    }
}

fn typeexpr_is_fat(te: @TypeExpr(), table: checker::TypeTable): bool {
    typeexpr_is_fat_walk(te, table, [])
}

fn field_layout_size(te: @TypeExpr(), ft: LType, nested: LStructLayout | null, table: checker::TypeTable, rft: @Type()): u32 {
    if field_is_fat_resolved(te, table, rft) { return fat_value_bytes(fat_field_width_type(rft)) }
    field_size_of(ft, nested)
}

fn fat_field_width_type(rft: @Type()): @Type() {
    if is_fat_type(rft) { return rft }
    checker::Slice { element = checker::Named { name = "teko::base::str" } }
}

fn field_is_fat_resolved(te: @TypeExpr(), table: checker::TypeTable, rft: @Type()): bool {
    typeexpr_is_fat(te, table) || is_fat_type(rft)
}

fn field_layout_align(te: @TypeExpr(), ft: LType, nested: LStructLayout | null, table: checker::TypeTable, rft: @Type()): u32 {
    if field_is_fat_resolved(te, table, rft) { return ltype_align(LType::Ptr) }
    field_align_of(ft, nested)
}

fn collect_enums(prog: checker::TProgram): []LEnumInfo {
    var out: []LEnumInfo = []
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        out = collect_enum_item(out, prog.items[i])
        i++
    }
    out
}

fn collect_enum_item(acc: []LEnumInfo, it: @TItem()): []LEnumInfo {
    match it {
        parser::TypeDecl as td => collect_enum_decl(acc, td)
        _ => acc
    }
}

fn collect_enum_decl(acc: []LEnumInfo, td: parser::TypeDecl): []LEnumInfo {
    match td.body {
        parser::EnumBody as eb => [..acc, LEnumInfo { name = td.name; members = eb.members; carrier = enum_carrier_ltype(); is_register = true; is_newtype = false }]
        parser::NewtypeBody as nb => [..acc, newtype_carrier_entry(td.name, nb, acc)]
        _ => acc
    }
}

fn newtype_carrier_entry(name: str, nb: parser::NewtypeBody, acc: []LEnumInfo): LEnumInfo {
    var carrier = ltype_of_typeexpr(nb.backing, acc)
    LEnumInfo { name = name; members = []; carrier = carrier; is_register = ltype_is_scalar(carrier); is_newtype = true }
}

fn ltype_is_scalar(t: LType): bool {
    if t == LType::Ptr { return false }
    if t == LType::Void { return false }
    true
}

fn collect_externs(prog: checker::TProgram): []LExternFn {
    var out: []LExternFn = []
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        out = collect_extern_item(out, prog.items[i])
        i++
    }
    out
}

fn collect_extern_item(acc: []LExternFn, it: @TItem()): []LExternFn {
    match it {
        checker::TFunction as f => collect_extern_fn(acc, f)
        _ => acc
    }
}

fn collect_extern_fn(acc: []LExternFn, f: checker::TFunction): []LExternFn {
    if !f.is_extern { return acc }
    [..acc, LExternFn { namespace = f.namespace; name = f.name; c_symbol = f.c_symbol }]
}

pub type LowerItemOut = struct { module: LModule; loose: []@TStatement(); lifted: []LFunc }

pub fn lower_item(m: LModule, loose: []@TStatement(), it: @TItem(), layouts: []LStructLayout, enums: []LEnumInfo, lifted: []LFunc, externs: []LExternFn, flat_symbols: bool, variants: []LVariantDef, table: checker::TypeTable, ref_fns: []LRefFnInfo, field_decls: []LFieldDecls, rodata_base: u64 = 0, const_rodata: []LRodata = [], lifted_base: u64 = 0): LowerItemOut | error {
    match it {
        checker::TFunction as f => lower_item_function(m, loose, f, layouts, enums, lifted, externs, flat_symbols, variants, table, ref_fns, field_decls, rodata_base, const_rodata, lifted_base)
        (@TStatement()) as s => LowerItemOut { module = m; loose = [..loose, s]; lifted = lifted }
        checker::TConstDecl as cd => lower_const_item(m, loose, cd, lifted)
        _ => LowerItemOut { module = m; loose = loose; lifted = lifted }
    }
}

fn const_decl_is_scalar(t: @Type()): bool {
    match t {
        checker::Slice => false
        checker::Named => false
        checker::Variant => false
        checker::Func => false
        checker::Error => false
        checker::Void => false
        checker::Ptr => false
        checker::Uptr => false
        checker::Reference => false
        checker::Null => false
        checker::Prim => true
        checker::Byte => true
        checker::Char => true
    }
}

fn lower_const_item(m: LModule, loose: []@TStatement(), cd: checker::TConstDecl, lifted: []LFunc): LowerItemOut | error {
    LowerItemOut { module = m; loose = loose; lifted = lifted }
}

fn lower_item_function(m: LModule, loose: []@TStatement(), f: checker::TFunction, layouts: []LStructLayout, enums: []LEnumInfo, lifted: []LFunc, externs: []LExternFn, flat_symbols: bool, variants: []LVariantDef, table: checker::TypeTable, ref_fns: []LRefFnInfo, field_decls: []LFieldDecls, rodata_base: u64 = 0, const_rodata: []LRodata = [], lifted_base: u64 = 0): LowerItemOut | error {
    if f.is_test { return LowerItemOut { module = m; loose = loose; lifted = lifted } }
    if f.is_extern { return LowerItemOut { module = m; loose = loose; lifted = lifted } }
    var lf = match lower_function(f, table, layouts, m.rodata, enums, lifted, externs, flat_symbols, variants, ref_fns, field_decls, rodata_base, const_rodata, lifted_base) { LoweredFunction as x => x; error as err => return err }
    LowerItemOut { module = add_func(with_rodata(m, lf.rodata), lf.func); loose = loose; lifted = lf.lifted }
}

pub fn lower_virtual_main(loose: []@TStatement(), layouts: []LStructLayout, enums: []LEnumInfo, rodata: []LRodata, lifted: []LFunc, externs: []LExternFn, flat_symbols: bool, variants: []LVariantDef, ref_fns: []LRefFnInfo, field_decls: []LFieldDecls, table: checker::TypeTable, rodata_base: u64 = 0, const_rodata: []LRodata = [], lifted_base: u64 = 0): LoweredFunction | error {
    var fn0 = new_func("main", 0, [], LType::I32)
    var ctx0 = LowerCtx {
        func = fn0; block_id = 0; env = empty_lenv()
        layouts = layouts; rodata = rodata; enums = enums; lifted = lifted
        variants = variants
        defers = []; loop_targets = []; externs = externs
        flat_symbols = flat_symbols; ret_type = checker::Prim { kind = checker::PrimKind::I32 }
        has_ret_len_slot = false; ret_len_slot = 0
        ref_fns = ref_fns; field_decls = field_decls; addr_taken = collect_addr_taken_locals(loose, ref_fns, enums); table = table
        region_stack = []; escaping = []; frees_old_names = []; bracket_depth = 0
        region_param = 0; plan = checker::ResidencePlan { bindings = []; returns = [] }; rodata_base = rodata_base; const_rodata = const_rodata; lifted_base = lifted_base
    }
    var tail = match lower_main_tail(ctx0, loose) { LowerMainTail as x => x; error as err => return err }
    var closed = match close_virtual_main(tail) { LowerCtx as c => c; error as err => return err }
    LoweredFunction { func = closed.func; rodata = closed.rodata; lifted = closed.lifted }
}

pub type LowerMainTail = struct { ctx: LowerCtx; has_value: bool; vreg: u32 }

fn lower_main_tail(ctx: LowerCtx, body: []@TStatement()): LowerMainTail | error {
    if body.len == 0 { return LowerMainTail { ctx = ctx; has_value = false; vreg = 0 } }
    var cur = ctx
    var i: u64 = 0
    loop {
        if i + 1 >= body.len { break }
        var out = match lower_stmt(cur, body[i]) { LowerStmtOut as x => x; error as err => return err }
        cur = out.ctx
        if out.terminated { return LowerMainTail { ctx = cur; has_value = false; vreg = 0 } }
        i++
    }
    lower_main_tail_stmt(cur, body[body.len - 1])
}

fn lower_main_tail_stmt(ctx: LowerCtx, s: @TStatement()): LowerMainTail | error {
    match s {
        checker::TExprStmt as es => lower_main_tail_expr(ctx, es)
        _ => lower_main_tail_other(ctx, s)
    }
}

fn lower_main_tail_expr(ctx: LowerCtx, es: checker::TExprStmt): LowerMainTail | error {
    if ltype_is_void(ltype_of(es.expr.type, ctx.enums)) {
        var out = match lower_expr_stmt(ctx, es) { LowerStmtOut as x => x; error as err => return err }
        return LowerMainTail { ctx = out.ctx; has_value = false; vreg = 0 }
    }
    var lo = match lower_expr(ctx, es.expr) { Lowered as x => x; error as err => return err }
    LowerMainTail { ctx = lo.ctx; has_value = true; vreg = lo.vreg }
}

fn lower_main_tail_other(ctx: LowerCtx, s: @TStatement()): LowerMainTail | error {
    var out = match lower_stmt(ctx, s) { LowerStmtOut as x => x; error as err => return err }
    LowerMainTail { ctx = out.ctx; has_value = false; vreg = 0 }
}

fn close_virtual_main(tail: LowerMainTail): LowerCtx | error {
    if block_terminated(tail.ctx.func, tail.ctx.block_id) { return tail.ctx }
    var replayed = match replay_defers(tail.ctx, 0) { LowerCtx as c => c; error as err => return err }
    if tail.has_value { return ctx_append(replayed, ret_inst(tail.vreg, 0, 0)) }
    var r = ctx_alloc(replayed)
    var c0 = ctx_append(r.ctx, const_int_inst(r.vreg, 0, 0, 0))
    ctx_append(c0, ret_inst(r.vreg, 0, 0))
}

const NATIVE_ENTRY_VMAIN_SYMBOL: str = "__teko_native_vmain"

pub fn wrap_native_entry(m: LModule): LModule | error {
    var renamed = match native_entry_rename_vmain(m.funcs) { teko::collections::Chunked<LFunc> as fs => fs; error as e => return e }
    renamed.push(native_entry_stub())
    LModule { funcs = renamed; rodata = m.rodata; globals = m.globals; layouts = m.layouts }
}

fn native_entry_rename_vmain(funcs: teko::collections::Chunked<LFunc>): teko::collections::Chunked<LFunc> | error {
    var out = teko::collections::Chunked<LFunc>::make()
    var found = false
    var it = funcs.iter()
    loop {
        match it.next() {
            LFunc as f => {
                if f.symbol == "main" {
                    found = true
                    out.push(rename_lfunc(f, NATIVE_ENTRY_VMAIN_SYMBOL))
                } else {
                    out.push(f)
                }
            }
            null => break
        }
    }
    if !found { return error { message = "native backend: wrap_native_entry — no `main` entry function found in the lowered module (internal)" } }
    out
}

fn append_exit_status_mask(f: LFunc, code: u32): FreshVReg {
    var maskreg = alloc_vreg(f)
    var with_mask = append_inst(maskreg.func, 0, const_int_inst(maskreg.vreg, EXIT_STATUS_MASK, 0, 0))
    var status = alloc_vreg(with_mask)
    var with_and = append_inst(status.func, 0, bin_inst(status.vreg, LBinOp::IAnd, code, maskreg.vreg, 0, 0))
    FreshVReg { func = with_and; vreg = status.vreg }
}

fn native_entry_stub(): LFunc {
    var ptypes = [LType::I32, LType::Ptr]
    var fn0 = new_func("main", 2, ptypes, LType::I32)
    var with_argc = append_inst(fn0, 0, param_inst(0, 0, 0, 0))
    var with_argv = append_inst(with_argc, 0, param_inst(1, 1, 0, 0))
    var with_set = append_inst(with_argv, 0, void_call_inst("tk_set_args", [0, 1], false, 0, 0))
    var called = alloc_vreg(with_set)
    var with_call = append_inst(called.func, 0, call_inst(called.vreg, NATIVE_ENTRY_VMAIN_SYMBOL, [], false, 0, 0))
    var status = append_exit_status_mask(with_call, called.vreg)
    append_inst(status.func, 0, ret_inst(status.vreg, 0, 0))
}
