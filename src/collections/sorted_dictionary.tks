/** A growable, reference-semantic map kept in ascending `K: IOrd` order (binary-searchable). */
exp type SortedDictionary<K: IOrd, V> = class {
    intern keys: []K
    intern vals: []V

    /** Builds an empty `SortedDictionary<K, V>`. */
    pub static fn make(): SortedDictionary<K, V> {
        .{ keys = []; vals = [] }
    }

    /** The number of distinct keys currently held. */
    pub fn len(): u64 { self.keys.len }

    /** True iff `len() == 0`. */
    pub fn is_empty(): bool { self.keys.len == 0 }

    /** True iff `k` is a key in the ordered map (binary search over `<`). */
    pub fn contains(k: K): bool {
        var at = sorted_key_lower_bound(self.keys, k)
        at < self.keys.len && !(k < self.keys[at]) && !(self.keys[at] < k)
    }

    /** Inserts or updates `v` at `k`'s sorted position, in place. */
    pub fn insert(k: K, v: V) {
        var at = sorted_key_lower_bound(self.keys, k)
        if at < self.keys.len && !(k < self.keys[at]) && !(self.keys[at] < k) {
            self.vals = arr_replace_at(self.vals, at, v)
            return
        }
        self.keys = arr_insert_at(self.keys, at, k)
        self.vals = arr_insert_at(self.vals, at, v)
    }

    /** The value associated with `k`, or `null` when `k` is absent. */
    pub fn get(k: K): V | null {
        var at = sorted_key_lower_bound(self.keys, k)
        if at >= self.keys.len || k < self.keys[at] || self.keys[at] < k { return null }
        self.vals[at]
    }

    /** A `[]K` snapshot of the ordered map's current keys, in ascending order. */
    pub fn keys(): []K { self.keys }
}

pub fn sorted_key_lower_bound<K: IOrd>(keys: []K, k: K): u64 {
    var lo: u64 = 0
    var hi: u64 = keys.len
    loop {
        if lo >= hi { break }
        var mid = lo + (hi - lo) / 2
        if keys[mid] < k { lo = mid + 1 } else { hi = mid }
    }
    lo
}
