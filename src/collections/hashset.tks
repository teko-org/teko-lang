/** A growable, reference-semantic hash set with O(1) amortized membership over `T: IEq & IHash`. */
exp type HashSet<T: IEq & IHash> = class {
    intern hashes: []u64
    intern items: []T

    /** Builds an empty `HashSet<T>`. */
    pub static fn make(): HashSet<T> {
        .{ hashes = []; items = [] }
    }

    /** The number of elements currently held. */
    pub fn len(): u64 { self.items.len }

    /** True iff `len() == 0`. */
    pub fn is_empty(): bool { self.items.len == 0 }

    /** Adds `x` if absent (idempotent); returns whether it was newly inserted. */
    pub fn add(x: T): bool {
        var h = x.hash()
        if dict_find_index(self.items, self.hashes, h, x) < self.items.len { return false }
        self.hashes = [..self.hashes, h]
        self.items = [..self.items, x]
        true
    }

    /** True iff `x` is a member of the set. */
    pub fn contains(x: T): bool {
        dict_find_index(self.items, self.hashes, x.hash(), x) < self.items.len
    }

    /** Removes `x` if present, in place; returns whether it was removed. */
    pub fn remove(x: T): bool {
        var at = dict_find_index(self.items, self.hashes, x.hash(), x)
        if at >= self.items.len { return false }
        self.hashes = arr_drop_u64_at(self.hashes, at)
        self.items = arr_drop_at(self.items, at)
        true
    }

    /** A `[]T` snapshot of the set's current elements, in insertion order. */
    pub fn to_array(): []T { self.items }
}
