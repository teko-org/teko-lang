/** The fixed leaf capacity of a `Chunked<T>` chain; the tail grows by one chunk of this size (never geometric). */
exp const CHUNK: u64 = 256

/** Copy of `xs` with the element at `at` replaced by `v`; out-of-range `at` yields an unchanged copy. */
exp fn arr_replace_at<T>(xs: []T, at: u64, v: T): []T {
    var out: [xs.len]T = []
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if i == at { out[i] = v } else { out[i] = xs[i] }
        i++
    }
    out
}

/** Copy of a `[]u64` array with the element at `at` removed; out-of-range `at` yields an unchanged copy. */
exp fn arr_drop_u64_at(xs: []u64, at: u64): []u64 {
    var out: [xs.len]u64 = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if i != at {
            out[count] = xs[i]
            count++
        }
        i++
    }
    arr_slice(out, 0, count)
}

/** Copy of `xs` with the element at `at` removed; out-of-range `at` yields an unchanged copy. */
exp fn arr_drop_at<T>(xs: []T, at: u64): []T {
    var out: [xs.len]T = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if i != at {
            out[count] = xs[i]
            count++
        }
        i++
    }
    arr_slice(out, 0, count)
}

/** Copy of `xs` with its last element removed; an empty `xs` yields an empty copy. */
exp fn arr_drop_last<T>(xs: []T): []T {
    if xs.len == 0 { return [] }
    arr_drop_at(xs, xs.len - 1)
}

/** Copy of `xs` with `v` inserted before index `at` (clamped to `xs.len` for an append). */
exp fn arr_insert_at<T>(xs: []T, at: u64, v: T): []T {
    var out: [xs.len + 1]T = []
    var count: u64 = 0
    var inserted = false
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if i == at {
            out[count] = v
            count++
            inserted = true
        }
        out[count] = xs[i]
        count++
        i++
    }
    if !inserted {
        out[count] = v
        count++
    }
    arr_slice(out, 0, count)
}

/** Copy of `xs` with the elements at `i` and `j` exchanged; out-of-range indices yield an unchanged copy. */
exp fn arr_swap<T>(xs: []T, i: u64, j: u64): []T {
    if i >= xs.len || j >= xs.len { return arr_slice(xs, 0, xs.len) }
    var swapped_i = arr_replace_at(xs, i, xs[j])
    arr_replace_at(swapped_i, j, xs[i])
}

/** Copy of `xs` in reverse order. */
exp fn arr_reverse<T>(xs: []T): []T {
    var out: [xs.len]T = []
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        out[i] = xs[xs.len - 1 - i]
        i++
    }
    out
}

/** Copy of the half-open range `[from, min(to, xs.len))` of `xs`. */
exp fn arr_slice<T>(xs: []T, from: u64, to: u64): []T {
    var hi = to
    if hi > xs.len { hi = xs.len }
    var n = if hi > from { hi - from } else { 0 }
    var out: [n]T = []
    var i: u64 = 0
    loop {
        if i >= n { break }
        out[i] = xs[from + i]
        i++
    }
    out
}

pub fn sorted_insert<T: IOrd>(ref items: []T, x: T): bool {
    var arr = items.value
    var lo: u64 = 0
    var hi: u64 = arr.len
    loop {
        if lo >= hi { break }
        var mid = lo + (hi - lo) / 2
        if arr[mid] < x { lo = mid + 1 } else { hi = mid }
    }
    if lo < arr.len && !(x < arr[lo]) && !(arr[lo] < x) { return false }
    items.value = arr_insert_at(arr, lo, x)
    true
}

pub fn heap_sift_up<T: IOrd>(heap: []T): []T {
    var h = heap
    if h.len == 0 { return h }
    var i = h.len - 1
    loop {
        if i == 0 { break }
        var parent = (i - 1) / 2
        if !(h[i] < h[parent]) { break }
        h = arr_swap(h, i, parent)
        i = parent
    }
    h
}

pub fn heap_pop_min<T: IOrd>(ref heap: []T): T {
    var h = heap.value
    var top = h[0]
    var last = h[h.len - 1]
    h = arr_drop_last(h)
    if h.len == 0 {
        heap.value = h
        return top
    }
    h = arr_replace_at(h, 0, last)
    var i: u64 = 0
    loop {
        var l = i * 2 + 1
        var r = i * 2 + 2
        var smallest = i
        if l < h.len && h[l] < h[smallest] { smallest = l }
        if r < h.len && h[r] < h[smallest] { smallest = r }
        if smallest == i { break }
        h = arr_swap(h, i, smallest)
        i = smallest
    }
    heap.value = h
    top
}
