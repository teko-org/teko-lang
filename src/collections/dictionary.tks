/** A growable, reference-semantic hash map from an arbitrary `K: IEq & IHash` key type to `V` values. */
exp type Dictionary<K: IEq & IHash, V> = class {
    intern keys: []K
    intern hashes: []u64
    intern vals: []V

    /** Builds an empty `Dictionary<K, V>`. */
    pub static fn make(): Dictionary<K, V> {
        .{ keys = []; hashes = []; vals = [] }
    }

    /** The number of distinct keys currently held. */
    pub fn len(): u64 { self.keys.len }

    /** True iff `len() == 0`. */
    pub fn is_empty(): bool { self.keys.len == 0 }

    /** True iff `k` is a key in the dictionary. */
    pub fn contains(k: K): bool {
        dict_find_index(self.keys, self.hashes, k.hash(), k) < self.keys.len
    }

    /** Inserts or updates the value for `k`, in place. */
    pub fn insert(k: K, v: V) {
        var h = k.hash()
        var at = dict_find_index(self.keys, self.hashes, h, k)
        if at < self.keys.len {
            self.vals = arr_replace_at(self.vals, at, v)
            return
        }
        self.keys = [..self.keys, k]
        self.hashes = [..self.hashes, h]
        self.vals = [..self.vals, v]
    }

    /** The value associated with `k`, or `null` when `k` is absent. */
    pub fn get(k: K): V | null {
        var at = dict_find_index(self.keys, self.hashes, k.hash(), k)
        if at >= self.keys.len { return null }
        self.vals[at]
    }

    /** Removes the entry for `k` if present, in place; returns whether one was removed. */
    pub fn remove(k: K): bool {
        var at = dict_find_index(self.keys, self.hashes, k.hash(), k)
        if at >= self.keys.len { return false }
        self.keys = arr_drop_at(self.keys, at)
        self.hashes = arr_drop_u64_at(self.hashes, at)
        self.vals = arr_drop_at(self.vals, at)
        true
    }

    /** A `[]K` snapshot of the dictionary's current keys, in insertion order. */
    pub fn keys(): []K { self.keys }
}

pub fn dict_find_index<K: IEq & IHash>(keys: []K, hashes: []u64, h: u64, k: K): u64 {
    var i: u64 = 0
    loop {
        if i >= keys.len { break }
        if hashes[i] == h && keys[i] == k { return i }
        i++
    }
    keys.len
}
