/** A growable, reference-semantic set kept in ascending order by `T: IOrd` (binary-searchable). */
exp type SortedSet<T: IOrd> = class {
    intern items: []T

    /** Builds an empty `SortedSet<T>`. */
    pub static fn make(): SortedSet<T> { .{ items = [] } }

    /** The number of elements currently held. */
    pub fn len(): u64 { self.items.len }

    /** True iff `len() == 0`. */
    pub fn is_empty(): bool { self.items.len == 0 }

    /** Adds `x` at its sorted position if absent (idempotent); returns whether it was newly inserted. */
    pub fn add(x: T): bool {
        var arr = self.items
        var inserted = sorted_insert(&arr, x)
        self.items = arr
        inserted
    }

    /** True iff `x` is a member (binary search over `<`). */
    pub fn contains(x: T): bool {
        var arr = self.items
        var lo: u64 = 0
        var hi: u64 = arr.len
        loop {
            if lo >= hi { break }
            var mid = lo + (hi - lo) / 2
            if arr[mid] < x { lo = mid + 1 } else { hi = mid }
        }
        lo < arr.len && !(x < arr[lo]) && !(arr[lo] < x)
    }

    /** A `[]T` snapshot of the set's current elements, in ascending order. */
    pub fn to_array(): []T { self.items }
}
