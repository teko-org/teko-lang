/** A growable, reference-semantic min-priority queue over `T: IOrd` (binary min-heap). */
exp type PriorityQueue<T: IOrd> = class {
    intern heap: []T

    /** Builds an empty `PriorityQueue<T>`. */
    pub static fn make(): PriorityQueue<T> { .{ heap = [] } }

    /** The number of elements currently queued. */
    pub fn len(): u64 { self.heap.len }

    /** True iff `len() == 0`. */
    pub fn is_empty(): bool { self.heap.len == 0 }

    /** Enqueues `x`, restoring the heap property upward. Duplicates are allowed. */
    pub fn enqueue(x: T) {
        var h = [..self.heap, x]
        self.heap = heap_sift_up(h)
    }

    /** The minimum element without removing it; the queue must be non-empty. */
    pub fn peek(): T { self.heap[0] }

    /** Removes and returns the minimum element, restoring the heap property downward; the queue must be non-empty. */
    pub fn dequeue(): T {
        var h = self.heap
        var m = heap_pop_min(&h)
        self.heap = h
        m
    }
}
