/** A growable, reference-semantic sequence of `T`; `push`/`set`/`pop` mutate the receiver in place. */
exp type List<T> = class {
    intern items: []T

    /** Builds an empty `List<T>`. */
    pub static fn make(): List<T> { .{ items = [] } }

    /** The number of elements currently held. */
    pub fn len(): u64 { self.items.len }

    /** True iff `len() == 0`. */
    pub fn is_empty(): bool { self.items.len == 0 }

    /** Appends `x` to the end of the list, in place. */
    pub fn push(x: T) { self.items = [..self.items, x] }

    /** Reads the element at index `i`; `i` must be in `[0, len())`. */
    pub fn get(i: u64): T { self.items[i] }

    /** Overwrites the element at index `i` with `x`, in place; a no-op if `i >= len()`. */
    pub fn set(i: u64, x: T) { self.items = arr_replace_at(self.items, i, x) }

    /** Removes the last element, in place; a no-op on an empty list. */
    pub fn pop() { self.items = arr_drop_last(self.items) }

    /** Removes the element at index `i`, in place; a no-op if `i >= len()`. */
    pub fn remove_at(i: u64) { self.items = arr_drop_at(self.items, i) }

    /** A `[]T` snapshot of the list's current contents. */
    pub fn to_array(): []T { self.items }
}
