/** A growable, reference-semantic hash map from `str` keys to `V` values. */
exp type Map<V> = class {
    intern keys: []str
    intern hashes: []u64
    intern vals: []V

    /** Builds an empty `Map<V>`. */
    pub static fn make(): Map<V> {
        .{ keys = []; hashes = []; vals = [] }
    }

    /** The number of distinct keys currently held. */
    pub fn len(): u64 { self.keys.len }

    /** True iff `len() == 0`. */
    pub fn is_empty(): bool { self.keys.len == 0 }

    /** True iff `k` is a key in the map. */
    pub fn contains(k: str): bool {
        map_find_index(self.keys, self.hashes, teko::runtime::str_hash(k), k) < self.keys.len
    }

    /** Inserts or updates the value for `k`, in place. */
    pub fn insert(k: str, v: V) {
        var h = teko::runtime::str_hash(k)
        var at = map_find_index(self.keys, self.hashes, h, k)
        if at < self.keys.len {
            self.vals = arr_replace_at(self.vals, at, v)
            return
        }
        self.keys = [..self.keys, k]
        self.hashes = [..self.hashes, h]
        self.vals = [..self.vals, v]
    }

    /** The value associated with `k`, or `null` when `k` is absent. */
    pub fn get(k: str): V | null {
        var at = map_find_index(self.keys, self.hashes, teko::runtime::str_hash(k), k)
        if at >= self.keys.len { return null }
        self.vals[at]
    }

    /** Removes the entry for `k` if present, in place; returns whether one was removed. */
    pub fn remove(k: str): bool {
        var at = map_find_index(self.keys, self.hashes, teko::runtime::str_hash(k), k)
        if at >= self.keys.len { return false }
        self.keys = arr_drop_at(self.keys, at)
        self.hashes = arr_drop_at(self.hashes, at)
        self.vals = arr_drop_at(self.vals, at)
        true
    }

    /** A `[]str` snapshot of the map's current keys, in insertion order. */
    pub fn keys(): []str { self.keys }

    /** A `Dictionary<StrKey, V>` snapshot of this map's current entries. */
    pub fn to_dictionary(): Dictionary<teko::cmp::StrKey, V> {
        var out = Dictionary<teko::cmp::StrKey, V>::make()
        var i: u64 = 0
        loop {
            if i >= self.keys.len { break }
            out.insert(teko::cmp::StrKey { key = self.keys[i] }, self.vals[i])
            i++
        }
        out
    }
}

fn map_find_index(keys: []str, hashes: []u64, h: u64, k: str): u64 {
    var i: u64 = 0
    loop {
        if i >= keys.len { break }
        if hashes[i] == h && keys[i] == k { return i }
        i++
    }
    keys.len
}
