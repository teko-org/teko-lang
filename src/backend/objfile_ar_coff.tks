fn emit_u16_le_lib(buf: []byte, v: u32): []byte {
    [
        ..buf, (v & AR_BYTE_MASK) to byte, ((v >> (8 to u32)) & AR_BYTE_MASK) to byte
    ]
}

const COFF_LIB_LONGNAME_TERMINATOR: byte = 0 to byte

type CoffLibLongnames = struct {
    bytes: []byte
    name_fields: []str
}

const AR_INLINE_NAME_MAX: u64 = 15

fn coff_inline_name_field(nm: str): str {
    match ar_member_name_field(nm) {
        str as s => s
        error => ""
    }
}

fn coff_lib_longnames(names: []str): CoffLibLongnames {
    var bytes: []byte = []
    var fields: [names.len]str = []
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        var nm = names[i]
        if nm.len <= AR_INLINE_NAME_MAX {
            fields[i] = coff_inline_name_field(nm)
        } else {
            var off = bytes.len
            fields[i] = ar_pad_right(teko::str::concat("/", $"{off}"), AR_NAME_WIDTH)
            bytes = emit_str_bytes(bytes, nm)
            bytes = [..bytes, COFF_LIB_LONGNAME_TERMINATOR]
        }
        i++
    }
    CoffLibLongnames { bytes = bytes; name_fields = fields }
}

fn coff_lib_symbol_before(a: ArSymbol, b: ArSymbol): bool {
    teko::runtime::str_compare(a.name, b.name) < (0)
}

fn coff_lib_sorted_symbols(symbols: []ArSymbol): []ArSymbol {
    var out: []ArSymbol = []
    var i: u64 = 0
    loop {
        if i >= symbols.len { break }
        var v = symbols[i]
        var ins: []ArSymbol = []
        var placed: bool = false
        var j: u64 = 0
        loop {
            if j >= out.len { break }
            var o = out[j]
            if !placed && coff_lib_symbol_before(v, o) {
                ins = [..ins, v]
                placed = true
            }
            ins = [..ins, o]
            j++
        }
        if !placed { ins = [..ins, v] }
        out = ins
        i++
    }
    out
}

fn coff_lib_second_payload_size(num_members: u64, sorted: []ArSymbol): u32 {
    var total: u32 = (4 to u32) + (num_members to u32) * (4 to u32) + (4 to u32) + (sorted.len to u32) * (2 to u32)
    var i: u64 = 0
    loop {
        if i >= sorted.len { break }
        total = total + (sorted[i].name.len to u32) + (1 to u32)
        i++
    }
    total
}

fn coff_lib_second_payload(member_offsets: []u32, sorted: []ArSymbol): []byte {
    var b: []byte = emit_u32_le([], member_offsets.len to u32)
    var i: u64 = 0
    loop {
        if i >= member_offsets.len { break }
        b = emit_u32_le(b, member_offsets[i])
        i++
    }
    b = emit_u32_le(b, sorted.len to u32)
    i = 0
    loop {
        if i >= sorted.len { break }
        b = emit_u16_le_lib(b, (sorted[i].member + (1 to u64)) to u32)
        i++
    }
    i = 0
    loop {
        if i >= sorted.len { break }
        b = emit_str_bytes(b, sorted[i].name)
        b = [..b, 0 to byte]
        i++
    }
    b
}

fn coff_lib_member_total_len(payload_size: u32): u32 {
    AR_HEADER_SIZE + payload_size + ar_even_pad_len(payload_size)
}

pub fn emit_coff_lib_archive(members: []ArMember, symbols: []ArSymbol): []byte {
    var names: [members.len]str = []
    var i: u64 = 0
    loop {
        if i >= members.len { break }
        names[i] = members[i].name
        i++
    }
    var longnames = coff_lib_longnames(names)
    var has_longnames = longnames.bytes.len > (0 to u64)
    var sorted = coff_lib_sorted_symbols(symbols)
    var payload1_size = ar_symtab_data_size(symbols)
    var payload1_total = coff_lib_member_total_len(payload1_size)
    var payload2_size = coff_lib_second_payload_size(members.len, sorted)
    var payload2_total = coff_lib_member_total_len(payload2_size)
    var longnames_size = longnames.bytes.len to u32
    var longnames_total = if has_longnames { coff_lib_member_total_len(longnames_size) } else { 0 to u32 }
    var first_real_offset = (AR_GLOBAL_HEADER.len to u32) + payload1_total + payload2_total + longnames_total
    var member_offsets = ar_member_offsets(first_real_offset, members)
    var payload1 = build_ar_symtab_data(symbols, member_offsets)
    var payload2 = coff_lib_second_payload(member_offsets, sorted)
    var b: []byte = []
    b = append_bytes(b, AR_GLOBAL_HEADER)
    b = emit_ar_member(b, ar_pad_right(AR_SYMTAB_NAME, AR_NAME_WIDTH), payload1, AR_MODE_SPECIAL)
    b = emit_ar_member(b, ar_pad_right(AR_SYMTAB_NAME, AR_NAME_WIDTH), payload2, AR_MODE_SPECIAL)
    if has_longnames { b = emit_ar_member(b, ar_pad_right("//", AR_NAME_WIDTH), longnames.bytes, AR_MODE_SPECIAL) }
    i = 0
    loop {
        if i >= members.len { break }
        b = emit_ar_member(b, longnames.name_fields[i], members[i].data, AR_MODE_REGULAR)
        i++
    }
    b
}

pub fn emit_static_archive_coff(obj_name: str, obj_bytes: []byte, symbols: []Symbol): []byte {
    var member = ArMember { name = obj_name; data = obj_bytes }
    var names = global_symbol_names(symbols)
    var ar_symbols: [names.len]ArSymbol = []
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        ar_symbols[i] = ArSymbol { name = names[i]; member = 0 to u64 }
        i++
    }
    emit_coff_lib_archive([member], ar_symbols)
}
