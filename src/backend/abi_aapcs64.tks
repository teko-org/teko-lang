pub type AbiDescriptor = struct {
    gpr_arg: []u32
    fpr_arg: []u32
    gpr_allocatable: []u32
    fpr_allocatable: []u32
    gpr_caller_saved: []u32
    fpr_caller_saved: []u32
    gpr_spill_scratch: []u32
    fpr_spill_scratch: []u32
    spill_slot_bytes: u32
    spill_slot_align: u32
    shadow_space: u32
    max_reg_arg_bytes: u32
    arg_slots_shared: bool
}

pub type ArgReg = struct {
    ok: bool
    reg: MReg
}

fn push_range(xs: []u32, lo: u32, hi: u32): []u32 {
    var buf: [hi - lo + 1]u32 = []
    var j: u32 = 0
    loop {
        if j > hi - lo { break }
        buf[j] = lo + j
        j++
    }
    [..xs, ..buf]
}

fn contains_u32(xs: []u32, target: u32): bool {
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == target { return true }
        i++
    }
    false
}

pub const AAPCS64: AbiDescriptor = AbiDescriptor {
    gpr_arg = [0 to u32, 1 to u32, 2 to u32, 3 to u32, 4 to u32, 5 to u32, 6 to u32, 7 to u32]
    fpr_arg = [0 to u32, 1 to u32, 2 to u32, 3 to u32, 4 to u32, 5 to u32, 6 to u32, 7 to u32]
    gpr_allocatable = [0 to u32, 1 to u32, 2 to u32, 3 to u32, 4 to u32, 5 to u32, 6 to u32, 7 to u32, 8 to u32, 9 to u32, 10 to u32, 11 to u32, 12 to u32, 13 to u32, 14 to u32, 19 to u32, 20 to u32, 21 to u32, 22 to u32, 23 to u32, 24 to u32, 25 to u32, 26 to u32, 27 to u32, 28 to u32]
    fpr_allocatable = [0 to u32, 1 to u32, 2 to u32, 3 to u32, 4 to u32, 5 to u32, 6 to u32, 7 to u32, 16 to u32, 17 to u32, 18 to u32, 19 to u32, 20 to u32, 21 to u32, 22 to u32, 23 to u32, 24 to u32, 25 to u32, 26 to u32, 27 to u32, 28 to u32, 29 to u32, 8 to u32, 9 to u32, 10 to u32, 11 to u32, 12 to u32, 13 to u32, 14 to u32, 15 to u32]
    gpr_caller_saved = [0 to u32, 1 to u32, 2 to u32, 3 to u32, 4 to u32, 5 to u32, 6 to u32, 7 to u32, 8 to u32, 9 to u32, 10 to u32, 11 to u32, 12 to u32, 13 to u32, 14 to u32, 15 to u32, 16 to u32, 17 to u32, 18 to u32]
    fpr_caller_saved = [0 to u32, 1 to u32, 2 to u32, 3 to u32, 4 to u32, 5 to u32, 6 to u32, 7 to u32, 16 to u32, 17 to u32, 18 to u32, 19 to u32, 20 to u32, 21 to u32, 22 to u32, 23 to u32, 24 to u32, 25 to u32, 26 to u32, 27 to u32, 28 to u32, 29 to u32, 30 to u32, 31 to u32]
    gpr_spill_scratch = [15 to u32, 16 to u32, 17 to u32]
    fpr_spill_scratch = [30 to u32, 31 to u32]
    spill_slot_bytes = 8 to u32
    spill_slot_align = 8 to u32
    shadow_space = 0 to u32
    max_reg_arg_bytes = 16 to u32
    arg_slots_shared = false
}

pub fn arg_reg(abi: AbiDescriptor, reg_class: MRegClass, index: u32): ArgReg {
    var regs = if reg_class == MRegClass::FPR { abi.fpr_arg } else { abi.gpr_arg }
    if index >= regs.len {
        return ArgReg { ok = false; reg = preg(0, reg_class) }
    }
    ArgReg { ok = true; reg = preg(regs[index to u64], reg_class) }
}

pub fn allocatable_pool(abi: AbiDescriptor, reg_class: MRegClass): []u32 {
    if reg_class == MRegClass::FPR { abi.fpr_allocatable } else { abi.gpr_allocatable }
}

pub fn is_caller_saved(abi: AbiDescriptor, r: MReg): bool {
    var saved = if r.reg_class == MRegClass::FPR { abi.fpr_caller_saved } else { abi.gpr_caller_saved }
    contains_u32(saved, r.id)
}

pub fn is_callee_saved(abi: AbiDescriptor, r: MReg): bool {
    if !contains_u32(allocatable_pool(abi, r.reg_class), r.id) {
        return false
    }
    !is_caller_saved(abi, r)
}

pub fn spill_scratch(abi: AbiDescriptor, reg_class: MRegClass, nth: u32): MReg {
    var scratch = if reg_class == MRegClass::FPR { abi.fpr_spill_scratch } else { abi.gpr_spill_scratch }
    preg(scratch[nth to u64], reg_class)
}
