pub type EncReloc = struct {
    sym: str
    kind: MRelocKind
}

pub type EncWord = struct {
    word: u32
    has_branch: bool
    target: u32
    branch_form: u32
    reloc: EncReloc | null
}

pub type FrameLayout = struct {
    size: u32
    saved_gpr: []u32
    saved_fpr: []u32
    slot_offsets: []u32
    out_arg_base: u32
}

type MemForm = struct {
    base_bits: u32
    scale: u32
}

fn plain_word(w: u32): EncWord {
    EncWord {
        word = w
        has_branch = false
        target = 0 to u32
        branch_form = 0 to u32
        reloc = null
    }
}

fn branch_word(w: u32, target: u32, form: u32): EncWord {
    EncWord {
        word = w
        has_branch = true
        target = target
        branch_form = form
        reloc = null
    }
}

fn reloc_word(w: u32, sym: str, kind: MRelocKind): EncWord {
    EncWord {
        word = w
        has_branch = false
        target = 0 to u32
        branch_form = 0 to u32
        reloc = EncReloc { sym = sym; kind = kind }
    }
}

pub fn emit_u32_le(buf: []byte, w: u32): []byte {
    [
        ..buf,
        (w & ARM64_BYTE_MASK) to byte,
        ((w >> ((1 to u32) * ARM64_BITS_PER_BYTE)) & ARM64_BYTE_MASK) to byte,
        ((w >> ((2 to u32) * ARM64_BITS_PER_BYTE)) & ARM64_BYTE_MASK) to byte,
        ((w >> ((3 to u32) * ARM64_BITS_PER_BYTE)) & ARM64_BYTE_MASK) to byte
    ]
}

fn enc_reg(r: MReg): u32 {
    r.id
}

fn enc_rd(r: MReg): u32 {
    enc_reg(r)
}

fn enc_rn(r: MReg): u32 {
    enc_reg(r) << ARM64_RN_SHIFT
}

fn enc_rm(r: MReg): u32 {
    enc_reg(r) << ARM64_RM_SHIFT
}

fn enc_ra(r: MReg): u32 {
    enc_reg(r) << ARM64_REG2_SHIFT
}

fn sf_bit(wide: bool): u32 {
    if wide { (1 to u32) << ARM64_SF_SHIFT } else { 0 to u32 }
}

fn cond_code(c: MCond): u32 {
    match c {
        EQ => ARM64_COND_EQ
        NE => ARM64_COND_NE
        LT => ARM64_COND_LT
        LE => ARM64_COND_LE
        GT => ARM64_COND_GT
        GE => ARM64_COND_GE
        LO => ARM64_COND_LO
        LS => ARM64_COND_LS
        HI => ARM64_COND_HI
        HS => ARM64_COND_HS
    }
}

fn ftype_bit(dbl: bool): u32 {
    if dbl { ARM64_FTYPE_D } else { 0 to u32 }
}

fn cross_width_bits(dbl: bool): u32 {
    sf_bit(dbl) | ftype_bit(dbl)
}

fn internal_fp(what: str): error {
    error { message = teko::str::concat("encode arm64: ", what, " has no float encoding (internal)") }
}

fn honest_bigimm(): error {
    error { message = "A4-bigimm: immediate not inline-encodable (needs the MOVZ+register-op sequence, deferred to 0.3.1)" }
}

fn honest_ldur(): error {
    error { message = "A4-ldur: unscaled / out-of-range load-store offset (needs LDUR/STUR, deferred to 0.3.1)" }
}

fn honest_bigframe(): error {
    error { message = "A4-bigframe: frame slot / prologue offset beyond the encodable field (large-frame sequence deferred to 0.3.1)" }
}

fn alu_reg_base(op: MAluOp): u32 {
    match op {
        Add => ARM64_ADD_REG
        Sub => ARM64_SUB_REG
        Mul => ARM64_MADD_REG
        Sdiv => ARM64_SDIV_REG
        Udiv => ARM64_UDIV_REG
        And => ARM64_AND_REG
        Orr => ARM64_ORR_REG
        Eor => ARM64_EOR_REG
        Lsl => ARM64_LSLV_REG
        Asr => ARM64_ASRV_REG
        Lsr => ARM64_LSRV_REG
    }
}

fn add_sub_imm_base(op: MAluOp, negative: bool): u32 | error {
    match op {
        Add => if negative { ARM64_SUB_IMM_BASE } else { ARM64_ADD_IMM_BASE }
        Sub => if negative { ARM64_ADD_IMM_BASE } else { ARM64_SUB_IMM_BASE }
        _ => honest_bigimm()
    }
}

fn ext_base(op: MExtOp): u32 {
    match op {
        Sxtb => ARM64_SXTB
        Sxth => ARM64_SXTH
        Sxtw => ARM64_SXTW
        Uxtb => ARM64_UXTB
        Uxth => ARM64_UXTH
        Uxtw => ARM64_UXTW
    }
}

fn load_form(size: MMemSize, sign: bool): MemForm {
    match size {
        B => MemForm { base_bits = if sign { ARM64_LDRSB } else { ARM64_LDRB }; scale = ARM64_SCALE_B }
        H => MemForm { base_bits = if sign { ARM64_LDRSH } else { ARM64_LDRH }; scale = ARM64_SCALE_H }
        W => MemForm { base_bits = if sign { ARM64_LDRSW } else { ARM64_LDR_W }; scale = ARM64_SCALE_W }
        X => MemForm { base_bits = ARM64_LDR_X; scale = ARM64_SCALE_X }
        S => MemForm { base_bits = ARM64_LDR_FPR32; scale = ARM64_SCALE_S }
        D => MemForm { base_bits = ARM64_LDR_FPR64; scale = ARM64_SCALE_D }
    }
}

fn store_form(size: MMemSize): MemForm {
    match size {
        B => MemForm { base_bits = ARM64_STRB; scale = ARM64_SCALE_B }
        H => MemForm { base_bits = ARM64_STRH; scale = ARM64_SCALE_H }
        W => MemForm { base_bits = ARM64_STR_W; scale = ARM64_SCALE_W }
        X => MemForm { base_bits = ARM64_STR_X; scale = ARM64_SCALE_X }
        S => MemForm { base_bits = ARM64_STR_FPR32; scale = ARM64_SCALE_S }
        D => MemForm { base_bits = ARM64_STR_FPR64; scale = ARM64_SCALE_D }
    }
}

fn scaled_offset(offset: i32, scale: u32): u32 | error {
    if offset < (0 to i32) { return honest_ldur() }
    var uoff = offset to u32
    if (uoff % scale) != (0 to u32) { return honest_ldur() }
    var imm = uoff / scale
    if imm > ARM64_IMM12_FIELD_MAX { return honest_ldur() }
    imm
}

fn encode_alu(i: MAlu): EncWord {
    plain_word(alu_reg_base(i.op) | sf_bit(i.wide) | enc_rm(i.b) | enc_rn(i.a) | enc_rd(i.dst))
}

fn encode_alu_imm(i: MAluImm): EncWord | error {
    var hi = ARM64_IMM12_MAX
    var lo = (0) - hi
    if i.imm > hi { return honest_bigimm() }
    if i.imm < lo { return honest_bigimm() }
    var neg = i.imm < (0)
    var base_word = match add_sub_imm_base(i.op, neg) { u32 as b => b; error as e => return e }
    var mag = if neg { (0) - i.imm } else { i.imm }
    var field = ((mag to u32) & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT
    plain_word(base_word | sf_bit(i.wide) | field | enc_rn(i.a) | enc_rd(i.dst))
}

fn encode_msub(i: MMSub): EncWord {
    plain_word(ARM64_MSUB_REG | sf_bit(i.wide) | enc_rm(i.b) | enc_ra(i.c) | enc_rn(i.a) | enc_rd(i.dst))
}

fn encode_neg(i: MNeg): EncWord {
    plain_word(ARM64_NEG_REG | sf_bit(i.wide) | enc_rm(i.a) | enc_rd(i.dst))
}

fn encode_mvn(i: MMvn): EncWord {
    plain_word(ARM64_MVN_REG | sf_bit(i.wide) | enc_rm(i.a) | enc_rd(i.dst))
}

fn encode_cmp(i: MCmp): EncWord {
    plain_word(ARM64_CMP_REG | sf_bit(i.wide) | enc_rm(i.b) | enc_rn(i.a))
}

fn encode_cmp_imm(i: MCmpImm): EncWord | error {
    var hi = ARM64_IMM12_MAX
    if i.imm > hi { return honest_bigimm() }
    if i.imm < (0) { return honest_bigimm() }
    var field = ((i.imm to u32) & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT
    plain_word(ARM64_CMP_IMM_BASE | sf_bit(i.wide) | field | enc_rn(i.a))
}

fn encode_cset(i: MCSet): EncWord {
    var field = ((cond_code(i.cond) ^ (1 to u32)) & ARM64_COND_MASK) << ARM64_COND_SHIFT
    plain_word(ARM64_CSET_REG | sf_bit(i.wide) | field | enc_rd(i.dst))
}

fn encode_movi(base_word: u32, wide: bool, dst: MReg, imm16: u32, shift: u32): EncWord {
    var hw = (shift / ARM64_MOVI_LANE_BITS) << ARM64_MOVI_HW_SHIFT
    var imm = (imm16 & ARM64_IMM16_MASK) << ARM64_MOVI_IMM16_SHIFT
    plain_word(base_word | sf_bit(wide) | hw | imm | enc_rd(dst))
}

fn encode_movz(i: MMovZ): EncWord {
    encode_movi(ARM64_MOVZ, i.wide, i.dst, i.imm16, i.shift)
}

fn encode_movk(i: MMovK): EncWord {
    encode_movi(ARM64_MOVK, i.wide, i.dst, i.imm16, i.shift)
}

fn encode_movn(i: MMovN): EncWord {
    encode_movi(ARM64_MOVN, i.wide, i.dst, i.imm16, i.shift)
}

fn encode_mov(i: MMov): EncWord {
    plain_word(ARM64_MOV_REG | sf_bit(i.wide) | enc_rm(i.src) | enc_rd(i.dst))
}

fn encode_ext(i: MExt): EncWord {
    plain_word(ext_base(i.op) | enc_rn(i.a) | enc_rd(i.dst))
}

fn falu_base(op: MFAluOp): u32 {
    match op {
        FAdd => ARM64_FADD
        FSub => ARM64_FSUB
        FMul => ARM64_FMUL
        FDiv => ARM64_FDIV
    }
}

fn encode_falu(i: MFAlu): EncWord {
    plain_word(falu_base(i.op) | ftype_bit(i.dbl) | enc_rm(i.b) | enc_rn(i.a) | enc_rd(i.dst))
}

fn encode_fneg(i: MFNeg): EncWord {
    plain_word(ARM64_FNEG | ftype_bit(i.dbl) | enc_rn(i.a) | enc_rd(i.dst))
}

fn encode_fcmp(i: MFCmp): EncWord {
    plain_word(ARM64_FCMP | ftype_bit(i.dbl) | enc_rm(i.b) | enc_rn(i.a))
}

fn fmov_base_bits(i: MFMov): u32 | error {
    var dst_fpr = i.dst.reg_class == MRegClass::FPR
    var src_fpr = i.src.reg_class == MRegClass::FPR
    if dst_fpr && src_fpr { return ARM64_FMOV_FPR_FPR | ftype_bit(i.dbl) }
    if dst_fpr { return ARM64_FMOV_FPR_GPR | cross_width_bits(i.dbl) }
    if src_fpr { return ARM64_FMOV_GPR_FPR | cross_width_bits(i.dbl) }
    internal_fp("an MFMov between two GPRs")
}

fn encode_fmov(i: MFMov): EncWord | error {
    var base_word = match fmov_base_bits(i) { u32 as b => b; error as e => return e }
    plain_word(base_word | enc_rn(i.src) | enc_rd(i.dst))
}

fn int_float_cvt_bits(op: MCvtOp, src_wide: bool, dst_wide: bool): u32 | error {
    match op {
        Scvtf => ARM64_SCVTF | sf_bit(src_wide) | ftype_bit(dst_wide)
        Ucvtf => ARM64_UCVTF | sf_bit(src_wide) | ftype_bit(dst_wide)
        Fcvtzs => ARM64_FCVTZS | sf_bit(dst_wide) | ftype_bit(src_wide)
        Fcvtzu => ARM64_FCVTZU | sf_bit(dst_wide) | ftype_bit(src_wide)
        Fcvt => internal_fp("an Fcvt routed through the int/float conversion form")
    }
}

fn fcvt_word(src_wide: bool, dst_wide: bool): u32 | error {
    if src_wide == dst_wide { return internal_fp("an identity FCVT (both ends the same width)") }
    if dst_wide { return ARM64_FCVT_D_S }
    ARM64_FCVT_S_D
}

fn cvt_base(i: MCvt): u32 | error {
    var is_fcvt = match i.op { Scvtf => false; Ucvtf => false; Fcvtzs => false; Fcvtzu => false; Fcvt => true }
    if is_fcvt { return fcvt_word(i.src_wide, i.dst_wide) }
    int_float_cvt_bits(i.op, i.src_wide, i.dst_wide)
}

fn encode_cvt(i: MCvt): EncWord | error {
    var base_word = match cvt_base(i) { u32 as b => b; error as e => return e }
    plain_word(base_word | enc_rn(i.a) | enc_rd(i.dst))
}

fn encode_load(i: MLoad): EncWord | error {
    var form = load_form(i.size, i.sign)
    var imm = match scaled_offset(i.mem.offset, form.scale) { u32 as v => v; error as e => return e }
    var field = (imm & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT
    plain_word(form.base_bits | field | enc_rn(i.mem.base_reg) | enc_rd(i.dst))
}

fn encode_store(i: MStore): EncWord | error {
    var form = store_form(i.size)
    var imm = match scaled_offset(i.mem.offset, form.scale) { u32 as v => v; error as e => return e }
    var field = (imm & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT
    plain_word(form.base_bits | field | enc_rn(i.mem.base_reg) | enc_rd(i.src))
}

fn encode_branch(i: MBranch): EncWord {
    branch_word(ARM64_B, i.target, 0 to u32)
}

fn encode_branch_cond(i: MBranchCond): EncWord {
    var w = ARM64_BCOND | (cond_code(i.cond) & ARM64_COND_MASK)
    branch_word(w, i.target, 1 to u32)
}

fn encode_cbz(i: MCbz): EncWord {
    var base_word = if i.zero { ARM64_CBZ } else { ARM64_CBNZ }
    var w = base_word | sf_bit(i.wide) | enc_rd(i.a)
    branch_word(w, i.target, 1 to u32)
}

fn encode_call(i: MCall): EncWord {
    reloc_word(ARM64_BL, i.sym, MRelocKind::Call)
}

fn encode_call_indirect(i: MCallIndirect): EncWord {
    plain_word(ARM64_BLR | enc_rn(i.target))
}

fn encode_adrp(i: MAdrp): EncWord {
    reloc_word(ARM64_ADRP | enc_rd(i.dst), i.sym, i.kind)
}

fn encode_add_lo(i: MAddLo): EncWord {
    reloc_word(ARM64_ADD_IMM64_BASE | enc_rn(i.a) | enc_rd(i.dst), i.sym, i.kind)
}

fn encode_ret(): EncWord {
    plain_word(ARM64_RET)
}

fn encode_syscall(i: MSyscall): EncWord {
    plain_word(ARM64_SVC0)
}

fn atomic_gpr(id: u32): MReg {
    preg(id, MRegClass::GPR)
}

fn atomic_ldaxr_word(addr: MReg, old: MReg): u32 {
    ARM64_LDAXR_W | enc_rn(addr) | enc_rd(old)
}

fn atomic_stlxr_word(status: MReg, src: MReg, addr: MReg): u32 {
    ARM64_STLXR_W | enc_rm(status) | enc_rn(addr) | enc_rd(src)
}

fn atomic_ldar_word(addr: MReg, old: MReg): u32 {
    ARM64_LDAR_W | enc_rn(addr) | enc_rd(old)
}

fn atomic_cmp_word(old: MReg, expected: MReg): u32 {
    ARM64_CMP_REG | sf_bit(false) | enc_rm(expected) | enc_rn(old)
}

fn atomic_add_word(dst: MReg, a: MReg, b: MReg): u32 {
    alu_reg_base(MAluOp::Add) | sf_bit(false) | enc_rm(b) | enc_rn(a) | enc_rd(dst)
}

fn atomic_bcond_field(disp_words: i64): u32 {
    twos_field(disp_words, ARM64_IMM19_BITS) << ARM64_BCOND_IMM19_SHIFT
}

fn atomic_bne_word(disp_words: i64): u32 {
    (ARM64_BCOND | (ARM64_COND_NE & ARM64_COND_MASK)) | atomic_bcond_field(disp_words)
}

fn atomic_cbnz_word(status: MReg, disp_words: i64): u32 {
    (ARM64_CBNZ | sf_bit(false) | enc_rd(status)) | atomic_bcond_field(disp_words)
}

fn atomic_cas_words(addr: MReg, old: MReg, expected: MReg, desired: MReg, status: MReg): []u32 {
    [
        atomic_ldaxr_word(addr, old),
        atomic_cmp_word(old, expected),
        atomic_bne_word(3),
        atomic_stlxr_word(status, desired, addr),
        atomic_cbnz_word(status, (0) - 4)
    ]
}

fn atomic_xchg_words(addr: MReg, old: MReg, value: MReg, status: MReg): []u32 {
    [
        atomic_ldaxr_word(addr, old),
        atomic_stlxr_word(status, value, addr),
        atomic_cbnz_word(status, (0) - 2)
    ]
}

fn atomic_add_words(addr: MReg, old: MReg, delta: MReg, temp: MReg, status: MReg): []u32 {
    [
        atomic_ldaxr_word(addr, old),
        atomic_add_word(temp, old, delta),
        atomic_stlxr_word(status, temp, addr),
        atomic_cbnz_word(status, (0) - 3)
    ]
}

fn atomic_words(kind: lir::LAtomicKind): []u32 {
    var addr = atomic_gpr(3 to u32)
    var old = atomic_gpr(0 to u32)
    var a_reg = atomic_gpr(1 to u32)
    var b_reg = atomic_gpr(2 to u32)
    var status = atomic_gpr(4 to u32)
    var temp = atomic_gpr(5 to u32)
    match kind {
        Cas => atomic_cas_words(addr, old, a_reg, b_reg, status)
        Xchg => atomic_xchg_words(addr, old, b_reg, status)
        Add => atomic_add_words(addr, old, b_reg, temp, status)
        Load => [atomic_ldar_word(addr, old)]
    }
}

type Saved = struct {
    gpr: []u32
    fpr: []u32
}

type SlotLayout = struct {
    offsets: []u32
    slots_size: u32
}

fn align_up(x: u32, a: u32): u32 {
    if a <= 1 { return x }
    (((x + a) - (1 to u32)) / a) * a
}

fn insert_sorted_unique(xs: []u32, v: u32): []u32 {
    var out: []u32 = []
    var inserted = false
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        var cur = xs[i]
        if cur == v { return xs }
        if !inserted {
            if v < cur {
                out = [..out, v]
                inserted = true
            }
        }
        out = [..out, cur]
        i++
    }
    if !inserted { out = [..out, v] }
    out
}

fn consider_reg(abi: AbiDescriptor, acc: Saved, r: MReg): Saved {
    if !is_callee_saved(abi, r) { return acc }
    if r.reg_class == MRegClass::FPR {
        return Saved { gpr = acc.gpr; fpr = insert_sorted_unique(acc.fpr, r.id) }
    }
    Saved { gpr = insert_sorted_unique(acc.gpr, r.id); fpr = acc.fpr }
}

fn scan_inst_saved(abi: AbiDescriptor, acc0: Saved, inst: @MInst()): Saved {
    var ir = inst_regs(inst)
    var acc = acc0
    if ir.has_def {
        acc = consider_reg(abi, acc, ir.def_reg)
    }
    var i: u64 = 0
    loop {
        if i >= ir.uses.len { break }
        acc = consider_reg(abi, acc, ir.uses[i])
        i++
    }
    acc
}

fn scan_block_saved(abi: AbiDescriptor, acc0: Saved, b: MBlock): Saved {
    var acc = acc0
    var it = b.insts.iter()
    loop {
        match it.next() {
            MInstNode as n => { acc = scan_inst_saved(abi, acc, n.op) }
            null => break
        }
    }
    acc
}

fn collect_callee_saved(abi: AbiDescriptor, f: MFunc): Saved {
    var acc = Saved { gpr = []; fpr = [] }
    var it = f.blocks.iter()
    loop {
        match it.next() {
            MBlock as b => { acc = scan_block_saved(abi, acc, b) }
            null => break
        }
    }
    acc
}

fn compute_slot_offsets(frame: []lir::LAlloca): SlotLayout {
    var offsets: [frame.len]u32 = []
    var running: u32 = 0
    var i: u64 = 0
    loop {
        if i >= frame.len { break }
        var la = frame[i]
        var at = align_up(running, la.align)
        offsets[i] = at
        running = at + la.bytes
        i++
    }
    SlotLayout { offsets = offsets; slots_size = align_up(running, ARM64_STACK_ALIGN) }
}

fn inst_is_call(inst: @MInst()): bool {
    inst_regs(inst).is_call
}

fn inst_is_ret(inst: @MInst()): bool {
    match inst {
        MRet => true
        _ => false
    }
}

fn block_any_call(b: MBlock): bool {
    var it = b.insts.iter()
    loop {
        match it.next() {
            MInstNode as n => { if inst_is_call(n.op) { return true } }
            null => break
        }
    }
    false
}

fn block_any_ret(b: MBlock): bool {
    var it = b.insts.iter()
    loop {
        match it.next() {
            MInstNode as n => { if inst_is_ret(n.op) { return true } }
            null => break
        }
    }
    false
}

fn func_any_call(f: MFunc): bool {
    var it = f.blocks.iter()
    loop {
        match it.next() {
            MBlock as b => { if block_any_call(b) { return true } }
            null => break
        }
    }
    false
}

fn func_any_ret(f: MFunc): bool {
    var it = f.blocks.iter()
    loop {
        match it.next() {
            MBlock as b => { if block_any_ret(b) { return true } }
            null => break
        }
    }
    false
}

fn needs_lr_save(f: MFunc): bool {
    func_any_call(f) && func_any_ret(f)
}

fn frame_total_size(slots_size: u32, saved: Saved, lr_save: bool): u32 {
    var n_saved = (saved.gpr.len + saved.fpr.len) to u32
    var framed = (slots_size > (0 to u32)) || (n_saved > (0 to u32)) || lr_save
    if !framed { return 0 to u32 }
    align_up(slots_size + (n_saved * ARM64_REG_BYTES) + ARM64_FP_LR_BYTES, ARM64_STACK_ALIGN)
}

fn out_arg_slots_of_inst(i: @MInst()): u32 {
    match i {
        MOutArg as x => x.index + (1 to u32)
        _ => 0 to u32
    }
}

fn max_out_arg_slots_of_block(b: MBlock): u32 {
    var max: u32 = 0
    var it = b.insts.iter()
    loop {
        match it.next() {
            MInstNode as n => {
                var slots = out_arg_slots_of_inst(n.op)
                if slots > max { max = slots }
            }
            null => break
        }
    }
    max
}

fn max_out_arg_slots(f: MFunc): u32 {
    var max: u32 = 0
    var it = f.blocks.iter()
    loop {
        match it.next() {
            MBlock as b => {
                var b_max = max_out_arg_slots_of_block(b)
                if b_max > max { max = b_max }
            }
            null => break
        }
    }
    max
}

fn out_arg_bytes(f: MFunc): u32 {
    var slots = max_out_arg_slots(f)
    if slots == (0 to u32) { return 0 to u32 }
    align_up(slots * ARM64_REG_BYTES, ARM64_STACK_ALIGN)
}

fn shift_slot_offsets(offsets: []u32, delta: u32): []u32 {
    if delta == (0 to u32) { return offsets }
    var result: [offsets.len]u32 = []
    var i: u64 = 0
    loop {
        if i >= offsets.len { break }
        result[i] = offsets[i] + delta
        i++
    }
    result
}

pub fn compute_frame_layout(abi: AbiDescriptor, f: MFunc): FrameLayout {
    var saved = collect_callee_saved(abi, f)
    var slots = compute_slot_offsets(f.frame)
    var out_bytes = out_arg_bytes(f)
    var effective_slots_size = slots.slots_size + out_bytes
    var size = frame_total_size(effective_slots_size, saved, needs_lr_save(f))
    var shifted_offsets = shift_slot_offsets(slots.offsets, out_bytes)
    FrameLayout {
        size = size
        saved_gpr = saved.gpr
        saved_fpr = saved.fpr
        slot_offsets = shifted_offsets
        out_arg_base = 0
    }
}

pub fn slot_offset(layout: FrameLayout, slot: u64): u32 {
    layout.slot_offsets[slot]
}

fn sub_sp_imm_word(imm12: u32): u32 {
    ARM64_SUB_IMM64_BASE | ((imm12 & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT) | (ARM64_SP_ID << ARM64_RN_SHIFT) | ARM64_SP_ID
}

fn add_sp_imm_word(dst_id: u32, imm12: u32): u32 {
    ARM64_ADD_IMM64_BASE | ((imm12 & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT) | (ARM64_SP_ID << ARM64_RN_SHIFT) | dst_id
}

fn add_reg_imm_word(rn_id: u32, rd_id: u32, imm12: u32): u32 {
    ARM64_ADD_IMM64_BASE | ((imm12 & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT) | (rn_id << ARM64_RN_SHIFT) | rd_id
}

fn add_reg_imm_shifted_word(rn_id: u32, rd_id: u32, imm12: u32): u32 {
    ARM64_ADD_IMM64_BASE | ARM64_ADD_SUB_SH_BIT | ((imm12 & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT) | (rn_id << ARM64_RN_SHIFT) | rd_id
}

fn sub_reg_imm_word(rn_id: u32, rd_id: u32, imm12: u32): u32 {
    ARM64_SUB_IMM64_BASE | ((imm12 & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT) | (rn_id << ARM64_RN_SHIFT) | rd_id
}

fn sub_reg_imm_shifted_word(rn_id: u32, rd_id: u32, imm12: u32): u32 {
    ARM64_SUB_IMM64_BASE | ARM64_ADD_SUB_SH_BIT | ((imm12 & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT) | (rn_id << ARM64_RN_SHIFT) | rd_id
}

fn big_offset_words(rn_id: u32, rd_id: u32, off: u32, is_sub: bool): []u32 | error {
    if off > ARM64_IMM24_FIELD_MAX { return honest_bigframe() }
    var hi = off >> ARM64_IMM12_SPLIT_SHIFT
    var lo = off & ARM64_IMM12_MASK
    var is_hi = hi > 0
    var is_lo = (lo > 0) || !is_hi
    var cur_rn = rn_id
    var words: []u32 = []
    if is_hi {
        var w = if is_sub { sub_reg_imm_shifted_word(rn_id, rd_id, hi) } else { add_reg_imm_shifted_word(rn_id, rd_id, hi) }
        words = [w]
        cur_rn = rd_id
    }
    if is_lo {
        var w = if is_sub { sub_reg_imm_word(cur_rn, rd_id, lo) } else { add_reg_imm_word(cur_rn, rd_id, lo) }
        words = [..words, w]
    }
    words
}

fn stp_gpr(ra: u32, rb: u32, imm7: u32): u32 {
    ARM64_STP_GPR64 | ((imm7 & ARM64_IMM7_MASK) << ARM64_IMM7_SHIFT) | (rb << ARM64_REG2_SHIFT) | (ARM64_SP_ID << ARM64_RN_SHIFT) | ra
}

fn ldp_gpr(ra: u32, rb: u32, imm7: u32): u32 {
    ARM64_LDP_GPR64 | ((imm7 & ARM64_IMM7_MASK) << ARM64_IMM7_SHIFT) | (rb << ARM64_REG2_SHIFT) | (ARM64_SP_ID << ARM64_RN_SHIFT) | ra
}

fn str_gpr_sp(ra: u32, imm12: u32): u32 {
    ARM64_STR_X | ((imm12 & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT) | (ARM64_SP_ID << ARM64_RN_SHIFT) | ra
}

fn ldr_gpr_sp(ra: u32, imm12: u32): u32 {
    ARM64_LDR_X | ((imm12 & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT) | (ARM64_SP_ID << ARM64_RN_SHIFT) | ra
}

fn stp_fpr(ra: u32, rb: u32, imm7: u32): u32 {
    ARM64_STP_FPR64 | ((imm7 & ARM64_IMM7_MASK) << ARM64_IMM7_SHIFT) | (rb << ARM64_REG2_SHIFT) | (ARM64_SP_ID << ARM64_RN_SHIFT) | ra
}

fn ldp_fpr(ra: u32, rb: u32, imm7: u32): u32 {
    ARM64_LDP_FPR64 | ((imm7 & ARM64_IMM7_MASK) << ARM64_IMM7_SHIFT) | (rb << ARM64_REG2_SHIFT) | (ARM64_SP_ID << ARM64_RN_SHIFT) | ra
}

fn str_fpr_sp(ra: u32, imm12: u32): u32 {
    ARM64_STR_FPR64 | ((imm12 & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT) | (ARM64_SP_ID << ARM64_RN_SHIFT) | ra
}

fn ldr_fpr_sp(ra: u32, imm12: u32): u32 {
    ARM64_LDR_FPR64 | ((imm12 & ARM64_IMM12_MASK) << ARM64_IMM12_SHIFT) | (ARM64_SP_ID << ARM64_RN_SHIFT) | ra
}

fn pair_frame_word(ra: u32, rb: u32, imm7: u32, is_fpr: bool, is_store: bool): u32 {
    if is_store {
        if is_fpr { return stp_fpr(ra, rb, imm7) }
        return stp_gpr(ra, rb, imm7)
    }
    if is_fpr { return ldp_fpr(ra, rb, imm7) }
    ldp_gpr(ra, rb, imm7)
}

fn single_frame_word(ra: u32, imm12: u32, is_fpr: bool, is_store: bool): u32 {
    if is_store {
        if is_fpr { return str_fpr_sp(ra, imm12) }
        return str_gpr_sp(ra, imm12)
    }
    if is_fpr { return ldr_fpr_sp(ra, imm12) }
    ldr_gpr_sp(ra, imm12)
}

fn emit_frame_mem(words0: []u32, ids: []u32, frame_off: u32, is_fpr: bool, is_store: bool): []u32 {
    var words: [ids.len]u32 = []
    var i: u64 = 0
    var k: u64 = 0
    loop {
        if i >= ids.len { break }
        var off = frame_off + ((i to u32) * ARM64_REG_BYTES)
        var has_pair = (i + 1) < ids.len
        if has_pair {
            words[k] = pair_frame_word(ids[i], ids[i + 1], off / ARM64_REG_BYTES, is_fpr, is_store)
            i = i + 2
        } else {
            words[k] = single_frame_word(ids[i], off / ARM64_REG_BYTES, is_fpr, is_store)
            i = i + 1
        }
        k++
    }
    [..words0, ..words]
}

fn callee_base_offset(layout: FrameLayout): u32 {
    var n = (layout.saved_gpr.len + layout.saved_fpr.len) to u32
    (layout.size - ARM64_FP_LR_BYTES) - (n * ARM64_REG_BYTES)
}

fn emit_callee_area(words0: []u32, layout: FrameLayout, is_store: bool): []u32 {
    var frame_off = callee_base_offset(layout)
    var after_gpr = emit_frame_mem(words0, layout.saved_gpr, frame_off, false, is_store)
    var fpr_base = frame_off + ((layout.saved_gpr.len to u32) * ARM64_REG_BYTES)
    emit_frame_mem(after_gpr, layout.saved_fpr, fpr_base, true, is_store)
}

fn emit_frame_mem_single(words0: []u32, ids: []u32, frame_off: u32, is_fpr: bool, is_store: bool): []u32 {
    var words: [ids.len]u32 = []
    var i: u64 = 0
    loop {
        if i >= ids.len { break }
        var off = frame_off + ((i to u32) * ARM64_REG_BYTES)
        words[i] = single_frame_word(ids[i], off / ARM64_REG_BYTES, is_fpr, is_store)
        i++
    }
    [..words0, ..words]
}

fn emit_callee_area_single(words0: []u32, layout: FrameLayout, is_store: bool): []u32 {
    var frame_off = callee_base_offset(layout)
    var after_gpr = emit_frame_mem_single(words0, layout.saved_gpr, frame_off, false, is_store)
    var fpr_base = frame_off + ((layout.saved_gpr.len to u32) * ARM64_REG_BYTES)
    emit_frame_mem_single(after_gpr, layout.saved_fpr, fpr_base, true, is_store)
}

fn frame_fits(layout: FrameLayout): bool {
    ((layout.size - ARM64_FP_LR_BYTES) / ARM64_REG_BYTES) <= ARM64_IMM7_MAX_POS
}

fn big_frame_fits(layout: FrameLayout): bool {
    (layout.size - ARM64_FP_LR_BYTES) <= ARM64_STR_LDR_FIELD_MAX_BYTES
}

fn emit_prologue_small(layout: FrameLayout): []u32 {
    var top = layout.size - ARM64_FP_LR_BYTES
    var words: []u32 = [
        sub_sp_imm_word(layout.size),
        stp_gpr(ARM64_FP_ID, ARM64_LR_ID, top / ARM64_REG_BYTES),
        add_sp_imm_word(ARM64_FP_ID, top)
    ]
    emit_callee_area(words, layout, true)
}

fn emit_epilogue_small(layout: FrameLayout): []u32 {
    var top = layout.size - ARM64_FP_LR_BYTES
    [
        ..emit_callee_area([], layout, false),
        ldp_gpr(ARM64_FP_ID, ARM64_LR_ID, top / ARM64_REG_BYTES),
        add_sp_imm_word(ARM64_SP_ID, layout.size)
    ]
}

fn emit_prologue_big(layout: FrameLayout): []u32 | error {
    if !big_frame_fits(layout) { return honest_bigframe() }
    var size = layout.size
    var top = size - ARM64_FP_LR_BYTES
    var sub_words = match big_offset_words(ARM64_SP_ID, ARM64_SP_ID, size, true) { []u32 as w => w; error as e => return e }
    var fp_words = match big_offset_words(ARM64_SP_ID, ARM64_FP_ID, top, false) { []u32 as w => w; error as e => return e }
    var words = [
        ..sub_words,
        str_gpr_sp(ARM64_FP_ID, top / ARM64_REG_BYTES),
        str_gpr_sp(ARM64_LR_ID, (top + ARM64_REG_BYTES) / ARM64_REG_BYTES),
        ..fp_words
    ]
    emit_callee_area_single(words, layout, true)
}

fn emit_epilogue_big(layout: FrameLayout): []u32 | error {
    if !big_frame_fits(layout) { return honest_bigframe() }
    var size = layout.size
    var add_words = match big_offset_words(ARM64_SP_ID, ARM64_SP_ID, size, false) { []u32 as w => w; error as e => return e }
    var top = size - ARM64_FP_LR_BYTES
    var words = [
        ..emit_callee_area_single([], layout, false),
        ldr_gpr_sp(ARM64_FP_ID, top / ARM64_REG_BYTES),
        ldr_gpr_sp(ARM64_LR_ID, (top + ARM64_REG_BYTES) / ARM64_REG_BYTES),
        ..add_words
    ]
}

pub fn emit_prologue(layout: FrameLayout): []u32 | error {
    if layout.size == (0 to u32) {
        var none: []u32 = []
        return none
    }
    if frame_fits(layout) { return emit_prologue_small(layout) }
    emit_prologue_big(layout)
}

pub fn emit_epilogue(layout: FrameLayout): []u32 | error {
    if layout.size == (0 to u32) {
        var none: []u32 = []
        return none
    }
    if frame_fits(layout) { return emit_epilogue_small(layout) }
    emit_epilogue_big(layout)
}

fn encode_fspill(layout: FrameLayout, i: MFSpill): EncWord | error {
    var mem = MMem { base_reg = preg(ARM64_SP_ID, MRegClass::GPR); offset = slot_offset(layout, i.slot) to i32 }
    if i.is_load { return encode_load(MLoad { size = MMemSize::D; sign = false; dst = i.reg; mem = mem }) }
    encode_store(MStore { size = MMemSize::D; src = i.reg; mem = mem })
}

fn encode_frame_addr(layout: FrameLayout, i: MFrameAddr): EncWord | error {
    var off = slot_offset(layout, i.slot)
    if off > ARM64_IMM12_FIELD_MAX { return honest_bigframe() }
    plain_word(add_sp_imm_word(enc_reg(i.dst), off))
}

fn encode_out_arg(i: MOutArg): EncWord | error {
    var mem = MMem { base_reg = preg(ARM64_SP_ID, MRegClass::GPR); offset = (i.index * ARM64_REG_BYTES) to i32 }
    encode_store(MStore { size = i.size; src = i.src; mem = mem })
}

fn encode_in_arg(layout: FrameLayout, i: MInArg): EncWord | error {
    var mem = MMem { base_reg = preg(ARM64_SP_ID, MRegClass::GPR); offset = (layout.size + i.index * ARM64_REG_BYTES) to i32 }
    encode_load(MLoad { size = i.size; sign = false; dst = i.dst; mem = mem })
}

pub fn encode_inst_word(layout: FrameLayout, inst: @MInst()): EncWord | error {
    match inst {
        MAlu as x => encode_alu(x)
        MAluImm as x => encode_alu_imm(x)
        MMSub as x => encode_msub(x)
        MNeg as x => encode_neg(x)
        MMvn as x => encode_mvn(x)
        MFAlu as x => encode_falu(x)
        MFNeg as x => encode_fneg(x)
        MCmp as x => encode_cmp(x)
        MCmpImm as x => encode_cmp_imm(x)
        MFCmp as x => encode_fcmp(x)
        MCSet as x => encode_cset(x)
        MMovZ as x => encode_movz(x)
        MMovK as x => encode_movk(x)
        MMovN as x => encode_movn(x)
        MFMov as x => encode_fmov(x)
        MMov as x => encode_mov(x)
        MExt as x => encode_ext(x)
        MCvt as x => encode_cvt(x)
        MLoad as x => encode_load(x)
        MStore as x => encode_store(x)
        MFSpill as x => encode_fspill(layout, x)
        MFrameAddr as x => encode_frame_addr(layout, x)
        MAdrp as x => encode_adrp(x)
        MAddLo as x => encode_add_lo(x)
        MBranch as x => encode_branch(x)
        MBranchCond as x => encode_branch_cond(x)
        MCbz as x => encode_cbz(x)
        MCall as x => encode_call(x)
        MCallIndirect as x => encode_call_indirect(x)
        MSyscall as x => encode_syscall(x)
        MAtomic => internal_atomic_word()
        MRet => encode_ret()
        MOutArg as x => encode_out_arg(x)
        MInArg as x => encode_in_arg(layout, x)
    }
}

pub type Reloc = struct {
    offset: u32
    sym: str
    kind: MRelocKind
    sect: RelocSect
}

pub type EncodedFunc = struct {
    symbol: str
    words: []u32
    relocs: []Reloc
}

type BlockOffset = struct {
    id: u32
    word: u32
}

fn honest_farbranch(): error {
    error { message = "A4-farbranch: branch displacement out of the imm26/imm19 field range (internal invariant — real functions are tiny)" }
}

fn honest_badblock(): error {
    error { message = "A4-badblock: branch target block id not found in the function (internal invariant)" }
}

fn imm26_fits(disp_words: i64): bool {
    (disp_words >= ((0) - ARM64_IMM26_MIN_MAGNITUDE)) && (disp_words <= ARM64_IMM26_MAX)
}

fn imm19_fits(disp_words: i64): bool {
    (disp_words >= ((0) - ARM64_IMM19_MIN_MAGNITUDE)) && (disp_words <= ARM64_IMM19_MAX)
}

fn twos_field(disp_words: i64, bits: u32): u32 {
    var modulus = (1 to u32) << bits
    var mask = modulus - (1 to u32)
    if disp_words >= (0) {
        return (disp_words to u32) & mask
    }
    var mag = ((0) - disp_words) to u32
    (modulus - mag) & mask
}

fn branch_disp_field(disp_words: i64, form: u32): u32 | error {
    if form == (0 to u32) {
        if !imm26_fits(disp_words) { return honest_farbranch() }
        return twos_field(disp_words, ARM64_IMM26_BITS)
    }
    if !imm19_fits(disp_words) { return honest_farbranch() }
    twos_field(disp_words, ARM64_IMM19_BITS) << ARM64_BCOND_IMM19_SHIFT
}

fn lookup_block_offset(offsets: []BlockOffset, id: u32): u32 | error {
    var i: u64 = 0
    loop {
        if i >= offsets.len { break }
        var bo = offsets[i]
        if bo.id == id { return bo.word }
        i++
    }
    honest_badblock()
}

fn wrap_plain_words(acc0: []EncWord, ws: []u32): []EncWord {
    var acc: [ws.len]EncWord = []
    var i: u64 = 0
    loop {
        if i >= ws.len { break }
        acc[i] = plain_word(ws[i])
        i++
    }
    [..acc0, ..acc]
}

fn inst_is_frame_addr(inst: @MInst()): bool {
    match inst {
        MFrameAddr => true
        _ => false
    }
}

fn as_frame_addr(inst: @MInst()): MFrameAddr {
    match inst {
        MFrameAddr as x => x
        _ => MFrameAddr { dst = preg(0 to u32, MRegClass::GPR); slot = 0 to u64 }
    }
}

fn encode_frame_addr_words(layout: FrameLayout, i: MFrameAddr): []EncWord | error {
    var off = slot_offset(layout, i.slot)
    if off <= ARM64_IMM12_FIELD_MAX {
        var ew = match encode_frame_addr(layout, i) { EncWord as x => x; error as e => return e }
        return [ew]
    }
    var raw = match big_offset_words(ARM64_SP_ID, enc_reg(i.dst), off, false) { []u32 as w => w; error as e => return e }
    wrap_plain_words([], raw)
}

fn internal_atomic_word(): error {
    error { message = "encode arm64: atomic RMW must expand to a word sequence (internal)" }
}

fn inst_is_atomic(inst: @MInst()): bool {
    match inst {
        MAtomic => true
        _ => false
    }
}

fn as_atomic_kind(inst: @MInst()): lir::LAtomicKind {
    match inst {
        MAtomic as x => x.kind
        _ => lir::LAtomicKind::Load
    }
}

fn encode_one(layout: FrameLayout, words0: []EncWord, inst: @MInst()): []EncWord | error {
    if inst_is_atomic(inst) {
        return wrap_plain_words(words0, atomic_words(as_atomic_kind(inst)))
    }
    if inst_is_ret(inst) {
        match emit_epilogue(layout) {
            []u32 as epi => {
                var after = wrap_plain_words(words0, epi)
                return [..after, encode_ret()]
            }
            error as e => return e
        }
    }
    if inst_is_frame_addr(inst) {
        var fa = as_frame_addr(inst)
        var ews = match encode_frame_addr_words(layout, fa) { []EncWord as w => w; error as e => return e }
        return [..words0, ..ews]
    }
    var ew = match encode_inst_word(layout, inst) { EncWord as x => x; error as e => return e }
    [..words0, ew]
}

fn encode_block_words(layout: FrameLayout, words0: []EncWord, blk: MBlock): []EncWord | error {
    var words = words0
    var it = blk.insts.iter()
    loop {
        match it.next() {
            MInstNode as n => {
                words = match encode_one(layout, words, n.op) { []EncWord as w => w; error as e => return e }
            }
            null => break
        }
    }
    words
}

fn resolve_word(ew: EncWord, here: u32, offsets: []BlockOffset): u32 | error {
    if !ew.has_branch { return ew.word }
    var target_off = match lookup_block_offset(offsets, ew.target) { u32 as v => v; error as e => return e }
    var disp_words = (target_off to i64) - (here to i64)
    var field = match branch_disp_field(disp_words, ew.branch_form) { u32 as v => v; error as e => return e }
    ew.word | field
}

fn collect_word_reloc(acc: []Reloc, ew: EncWord, word_index: u64): []Reloc {
    match ew.reloc {
        null => acc
        EncReloc as r => [.. acc, Reloc { offset = (word_index to u32) * ARM64_WORD_BYTES; sym = r.sym; kind = r.kind; sect = RelocSect::Text }]
    }
}

fn finalize_func(symbol: str, words: []EncWord, offsets: []BlockOffset): EncodedFunc | error {
    var out_words: [words.len]u32 = []
    var relocs: []Reloc = []
    var i: u64 = 0
    loop {
        if i >= words.len { break }
        var ew = words[i]
        var w = match resolve_word(ew, i to u32, offsets) { u32 as v => v; error as e => return e }
        out_words[i] = w
        relocs = collect_word_reloc(relocs, ew, i)
        i++
    }
    EncodedFunc { symbol = symbol; words = out_words; relocs = relocs }
}

pub fn encode_func(abi: AbiDescriptor, f: MFunc): EncodedFunc | error {
    var layout = compute_frame_layout(abi, f)
    var pro_words = match emit_prologue(layout) { []u32 as w => w; error as e => return e }
    var words: []EncWord = wrap_plain_words([], pro_words)
    var offsets: [f.blocks.len()]BlockOffset = []
    var bi: u64 = 0
    var it = f.blocks.iter()
    loop {
        match it.next() {
            MBlock as blk => {
                var off = words.len to u32
                offsets[bi] = BlockOffset { id = blk.id; word = off }
                words = match encode_block_words(layout, words, blk) { []EncWord as w => w; error as e => return e }
                bi++
            }
            null => break
        }
    }
    finalize_func(f.symbol, words, offsets)
}

pub type Symbol = struct {
    name: str
    defined: bool
    sect: u8
    offset: u32
    local: bool
}

pub type EncodedModule = struct {
    text: []byte
    rodata: []byte
    symbols: []Symbol
    relocs: []Reloc
}

fn honest_globals(): error {
    error { message = "A4-globals: __data section + GOT data relocs deferred (the N2 subset lowers no LGlobal)" }
}

fn append_words_le(buf: []byte, ws: []u32): []byte {
    var b = buf
    var i: u64 = 0
    loop {
        if i >= ws.len { break }
        b = emit_u32_le(b, ws[i])
        i++
    }
    b
}

fn rebase_relocs(acc: []Reloc, relocs: []Reloc, base_off: u32): []Reloc {
    var out: [relocs.len]Reloc = []
    var i: u64 = 0
    loop {
        if i >= relocs.len { break }
        var r = relocs[i]
        out[i] = Reloc { offset = r.offset + base_off; sym = r.sym; kind = r.kind; sect = r.sect }
        i++
    }
    [..acc, ..out]
}

pub type ModuleText = struct {
    text: []byte
    relocs: []Reloc
    syms: []Symbol
    text_off: u32
}

pub fn empty_module_text(): ModuleText {
    ModuleText { text = []; relocs = []; syms = []; text_off = 0 to u32 }
}

fn fold_func_into_text(abi: AbiDescriptor, acc: ModuleText, f: MFunc): ModuleText | error {
    var ef = match encode_func(abi, f) { EncodedFunc as x => x; error as e => return e }
    fold_encoded_func(acc, ef)
}

pub fn fold_encoded_func(acc: ModuleText, ef: EncodedFunc): ModuleText {
    var sym = Symbol { name = ef.symbol; defined = true; sect = 1 to u8; offset = acc.text_off; local = false }
    var text = append_words_le(acc.text, ef.words)
    var relocs = rebase_relocs(acc.relocs, ef.relocs, acc.text_off)
    var syms = [..acc.syms, sym]
    var text_off = acc.text_off + ((ef.words.len to u32) * ARM64_WORD_BYTES)
    ModuleText { text = text; relocs = relocs; syms = syms; text_off = text_off }
}

fn encode_functions(abi: AbiDescriptor, funcs: teko::collections::Chunked<MFunc>): ModuleText | error {
    var acc = empty_module_text()
    var it = funcs.iter()
    loop {
        match it.next() {
            MFunc as f => {
                acc = match fold_func_into_text(abi, acc, f) { ModuleText as x => x; error as e => return e }
            }
            null => break
        }
    }
    acc
}

type ModuleRodata = struct {
    bytes: []byte
    syms: []Symbol
    relocs: []lir::LDataReloc
}

const RODATA_ENTRY_ALIGN: u32 = 8

fn fold_rodata_entry_relocs(relocs: []lir::LDataReloc, entry: lir::LRodata, off: u32): []lir::LDataReloc {
    var out: [entry.relocs.len]lir::LDataReloc = []
    var j: u64 = 0
    loop {
        if j >= entry.relocs.len { break }
        out[j] = lir::data_reloc(off + entry.relocs[j].offset, entry.relocs[j].target)
        j++
    }
    [..relocs, ..out]
}

type PaddedRodata = struct {
    bytes: []byte
    off: u32
}

fn pad_rodata_entry_boundary(bytes: []byte, off: u32, entry: lir::LRodata, is_last: bool): PaddedRodata {
    var placed = [..bytes, ..entry.bytes]
    var placed_off = off + (entry.bytes.len to u32)
    if is_last { return PaddedRodata { bytes = placed; off = placed_off } }
    var aligned_off = align_up(placed_off, RODATA_ENTRY_ALIGN)
    var padded: [placed.len]byte = []
    PaddedRodata { bytes = [..placed, ..padded]; off = aligned_off }
}

fn encode_rodata(rodata: []lir::LRodata): ModuleRodata | error {
    var bytes: []byte = []
    var syms: [rodata.len]Symbol = []
    var relocs: []lir::LDataReloc = []
    var off: u32 = 0
    var i: u64 = 0
    loop {
        if i >= rodata.len { break }
        var rd = rodata[i]
        syms[i] = Symbol { name = rd.symbol; defined = true; sect = 2 to u8; offset = off; local = true }
        relocs = fold_rodata_entry_relocs(relocs, rd, off)
        var placed = pad_rodata_entry_boundary(bytes, off, rd, i + 1 >= rodata.len)
        bytes = placed.bytes
        off = placed.off
        i++
    }
    match report_rodata_align_violations(syms, relocs) { error as e => return e; null => { } }
    ModuleRodata { bytes = bytes; syms = syms; relocs = relocs }
}

type RodataAlignViolation = struct {
    owner: str
    target: str
    offset: u32
    expected: u32
}

fn rodata_owning_symbol_name(syms: []Symbol, off: u32): str {
    var best = "<unknown>"
    var i: u64 = 0
    loop {
        if i >= syms.len { break }
        if syms[i].offset <= off { best = syms[i].name }
        i++
    }
    best
}

fn find_rodata_align_violations(syms: []Symbol, relocs: []lir::LDataReloc): []RodataAlignViolation {
    var out: []RodataAlignViolation = []
    var i: u64 = 0
    loop {
        if i >= relocs.len { break }
        out = push_rodata_align_violation(out, syms, relocs[i])
        i++
    }
    out
}

fn push_rodata_align_violation(out: []RodataAlignViolation, syms: []Symbol, r: lir::LDataReloc): []RodataAlignViolation {
    if r.offset % RODATA_ENTRY_ALIGN == 0 { return out }
    [
        ..out,
        RodataAlignViolation {
            owner = rodata_owning_symbol_name(syms, r.offset)
            target = r.target
            offset = r.offset
            expected = align_up(r.offset, RODATA_ENTRY_ALIGN)
        }
    ]
}

fn rodata_align_check_enabled(): bool {
    match teko::env::var("TEKO_NATIVE_RODATA_ALIGN_CHECK") { str as v => v == "1"; error => false }
}

fn rodata_align_violation_line(v: RodataAlignViolation): str {
    $"owner={v.owner} target={v.target} offset={v.offset} expected>={v.expected}"
}

fn report_rodata_align_violation(v: RodataAlignViolation) {
    teko::io::eprintln(teko::str::concat("teko: TEKO_NATIVE_RODATA_ALIGN_CHECK: unaligned rodata pointer reloc — ", rodata_align_violation_line(v)))
}

fn report_rodata_align_violations(syms: []Symbol, relocs: []lir::LDataReloc): null | error {
    if !rodata_align_check_enabled() { return null }
    var violations = find_rodata_align_violations(syms, relocs)
    if violations.len == 0 { return null }
    var i: u64 = 0
    loop {
        if i >= violations.len { break }
        report_rodata_align_violation(violations[i])
        i++
    }
    error { message = teko::str::concat("TEKO_NATIVE_RODATA_ALIGN_CHECK: aborting — unaligned rodata pointer reloc(s); first: ", rodata_align_violation_line(violations[0])) }
}

fn name_in_symbols(syms: []Symbol, name: str): bool {
    var i: u64 = 0
    loop {
        if i >= syms.len { break }
        if syms[i].name == name { return true }
        i++
    }
    false
}

fn collect_undefined(defined: []Symbol, relocs: []Reloc): []Symbol {
    var undef: [relocs.len]Symbol = []
    var i: u64 = 0
    var j: u64 = 0
    loop {
        if i >= relocs.len { break }
        var name = relocs[i].sym
        var known = name_in_symbols(defined, name) || name_in_symbols(undef, name)
        if !known {
            undef[j] = Symbol { name = name; defined = false; sect = 0 to u8; offset = 0 to u32; local = false }
            j++
        }
        i++
    }
    teko::collections::arr_slice(undef, 0, j)
}

fn rodata_relocs_arm64(rs: []lir::LDataReloc): []Reloc {
    var out: [rs.len]Reloc = []
    var i: u64 = 0
    loop {
        if i >= rs.len { break }
        out[i] = Reloc { offset = rs[i].offset; sym = rs[i].target; kind = MRelocKind::Abs64; sect = RelocSect::Rodata }
        i++
    }
    out
}

pub fn encode_module(abi: AbiDescriptor, m: MModule): EncodedModule | error {
    if m.globals.len > (0 to u64) { return honest_globals() }
    var mt = match encode_functions(abi, m.funcs) { ModuleText as x => x; error as e => return e }
    finish_encoded_module(mt, m.rodata, m.globals)
}

pub fn finish_encoded_module(mt: ModuleText, rodata: []lir::LRodata, globals: []lir::LGlobal): EncodedModule | error {
    if globals.len > (0 to u64) { return honest_globals() }
    var rod = match encode_rodata(rodata) { ModuleRodata as x => x; error as e => return e }
    var defined = [..rod.syms, ..mt.syms]
    var undef = collect_undefined(defined, mt.relocs)
    var symbols = [..defined, ..undef]
    EncodedModule { text = mt.text; rodata = rod.bytes; symbols = symbols; relocs = [..mt.relocs, ..rodata_relocs_arm64(rod.relocs)] }
}
