fn append_bytes(a: []byte, b: []byte): []byte {
    [..a, ..b]
}

fn concat_symbols(a: []Symbol, b: []Symbol): []Symbol {
    [..a, ..b]
}

fn emit_u64_le(buf: []byte, v: u64): []byte {
    [
        ..buf,
        (v & MACHO_BYTE_MASK_64) to byte,
        ((v >> 8) & MACHO_BYTE_MASK_64) to byte,
        ((v >> 16) & MACHO_BYTE_MASK_64) to byte,
        ((v >> 24) & MACHO_BYTE_MASK_64) to byte,
        ((v >> 32) & MACHO_BYTE_MASK_64) to byte,
        ((v >> 40) & MACHO_BYTE_MASK_64) to byte,
        ((v >> 48) & MACHO_BYTE_MASK_64) to byte,
        ((v >> 56) & MACHO_BYTE_MASK_64) to byte
    ]
}

fn emit_str_bytes(buf: []byte, s: str): []byte {
    var b: [s.len]byte = []
    var i: u64 = 0
    loop {
        if i >= s.len { break }
        b[i] = s[i]
        i++
    }
    [..buf, ..b]
}

fn emit_fixed16(buf: []byte, s: str): []byte {
    var fixed: [16]byte = []
    var b = emit_str_bytes(buf, s)
    [..b, ..fixed]
}

fn emit_u8_field(buf: []byte, v: u32): []byte {
    [..buf, (v & MACHO_BYTE_MASK) to byte]
}

fn pad_to_mult(buf: []byte, k: u32): []byte {
    var padding: [(k - (buf.len % k)) % k]byte = []
    [..buf, ..padding]
}

fn pad_to_offset(buf: []byte, target: u32): []byte {
    var padding: [target - buf.len]byte = []
    [..buf, ..padding]
}

type StrTab = struct {
    bytes: []byte
    strx: []u32
}

fn build_strtab(symbols: []Symbol): StrTab {
    var bytes: []byte = [0 to byte]
    var strx: [symbols.len]u32 = []
    var i: u64 = 0
    loop {
        if i >= symbols.len { break }
        strx[i] = bytes.len to u32
        bytes = [..bytes, MACHO_SYM_UNDERSCORE to byte]
        bytes = emit_str_bytes(bytes, symbols[i].name)
        bytes = [..bytes, 0 to byte]
        i++
    }
    StrTab { bytes = bytes; strx = strx }
}

fn count_defined(symbols: []Symbol): u32 {
    var n: u32 = 0
    var i: u64 = 0
    loop {
        if i >= symbols.len { break }
        if symbols[i].defined { n = n + 1 }
        i++
    }
    n
}

fn count_local(symbols: []Symbol): u32 {
    var n: u32 = 0
    var i: u64 = 0
    loop {
        if i >= symbols.len { break }
        if symbols[i].defined && symbols[i].local { n = n + 1 }
        i++
    }
    n
}

fn sym_index(symbols: []Symbol, name: str): u32 {
    var i: u32 = 0
    loop {
        if i >= symbols.len { break }
        if symbols[i].name == name { return i }
        i++
    }
    symbols.len to u32
}

const ARM64_RELOC_UNSIGNED: u32 = 0

const ARM64_RELOC_BRANCH26: u32 = 2

const ARM64_RELOC_PAGE21: u32 = 3

const ARM64_RELOC_PAGEOFF12: u32 = 4

fn reloc_type_value(k: MRelocKind): u32 {
    match k {
        PageHi => ARM64_RELOC_PAGE21
        PageLo => ARM64_RELOC_PAGEOFF12
        Call => ARM64_RELOC_BRANCH26
        Abs64 => ARM64_RELOC_UNSIGNED
    }
}

fn reloc_pcrel(k: MRelocKind): u32 {
    match k {
        PageHi => 1
        PageLo => 0
        Call => 1
        Abs64 => 0
    }
}

fn reloc_length(k: MRelocKind): u32 {
    match k {
        Abs64 => 3
        PageHi => 2
        PageLo => 2
        Call => 2
    }
}

type MachoRelocParts = struct {
    text: []Reloc
    rodata: []Reloc
}

fn macho_partition_relocs(relocs: []Reloc): MachoRelocParts {
    var text: [relocs.len]Reloc = []
    var tc: u64 = 0
    var rodata: [relocs.len]Reloc = []
    var rc: u64 = 0
    var i: u32 = 0
    loop {
        if i >= relocs.len { break }
        var r = relocs[i]
        match r.sect {
            Text => {
                text[tc] = r
                tc++
            }
            Rodata => {
                rodata[rc] = r
                rc++
            }
        }
        i++
    }
    MachoRelocParts { text = text[0..tc]; rodata = rodata[0..rc] }
}

type MachoLayout = struct {
    ncmds: u32
    nsects: u32
    sizeofcmds: u32
    text_offset: u32
    text_size: u32
    const_addr: u32
    const_offset: u32
    const_size: u32
    reloc_offset: u32
    nreloc: u32
    const_reloc_offset: u32
    nreloc_const: u32
    symtab_offset: u32
    nsyms: u32
    strtab_offset: u32
    strtab_size: u32
    ndef: u32
    nlocal: u32
    nundef: u32
    debug_abbrev_offset: u32
    debug_abbrev_size: u32
    debug_info_offset: u32
    debug_info_size: u32
    debug_line_offset: u32
    debug_line_size: u32
    debug_info_reloc_offset: u32
    nreloc_debug_info: u32
    debug_line_reloc_offset: u32
    nreloc_debug_line: u32
}

fn compute_macho_layout(enc: EncodedModule, strtab_size: u32, nreloc_text: u32, nreloc_const: u32, dwarf: DwarfSink): MachoLayout {
    var has_dwarf = dwarf.present
    var nsects: u32 = if enc.rodata.len > 0 { 2 } else { 1 }
    var seg_cmdsize = 72 + nsects * 80
    var dwarf_seg_cmdsize: u32 = if has_dwarf { (72 + 3 * 80) to u32 } else { 0 }
    var sizeofcmds = seg_cmdsize + dwarf_seg_cmdsize + 24 + 24 + 80
    var ncmds: u32 = if has_dwarf { 5 } else { 4 }
    var text_offset = 32 + sizeofcmds
    var text_size = enc.text.len to u32
    var const_size = enc.rodata.len to u32
    var const_addr: u32 = if const_size > 0 { align_up(text_size, MACHO_CONST_ALIGN) } else { text_size }
    var const_offset = text_offset + const_addr
    var seg_data_end = const_offset + const_size
    var nreloc = nreloc_text
    var reloc_offset = align_up(seg_data_end, 4)
    var text_reloc_end = reloc_offset + (nreloc_text * MACHO_RELOC_ENTRY_SIZE)
    var const_reloc_offset = text_reloc_end
    var reloc_end = const_reloc_offset + (nreloc_const * MACHO_RELOC_ENTRY_SIZE)
    var debug_abbrev_size = dwarf.abbrev.len to u32
    var debug_info_size = dwarf.info.bytes.len to u32
    var debug_line_size = dwarf.line.bytes.len to u32
    var nreloc_debug_info = dwarf.info.relocs.len to u32
    var nreloc_debug_line = dwarf.line.relocs.len to u32
    var debug_abbrev_offset = align_up(reloc_end, 4)
    var debug_info_offset = debug_abbrev_offset + debug_abbrev_size
    var debug_line_offset = debug_info_offset + debug_info_size
    var debug_info_reloc_offset = align_up(debug_line_offset + debug_line_size, 4)
    var debug_line_reloc_offset = debug_info_reloc_offset + (nreloc_debug_info * MACHO_RELOC_ENTRY_SIZE)
    var dwarf_reloc_end = debug_line_reloc_offset + (nreloc_debug_line * MACHO_RELOC_ENTRY_SIZE)
    var symtab_base: u32 = if has_dwarf { dwarf_reloc_end } else { reloc_end }
    var symtab_offset = align_up(symtab_base, 8)
    var nsyms = enc.symbols.len to u32
    var symtab_end = symtab_offset + nsyms * 16
    var ndef = count_defined(enc.symbols)
    var nlocal = count_local(enc.symbols)
    MachoLayout {
        ncmds = ncmds
        nsects = nsects
        sizeofcmds = sizeofcmds
        text_offset = text_offset
        text_size = text_size
        const_addr = const_addr
        const_offset = const_offset
        const_size = const_size
        reloc_offset = reloc_offset
        nreloc = nreloc
        const_reloc_offset = const_reloc_offset
        nreloc_const = nreloc_const
        symtab_offset = symtab_offset
        nsyms = nsyms
        strtab_offset = symtab_end
        strtab_size = strtab_size
        ndef = ndef
        nlocal = nlocal
        nundef = nsyms - ndef
        debug_abbrev_offset = debug_abbrev_offset
        debug_abbrev_size = debug_abbrev_size
        debug_info_offset = debug_info_offset
        debug_info_size = debug_info_size
        debug_line_offset = debug_line_offset
        debug_line_size = debug_line_size
        debug_info_reloc_offset = debug_info_reloc_offset
        nreloc_debug_info = nreloc_debug_info
        debug_line_reloc_offset = debug_line_reloc_offset
        nreloc_debug_line = nreloc_debug_line
    }
}

const MACHO_RELOC_ENTRY_SIZE: u32 = 8

const MACHO_MAGIC_64: u32 = 0xFEEDFACF

const MACHO_CPU_TYPE_ARM64: u32 = 0x0100000C

const MACHO_LC_SEGMENT_64: u32 = 0x19

const MACHO_LC_BUILD_VERSION: u32 = 0x32

const MACHO_LC_DYSYMTAB: u32 = 0x0B

const MACHO_VERSION_11_0: u32 = 0x000B0000

const MACHO_SYM_UNDERSCORE: byte = 0x5F

const MACHO_NTYPE_UNDF_EXT: u32 = 0x01

const MACHO_NTYPE_SECT: u32 = 0x0E

const MACHO_NTYPE_SECT_EXT: u32 = 0x0F

const MACHO_CONST_ALIGN: u32 = 8

const MACHO_BYTE_MASK: u32 = 0xFF

const MACHO_BYTE_MASK_64: u64 = 0xFF

fn emit_header(buf: []byte, lay: MachoLayout): []byte {
    var b = emit_u32_le(buf, MACHO_MAGIC_64)
    b = emit_u32_le(b, MACHO_CPU_TYPE_ARM64)
    b = emit_u32_le(b, 0)
    b = emit_u32_le(b, 1)
    b = emit_u32_le(b, lay.ncmds)
    b = emit_u32_le(b, lay.sizeofcmds)
    b = emit_u32_le(b, 0)
    emit_u32_le(b, 0)
}

fn emit_section(buf: []byte, sectname: str, segname: str, addr: u32, size: u32, offset: u32, align: u32, reloff: u32, nreloc: u32, sect_flags: u32): []byte {
    var b = emit_fixed16(buf, sectname)
    b = emit_fixed16(b, segname)
    b = emit_u64_le(b, addr to u64)
    b = emit_u64_le(b, size to u64)
    b = emit_u32_le(b, offset)
    b = emit_u32_le(b, align)
    b = emit_u32_le(b, reloff)
    b = emit_u32_le(b, nreloc)
    b = emit_u32_le(b, sect_flags)
    b = emit_u32_le(b, 0)
    b = emit_u32_le(b, 0)
    emit_u32_le(b, 0)
}

const S_ATTR_PURE_INSTRUCTIONS: u32 = 0x80000000

const S_ATTR_SOME_INSTRUCTIONS: u32 = 0x00000400

const S_ATTR_DEBUG: u32 = 0x02000000

fn emit_segment(buf: []byte, lay: MachoLayout): []byte {
    var seg_cmdsize = 72 + lay.nsects * 80
    var data_size = lay.const_addr + lay.const_size
    var b = emit_u32_le(buf, MACHO_LC_SEGMENT_64)
    b = emit_u32_le(b, seg_cmdsize)
    b = emit_fixed16(b, "")
    b = emit_u64_le(b, 0)
    b = emit_u64_le(b, align_up(data_size, 16) to u64)
    b = emit_u64_le(b, lay.text_offset to u64)
    b = emit_u64_le(b, data_size to u64)
    b = emit_u32_le(b, 7)
    b = emit_u32_le(b, 7)
    b = emit_u32_le(b, lay.nsects)
    b = emit_u32_le(b, 0)
    var text_reloff = if lay.nreloc > 0 { lay.reloc_offset } else { 0 }
    b = emit_section(b, "__text", "__TEXT", 0, lay.text_size, lay.text_offset, 2, text_reloff, lay.nreloc, S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS)
    if lay.nsects > 1 {
        var const_reloff = if lay.nreloc_const > 0 { lay.const_reloc_offset } else { 0 }
        var const_segname = if lay.nreloc_const > 0 { "__DATA" } else { "__TEXT" }
        b = emit_section(b, "__const", const_segname, lay.const_addr, lay.const_size, lay.const_offset, 3, const_reloff, lay.nreloc_const, 0)
    }
    b
}

fn emit_dwarf_segment(buf: []byte, lay: MachoLayout): []byte {
    var dwarf_nsects: u32 = 3
    var seg_cmdsize = 72 + dwarf_nsects * 80
    var vmaddr = align_up(lay.const_addr + lay.const_size, 16)
    var data_size = lay.debug_abbrev_size + lay.debug_info_size + lay.debug_line_size
    var b = emit_u32_le(buf, MACHO_LC_SEGMENT_64)
    b = emit_u32_le(b, seg_cmdsize)
    b = emit_fixed16(b, "__DWARF")
    b = emit_u64_le(b, vmaddr to u64)
    b = emit_u64_le(b, align_up(data_size, 16) to u64)
    b = emit_u64_le(b, lay.debug_abbrev_offset to u64)
    b = emit_u64_le(b, data_size to u64)
    b = emit_u32_le(b, 0)
    b = emit_u32_le(b, 0)
    b = emit_u32_le(b, dwarf_nsects)
    b = emit_u32_le(b, 0)
    b = emit_section(b, "__debug_abbrev", "__DWARF", vmaddr, lay.debug_abbrev_size, lay.debug_abbrev_offset, 0, 0, 0, S_ATTR_DEBUG)
    var info_addr = vmaddr + lay.debug_abbrev_size
    var info_reloff = if lay.nreloc_debug_info > 0 { lay.debug_info_reloc_offset } else { 0 }
    b = emit_section(b, "__debug_info", "__DWARF", info_addr, lay.debug_info_size, lay.debug_info_offset, 0, info_reloff, lay.nreloc_debug_info, S_ATTR_DEBUG)
    var line_addr = info_addr + lay.debug_info_size
    var line_reloff = if lay.nreloc_debug_line > 0 { lay.debug_line_reloc_offset } else { 0 }
    emit_section(b, "__debug_line", "__DWARF", line_addr, lay.debug_line_size, lay.debug_line_offset, 0, line_reloff, lay.nreloc_debug_line, S_ATTR_DEBUG)
}

fn emit_dwarf_reloc_table(buf: []byte, relocs: []DwReloc, symbols: []Symbol): []byte {
    var b = buf
    var i: u64 = 0
    loop {
        if i >= relocs.len { break }
        var r = relocs[i]
        b = emit_u32_le(b, r.offset to u32)
        var symnum = sym_index(symbols, r.symbol)
        var packed = symnum | (0 << 24) | (3 << 25) | (1 << 27) | (ARM64_RELOC_UNSIGNED << 28)
        b = emit_u32_le(b, packed to u32)
        i++
    }
    b
}

fn emit_dwarf_body(buf: []byte, dwarf: DwarfSink, symbols: []Symbol): []byte {
    var b = pad_to_mult(buf, 4)
    b = append_bytes(b, dwarf.abbrev)
    b = append_bytes(b, dwarf.info.bytes)
    b = append_bytes(b, dwarf.line.bytes)
    b = pad_to_mult(b, 4)
    b = emit_dwarf_reloc_table(b, dwarf.info.relocs, symbols)
    emit_dwarf_reloc_table(b, dwarf.line.relocs, symbols)
}

fn emit_build_version(buf: []byte): []byte {
    var b = emit_u32_le(buf, MACHO_LC_BUILD_VERSION)
    b = emit_u32_le(b, 24)
    b = emit_u32_le(b, 1)
    b = emit_u32_le(b, MACHO_VERSION_11_0)
    b = emit_u32_le(b, MACHO_VERSION_11_0)
    emit_u32_le(b, 0)
}

fn emit_symtab_cmd(buf: []byte, lay: MachoLayout): []byte {
    var b = emit_u32_le(buf, 2)
    b = emit_u32_le(b, 24)
    b = emit_u32_le(b, lay.symtab_offset)
    b = emit_u32_le(b, lay.nsyms)
    b = emit_u32_le(b, lay.strtab_offset)
    emit_u32_le(b, lay.strtab_size)
}

fn emit_dysymtab_cmd(buf: []byte, lay: MachoLayout): []byte {
    var nextdef = lay.ndef - lay.nlocal
    var b = emit_u32_le(buf, MACHO_LC_DYSYMTAB)
    b = emit_u32_le(b, 80)
    b = emit_u32_le(b, 0)
    b = emit_u32_le(b, lay.nlocal)
    b = emit_u32_le(b, lay.nlocal)
    b = emit_u32_le(b, nextdef)
    b = emit_u32_le(b, lay.ndef)
    b = emit_u32_le(b, lay.nundef)
    var i: u32 = 0
    loop {
        if i >= 12 { break }
        b = emit_u32_le(b, 0)
        i++
    }
    b
}

fn emit_reloc_table(buf: []byte, relocs: []Reloc, symbols: []Symbol): []byte {
    var b = buf
    var i: u64 = 0
    loop {
        if i >= relocs.len { break }
        var r = relocs[i]
        b = emit_u32_le(b, r.offset)
        var symnum = sym_index(symbols, r.sym)
        var packed = symnum | (reloc_pcrel(r.kind) << 24) | (reloc_length(r.kind) << 25) | (1 << 27) | (reloc_type_value(r.kind) << 28)
        b = emit_u32_le(b, packed to u32)
        i++
    }
    b
}

fn section_addr(sect: u8, const_addr: u32): u32 {
    if sect == 2 { return const_addr }
    0
}

type MachoSymType = enum { Undefined; DefinedLocal; DefinedGlobal }

fn macho_symtype_wire(t: MachoSymType): u32 {
    match t {
        Undefined => MACHO_NTYPE_UNDF_EXT
        DefinedLocal => MACHO_NTYPE_SECT
        DefinedGlobal => MACHO_NTYPE_SECT_EXT
    }
}

fn macho_sym_type(s: Symbol): MachoSymType {
    if !s.defined { return MachoSymType::Undefined }
    if s.local { MachoSymType::DefinedLocal } else { MachoSymType::DefinedGlobal }
}

fn emit_one_symbol(buf: []byte, s: Symbol, strx: u32, const_addr: u32): []byte {
    var b = emit_u32_le(buf, strx)
    b = emit_u8_field(b, macho_symtype_wire(macho_sym_type(s)))
    if s.defined {
        b = emit_u8_field(b, s.sect to u32)
    } else {
        b = emit_u8_field(b, 0)
    }
    b = [ ..b, 0, 0 ]
    var value = if s.defined { section_addr(s.sect, const_addr) + s.offset } else { 0 }
    emit_u64_le(b, value to u64)
}

fn emit_symtab(buf: []byte, symbols: []Symbol, strtab: StrTab, const_addr: u32): []byte {
    var b = buf
    var i: u64 = 0
    loop {
        if i >= symbols.len { break }
        b = emit_one_symbol(b, symbols[i], strtab.strx[i], const_addr)
        i++
    }
    b
}

pub fn emit_macho(enc: EncodedModule, dwarf: DwarfSink): []byte {
    var parts = macho_partition_relocs(enc.relocs)
    var strtab = build_strtab(enc.symbols)
    var lay = compute_macho_layout(enc, strtab.bytes.len to u32, parts.text.len to u32, parts.rodata.len to u32, dwarf)
    var b: []byte = []
    b = emit_header(b, lay)
    b = emit_segment(b, lay)
    if dwarf.present { b = emit_dwarf_segment(b, lay) }
    b = emit_build_version(b)
    b = emit_symtab_cmd(b, lay)
    b = emit_dysymtab_cmd(b, lay)
    b = append_bytes(b, enc.text)
    b = pad_to_offset(b, lay.const_offset)
    b = append_bytes(b, enc.rodata)
    b = pad_to_mult(b, 4)
    b = emit_reloc_table(b, parts.text, enc.symbols)
    b = emit_reloc_table(b, parts.rodata, enc.symbols)
    if dwarf.present { b = emit_dwarf_body(b, dwarf, enc.symbols) }
    b = pad_to_mult(b, 8)
    b = emit_symtab(b, enc.symbols, strtab, lay.const_addr)
    append_bytes(b, strtab.bytes)
}
