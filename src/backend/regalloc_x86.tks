type NumberedInstX86 = struct {
    point: u32
    block_id: u32
    inst: @MInstX86()
}

const SHIFT_COUNT_REG_X86: MReg = preg(1, MRegClass::GPR)

fn inst_regs_x86(inst: @MInstX86()): InstRegs {
    match inst {
        MMovImmX86 as x => ir_def(x.dst)
        MMovX86 as x => ir_def_use(x.dst, one_reg(x.src))
        MAluRmX86 as x => ir_def_use(x.dst, two_regs(x.dst, x.src))
        MImulX86 as x => ir_def_use(x.dst, two_regs(x.dst, x.src))
        MDivSeqX86 as x => ir_call(x.dst, true, two_regs(x.a, x.b))
        MShiftX86 as x => ir_def_use(x.dst, two_regs(x.dst, SHIFT_COUNT_REG_X86))
        MCmpX86 as x => ir_use(two_regs(x.a, x.b))
        MSetccX86 as x => ir_def(x.dst)
        MJccX86 => ir_none()
        MNegX86 as x => ir_def_use(x.dst, one_reg(x.dst))
        MNotX86 as x => ir_def_use(x.dst, one_reg(x.dst))
        MLoadX86 as x => ir_def_use(x.dst, one_reg(x.mem.base_reg))
        MStoreX86 as x => ir_use(two_regs(x.src, x.mem.base_reg))
        MFrameAddrX86 as x => ir_def(x.dst)
        MLeaRipX86 as x => ir_def(x.dst)
        MJmpX86 => ir_none()
        MCallX86 as x => ir_call(x.ret_reg, x.has_result, x.uses)
        MCallIndX86 as x => ir_call(x.ret_reg, x.has_result, cons_reg(x.target, x.uses))
        MSyscallX86 as x => ir_call(x.ret_reg, x.has_result, x.uses)
        MAtomicX86 as x => ir_call(x.ret_reg, x.has_result, x.uses)
        MRetX86 => ir_none()
        MFAluX86 as x => ir_def_use(x.dst, two_regs(x.dst, x.src))
        MFMovX86 as x => ir_def_use(x.dst, one_reg(x.src))
        MFCmpX86 as x => ir_use(two_regs(x.a, x.b))
        MSetPX86 as x => ir_def(x.dst)
        MCvtX86 as x => ir_def_use(x.dst, one_reg(x.src))
        MOutArgX86 as x => ir_use(one_reg(x.src))
        MInArgX86 as x => ir_def(x.dst)
        MFSpillX86 as x => if x.is_load { ir_def(x.reg) } else { ir_use(one_reg(x.reg)) }
    }
}

fn is_terminator_x86(inst: @MInstX86()): bool {
    match inst {
        MRetX86 => true
        MJmpX86 => true
        MJccX86 => true
        _ => false
    }
}

fn terminator_target_x86(inst: @MInstX86()): TargetOpt {
    match inst {
        MJmpX86 as x => TargetOpt { has = true; target = x.target }
        MJccX86 as x => TargetOpt { has = true; target = x.target }
        _ => TargetOpt { has = false; target = 0 }
    }
}

fn block_insts_of_x86(f: MFuncX86, id: u32): teko::collections::Chunked<MInstX86Node> {
    var it = f.blocks.iter()
    loop {
        match it.next() {
            MBlockX86 as b => {
                if b.id == id { return b.insts }
            }
            null => break
        }
    }
    teko::collections::Chunked<MInstX86Node>::make()
}

fn block_successors_x86(f: MFuncX86, id: u32): []u32 {
    var insts = block_insts_of_x86(f, id)
    var out: []u32 = []
    var it = insts.iter()
    loop {
        match it.next() {
            MInstX86Node as n => {
                var t = terminator_target_x86(n.op)
                if t.has { out = add_unique_u32(out, t.target) }
            }
            null => break
        }
    }
    out
}

fn rpo_visit_x86(f: MFuncX86, id: u32, st: RpoState): RpoState {
    if u32_in(st.visited, id) { return st }
    var succs = block_successors_x86(f, id)
    var cur = RpoState { visited = [..st.visited, id]; post = st.post }
    var i: u64 = 0
    loop {
        if i >= succs.len { break }
        cur = rpo_visit_x86(f, succs[i], cur)
        i++
    }
    RpoState { visited = cur.visited; post = [..cur.post, id] }
}

fn append_unvisited_x86(f: MFuncX86, order: []u32): []u32 {
    var out: [order.len + f.blocks.len()]u32 = []
    var count: u64 = 0
    loop {
        if count >= order.len { break }
        out[count] = order[count]
        count++
    }
    var it = f.blocks.iter()
    loop {
        match it.next() {
            MBlockX86 as b => {
                if !u32_in(out[0..count], b.id) {
                    out[count] = b.id
                    count++
                }
            }
            null => break
        }
    }
    out[0..count]
}

fn rpo_block_order_x86(f: MFuncX86): []u32 {
    if f.blocks.is_empty() { return [] }
    var entry = f.blocks.first().id
    var st = rpo_visit_x86(f, entry, RpoState { visited = []; post = [] })
    append_unvisited_x86(f, reverse_u32(st.post))
}

fn reachable_blocks_x86(f: MFuncX86): []u32 {
    if f.blocks.is_empty() { return [] }
    var entry = f.blocks.first().id
    rpo_visit_x86(f, entry, RpoState { visited = []; post = [] }).visited
}

fn number_insts_total_x86(f: MFuncX86, order: []u32): u64 {
    var total: u64 = 0
    var bi: u64 = 0
    loop {
        if bi >= order.len { break }
        total = total + block_insts_of_x86(f, order[bi]).len()
        bi++
    }
    total
}

fn number_insts_x86(f: MFuncX86, order: []u32): []NumberedInstX86 {
    var out: [number_insts_total_x86(f, order)]NumberedInstX86 = []
    var k: u64 = 0
    var p: u32 = 0
    var bi: u64 = 0
    loop {
        if bi >= order.len { break }
        var bid = order[bi]
        var iit = block_insts_of_x86(f, bid).iter()
        loop {
            match iit.next() {
                MInstX86Node as n => {
                    out[k] = NumberedInstX86 { point = p; block_id = bid; inst = n.op }
                    k++
                    p = p + 1
                }
                null => break
            }
        }
        bi++
    }
    out
}

fn collect_events_total_x86(stream: []NumberedInstX86): u64 {
    var total: u64 = 0
    var i: u64 = 0
    loop {
        if i >= stream.len { break }
        var ir = inst_regs_x86(stream[i].inst)
        if ir.has_def { total = total + 1 }
        total = total + ir.uses.len
        i++
    }
    total
}

fn collect_events_x86(stream: []NumberedInstX86): []RegEvent {
    var out: [collect_events_total_x86(stream)]RegEvent = []
    var k: u64 = 0
    var i: u64 = 0
    loop {
        if i >= stream.len { break }
        var ni = stream[i]
        var ir = inst_regs_x86(ni.inst)
        if ir.has_def {
            out[k] = RegEvent { reg = ir.def_reg; point = ni.point; is_def = true }
            k++
        }
        var u: u64 = 0
        loop {
            if u >= ir.uses.len { break }
            out[k] = RegEvent { reg = ir.uses[u]; point = ni.point; is_def = false }
            k++
            u++
        }
        i++
    }
    out
}

fn call_points_of_x86(stream: []NumberedInstX86): []u32 {
    var out: [stream.len]u32 = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= stream.len { break }
        if inst_regs_x86(stream[i].inst).is_call {
            out[count] = stream[i].point
            count++
        }
        i++
    }
    out[0..count]
}

fn next_terminator_point_x86(stream: []NumberedInstX86, from: u32): u32 {
    var i: u64 = 0
    loop {
        if i >= stream.len { break }
        var ni = stream[i]
        if ni.point >= from && is_terminator_x86(ni.inst) { return ni.point }
        i++
    }
    from
}

fn finalize_pin_x86(r: MReg, start: u32, end: u32, def_started: bool, stream: []NumberedInstX86, call_points: []u32): LiveInterval {
    var real_end = if def_started && end == start {
        var term = next_terminator_point_x86(stream, start)
        if term > end { term } else { end }
    } else {
        end
    }
    mk_interval(r, start, real_end, true, call_points)
}

fn phys_intervals_x86(events: []RegEvent, r: MReg, stream: []NumberedInstX86, call_points: []u32): []LiveInterval {
    var out: []LiveInterval = []
    var have_open: bool = false
    var def_started: bool = false
    var cur_start: u32 = 0
    var cur_end: u32 = 0
    var i: u64 = 0
    loop {
        if i >= events.len { break }
        var e = events[i]
        if reg_eq(e.reg, r) {
            if e.is_def {
                if have_open { out = [..out, finalize_pin_x86(r, cur_start, cur_end, def_started, stream, call_points)] }
                cur_start = e.point
                cur_end = e.point
                have_open = true
                def_started = true
            } else {
                if have_open {
                    if e.point > cur_end { cur_end = e.point }
                } else {
                    cur_start = 0
                    cur_end = e.point
                    have_open = true
                    def_started = false
                }
            }
        }
        i++
    }
    if have_open { out = [..out, finalize_pin_x86(r, cur_start, cur_end, def_started, stream, call_points)] }
    out
}

fn block_first_point_x86(stream: []NumberedInstX86, block_id: u32): u32 {
    var have: bool = false
    var best: u32 = 0
    var i: u64 = 0
    loop {
        if i >= stream.len { break }
        var ni = stream[i]
        if ni.block_id == block_id {
            if !have || ni.point < best { best = ni.point; have = true }
        }
        i++
    }
    best
}

fn natural_loops_x86(stream: []NumberedInstX86, order: []u32, reachable: []u32): []NaturalLoop {
    var out: [stream.len]NaturalLoop = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= stream.len { break }
        var ni = stream[i]
        var t = terminator_target_x86(ni.inst)
        if t.has && u32_in(reachable, ni.block_id) {
            if block_pos(order, t.target) <= block_pos(order, ni.block_id) {
                out[count] = NaturalLoop { header_pt = block_first_point_x86(stream, t.target); latch_pt = ni.point }
                count++
            }
        }
        i++
    }
    out[0..count]
}

fn compute_intervals_x86(stream: []NumberedInstX86, order: []u32, reachable: []u32): IntervalSet | error {
    var events = collect_events_x86(stream)
    var regs = distinct_regs(events)
    var cps = call_points_of_x86(stream)
    var virt_n: u64 = 0
    var vc: u64 = 0
    loop {
        if vc >= regs.len { break }
        if !regs[vc].is_phys { virt_n = virt_n + 1 }
        vc++
    }
    var virt: [virt_n]LiveInterval = []
    var vk: u64 = 0
    var fixed: []LiveInterval = []
    var i: u64 = 0
    loop {
        if i >= regs.len { break }
        var r = regs[i]
        if r.is_phys {
            var pins = phys_intervals_x86(events, r, stream, cps)
            var j: u64 = 0
            loop {
                if j >= pins.len { break }
                fixed = [..fixed, pins[j]]
                j++
            }
        } else {
            virt[vk] = virt_interval(events, r, cps)
            vk++
        }
        i++
    }
    virt = extend_over_loops(virt, natural_loops_x86(stream, order, reachable), cps)
    IntervalSet { virt = virt; fixed = fixed; call_points = cps }
}

fn map_minst_x86(inst: @MInstX86(), table: []SubstEntry): @MInstX86() {
    match inst {
        MMovImmX86 as x => movimm_x86(subst_find(table, x.dst), x.imm64, x.wide)
        MMovX86 as x => mov_x86(subst_find(table, x.dst), subst_find(table, x.src), x.wide)
        MAluRmX86 as x => alu_rm_x86(x.op, subst_find(table, x.dst), subst_find(table, x.src), x.wide)
        MImulX86 as x => imul_x86(subst_find(table, x.dst), subst_find(table, x.src), x.wide)
        MDivSeqX86 as x => divseq_x86(subst_find(table, x.dst), subst_find(table, x.a), subst_find(table, x.b), x.is_signed, x.is_rem, x.wide)
        MShiftX86 as x => shift_x86(x.op, subst_find(table, x.dst), x.wide)
        MCmpX86 as x => cmp_x86(subst_find(table, x.a), subst_find(table, x.b), x.wide)
        MSetccX86 as x => setcc_x86(subst_find(table, x.dst), x.cond)
        MJccX86 as x => jcc_x86(x.cond, x.target)
        MNegX86 as x => neg_x86(subst_find(table, x.dst), x.wide)
        MNotX86 as x => not_x86(subst_find(table, x.dst), x.wide)
        MLoadX86 as x => load_x86(x.size, x.sign, subst_find(table, x.dst), MMem { base_reg = subst_find(table, x.mem.base_reg); offset = x.mem.offset })
        MStoreX86 as x => store_x86(x.size, subst_find(table, x.src), MMem { base_reg = subst_find(table, x.mem.base_reg); offset = x.mem.offset })
        MFrameAddrX86 as x => frame_addr_x86(subst_find(table, x.dst), x.slot)
        MLeaRipX86 as x => lea_rip_x86(subst_find(table, x.dst), x.sym, x.kind)
        MJmpX86 as x => jmp_x86(x.target)
        MCallX86 as x => call_x86(x.sym, map_regs_list(x.uses, table), subst_find(table, x.ret_reg), x.has_result, x.variadic)
        MCallIndX86 as x => call_ind_x86(subst_find(table, x.target), map_regs_list(x.uses, table), subst_find(table, x.ret_reg), x.has_result)
        MSyscallX86 as x => syscall_x86(map_regs_list(x.uses, table), subst_find(table, x.ret_reg), x.has_result)
        MAtomicX86 as x => atomic_x86(x.kind, map_regs_list(x.uses, table), subst_find(table, x.ret_reg), x.has_result)
        MRetX86 => ret_x86()
        MFAluX86 as x => falu_x86(x.op, subst_find(table, x.dst), subst_find(table, x.src), x.dbl)
        MFMovX86 as x => fmov_x86(subst_find(table, x.dst), subst_find(table, x.src), x.dbl)
        MFCmpX86 as x => fcmp_x86(subst_find(table, x.a), subst_find(table, x.b), x.dbl)
        MSetPX86 as x => setp_x86(subst_find(table, x.dst), x.is_np)
        MCvtX86 as x => cvt_x86(x.op, subst_find(table, x.dst), subst_find(table, x.src))
        MOutArgX86 as x => out_arg_x86(x.size, subst_find(table, x.src), x.index)
        MInArgX86 as x => in_arg_x86(x.size, subst_find(table, x.dst), x.index)
        MFSpillX86 as x => fspill_x86(subst_find(table, x.reg), x.slot, x.is_load)
    }
}

fn minst_x86_single(x: @MInstX86()): []@MInstX86() {
    [x]
}

fn minst_x86_cat(a: []@MInstX86(), b: []@MInstX86()): []@MInstX86() {
    [..a, ..b]
}

fn emit_gpr_reload_x86(sv: MReg, slot: u64): []@MInstX86() {
    var fa = frame_addr_x86(sv, slot)
    var ld = load_x86(MMemSizeX86::Q, false, sv, MMem { base_reg = sv; offset = 0 to i32 })
    [fa, ld]
}

fn emit_spill_reload_x86(sv: MReg, slot: u64): []@MInstX86() {
    if sv.reg_class == MRegClass::FPR { return minst_x86_single(fspill_x86(sv, slot, true)) }
    emit_gpr_reload_x86(sv, slot)
}

fn emit_spill_store_x86(dsv: MReg, asv: MReg, slot: u64): []@MInstX86() {
    if dsv.reg_class == MRegClass::FPR { return minst_x86_single(fspill_x86(dsv, slot, false)) }
    emit_gpr_store_x86(dsv, asv, slot)
}

fn emit_gpr_store_x86(dsv: MReg, asv: MReg, slot: u64): []@MInstX86() {
    var fa = frame_addr_x86(asv, slot)
    var st = store_x86(MMemSizeX86::Q, dsv, MMem { base_reg = asv; offset = 0 to i32 })
    [fa, st]
}

type UseAccX86 = struct {
    table: []SubstEntry
    reloads: []@MInstX86()
    nth: u32
}

fn add_use_subst_x86(abi: AbiDescriptor, sr: ScanResult, u: MReg, frame_base: u64, acc: UseAccX86): UseAccX86 {
    if u.is_phys { return acc }
    if subst_has(acc.table, u.id) { return acc }
    var la = assign_lookup(sr, u.id)
    if !la.found { return acc }
    if la.is_spill {
        var sv = spill_scratch(abi, u.reg_class, acc.nth)
        var reloads2 = minst_x86_cat(acc.reloads, emit_spill_reload_x86(sv, frame_base + la.slot))
        var table2 = [..acc.table, SubstEntry { vid = u.id; to = sv }]
        return UseAccX86 { table = table2; reloads = reloads2; nth = acc.nth + 1 }
    }
    var table3 = [..acc.table, SubstEntry { vid = u.id; to = preg(la.phys, u.reg_class) }]
    UseAccX86 { table = table3; reloads = acc.reloads; nth = acc.nth }
}

fn rewrite_inst_x86(abi: AbiDescriptor, sr: ScanResult, inst: @MInstX86(), frame_base: u64): []@MInstX86() {
    var ir = inst_regs_x86(inst)
    var acc = UseAccX86 { table = []; reloads = []; nth = 0 to u32 }
    var ui: u64 = 0
    loop {
        if ui >= ir.uses.len { break }
        acc = add_use_subst_x86(abi, sr, ir.uses[ui], frame_base, acc)
        ui++
    }
    var table = acc.table
    var stores: []@MInstX86() = []
    if ir.has_def {
        var d = ir.def_reg
        if !d.is_phys {
            var la = assign_lookup(sr, d.id)
            if la.found {
                if la.is_spill {
                    var dsv = spill_scratch(abi, d.reg_class, 0 to u32)
                    var asv = spill_scratch(abi, MRegClass::GPR, 1 to u32)
                    if !subst_has(table, d.id) {
                        table = [..table, SubstEntry { vid = d.id; to = dsv }]
                    }
                    stores = emit_spill_store_x86(dsv, asv, frame_base + la.slot)
                } else {
                    if !subst_has(table, d.id) {
                        table = [..table, SubstEntry { vid = d.id; to = preg(la.phys, d.reg_class) }]
                    }
                }
            }
        }
    }
    var mapped = map_minst_x86(inst, table)
    minst_x86_cat(minst_x86_cat(acc.reloads, minst_x86_single(mapped)), stores)
}

fn rewrite_block_x86(abi: AbiDescriptor, sr: ScanResult, b: MBlockX86, frame_base: u64): MBlockX86 {
    var insts = teko::collections::Chunked<MInstX86Node>::make()
    var it = b.insts.iter()
    loop {
        match it.next() {
            MInstX86Node as n => {
                var part = rewrite_inst_x86(abi, sr, n.op, frame_base)
                var pj: u64 = 0
                loop {
                    if pj >= part.len { break }
                    insts.push(MInstX86Node { op = part[pj] })
                    pj++
                }
            }
            null => break
        }
    }
    MBlockX86 { id = b.id; params = b.params; insts = insts }
}

fn rewrite_func_x86(abi: AbiDescriptor, f: MFuncX86, sr: ScanResult): MFuncX86 {
    var frame_base = f.frame.len
    var frame = append_spill_slots(abi, f.frame, count_spills(sr))
    var blocks = teko::collections::Chunked<MBlockX86>::make()
    var it = f.blocks.iter()
    loop {
        match it.next() {
            MBlockX86 as b => { blocks.push(rewrite_block_x86(abi, sr, b, frame_base)) }
            null => break
        }
    }
    MFuncX86 { symbol = f.symbol; blocks = blocks; frame = frame }
}

pub fn all_physical_x86(f: MFuncX86): bool {
    var bit = f.blocks.iter()
    loop {
        match bit.next() {
            MBlockX86 as b => {
                var iit = b.insts.iter()
                loop {
                    match iit.next() {
                        MInstX86Node as n => {
                            var ir = inst_regs_x86(n.op)
                            if ir.has_def {
                                if !ir.def_reg.is_phys { return false }
                            }
                            var ui: u64 = 0
                            loop {
                                if ui >= ir.uses.len { break }
                                if !ir.uses[ui].is_phys { return false }
                                ui++
                            }
                        }
                        null => break
                    }
                }
            }
            null => break
        }
    }
    true
}

pub fn regalloc_func_x86(abi: AbiDescriptor, f: MFuncX86): MFuncX86 | error {
    var order = rpo_block_order_x86(f)
    var numbered = number_insts_x86(f, order)
    var ivals = match compute_intervals_x86(numbered, order, reachable_blocks_x86(f)) {
        IntervalSet as s => s
        error as e => return e
    }
    var sr = linear_scan(abi, ivals)
    report_call_unsafe_assignments(abi, ivals, sr)
    rewrite_func_x86(abi, f, sr)
}

pub fn regalloc_module_x86(abi: AbiDescriptor, m: MModuleX86): MModuleX86 | error {
    var funcs = teko::collections::Chunked<MFuncX86>::make()
    var it = m.funcs.iter()
    loop {
        match it.next() {
            MFuncX86 as f => {
                var rf = match regalloc_func_x86(abi, f) { MFuncX86 as g => g; error as e => return e }
                funcs.push(rf)
            }
            null => break
        }
    }
    MModuleX86 { funcs = funcs; rodata = m.rodata; globals = m.globals; layouts = m.layouts }
}
