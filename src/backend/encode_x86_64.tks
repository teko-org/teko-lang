pub type EncRelocX86 = struct {
    field_off: u32
    sym: str
    kind: RelocKindX86
}

pub type EncInstX86 = struct {
    bytes: []byte
    has_branch: bool
    branch_field_off: u32
    target: u32
    reloc: EncRelocX86 | null
}

pub type FrameLayoutX86 = struct {
    size: u32
    saved_gpr: []u32
    saved_fpr: []u32
    slot_offsets: []u32
    call_align: bool
    out_arg_base: u32
    fpr_save_base: u32
    caller_shadow: u32
}

type X86MemOp = struct {
    op66: bool
    mandatory_prefix: u32
    rexw: bool
    two_byte: bool
    opcode: u32
    byte_reg: bool
}

fn push_byte_x86(buf: []byte, v: u32): []byte {
    [..buf, (v & X86_BYTE_MASK) to byte]
}

fn push_imm32_x86(buf: []byte, x: i64): []byte {
    emit_u32_le(buf, (x & X86_LOW32_MASK) to u32)
}

fn push_imm64_x86(buf: []byte, x: i64): []byte {
    var lo = (x & X86_LOW32_MASK) to u32
    var hi = ((x >> (32)) & X86_LOW32_MASK) to u32
    emit_u32_le(emit_u32_le(buf, lo), hi)
}

fn bit_u32(flag: bool): u32 {
    if flag { 1 to u32 } else { 0 to u32 }
}

fn rex_x86(w: bool, r: bool, x: bool, b: bool): u32 {
    var hi = (REX_BASE | (bit_u32(w) << REX_W_SHIFT)) | (bit_u32(r) << REX_R_SHIFT)
    (hi | (bit_u32(x) << REX_X_SHIFT)) | bit_u32(b)
}

fn push_rex_x86(buf: []byte, w: bool, r: bool, x: bool, b: bool): []byte {
    var v = rex_x86(w, r, x, b)
    if v == REX_BASE { return buf }
    push_byte_x86(buf, v)
}

fn push_rex_forced_x86(buf: []byte, w: bool, r: bool, x: bool, b: bool): []byte {
    push_byte_x86(buf, rex_x86(w, r, x, b))
}

fn modrm_x86(md: u32, reg: u32, rm: u32): u32 {
    ((md & MODRM_MOD_MASK) << MODRM_MOD_SHIFT) | ((reg & X86_FIELD3_MASK) << X86_FIELD3_SHIFT) | (rm & X86_FIELD3_MASK)
}

fn reg_low3_x86(r: MReg): u32 {
    r.id & X86_FIELD3_MASK
}

fn reg_ext_x86(r: MReg): bool {
    (r.id & X86_REG_HIGH_BIT) != (0 to u32)
}

fn cond_cc_x86(c: MCond): u32 {
    match c {
        EQ => X86_CC_E
        NE => X86_CC_NE
        LT => X86_CC_L
        LE => X86_CC_LE
        GT => X86_CC_G
        GE => X86_CC_GE
        LO => X86_CC_B
        LS => X86_CC_BE
        HI => X86_CC_A
        HS => X86_CC_AE
    }
}

fn fits_i32_x86(x: i64): bool {
    var hi = X86_IMM32_MAX
    var lo = (0) - X86_IMM32_MIN_MAGNITUDE
    x >= lo && x <= hi
}

fn plain_inst_x86(bytes: []byte): EncInstX86 {
    EncInstX86 {
        bytes = bytes
        has_branch = false
        branch_field_off = 0 to u32
        target = 0 to u32
        reloc = null
    }
}

fn branch_inst_x86(bytes: []byte, field_off: u32, target: u32): EncInstX86 {
    EncInstX86 {
        bytes = bytes
        has_branch = true
        branch_field_off = field_off
        target = target
        reloc = null
    }
}

fn reloc_inst_x86(bytes: []byte, field_off: u32, sym: str, kind: RelocKindX86): EncInstX86 {
    EncInstX86 {
        bytes = bytes
        has_branch = false
        branch_field_off = 0 to u32
        target = 0 to u32
        reloc = EncRelocX86 { field_off = field_off; sym = sym; kind = kind }
    }
}

fn emit_rr_x86(buf: []byte, rexw: bool, two_byte: bool, opcode: u32, reg: MReg, rm: MReg): []byte {
    var b = push_rex_x86(buf, rexw, reg_ext_x86(reg), false, reg_ext_x86(rm))
    if two_byte { b = push_byte_x86(b, X86_OP_TWO_BYTE_ESCAPE) }
    b = push_byte_x86(b, opcode)
    push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, reg_low3_x86(reg), reg_low3_x86(rm)))
}

fn emit_sse_rr_x86(buf: []byte, prefix: u32, rexw: bool, opcode: u32, reg: MReg, rm: MReg): []byte {
    var b0 = if prefix != X86_NO_PREFIX { push_byte_x86(buf, prefix) } else { buf }
    emit_rr_x86(b0, rexw, true, opcode, reg, rm)
}

fn emit_rm_ext_x86(buf: []byte, rexw: bool, opcode: u32, ext_field: u32, rm: MReg): []byte {
    var b = push_rex_x86(buf, rexw, false, false, reg_ext_x86(rm))
    b = push_byte_x86(b, opcode)
    push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, ext_field, reg_low3_x86(rm)))
}

fn push_mem_operand_x86(buf: []byte, reg3: u32, mem: MMem): []byte {
    var base3 = reg_low3_x86(mem.base_reg)
    var disp = mem.offset to i64
    var need_sib = base3 == X86_REG_RSP_ID
    var is_rbp = base3 == X86_REG_RBP_ID
    var zero_disp = disp == (0) && !is_rbp
    var disp8 = disp >= ((0) - X86_DISP8_MAGNITUDE) && disp <= X86_DISP8_MAX
    var md = if zero_disp { MODRM_MOD_INDIRECT } else { if disp8 { MODRM_MOD_DISP8 } else { MODRM_MOD_DISP32 } }
    var rm = if need_sib { X86_REG_RSP_ID } else { base3 }
    var b = push_byte_x86(buf, modrm_x86(md, reg3, rm))
    if need_sib { b = push_byte_x86(b, (X86_REG_RSP_ID << X86_FIELD3_SHIFT) | base3) }
    if md == MODRM_MOD_DISP8 { b = push_byte_x86(b, (disp & X86_BYTE_MASK) to u32) }
    if md == MODRM_MOD_DISP32 { b = push_imm32_x86(b, disp) }
    b
}

fn emit_mem_op_x86(form: X86MemOp, regop: MReg, mem: MMem): EncInstX86 {
    var b: []byte = []
    if form.mandatory_prefix != X86_NO_PREFIX { b = push_byte_x86(b, form.mandatory_prefix) }
    if form.op66 { b = push_byte_x86(b, X86_OPERAND_SIZE_PREFIX) }
    var force = form.byte_reg && (regop.id >= X86_BYTE_REG_MIN_ID)
    var rr = reg_ext_x86(regop)
    var rb = reg_ext_x86(mem.base_reg)
    b = if force { push_rex_forced_x86(b, form.rexw, rr, false, rb) } else { push_rex_x86(b, form.rexw, rr, false, rb) }
    if form.two_byte { b = push_byte_x86(b, X86_OP_TWO_BYTE_ESCAPE) }
    b = push_byte_x86(b, form.opcode)
    plain_inst_x86(push_mem_operand_x86(b, reg_low3_x86(regop), mem))
}

fn load_memop_x86(size: MMemSizeX86, sign: bool): X86MemOp {
    match size {
        Q => X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = true; two_byte = false; opcode = X86_OP_MOV_R_RM; byte_reg = false }
        D => if sign {
            X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = true; two_byte = false; opcode = X86_OP_MOVSXD; byte_reg = false }
        } else {
            X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = false; opcode = X86_OP_MOV_R_RM; byte_reg = false }
        }
        W => if sign {
            X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = true; two_byte = true; opcode = X86_OP_MOVSX_R32_RM16; byte_reg = false }
        } else {
            X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = true; opcode = X86_OP_MOVZX_R32_RM16; byte_reg = false }
        }
        B => if sign {
            X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = true; two_byte = true; opcode = X86_OP_MOVSX_R32_RM8; byte_reg = false }
        } else {
            X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = true; opcode = X86_OP_MOVZX_R32_RM8; byte_reg = false }
        }
        F64 => X86MemOp { op66 = false; mandatory_prefix = X86_PREFIX_F2; rexw = false; two_byte = true; opcode = X86_OP_SSE_MOV_LOAD; byte_reg = false }
        F32 => X86MemOp { op66 = false; mandatory_prefix = X86_PREFIX_F3; rexw = false; two_byte = true; opcode = X86_OP_SSE_MOV_LOAD; byte_reg = false }
    }
}

fn store_memop_x86(size: MMemSizeX86): X86MemOp {
    match size {
        Q => X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = true; two_byte = false; opcode = X86_OP_MOV_RM_R; byte_reg = false }
        D => X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = false; opcode = X86_OP_MOV_RM_R; byte_reg = false }
        W => X86MemOp { op66 = true; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = false; opcode = X86_OP_MOV_RM_R; byte_reg = false }
        B => X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = false; opcode = X86_OP_MOV_RM8_R8; byte_reg = true }
        F64 => X86MemOp { op66 = false; mandatory_prefix = X86_PREFIX_F2; rexw = false; two_byte = true; opcode = X86_OP_SSE_MOV_STORE; byte_reg = false }
        F32 => X86MemOp { op66 = false; mandatory_prefix = X86_PREFIX_F3; rexw = false; two_byte = true; opcode = X86_OP_SSE_MOV_STORE; byte_reg = false }
    }
}

fn alu_opcode_x86(op: MAluOpX86): u32 {
    match op {
        Add => X86_OP_ADD_RM_R
        Sub => X86_OP_SUB_RM_R
        And => X86_OP_AND_RM_R
        Or => X86_OP_OR_RM_R
        Xor => X86_OP_XOR_RM_R
    }
}

fn shift_ext_x86(op: MShiftOpX86): u32 {
    match op {
        Shl => X86_EXT_SHL
        Shr => X86_EXT_SHR
        Sar => X86_EXT_SAR
    }
}

fn encode_movimm_x86(i: MMovImmX86): EncInstX86 {
    if !i.wide {
        var b = push_rex_x86([], false, false, false, reg_ext_x86(i.dst))
        b = push_byte_x86(b, X86_OP_MOV_R_IMM + reg_low3_x86(i.dst))
        return plain_inst_x86(push_imm32_x86(b, i.imm64))
    }
    if fits_i32_x86(i.imm64) {
        var b = push_rex_x86([], true, false, false, reg_ext_x86(i.dst))
        b = push_byte_x86(b, X86_OP_MOV_RM_IMM32)
        b = push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, 0 to u32, reg_low3_x86(i.dst)))
        return plain_inst_x86(push_imm32_x86(b, i.imm64))
    }
    var b = push_rex_x86([], true, false, false, reg_ext_x86(i.dst))
    b = push_byte_x86(b, X86_OP_MOV_R_IMM + reg_low3_x86(i.dst))
    plain_inst_x86(push_imm64_x86(b, i.imm64))
}

fn encode_mov_x86(i: MMovX86): EncInstX86 {
    plain_inst_x86(emit_rr_x86([], i.wide, false, X86_OP_MOV_RM_R, i.src, i.dst))
}

fn encode_alu_rm_x86(i: MAluRmX86): EncInstX86 {
    plain_inst_x86(emit_rr_x86([], i.wide, false, alu_opcode_x86(i.op), i.src, i.dst))
}

fn encode_imul_x86(i: MImulX86): EncInstX86 {
    plain_inst_x86(emit_rr_x86([], i.wide, true, X86_OP_IMUL_R_RM, i.dst, i.src))
}

fn encode_divseq_x86(i: MDivSeqX86): EncInstX86 {
    var rax = preg(X86_REG_RAX_ID, MRegClass::GPR)
    var rdx = preg(X86_REG_RDX_ID, MRegClass::GPR)
    var b = emit_rr_x86([], i.wide, false, X86_OP_MOV_RM_R, i.a, rax)
    if i.is_signed {
        if i.wide { b = push_byte_x86(b, REX_W_PREFIX) }
        b = push_byte_x86(b, X86_OP_CQO)
    } else {
        b = push_byte_x86(b, X86_OP_XOR_RM_R)
        b = push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, X86_REG_RDX_ID, X86_REG_RDX_ID))
    }
    var ext_field = if i.is_signed { X86_EXT_IDIV } else { X86_EXT_DIV }
    b = emit_rm_ext_x86(b, i.wide, X86_OP_GRP3_F7, ext_field, i.b)
    var srcreg = if i.is_rem { rdx } else { rax }
    plain_inst_x86(emit_rr_x86(b, i.wide, false, X86_OP_MOV_RM_R, srcreg, i.dst))
}

fn encode_shift_x86(i: MShiftX86): EncInstX86 {
    plain_inst_x86(emit_rm_ext_x86([], i.wide, X86_OP_SHIFT_CL, shift_ext_x86(i.op), i.dst))
}

fn encode_cmp_x86(i: MCmpX86): EncInstX86 {
    plain_inst_x86(emit_rr_x86([], i.wide, false, X86_OP_CMP_RM_R, i.b, i.a))
}

fn encode_setcc_raw_x86(dst: MReg, cc: u32): EncInstX86 {
    var force = dst.id >= X86_BYTE_REG_MIN_ID
    var dst_ext = reg_ext_x86(dst)
    var dst_low3 = reg_low3_x86(dst)
    var b = if force { push_rex_forced_x86([], false, false, false, dst_ext) } else { [] }
    b = push_byte_x86(b, X86_OP_TWO_BYTE_ESCAPE)
    b = push_byte_x86(b, X86_OP_SETCC_BASE + cc)
    b = push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, 0 to u32, dst_low3))
    if force { b = push_rex_forced_x86(b, false, dst_ext, false, dst_ext) }
    b = push_byte_x86(b, X86_OP_TWO_BYTE_ESCAPE)
    b = push_byte_x86(b, X86_OP_MOVZX_R32_RM8)
    plain_inst_x86(push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, dst_low3, dst_low3)))
}

fn encode_setcc_x86(i: MSetccX86): EncInstX86 {
    encode_setcc_raw_x86(i.dst, cond_cc_x86(i.cond))
}

fn encode_setp_x86(i: MSetPX86): EncInstX86 {
    encode_setcc_raw_x86(i.dst, if i.is_np { X86_CC_NP } else { X86_CC_P })
}

fn encode_falu_x86(i: MFAluX86): EncInstX86 {
    var prefix = if i.dbl { X86_PREFIX_F2 } else { X86_PREFIX_F3 }
    var opcode = match i.op { FAdd => X86_OP_SSE_ADD; FSub => X86_OP_SSE_SUB; FMul => X86_OP_SSE_MUL; FDiv => X86_OP_SSE_DIV }
    plain_inst_x86(emit_sse_rr_x86([], prefix, false, opcode, i.dst, i.src))
}

fn encode_fmov_x86(i: MFMovX86): EncInstX86 {
    var dst_fpr = i.dst.reg_class == MRegClass::FPR
    var src_fpr = i.src.reg_class == MRegClass::FPR
    if dst_fpr && src_fpr {
        var prefix = if i.dbl { X86_PREFIX_F2 } else { X86_PREFIX_F3 }
        return plain_inst_x86(emit_sse_rr_x86([], prefix, false, X86_OP_SSE_MOV_LOAD, i.dst, i.src))
    }
    if dst_fpr && !src_fpr {
        return plain_inst_x86(emit_sse_rr_x86([], X86_PREFIX_66, i.dbl, X86_OP_MOVQD_LOAD, i.dst, i.src))
    }
    if !dst_fpr && src_fpr {
        return plain_inst_x86(emit_sse_rr_x86([], X86_PREFIX_66, i.dbl, X86_OP_MOVQD_STORE, i.src, i.dst))
    }
    plain_inst_x86(emit_rr_x86([], i.dbl, false, X86_OP_MOV_RM_R, i.src, i.dst))
}

fn encode_fcmp_x86(i: MFCmpX86): EncInstX86 {
    var prefix = if i.dbl { X86_PREFIX_66 } else { X86_NO_PREFIX }
    plain_inst_x86(emit_sse_rr_x86([], prefix, false, X86_OP_UCOMIS, i.a, i.b))
}

fn encode_cvt_x86(i: MCvtX86): EncInstX86 {
    match i.op {
        Cvtsi2sd => plain_inst_x86(emit_sse_rr_x86([], X86_PREFIX_F2, true, X86_OP_CVTSI2S, i.dst, i.src))
        Cvttsd2si => plain_inst_x86(emit_sse_rr_x86([], X86_PREFIX_F2, true, X86_OP_CVTTS2SI, i.dst, i.src))
        Cvttss2si => plain_inst_x86(emit_sse_rr_x86([], X86_PREFIX_F3, true, X86_OP_CVTTS2SI, i.dst, i.src))
        Cvtsd2ss => plain_inst_x86(emit_sse_rr_x86([], X86_PREFIX_F2, false, X86_OP_CVTS2S, i.dst, i.src))
        Cvtss2sd => plain_inst_x86(emit_sse_rr_x86([], X86_PREFIX_F3, false, X86_OP_CVTS2S, i.dst, i.src))
    }
}

fn encode_neg_x86(i: MNegX86): EncInstX86 {
    plain_inst_x86(emit_rm_ext_x86([], i.wide, X86_OP_GRP3_F7, X86_EXT_NEG, i.dst))
}

fn encode_not_x86(i: MNotX86): EncInstX86 {
    plain_inst_x86(emit_rm_ext_x86([], i.wide, X86_OP_GRP3_F7, X86_EXT_NOT, i.dst))
}

fn encode_load_x86(i: MLoadX86): EncInstX86 {
    emit_mem_op_x86(load_memop_x86(i.size, i.sign), i.dst, i.mem)
}

fn encode_store_x86(i: MStoreX86): EncInstX86 {
    emit_mem_op_x86(store_memop_x86(i.size), i.src, i.mem)
}

const RSP_BASE_X86: MReg = preg(X86_REG_RSP_ID, MRegClass::GPR)

fn in_arg_base_x86(layout: FrameLayoutX86): u32 {
    if !frame_is_framed_x86(layout) { return X86_GPR_BYTES + layout.caller_shadow }
    var n_saved = layout.saved_gpr.len to u32
    (2 to u32) * X86_GPR_BYTES + (n_saved * X86_GPR_BYTES) + layout.size + layout.caller_shadow
}

fn encode_fspill_x86(layout: FrameLayoutX86, i: MFSpillX86): EncInstX86 {
    var mem = MMem { base_reg = RSP_BASE_X86; offset = layout.slot_offsets[i.slot] to i32 }
    var form = if i.is_load { load_memop_x86(MMemSizeX86::F64, false) } else { store_memop_x86(MMemSizeX86::F64) }
    emit_mem_op_x86(form, i.reg, mem)
}

fn encode_out_arg_x86(layout: FrameLayoutX86, i: MOutArgX86): EncInstX86 {
    var off = layout.out_arg_base + (i.index * X86_GPR_BYTES)
    emit_mem_op_x86(store_memop_x86(i.size), i.src, MMem { base_reg = RSP_BASE_X86; offset = off to i32 })
}

fn encode_in_arg_x86(layout: FrameLayoutX86, i: MInArgX86): EncInstX86 {
    var off = in_arg_base_x86(layout) + (i.index * X86_GPR_BYTES)
    emit_mem_op_x86(load_memop_x86(i.size, false), i.dst, MMem { base_reg = RSP_BASE_X86; offset = off to i32 })
}

fn encode_frame_addr_x86(layout: FrameLayoutX86, i: MFrameAddrX86): EncInstX86 {
    var off = layout.slot_offsets[i.slot]
    var mem = MMem { base_reg = RSP_BASE_X86; offset = off to i32 }
    var b = push_rex_x86([], true, reg_ext_x86(i.dst), false, reg_ext_x86(mem.base_reg))
    b = push_byte_x86(b, X86_OP_LEA)
    plain_inst_x86(push_mem_operand_x86(b, reg_low3_x86(i.dst), mem))
}

fn encode_lea_rip_x86(i: MLeaRipX86): EncInstX86 {
    var b = push_rex_forced_x86([], true, reg_ext_x86(i.dst), false, false)
    b = push_byte_x86(b, X86_OP_LEA)
    b = push_byte_x86(b, modrm_x86(MODRM_MOD_INDIRECT, reg_low3_x86(i.dst), MODRM_RM_RIP_RELATIVE))
    var field_off = b.len to u32
    reloc_inst_x86(emit_u32_le(b, 0 to u32), field_off, i.sym, i.kind)
}

fn encode_jmp_x86(i: MJmpX86): EncInstX86 {
    var b = push_byte_x86([], X86_OP_JMP_REL32)
    var field_off = b.len to u32
    branch_inst_x86(emit_u32_le(b, 0 to u32), field_off, i.target)
}

fn encode_jcc_x86(i: MJccX86): EncInstX86 {
    var b = push_byte_x86([], X86_OP_TWO_BYTE_ESCAPE)
    b = push_byte_x86(b, X86_OP_JCC_BASE + cond_cc_x86(i.cond))
    var field_off = b.len to u32
    branch_inst_x86(emit_u32_le(b, 0 to u32), field_off, i.target)
}

fn encode_call_x86(i: MCallX86): EncInstX86 {
    var b = push_byte_x86([], X86_OP_CALL_REL32)
    var field_off = b.len to u32
    reloc_inst_x86(emit_u32_le(b, 0 to u32), field_off, i.sym, RelocKindX86::Plt32)
}

fn encode_call_ind_x86(i: MCallIndX86): EncInstX86 {
    var b = push_rex_x86([], false, false, false, reg_ext_x86(i.target))
    b = push_byte_x86(b, X86_OP_GRP5_FF)
    plain_inst_x86(push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, X86_EXT_CALL_IND, reg_low3_x86(i.target))))
}

fn encode_ret_x86(): EncInstX86 {
    plain_inst_x86(push_byte_x86([], X86_OP_RET))
}

fn encode_syscall_x86(i: MSyscallX86): EncInstX86 {
    var b = push_byte_x86([], X86_OP_TWO_BYTE_ESCAPE)
    plain_inst_x86(push_byte_x86(b, X86_OP_SYSCALL))
}

fn atomic_mem_x86(): MMem {
    MMem { base_reg = preg(1 to u32, MRegClass::GPR); offset = 0 to i32 }
}

fn atomic_form_x86(kind: lir::LAtomicKind): X86MemOp {
    match kind {
        Cas => X86MemOp { op66 = false; mandatory_prefix = X86_PREFIX_LOCK; rexw = false; two_byte = true; opcode = X86_OP_CMPXCHG_RM_R; byte_reg = false }
        Add => X86MemOp { op66 = false; mandatory_prefix = X86_PREFIX_LOCK; rexw = false; two_byte = true; opcode = X86_OP_XADD_RM_R; byte_reg = false }
        Xchg => X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = false; opcode = X86_OP_XCHG_RM_R; byte_reg = false }
        Load => X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = false; opcode = X86_OP_MOV_R_RM; byte_reg = false }
    }
}

fn atomic_reg_x86(kind: lir::LAtomicKind): MReg {
    match kind {
        Cas => preg(X86_REG_RDX_ID, MRegClass::GPR)
        _ => preg(X86_REG_RAX_ID, MRegClass::GPR)
    }
}

fn encode_atomic_x86(i: MAtomicX86): EncInstX86 {
    emit_mem_op_x86(atomic_form_x86(i.kind), atomic_reg_x86(i.kind), atomic_mem_x86())
}

pub fn encode_inst_x86(layout: FrameLayoutX86, inst: @MInstX86()): EncInstX86 | error {
    match inst {
        MMovImmX86 as x => encode_movimm_x86(x)
        MMovX86 as x => encode_mov_x86(x)
        MAluRmX86 as x => encode_alu_rm_x86(x)
        MImulX86 as x => encode_imul_x86(x)
        MDivSeqX86 as x => encode_divseq_x86(x)
        MShiftX86 as x => encode_shift_x86(x)
        MCmpX86 as x => encode_cmp_x86(x)
        MSetccX86 as x => encode_setcc_x86(x)
        MJccX86 as x => encode_jcc_x86(x)
        MNegX86 as x => encode_neg_x86(x)
        MNotX86 as x => encode_not_x86(x)
        MLoadX86 as x => encode_load_x86(x)
        MStoreX86 as x => encode_store_x86(x)
        MFrameAddrX86 as x => encode_frame_addr_x86(layout, x)
        MLeaRipX86 as x => encode_lea_rip_x86(x)
        MJmpX86 as x => encode_jmp_x86(x)
        MCallX86 as x => encode_call_x86(x)
        MCallIndX86 as x => encode_call_ind_x86(x)
        MSyscallX86 as x => encode_syscall_x86(x)
        MAtomicX86 as x => encode_atomic_x86(x)
        MRetX86 => encode_ret_x86()
        MFAluX86 as x => encode_falu_x86(x)
        MFMovX86 as x => encode_fmov_x86(x)
        MFCmpX86 as x => encode_fcmp_x86(x)
        MSetPX86 as x => encode_setp_x86(x)
        MCvtX86 as x => encode_cvt_x86(x)
        MOutArgX86 as x => encode_out_arg_x86(layout, x)
        MInArgX86 as x => encode_in_arg_x86(layout, x)
        MFSpillX86 as x => encode_fspill_x86(layout, x)
    }
}

fn scan_inst_saved_x86(abi: AbiDescriptor, acc0: Saved, inst: @MInstX86()): Saved {
    var ir = inst_regs_x86(inst)
    var acc = acc0
    if ir.has_def {
        acc = consider_reg(abi, acc, ir.def_reg)
    }
    var i: u64 = 0
    loop {
        if i >= ir.uses.len { break }
        acc = consider_reg(abi, acc, ir.uses[i])
        i++
    }
    acc
}

fn scan_block_saved_x86(abi: AbiDescriptor, acc0: Saved, b: MBlockX86): Saved {
    var acc = acc0
    var it = b.insts.iter()
    loop {
        match it.next() {
            MInstX86Node as n => { acc = scan_inst_saved_x86(abi, acc, n.op) }
            null => break
        }
    }
    acc
}

fn collect_callee_saved_x86(abi: AbiDescriptor, f: MFuncX86): Saved {
    var acc = Saved { gpr = []; fpr = [] }
    var it = f.blocks.iter()
    loop {
        match it.next() {
            MBlockX86 as b => { acc = scan_block_saved_x86(abi, acc, b) }
            null => break
        }
    }
    acc
}

fn shift_slot_offsets_x86(offsets: []u32, delta: u32): []u32 {
    var out: [offsets.len]u32 = []
    var i: u64 = 0
    loop {
        if i >= offsets.len { break }
        out[i] = offsets[i] + delta
        i++
    }
    out
}

fn frame_sub_size_x86(reserved: u32, n_pushed: u32): u32 {
    var framed = (reserved > (0 to u32)) || (n_pushed > (0 to u32))
    if !framed { return 0 to u32 }
    align_up(reserved + (n_pushed * X86_GPR_BYTES), X86_STACK_ALIGN) - (n_pushed * X86_GPR_BYTES)
}

fn inst_is_call_x86(i: @MInstX86()): bool {
    match i {
        MCallX86 => true
        MCallIndX86 => true
        _ => false
    }
}

fn block_makes_call_x86(b: MBlockX86): bool {
    var found = false
    var it = b.insts.iter()
    loop {
        match it.next() {
            MInstX86Node as n => { if inst_is_call_x86(n.op) { found = true; break } }
            null => break
        }
    }
    found
}

fn func_makes_call_x86(f: MFuncX86): bool {
    var found = false
    var it = f.blocks.iter()
    loop {
        match it.next() {
            MBlockX86 as b => { if block_makes_call_x86(b) { found = true; break } }
            null => break
        }
    }
    found
}

fn block_any_ret_x86(b: MBlockX86): bool {
    var found = false
    var it = b.insts.iter()
    loop {
        match it.next() {
            MInstX86Node as n => { if is_ret_x86(n.op) { found = true; break } }
            null => break
        }
    }
    found
}

fn func_any_ret_x86(f: MFuncX86): bool {
    var found = false
    var it = f.blocks.iter()
    loop {
        match it.next() {
            MBlockX86 as b => { if block_any_ret_x86(b) { found = true; break } }
            null => break
        }
    }
    found
}

fn needs_call_align_x86(f: MFuncX86): bool {
    func_makes_call_x86(f) && func_any_ret_x86(f)
}

fn shadow_bytes_x86(abi: AbiDescriptor, f: MFuncX86): u32 {
    if abi.shadow_space == (0 to u32) { return 0 to u32 }
    if !func_makes_call_x86(f) { return 0 to u32 }
    abi.shadow_space
}

fn out_arg_bytes_x86(f: MFuncX86): u32 {
    var n = max_out_arg_slots_x86(f)
    if n == (0 to u32) { return 0 to u32 }
    align_up(n * X86_GPR_BYTES, X86_STACK_ALIGN)
}

fn max_out_arg_slots_x86(f: MFuncX86): u32 {
    var slots: u32 = 0
    var bit = f.blocks.iter()
    loop {
        match bit.next() {
            MBlockX86 as b => {
                var iit = b.insts.iter()
                loop {
                    match iit.next() {
                        MInstX86Node as n => {
                            var need = out_arg_slots_of_inst_x86(n.op)
                            if need > slots { slots = need }
                        }
                        null => break
                    }
                }
            }
            null => break
        }
    }
    slots
}

fn out_arg_slots_of_inst_x86(i: @MInstX86()): u32 {
    match i {
        MOutArgX86 as x => x.index + (1 to u32)
        _ => 0 to u32
    }
}

pub fn compute_frame_layout_x86(abi: AbiDescriptor, f: MFuncX86): FrameLayoutX86 {
    var saved = collect_callee_saved_x86(abi, f)
    var slots = compute_slot_offsets(f.frame)
    var shadow = shadow_bytes_x86(abi, f)
    var arg_region = shadow + out_arg_bytes_x86(f)
    var fpr_region = (saved.fpr.len to u32) * X86_XMM_SAVE_BYTES
    var size = frame_sub_size_x86(slots.slots_size + arg_region + fpr_region, (saved.gpr.len to u32))
    var slot_offsets = shift_slot_offsets_x86(slots.offsets, arg_region + fpr_region)
    FrameLayoutX86 {
        size = size
        saved_gpr = saved.gpr
        saved_fpr = saved.fpr
        slot_offsets = slot_offsets
        call_align = needs_call_align_x86(f)
        out_arg_base = shadow
        fpr_save_base = arg_region
        caller_shadow = abi.shadow_space
    }
}

fn frame_is_framed_x86(layout: FrameLayoutX86): bool {
    var n_saved = (layout.saved_gpr.len + layout.saved_fpr.len) to u32
    (layout.size > (0 to u32)) || (n_saved > (0 to u32)) || layout.call_align
}

fn honest_bigframe_x86(): error {
    error { message = "B1-bigframe: frame size exceeds the signed imm32 sub rsp field (near-N/A — sub rsp,imm32 covers 2GB)" }
}

fn emit_mov_rbp_rsp_x86(buf: []byte): []byte {
    var b = push_byte_x86(buf, REX_W_PREFIX)
    push_byte_x86(push_byte_x86(b, X86_OP_MOV_RM_R), X86_MODRM_MOV_RBP_RSP)
}

fn emit_push_reg_x86(buf: []byte, id: u32): []byte {
    var b = if (id & X86_REG_HIGH_BIT) != (0 to u32) { push_byte_x86(buf, REX_B_PREFIX) } else { buf }
    push_byte_x86(b, X86_OP_PUSH_R64 + (id & X86_FIELD3_MASK))
}

fn emit_pop_reg_x86(buf: []byte, id: u32): []byte {
    var b = if (id & X86_REG_HIGH_BIT) != (0 to u32) { push_byte_x86(buf, REX_B_PREFIX) } else { buf }
    push_byte_x86(b, X86_OP_POP_R64 + (id & X86_FIELD3_MASK))
}

fn emit_sub_rsp_x86(buf: []byte, amount: u32): []byte | error {
    if amount == (0 to u32) { return buf }
    if amount < X86_SUB_RSP_IMM8_MAX {
        var b = push_byte_x86(push_byte_x86(push_byte_x86(buf, REX_W_PREFIX), X86_OP_GRP1_IMM8), X86_MODRM_SUB_RSP)
        return push_byte_x86(b, amount)
    }
    if amount > (X86_IMM32_MAX to u32) { return honest_bigframe_x86() }
    var b = push_byte_x86(push_byte_x86(push_byte_x86(buf, REX_W_PREFIX), X86_OP_GRP1_IMM32), X86_MODRM_SUB_RSP)
    emit_u32_le(b, amount)
}

fn emit_add_rsp_x86(buf: []byte, amount: u32): []byte {
    if amount == (0 to u32) { return buf }
    if amount < X86_SUB_RSP_IMM8_MAX {
        var b = push_byte_x86(push_byte_x86(push_byte_x86(buf, REX_W_PREFIX), X86_OP_GRP1_IMM8), X86_MODRM_ADD_RSP)
        return push_byte_x86(b, amount)
    }
    var b = push_byte_x86(push_byte_x86(push_byte_x86(buf, REX_W_PREFIX), X86_OP_GRP1_IMM32), X86_MODRM_ADD_RSP)
    emit_u32_le(b, amount)
}

fn emit_saved_fpr_stores_x86(buf: []byte, layout: FrameLayoutX86, reload: bool): []byte {
    var b = buf
    var i: u64 = 0
    loop {
        if i >= layout.saved_fpr.len { break }
        var off = layout.fpr_save_base + ((i to u32) * X86_XMM_SAVE_BYTES)
        b = append_bytes(b, emit_movaps_frame_x86(layout.saved_fpr[i], off, reload).bytes)
        i++
    }
    b
}

fn emit_movaps_frame_x86(id: u32, off: u32, reload: bool): EncInstX86 {
    var opcode = if reload { X86_OP_MOVAPS_LOAD } else { X86_OP_MOVAPS_STORE }
    var form = X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = true; opcode = opcode; byte_reg = false }
    emit_mem_op_x86(form, preg(id, MRegClass::FPR), MMem { base_reg = RSP_BASE_X86; offset = off to i32 })
}

fn emit_saved_pushes_x86(buf: []byte, layout: FrameLayoutX86): []byte {
    var b = buf
    var i: u64 = 0
    loop {
        if i >= layout.saved_gpr.len { break }
        b = emit_push_reg_x86(b, layout.saved_gpr[i])
        i++
    }
    b
}

pub fn emit_prologue_x86(layout: FrameLayoutX86): []byte | error {
    if !frame_is_framed_x86(layout) {
        var none: []byte = []
        return none
    }
    var after_rbp = emit_mov_rbp_rsp_x86(emit_push_reg_x86([], X86_REG_RBP_ID))
    var after_pushes = emit_saved_pushes_x86(after_rbp, layout)
    var after_sub = match emit_sub_rsp_x86(after_pushes, layout.size) { []byte as w => w; error as e => return e }
    emit_saved_fpr_stores_x86(after_sub, layout, false)
}

fn emit_epilogue_x86(layout: FrameLayoutX86): []byte {
    if !frame_is_framed_x86(layout) {
        var none: []byte = []
        return none
    }
    var after_fpr = emit_saved_fpr_stores_x86([], layout, true)
    var b = if layout.saved_gpr.len > (0 to u64) { emit_add_rsp_x86(after_fpr, layout.size) } else { after_fpr }
    var i: u64 = layout.saved_gpr.len
    loop {
        if i == (0 to u64) { break }
        i = i - (1 to u64)
        b = emit_pop_reg_x86(b, layout.saved_gpr[i])
    }
    push_byte_x86(b, X86_OP_LEAVE)
}

pub type RelocX86 = struct {
    offset: u32
    sym: str
    kind: RelocKindX86
    addend: i64
    sect: RelocSect
}

pub type EncodedFuncX86 = struct {
    symbol: str
    bytes: []byte
    relocs: []RelocX86
}

pub type EncodedModuleX86 = struct {
    text: []byte
    rodata: []byte
    symbols: []Symbol
    relocs: []RelocX86
}

type BlockOffsetX86 = struct {
    id: u32
    byte: u32
}

type BranchFixupX86 = struct {
    field_off: u32
    target: u32
}

type FuncEmitX86 = struct {
    bytes: []byte
    block_offsets: []BlockOffsetX86
    branch_fixups: []BranchFixupX86
    relocs: []RelocX86
}

fn honest_farbranch_x86(): error {
    error { message = "B1-farbranch: rel32 branch displacement out of the signed 32-bit field (internal invariant — real functions are tiny)" }
}

fn honest_badblock_x86(): error {
    error { message = "B1-badblock: branch target block id not found in the function (internal invariant)" }
}

fn honest_globals_x86(): error {
    error { message = "B1-globals: .data/.bss section + R_X86_64_64 data relocs deferred (the N2 subset lowers no LGlobal)" }
}

fn reloc_addend_x86(kind: RelocKindX86): i64 {
    match kind {
        Plt32 => (0) - X86_REL32_FIELD_BYTES
        Pc32 => (0) - X86_REL32_FIELD_BYTES
        Abs64 => 0
    }
}

fn byte_of_u32_le(value: u32, k: u32): byte {
    ((value >> (k * X86_BITS_PER_BYTE)) & X86_BYTE_MASK) to byte
}

fn write_u32_le_at(buf: []byte, offset: u32, value: u32): []byte {
    var out = buf
    var k: u32 = 0
    loop {
        if k >= (X86_REL32_FIELD_BYTES to u32) { break }
        out[(offset + k) to u64] = byte_of_u32_le(value, k)
        k++
    }
    out
}

fn lookup_block_offset_x86(offsets: []BlockOffsetX86, id: u32): u32 | error {
    var i: u64 = 0
    loop {
        if i >= offsets.len { break }
        if offsets[i].id == id { return offsets[i].byte }
        i++
    }
    honest_badblock_x86()
}

fn collect_inst_reloc_x86(acc: []RelocX86, reloc: EncRelocX86 | null, start: u32): []RelocX86 {
    match reloc {
        null => acc
        EncRelocX86 as r => [..acc, RelocX86 { offset = start + r.field_off; sym = r.sym; kind = r.kind; addend = reloc_addend_x86(r.kind); sect = RelocSect::Text }]
    }
}

fn append_enc_inst_x86(acc: FuncEmitX86, ei: EncInstX86): FuncEmitX86 {
    var start = acc.bytes.len to u32
    var bytes2 = append_bytes(acc.bytes, ei.bytes)
    var fixups2 = if ei.has_branch {
        [..acc.branch_fixups, BranchFixupX86 { field_off = start + ei.branch_field_off; target = ei.target }]
    } else {
        acc.branch_fixups
    }
    var relocs2 = collect_inst_reloc_x86(acc.relocs, ei.reloc, start)
    FuncEmitX86 { bytes = bytes2; block_offsets = acc.block_offsets; branch_fixups = fixups2; relocs = relocs2 }
}

fn is_ret_x86(inst: @MInstX86()): bool {
    match inst {
        MRetX86 => true
        _ => false
    }
}

fn emit_one_x86(layout: FrameLayoutX86, acc: FuncEmitX86, inst: @MInstX86()): FuncEmitX86 | error {
    if is_ret_x86(inst) {
        var with_epi = append_bytes(acc.bytes, emit_epilogue_x86(layout))
        var with_ret = append_bytes(with_epi, encode_ret_x86().bytes)
        return FuncEmitX86 { bytes = with_ret; block_offsets = acc.block_offsets; branch_fixups = acc.branch_fixups; relocs = acc.relocs }
    }
    var ei = match encode_inst_x86(layout, inst) { EncInstX86 as x => x; error as e => return e }
    append_enc_inst_x86(acc, ei)
}

fn emit_block_x86(layout: FrameLayoutX86, acc: FuncEmitX86, blk: MBlockX86): FuncEmitX86 | error {
    var cur = acc
    var it = blk.insts.iter()
    loop {
        match it.next() {
            MInstX86Node as n => {
                cur = match emit_one_x86(layout, cur, n.op) { FuncEmitX86 as x => x; error as e => return e }
            }
            null => break
        }
    }
    cur
}

fn patch_branches_x86(raw: []byte, fixups: []BranchFixupX86, offsets: []BlockOffsetX86): []byte | error {
    var buf = raw
    var i: u64 = 0
    loop {
        if i >= fixups.len { break }
        var fx = fixups[i]
        var target_off = match lookup_block_offset_x86(offsets, fx.target) { u32 as v => v; error as e => return e }
        var disp = target_off - (fx.field_off + X86_REL32_FIELD_BYTES)
        if !fits_i32_x86(disp) { return honest_farbranch_x86() }
        var field = (disp & X86_LOW32_MASK) to u32
        buf = write_u32_le_at(buf, fx.field_off, field)
        i++
    }
    buf
}

fn record_block_offset_x86(acc: FuncEmitX86, id: u32): FuncEmitX86 {
    var off = acc.bytes.len to u32
    var block_offsets = [..acc.block_offsets, BlockOffsetX86 { id = id; byte = off }]
    FuncEmitX86 { bytes = acc.bytes; block_offsets = block_offsets; branch_fixups = acc.branch_fixups; relocs = acc.relocs }
}

pub fn encode_func_x86(abi: AbiDescriptor, f: MFuncX86): EncodedFuncX86 | error {
    var layout = compute_frame_layout_x86(abi, f)
    var pro = match emit_prologue_x86(layout) { []byte as w => w; error as e => return e }
    var acc = FuncEmitX86 { bytes = pro; block_offsets = []; branch_fixups = []; relocs = [] }
    var it = f.blocks.iter()
    loop {
        match it.next() {
            MBlockX86 as blk => {
                var with_off = record_block_offset_x86(acc, blk.id)
                acc = match emit_block_x86(layout, with_off, blk) { FuncEmitX86 as x => x; error as e => return e }
            }
            null => break
        }
    }
    var patched = match patch_branches_x86(acc.bytes, acc.branch_fixups, acc.block_offsets) { []byte as x => x; error as e => return e }
    EncodedFuncX86 { symbol = f.symbol; bytes = patched; relocs = acc.relocs }
}

pub type ModuleTextX86 = struct {
    text: []byte
    relocs: []RelocX86
    syms: []Symbol
    text_off: u32
}

pub fn empty_module_text_x86(): ModuleTextX86 {
    ModuleTextX86 { text = []; relocs = []; syms = []; text_off = 0 to u32 }
}

fn rebase_relocs_x86(acc: []RelocX86, relocs: []RelocX86, base_off: u32): []RelocX86 {
    var out: [acc.len + relocs.len]RelocX86 = []
    var a: u64 = 0
    loop {
        if a >= acc.len { break }
        out[a] = acc[a]
        a++
    }
    var i: u64 = 0
    loop {
        if i >= relocs.len { break }
        var r = relocs[i]
        out[acc.len + i] = RelocX86 { offset = r.offset + base_off; sym = r.sym; kind = r.kind; addend = r.addend; sect = r.sect }
        i++
    }
    out
}

fn fold_func_into_text_x86(abi: AbiDescriptor, acc: ModuleTextX86, f: MFuncX86): ModuleTextX86 | error {
    var ef = match encode_func_x86(abi, f) { EncodedFuncX86 as x => x; error as e => return e }
    fold_encoded_func_x86(acc, ef)
}

pub fn fold_encoded_func_x86(acc: ModuleTextX86, ef: EncodedFuncX86): ModuleTextX86 {
    var sym = Symbol { name = ef.symbol; defined = true; sect = 1 to u8; offset = acc.text_off; local = false }
    var text = append_bytes(acc.text, ef.bytes)
    var relocs = rebase_relocs_x86(acc.relocs, ef.relocs, acc.text_off)
    var syms = [..acc.syms, sym]
    var text_off = acc.text_off + (ef.bytes.len to u32)
    ModuleTextX86 { text = text; relocs = relocs; syms = syms; text_off = text_off }
}

fn encode_functions_x86(abi: AbiDescriptor, funcs: teko::collections::Chunked<MFuncX86>): ModuleTextX86 | error {
    var acc = empty_module_text_x86()
    var it = funcs.iter()
    loop {
        match it.next() {
            MFuncX86 as f => {
                acc = match fold_func_into_text_x86(abi, acc, f) { ModuleTextX86 as x => x; error as e => return e }
            }
            null => break
        }
    }
    acc
}

fn collect_undefined_x86(defined: []Symbol, relocs: []RelocX86): []Symbol {
    var undef: [relocs.len]Symbol = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= relocs.len { break }
        var name = relocs[i].sym
        var known = name_in_symbols(defined, name) || name_in_symbols(undef[0..count], name)
        if !known {
            undef[count] = Symbol { name = name; defined = false; sect = 0 to u8; offset = 0 to u32; local = false }
            count++
        }
        i++
    }
    undef[0..count]
}

fn rodata_relocs_x86(rs: []lir::LDataReloc): []RelocX86 {
    var out: [rs.len]RelocX86 = []
    var i: u64 = 0
    loop {
        if i >= rs.len { break }
        out[i] = RelocX86 { offset = rs[i].offset; sym = rs[i].target; kind = RelocKindX86::Abs64; addend = 0; sect = RelocSect::Rodata }
        i++
    }
    out
}

fn append_relocs_x86(a: []RelocX86, b: []RelocX86): []RelocX86 {
    var out: [a.len + b.len]RelocX86 = []
    var k: u64 = 0
    loop {
        if k >= a.len { break }
        out[k] = a[k]
        k++
    }
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        out[a.len + i] = b[i]
        i++
    }
    out
}

pub fn encode_module_x86(abi: AbiDescriptor, m: MModuleX86): EncodedModuleX86 | error {
    if m.globals.len > (0 to u64) { return honest_globals_x86() }
    var mt = match encode_functions_x86(abi, m.funcs) { ModuleTextX86 as x => x; error as e => return e }
    finish_encoded_module_x86(mt, m.rodata, m.globals)
}

pub fn finish_encoded_module_x86(mt: ModuleTextX86, rodata: []lir::LRodata, globals: []lir::LGlobal): EncodedModuleX86 | error {
    if globals.len > (0 to u64) { return honest_globals_x86() }
    var rod = match encode_rodata(rodata) { ModuleRodata as x => x; error as e => return e }
    var defined = concat_symbols(rod.syms, mt.syms)
    var undef = collect_undefined_x86(defined, mt.relocs)
    var symbols = concat_symbols(defined, undef)
    EncodedModuleX86 { text = mt.text; rodata = rod.bytes; symbols = symbols; relocs = append_relocs_x86(mt.relocs, rodata_relocs_x86(rod.relocs)) }
}
