use teko::lir

type VInfo = struct {
    reg_class: MRegClass
    wide: bool
}

type VInfoTable = struct {
    classes: []MRegClass
    wides: []bool
    set: []bool
}

fn vinfo_empty(): VInfoTable {
    VInfoTable { classes = []; wides = []; set = [] }
}

fn vinfo_grow(t: VInfoTable, n: u64): VInfoTable {
    var classes = t.classes
    var wides = t.wides
    var set = t.set
    loop {
        if classes.len >= n { break }
        classes = [..classes, MRegClass::GPR]
        wides = [..wides, true]
        set = [..set, false]
    }
    VInfoTable { classes = classes; wides = wides; set = set }
}

fn vinfo_set(t0: VInfoTable, id: u32, reg_class: MRegClass, wide: bool): VInfoTable {
    var grown = vinfo_grow(t0, (id to u64) + 1)
    var classes = grown.classes
    var wides = grown.wides
    var set = grown.set
    var i = id to u64
    classes[i] = reg_class
    wides[i] = wide
    set[i] = true
    VInfoTable { classes = classes; wides = wides; set = set }
}

fn vinfo_get(t: VInfoTable, id: u32): VInfo {
    var i = id to u64
    if i >= t.classes.len { return VInfo { reg_class = MRegClass::GPR; wide = true } }
    VInfo { reg_class = t.classes[i]; wide = t.wides[i] }
}

const MINST_I64_SIGN_BIT_U: u64 = 9223372036854775808

const MINST_I64_MIN: i64 = -9223372036854775807 - 1

fn decode_signed64(bits: u64): i64 {
    if bits < MINST_I64_SIGN_BIT_U { return bits to i64 }
    ((bits - MINST_I64_SIGN_BIT_U) to i64) + MINST_I64_MIN
}

type SelCtx = struct {
    func: MFunc
    vinfo: VInfoTable
    next_scratch: u32
    cur_block: u32
    next_block: u32
}

fn selctx_emit(ctx: SelCtx, inst: @MInst()): SelCtx {
    SelCtx { func = append_minst(ctx.func, ctx.cur_block, inst); vinfo = ctx.vinfo; next_scratch = ctx.next_scratch; cur_block = ctx.cur_block; next_block = ctx.next_block }
}

fn selctx_switch(ctx: SelCtx, block_id: u32): SelCtx {
    SelCtx { func = ctx.func; vinfo = ctx.vinfo; next_scratch = ctx.next_scratch; cur_block = block_id; next_block = ctx.next_block }
}

type FreshBlock = struct {
    ctx: SelCtx
    id: u32
}

fn selctx_new_block(ctx: SelCtx): FreshBlock {
    var id = ctx.next_block
    var blk = MBlock { id = id; params = []; insts = teko::collections::Chunked<MInstNode>::make() }
    var advanced = SelCtx { func = append_block(ctx.func, blk); vinfo = ctx.vinfo; next_scratch = ctx.next_scratch; cur_block = ctx.cur_block; next_block = id + 1 }
    FreshBlock { ctx = advanced; id = id }
}

fn selctx_set_vinfo(ctx: SelCtx, id: u32, reg_class: MRegClass, wide: bool): SelCtx {
    SelCtx { func = ctx.func; vinfo = vinfo_set(ctx.vinfo, id, reg_class, wide); next_scratch = ctx.next_scratch; cur_block = ctx.cur_block; next_block = ctx.next_block }
}

type FreshScratch = struct {
    ctx: SelCtx
    reg: MReg
}

fn selctx_scratch(ctx: SelCtx, reg_class: MRegClass): FreshScratch {
    var id = ctx.next_scratch
    var advanced = SelCtx { func = ctx.func; vinfo = ctx.vinfo; next_scratch = id + 1; cur_block = ctx.cur_block; next_block = ctx.next_block }
    FreshScratch { ctx = advanced; reg = vreg(id, reg_class) }
}

fn u64_bits_of(val: i64): u64 {
    if val >= (0) { return val to u64 }
    var mag = ((0) - (val + (1))) to u64 + (1 to u64)
    (MASK_ALL_U64 - mag) + (1 to u64)
}

const MASK_ALL_U64: u64 = ~(0 to u64)

fn mask32_u64(): u64 {
    MASK_ALL_U64 >> (32 to u64)
}

fn mask_for(wide: bool): u64 {
    if wide { MASK_ALL_U64 } else { mask32_u64() }
}

fn lane_count(wide: bool): u32 {
    if wide { 4 } else { 2 }
}

fn lane_shift_u32(i: u32): u32 {
    i * 16
}

fn lane_value(bits: u64, i: u32): u32 {
    var shift = i * (16 to u64)
    ((bits >> shift) & (65535 to u64)) to u32
}

fn count_nonzero_lanes(bits: u64, n: u32): u32 {
    var count: u32 = 0
    var i: u32 = 0
    loop {
        if i >= n { break }
        if lane_value(bits, i) != 0 { count++ }
        i++
    }
    count
}

fn first_nonzero_lane(bits: u64, n: u32): u32 {
    var i: u32 = 0
    loop {
        if i >= n { break }
        if lane_value(bits, i) != 0 { return i }
        i++
    }
    n
}

fn materialize_movz_chain(ctx0: SelCtx, dst: MReg, bits: u64, wide: bool, n: u32): SelCtx {
    if bits == (0 to u64) {
        return selctx_emit(ctx0, movz_inst(wide, dst, 0, 0))
    }
    var first = first_nonzero_lane(bits, n)
    var ctx = selctx_emit(ctx0, movz_inst(wide, dst, lane_value(bits, first), lane_shift_u32(first)))
    var i = first + 1
    loop {
        if i >= n { break }
        var lv = lane_value(bits, i)
        if lv != 0 { ctx = selctx_emit(ctx, movk_inst(wide, dst, lv, lane_shift_u32(i))) }
        i++
    }
    ctx
}

fn materialize_movn_chain(ctx0: SelCtx, dst: MReg, bits: u64, nbits: u64, wide: bool, n: u32): SelCtx {
    var found = first_nonzero_lane(nbits, n)
    var anchor = if found >= n { 0 } else { found }
    var ctx = selctx_emit(ctx0, movn_inst(wide, dst, lane_value(nbits, anchor), lane_shift_u32(anchor)))
    var i: u32 = 0
    loop {
        if i >= n { break }
        if i != anchor {
            var nlv = lane_value(nbits, i)
            if nlv != 0 { ctx = selctx_emit(ctx, movk_inst(wide, dst, lane_value(bits, i), lane_shift_u32(i))) }
        }
        i++
    }
    ctx
}

fn materialize_bits(ctx0: SelCtx, dst: MReg, bits: u64, wide: bool): SelCtx {
    var n = lane_count(wide)
    var nbits = (~bits) & mask_for(wide)
    var pos = count_nonzero_lanes(bits, n)
    var neg = count_nonzero_lanes(nbits, n)
    if pos <= neg { materialize_movz_chain(ctx0, dst, bits, wide, n) } else { materialize_movn_chain(ctx0, dst, bits, nbits, wide, n) }
}

fn materialize_int(ctx0: SelCtx, dst: MReg, val: i64, wide: bool): SelCtx {
    var bits = u64_bits_of(val) & mask_for(wide)
    materialize_bits(ctx0, dst, bits, wide)
}

fn select_const_int(ctx0: SelCtx, inst: lir::LInst, c: lir::LConstInt): SelCtx {
    var dst = vreg(inst.result, MRegClass::GPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::GPR, true)
    materialize_int(ctx1, dst, c.val, true)
}

fn select_const_float(ctx0: SelCtx, inst: lir::LInst, c: lir::LConstFloat): SelCtx {
    var dst = vreg(inst.result, MRegClass::FPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::FPR, c.wide)
    var scratch = selctx_scratch(ctx1, MRegClass::GPR)
    var materialized = materialize_int(scratch.ctx, scratch.reg, decode_signed64(c.bits), true)
    if c.wide {
        return selctx_emit(materialized, fmov_inst(true, dst, scratch.reg))
    }
    var staged = selctx_scratch(materialized, MRegClass::FPR)
    var ctx2 = selctx_emit(staged.ctx, fmov_inst(true, staged.reg, scratch.reg))
    selctx_emit(ctx2, cvt_inst(MCvtOp::Fcvt, dst, staged.reg, true, false))
}

fn select_alu(ctx0: SelCtx, inst: lir::LInst, op: MAluOp, a: u32, bb: u32, wide: bool): SelCtx {
    var dst = vreg(inst.result, MRegClass::GPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::GPR, wide)
    selctx_emit(ctx1, alu_inst(op, wide, dst, vreg(a, MRegClass::GPR), vreg(bb, MRegClass::GPR)))
}

fn select_rem(ctx0: SelCtx, inst: lir::LInst, op: MAluOp, a: u32, bb: u32, wide: bool): SelCtx {
    var q = selctx_scratch(ctx0, MRegClass::GPR)
    var ctx1 = selctx_emit(q.ctx, alu_inst(op, wide, q.reg, vreg(a, MRegClass::GPR), vreg(bb, MRegClass::GPR)))
    var dst = vreg(inst.result, MRegClass::GPR)
    var ctx2 = selctx_set_vinfo(ctx1, inst.result, MRegClass::GPR, wide)
    selctx_emit(ctx2, msub_inst(wide, dst, q.reg, vreg(bb, MRegClass::GPR), vreg(a, MRegClass::GPR)))
}

fn select_falu(ctx0: SelCtx, inst: lir::LInst, op: MFAluOp, a: u32, bb: u32, dbl: bool): SelCtx {
    var dst = vreg(inst.result, MRegClass::FPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::FPR, dbl)
    selctx_emit(ctx1, falu_inst(op, dbl, dst, vreg(a, MRegClass::FPR), vreg(bb, MRegClass::FPR)))
}

fn select_icmp(ctx0: SelCtx, inst: lir::LInst, cond: MCond, a: u32, bb: u32, wide: bool): SelCtx {
    var ctx1 = selctx_emit(ctx0, cmp_inst(wide, vreg(a, MRegClass::GPR), vreg(bb, MRegClass::GPR)))
    var dst = vreg(inst.result, MRegClass::GPR)
    var ctx2 = selctx_set_vinfo(ctx1, inst.result, MRegClass::GPR, false)
    selctx_emit(ctx2, cset_inst(false, dst, cond))
}

fn float_lt_cond(): MCond {
    MCond::LO
}

fn float_le_cond(): MCond {
    MCond::LS
}

fn select_fcmp(ctx0: SelCtx, inst: lir::LInst, cond: MCond, a: u32, bb: u32, dbl: bool): SelCtx {
    var ctx1 = selctx_emit(ctx0, fcmp_inst(dbl, vreg(a, MRegClass::FPR), vreg(bb, MRegClass::FPR)))
    var dst = vreg(inst.result, MRegClass::GPR)
    var ctx2 = selctx_set_vinfo(ctx1, inst.result, MRegClass::GPR, false)
    selctx_emit(ctx2, cset_inst(false, dst, cond))
}

fn select_bin(ctx0: SelCtx, f: lir::LFunc, inst: lir::LInst, b: lir::LBin): SelCtx {
    if cmp_kind_of(b.op).is_cmp && is_fused_compare(f, inst.result) {
        return ctx0
    }
    var a_info = vinfo_get(ctx0.vinfo, b.a)
    match b.op {
        lir::LBinOp::IAdd => select_alu(ctx0, inst, MAluOp::Add, b.a, b.b, a_info.wide)
        lir::LBinOp::ISub => select_alu(ctx0, inst, MAluOp::Sub, b.a, b.b, a_info.wide)
        lir::LBinOp::IMul => select_alu(ctx0, inst, MAluOp::Mul, b.a, b.b, a_info.wide)
        lir::LBinOp::IDivS => select_alu(ctx0, inst, MAluOp::Sdiv, b.a, b.b, a_info.wide)
        lir::LBinOp::IDivU => select_alu(ctx0, inst, MAluOp::Udiv, b.a, b.b, a_info.wide)
        lir::LBinOp::IRemS => select_rem(ctx0, inst, MAluOp::Sdiv, b.a, b.b, a_info.wide)
        lir::LBinOp::IRemU => select_rem(ctx0, inst, MAluOp::Udiv, b.a, b.b, a_info.wide)
        lir::LBinOp::IAnd => select_alu(ctx0, inst, MAluOp::And, b.a, b.b, a_info.wide)
        lir::LBinOp::IOr => select_alu(ctx0, inst, MAluOp::Orr, b.a, b.b, a_info.wide)
        lir::LBinOp::IXor => select_alu(ctx0, inst, MAluOp::Eor, b.a, b.b, a_info.wide)
        lir::LBinOp::IShl => select_alu(ctx0, inst, MAluOp::Lsl, b.a, b.b, a_info.wide)
        lir::LBinOp::IShrS => select_alu(ctx0, inst, MAluOp::Asr, b.a, b.b, a_info.wide)
        lir::LBinOp::IShrU => select_alu(ctx0, inst, MAluOp::Lsr, b.a, b.b, a_info.wide)
        lir::LBinOp::ICmpEq => select_icmp(ctx0, inst, MCond::EQ, b.a, b.b, a_info.wide)
        lir::LBinOp::ICmpNe => select_icmp(ctx0, inst, MCond::NE, b.a, b.b, a_info.wide)
        lir::LBinOp::ICmpLtS => select_icmp(ctx0, inst, MCond::LT, b.a, b.b, a_info.wide)
        lir::LBinOp::ICmpLtU => select_icmp(ctx0, inst, MCond::LO, b.a, b.b, a_info.wide)
        lir::LBinOp::ICmpLeS => select_icmp(ctx0, inst, MCond::LE, b.a, b.b, a_info.wide)
        lir::LBinOp::ICmpLeU => select_icmp(ctx0, inst, MCond::LS, b.a, b.b, a_info.wide)
        lir::LBinOp::ICmpGtS => select_icmp(ctx0, inst, MCond::GT, b.a, b.b, a_info.wide)
        lir::LBinOp::ICmpGtU => select_icmp(ctx0, inst, MCond::HI, b.a, b.b, a_info.wide)
        lir::LBinOp::ICmpGeS => select_icmp(ctx0, inst, MCond::GE, b.a, b.b, a_info.wide)
        lir::LBinOp::ICmpGeU => select_icmp(ctx0, inst, MCond::HS, b.a, b.b, a_info.wide)
        lir::LBinOp::FAdd => select_falu(ctx0, inst, MFAluOp::FAdd, b.a, b.b, a_info.wide)
        lir::LBinOp::FSub => select_falu(ctx0, inst, MFAluOp::FSub, b.a, b.b, a_info.wide)
        lir::LBinOp::FMul => select_falu(ctx0, inst, MFAluOp::FMul, b.a, b.b, a_info.wide)
        lir::LBinOp::FDiv => select_falu(ctx0, inst, MFAluOp::FDiv, b.a, b.b, a_info.wide)
        lir::LBinOp::FCmpEq => select_fcmp(ctx0, inst, MCond::EQ, b.a, b.b, a_info.wide)
        lir::LBinOp::FCmpNe => select_fcmp(ctx0, inst, MCond::NE, b.a, b.b, a_info.wide)
        lir::LBinOp::FCmpLt => select_fcmp(ctx0, inst, float_lt_cond(), b.a, b.b, a_info.wide)
        lir::LBinOp::FCmpLe => select_fcmp(ctx0, inst, float_le_cond(), b.a, b.b, a_info.wide)
        lir::LBinOp::FCmpGt => select_fcmp(ctx0, inst, MCond::GT, b.a, b.b, a_info.wide)
        lir::LBinOp::FCmpGe => select_fcmp(ctx0, inst, MCond::GE, b.a, b.b, a_info.wide)
    }
}

fn select_ineg(ctx0: SelCtx, inst: lir::LInst, a: u32, wide: bool): SelCtx {
    var dst = vreg(inst.result, MRegClass::GPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::GPR, wide)
    selctx_emit(ctx1, neg_inst(wide, dst, vreg(a, MRegClass::GPR)))
}

fn select_inot(ctx0: SelCtx, inst: lir::LInst, a: u32, wide: bool): SelCtx {
    var dst = vreg(inst.result, MRegClass::GPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::GPR, wide)
    selctx_emit(ctx1, mvn_inst(wide, dst, vreg(a, MRegClass::GPR)))
}

fn select_bits_cross(ctx0: SelCtx, inst: lir::LInst, a: u32, to_float: bool): SelCtx {
    var dst_class = if to_float { MRegClass::FPR } else { MRegClass::GPR }
    var src_class = if to_float { MRegClass::GPR } else { MRegClass::FPR }
    var dst = vreg(inst.result, dst_class)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, dst_class, true)
    selctx_emit(ctx1, fmov_inst(true, dst, vreg(a, src_class)))
}

fn select_fneg(ctx0: SelCtx, inst: lir::LInst, a: u32, dbl: bool): SelCtx {
    var dst = vreg(inst.result, MRegClass::FPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::FPR, dbl)
    selctx_emit(ctx1, fneg_inst(dbl, dst, vreg(a, MRegClass::FPR)))
}

fn select_identity_mov(ctx0: SelCtx, inst: lir::LInst, a: u32, wide: bool): SelCtx {
    var dst = vreg(inst.result, MRegClass::GPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::GPR, wide)
    selctx_emit(ctx1, mov_inst(wide, dst, vreg(a, MRegClass::GPR)))
}

fn select_itof(ctx0: SelCtx, inst: lir::LInst, a: u32): SelCtx {
    var dst = vreg(inst.result, MRegClass::FPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::FPR, true)
    selctx_emit(ctx1, cvt_inst(MCvtOp::Scvtf, dst, vreg(a, MRegClass::GPR), true, true))
}

fn select_ftoi(ctx0: SelCtx, inst: lir::LInst, a: u32, a_wide: bool): SelCtx {
    var dst = vreg(inst.result, MRegClass::GPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::GPR, true)
    selctx_emit(ctx1, cvt_inst(MCvtOp::Fcvtzs, dst, vreg(a, MRegClass::FPR), a_wide, true))
}

fn select_ftof(ctx0: SelCtx, inst: lir::LInst, a: u32, a_wide: bool): SelCtx {
    var dst_wide = !a_wide
    var dst = vreg(inst.result, MRegClass::FPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::FPR, dst_wide)
    selctx_emit(ctx1, cvt_inst(MCvtOp::Fcvt, dst, vreg(a, MRegClass::FPR), a_wide, dst_wide))
}

fn select_un(ctx0: SelCtx, inst: lir::LInst, u: lir::LUn): SelCtx {
    var a_info = vinfo_get(ctx0.vinfo, u.a)
    match u.op {
        lir::LUnOp::INeg => select_ineg(ctx0, inst, u.a, a_info.wide)
        lir::LUnOp::INot => select_inot(ctx0, inst, u.a, a_info.wide)
        lir::LUnOp::FNeg => select_fneg(ctx0, inst, u.a, a_info.wide)
        lir::LUnOp::Trunc => select_identity_mov(ctx0, inst, u.a, false)
        lir::LUnOp::ZExt => select_identity_mov(ctx0, inst, u.a, a_info.wide)
        lir::LUnOp::SExt => select_identity_mov(ctx0, inst, u.a, a_info.wide)
        lir::LUnOp::IToF => select_itof(ctx0, inst, u.a)
        lir::LUnOp::FToI => select_ftoi(ctx0, inst, u.a, a_info.wide)
        lir::LUnOp::FToF => select_ftof(ctx0, inst, u.a, a_info.wide)
        lir::LUnOp::IToFBits => select_bits_cross(ctx0, inst, u.a, true)
        lir::LUnOp::FToIBits => select_bits_cross(ctx0, inst, u.a, false)
    }
}

fn mregclass_of_ltype(t: lir::LType): MRegClass {
    match t {
        lir::LType::F32 => MRegClass::FPR
        lir::LType::F64 => MRegClass::FPR
        lir::LType::I8 => MRegClass::GPR
        lir::LType::I16 => MRegClass::GPR
        lir::LType::I32 => MRegClass::GPR
        lir::LType::I64 => MRegClass::GPR
        lir::LType::Ptr => MRegClass::GPR
        lir::LType::Void => MRegClass::GPR
    }
}

fn ltype_is_wide(t: lir::LType): bool {
    match t {
        lir::LType::I64 => true
        lir::LType::Ptr => true
        lir::LType::F64 => true
        lir::LType::I8 => false
        lir::LType::I16 => false
        lir::LType::I32 => false
        lir::LType::F32 => false
        lir::LType::Void => false
    }
}

fn gpr_index_before(param_types: []lir::LType, index: u32): u32 {
    var count: u32 = 0
    var i: u64 = 0
    loop {
        if i >= index { break }
        if mregclass_of_ltype(param_types[i]) == MRegClass::GPR { count++ }
        i++
    }
    count
}

fn fpr_index_before(param_types: []lir::LType, index: u32): u32 {
    var count: u32 = 0
    var i: u64 = 0
    loop {
        if i >= index { break }
        if mregclass_of_ltype(param_types[i]) == MRegClass::FPR { count++ }
        i++
    }
    count
}

fn arg_slot_size(reg_class: MRegClass, wide: bool): MMemSize {
    if reg_class == MRegClass::FPR {
        return if wide { MMemSize::D } else { MMemSize::S }
    }
    if wide { MMemSize::X } else { MMemSize::W }
}

type ParamSlot = struct {
    ok: bool
    reg: MReg
}

fn param_slot(reg_class: MRegClass, index: u32): ParamSlot {
    if index >= 8 { return ParamSlot { ok = false; reg = preg(0, reg_class) } }
    ParamSlot { ok = true; reg = preg(index, reg_class) }
}

fn select_param(ctx0: SelCtx, f: lir::LFunc, inst: lir::LInst, p: lir::LParam): SelCtx | error {
    if p.index >= f.param_types.len {
        return error { message = "isel arm64: param index out of range (internal)" }
    }
    var ty = f.param_types[p.index to u64]
    var reg_class = mregclass_of_ltype(ty)
    var wide = ltype_is_wide(ty)
    var class_index = if reg_class == MRegClass::FPR { fpr_index_before(f.param_types, p.index) } else { gpr_index_before(f.param_types, p.index) }
    var slot = param_slot(reg_class, class_index)
    var dst = vreg(inst.result, reg_class)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, reg_class, wide)
    if !slot.ok {
        var gi: u32 = 0
        var fi: u32 = 0
        var stack_n: u32 = 0
        var k: u64 = 0
        loop {
            if k >= p.index { break }
            var kc = mregclass_of_ltype(f.param_types[k])
            if kc == MRegClass::FPR {
                if fi >= 8 { stack_n++ }
                fi++
            } else {
                if gi >= 8 { stack_n++ }
                gi++
            }
            k++
        }
        return selctx_emit(ctx1, in_arg(arg_slot_size(reg_class, wide), dst, stack_n))
    }
    var mv = if reg_class == MRegClass::FPR { fmov_inst(wide, dst, slot.reg) } else { mov_inst(wide, dst, slot.reg) }
    selctx_emit(ctx1, mv)
}

fn select_ret(ctx0: SelCtx, r: lir::LRet): SelCtx {
    if !r.has_value {
        return selctx_emit(ctx0, RET_INST)
    }
    var info = vinfo_get(ctx0.vinfo, r.value)
    var pinned = preg(0, info.reg_class)
    var mv = if info.reg_class == MRegClass::FPR { fmov_inst(info.wide, pinned, vreg(r.value, MRegClass::FPR)) } else { mov_inst(info.wide, pinned, vreg(r.value, MRegClass::GPR)) }
    var ctx1 = selctx_emit(ctx0, mv)
    selctx_emit(ctx1, RET_INST)
}

type CmpKind = struct {
    is_cmp: bool
    is_float: bool
    cond: MCond
}

fn cmp_kind_of(op: lir::LBinOp): CmpKind {
    match op {
        lir::LBinOp::ICmpEq => CmpKind { is_cmp = true; is_float = false; cond = MCond::EQ }
        lir::LBinOp::ICmpNe => CmpKind { is_cmp = true; is_float = false; cond = MCond::NE }
        lir::LBinOp::ICmpLtS => CmpKind { is_cmp = true; is_float = false; cond = MCond::LT }
        lir::LBinOp::ICmpLtU => CmpKind { is_cmp = true; is_float = false; cond = MCond::LO }
        lir::LBinOp::ICmpLeS => CmpKind { is_cmp = true; is_float = false; cond = MCond::LE }
        lir::LBinOp::ICmpLeU => CmpKind { is_cmp = true; is_float = false; cond = MCond::LS }
        lir::LBinOp::ICmpGtS => CmpKind { is_cmp = true; is_float = false; cond = MCond::GT }
        lir::LBinOp::ICmpGtU => CmpKind { is_cmp = true; is_float = false; cond = MCond::HI }
        lir::LBinOp::ICmpGeS => CmpKind { is_cmp = true; is_float = false; cond = MCond::GE }
        lir::LBinOp::ICmpGeU => CmpKind { is_cmp = true; is_float = false; cond = MCond::HS }
        lir::LBinOp::FCmpEq => CmpKind { is_cmp = true; is_float = true; cond = MCond::EQ }
        lir::LBinOp::FCmpNe => CmpKind { is_cmp = true; is_float = true; cond = MCond::NE }
        lir::LBinOp::FCmpLt => CmpKind { is_cmp = true; is_float = true; cond = float_lt_cond() }
        lir::LBinOp::FCmpLe => CmpKind { is_cmp = true; is_float = true; cond = float_le_cond() }
        lir::LBinOp::FCmpGt => CmpKind { is_cmp = true; is_float = true; cond = MCond::GT }
        lir::LBinOp::FCmpGe => CmpKind { is_cmp = true; is_float = true; cond = MCond::GE }
        _ => CmpKind { is_cmp = false; is_float = false; cond = MCond::EQ }
    }
}

fn count_in_list(xs: []u32, vreg: u32): u32 {
    var n: u32 = 0
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == vreg { n++ }
        i++
    }
    n
}

fn b2n(cond: bool): u32 {
    if cond { 1 } else { 0 }
}

fn count_in_inst(inst: lir::LInst, vreg: u32): u32 {
    match inst.op {
        lir::LBin as b => b2n(b.a == vreg) + b2n(b.b == vreg)
        lir::LUn as u => b2n(u.a == vreg)
        lir::LRet as r => b2n(r.has_value && r.value == vreg)
        lir::LJump as j => count_in_list(j.args, vreg)
        lir::LBranch as br => b2n(br.cond == vreg) + count_in_list(br.t_args, vreg) + count_in_list(br.f_args, vreg)
        _ => 0 to u32
    }
}

fn count_uses(f: lir::LFunc, vreg: u32): u32 {
    var n: u32 = 0
    var bit = f.blocks.iter()
    loop {
        match bit.next() {
            lir::LBlock as b => {
                var iit = b.insts.iter()
                loop {
                    match iit.next() {
                        lir::LInst as inst => { n = n + count_in_inst(inst, vreg) }
                        null => break
                    }
                }
            }
            null => break
        }
    }
    n
}

fn used_as_branch_cond(f: lir::LFunc, vreg: u32): bool {
    var bit = f.blocks.iter()
    loop {
        match bit.next() {
            lir::LBlock as b => {
                var iit = b.insts.iter()
                loop {
                    match iit.next() {
                        lir::LInst as inst => {
                            var hit = match inst.op { lir::LBranch as br => br.cond == vreg; _ => false }
                            if hit { return true }
                        }
                        null => break
                    }
                }
            }
            null => break
        }
    }
    false
}

fn is_fused_compare(f: lir::LFunc, result: u32): bool {
    count_uses(f, result) == 1 && used_as_branch_cond(f, result)
}

type DefCmp = struct {
    found: bool
    op: lir::LBinOp
    a: u32
    bb: u32
}

fn find_cmp_def(f: lir::LFunc, vreg: u32): DefCmp {
    var bit = f.blocks.iter()
    loop {
        match bit.next() {
            lir::LBlock as b => {
                var iit = b.insts.iter()
                loop {
                    match iit.next() {
                        lir::LInst as inst => {
                            if inst.has_result && inst.result == vreg {
                                return match inst.op {
                                    lir::LBin as bo => DefCmp { found = cmp_kind_of(bo.op).is_cmp; op = bo.op; a = bo.a; bb = bo.b }
                                    _ => DefCmp { found = false; op = lir::LBinOp::IAdd; a = 0; bb = 0 }
                                }
                            }
                        }
                        null => break
                    }
                }
            }
            null => break
        }
    }
    DefCmp { found = false; op = lir::LBinOp::IAdd; a = 0; bb = 0 }
}

fn block_params_of(f: lir::LFunc, block_id: u32): []u32 {
    var it = f.blocks.iter()
    loop {
        match it.next() {
            lir::LBlock as b => {
                if b.id == block_id { return b.params }
            }
            null => break
        }
    }
    []
}

fn selctx_set_block_param(ctx: SelCtx, block_id: u32, index: u32, reg: MReg): SelCtx {
    SelCtx { func = set_block_param(ctx.func, block_id, index, reg); vinfo = ctx.vinfo; next_scratch = ctx.next_scratch; cur_block = ctx.cur_block; next_block = ctx.next_block }
}

fn emit_edge_moves(ctx0: SelCtx, f: lir::LFunc, target: u32, args: []u32): SelCtx | error {
    var params = block_params_of(f, target)
    if params.len != args.len {
        return error { message = "isel arm64: edge arg count does not match target block param count (internal)" }
    }
    var ctx = ctx0
    var i: u64 = 0
    loop {
        if i >= args.len { break }
        var src = args[i]
        var src_info = vinfo_get(ctx.vinfo, src)
        var dst = vreg(params[i], src_info.reg_class)
        var mv = if src_info.reg_class == MRegClass::FPR { fmov_inst(src_info.wide, dst, vreg(src, MRegClass::FPR)) } else { mov_inst(src_info.wide, dst, vreg(src, MRegClass::GPR)) }
        var ctx_a = selctx_emit(ctx, mv)
        var ctx_b = selctx_set_block_param(ctx_a, target, i to u32, dst)
        ctx = selctx_set_vinfo(ctx_b, params[i], src_info.reg_class, src_info.wide)
        i++
    }
    ctx
}

fn select_jump(ctx0: SelCtx, f: lir::LFunc, j: lir::LJump): SelCtx | error {
    var ctx1 = match emit_edge_moves(ctx0, f, j.target, j.args) { SelCtx as c => c; error as e => return e }
    selctx_emit(ctx1, branch_inst(j.target))
}

type EdgeRes = struct {
    ctx: SelCtx
    block: u32
}

fn resolve_edge(ctx0: SelCtx, f: lir::LFunc, target: u32, args: []u32): EdgeRes | error {
    if args.len == 0 {
        return EdgeRes { ctx = ctx0; block = target }
    }
    var saved = ctx0.cur_block
    var fb = selctx_new_block(ctx0)
    var ctx_in = selctx_switch(fb.ctx, fb.id)
    var ctx_moved = match emit_edge_moves(ctx_in, f, target, args) { SelCtx as c => c; error as e => return e }
    var ctx_end = selctx_emit(ctx_moved, branch_inst(target))
    var ctx_back = selctx_switch(ctx_end, saved)
    EdgeRes { ctx = ctx_back; block = fb.id }
}

fn select_branch(ctx0: SelCtx, f: lir::LFunc, br: lir::LBranch): SelCtx | error {
    var t_land = match resolve_edge(ctx0, f, br.t_target, br.t_args) { EdgeRes as r => r; error as e => return e }
    var f_land = match resolve_edge(t_land.ctx, f, br.f_target, br.f_args) { EdgeRes as r => r; error as e => return e }
    var ctx1 = f_land.ctx
    var dc = find_cmp_def(f, br.cond)
    var ctx2 = if dc.found && is_fused_compare(f, br.cond) {
        var ck = cmp_kind_of(dc.op)
        var a_info = vinfo_get(ctx1.vinfo, dc.a)
        var cmp = if ck.is_float { fcmp_inst(a_info.wide, vreg(dc.a, MRegClass::FPR), vreg(dc.bb, MRegClass::FPR)) } else { cmp_inst(a_info.wide, vreg(dc.a, MRegClass::GPR), vreg(dc.bb, MRegClass::GPR)) }
        var ca = selctx_emit(ctx1, cmp)
        selctx_emit(ca, branch_cond_inst(ck.cond, t_land.block))
    } else {
        var c_info = vinfo_get(ctx1.vinfo, br.cond)
        selctx_emit(ctx1, cbz_inst(c_info.wide, false, vreg(br.cond, MRegClass::GPR), t_land.block))
    }
    selctx_emit(ctx2, branch_inst(f_land.block))
}

fn mem_size_of(t: lir::LType): MMemSize | error {
    match t {
        lir::LType::I8 => MMemSize::B
        lir::LType::I16 => MMemSize::H
        lir::LType::I32 => MMemSize::W
        lir::LType::I64 => MMemSize::X
        lir::LType::Ptr => MMemSize::X
        lir::LType::F32 => MMemSize::S
        lir::LType::F64 => MMemSize::D
        lir::LType::Void => error { message = "isel arm64: a void-typed memory access is malformed (internal)" }
    }
}

fn select_alloca(ctx0: SelCtx, inst: lir::LInst, a: lir::LAlloca): SelCtx {
    var slot = ctx0.func.frame.len
    var ctx1 = SelCtx { func = append_frame(ctx0.func, a); vinfo = ctx0.vinfo; next_scratch = ctx0.next_scratch; cur_block = ctx0.cur_block; next_block = ctx0.next_block }
    var dst = vreg(inst.result, MRegClass::GPR)
    var ctx2 = selctx_set_vinfo(ctx1, inst.result, MRegClass::GPR, true)
    selctx_emit(ctx2, frame_addr_inst(dst, slot))
}

fn select_field_addr(ctx0: SelCtx, inst: lir::LInst, fa: lir::LFieldAddr): SelCtx {
    var dst = vreg(inst.result, MRegClass::GPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::GPR, true)
    selctx_emit(ctx1, alu_imm_inst(MAluOp::Add, true, dst, vreg(fa.base_vreg, MRegClass::GPR), fa.offset to i64))
}

fn select_load(ctx0: SelCtx, inst: lir::LInst, l: lir::LLoad): SelCtx | error {
    var size = match mem_size_of(l.ty) { MMemSize as s => s; error as e => return e }
    var reg_class = mregclass_of_ltype(l.ty)
    var wide = ltype_is_wide(l.ty)
    var dst = vreg(inst.result, reg_class)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, reg_class, wide)
    selctx_emit(ctx1, load_inst(size, false, dst, MMem { base_reg = vreg(l.addr, MRegClass::GPR); offset = 0 to i32 }))
}

fn select_store(ctx0: SelCtx, s: lir::LStore): SelCtx | error {
    var size = match mem_size_of(s.ty) { MMemSize as sz => sz; error as e => return e }
    var reg_class = mregclass_of_ltype(s.ty)
    selctx_emit(ctx0, store_inst(size, vreg(s.value, reg_class), MMem { base_reg = vreg(s.addr, MRegClass::GPR); offset = 0 to i32 }))
}

fn select_addr_pair(ctx0: SelCtx, inst: lir::LInst, symbol: str): SelCtx {
    var dst = vreg(inst.result, MRegClass::GPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::GPR, true)
    var ctx2 = selctx_emit(ctx1, adrp_inst(dst, symbol, MRelocKind::PageHi))
    selctx_emit(ctx2, add_lo_inst(dst, dst, symbol, MRelocKind::PageLo))
}

fn select_global_addr(ctx0: SelCtx, inst: lir::LInst, g: lir::LGlobalAddr): SelCtx {
    select_addr_pair(ctx0, inst, g.symbol)
}

fn select_func_addr(ctx0: SelCtx, inst: lir::LInst, fa: lir::LFuncAddr): SelCtx {
    select_addr_pair(ctx0, inst, fa.symbol)
}

type PinnedArgs = struct {
    ctx: SelCtx
    uses: []MReg
}

fn pin_args(ctx0: SelCtx, args: []u32, variadic: bool): PinnedArgs | error {
    if variadic {
        return error { message = "isel arm64: variadic calls not yet supported (AAPCS64 §3.5 needs the callee's fixed arity to route its tail to the stack, but LCall carries none)" }
    }
    var ctx = ctx0
    var uses: []MReg = []

    var gpr_n1: u32 = 0
    var fpr_n1: u32 = 0
    var stack_n: u32 = 0
    var i1: u64 = 0
    loop {
        if i1 >= args.len { break }
        var a = args[i1]
        var info = vinfo_get(ctx.vinfo, a)
        var is_fpr = info.reg_class == MRegClass::FPR
        var idx = if is_fpr { fpr_n1 } else { gpr_n1 }
        if idx >= 8 {
            var sz = arg_slot_size(info.reg_class, info.wide)
            ctx = selctx_emit(ctx, out_arg(sz, vreg(a, info.reg_class), stack_n))
            stack_n = stack_n + 1
        }
        if is_fpr { fpr_n1 = fpr_n1 + 1 } else { gpr_n1 = gpr_n1 + 1 }
        i1++
    }

    var gpr_n2: u32 = 0
    var fpr_n2: u32 = 0
    var i2: u64 = 0
    loop {
        if i2 >= args.len { break }
        var a = args[i2]
        var info = vinfo_get(ctx.vinfo, a)
        var is_fpr = info.reg_class == MRegClass::FPR
        var idx = if is_fpr { fpr_n2 } else { gpr_n2 }
        if idx < 8 {
            var phys = preg(idx, info.reg_class)
            var mv = if is_fpr { fmov_inst(info.wide, phys, vreg(a, MRegClass::FPR)) } else { mov_inst(info.wide, phys, vreg(a, MRegClass::GPR)) }
            ctx = selctx_emit(ctx, mv)
            uses = [..uses, phys]
        }
        if is_fpr { fpr_n2 = fpr_n2 + 1 } else { gpr_n2 = gpr_n2 + 1 }
        i2++
    }

    PinnedArgs { ctx = ctx; uses = uses }
}

fn select_call_result(ctx0: SelCtx, inst: lir::LInst, ret_reg: MReg, ret_type: lir::LType): SelCtx {
    if !inst.has_result {
        return ctx0
    }
    if mregclass_of_ltype(ret_type) == MRegClass::FPR {
        var wide = ltype_is_wide(ret_type)
        var fdst = vreg(inst.result, MRegClass::FPR)
        var fctx = selctx_set_vinfo(ctx0, inst.result, MRegClass::FPR, wide)
        return selctx_emit(fctx, fmov_inst(wide, fdst, ret_reg))
    }
    var dst = vreg(inst.result, MRegClass::GPR)
    var ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::GPR, true)
    selctx_emit(ctx1, mov_inst(true, dst, ret_reg))
}

fn call_result_reg(ret_type: lir::LType): MReg {
    preg(0, mregclass_of_ltype(ret_type))
}

fn select_call(ctx0: SelCtx, inst: lir::LInst, c: lir::LCall): SelCtx | error {
    var pinned = match pin_args(ctx0, c.args, c.variadic) { PinnedArgs as p => p; error as e => return e }
    var ret_reg = call_result_reg(c.ret_type)
    var ctx1 = selctx_emit(pinned.ctx, call_inst(c.symbol, pinned.uses, ret_reg, inst.has_result, c.variadic))
    select_call_result(ctx1, inst, ret_reg, c.ret_type)
}

fn select_call_indirect(ctx0: SelCtx, inst: lir::LInst, ci: lir::LCallIndirect): SelCtx | error {
    var pinned = match pin_args(ctx0, ci.args, ci.variadic) { PinnedArgs as p => p; error as e => return e }
    var ret_reg = call_result_reg(ci.ret_type)
    var ctx1 = selctx_emit(pinned.ctx, call_indirect_inst(vreg(ci.target, MRegClass::GPR), pinned.uses, ret_reg, inst.has_result))
    select_call_result(ctx1, inst, ret_reg, ci.ret_type)
}

fn syscall_reg_arm64(index: u64): MReg {
    if index == 0 { return preg(8, MRegClass::GPR) }
    preg((index - 1) to u32, MRegClass::GPR)
}

fn pin_syscall_args(ctx0: SelCtx, args: []u32): PinnedArgs {
    var ctx = ctx0
    var uses: [args.len]MReg = []
    var i: u64 = 0
    loop {
        if i >= args.len { break }
        var reg = syscall_reg_arm64(i)
        ctx = selctx_emit(ctx, mov_inst(true, reg, vreg(args[i], MRegClass::GPR)))
        uses[i] = reg
        i++
    }
    PinnedArgs { ctx = ctx; uses = uses }
}

fn select_syscall(ctx0: SelCtx, inst: lir::LInst, s: lir::LSyscall): SelCtx {
    var pinned = pin_syscall_args(ctx0, s.args)
    var ret_reg = preg(0, MRegClass::GPR)
    var ctx1 = selctx_emit(pinned.ctx, syscall_inst(pinned.uses, ret_reg, inst.has_result))
    select_call_result(ctx1, inst, ret_reg, lir::LType::I64)
}

fn atomic_addr_reg_arm64(): MReg { preg(3, MRegClass::GPR) }

fn atomic_a_reg_arm64(): MReg { preg(1, MRegClass::GPR) }

fn atomic_b_reg_arm64(): MReg { preg(2, MRegClass::GPR) }

fn pin_atomic_arg_arm64(ctx0: SelCtx, reg: MReg, arg: u32): SelCtx {
    selctx_emit(ctx0, mov_inst(true, reg, vreg(arg, MRegClass::GPR)))
}

fn pin_atomic_args_arm64(ctx0: SelCtx, kind: lir::LAtomicKind, args: []u32): PinnedArgs {
    var ctx = pin_atomic_arg_arm64(ctx0, atomic_addr_reg_arm64(), args[0])
    match kind {
        Load => return PinnedArgs { ctx = ctx; uses = [atomic_addr_reg_arm64()] }
        Cas => {
            var c1 = pin_atomic_arg_arm64(ctx, atomic_a_reg_arm64(), args[1])
            var c2 = pin_atomic_arg_arm64(c1, atomic_b_reg_arm64(), args[2])
            return PinnedArgs { ctx = c2; uses = [atomic_addr_reg_arm64(), atomic_a_reg_arm64(), atomic_b_reg_arm64()] }
        }
        _ => {
            var c1 = pin_atomic_arg_arm64(ctx, atomic_b_reg_arm64(), args[1])
            return PinnedArgs { ctx = c1; uses = [atomic_addr_reg_arm64(), atomic_b_reg_arm64()] }
        }
    }
}

fn select_atomic(ctx0: SelCtx, inst: lir::LInst, a: lir::LAtomicRmw): SelCtx {
    var pinned = pin_atomic_args_arm64(ctx0, a.kind, a.args)
    var ret_reg = preg(0, MRegClass::GPR)
    var ctx1 = selctx_emit(pinned.ctx, atomic_inst(a.kind, pinned.uses, ret_reg, inst.has_result))
    select_call_result(ctx1, inst, ret_reg, lir::LType::I64)
}

fn select_inst(ctx: SelCtx, f: lir::LFunc, inst: lir::LInst): SelCtx | error {
    match inst.op {
        lir::LConstInt as c => select_const_int(ctx, inst, c)
        lir::LConstFloat as c => select_const_float(ctx, inst, c)
        lir::LBin as b => select_bin(ctx, f, inst, b)
        lir::LUn as u => select_un(ctx, inst, u)
        lir::LParam as p => select_param(ctx, f, inst, p)
        lir::LRet as r => select_ret(ctx, r)
        lir::LJump as j => select_jump(ctx, f, j)
        lir::LBranch as br => select_branch(ctx, f, br)
        lir::LAlloca as a => select_alloca(ctx, inst, a)
        lir::LFieldAddr as fa => select_field_addr(ctx, inst, fa)
        lir::LLoad as l => select_load(ctx, inst, l)
        lir::LStore as s => select_store(ctx, s)
        lir::LGlobalAddr as g => select_global_addr(ctx, inst, g)
        lir::LCallIndirect as ci => select_call_indirect(ctx, inst, ci)
        lir::LFuncAddr as fa => select_func_addr(ctx, inst, fa)
        lir::LCall as c => select_call(ctx, inst, c)
        lir::LSyscall as s => select_syscall(ctx, inst, s)
        lir::LAtomicRmw as a => select_atomic(ctx, inst, a)
    }
}

fn select_insts(ctx0: SelCtx, f: lir::LFunc, insts: teko::collections::Chunked<lir::LInst>): SelCtx | error {
    var ctx = ctx0
    var it = insts.iter()
    loop {
        match it.next() {
            lir::LInst as inst => {
                var stepped = match select_inst(ctx, f, inst) { SelCtx as c => c; error as e => return e }
                ctx = stepped
            }
            null => break
        }
    }
    ctx
}

fn provisional_params(pids: []u32): []MReg {
    var out: [pids.len]MReg = []
    var i: u64 = 0
    loop {
        if i >= pids.len { break }
        out[i] = vreg(pids[i], MRegClass::GPR)
        i++
    }
    out
}

fn build_mirror_blocks(f: lir::LFunc): MFunc {
    var blocks = teko::collections::Chunked<MBlock>::make()
    var it = f.blocks.iter()
    loop {
        match it.next() {
            lir::LBlock as lb => {
                blocks.push(MBlock { id = lb.id; params = provisional_params(lb.params); insts = teko::collections::Chunked<MInstNode>::make() })
            }
            null => break
        }
    }
    MFunc { symbol = f.symbol; blocks = blocks; frame = [] }
}

fn max_block_id(f: lir::LFunc): u32 {
    var m: u32 = 0
    var it = f.blocks.iter()
    loop {
        match it.next() {
            lir::LBlock as b => { if b.id > m { m = b.id } }
            null => break
        }
    }
    m
}

fn select_all_blocks(ctx0: SelCtx, f: lir::LFunc): SelCtx | error {
    var ctx = ctx0
    var it = f.blocks.iter()
    loop {
        match it.next() {
            lir::LBlock as lb => {
                var switched = selctx_switch(ctx, lb.id)
                var stepped = match select_insts(switched, f, lb.insts) { SelCtx as c => c; error as e => return e }
                ctx = stepped
            }
            null => break
        }
    }
    ctx
}

pub fn select_lfunc(f: lir::LFunc): MFunc | error {
    var ctx0 = SelCtx { func = build_mirror_blocks(f); vinfo = vinfo_empty(); next_scratch = f.next_vreg; cur_block = 0; next_block = max_block_id(f) + 1 }
    var done = match select_all_blocks(ctx0, f) { SelCtx as c => c; error as e => return e }
    done.func
}

pub fn select_module(m: lir::LModule): MModule | error {
    var out = MModule { funcs = teko::collections::Chunked<MFunc>::make(); rodata = m.rodata; globals = m.globals; layouts = m.layouts }
    var it = m.funcs.iter()
    loop {
        match it.next() {
            lir::LFunc as f => {
                var mf = match select_lfunc(f) { MFunc as x => x; error as e => return e }
                out = add_mfunc(out, mf)
            }
            null => break
        }
    }
    out
}
