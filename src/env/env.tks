const ENV_HDR_LEN: u64 = 0

const ENV_HDR_CAP: u64 = 8

const ENV_HDR_DATA: u64 = 16

const ENV_HDR_BYTES: u64 = 24

const ENV_INIT_CAP: u64 = 16

const ENV_EQUALS: u64 = 61

/** teko::env::args — the process argv, as owned strings. */
exp extern fn args(): []str = "tk_rt_args" from "teko_rt"

/** teko::env::version — the build's version string. */
exp extern fn version(): str = "tk_rt_version" from "teko_rt"

/** teko::env::nproc — the number of logical CPUs granted to this process (always >= 1). */
exp extern fn nproc(): u64 = "tk_nproc" from "teko_rt"

fn cstr_addr(s: str): i64 {
    teko::sys::ptr_word(teko::mem::as_cstr(s))
}

fn prog_alloc(n: u64): u64 {
    teko::sys::ptr_word(teko::runtime::Arena::current().program().alloc(n)) to u64
}

fn env_copy_bytes(dst: u64, src: u64, n: u64) {
    _ = teko::runtime::rt_memcpy(dst, src, n)
}

fn copy_str_bytes(dst: u64, s: str) {
    var i: u64 = 0
    loop {
        if i >= s.len { break }
        teko::mem::store_u8(dst + i, s[i] to u64)
        i++
    }
}

fn env_cstr_len(addr: u64): u64 {
    var n: u64 = 0
    loop {
        if teko::mem::load_u8(addr + n) == 0 { break }
        n++
    }
    n
}

fn env_store_raw(src: u64, n: u64): u64 {
    var p = prog_alloc(n + 1)
    env_copy_bytes(p, src, n)
    teko::mem::store_u8(p + n, 0)
    p
}

fn env_store_kv(key: str, value: str): u64 {
    var need = key.len + 1 + value.len + 1
    var p = prog_alloc(need)
    copy_str_bytes(p, key)
    teko::mem::store_u8(p + key.len, ENV_EQUALS)
    copy_str_bytes(p + key.len + 1, value)
    teko::mem::store_u8(p + key.len + 1 + value.len, 0)
    p
}

fn env_ensure_cap(hdr: u64, want: u64) {
    var cap = teko::mem::load_u64(hdr + ENV_HDR_CAP)
    if want <= cap { return }
    var newcap = if cap == 0 { ENV_INIT_CAP } else { cap * 2 }
    loop {
        if newcap >= want { break }
        newcap = newcap * 2
    }
    var newdata = prog_alloc(newcap * 8)
    var olddata = teko::mem::load_u64(hdr + ENV_HDR_DATA)
    var len = teko::mem::load_u64(hdr + ENV_HDR_LEN)
    var i: u64 = 0
    loop {
        if i >= len { break }
        teko::mem::store_u64(newdata + i * 8, teko::mem::load_u64(olddata + i * 8))
        i++
    }
    teko::mem::store_u64(hdr + ENV_HDR_DATA, newdata)
    teko::mem::store_u64(hdr + ENV_HDR_CAP, newcap)
}

fn env_append(hdr: u64, entry: u64) {
    var len = teko::mem::load_u64(hdr + ENV_HDR_LEN)
    env_ensure_cap(hdr, len + 1)
    var data = teko::mem::load_u64(hdr + ENV_HDR_DATA)
    teko::mem::store_u64(data + len * 8, entry)
    teko::mem::store_u64(hdr + ENV_HDR_LEN, len + 1)
}

fn env_len(hdr: u64): u64 {
    teko::mem::load_u64(hdr + ENV_HDR_LEN)
}

fn env_entry(hdr: u64, i: u64): u64 {
    teko::mem::load_u64(teko::mem::load_u64(hdr + ENV_HDR_DATA) + i * 8)
}

fn entry_key_eq(entry: u64, name: str): bool {
    var i: u64 = 0
    loop {
        var c = teko::mem::load_u8(entry + i)
        if c == ENV_EQUALS || c == 0 { return i == name.len }
        if i >= name.len { return false }
        if (name[i] to u64) != c { return false }
        i++
    }
}

fn entry_eq_pos(entry: u64): u64 {
    var i: u64 = 0
    loop {
        var c = teko::mem::load_u8(entry + i)
        if c == 0 || c == ENV_EQUALS { return i }
        i++
    }
}

fn entry_value(entry: u64): str {
    var eq = entry_eq_pos(entry)
    if teko::mem::load_u8(entry + eq) != ENV_EQUALS { return "" }
    var vp = entry + eq + 1
    teko::mem::str_from_c(teko::sys::word_ptr(vp to i64), env_cstr_len(vp))
}

fn env_find(hdr: u64, name: str): u64 {
    var len = env_len(hdr)
    var i: u64 = 0
    loop {
        if i >= len { break }
        if entry_key_eq(env_entry(hdr, i), name) { return i }
        i++
    }
    len
}

fn env_header(): u64 {
    var existing = teko::runtime::environ_slot()
    if existing != 0 { return existing }
    var hdr = prog_alloc(ENV_HDR_BYTES)
    teko::mem::store_u64(hdr + ENV_HDR_LEN, 0)
    teko::mem::store_u64(hdr + ENV_HDR_CAP, 0)
    teko::mem::store_u64(hdr + ENV_HDR_DATA, 0)
    env_source_initial(hdr)
    teko::runtime::set_environ_slot(hdr)
    hdr
}

/** teko::env::var — the value of the environment variable `name`, from the program-resident overlay.
 * @return the value, or an error when unset. */
exp fn var(name: str): str | error {
    var hdr = env_header()
    var idx = env_find(hdr, name)
    if idx >= env_len(hdr) { return error { message = teko::str::concat("teko::env::var: environment variable not set: ", name) } }
    entry_value(env_entry(hdr, idx))
}

/** teko::env::set_var — bind `name` to `value` in the program-resident overlay. */
exp fn set_var(name: str, value: str): error | null {
    var hdr = env_header()
    var entry = env_store_kv(name, value)
    var idx = env_find(hdr, name)
    if idx < env_len(hdr) {
        teko::mem::store_u64(teko::mem::load_u64(hdr + ENV_HDR_DATA) + idx * 8, entry)
        return null
    }
    env_append(hdr, entry)
    null
}

/** teko::env::env_snapshot — the overlay as a null-terminated `char**` (`KEY=VALUE` pointers) in
 * `region_program`, to hand to `execve`; build it before a fork so the child inherits `set_var`. */
exp fn env_snapshot(): u64 {
    var hdr = env_header()
    var n = env_len(hdr)
    var arr = prog_alloc((n + 1) * 8)
    var i: u64 = 0
    loop {
        if i >= n { break }
        teko::mem::store_u64(arr + i * 8, env_entry(hdr, i))
        i++
    }
    teko::mem::store_u64(arr + n * 8, 0)
    arr
}

/** teko::env::unset — remove `name` from the program-resident overlay. */
exp fn unset(name: str) {
    var hdr = env_header()
    var idx = env_find(hdr, name)
    var len = env_len(hdr)
    if idx >= len { return }
    var data = teko::mem::load_u64(hdr + ENV_HDR_DATA)
    var i = idx
    loop {
        if i + 1 >= len { break }
        teko::mem::store_u64(data + i * 8, teko::mem::load_u64(data + (i + 1) * 8))
        i++
    }
    teko::mem::store_u64(hdr + ENV_HDR_LEN, len - 1)
}

#os("linux")
fn env_source_initial(hdr: u64) {
    var fd = teko::sys::syscall4(teko::sys::SYS_OPENAT, teko::sys::AT_FDCWD, cstr_addr("/proc/self/environ"), teko::sys::O_RDONLY, 0)
    if fd < 0 { return }
    var cap: u64 = 4096
    var buf = prog_alloc(cap)
    var used: u64 = 0
    loop {
        if used == cap {
            var ncap = cap * 2
            var nbuf = prog_alloc(ncap)
            env_copy_bytes(nbuf, buf, used)
            buf = nbuf
            cap = ncap
        }
        var n = teko::sys::syscall3(teko::sys::SYS_READ, fd, (buf + used) to i64, (cap - used) to i64)
        if n <= 0 { break }
        used = used + (n to u64)
    }
    _ = teko::sys::syscall1(teko::sys::SYS_CLOSE, fd)
    env_split_block(hdr, buf, used)
}

#os("linux")
fn env_split_block(hdr: u64, buf: u64, used: u64) {
    var start: u64 = 0
    var i: u64 = 0
    loop {
        if i >= used { break }
        if teko::mem::load_u8(buf + i) == 0 {
            if i > start { env_append(hdr, env_store_raw(buf + start, i - start)) }
            start = i + 1
        }
        i++
    }
    if used > start { env_append(hdr, env_store_raw(buf + start, used - start)) }
}

#os("linux")
exp fn cwd(): str | error {
    var cap: u64 = 4096
    var buf = teko::mem::buf_ptr(cap)
    var r = teko::sys::syscall2(teko::sys::SYS_GETCWD, teko::sys::ptr_word(buf), cap to i64)
    if r < 0 { return error { message = "teko::env::cwd: cannot get working directory" } }
    teko::mem::str_from_c(buf, cap)
}

#os("linux")
exp fn chdir(path: str): error | null {
    if teko::sys::syscall1(teko::sys::SYS_CHDIR, cstr_addr(path)) != 0 { return error { message = teko::str::concat("teko::env::chdir: cannot change directory to ", path) } }
    null
}

#os("macos")
fn env_source_charpp(hdr: u64, envp: u64) {
    if envp == 0 { return }
    var i: u64 = 0
    loop {
        var e = teko::mem::load_u64(envp + i * 8)
        if e == 0 { break }
        env_append(hdr, env_store_raw(e, env_cstr_len(e)))
        i++
    }
}

#os("macos")
fn env_source_initial(hdr: u64) {
    var pp = teko::sys::abi::os_ns_get_environ()
    if pp == 0 { return }
    env_source_charpp(hdr, teko::mem::load_u64(pp))
}

#os("macos")
exp fn cwd(): str | error {
    var cap: u64 = 4096
    var buf = teko::mem::buf_ptr(cap)
    var r = teko::sys::abi::os_getcwd_raw(teko::sys::ptr_word(buf) to u64, cap)
    if r == 0 { return error { message = "teko::env::cwd: cannot get working directory" } }
    teko::mem::str_from_c(buf, cap)
}

#os("macos")
exp fn chdir(path: str): error | null {
    if teko::sys::abi::os_chdir_raw(cstr_addr(path) to u64) != 0 { return error { message = teko::str::concat("teko::env::chdir: cannot change directory to ", path) } }
    null
}

#os("windows")
type WinCp = struct {
    cp: u64
    next: u64
}

#os("windows")
fn utf16_at(blk: u64, idx: u64): u64 {
    teko::mem::load_u8(blk + idx * 2) | (teko::mem::load_u8(blk + idx * 2 + 1) << 8)
}

#os("windows")
fn win_cp_at(uptr: u64, units: u64, idx: u64): WinCp {
    var u = utf16_at(uptr, idx)
    if u >= 0xD800 && u <= 0xDBFF && idx + 1 < units {
        var lo = utf16_at(uptr, idx + 1)
        if lo >= 0xDC00 && lo <= 0xDFFF {
            return WinCp { cp = 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00); next = idx + 2 }
        }
    }
    WinCp { cp = u; next = idx + 1 }
}

#os("windows")
fn cp_utf8_size(cp: u64): u64 {
    if cp < 0x80 { return 1 }
    if cp < 0x800 { return 2 }
    if cp < 0x10000 { return 3 }
    4
}

#os("windows")
fn cp_encode(dst: u64, cp: u64): u64 {
    if cp < 0x80 {
        teko::mem::store_u8(dst, cp)
        return 1
    }
    if cp < 0x800 {
        teko::mem::store_u8(dst, 0xC0 | (cp >> 6))
        teko::mem::store_u8(dst + 1, 0x80 | (cp & 0x3F))
        return 2
    }
    if cp < 0x10000 {
        teko::mem::store_u8(dst, 0xE0 | (cp >> 12))
        teko::mem::store_u8(dst + 1, 0x80 | ((cp >> 6) & 0x3F))
        teko::mem::store_u8(dst + 2, 0x80 | (cp & 0x3F))
        return 3
    }
    teko::mem::store_u8(dst, 0xF0 | (cp >> 18))
    teko::mem::store_u8(dst + 1, 0x80 | ((cp >> 12) & 0x3F))
    teko::mem::store_u8(dst + 2, 0x80 | ((cp >> 6) & 0x3F))
    teko::mem::store_u8(dst + 3, 0x80 | (cp & 0x3F))
    4
}

#os("windows")
fn win_utf8_len(uptr: u64, units: u64): u64 {
    var idx: u64 = 0
    var n: u64 = 0
    loop {
        if idx >= units { break }
        var c = win_cp_at(uptr, units, idx)
        n = n + cp_utf8_size(c.cp)
        idx = c.next
    }
    n
}

#os("windows")
fn win_store_entry(uptr: u64, units: u64): u64 {
    var n = win_utf8_len(uptr, units)
    var p = prog_alloc(n + 1)
    var idx: u64 = 0
    var w: u64 = 0
    loop {
        if idx >= units { break }
        var c = win_cp_at(uptr, units, idx)
        w = w + cp_encode(p + w, c.cp)
        idx = c.next
    }
    teko::mem::store_u8(p + n, 0)
    p
}

#os("windows")
fn win_split_block(hdr: u64, block: u64) {
    var i: u64 = 0
    loop {
        if utf16_at(block, i) == 0 { break }
        var start = i
        loop {
            if utf16_at(block, i) == 0 { break }
            i++
        }
        env_append(hdr, win_store_entry(block + start * 2, i - start))
        i++
    }
}

#os("windows")
fn env_source_initial(hdr: u64) {
    var block = teko::sys::abi::GetEnvironmentStringsW()
    if block == 0 { return }
    win_split_block(hdr, block)
    _ = teko::sys::abi::FreeEnvironmentStringsW(block)
}

#os("windows")
exp fn cwd(): str | error {
    var cap: u64 = 4096
    var buf = teko::mem::buf_ptr(cap)
    var r = teko::sys::abi::GetCurrentDirectoryA(cap to u32, teko::sys::ptr_word(buf) to u64)
    if r == 0 { return error { message = "teko::env::cwd: cannot get working directory" } }
    teko::mem::str_from_c(buf, cap)
}

#os("windows")
exp fn chdir(path: str): error | null {
    if teko::sys::abi::SetCurrentDirectoryA(cstr_addr(path) to u64) == 0 { return error { message = teko::str::concat("teko::env::chdir: cannot change directory to ", path) } }
    null
}
