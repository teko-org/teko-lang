use teko::checker
use teko::parser

type BranchSite = struct {
        line: u32
        col: u32
        n: u64
}

type CovWalk = struct {
        sites: []BranchSite
        lines: []u32
}

fn cov_walk_empty(): CovWalk { CovWalk { sites = []; lines = [] } }

fn cov_addline(w: CovWalk, line: u32): CovWalk {
    if line == 0 { return w }
    var i = 0
    loop { if i >= w.lines.len { break }; if w.lines[i] == line { return w }; i = i + 1 }
    CovWalk { sites = w.sites; lines = [..w.lines, line] }
}

fn cov_addsite(w: CovWalk, line: u32, col: u32, n: u64): CovWalk {
    CovWalk { sites = [..w.sites, BranchSite { line = line; col = col; n = n }]; lines = w.lines }
}

fn cov_walk_expr(e: checker::TExpr, w: CovWalk): CovWalk {
    var w0 = cov_addline(w, e.line)
    match e.kind {
        checker::TIfExpr as f => {
            var a1 = cov_addsite(w0, e.line, e.col, 2)
            var a2 = cov_walk_expr(f.cond, a1)
            var a3 = cov_walk_block(f.then_blk, a2)
            if f.has_else { cov_walk_block(f.else_blk, a3) } else { a3 }
        }
        checker::TMatchExpr as m => {
            var a1 = cov_addsite(w0, e.line, e.col, m.arms.len)
            var a = cov_walk_expr(m.subject, a1)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { a = cov_walk_expr(m.arms[i].guard, a) }
                a = cov_walk_block(m.arms[i].body, a)
                i++
            }
            a
        }
        checker::TBinary as b => cov_walk_expr(b.right, cov_walk_expr(b.left, w0))
        checker::TUnary as u => cov_walk_expr(u.operand, w0)
        checker::TCompare as c => {
            var a = cov_walk_expr(c.first, w0)
            var i = 0
            loop { if i >= c.rest.len { break }; a = cov_walk_expr(c.rest[i].operand, a); i++ }
            a
        }
        checker::TCall as c => {
            var a = w0
            var i = 0
            loop { if i >= c.args.len { break }; a = cov_walk_expr(c.args[i], a); i++ }
            a
        }
        checker::TCast as c => cov_walk_expr(c.expr, w0)
        checker::TFieldAccess as fa => cov_walk_expr(fa.receiver, w0)
        checker::TIndex as ix => cov_walk_expr(ix.index, cov_walk_expr(ix.receiver, w0))
        checker::TStructInit as si => {
            var a = w0
            var i = 0
            loop { if i >= si.field_vals.len { break }; a = cov_walk_expr(si.field_vals[i], a); i++ }
            a
        }
        checker::TInterp as in => {
            var a = w0
            var i = 0
            loop {
                if i >= in.holes.len { break }
                a = cov_walk_expr(in.holes[i], a)
                if i < in.specs.len {
                    match in.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; a = cov_walk_expr(fd.args[k], a); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            a
        }
        checker::TInExpr as ie => {
            var a = cov_walk_expr(ie.lhs, w0)
            var i = 0
            loop { if i >= ie.elems.len { break }; a = cov_walk_expr(ie.elems[i], a); i++ }
            a
        }
        checker::TArrayLit as al => {
            var a = w0
            var i = 0
            loop { if i >= al.elements.len { break }; a = cov_walk_expr(al.elements[i].expr, a); i++ }
            a
        }
        _ => w0
    }
}

fn cov_walk_stmt(s: @TStatement(), w: CovWalk): CovWalk {
    match s {
        checker::TBinding as b => cov_walk_expr(b.value, w)
        checker::TAssign as a => { var w2 = cov_walk_expr(a.value, w); if parser::assign_has_target(a.kind) { cov_walk_expr(a.target, w2) } else { w2 } }
        checker::TReturn as r => if r.has_value { cov_walk_expr(r.value, w) } else { w }
        checker::TLoopStmt as l => cov_walk_block(l.body, cov_walk_block(l.init, w))
        checker::TExprStmt as x => cov_walk_expr(x.expr, w)
        checker::TAdoptStmt as ad => cov_walk_block(ad.body, w)
        checker::TBlockStmt as b => cov_walk_block(b.body, w)
        _ => w
    }
}

fn cov_walk_block(stmts: []@TStatement(), w: CovWalk): CovWalk {
    var a = w
    var i = 0
    loop { if i >= stmts.len { break }; a = cov_walk_stmt(stmts[i], a); i++ }
    a
}

fn cov_rate_str(cov: u64, val: u64): str {
    if val == 0 { return "1.0" }
    var m = cov * 1000 / val
    if m >= 1000 { return "1.0" }
    var fs = teko::str::u64_to_str(m)
    loop { if fs.len >= 3 { break }; fs = teko::str::concat("0", fs) }
    teko::str::concat("0.", fs)
}

type LineBr = struct {
        taken: u64
        total: u64
}

fn cov_line_branch(sites: []BranchSite, fn_idx: u64, ln: u32): LineBr {
    var taken: u64 = 0; var total: u64 = 0
    var s = 0
    loop {
        if s >= sites.len { break }
        if sites[s].line == ln {
            var o: u64 = 0
            loop { if o >= sites[s].n { break }; if teko::cov_branch_hit(fn_idx, sites[s].line, sites[s].col, o) { taken = taken + 1 }; o = o + 1 }
            total = total + sites[s].n
        }
        s = s + 1
    }
    LineBr { taken = taken; total = total }
}

fn cov_fn_line_tally(w: CovWalk, fn_idx: u64): CovCount {
    var cov: u64 = 0
    var k = 0
    loop {
        if k >= w.lines.len { break }
        if teko::cov_line_hit(fn_idx, w.lines[k]) { cov = cov + 1 }
        k = k + 1
    }
    CovCount { cov = cov; val = w.lines.len }
}

fn cov_fn_branch_tally(w: CovWalk, fn_idx: u64): CovCount {
    var cov: u64 = 0
    var val: u64 = 0
    var s = 0
    loop {
        if s >= w.sites.len { break }
        var o: u64 = 0
        loop {
            if o >= w.sites[s].n { break }
            if teko::cov_branch_hit(fn_idx, w.sites[s].line, w.sites[s].col, o) { cov = cov + 1 }
            o = o + 1
        }
        val = val + w.sites[s].n
        s = s + 1
    }
    CovCount { cov = cov; val = val }
}

fn cov_emit_lines(buf: []byte, w: CovWalk, fn_idx: u64): []byte {
    var b = buf
    var k = 0
    loop {
        if k >= w.lines.len { break }
        var ln = w.lines[k]
        var lhit: u64 = if teko::cov_line_hit(fn_idx, ln) { 1 to u64 } else { 0 to u64 }
        var lb = cov_line_branch(w.sites, fn_idx, ln)
        if lb.total > 0 {
            var pct = lb.taken * 100 / lb.total
            b = teko::mem::append_fo(b, $"          <line number='{ln}' hits='{lhit}' branch='true' condition-coverage='{pct}% ({lb.taken}/{lb.total})'/>\n")
        } else {
            b = teko::mem::append_fo(b, $"          <line number='{ln}' hits='{lhit}'/>\n")
        }
        k = k + 1
    }
    b
}

fn cov_emit_class(buf: []byte, f: checker::TFunction, fn_idx: u64, w: CovWalk, lt: CovCount, bt: CovCount, fnhit: u64): []byte {
    cov_emit_class_fields(buf, cov_class_name(f.namespace, f.name), f.file, f.name, f.line, fn_idx, w, lt, bt, fnhit)
}

fn cov_class_name(namespace: str, name: str): str {
    if namespace.len != 0 { teko::str::concat(namespace, "::", name) } else { name }
}

fn cov_emit_class_fields(buf: []byte, cname: str, file: str, mname: str, mline: u32, fn_idx: u64, w: CovWalk, lt: CovCount, bt: CovCount, fnhit: u64): []byte {
    var lrate = cov_rate_str(lt.cov, lt.val)
    var brate = cov_rate_str(bt.cov, bt.val)
    var b = teko::mem::append_fo(buf, $"      <class name='{cname}' filename='{file}' line-rate='{lrate}' branch-rate='{brate}' complexity='0'>\n")
    b = teko::mem::append_fo(b, $"        <methods><method name='{mname}' signature='()V' line-rate='{lrate}' branch-rate='{brate}'><lines><line number='{mline}' hits='{fnhit}'/></lines></method></methods>\n")
    b = teko::mem::append_fo(b, "        <lines>\n")
    b = cov_emit_lines(b, w, fn_idx)
    teko::mem::append_fo(b, "        </lines>\n      </class>\n")
}

pub fn cov_cobertura(prog: checker::TProgram): str {
    var body: []byte = []
    var agg = CovAgg { lines_cov = 0; lines_val = 0; br_cov = 0; br_val = 0 }
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if !f.is_test && f.namespace != "teko::coverage" {
                    var w = cov_walk_block(f.body, cov_walk_empty())
                    var r = cov_render_class(body, cov_class_name(f.namespace, f.name), f.file, f.name, f.line, i to u64, w)
                    body = r.body
                    agg = cov_agg_add(agg, r.lt, r.bt)
                }
            }
            _ => { }
        }
        i++
    }
    cov_cobertura_wrap(body, agg)
}

type CovAgg = struct {
        lines_cov: u64
        lines_val: u64
        br_cov: u64
        br_val: u64
}

fn cov_agg_add(a: CovAgg, lt: CovCount, bt: CovCount): CovAgg {
    CovAgg { lines_cov = a.lines_cov + lt.cov; lines_val = a.lines_val + lt.val; br_cov = a.br_cov + bt.cov; br_val = a.br_val + bt.val }
}

type CovClassRender = struct {
        body: []byte
        lt: CovCount
        bt: CovCount
}

fn cov_render_class(body: []byte, cname: str, file: str, mname: str, mline: u32, fn_idx: u64, w: CovWalk): CovClassRender {
    var lt = cov_fn_line_tally(w, fn_idx)
    var bt = cov_fn_branch_tally(w, fn_idx)
    var fnhit: u64 = if teko::cov_is_marked(fn_idx) { 1 to u64 } else { 0 to u64 }
    var b = cov_emit_class_fields(body, cname, file, mname, mline, fn_idx, w, lt, bt, fnhit)
    CovClassRender { body = b; lt = lt; bt = bt }
}

fn cov_cobertura_wrap(body: []byte, agg: CovAgg): str {
    var lrate = cov_rate_str(agg.lines_cov, agg.lines_val)
    var brate = cov_rate_str(agg.br_cov, agg.br_val)
    var out: []byte = []
    out = teko::mem::append_fo(out, "<?xml version='1.0' ?>\n")
    out = teko::mem::append_fo(out, $"<coverage line-rate='{lrate}' branch-rate='{brate}' lines-covered='{agg.lines_cov}' lines-valid='{agg.lines_val}' branches-covered='{agg.br_cov}' branches-valid='{agg.br_val}' complexity='0' version='teko' timestamp='0'>\n")
    out = teko::mem::append_fo(out, "  <sources><source>.</source></sources>\n  <packages>\n")
    out = teko::mem::append_fo(out, $"    <package name='teko' line-rate='{lrate}' branch-rate='{brate}' complexity='0'>\n      <classes>\n")
    out = teko::mem::append_fo(out, str(body))
    out = teko::mem::append_fo(out, "      </classes>\n    </package>\n  </packages>\n</coverage>\n")
    str(out)
}

pub fn cov_merge(path: str): bool { teko::runtime::cov_merge(path) }

type CovCount = struct {
        cov: u64
        val: u64
}

fn cov_pct(c: CovCount): u64 { if c.val == 0 { 100 } else { c.cov * 100 / c.val } }

pub fn functions_coverage(prog: checker::TProgram): CovCount {
    CovCount { cov = teko::cov_distinct(); val = count_prod_fns(prog) }
}

pub fn line_coverage(prog: checker::TProgram): CovCount {
    var cov: u64 = 0; var val: u64 = 0
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if !f.is_test && f.namespace != "teko::coverage" {
                    var w = cov_walk_block(f.body, cov_walk_empty())
                    var k = 0
                    loop {
                        if k >= w.lines.len { break }
                        val = val + 1
                        if teko::cov_line_hit(i to u64, w.lines[k]) { cov = cov + 1 }
                        k = k + 1
                    }
                }
            }
            _ => { }
        }
        i++
    }
    CovCount { cov = cov; val = val }
}

pub fn branch_coverage(prog: checker::TProgram): CovCount {
    var cov: u64 = 0; var val: u64 = 0
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if !f.is_test && f.namespace != "teko::coverage" {
                    var w = cov_walk_block(f.body, cov_walk_empty())
                    var s = 0
                    loop {
                        if s >= w.sites.len { break }
                        var o: u64 = 0
                        loop {
                            if o >= w.sites[s].n { break }
                            if teko::cov_branch_hit(i to u64, w.sites[s].line, w.sites[s].col, o) { cov = cov + 1 }
                            o = o + 1
                        }
                        val = val + w.sites[s].n
                        s = s + 1
                    }
                }
            }
            _ => { }
        }
        i++
    }
    CovCount { cov = cov; val = val }
}

pub fn branch_coverage_pct(prog: checker::TProgram): u64 { cov_pct(branch_coverage(prog)) }

pub fn line_coverage_pct(prog: checker::TProgram): u64 { cov_pct(line_coverage(prog)) }

fn count_prod_fns(prog: checker::TProgram): u64 {
    var n: u64 = 0
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { if !f.is_test && f.namespace != "teko::coverage" { n = n + 1 } }
            _ => { }
        }
        i++
    }
    n
}

pub fn coverage_pct(prog: checker::TProgram): u64 { cov_pct(functions_coverage(prog)) }

const SITEMAP_MAGIC: str = "tksites"

const SITEMAP_VERSION: u64 = 1

type SiteFn = struct {
        fn_idx: u64
        namespace: str
        name: str
        file: str
        fn_line: u32
        walk: CovWalk
}

pub type SiteMap = struct {
        fns: []SiteFn
        arith_total: u64
        arith_with_conversion: u64
}

fn cov_build_sitefns(prog: checker::TProgram): []SiteFn {
    var fns: []SiteFn = []
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if !f.is_test && f.namespace != "teko::coverage" {
                    var w = cov_walk_block(f.body, cov_walk_empty())
                    fns = [..fns, SiteFn { fn_idx = i to u64; namespace = f.namespace; name = f.name; file = f.file; fn_line = f.line; walk = w }]
                }
            }
            _ => { }
        }
        i++
    }
    fns
}

pub fn cov_emit_sitemap(prog: checker::TProgram): str {
    var fns = cov_build_sitefns(prog)
    var acr = checker::arith_cast_rate_report(prog)
    var b: []byte = []
    b = teko::mem::append_fo(b, $"{SITEMAP_MAGIC} {SITEMAP_VERSION} {fns.len} {acr.total} {acr.with_conversion}\n")
    var i: u64 = 0
    loop {
        if i >= fns.len { break }
        b = cov_emit_one_sitefn(b, fns[i])
        i = i + 1
    }
    str(b)
}

fn cov_emit_one_sitefn(buf: []byte, sf: SiteFn): []byte {
    var b = teko::mem::append_fo(buf, $"{sf.fn_idx} {sf.fn_line} {sf.namespace.len} {sf.name.len} {sf.file.len} {sf.walk.lines.len} {sf.walk.sites.len}\n")
    b = teko::mem::append_fo(b, sf.namespace)
    b = teko::mem::append_fo(b, sf.name)
    b = teko::mem::append_fo(b, sf.file)
    b = teko::mem::append_fo(b, "\n")
    var k: u64 = 0
    loop {
        if k >= sf.walk.lines.len { break }
        b = teko::mem::append_fo(b, $"{sf.walk.lines[k]} ")
        k = k + 1
    }
    b = teko::mem::append_fo(b, "\n")
    var s: u64 = 0
    loop {
        if s >= sf.walk.sites.len { break }
        var st = sf.walk.sites[s]
        b = teko::mem::append_fo(b, $"{st.line} {st.col} {st.n} ")
        s = s + 1
    }
    teko::mem::append_fo(b, "\n")
}

type SmScan = struct {
        v: u64
        pos: u64
}

fn sm_is_ws(c: byte): bool { c == b' ' || c == b'\n' || c == b'\t' || c == b'\r' }

fn sm_skip_ws(s: str, p: u64): u64 {
    var q = p
    loop {
        if q >= s.len { break }
        if !sm_is_ws(s[q]) { break }
        q = q + 1
    }
    q
}

fn sm_uint(s: str, p: u64): SmScan {
    var q = sm_skip_ws(s, p)
    var n: u64 = 0
    loop {
        if q >= s.len { break }
        var c = s[q]
        if c < b'0' || c > b'9' { break }
        n = n * 10 + (c to u64) - (b'0' to u64)
        q = q + 1
    }
    SmScan { v = n; pos = q }
}

type SmFnParse = struct {
        sf: SiteFn
        pos: u64
}

fn sm_parse_fn(s: str, p: u64): SmFnParse | error {
    var fn_idx = sm_uint(s, p)
    var fn_line = sm_uint(s, fn_idx.pos)
    var ns_len = sm_uint(s, fn_line.pos)
    var name_len = sm_uint(s, ns_len.pos)
    var file_len = sm_uint(s, name_len.pos)
    var n_lines = sm_uint(s, file_len.pos)
    var n_sites = sm_uint(s, n_lines.pos)
    var bs = sm_skip_ws(s, n_sites.pos)
    var ns_end = bs + ns_len.v
    var name_end = ns_end + name_len.v
    var file_end = name_end + file_len.v
    if file_end > s.len { return error { message = "site-map: identity strings run past end of blob" } }
    var namespace = s.slice(bs, ns_end)
    var name = s.slice(ns_end, name_end)
    var file = s.slice(name_end, file_end)
    var lines: []u32 = []
    var cur = file_end
    var k: u64 = 0
    loop {
        if k >= n_lines.v { break }
        var u = sm_uint(s, cur)
        lines = [..lines, u.v to u32]
        cur = u.pos
        k = k + 1
    }
    var sites: []BranchSite = []
    var j: u64 = 0
    loop {
        if j >= n_sites.v { break }
        var ul = sm_uint(s, cur)
        var uc = sm_uint(s, ul.pos)
        var un = sm_uint(s, uc.pos)
        sites = [..sites, BranchSite { line = ul.v to u32; col = uc.v to u32; n = un.v }]
        cur = un.pos
        j = j + 1
    }
    SmFnParse { sf = SiteFn { fn_idx = fn_idx.v; namespace = namespace; name = name; file = file; fn_line = fn_line.v to u32; walk = CovWalk { sites = sites; lines = lines } }; pos = cur }
}

pub fn cov_parse_sitemap(blob: str): SiteMap | error {
    if blob.len < SITEMAP_MAGIC.len || blob.slice_to(SITEMAP_MAGIC.len) != SITEMAP_MAGIC { return error { message = "site-map: bad magic" } }
    var ver = sm_uint(blob, SITEMAP_MAGIC.len)
    if ver.v != SITEMAP_VERSION { return error { message = "site-map: unsupported version" } }
    var n = sm_uint(blob, ver.pos)
    var arith_total = sm_uint(blob, n.pos)
    var arith_with = sm_uint(blob, arith_total.pos)
    var fns: []SiteFn = []
    var cur = arith_with.pos
    var i: u64 = 0
    loop {
        if i >= n.v { break }
        match sm_parse_fn(blob, cur) {
            SmFnParse as r => { fns = [..fns, r.sf]; cur = r.pos }
            error as e => return e
        }
        i = i + 1
    }
    SiteMap { fns = fns; arith_total = arith_total.v; arith_with_conversion = arith_with.v }
}

pub fn cov_cobertura_of(sm: SiteMap): str {
    var body: []byte = []
    var agg = CovAgg { lines_cov = 0; lines_val = 0; br_cov = 0; br_val = 0 }
    var i: u64 = 0
    loop {
        if i >= sm.fns.len { break }
        var sf = sm.fns[i]
        var r = cov_render_class(body, cov_class_name(sf.namespace, sf.name), sf.file, sf.name, sf.fn_line, sf.fn_idx, sf.walk)
        body = r.body
        agg = cov_agg_add(agg, r.lt, r.bt)
        i = i + 1
    }
    cov_cobertura_wrap(body, agg)
}

pub fn cov_cobertura_from_sitemap(sitemap: str): str | error {
    match cov_parse_sitemap(sitemap) {
        SiteMap as sm => cov_cobertura_of(sm)
        error as e => e
    }
}

pub fn functions_coverage_of(sm: SiteMap): CovCount {
    CovCount { cov = teko::cov_distinct(); val = sm.fns.len }
}

pub fn line_coverage_of(sm: SiteMap): CovCount {
    var cov: u64 = 0; var val: u64 = 0
    var i: u64 = 0
    loop {
        if i >= sm.fns.len { break }
        var sf = sm.fns[i]
        var k: u64 = 0
        loop {
            if k >= sf.walk.lines.len { break }
            val = val + 1
            if teko::cov_line_hit(sf.fn_idx, sf.walk.lines[k]) { cov = cov + 1 }
            k = k + 1
        }
        i = i + 1
    }
    CovCount { cov = cov; val = val }
}

pub fn branch_coverage_of(sm: SiteMap): CovCount {
    var cov: u64 = 0; var val: u64 = 0
    var i: u64 = 0
    loop {
        if i >= sm.fns.len { break }
        var sf = sm.fns[i]
        var s: u64 = 0
        loop {
            if s >= sf.walk.sites.len { break }
            var st = sf.walk.sites[s]
            var o: u64 = 0
            loop {
                if o >= st.n { break }
                if teko::cov_branch_hit(sf.fn_idx, st.line, st.col, o) { cov = cov + 1 }
                o = o + 1
            }
            val = val + st.n
            s = s + 1
        }
        i = i + 1
    }
    CovCount { cov = cov; val = val }
}

pub fn coverage_pct_of(sm: SiteMap): u64 { cov_pct(functions_coverage_of(sm)) }

pub fn line_coverage_pct_of(sm: SiteMap): u64 { cov_pct(line_coverage_of(sm)) }

pub fn branch_coverage_pct_of(sm: SiteMap): u64 { cov_pct(branch_coverage_of(sm)) }
