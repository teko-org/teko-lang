/** One CSV record: its fields, in column order, already unquoted/unescaped. */
exp type CsvRow = struct {
    fields: []str
}

fn needs_quoting(field: str): bool {
    var bytes = field.bytes()
    var i: u64 = 0
    loop {
        if i >= bytes.len { break }
        var b = bytes[i]
        if b == b',' || b == b'"' || b == b'\n' || b == b'\r' { return true }
        i++
    }
    false
}

fn quoted_field_bytes(field: str): []byte {
    var bytes = field.bytes()
    var out: [bytes.len * 2 + 2]byte = []
    var count: u64 = 0
    out[count] = b'"'
    count++
    var i: u64 = 0
    loop {
        if i >= bytes.len { break }
        var b = bytes[i]
        out[count] = b
        count++
        if b == b'"' {
            out[count] = b'"'
            count++
        }
        i++
    }
    out[count] = b'"'
    count++
    teko::collections::arr_slice(out, 0, count)
}

fn field_bytes(field: str): []byte {
    if needs_quoting(field) { return quoted_field_bytes(field) }
    field.bytes()
}

fn row_to_bytes(row: CsvRow): []byte {
    var parts: [row.fields.len][]byte = []
    var total: u64 = 0
    var i: u64 = 0
    loop {
        if i >= row.fields.len { break }
        var fb = field_bytes(row.fields[i])
        parts[i] = fb
        total = total + fb.len
        i++
    }
    var separators = if row.fields.len > 0 { row.fields.len - 1 } else { 0 }
    var out: [total + separators + 2]byte = []
    var pos: u64 = 0
    i = 0
    loop {
        if i >= row.fields.len { break }
        if i > 0 {
            out[pos] = b','
            pos++
        }
        var fb = parts[i]
        var j: u64 = 0
        loop {
            if j >= fb.len { break }
            out[pos] = fb[j]
            pos++
            j++
        }
        i++
    }
    out[pos] = b'\r'
    pos++
    out[pos] = b'\n'
    pos++
    out
}

/** Renders `rows` as RFC 4180 CSV text (fields quoted only when required, `\r\n`-terminated). */
exp fn write_csv(rows: []CsvRow): str {
    var row_bytes: [rows.len][]byte = []
    var total: u64 = 0
    var i: u64 = 0
    loop {
        if i >= rows.len { break }
        var rb = row_to_bytes(rows[i])
        row_bytes[i] = rb
        total = total + rb.len
        i++
    }
    var out: [total]byte = []
    var pos: u64 = 0
    i = 0
    loop {
        if i >= rows.len { break }
        var rb = row_bytes[i]
        var j: u64 = 0
        loop {
            if j >= rb.len { break }
            out[pos] = rb[j]
            pos++
            j++
        }
        i++
    }
    str(out)
}

type FieldStep = struct {
    text: str
    next: u64
}

fn parse_quoted_field(input: []byte, pos: u64): FieldStep | error {
    var i = pos + 1
    var out: [input.len]byte = []
    var count: u64 = 0
    loop {
        if i >= input.len { return error { message = "csv: unterminated quoted field" } }
        var b = input[i]
        if b != b'"' {
            out[count] = b
            count++
            i++
            continue
        }
        var is_escaped_quote = i + 1 < input.len && input[i + 1] == b'"'
        if is_escaped_quote {
            out[count] = b'"'
            count++
            i = i + 2
            continue
        }
        return FieldStep { text = str(teko::collections::arr_slice(out, 0, count)); next = i + 1 }
    }
    error { message = "csv: unreachable" }
}

fn is_field_boundary(input: []byte, pos: u64): bool {
    if pos >= input.len { return true }
    var b = input[pos]
    b == b',' || b == b'\r' || b == b'\n'
}

fn parse_unquoted_field(input: []byte, pos: u64): FieldStep {
    var i = pos
    loop {
        if is_field_boundary(input, i) { break }
        i++
    }
    FieldStep { text = str_slice_bytes_view(input, pos, i); next = i }
}

fn str_slice_bytes_view(data: []byte, from: u64, to: u64): str {
    str(teko::collections::arr_slice(data, from, to))
}

fn parse_field(input: []byte, pos: u64): FieldStep | error {
    if pos < input.len && input[pos] == b'"' { return parse_quoted_field(input, pos) }
    parse_unquoted_field(input, pos)
}

fn consume_record_terminator(input: []byte, pos: u64): u64 {
    if pos >= input.len { return pos }
    if input[pos] == b'\r' && pos + 1 < input.len && input[pos + 1] == b'\n' { return pos + 2 }
    pos + 1
}

fn parse_row(input: []byte, pos: u64): RowStep | error {
    var fields: [input.len + 1]str = []
    var nfields: u64 = 0
    var i = pos
    loop {
        var step = match parse_field(input, i) { FieldStep as s => s; error as e => return e }
        fields[nfields] = step.text
        nfields++
        i = step.next
        if i >= input.len || input[i] == b'\r' || input[i] == b'\n' { break }
        i = i + 1
    }
    var after = consume_record_terminator(input, i)
    RowStep { row = CsvRow { fields = teko::collections::arr_slice(fields, 0, nfields) }; next = after }
}

type RowStep = struct {
    row: CsvRow
    next: u64
}

/** Parses `text` as an RFC 4180 CSV document into its records, in source order. */
exp fn parse_csv(text: str): []CsvRow | error {
    var input = text.bytes()
    if input.len == 0 {
        var no_rows: []CsvRow = []
        return no_rows
    }
    var rows: [input.len]CsvRow = []
    var nrows: u64 = 0
    var pos: u64 = 0
    loop {
        if pos >= input.len { break }
        var step = match parse_row(input, pos) { RowStep as s => s; error as e => return e }
        rows[nrows] = step.row
        nrows++
        pos = step.next
    }
    teko::collections::arr_slice(rows, 0, nrows)
}
