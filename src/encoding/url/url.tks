fn is_unreserved(b: byte): bool {
    if b >= b'A' && b <= b'Z' { return true }
    if b >= b'a' && b <= b'z' { return true }
    if b >= b'0' && b <= b'9' { return true }
    b == b'-' || b == b'_' || b == b'.' || b == b'~'
}

fn is_sub_delim(b: byte): bool {
    b == b'!' || b == b'$' || b == b'&' || b == b'\'' || b == b'(' || b == b')' || b == b'*' ||
    b == b'+' || b == b',' || b == b';' || b == b'='
}

fn is_path_safe(b: byte): bool {
    if is_unreserved(b) { return true }
    if is_sub_delim(b) { return true }
    b == b':' || b == b'@' || b == b'/'
}

fn is_safe_byte(b: byte, path_mode: bool): bool {
    if path_mode { return is_path_safe(b) }
    is_unreserved(b)
}

fn hex_upper_nibble(nibble: u32): byte {
    if nibble < 10 { return (b'0' to u32 + nibble) to byte }
    (b'A' to u32 + (nibble - 10)) to byte
}

fn percent_escape(b: byte): []byte {
    var v = b to u32
    [b'%', hex_upper_nibble(v >> 4), hex_upper_nibble(v & 0xF)]
}

fn encode_with(text: str, space_as_plus: bool, path_mode: bool): str {
    var input = text.bytes()
    var out: [input.len * 3]byte = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= input.len { break }
        var b = input[i]
        if space_as_plus && b == b' ' {
            out[count] = b'+'
            count++
        } else if is_safe_byte(b, path_mode) {
            out[count] = b
            count++
        } else {
            var esc = percent_escape(b)
            out[count] = esc[0]
            out[count + 1] = esc[1]
            out[count + 2] = esc[2]
            count = count + 3
        }
        i++
    }
    str(teko::collections::arr_slice(out, 0, count))
}

/** Percent-encodes `text` per RFC 3986 §2.1 (a space becomes `%20`). Total — always succeeds. */
exp fn percent_encode(text: str): str {
    encode_with(text, false, false)
}

/** Encodes `text` as one `application/x-www-form-urlencoded` component (a space becomes `+`). */
exp fn encode_form_component(text: str): str {
    encode_with(text, true, false)
}

/** Percent-encodes `text` as an RFC 3986 §3.3 path (sub-delims, `:`, `@`, `/` stay un-escaped). */
exp fn encode_path(text: str): str {
    encode_with(text, false, true)
}

fn hex_digit_value_of(c: byte): u32 | error {
    if c >= b'0' && c <= b'9' { return (c to u32) - (b'0' to u32) }
    if c >= b'a' && c <= b'f' { return (c to u32) - (b'a' to u32) + 10 }
    if c >= b'A' && c <= b'F' { return (c to u32) - (b'A' to u32) + 10 }
    error { message = "url: invalid hex digit in percent-escape" }
}

type PercentEscapeStep = struct {
    value: byte
    next: u64
}

fn decode_percent_escape(input: []byte, pos: u64): PercentEscapeStep | error {
    if pos + 2 >= input.len { return error { message = "url: truncated percent-escape" } }
    var hi = match hex_digit_value_of(input[pos + 1]) { u32 as v => v; error as e => return e }
    var lo = match hex_digit_value_of(input[pos + 2]) { u32 as v => v; error as e => return e }
    PercentEscapeStep { value = ((hi << 4) | lo) to byte; next = pos + 3 }
}

fn decode_with(text: str, plus_as_space: bool): str | error {
    var input = text.bytes()
    var out: [input.len]byte = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= input.len { break }
        var b = input[i]
        if b == b'%' {
            var step = match decode_percent_escape(input, i) { PercentEscapeStep as s => s; error as e => return e }
            out[count] = step.value
            count++
            i = step.next
            continue
        }
        if plus_as_space && b == b'+' {
            out[count] = b' '
        } else {
            out[count] = b
        }
        count++
        i++
    }
    str_from_utf8(teko::collections::arr_slice(out, 0, count))
}

/** Decodes a percent-encoded `text` per RFC 3986 (`+` stays a literal `+`). */
exp fn percent_decode(text: str): str | error {
    decode_with(text, false)
}

/** Decodes a percent-encoded RFC 3986 §3.3 path produced by `encode_path`. */
exp fn decode_path(text: str): str | error {
    percent_decode(text)
}

/** Decodes one `application/x-www-form-urlencoded` component (`+` decodes to a space). */
exp fn decode_form_component(text: str): str | error {
    decode_with(text, true)
}

/** One decoded `key=value` pair from a parsed form-urlencoded query/body string. */
exp type FormField = struct {
    key: str
    value: str
}

fn split_form_segments(body: str): []str {
    var input = body.bytes()
    var segments: [input.len + 1]str = []
    var nseg: u64 = 0
    var start: u64 = 0
    var i: u64 = 0
    loop {
        if i >= input.len { break }
        if input[i] == b'&' || input[i] == b';' {
            segments[nseg] = body.slice_chars(start to i64, i to i64)
            nseg++
            start = i + 1
        }
        i++
    }
    segments[nseg] = body.slice_chars(start to i64, input.len to i64)
    nseg++
    teko::collections::arr_slice(segments, 0, nseg)
}

fn split_key_value(segment: str): FormField {
    var input = segment.bytes()
    var i: u64 = 0
    loop {
        if i >= input.len { break }
        if input[i] == b'=' {
            return FormField { key = segment.slice_chars(0, i to i64); value = segment.slice_chars((i + 1) to i64, input.len to i64) }
        }
        i++
    }
    FormField { key = segment; value = "" }
}

fn decode_form_segment(segment: str): FormField | error {
    var raw = split_key_value(segment)
    var key = match decode_form_component(raw.key) { str as s => s; error as e => return e }
    var value = match decode_form_component(raw.value) { str as s => s; error as e => return e }
    FormField { key = key; value = value }
}

/** Parses a form-urlencoded body (or query string, `?` already stripped) into its fields, in order. */
exp fn parse_form(body: str): []FormField | error {
    if body.len == 0 {
        var no_fields: []FormField = []
        return no_fields
    }
    var segments = split_form_segments(body)
    var fields: [segments.len]FormField = []
    var i: u64 = 0
    loop {
        if i >= segments.len { break }
        var field = match decode_form_segment(segments[i]) { FormField as f => f; error as e => return e }
        fields[i] = field
        i++
    }
    fields
}

/** Renders `fields` back into one `application/x-www-form-urlencoded` body string. */
exp fn encode_form(fields: []FormField): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= fields.len { break }
        if i > 0 { out = concat(out, "&") }
        out = concat(out, encode_form_component(fields[i].key), "=", encode_form_component(fields[i].value))
        i++
    }
    out
}
