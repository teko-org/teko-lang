/** RFC 4648 Base64 alphabet: which two characters stand for 6-bit values 62/63, and padding policy. */
exp type Base64Alphabet = struct {
    char62: byte
    char63: byte
    padded: bool
}

/** The RFC 4648 §4 standard alphabet (`+`/`/`), with `=` padding. */
exp fn standard_alphabet(): Base64Alphabet {
    Base64Alphabet { char62 = b'+'; char63 = b'/'; padded = true }
}

/** The RFC 4648 §5 URL-and-filename-safe alphabet (`-`/`_`), with `=` padding. */
exp fn url_safe_alphabet(): Base64Alphabet {
    Base64Alphabet { char62 = b'-'; char63 = b'_'; padded = true }
}

/** The URL-safe alphabet without `=` padding (the `base64url`/JWT-segment form). */
exp fn url_safe_no_pad_alphabet(): Base64Alphabet {
    Base64Alphabet { char62 = b'-'; char63 = b'_'; padded = false }
}

fn base64_char_of(alphabet: Base64Alphabet, sextet: u32): byte {
    if sextet < 26 { return (b'A' to u32 + sextet) to byte }
    if sextet < 52 { return (b'a' to u32 + (sextet - 26)) to byte }
    if sextet < 62 { return (b'0' to u32 + (sextet - 52)) to byte }
    if sextet == 62 { return alphabet.char62 }
    alphabet.char63
}

fn encode_full_group(alphabet: Base64Alphabet, b0: byte, b1: byte, b2: byte): []byte {
    var n0 = b0 to u32
    var n1 = b1 to u32
    var n2 = b2 to u32
    [
        base64_char_of(alphabet, n0 >> 2),
        base64_char_of(alphabet, ((n0 & 0x3) << 4) | (n1 >> 4)),
        base64_char_of(alphabet, ((n1 & 0xF) << 2) | (n2 >> 6)),
        base64_char_of(alphabet, n2 & 0x3F),
    ]
}

fn encode_tail_group(alphabet: Base64Alphabet, b0: byte, has_b1: bool, b1: byte): []byte {
    var n0 = b0 to u32
    var out: [4]byte = []
    var count: u64 = 0
    out[count] = base64_char_of(alphabet, n0 >> 2)
    count++
    if has_b1 {
        var n1 = b1 to u32
        out[count] = base64_char_of(alphabet, ((n0 & 0x3) << 4) | (n1 >> 4))
        count++
        out[count] = base64_char_of(alphabet, (n1 & 0xF) << 2)
        count++
        if alphabet.padded {
            out[count] = b'='
            count++
        }
        return teko::collections::arr_slice(out, 0, count)
    }
    out[count] = base64_char_of(alphabet, (n0 & 0x3) << 4)
    count++
    if alphabet.padded {
        out[count] = b'='
        count++
        out[count] = b'='
        count++
    }
    teko::collections::arr_slice(out, 0, count)
}

/** Encodes `data` as Base64 text under `alphabet`. Total — always succeeds. */
exp fn encode(data: []byte, alphabet: Base64Alphabet): str {
    var full_groups = data.len / 3
    var out: [full_groups * 4 + 4]byte = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= full_groups { break }
        var grp_off = i * 3
        var g = encode_full_group(alphabet, data[grp_off], data[grp_off + 1], data[grp_off + 2])
        var j: u64 = 0
        loop {
            if j >= g.len { break }
            out[count] = g[j]
            count++
            j++
        }
        i++
    }
    var remainder = data.len - (full_groups * 3)
    var tail: []byte = []
    if remainder == 1 {
        tail = encode_tail_group(alphabet, data[full_groups * 3], false, 0 to byte)
    } else if remainder == 2 {
        tail = encode_tail_group(alphabet, data[full_groups * 3], true, data[(full_groups * 3) + 1])
    }
    var t: u64 = 0
    loop {
        if t >= tail.len { break }
        out[count] = tail[t]
        count++
        t++
    }
    str(teko::collections::arr_slice(out, 0, count))
}

/** `encode` under the standard, padded alphabet. */
exp fn encode_standard(data: []byte): str {
    encode(data, standard_alphabet())
}

/** `encode` under the URL-safe, padded alphabet. */
exp fn encode_url_safe(data: []byte): str {
    encode(data, url_safe_alphabet())
}

/** `encode` under the URL-safe, unpadded alphabet. */
exp fn encode_url_safe_no_pad(data: []byte): str {
    encode(data, url_safe_no_pad_alphabet())
}

fn base64_value_of(alphabet: Base64Alphabet, c: byte): u32 | error {
    if c >= b'A' && c <= b'Z' { return (c to u32) - (b'A' to u32) }
    if c >= b'a' && c <= b'z' { return (c to u32) - (b'a' to u32) + 26 }
    if c >= b'0' && c <= b'9' { return (c to u32) - (b'0' to u32) + 52 }
    if c == alphabet.char62 { return 62 to u32 }
    if c == alphabet.char63 { return 63 to u32 }
    error { message = "base64: invalid character in input" }
}

type Base64Trimmed = struct {
    body: []byte
    pad_count: u64
}

fn trim_base64_padding(input: []byte, alphabet: Base64Alphabet): Base64Trimmed | error {
    if !alphabet.padded {
        return Base64Trimmed { body = input; pad_count = 0 }
    }
    if input.len == 0 {
        return Base64Trimmed { body = input; pad_count = 0 }
    }
    if input.len % 4 != 0 {
        return error { message = "base64: padded input length must be a multiple of 4" }
    }
    var pad: u64 = 0
    if input[input.len - 1] == b'=' { pad = 1 }
    if pad == 1 && input.len >= 2 && input[input.len - 2] == b'=' { pad = 2 }
    Base64Trimmed { body = bytes_slice_view(input, 0, input.len - pad); pad_count = pad }
}

fn bytes_slice_view(data: []byte, from: u64, to: u64): []byte {
    teko::collections::arr_slice(data, from, to)
}

fn decode_full_quantum(alphabet: Base64Alphabet, c0: byte, c1: byte, c2: byte, c3: byte): []byte | error {
    var v0 = match base64_value_of(alphabet, c0) { u32 as v => v; error as e => return e }
    var v1 = match base64_value_of(alphabet, c1) { u32 as v => v; error as e => return e }
    var v2 = match base64_value_of(alphabet, c2) { u32 as v => v; error as e => return e }
    var v3 = match base64_value_of(alphabet, c3) { u32 as v => v; error as e => return e }
    [
        ((v0 << 2) | (v1 >> 4)) to byte,
        (((v1 << 4) | (v2 >> 2)) & 0xFF) to byte,
        (((v2 << 6) | v3) & 0xFF) to byte,
    ]
}

fn decode_tail_quantum(alphabet: Base64Alphabet, c0: byte, c1: byte, has_c2: bool, c2: byte): []byte | error {
    var v0 = match base64_value_of(alphabet, c0) { u32 as v => v; error as e => return e }
    var v1 = match base64_value_of(alphabet, c1) { u32 as v => v; error as e => return e }
    var first = ((v0 << 2) | (v1 >> 4)) to byte
    if !has_c2 {
        return [first]
    }
    var v2 = match base64_value_of(alphabet, c2) { u32 as v => v; error as e => return e }
    [first, (((v1 << 4) | (v2 >> 2)) & 0xFF) to byte]
}

fn decode_trailing_quantum(alphabet: Base64Alphabet, trimmed: Base64Trimmed, start: u64): []byte | error {
    var body = trimmed.body
    if trimmed.pad_count == 0 {
        return decode_full_quantum(alphabet, body[start], body[start + 1], body[start + 2], body[start + 3])
    }
    if trimmed.pad_count == 1 {
        return decode_tail_quantum(alphabet, body[start], body[start + 1], true, body[start + 2])
    }
    decode_tail_quantum(alphabet, body[start], body[start + 1], false, 0 to byte)
}

fn validate_unpadded_length(body_len: u64): error | null {
    if body_len % 4 == 1 { return error { message = "base64: invalid unpadded input length" } }
    null
}

fn decode_unpadded_tail(alphabet: Base64Alphabet, body: []byte, full_quantums: u64): []byte | error {
    var start = full_quantums * 4
    var remainder = body.len - start
    if remainder == 0 { var empty: []byte = []; return empty }
    if remainder == 2 { return decode_tail_quantum(alphabet, body[start], body[start + 1], false, 0 to byte) }
    decode_tail_quantum(alphabet, body[start], body[start + 1], true, body[start + 2])
}

/** Decodes Base64 `text` under `alphabet` back to raw bytes. Malformed input is a checked error. */
exp fn decode(text: str, alphabet: Base64Alphabet): []byte | error {
    var input = text.bytes()
    var trimmed = match trim_base64_padding(input, alphabet) { Base64Trimmed as t => t; error as e => return e }
    if !alphabet.padded {
        match validate_unpadded_length(trimmed.body.len) { null => { }; error as e => return e }
    }
    var body = trimmed.body
    var has_trailing = alphabet.padded && trimmed.pad_count > 0
    var full_quantums = body.len / 4
    var tail = match decode_tail_bytes(alphabet, trimmed, body, full_quantums, has_trailing) { []byte as t => t; error as e => return e }
    var out: [full_quantums * 3 + tail.len]byte = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= full_quantums { break }
        var grp_off = i * 4
        var q = match decode_full_quantum(alphabet, body[grp_off], body[grp_off + 1], body[grp_off + 2], body[grp_off + 3]) { []byte as b => b; error as e => return e }
        var j: u64 = 0
        loop {
            if j >= q.len { break }
            out[count] = q[j]
            count++
            j++
        }
        i++
    }
    var t: u64 = 0
    loop {
        if t >= tail.len { break }
        out[count] = tail[t]
        count++
        t++
    }
    out
}

fn decode_tail_bytes(alphabet: Base64Alphabet, trimmed: Base64Trimmed, body: []byte, full_quantums: u64, has_trailing: bool): []byte | error {
    if has_trailing {
        return decode_trailing_quantum(alphabet, trimmed, full_quantums * 4)
    }
    decode_unpadded_tail(alphabet, body, full_quantums)
}

/** `decode` under the standard, padded alphabet. */
exp fn decode_standard(text: str): []byte | error {
    decode(text, standard_alphabet())
}

/** `decode` under the URL-safe, padded alphabet. */
exp fn decode_url_safe(text: str): []byte | error {
    decode(text, url_safe_alphabet())
}

/** `decode` under the URL-safe, unpadded alphabet. */
exp fn decode_url_safe_no_pad(text: str): []byte | error {
    decode(text, url_safe_no_pad_alphabet())
}
