/** zip_seal — seal a `MemWriter`'s accumulated bytes into a one-entry ZIP-STORE (uncompressed)
 * archive under `name`. */
exp fn zip_seal(name: str, acc: MemWriter): Buf {
    var entry = teko::compress::ZipEntry { name = name; data = acc.content().bytes() }
    var archive = teko::compress::write_zip([entry])
    Buf::from_bytes(archive)
}

/** ZipReader — a one-shot `Reader` over a ZIP-STORE archive's first entry: the first `read`
 * decodes the archive, every later `read` yields EOF. */
exp type ZipReader = class & Reader {
    /** The raw archive bytes decoded on the first pull. */
    pub archive: Buf
    /** Whether the entry's bytes have already been handed out. */
    pub delivered: bool

    /** of — a reader over `archive`'s first entry. */
    pub static fn of(archive: Buf): ZipReader { ZipReader { archive = archive; delivered = false } }

    /** read — on the first call, decode and yield the first entry's bytes; on every later call,
     * yield EOF. */
    pub fn read(max: u64): Buf | error {
        if self.delivered { return Buf::empty() }
        self.delivered = true
        first_entry_buf(self.archive)
    }
}

fn first_entry_buf(archive: Buf): Buf | error {
    var entries = match teko::compress::read_zip(archive.bytes()) {
        []teko::compress::ZipEntry as e => e
        error as e => return e
    }
    if entries.len == 0 { return error { message = "io::ZipReader: archive has no entries" } }
    Buf::from_bytes(entries[0].data)
}
