/** teko::io::read_file — read `path` as UTF-8 text (TOTAL form, over read_stream).
 * @return the file contents, or an error on failure. */
exp fn read_file(path: str): str | error {
    match read_stream(path) {
        []byte as b => str_of_bytes(b)
        error as e => e
    }
}

/** teko::io::read_line — read one line from stdin (newline stripped); "" at EOF (check
 * stdin_eof() to distinguish from a genuine blank line). */
exp fn read_line(): str { teko::runtime::read_line() }

/** teko::io::stdin_eof — whether the last read_line() call hit end of input. */
exp fn stdin_eof(): bool { teko::runtime::stdin_eof() }

/** teko::io::read_stdin — read all of stdin until EOF. */
exp fn read_stdin(): str { teko::runtime::read_stdin() }

/** teko::io::write_file — (over)write `path` with `content` (TOTAL form, over write_stream).
 * @return null on success, or the failure. */
exp fn write_file(path: str, content: str): error | null {
    write_stream(path, content.bytes())
}

/** teko::io::append_file — append `content` to the file at `path`, creating it when absent
 * (TOTAL form, over append_stream).
 * @return null on success, or the failure. */
exp fn append_file(path: str, content: str): error | null {
    append_stream(path, content.bytes())
}

/** teko::io::write_file_bytes — write raw bytes to `path` (TOTAL form, over write_stream). */
exp fn write_file_bytes(path: str, data: []byte): error | null {
    write_stream(path, data)
}

/** teko::io::read_file_bytes — read `path` as raw bytes (TOTAL form, over read_stream); the binary-asset
 * companion of read_file that returns bytes rather than decoding UTF-8.
 * @return the file bytes, or an error on failure. */
exp fn read_file_bytes(path: str): []byte | error {
    read_stream(path)
}

/** teko::io::write — write `s` to stdout verbatim (no newline), captured into the running test's
 * channel when one is open. */
exp fn write(s: str) { teko::runtime::write(s) }

/** teko::io::ewrite — write `s` to stderr verbatim (no newline), captured into the running test's
 * channel when one is open. */
exp fn ewrite(s: str) { teko::runtime::ewrite(s) }

/** teko::io::print — write `s` to stdout, captured into the running test's channel when one is open. */
exp fn print(s: str) { teko::runtime::print(s) }

/** teko::io::println — write `s` to stdout followed by a newline, captured into the running test's
 * channel when one is open. */
exp fn println(s: str) { teko::runtime::println(s) }

/** teko::io::eprint — write `s` to stderr, captured into the running test's channel when one is open. */
exp fn eprint(s: str) { teko::runtime::eprint(s) }

/** teko::io::eprintln — write `s` to stderr followed by a newline, captured into the running test's
 * channel when one is open. */
exp fn eprintln(s: str) { teko::runtime::eprintln(s) }

/** teko::io::flush — flush buffered stdout to the OS. */
exp fn flush() { teko::runtime::flush() }
