/** Whence — the seek origin: from the start, from the current position, or from the end. */
exp type Whence = enum { Start; Current; End }

/** Reader — a byte source; a conforming class dispatches through its vtable. */
exp type Reader = interface {
    /** read — pull up to `max` further bytes.
     * @return the next chunk (empty at end-of-stream), or a read error. */
    fn read(max: u64): Buf | error
}

/** Writer — a byte sink; a conforming class dispatches through its vtable. */
exp type Writer = interface {
    /** write — accept some prefix of `from`.
     * @return the number of bytes accepted, or a write error. */
    fn write(from: Buf): u64 | error
}

/** Seeker — a repositionable stream. */
exp type Seeker = interface {
    /** seek — reposition the cursor to `off` relative to `whence`.
     * @return the new absolute position, or an error on a negative target. */
    fn seek(off: i64, whence: Whence): u64 | error
}

/** Closer — a stream that owns a resource. */
exp type Closer = interface {
    /** close — release the stream's resource.
     * @return null on success, or the close error. */
    fn close(): error | null
}

/** Buf — an immutable byte region; every operation returns a NEW Buf. */
exp type Buf = struct {
    /** The byte snapshot this region views. */
    data: []byte

    /** empty — the empty region. */
    static fn empty(): Buf { Buf { data = [] } }

    /** from_bytes — wrap an existing byte slice (no copy). */
    static fn from_bytes(bytes: []byte): Buf { Buf { data = bytes } }

    /** from_str — the UTF-8 bytes of `s`. */
    static fn from_str(s: str): Buf { Buf { data = s.bytes() } }

    /** len — the number of bytes in the region. */
    fn len(): u64 { self.data.len }

    /** bytes — the region's raw bytes. */
    fn bytes(): []byte { self.data }

    /** push — append one byte, returning the grown Buf. */
    fn push(b: byte): Buf { Buf { data = [..self.data, b] } }

    /** extend — append a whole byte slice, returning the grown Buf. */
    fn extend(more: []byte): Buf {
        var grown = self.data
        var i: u64 = 0
        loop {
            if i >= more.len { break }
            grown = [..grown, more[i]]
            i++
        }
        Buf { data = grown }
    }

    /** concat — append another Buf, returning the combined Buf. */
    fn concat(other: Buf): Buf { self.extend(other.data) }

    /** slice — the half-open sub-region `[from, to)`.
     * @return the sub-region, or an error on a bad range. */
    fn slice(from: u64, to: u64): Buf | error {
        if from > to { return error { message = "io::Buf::slice: from > to" } }
        if to > self.data.len { return error { message = "io::Buf::slice: range out of bounds" } }
        var out: []byte = []
        var i = from
        loop {
            if i >= to { break }
            out = [..out, self.data[i]]
            i++
        }
        Buf { data = out }
    }

    /** to_str — decode the region as UTF-8 text. */
    fn to_str(): str | error { str_from_utf8(self.data) }
}

/** NullStream — the four-interface discard sink / empty source: reads yield EOF, writes are
 * discarded (and reported accepted), seeks move an unobservable cursor, closes always succeed. */
exp type NullStream = class & Reader & Writer & Seeker & Closer {
    sentinel: byte

    /** make — construct the null stream. */
    pub static fn make(): NullStream { NullStream { sentinel = 0 } }

    /** read — always at end-of-stream: an empty chunk. */
    pub fn read(max: u64): Buf | error { Buf::empty() }

    /** write — the discard sink: accepts (and drops) every byte. */
    pub fn write(from: Buf): u64 | error { from.len() }

    /** seek — every origin is position 0; the target is `off` from 0.
     * @return the target position, or an error on a negative target. */
    pub fn seek(off: i64, whence: Whence): u64 | error {
        var origin: i64 = match whence {
            Whence::Start => 0
            Whence::Current => 0
            Whence::End => 0
        }
        var target = origin + off
        if target < 0 { return error { message = "io::NullStream::seek: negative position" } }
        target to u64
    }

    /** close — always succeeds. */
    pub fn close(): error | null { null }
}

/** MemReader — an in-memory `Reader` over a byte region, cursor-advancing across calls. */
exp type MemReader = class & Reader & Seeker {
    /** The backing byte region. */
    pub buf: Buf
    /** The current read cursor. */
    pub pos: u64

    /** over — a reader over a byte region, positioned at the start. */
    pub static fn over(b: Buf): MemReader { MemReader { buf = b; pos = 0 } }

    /** of_str — a reader over a str's UTF-8 bytes. */
    pub static fn of_str(s: str): MemReader { MemReader { buf = Buf::from_str(s); pos = 0 } }

    /** read — pull up to `max` bytes from the current position, advancing the cursor; EOF (or
     * `max == 0`) yields an empty chunk. */
    pub fn read(max: u64): Buf | error {
        var total = self.buf.len()
        if self.pos >= total || max == 0 { return Buf::empty() }
        var take = total - self.pos
        if take > max { take = max }
        var chunk = match self.buf.slice(self.pos, self.pos + take) {
            Buf as b => b
            error as e => return e
        }
        self.pos = self.pos + take
        chunk
    }

    /** seek — reposition the cursor: `off` relative to Start / Current / End.
     * @return the new absolute position, or an error on a negative target. */
    pub fn seek(off: i64, whence: Whence): u64 | error {
        var origin: i64 = match whence {
            Whence::Start => 0
            Whence::Current => self.pos to i64
            Whence::End => self.buf.len() to i64
        }
        var target = origin + off
        if target < 0 { return error { message = "io::MemReader::seek: negative position" } }
        self.pos = target to u64
        self.pos
    }
}

/** MemWriter — an in-memory `Writer` accumulating every write. */
exp type MemWriter = class & Writer {
    /** The bytes accumulated so far. */
    pub buf: Buf

    /** empty — an empty in-memory sink. */
    pub static fn empty(): MemWriter { MemWriter { buf = Buf::empty() } }

    /** write — append `from`; a memory sink always accepts the whole region. */
    pub fn write(from: Buf): u64 | error {
        self.buf = self.buf.concat(from)
        from.len()
    }

    /** content — everything written so far. */
    pub fn content(): Buf { self.buf }
}

const DEFAULT_CHUNK_SIZE: u64 = 4096

/** read_chunk — pull one chunk from a dynamic `Reader` value. */
exp fn read_chunk(r: Reader, max: u64): Buf | error { r.read(max) }

/** write_chunk — offer one region to a dynamic `Writer` value. */
exp fn write_chunk(w: Writer, from: Buf): u64 | error { w.write(from) }

/** read_all — drain `r` to end-of-stream, concatenating every chunk.
 * @return the fully-drained bytes, or the first read error. */
exp fn read_all(r: Reader): Buf | error {
    var collected = Buf::empty()
    loop {
        var chunk = match read_chunk(r, DEFAULT_CHUNK_SIZE) { Buf as b => b; error as e => return e }
        if chunk.len() == 0 { break }
        collected = collected.concat(chunk)
    }
    collected
}

/** read_exact — read exactly `count` bytes; reaching EOF first is an error. */
exp fn read_exact(r: Reader, count: u64): Buf | error {
    var collected = Buf::empty()
    loop {
        if collected.len() >= count { break }
        var chunk = match read_chunk(r, count - collected.len()) { Buf as b => b; error as e => return e }
        if chunk.len() == 0 {
            return error { message = "io::read_exact: end of stream before the requested count" }
        }
        collected = collected.concat(chunk)
    }
    collected
}

/** write_all — write ALL of `from`, looping while the writer takes partial counts; a writer
 * that stalls or over-reports is an error. */
exp fn write_all(w: Writer, from: Buf): u64 | error {
    var remaining = from
    var total: u64 = 0
    loop {
        if remaining.len() == 0 { break }
        var taken = match write_chunk(w, remaining) { u64 as n => n; error as e => return e }
        if taken == 0 { return error { message = "io::write_all: writer made no progress" } }
        if taken > remaining.len() { return error { message = "io::write_all: writer reported more bytes than offered" } }
        remaining = match remaining.slice(taken, remaining.len()) {
            Buf as rest => rest
            error as e => return e
        }
        total = total + taken
    }
    total
}

/** copy — pump `r` into `w` until EOF.
 * @return the total bytes moved, or an error. */
exp fn copy(w: Writer, r: Reader): u64 | error {
    var total: u64 = 0
    loop {
        var chunk = match read_chunk(r, DEFAULT_CHUNK_SIZE) { Buf as b => b; error as e => return e }
        if chunk.len() == 0 { break }
        var moved = match write_all(w, chunk) { u64 as n => n; error as e => return e }
        total = total + moved
    }
    total
}

/** LimitReader — caps how much an underlying `Reader` may yield. */
exp type LimitReader = class & Reader {
    /** The wrapped source stream. */
    pub inner: Reader
    /** How many further bytes the cap still permits. */
    pub remaining: u64

    /** of — cap `inner` to at most `limit` further bytes. */
    pub static fn of(inner: teko::io::Reader, limit: u64): LimitReader { LimitReader { inner = inner; remaining = limit } }

    /** read — yield at most `remaining` further bytes from the inner stream, then EOF. */
    pub fn read(max: u64): Buf | error {
        var want = self.remaining
        if want > max { want = max }
        if want == 0 { return Buf::empty() }
        var chunk = match self.inner.read(want) { Buf as b => b; error as e => return e }
        self.remaining = self.remaining - chunk.len()
        chunk
    }
}

/** BufReader — read-side buffering: pulls `chunk_size` gulps and serves requests out of the
 * pending gulp. */
exp type BufReader = class & Reader {
    /** The wrapped source stream. */
    pub inner: Reader
    /** The bytes gulped ahead but not yet served. */
    pub pending: Buf
    /** The serve cursor within `pending`. */
    pub pos: u64
    /** The size of each gulp pulled from `inner`. */
    pub chunk_size: u64

    /** of — wrap `inner`, gulping `chunk_size` bytes at a time. */
    pub static fn of(inner: teko::io::Reader, chunk_size: u64): BufReader {
        BufReader { inner = inner; pending = Buf::empty(); pos = 0; chunk_size = chunk_size }
    }

    /** read — serve up to `max` bytes, gulping a fresh block when the pending one is spent. */
    pub fn read(max: u64): Buf | error {
        if max == 0 { return Buf::empty() }
        if self.pos >= self.pending.len() {
            var gulp = match self.inner.read(self.chunk_size) { Buf as b => b; error as e => return e }
            if gulp.len() == 0 { return Buf::empty() }
            self.pending = gulp
            self.pos = 0
        }
        var take = self.pending.len() - self.pos
        if take > max { take = max }
        var chunk = match self.pending.slice(self.pos, self.pos + take) { Buf as b => b; error as e => return e }
        self.pos = self.pos + take
        chunk
    }
}

/** BufWriter — write-side buffering: accumulates writes and drains to the underlying stream at
 * `capacity`. Must be flushed for output to be complete. */
exp type BufWriter = class & Writer {
    /** The wrapped destination stream. */
    pub inner: Writer
    /** The bytes held back, not yet drained to `inner`. */
    pub pending: Buf
    /** The threshold at which `pending` is drained. */
    pub capacity: u64

    /** of — wrap `inner`, draining once `capacity` bytes have accumulated. */
    pub static fn of(inner: Writer, capacity: u64): BufWriter {
        BufWriter { inner = inner; pending = Buf::empty(); capacity = capacity }
    }

    /** write — hold `from` in the pending region, draining it once `capacity` is reached. */
    pub fn write(from: Buf): u64 | error {
        var combined = self.pending.concat(from)
        if combined.len() < self.capacity {
            self.pending = combined
            return from.len()
        }
        match write_all(self.inner, combined) {
            u64 => {
                self.pending = Buf::empty()
                from.len()
            }
            error as e => e
        }
    }

    /** flush — drain the pending bytes to the underlying stream.
     * @return the number of bytes flushed (0 if nothing was pending), or a drain error. */
    pub fn flush(): u64 | error {
        if self.pending.len() == 0 { return 0 to u64 }
        var flushed = match write_all(self.inner, self.pending) { u64 as n => n; error as e => return e }
        self.pending = Buf::empty()
        flushed
    }
}

/** TeeWriter — fans every write out to two sinks, each drained fully via `write_all` before the
 * tee reports the region consumed. */
exp type TeeWriter = class & Writer {
    /** The first sink (e.g. the real destination). */
    pub primary: Writer
    /** The second sink (e.g. a hash/audit/log sink). */
    pub secondary: Writer

    /** of — a tee mirroring each write into `primary` and `secondary`. */
    pub static fn of(primary: Writer, secondary: Writer): TeeWriter { TeeWriter { primary = primary; secondary = secondary } }

    /** write — drain `from` fully into both sinks, then report the whole region length. */
    pub fn write(from: Buf): u64 | error {
        var wrote = match write_all(self.primary, from) { u64 as n => n; error as e => return e }
        var mirrored = match write_all(self.secondary, from) { u64 as m => m; error as e => return e }
        if mirrored != wrote { return error { message = "io::TeeWriter: sinks drained unequal counts" } }
        wrote
    }
}
