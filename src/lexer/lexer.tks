
type Scan = struct {
    token: Token
    next: u64
}

type EscByte = struct {
    value: byte
    next: u64
}
type ByteVal = struct {
    value: byte
    next: u64
}

type Loc = struct {
    line: u32
    col: u32
}


fn at(source: str, p: u64): byte {
    if p >= source.len { return 0 }
    source[p]
}


fn compute_loc(source: str, pos: u64): Loc {
    var line: u32 = 1
    var col: u32 = 1
    var limit = if pos < source.len { pos } else { source.len }
    var i: u64 = 0
    loop {
        if i >= limit { break }
        if source[i] == b'\n' { line = line + 1; col = 1 } else { col = col + 1 }
        i++
    }
    Loc { line = line; col = col }
}

fn stamp_loc(tok: Token, line: u32, col: u32, byte_off: u64, file: str): Token {
    Token { kind = tok.kind; text = tok.text; line = line; col = col; byte_off = byte_off; file = file }
}

fn scan_err_at(source: str, pos: u64, msg: str): error {
    var loc = compute_loc(source, pos)
    error { message = $"{loc.line}:{loc.col}: {msg}" }
}


fn is_digit(c: byte): bool {
    c >= b'0' && c <= b'9'
}

fn is_hex_digit(c: byte): bool {
    is_digit(c) || (c >= b'a' && c <= b'f') || (c >= b'A' && c <= b'F')
}

fn is_alpha(c: byte): bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z')
}

fn is_ident_continue(c: byte): bool {
    is_alpha(c) || is_digit(c) || c == b'_'
}

fn is_upper_uc(c: byte): bool {
    c >= b'A' && c <= b'Z'
}

fn is_upper_snake_continue(c: byte): bool {
    is_upper_uc(c) || is_digit(c) || c == b'_'
}

pub fn is_upper_snake(text: str): bool {
    if text.len == 0 { return false }
    if !is_upper_uc(text[0]) { return false }
    var i: u64 = 1
    loop {
        if i >= text.len { break }
        if !is_upper_snake_continue(text[i]) { return false }
        i++
    }
    true
}


fn skip_spaces(source: str, pos: u64): u64 {
    var p = pos
    loop {
        if p >= source.len { break }
        var c = source[p]
        if c != b' ' && c != b'\t' && c != b'\r' { break }
        p++
    }
    p
}

fn skip_line(source: str, pos: u64): u64 {
    var p = pos
    loop {
        if p >= source.len { break }
        if source[p] == b'\n' { break }
        p++
    }
    p
}

fn skip_block_comment(source: str, pos: u64): u64 | error {
    var p = pos + 2
    loop {
        if p + 1 >= source.len { return error { message = "unterminated block comment" } }
        if source[p] == b'*' && source[p + 1] == b'/' { return p + 2 }
        p++
    }
}

fn read_doc_comment(source: str, pos: u64): Scan | error {
    var p = pos + 3
    loop {
        if p + 1 >= source.len { return error { message = "unterminated doc comment" } }
        if source[p] == b'*' && source[p + 1] == b'/' {
            var end = p + 2
            return Scan { token = Token { kind = TokenKind::Doc; text = source.slice(pos, end); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = end }
        }
        p++
    }
}


fn sym(source: str, pos: u64, n: u64, kind: TokenKind): Scan {
    Scan { token = Token { kind = kind; text = source.slice(pos, pos + n); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = pos + n }
}


fn scan_digits(source: str, pos: u64): u64 {
    var p = pos
    loop {
        if p >= source.len { break }
        var c = source[p]
        if is_digit(c) { p++; continue }
        if c == b'_' {
            if p + 1 < source.len && is_digit(at(source, p + 1)) { p++; continue }
        }
        break
    }
    p
}

fn read_number(source: str, pos: u64): Scan {
    if at(source, pos) == b'0' && (at(source, pos + 1) == b'x' || at(source, pos + 1) == b'X') {
        var h = pos + 2
        loop {
            if h >= source.len { break }
            var c = source[h]
            if is_hex_digit(c) { h++; continue }
            if c == b'_' {
                if h + 1 < source.len && is_hex_digit(at(source, h + 1)) { h++; continue }
            }
            break
        }
        return Scan { token = Token { kind = TokenKind::Number; text = source.slice(pos, h); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = h }
    }
    if at(source, pos) == b'0' && (at(source, pos + 1) == b'b' || at(source, pos + 1) == b'B') && is_bin_body_start(at(source, pos + 2)) {
        var bp = pos + 2
        loop {
            if bp >= source.len { break }
            var c = source[bp]
            if c == b'0' || c == b'1' { bp++; continue }
            if c == b'_' {
                if bp + 1 < source.len && (at(source, bp + 1) == b'0' || at(source, bp + 1) == b'1') { bp++; continue }
            }
            break
        }
        return Scan { token = Token { kind = TokenKind::Number; text = source.slice(pos, bp); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = bp }
    }
    var p = scan_digits(source, pos)

    if at(source, p) == b'.' && is_digit(at(source, p + 1)) {
        p = scan_digits(source, p + 1)
    }

    if at(source, p) == b'e' || at(source, p) == b'E' {
        var q = p + 1
        if at(source, q) == b'+' || at(source, q) == b'-' { q = q + 1 }
        if is_digit(at(source, q)) {
            p = scan_digits(source, q)
        }
    }

    if at(source, p) == b'b' && at(source, p + 1) == b'i' && !is_ident_continue(at(source, p + 2)) {
        return Scan { token = Token { kind = TokenKind::Number; text = source.slice(pos, p + 2); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = p + 2 }
    }
    if at(source, p) == b'd' && !is_ident_continue(at(source, p + 1)) {
        return Scan { token = Token { kind = TokenKind::Number; text = source.slice(pos, p + 1); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = p + 1 }
    }

    Scan { token = Token { kind = TokenKind::Number; text = source.slice(pos, p); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = p }
}

fn is_bin_body_start(c: byte): bool {
    c == b'0' || c == b'1' || c == b'_'
}

fn read_ident(source: str, pos: u64): Scan {
    var p = pos
    loop {
        if p >= source.len { break }
        if !is_ident_continue(source[p]) { break }
        p++
    }
    Scan { token = Token { kind = TokenKind::Ident; text = source.slice(pos, p); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = p }
}

fn read_underscore(source: str, pos: u64): Scan | error {
    var p = pos
    loop {
        if p >= source.len { break }
        if source[p] != b'_' { break }
        p++
    }
    if p < source.len && is_alpha(source[p]) {
        return read_ident(source, pos)
    }
    if p < source.len && is_digit(source[p]) {
        return scan_err_at(source, pos, "`_` is the write-only discard; an identifier cannot begin with an underscore run followed by a digit")
    }
    if p - pos >= 2 {
        return scan_err_at(source, pos, "`_` is the write-only discard; two or more underscores in a row (`__`) are not a valid token")
    }
    sym(source, pos, 1, TokenKind::Underscore)
}


fn keyword_kind(text: str): TokenKind {
    if text == "fn" { return TokenKind::Fn }
    if text == "type" { return TokenKind::Type }
    if text == "struct" { return TokenKind::Struct }
    if text == "enum" { return TokenKind::Enum }
    if text == "flags" { return TokenKind::Flags }
    if text == "variant" { return TokenKind::Variant }
    if text == "const" { return TokenKind::Const }
    if text == "if" { return TokenKind::If }
    if text == "else" { return TokenKind::Else }
    if text == "loop" { return TokenKind::Loop }
    if text == "break" { return TokenKind::Break }
    if text == "continue" { return TokenKind::Continue }
    if text == "return" { return TokenKind::Return }
    if text == "defer" { return TokenKind::Defer }
    if text == "match" { return TokenKind::Match }
    if text == "when" { return TokenKind::When }
    if text == "in" { return TokenKind::In }
    if text == "as" { return TokenKind::As }
    if text == "to" { return TokenKind::To }
    if text == "use" { return TokenKind::Use }
    if text == "pub" { return TokenKind::Pub }
    if text == "exp" { return TokenKind::Exp }
    if text == "extern" { return TokenKind::Extern }
    if text == "true" { return TokenKind::True }
    if text == "false" { return TokenKind::False }
    if text == "null" { return TokenKind::Null }
    if text == "class" { return TokenKind::Class }
    if text == "abstract" { return TokenKind::Abstract }
    if text == "virtual" { return TokenKind::Virtual }
    if text == "override" { return TokenKind::Override }
    if text == "intern" { return TokenKind::Intern }
    if text == "interface" { return TokenKind::Interface }
    if text == "self" { return TokenKind::SelfKw }
    if text == "base" { return TokenKind::Base }
    if text == "static" { return TokenKind::Static }
    if text == "global" { return TokenKind::Global }
    if text == "service" { return TokenKind::Service }
    if text == "macro" { return TokenKind::Macro }
    if text == "comptime" { return TokenKind::Comptime }
    TokenKind::Ident
}

fn keyword_or_ident(source: str, pos: u64): Scan {
    var s = read_ident(source, pos)
    var k = keyword_kind(s.token.text)
    Scan { token = Token { kind = k; text = s.token.text; line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = s.next }
}


fn escape_byte(source: str, pos: u64): EscByte | error {
    var after = pos + 1
    if after >= source.len { return error { message = "unterminated escape" } }
    var v = match source[after] {
        b'n' => 0x0A
        b't' => 0x09
        b'r' => 0x0D
        b'\\' => 0x5C
        b'"' => 0x22
        b'\'' => 0x27
        b'0' => 0x00
        _ => return error { message = "unknown escape" }
    }
    EscByte { value = v to byte; next = after + 1 }
}

fn byte_value(source: str, pos: u64): ByteVal | error {
    if source[pos] == b'\\' {
        var e = match escape_byte(source, pos) {
            EscByte as eb => eb
            error as err => return err
        }
        return ByteVal { value = e.value; next = e.next }
    }
    ByteVal { value = source[pos]; next = pos + 1 }
}

fn str_of_bytes(xs: []byte): str {
    str(xs)
}



fn str_close_at(source: str, p: u64, multiline: bool): bool {
    if source[p] != b'"' { return false }
    if !multiline { return true }
    at(source, p + 1) == b'"' && at(source, p + 2) == b'"'
}

fn interp_raw_span(source: str, pos: u64, inner: u64, multiline: bool): u64 | error {
    var p = inner
    var depth: u64 = 0
    loop {
        if p >= source.len { return scan_err_at(source, pos, "unterminated interpolated string") }
        var c = source[p]
        if depth == 0 && c == b'{' && at(source, p + 1) == b'{' { p = p + 2; continue }
        if depth == 0 && c == b'}' && at(source, p + 1) == b'}' { p = p + 2; continue }
        if c == b'{' { depth = depth + 1; p++; continue }
        if c == b'}' { if depth > 0 { depth = depth - 1 }; p++; continue }
        if c == b'"' && depth == 0 {
            if !multiline {
                if at(source, p + 1) == b'"' { p = p + 2; continue }
                return p
            }
            if str_close_at(source, p, true) { return p }
        }
        p++
    }
}

fn str_body_span(source: str, pos: u64, inner: u64, has_verbatim: bool, multiline: bool): u64 | error {
    var p = inner
    loop {
        if p >= source.len { return scan_err_at(source, pos, "unterminated string literal") }
        var c = source[p]
        if has_verbatim {
            if !multiline && c == b'"' && at(source, p + 1) == b'"' { p = p + 2; continue }
            if str_close_at(source, p, multiline) { return p }
            p++
            continue
        }
        if str_close_at(source, p, multiline) { return p }
        if c == b'\\' {
            var e = match escape_byte(source, p) {
                EscByte as eb => eb
                error as err => return err
            }
            p = e.next
            continue
        }
        p++
    }
}

fn read_string_body(source: str, pos: u64, inner: u64, has_interp: bool, has_verbatim: bool, multiline: bool): Scan | error {
    var delim: u64 = 1
    if multiline { delim = 3 }
    if has_interp {
        if !has_verbatim {
            var p = inner
            var depth: u64 = 0
            loop {
                if p >= source.len { return scan_err_at(source, pos, "unterminated interpolated string") }
                var c = source[p]
                if !multiline && c == b'\\' {
                    if p + 1 >= source.len { return scan_err_at(source, pos, "unterminated escape in interpolated string") }
                    p = p + 2
                    continue
                }
                if depth == 0 && c == b'{' && at(source, p + 1) == b'{' { p = p + 2; continue }
                if depth == 0 && c == b'}' && at(source, p + 1) == b'}' { p = p + 2; continue }
                if c == b'{' { depth = depth + 1; p++; continue }
                if c == b'}' { if depth > 0 { depth = depth - 1 }; p++; continue }
                if depth == 0 && str_close_at(source, p, multiline) {
                    return Scan { token = Token { kind = TokenKind::Interp; text = source.slice(inner, p); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = p + delim }
                }
                p++
            }
        }
        var end = match interp_raw_span(source, pos, inner, multiline) {
            u64 as s => s
            error as err => return err
        }
        var p = inner
        var depth: u64 = 0
        var bytes: [end - inner]byte = []
        var n: u64 = 0
        loop {
            if p >= source.len { return scan_err_at(source, pos, "unterminated interpolated string") }
            var c = source[p]
            if depth == 0 && c == b'{' && at(source, p + 1) == b'{' {
                bytes[n] = b'{'; n++; bytes[n] = b'{'; n++; p = p + 2; continue
            }
            if depth == 0 && c == b'}' && at(source, p + 1) == b'}' {
                bytes[n] = b'}'; n++; bytes[n] = b'}'; n++; p = p + 2; continue
            }
            if c == b'{' { depth = depth + 1; bytes[n] = c; n++; p++; continue }
            if c == b'}' { if depth > 0 { depth = depth - 1 }; bytes[n] = c; n++; p++; continue }
            if c == b'"' && depth == 0 {
                if !multiline {
                    if at(source, p + 1) == b'"' {
                        bytes[n] = b'"'; n++
                        p = p + 2
                        continue
                    }
                    return Scan { token = Token { kind = TokenKind::InterpRaw; text = str_of_bytes(teko::collections::arr_slice(bytes, 0, n)); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = p + 1 }
                }
                if str_close_at(source, p, true) {
                    return Scan { token = Token { kind = TokenKind::InterpRaw; text = str_of_bytes(teko::collections::arr_slice(bytes, 0, n)); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = p + 3 }
                }
            }
            bytes[n] = c; n++
            p++
        }
    }
    var end = match str_body_span(source, pos, inner, has_verbatim, multiline) {
        u64 as s => s
        error as err => return err
    }
    var p = inner
    var bytes: [end - inner]byte = []
    var n: u64 = 0
    loop {
        if p >= source.len { return scan_err_at(source, pos, "unterminated string literal") }
        var c = source[p]
        if has_verbatim {
            if !multiline && c == b'"' && at(source, p + 1) == b'"' {
                bytes[n] = b'"'; n++
                p = p + 2
                continue
            }
            if str_close_at(source, p, multiline) {
                return Scan { token = Token { kind = TokenKind::Str; text = str_of_bytes(teko::collections::arr_slice(bytes, 0, n)); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = p + delim }
            }
            bytes[n] = c; n++
            p++
            continue
        }
        if str_close_at(source, p, multiline) {
            return Scan { token = Token { kind = TokenKind::Str; text = str_of_bytes(teko::collections::arr_slice(bytes, 0, n)); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = p + delim }
        }
        if c == b'\\' {
            var e = match escape_byte(source, p) {
                EscByte as eb => eb
                error as err => return err
            }
            bytes[n] = e.value; n++
            p = e.next
            continue
        }
        bytes[n] = c; n++
        p++
    }
}

fn read_string(source: str, pos: u64): Scan | error {
    var has_interp = false
    var has_verbatim = false
    var p = pos
    loop {
        var c = at(source, p)
        if c == b'$' { if has_interp { break }; has_interp = true; p = p + 1; continue }
        if c == b'@' { if has_verbatim { break }; has_verbatim = true; p = p + 1; continue }
        break
    }
    var multiline = at(source, p + 1) == b'"' && at(source, p + 2) == b'"'
    var inner = if multiline { p + 3 } else { p + 1 }
    read_string_body(source, pos, inner, has_interp, has_verbatim, multiline)
}

fn is_string_start(source: str, pos: u64): bool {
    var has_interp = false
    var has_verbatim = false
    var p = pos
    loop {
        var c = at(source, p)
        if c == b'$' { if has_interp { break }; has_interp = true; p = p + 1; continue }
        if c == b'@' { if has_verbatim { break }; has_verbatim = true; p = p + 1; continue }
        break
    }
    at(source, p) == b'"'
}

fn read_byte_lit(source: str, pos: u64): Scan | error {
    var inner = pos + 2
    if inner >= source.len { return error { message = "unterminated byte literal" } }
    var v = match byte_value(source, inner) {
        ByteVal as bv => bv
        error as err => return err
    }
    if at(source, v.next) != b'\'' { return error { message = "expected closing ' in byte literal" } }
    Scan { token = Token { kind = TokenKind::Byte; text = teko::runtime::one_byte(v.value); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = v.next + 1 }
}

fn read_byte_str(source: str, pos: u64): Scan | error {
    var p = pos + 2
    var bytes: []byte = []
    loop {
        if p >= source.len { return error { message = "unterminated byte string literal" } }
        if source[p] == b'"' { break }
        var v = match byte_value(source, p) {
            ByteVal as bv => bv
            error as err => return err
        }
        bytes = [..bytes, v.value]
        p = v.next
    }
    Scan { token = Token { kind = TokenKind::ByteStr; text = str_of_bytes(bytes); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = p + 1 }
}

fn utf8_codepoint_len(b: byte): u64 {
    if b <= 0x7F { return 1 }
    if b >= 0xC2 && b <= 0xDF { return 2 }
    if b >= 0xE0 && b <= 0xEF { return 3 }
    if b >= 0xF0 && b <= 0xF4 { return 4 }
    0
}

fn read_char_lit(source: str, pos: u64): Scan | error {
    var inner = pos + 2
    if inner >= source.len { return error { message = "unterminated char literal" } }
    var bytes: []byte = []
    var p = inner
    loop {
        if p >= source.len { return error { message = "expected closing ' in char literal" } }
        if source[p] == b'\'' { break }
        var v = match byte_value(source, p) {
            ByteVal as bv => bv
            error as err => return err
        }
        bytes = [..bytes, v.value]
        p = v.next
    }
    if bytes.len == 0 { return error { message = "empty char literal — a char must be exactly one codepoint" } }
    if !teko::text::valid_utf8(bytes) { return error { message = "invalid UTF-8 in char literal" } }
    if utf8_codepoint_len(bytes[0]) != bytes.len { return error { message = "char literal must be exactly one codepoint" } }
    Scan { token = Token { kind = TokenKind::Char; text = str_of_bytes(bytes); line = 0; col = 0; byte_off = 0 to u64; file = "" }; next = p + 1 }
}


fn read_symbol(source: str, pos: u64): Scan | error {
    var c = source[pos]
    var c1 = at(source, pos + 1)
    var c2 = at(source, pos + 2)

    if c == b'<' && c1 == b'<' && c2 == b'=' { return sym(source, pos, 3, TokenKind::ShlEq) }
    if c == b'>' && c1 == b'>' && c2 == b'=' { return sym(source, pos, 3, TokenKind::ShrEq) }
    if c == b'.' && c1 == b'.' && c2 == b'=' { return sym(source, pos, 3, TokenKind::DotDotEq) }

    if c == b'=' && c1 == b'=' { return sym(source, pos, 2, TokenKind::EqEq) }
    if c == b'=' && c1 == b'>' { return sym(source, pos, 2, TokenKind::FatArrow) }
    if c == b'!' && c1 == b'=' { return sym(source, pos, 2, TokenKind::Ne) }
    if c == b'<' && c1 == b'=' { return sym(source, pos, 2, TokenKind::Le) }
    if c == b'>' && c1 == b'=' { return sym(source, pos, 2, TokenKind::Ge) }
    if c == b'<' && c1 == b'<' { return sym(source, pos, 2, TokenKind::Shl) }
    if c == b'>' && c1 == b'>' { return sym(source, pos, 2, TokenKind::Shr) }
    if c == b':' && c1 == b':' { return sym(source, pos, 2, TokenKind::ColonColon) }
    if c == b':' && c1 == b'=' { return sym(source, pos, 2, TokenKind::Walrus) }
    if c == b'&' && c1 == b'&' { return sym(source, pos, 2, TokenKind::AndAnd) }
    if c == b'|' && c1 == b'|' { return sym(source, pos, 2, TokenKind::OrOr) }
    if c == b'+' && c1 == b'+' { return sym(source, pos, 2, TokenKind::PlusPlus) }
    if c == b'-' && c1 == b'-' { return sym(source, pos, 2, TokenKind::MinusMinus) }
    if c == b'+' && c1 == b'=' { return sym(source, pos, 2, TokenKind::PlusEq) }
    if c == b'-' && c1 == b'=' { return sym(source, pos, 2, TokenKind::MinusEq) }
    if c == b'*' && c1 == b'=' { return sym(source, pos, 2, TokenKind::StarEq) }
    if c == b'/' && c1 == b'=' { return sym(source, pos, 2, TokenKind::SlashEq) }
    if c == b'%' && c1 == b'=' { return sym(source, pos, 2, TokenKind::PercentEq) }
    if c == b'&' && c1 == b'=' { return sym(source, pos, 2, TokenKind::AmpEq) }
    if c == b'|' && c1 == b'=' { return sym(source, pos, 2, TokenKind::PipeEq) }
    if c == b'^' && c1 == b'=' { return sym(source, pos, 2, TokenKind::CaretEq) }


    if c == b'.' && c1 == b'.' { return sym(source, pos, 2, TokenKind::DotDot) }

    var one = match c {
        b'+' => TokenKind::Plus
        b'-' => TokenKind::Minus
        b'*' => TokenKind::Star
        b'/' => TokenKind::Slash
        b'%' => TokenKind::Percent
        b'&' => TokenKind::Amp
        b'|' => TokenKind::Pipe
        b'^' => TokenKind::Caret
        b'~' => TokenKind::Tilde
        b'!' => TokenKind::Bang
        b'<' => TokenKind::Lt
        b'>' => TokenKind::Gt
        b'=' => TokenKind::Assign
        b':' => TokenKind::Colon
        b';' => TokenKind::Semicolon
        b',' => TokenKind::Comma
        b'.' => TokenKind::Dot
        b'(' => TokenKind::LParen
        b')' => TokenKind::RParen
        b'{' => TokenKind::LBrace
        b'}' => TokenKind::RBrace
        b'[' => TokenKind::LBracket
        b']' => TokenKind::RBracket
        b'#' => TokenKind::Hash
        _ => return scan_err_at(source, pos, "unexpected character")
    }
    sym(source, pos, 1, one)
}


fn next_token(source: str, pos: u64): Scan | error {
    var c = source[pos]
    if c == b'b' && at(source, pos + 1) == b'\'' { return read_byte_lit(source, pos) }
    if c == b'b' && at(source, pos + 1) == b'"' { return read_byte_str(source, pos) }
    if c == b'c' && at(source, pos + 1) == b'\'' { return read_char_lit(source, pos) }
    if (c == b'"' || c == b'$' || c == b'@') && is_string_start(source, pos) { return read_string(source, pos) }
    if c == b'@' { return sym(source, pos, 1, TokenKind::At) }
    if c == b'$' { return sym(source, pos, 1, TokenKind::Dollar) }
    if is_digit(c) { return read_number(source, pos) }
    if is_alpha(c) { return keyword_or_ident(source, pos) }
    if c == b'_' { return read_underscore(source, pos) }
    read_symbol(source, pos)
}


type LexStep = struct {
    token: Token
    start: u64
    next: u64
    has_token: bool
    done: bool
}

fn empty_token(): Token {
    Token { kind = TokenKind::Newline; text = ""; line = 0; col = 0; byte_off = 0 to u64; file = "" }
}

fn lex_step(source: str, pos: u64): LexStep | error {
    var p = skip_spaces(source, pos)
    if p >= source.len {
        return LexStep { token = empty_token(); start = p; next = p; has_token = false; done = true }
    }

    var c = source[p]

    if c == b'/' && at(source, p + 1) == b'/' {
        return LexStep { token = empty_token(); start = p; next = skip_line(source, p); has_token = false; done = false }
    }
    if c == b'/' && at(source, p + 1) == b'*' {
        if at(source, p + 2) == b'*' && at(source, p + 3) != b'/' {
            var scan = match read_doc_comment(source, p) { Scan as sc => sc; error as e => return e }
            return LexStep { token = scan.token; start = p; next = scan.next; has_token = true; done = false }
        }
        var np = match skip_block_comment(source, p) { u64 as q => q; error as e => return e }
        return LexStep { token = empty_token(); start = p; next = np; has_token = false; done = false }
    }
    if c == b'\n' {
        return LexStep { token = sym(source, p, 1, TokenKind::Newline).token; start = p; next = p + 1; has_token = true; done = false }
    }

    var scan = match next_token(source, p) {
        Scan as sc => sc
        error as e => return e
    }
    LexStep { token = scan.token; start = p; next = scan.next; has_token = true; done = false }
}

fn count_tokens(source: str): u64 | error {
    var pos: u64 = 0
    var n: u64 = 0
    loop {
        var step = match lex_step(source, pos) { LexStep as s => s; error as e => return e }
        if step.done { break }
        if step.has_token { n = n + 1 }
        pos = step.next
    }
    n
}

pub fn tokenize(source: str): []Token | error {
    tokenize_file(source, "")
}

pub fn tokenize_file(source: str, file: str): []Token | error {
    var ntok = match count_tokens(source) { u64 as n => n; error as e => return e }
    var tokens: [ntok]Token = []
    var count: u64 = 0
    var pos: u64 = 0
    var cur_pos: u64 = 0
    var cur_line: u32 = 1
    var cur_col: u32 = 1

    loop {
        var step = match lex_step(source, pos) { LexStep as s => s; error as e => return e }
        if step.done { break }

        loop {
            if cur_pos >= step.start { break }
            if source[cur_pos] == b'\n' { cur_line = cur_line + 1; cur_col = 1 } else { cur_col = cur_col + 1 }
            cur_pos = cur_pos + 1
        }

        if step.has_token {
            tokens[count] = stamp_loc(step.token, cur_line, cur_col, step.start, file)
            count++
        }
        pos = step.next
    }

    teko::collections::arr_slice(tokens, 0, count)
}
