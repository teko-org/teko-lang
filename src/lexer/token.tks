
pub type TokenKind = enum {
    Number
    Ident
    Str
    Byte
    ByteStr
    Underscore

    Fn
    Type
    Struct
    Enum
    Flags
    Const
    If
    Else
    Loop
    Break
    Continue
    Return
    Defer
    Match
    When
    As
    Use
    Exp
    True
    False
    Null

    Plus
    Minus
    Star
    Slash
    Percent
    Amp
    Pipe
    Caret
    Tilde
    Shl
    Shr

    Assign
    PlusEq
    MinusEq
    StarEq
    SlashEq
    PercentEq
    AmpEq
    PipeEq
    CaretEq
    ShlEq
    ShrEq

    EqEq
    Ne
    Lt
    Le
    Gt
    Ge

    AndAnd
    OrOr
    Bang

    LParen
    RParen
    LBrace
    RBrace
    LBracket
    RBracket
    Comma
    Colon
    ColonColon
    FatArrow
    DotDotEq
    Newline
    Doc

    To
    Dot
    Semicolon
    Variant


    Pub

    PlusPlus
    MinusMinus

    Interp

    In

    Hash

    Extern

    DotDot

    InterpRaw

    Char

    Class
    Abstract
    Virtual
    Override
    Intern
    Interface

    SelfKw
    Base
    Static
    Global
    Service
    Walrus

    At
    Macro
    Comptime
    Dollar
}

pub type Token = struct {
    kind: TokenKind
    text: str
    line: u32
    col: u32
    byte_off: u64
    file: str
}
