use teko::parser
use teko::lexer

fn const_form_error(msg: str, e: TExpr): error {
    teko::error::err_loc(error { message = msg }, e.line, e.col)
}

fn form_name(k: @TExprKind()): str {
    match k {
        TNullLit => "a `null` literal"
        TCompare => "a comparison"
        TIfExpr => "an `if` expression"
        TMatchExpr => "a `match` expression"
        TFieldAccess => "a field access"
        TIndex => "an index expression"
        TInterp => "a string interpolation"
        TInExpr => "an `in` membership test"
        TLambda => "a closure literal"
        TBlockExpr => "a block expression"
        _ => "this expression"
    }
}

fn reject_form(e: TExpr): error {
    const_form_error($"{form_name(e.kind)} is not allowed in a const initializer", e)
}

fn is_const_binary_op(op: lexer::TokenKind): bool {
    match op {
        lexer::TokenKind::Plus => true
        lexer::TokenKind::Minus => true
        lexer::TokenKind::Star => true
        lexer::TokenKind::Slash => true
        lexer::TokenKind::Percent => true
        lexer::TokenKind::Amp => true
        lexer::TokenKind::Pipe => true
        lexer::TokenKind::Caret => true
        lexer::TokenKind::Shl => true
        lexer::TokenKind::Shr => true
        _ => false
    }
}

fn is_const_unary_op(op: lexer::TokenKind): bool {
    match op {
        lexer::TokenKind::Tilde => true
        lexer::TokenKind::Minus => true
        _ => false
    }
}

fn path_str(path: parser::Path): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= path.segments.len { break }
        if i > 0 { out = $"{out}::" }
        out = $"{out}{path.segments[i].name}"
        i++
    }
    out
}

fn is_const_allowlisted_callee(path: parser::Path): bool {
    var n = path.segments.len
    if n == 1 { return path.segments[0].name == "preg" }
    if n == 2 {
        if path.segments[0].name != "teko" { return false }
        var last = path.segments[1].name
        return last == "f64_from_bits" || last == "f32_from_bits"
    }
    false
}

fn const_var_ok(v: TVar, e: TExpr, env: Env): error | null {
    match lookup_binding(env, v.name) {
        ValBinding as b => if b.is_const { null } else { const_form_error($"reference to '{v.name}', which is not a module-level const, in a const initializer", e) }
        error => const_form_error($"reference to undefined name '{v.name}' in a const initializer", e)
    }
}

fn const_unary_ok(u: TUnary, e: TExpr, table: TypeTable, env: Env): error | null {
    if !is_const_unary_op(u.op) { return const_form_error("a non-const unary operator in a const initializer (only `~` and unary `-` are allowed)", e) }
    is_const_expr(u.operand, table, env)
}

fn const_binary_ok(b: TBinary, e: TExpr, table: TypeTable, env: Env): error | null {
    if !is_const_binary_op(b.op) { return const_form_error("a non-const binary operator in a const initializer (only `+ - * / % & | ^ << >>` are allowed)", e) }
    match is_const_expr(b.left, table, env) { error as x => return x; null => { } }
    is_const_expr(b.right, table, env)
}

fn const_exprs_ok(xs: []TExpr, table: TypeTable, env: Env): error | null {
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        match is_const_expr(xs[i], table, env) { error as x => return x; null => { } }
        i++
    }
    null
}

fn const_array_ok(a: TArrayLit, table: TypeTable, env: Env): error | null {
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        match is_const_expr(a.elements[i].expr, table, env) { error as x => return x; null => { } }
        i++
    }
    null
}

fn const_call_ok(c: TCall, e: TExpr, table: TypeTable, env: Env): error | null {
    if !is_const_allowlisted_callee(c.callee) { return const_form_error($"call to '{path_str(c.callee)}' is not an allowlisted const constructor", e) }
    const_exprs_ok(c.args, table, env)
}

fn is_const_expr(e: TExpr, table: TypeTable, env: Env): error | null {
    match e.kind {
        TNumber => null
        TStrLit => null
        TByteStrLit => null
        TByteLit => null
        TCharLit => null
        TBoolLit => null
        TPathExpr => null
        TCast as c => is_const_expr(c.expr, table, env)
        TUnary as u => const_unary_ok(u, e, table, env)
        TBinary as b => const_binary_ok(b, e, table, env)
        TVar as v => const_var_ok(v, e, env)
        TArrayLit as a => const_array_ok(a, table, env)
        TStructInit as s => const_exprs_ok(s.field_vals, table, env)
        TCall as c => const_call_ok(c, e, table, env)
        _ => reject_form(e)
    }
}
