use teko::lexer
use teko::parser

pub type ConstValue = struct { kind: CVInt | CVFloat | CVBool | CVBytes | CVAgg }

pub type CVInt = struct { bits: u64; ty: @Type() }

pub type CVFloat = struct { bits: u64; is_f32: bool }

pub type CVBool = struct { v: bool }

pub type CVBytes = struct { data: []byte }

pub type CVAgg = struct { elems: []ConstValue }

type IntInfo = struct { width: u32; is_signed: bool }

fn cv_int(bits: u64, ty: @Type()): ConstValue { ConstValue { kind = CVInt { bits = bits; ty = ty } } }

fn cv_float(bits: u64, is_f32: bool): ConstValue { ConstValue { kind = CVFloat { bits = bits; is_f32 = is_f32 } } }

fn cv_bool(v: bool): ConstValue { ConstValue { kind = CVBool { v = v } } }

fn cv_bytes(data: []byte): ConstValue { ConstValue { kind = CVBytes { data = data } } }

pub type AggConstMap = ScalarConstMap

fn cv_agg(elems: []ConstValue): ConstValue { ConstValue { kind = CVAgg { elems = elems } } }

fn width_mask(w: u32): u64 {
    if w >= 64 { return ~(0 to u64) }
    (1 to u64 << w) - 1
}

fn mask_to_width(bits: u64, w: u32): u64 { bits & width_mask(w) }

fn bit_set(bits: u64, pos: u32): bool { ((bits >> pos) & (1 to u64)) == (1 to u64) }

fn msb_value(w: u32): u64 { 1 to u64 << (w - 1) }

fn is_negative(bits: u64, info: IntInfo): bool { info.is_signed && bit_set(mask_to_width(bits, info.width), info.width - 1) }

fn twos_neg(x: u64, w: u32): u64 { mask_to_width((width_mask(w) - mask_to_width(x, w)) + (1 to u64), w) }

fn magnitude(bits: u64, info: IntInfo): u64 {
    if is_negative(bits, info) { return twos_neg(bits, info.width) }
    mask_to_width(bits, info.width)
}

fn is_min_bits(bits: u64, info: IntInfo): bool { info.is_signed && mask_to_width(bits, info.width) == msb_value(info.width) }

fn is_all_ones(bits: u64, w: u32): bool { mask_to_width(bits, w) == width_mask(w) }

fn int_info(t: @Type()): IntInfo | error {
    match t {
        Prim as p => {
            if !prim_is_int(p.kind) { return error { message = "comptime fold: type is not an integer" } }
            var w = prim_width(p.kind, host_target())
            if w > 64 { return error { message = "comptime fold: integer width wider than 64 bits is not evaluated" } }
            IntInfo { width = w; is_signed = prim_is_signed(p.kind) }
        }
        Byte => IntInfo { width = 8; is_signed = false }
        _ => error { message = "comptime fold: type is not an integer" }
    }
}

pub fn eval_const(e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): ConstValue | error {
    match e.kind {
        TNumber as n => eval_number(n, e)
        TBoolLit as b => cv_bool(b.value)
        TByteLit as by => cv_int(by.value to u64, Byte { })
        TCharLit as ch => cv_bytes(ch.bytes.bytes())
        TStrLit as s => cv_bytes(s.text.bytes())
        TCast as c => eval_cast_expr(c, e, table, env, agg)
        TUnary as u => eval_unary_expr(u, e, table, env, agg)
        TBinary as bi => eval_binary_expr(bi, e, table, env, agg)
        TVar as v => eval_agg_ref(v, e, table, env, agg)
        TArrayLit as a => eval_array_agg(a, table, env, agg)
        TStructInit as si => eval_struct_agg(si, table, env, agg)
        TIndex as ix => eval_index_expr(ix, e, table, env, agg)
        TFieldAccess as fa => eval_field_expr(fa, e, table, env, agg)
        _ => const_form_error("this expression is not a Tier-0..2 scalar constant the comptime fold evaluates yet", e)
    }
}

pub fn predicate_folds_const(e: TExpr): bool {
    predicate_folds(e, fold_empty_table(), env_empty())
}

fn eval_folds(e: TExpr, table: TypeTable, env: Env): bool {
    match eval_const(e, table, env, fold_empty_agg()) { ConstValue => true; error => false }
}

fn predicate_folds(e: TExpr, table: TypeTable, env: Env): bool {
    if eval_folds(e, table, env) { return true }
    match e.kind {
        TCompare as c => compare_operands_fold(c, table, env)
        TBinary as b => logical_binary_folds(b, table, env)
        TUnary as u => predicate_folds(u.operand, table, env)
        _ => false
    }
}

fn compare_operands_fold(c: TCompare, table: TypeTable, env: Env): bool {
    if !eval_folds(c.first, table, env) { return false }
    var i: u64 = 0
    loop {
        if i >= c.rest.len { break }
        if !eval_folds(c.rest[i].operand, table, env) { return false }
        i++
    }
    true
}

fn logical_binary_folds(b: TBinary, table: TypeTable, env: Env): bool {
    if b.op != lexer::TokenKind::AndAnd && b.op != lexer::TokenKind::OrOr { return false }
    predicate_folds(b.left, table, env) && predicate_folds(b.right, table, env)
}

fn eval_number(n: TNumber, e: TExpr): ConstValue | error {
    if n.is_float { return eval_float_literal(n.fval, e.type, e) }
    eval_int_literal(n.value, e.type, e)
}

fn eval_int_literal(value: parser::NumInt, t: @Type(), e: TExpr): ConstValue | error {
    match int_info(t) {
        error => return const_form_error("comptime fold: a non-integer type on an integer literal", e)
        IntInfo as info => encode_int_literal(value, info, t, e)
    }
}

fn encode_int_literal(value: parser::NumInt, info: IntInfo, t: @Type(), e: TExpr): ConstValue | error {
    if value.neg {
        if !info.is_signed { return const_form_error("negative literal is out of range for an unsigned type", e) }
        if value.mag > msb_value(info.width) { return const_form_error("integer literal is out of range for its type", e) }
        return cv_int(mask_to_width((width_mask(info.width) - value.mag) + (1 to u64), info.width), t)
    }
    var max = if info.is_signed { msb_value(info.width) - (1 to u64) } else { width_mask(info.width) }
    if value.mag > max { return const_form_error("integer literal is out of range for its type", e) }
    cv_int(mask_to_width(value.mag, info.width), t)
}

fn eval_float_literal(fval: f64, t: @Type(), e: TExpr): ConstValue | error {
    match t {
        Prim as p => {
            if p.kind == PrimKind::F64 { return cv_float(teko::f64_bits(fval), false) }
            const_form_error("comptime folding of this float width is not yet supported (only f64)", e)
        }
        _ => const_form_error("comptime fold: a non-float type on a float literal", e)
    }
}

fn eval_cast_expr(c: TCast, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): ConstValue | error {
    match eval_const(c.expr, table, env, agg) {
        error as x => return x
        ConstValue as v => apply_cast(v, e.type, e)
    }
}

fn apply_cast(v: ConstValue, target: @Type(), e: TExpr): ConstValue | error {
    match int_info(target) {
        IntInfo as dst => cast_to_int(v, target, dst, e)
        error => cast_to_non_int(v, target, e)
    }
}

fn cast_to_non_int(v: ConstValue, target: @Type(), e: TExpr): ConstValue | error {
    if !is_byte_slice(target) { return const_form_error("comptime fold: this cast target is not yet supported", e) }
    match v.kind {
        CVBytes as cb => cv_agg(bytes_to_cv_elems(cb.data))
        _ => const_form_error("comptime fold: only a const string coerces to a byte-array const", e)
    }
}

fn bytes_to_cv_elems(data: []byte): []ConstValue {
    var out: [data.len]ConstValue = []
    var i: u64 = 0
    loop {
        if i >= data.len { break }
        out[i] = cv_int(data[i] to u64, Byte { })
        i++
    }
    out
}

fn is_byte_slice(t: @Type()): bool {
    match t {
        Slice as sl => is_byte_type(sl.element)
        _ => false
    }
}

fn is_byte_type(t: @Type()): bool {
    match t {
        Byte => true
        _ => false
    }
}

fn cast_to_int(v: ConstValue, target: @Type(), dst: IntInfo, e: TExpr): ConstValue | error {
    match v.kind {
        CVInt as ci => cast_int_to_int(ci, target, dst, e)
        CVBool as cb => cv_int(if cb.v { 1 to u64 } else { 0 to u64 }, target)
        _ => const_form_error("comptime fold: cannot cast this constant kind to an integer", e)
    }
}

fn cast_int_to_int(ci: CVInt, target: @Type(), dst: IntInfo, e: TExpr): ConstValue | error {
    match int_info(ci.ty) {
        error as x => return x
        IntInfo as src => cast_int_widths(ci.bits, src, target, dst, e)
    }
}

fn cast_int_widths(bits: u64, src: IntInfo, target: @Type(), dst: IntInfo, e: TExpr): ConstValue | error {
    if is_negative(bits, src) {
        if !dst.is_signed { return const_form_error("constant is out of range for the cast target (a negative value to an unsigned type)", e) }
        var m = twos_neg(bits, src.width)
        if m > msb_value(dst.width) { return const_form_error("constant is out of range for the cast target", e) }
        return cv_int(twos_neg(m, dst.width), target)
    }
    var v = mask_to_width(bits, src.width)
    if v > cast_max(dst) { return const_form_error("constant is out of range for the cast target", e) }
    cv_int(mask_to_width(v, dst.width), target)
}

fn cast_max(dst: IntInfo): u64 {
    if dst.is_signed { return msb_value(dst.width) - (1 to u64) }
    width_mask(dst.width)
}

fn eval_unary_expr(u: TUnary, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): ConstValue | error {
    if u.op == lexer::TokenKind::Minus {
        match u.operand.kind {
            TNumber as n => if !n.is_float { return eval_int_literal(parser::numint_negate(n.value), e.type, e) }
            _ => { }
        }
    }
    match eval_const(u.operand, table, env, agg) {
        error as x => return x
        ConstValue as v => apply_unary(u.op, v, e)
    }
}

fn apply_unary(op: lexer::TokenKind, v: ConstValue, e: TExpr): ConstValue | error {
    match v.kind {
        CVInt as ci => int_unary(op, ci, e)
        CVFloat as cf => apply_float_unary(op, cf, e)
        _ => const_form_error("comptime fold: unsupported unary operator on this constant", e)
    }
}

fn int_unary(op: lexer::TokenKind, ci: CVInt, e: TExpr): ConstValue | error {
    match int_info(ci.ty) {
        error as x => return x
        IntInfo as info => int_unary_at(op, ci, info, e)
    }
}

fn int_unary_at(op: lexer::TokenKind, ci: CVInt, info: IntInfo, e: TExpr): ConstValue | error {
    var a = mask_to_width(ci.bits, info.width)
    match op {
        lexer::TokenKind::Tilde => cv_int(width_mask(info.width) ^ a, ci.ty)
        lexer::TokenKind::Minus => int_negate(a, info, ci.ty, e)
        _ => const_form_error("comptime fold: unsupported unary operator on an integer constant", e)
    }
}

fn int_negate(a: u64, info: IntInfo, ty: @Type(), e: TExpr): ConstValue | error {
    if !info.is_signed {
        if mask_to_width(a, info.width) == (0 to u64) { return cv_int(0 to u64, ty) }
        return const_form_error("negation of a non-zero unsigned constant is out of range", e)
    }
    if is_min_bits(a, info) { return const_form_error("integer overflow negating a constant (a signed MIN has no positive)", e) }
    cv_int(twos_neg(a, info.width), ty)
}

fn apply_float_unary(op: lexer::TokenKind, cf: CVFloat, e: TExpr): ConstValue | error {
    match op {
        lexer::TokenKind::Minus => float_negate(cf, e)
        _ => const_form_error("comptime fold: unsupported unary operator on a float constant", e)
    }
}

fn float_negate(cf: CVFloat, e: TExpr): ConstValue | error {
    if cf.is_f32 { return const_form_error("comptime folding of f32 is not yet supported", e) }
    cv_float(teko::f64_bits(-(teko::f64_from_bits(cf.bits))), false)
}

fn eval_binary_expr(bi: TBinary, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): ConstValue | error {
    match eval_const(bi.left, table, env, agg) {
        error as x => return x
        ConstValue as lv => eval_binary_right(bi, lv, e, table, env, agg)
    }
}

fn eval_binary_right(bi: TBinary, lv: ConstValue, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): ConstValue | error {
    match eval_const(bi.right, table, env, agg) {
        error as y => return y
        ConstValue as rv => apply_binary(bi.op, lv, rv, e)
    }
}

fn agg_const_init(agg: AggConstMap, name: str, ns: str): TExpr | null {
    var i: u64 = 0
    loop {
        if i >= agg.names.len { break }
        if agg.names[i] == name && agg.nss[i] == ns { return agg.inits[i] }
        i++
    }
    null
}

fn eval_agg_ref(v: TVar, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): ConstValue | error {
    if v.is_func { return const_form_error("comptime fold: a function value is not a const aggregate", e) }
    match agg_const_init(agg, v.name, v.func_ns) {
        null => const_form_error("comptime fold: this reference is not a module aggregate const", e)
        TExpr as init => eval_const(init, table, env, agg)
    }
}

fn eval_array_agg(a: TArrayLit, table: TypeTable, env: Env, agg: AggConstMap): ConstValue | error {
    var elems: [a.elements.len]ConstValue = []
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        if a.elements[i].is_spread { return error { message = "comptime fold: a spread element is not a const aggregate" } }
        var v = match eval_const(a.elements[i].expr, table, env, agg) { error as x => return x; ConstValue as cv => cv }
        elems[i] = v
        i++
    }
    cv_agg(elems)
}

fn eval_struct_agg(si: TStructInit, table: TypeTable, env: Env, agg: AggConstMap): ConstValue | error {
    var elems: [si.field_vals.len]ConstValue = []
    var i: u64 = 0
    loop {
        if i >= si.field_vals.len { break }
        var v = match eval_const(si.field_vals[i], table, env, agg) { error as x => return x; ConstValue as cv => cv }
        elems[i] = v
        i++
    }
    cv_agg(elems)
}

fn eval_index_expr(ix: TIndex, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): ConstValue | error {
    var recv = match eval_const(ix.receiver, table, env, agg) { error as x => return x; ConstValue as cv => cv }
    var idx = match eval_const(ix.index, table, env, agg) { error as x => return x; ConstValue as cv => cv }
    match recv.kind {
        CVAgg as ag => eval_index_at(ag, idx, e)
        _ => const_form_error("comptime fold: index receiver is not a const aggregate", e)
    }
}

fn eval_index_at(ag: CVAgg, idx: ConstValue, e: TExpr): ConstValue | error {
    match idx.kind {
        CVInt as ci => eval_index_pick(ag, ci, e)
        _ => const_form_error("comptime fold: index is not a const integer", e)
    }
}

fn eval_index_pick(ag: CVAgg, ci: CVInt, e: TExpr): ConstValue | error {
    var iv = match index_carrier(ci) { null => return const_form_error("comptime fold: index is out of range", e); parser::NumInt as v => v }
    if iv.neg { return const_form_error("comptime fold: a negative index is out of range", e) }
    if iv.mag >= ag.elems.len { return const_form_error("comptime fold: index is out of range for the aggregate length", e) }
    ag.elems[iv.mag]
}

fn index_carrier(ci: CVInt): parser::NumInt | null {
    match int_info(ci.ty) {
        error => null
        IntInfo as info => cv_int_to_numint(ci.bits, info)
    }
}

fn eval_field_expr(fa: TFieldAccess, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): ConstValue | error {
    if is_len_field(fa) { return eval_len_field(fa, e, table, env, agg) }
    eval_struct_field(fa, e, table, env, agg)
}

fn is_len_field(fa: TFieldAccess): bool {
    if fa.field != "len" { return false }
    if is_str_type(fa.receiver.type) { return true }
    match fa.receiver.type {
        Slice => true
        _ => false
    }
}

fn eval_len_field(fa: TFieldAccess, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): ConstValue | error {
    var recv = match eval_const(fa.receiver, table, env, agg) { error as x => return x; ConstValue as v => v }
    match value_length(recv) {
        null => const_form_error("comptime fold: `.len` receiver is not a const string or aggregate", e)
        u64 as n => cv_int(n, e.type)
    }
}

fn value_length(v: ConstValue): u64 | null {
    match v.kind {
        CVAgg as ag => ag.elems.len
        CVBytes as cb => cb.data.len
        _ => null
    }
}

fn eval_struct_field(fa: TFieldAccess, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): ConstValue | error {
    match struct_field_init(fa.receiver, fa.field, agg) {
        null => const_form_error("comptime fold: field-access receiver is not a const struct", e)
        TExpr as fv => eval_const(fv, table, env, agg)
    }
}

fn struct_field_init(recv: TExpr, field: str, agg: AggConstMap): TExpr | null {
    match resolve_struct_init(recv, agg) {
        null => null
        TStructInit as si => field_init_by_name(si, field)
    }
}

fn resolve_struct_init(recv: TExpr, agg: AggConstMap): TStructInit | null {
    match recv.kind {
        TStructInit as si => si
        TVar as v => resolve_struct_init_var(v, agg)
        _ => null
    }
}

fn resolve_struct_init_var(v: TVar, agg: AggConstMap): TStructInit | null {
    if v.is_func { return null }
    match agg_const_init(agg, v.name, v.func_ns) {
        null => null
        TExpr as init => match init.kind {
            TStructInit as si => si
            _ => null
        }
    }
}

fn field_init_by_name(si: TStructInit, field: str): TExpr | null {
    var i: u64 = 0
    loop {
        if i >= si.field_names.len { break }
        if si.field_names[i] == field { return si.field_vals[i] }
        i++
    }
    null
}

fn apply_binary(op: lexer::TokenKind, lv: ConstValue, rv: ConstValue, e: TExpr): ConstValue | error {
    match lv.kind {
        CVInt as li => apply_binary_int(op, li, rv, e)
        CVFloat as lf => apply_binary_float(op, lf, rv, e)
        _ => const_form_error("comptime fold: unsupported operand kind in a binary op", e)
    }
}

fn apply_binary_int(op: lexer::TokenKind, li: CVInt, rv: ConstValue, e: TExpr): ConstValue | error {
    match rv.kind {
        CVInt as ri => int_binop(op, li, ri, e)
        _ => const_form_error("comptime fold: mismatched operand kinds in a binary op", e)
    }
}

fn apply_binary_float(op: lexer::TokenKind, lf: CVFloat, rv: ConstValue, e: TExpr): ConstValue | error {
    match rv.kind {
        CVFloat as rf => float_binop(op, lf, rf, e)
        _ => const_form_error("comptime fold: mismatched operand kinds in a binary op", e)
    }
}

fn int_binop(op: lexer::TokenKind, la: CVInt, ra: CVInt, e: TExpr): ConstValue | error {
    match int_info(la.ty) {
        error as x => return x
        IntInfo as info => int_binop_dispatch(op, la, ra, info, e)
    }
}

fn int_binop_dispatch(op: lexer::TokenKind, la: CVInt, ra: CVInt, info: IntInfo, e: TExpr): ConstValue | error {
    var a = mask_to_width(la.bits, info.width)
    var b = mask_to_width(ra.bits, info.width)
    match op {
        lexer::TokenKind::Plus => int_add(a, b, info, la.ty, e)
        lexer::TokenKind::Minus => int_sub(a, b, info, la.ty, e)
        lexer::TokenKind::Star => int_mul(a, b, info, la.ty, e)
        lexer::TokenKind::Slash => int_divrem(true, a, b, info, la.ty, e)
        lexer::TokenKind::Percent => int_divrem(false, a, b, info, la.ty, e)
        lexer::TokenKind::Amp => cv_int(mask_to_width(a & b, info.width), la.ty)
        lexer::TokenKind::Pipe => cv_int(mask_to_width(a | b, info.width), la.ty)
        lexer::TokenKind::Caret => cv_int(mask_to_width(a ^ b, info.width), la.ty)
        lexer::TokenKind::Shl => int_shift(true, la, ra, info, e)
        lexer::TokenKind::Shr => int_shift(false, la, ra, info, e)
        _ => const_form_error("comptime fold: unsupported binary operator on an integer constant", e)
    }
}

fn int_add(a: u64, b: u64, info: IntInfo, ty: @Type(), e: TExpr): ConstValue | error {
    var raw = a + b
    var res = mask_to_width(raw, info.width)
    if int_add_overflows(a, b, res, raw, info) { return const_form_error("integer overflow in a constant `+` (out of range for its type)", e) }
    cv_int(res, ty)
}

fn int_add_overflows(a: u64, b: u64, res: u64, raw: u64, info: IntInfo): bool {
    if info.is_signed {
        var sa = bit_set(a, info.width - 1)
        var sb = bit_set(b, info.width - 1)
        var sr = bit_set(res, info.width - 1)
        return (sa == sb) && (sr != sa)
    }
    if info.width >= 64 { return raw < a }
    raw > width_mask(info.width)
}

fn int_sub(a: u64, b: u64, info: IntInfo, ty: @Type(), e: TExpr): ConstValue | error {
    var res = mask_to_width(a + twos_neg(b, info.width), info.width)
    if int_sub_overflows(a, b, res, info) { return const_form_error("integer overflow in a constant `-` (out of range for its type)", e) }
    cv_int(res, ty)
}

fn int_sub_overflows(a: u64, b: u64, res: u64, info: IntInfo): bool {
    if info.is_signed {
        var sa = bit_set(a, info.width - 1)
        var sb = bit_set(b, info.width - 1)
        var sr = bit_set(res, info.width - 1)
        return (sa != sb) && (sr != sa)
    }
    a < b
}

fn int_mul(a: u64, b: u64, info: IntInfo, ty: @Type(), e: TExpr): ConstValue | error {
    var res = mask_to_width(a * b, info.width)
    if int_mul_overflows(a, b, info) { return const_form_error("integer overflow in a constant `*` (out of range for its type)", e) }
    cv_int(res, ty)
}

fn int_mul_overflows(a: u64, b: u64, info: IntInfo): bool {
    if !info.is_signed { return unsigned_mul_overflows(a, b, info) }
    signed_mul_overflows(a, b, info)
}

fn unsigned_mul_overflows(a: u64, b: u64, info: IntInfo): bool {
    if mul_mag_overflows(a, b) { return true }
    if info.width >= 64 { return false }
    (a * b) > width_mask(info.width)
}

fn signed_mul_overflows(a: u64, b: u64, info: IntInfo): bool {
    var ua = magnitude(a, info)
    var ub = magnitude(b, info)
    if mul_mag_overflows(ua, ub) { return true }
    var cap = msb_value(info.width)
    var prod = ua * ub
    if prod > cap { return true }
    if prod == cap { return bit_set(a, info.width - 1) == bit_set(b, info.width - 1) }
    false
}

fn mul_mag_overflows(x: u64, y: u64): bool { x != (0 to u64) && ((x * y) / x != y) }

fn int_divrem(is_div: bool, a: u64, b: u64, info: IntInfo, ty: @Type(), e: TExpr): ConstValue | error {
    if mask_to_width(b, info.width) == (0 to u64) { return divrem_zero_error(is_div, e) }
    if info.is_signed && is_min_bits(a, info) && is_all_ones(b, info.width) { return const_form_error("integer overflow in a constant signed division (MIN / -1)", e) }
    if !info.is_signed { return cv_int(mask_to_width(if is_div { a / b } else { a % b }, info.width), ty) }
    var ua = magnitude(a, info)
    var ub = magnitude(b, info)
    if is_div { return int_div_signed(ua, ub, a, b, info, ty) }
    int_rem_signed(ua, ub, a, info, ty)
}

fn divrem_zero_error(is_div: bool, e: TExpr): error {
    if is_div { return const_form_error("division by zero in a constant", e) }
    const_form_error("remainder by zero in a constant", e)
}

fn int_div_signed(ua: u64, ub: u64, a: u64, b: u64, info: IntInfo, ty: @Type()): ConstValue | error {
    var uq = ua / ub
    var neg = bit_set(a, info.width - 1) != bit_set(b, info.width - 1)
    var res = if neg { twos_neg(uq, info.width) } else { uq }
    cv_int(mask_to_width(res, info.width), ty)
}

fn int_rem_signed(ua: u64, ub: u64, a: u64, info: IntInfo, ty: @Type()): ConstValue | error {
    var ur = ua % ub
    var neg = bit_set(a, info.width - 1)
    var res = if neg { twos_neg(ur, info.width) } else { ur }
    cv_int(mask_to_width(res, info.width), ty)
}

fn int_shift(is_left: bool, la: CVInt, ra: CVInt, info: IntInfo, e: TExpr): ConstValue | error {
    var cnt = shift_count(ra.bits, info.width)
    var a = mask_to_width(la.bits, info.width)
    if is_left { return cv_int(mask_to_width(a << cnt, info.width), la.ty) }
    if is_arith_shift(a, cnt, info) { return cv_int(arith_shr(a, cnt, info), la.ty) }
    cv_int(mask_to_width(a >> cnt, info.width), la.ty)
}

fn shift_count(bits: u64, w: u32): u32 { (bits & (w - 1)) to u32 }

fn is_arith_shift(a: u64, cnt: u32, info: IntInfo): bool { info.is_signed && cnt > 0 && bit_set(a, info.width - 1) }

fn arith_shr(a: u64, cnt: u32, info: IntInfo): u64 {
    var logical = a >> cnt
    var fill = mask_to_width(width_mask(info.width) << (info.width - cnt), info.width)
    mask_to_width(logical | fill, info.width)
}

fn float_binop(op: lexer::TokenKind, lf: CVFloat, rf: CVFloat, e: TExpr): ConstValue | error {
    if lf.is_f32 || rf.is_f32 { return const_form_error("comptime folding of f32 is not yet supported", e) }
    var x = teko::f64_from_bits(lf.bits)
    var y = teko::f64_from_bits(rf.bits)
    match op {
        lexer::TokenKind::Plus => cv_float(teko::f64_bits(x + y), false)
        lexer::TokenKind::Minus => cv_float(teko::f64_bits(x - y), false)
        lexer::TokenKind::Star => cv_float(teko::f64_bits(x * y), false)
        lexer::TokenKind::Slash => float_div(x, y, e)
        _ => const_form_error("comptime fold: unsupported binary operator on a float constant", e)
    }
}

fn float_div(x: f64, y: f64, e: TExpr): ConstValue | error {
    if y == 0.0 { return const_form_error("float division by zero in a constant", e) }
    cv_float(teko::f64_bits(x / y), false)
}

fn cf_is_int_type(t: @Type()): bool {
    match int_info(t) {
        IntInfo => true
        error => false
    }
}

fn cf_int_value(e: TExpr): bool {
    match e.kind {
        TNumber as n => !n.is_float && cf_is_int_type(e.type)
        TByteLit => true
        TCast as c => cf_is_int_type(e.type) && cf_cast_operand_ok(c.expr)
        TUnary as u => is_const_unary_op(u.op) && cf_int_value(u.operand)
        TBinary as b => is_const_binary_op(b.op) && cf_int_value(b.left) && cf_int_value(b.right)
        _ => false
    }
}

fn cf_cast_operand_ok(e: TExpr): bool {
    match e.kind {
        TBoolLit => true
        _ => cf_int_value(e)
    }
}

fn cf_agg_value(e: TExpr, agg: AggConstMap): bool {
    match e.kind {
        TArrayLit as a => cf_array_elems_const(a, agg)
        TVar as v => cf_var_is_agg_const(v, agg)
        TCast as c => cf_str_to_bytes_cast(e, c, agg)
        _ => false
    }
}

fn cf_str_to_bytes_cast(e: TExpr, c: TCast, agg: AggConstMap): bool {
    is_byte_slice(e.type) && cf_str_value(c.expr, agg)
}

fn cf_str_value(e: TExpr, agg: AggConstMap): bool {
    match e.kind {
        TStrLit => true
        TVar as v => cf_var_is_agg_const(v, agg)
        _ => false
    }
}

fn cf_var_is_agg_const(v: TVar, agg: AggConstMap): bool {
    if v.is_func { return false }
    match agg_const_init(agg, v.name, v.func_ns) {
        null => false
        TExpr => true
    }
}

fn cf_array_elems_const(a: TArrayLit, agg: AggConstMap): bool {
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        if a.elements[i].is_spread { return false }
        if !cf_element_const(a.elements[i].expr, agg) { return false }
        i++
    }
    true
}

fn cf_element_const(e: TExpr, agg: AggConstMap): bool {
    if cf_int_value(e) { return true }
    cf_agg_value(e, agg)
}

fn cf_can_index(ix: TIndex, agg: AggConstMap): bool {
    cf_agg_value(ix.receiver, agg) && cf_int_value(ix.index)
}

fn cf_fold_int(e: TExpr, agg: AggConstMap): bool {
    match e.kind {
        TNumber as n => !n.is_float && cf_is_int_type(e.type)
        TByteLit => true
        TCast as c => cf_is_int_type(e.type) && cf_fold_cast_operand(c.expr, agg)
        TUnary as u => is_const_unary_op(u.op) && cf_fold_int(u.operand, agg)
        TBinary as b => is_const_binary_op(b.op) && cf_fold_int(b.left, agg) && cf_fold_int(b.right, agg)
        TIndex as ix => cf_can_index(ix, agg)
        TFieldAccess as fa => cf_can_fold_field(fa, agg)
        _ => false
    }
}

fn cf_can_fold_field(fa: TFieldAccess, agg: AggConstMap): bool {
    if is_len_field(fa) { return cf_len_receiver_const(fa, agg) }
    cf_struct_int_field(fa, agg)
}

fn cf_len_receiver_const(fa: TFieldAccess, agg: AggConstMap): bool {
    if is_str_type(fa.receiver.type) { return cf_str_value(fa.receiver, agg) }
    match fa.receiver.type {
        Slice => cf_agg_value(fa.receiver, agg)
        _ => false
    }
}

fn cf_struct_int_field(fa: TFieldAccess, agg: AggConstMap): bool {
    match struct_field_init(fa.receiver, fa.field, agg) {
        null => false
        TExpr as fv => cf_fold_int(fv, agg)
    }
}

fn cf_fold_cast_operand(e: TExpr, agg: AggConstMap): bool {
    match e.kind {
        TBoolLit => true
        _ => cf_fold_int(e, agg)
    }
}

fn cv_int_to_numint(bits: u64, info: IntInfo): parser::NumInt | null {
    var v = mask_to_width(bits, info.width)
    if !info.is_signed { return parser::numint_of_u64(v) }
    if !bit_set(v, info.width - 1) { return parser::numint_of_u64(v) }
    if is_min_bits(v, info) { return parser::NumInt { neg = true; mag = msb_value(info.width) } }
    parser::NumInt { neg = true; mag = twos_neg(v, info.width) }
}

fn literal_of(v: ConstValue, ty: @Type(), line: u32, col: u32): TExpr | null {
    match v.kind {
        CVInt as ci => int_literal_of(ci, ty, line, col)
        _ => null
    }
}

fn int_literal_of(ci: CVInt, ty: @Type(), line: u32, col: u32): TExpr | null {
    match int_info(ty) {
        error => null
        IntInfo as info => match cv_int_to_numint(ci.bits, info) {
            null => null
            parser::NumInt as val => TExpr { kind = TNumber { is_float = false; value = val; fval = 0.0 }; type = ty; line = line; col = col }
        }
    }
}

pub fn comptime_literal_of(v: ConstValue, ty: @Type(), table: TypeTable, line: u32, col: u32): TExpr | null {
    match v.kind {
        CVInt as ci => int_literal_of(ci, ty, line, col)
        CVBool as cb => bool_literal_of(cb, ty, line, col)
        CVFloat as cf => float_literal_of(cf, ty, line, col)
        CVBytes as cbytes => bytes_literal_of(cbytes, ty, line, col)
        CVAgg as ag => agg_literal_of(ag, ty, table, line, col)
    }
}

fn bool_literal_of(cb: CVBool, ty: @Type(), line: u32, col: u32): TExpr | null {
    TExpr { kind = TBoolLit { value = cb.v }; type = ty; line = line; col = col }
}

fn float_literal_of(cf: CVFloat, ty: @Type(), line: u32, col: u32): TExpr | null {
    if cf.is_f32 { return null }
    TExpr { kind = TNumber { is_float = true; value = parser::numint_of_u64(0); fval = teko::f64_from_bits(cf.bits) }; type = ty; line = line; col = col }
}

fn bytes_literal_of(cb: CVBytes, ty: @Type(), line: u32, col: u32): TExpr | null {
    if is_str_type(ty) { return TExpr { kind = TStrLit { text = str_of_bytes(cb.data) }; type = ty; line = line; col = col } }
    match ty {
        Char => TExpr { kind = TCharLit { bytes = str_of_bytes(cb.data) }; type = ty; line = line; col = col }
        Slice as sl => byte_array_literal_of(cb, sl, ty, line, col)
        _ => null
    }
}

fn byte_array_literal_of(cb: CVBytes, sl: Slice, ty: @Type(), line: u32, col: u32): TExpr | null {
    if !is_byte_type(sl.element) { return null }
    var elems: [cb.data.len]TArrayElem = []
    var i: u64 = 0
    loop {
        if i >= cb.data.len { break }
        var lit = TExpr { kind = TByteLit { value = cb.data[i] }; type = sl.element; line = line; col = col }
        elems[i] = TArrayElem { is_spread = false; expr = lit }
        i++
    }
    TExpr { kind = TArrayLit { elements = elems }; type = ty; line = line; col = col }
}

fn agg_literal_of(ag: CVAgg, ty: @Type(), table: TypeTable, line: u32, col: u32): TExpr | null {
    match ty {
        Slice as sl => array_literal_of(ag, sl.element, ty, table, line, col)
        Named as nm => struct_literal_of(ag, nm, ty, table, line, col)
        _ => null
    }
}

fn array_literal_of(ag: CVAgg, elem_ty: @Type(), ty: @Type(), table: TypeTable, line: u32, col: u32): TExpr | null {
    var elems: [ag.elems.len]TArrayElem = []
    var i: u64 = 0
    loop {
        if i >= ag.elems.len { break }
        var child = match comptime_literal_of(ag.elems[i], elem_ty, table, line, col) {
            TExpr as lit => lit
            null => return null
        }
        elems[i] = TArrayElem { is_spread = false; expr = child }
        i++
    }
    TExpr { kind = TArrayLit { elements = elems }; type = ty; line = line; col = col }
}

fn struct_literal_of(ag: CVAgg, nm: Named, ty: @Type(), table: TypeTable, line: u32, col: u32): TExpr | null {
    var fvs = match deriver_field_view(nm.name, table) {
        []FieldView as v => v
        error => return null
    }
    if fvs.len != ag.elems.len { return null }
    var names: [fvs.len]str = []
    var vals: [fvs.len]TExpr = []
    var i: u64 = 0
    loop {
        if i >= fvs.len { break }
        var child = match comptime_literal_of(ag.elems[i], fvs[i].type, table, line, col) {
            TExpr as lit => lit
            null => return null
        }
        names[i] = fvs[i].name
        vals[i] = child
        i++
    }
    TExpr { kind = TStructInit { field_names = names; field_vals = vals }; type = ty; line = line; col = col }
}

pub fn fold_expr(e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    match e.kind {
        TUnary => fold_op_node(e, table, env, agg)
        TBinary => fold_op_node(e, table, env, agg)
        TCast => fold_op_node(e, table, env, agg)
        _ => fold_children(e, table, env, agg)
    }
}

fn fold_op_node(e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    if !cf_fold_int(e, agg) { return fold_children(e, table, env, agg) }
    match eval_const(e, table, env, agg) {
        error as x => return x
        ConstValue as v => fold_splice(v, e, table, env, agg)
    }
}

fn fold_splice(v: ConstValue, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    match literal_of(v, e.type, e.line, e.col) {
        TExpr as lit => lit
        null => fold_children(e, table, env, agg)
    }
}

fn fold_children(e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    match e.kind {
        TNumber => e
        TStrLit => e
        TByteStrLit => e
        TByteLit => e
        TCharLit => e
        TBoolLit => e
        TNullLit => e
        TPathExpr => e
        TVar => e
        TBinary as b => fold_binary(b, e, table, env, agg)
        TUnary as u => fold_unary(u, e, table, env, agg)
        TCompare as c => fold_compare(c, e, table, env, agg)
        TCall as cl => fold_call(cl, e, table, env, agg)
        TIfExpr as f => fold_if(f, e, table, env, agg)
        TMatchExpr as m => fold_match(m, e, table, env, agg)
        TCast as c => fold_cast(c, e, table, env, agg)
        TFieldAccess as fa => fold_field(fa, e, table, env, agg)
        TStructInit as si => fold_struct(si, e, table, env, agg)
        TIndex as ix => fold_index(ix, e, table, env, agg)
        TInterp as in => fold_rw_interp(in, e, table, env, agg)
        TInExpr as n => fold_in(n, e, table, env, agg)
        TArrayLit as a => fold_array(a, e, table, env, agg)
        TSliceOfLen as s => fold_slice_of_len(s, e, table, env, agg)
        TZeroOf => e
        TLambda as lam => fold_lambda(lam, e, table, env, agg)
        TBorrow as b => fold_borrow(b, e, table, env, agg)
        TBlockExpr as b => fold_block_expr(b, e, table, env, agg)
    }
}

fn fold_slice_of_len(s: TSliceOfLen, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var sz = match fold_expr(s.size, table, env, agg) { error as x => return x; TExpr as v => v }
    TExpr { kind = TSliceOfLen { size = sz; element = s.element }; type = e.type; line = e.line; col = e.col }
}

fn fold_block_expr(blk: TBlockExpr, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var body = match fold_block(blk.body, table, env, agg) { error as x => return x; []@TStatement() as v => v }
    TExpr { kind = TBlockExpr { body = body }; type = e.type; line = e.line; col = e.col }
}

fn fold_exprs(xs: []TExpr, table: TypeTable, env: Env, agg: AggConstMap): []TExpr | error {
    var out: [xs.len]TExpr = []
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        var v = match fold_expr(xs[i], table, env, agg) { error as x => return x; TExpr as f => f }
        out[i] = v
        i++
    }
    out
}

fn fold_binary(b: TBinary, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var l = match fold_expr(b.left, table, env, agg) { error as x => return x; TExpr as v => v }
    var r = match fold_expr(b.right, table, env, agg) { error as x => return x; TExpr as v => v }
    TExpr { kind = TBinary { op = b.op; left = l; right = r }; type = e.type; line = e.line; col = e.col }
}

fn fold_unary(u: TUnary, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var o = match fold_expr(u.operand, table, env, agg) { error as x => return x; TExpr as v => v }
    TExpr { kind = TUnary { op = u.op; operand = o }; type = e.type; line = e.line; col = e.col }
}

fn fold_cast(c: TCast, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var o = match fold_expr(c.expr, table, env, agg) { error as x => return x; TExpr as v => v }
    TExpr { kind = TCast { expr = o }; type = e.type; line = e.line; col = e.col }
}

fn fold_field(fa: TFieldAccess, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    if !cf_can_fold_field(fa, agg) { return fold_field_children(fa, e, table, env, agg) }
    var v = match eval_const(e, table, env, agg) { error as x => return x; ConstValue as cv => cv }
    match literal_of(v, e.type, e.line, e.col) {
        TExpr as lit => lit
        null => fold_field_children(fa, e, table, env, agg)
    }
}

fn fold_field_children(fa: TFieldAccess, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var r = match fold_expr(fa.receiver, table, env, agg) { error as x => return x; TExpr as v => v }
    TExpr { kind = TFieldAccess { receiver = r; field = fa.field }; type = e.type; line = e.line; col = e.col }
}

fn fold_index(ix: TIndex, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    if !cf_can_index(ix, agg) { return fold_index_children(ix, e, table, env, agg) }
    var v = match eval_const(e, table, env, agg) { error as x => return x; ConstValue as cv => cv }
    match literal_of(v, e.type, e.line, e.col) {
        TExpr as lit => lit
        null => fold_index_children(ix, e, table, env, agg)
    }
}

fn fold_index_children(ix: TIndex, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var r = match fold_expr(ix.receiver, table, env, agg) { error as x => return x; TExpr as v => v }
    var n = match fold_expr(ix.index, table, env, agg) { error as x => return x; TExpr as v => v }
    TExpr { kind = TIndex { receiver = r; index = n }; type = e.type; line = e.line; col = e.col }
}

fn fold_borrow(b: TBorrow, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var o = match fold_expr(b.operand, table, env, agg) { error as x => return x; TExpr as v => v }
    TExpr { kind = TBorrow { operand = o }; type = e.type; line = e.line; col = e.col }
}

fn fold_call(cl: TCall, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var args = match fold_exprs(cl.args, table, env, agg) { error as x => return x; []TExpr as a => a }
    TExpr { kind = TCall { overload_suffix = cl.overload_suffix; callee = cl.callee; args = args; call_ns = cl.call_ns; is_closure_call = cl.is_closure_call; callee_type = cl.callee_type; is_iface_dispatch = cl.is_iface_dispatch; iface_slot = cl.iface_slot; type_args = cl.type_args; ret_extra = cl.ret_extra }; type = e.type; line = e.line; col = e.col }
}

fn fold_struct(si: TStructInit, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var vals = match fold_exprs(si.field_vals, table, env, agg) { error as x => return x; []TExpr as v => v }
    TExpr { kind = TStructInit { field_names = si.field_names; field_vals = vals }; type = e.type; line = e.line; col = e.col }
}

fn fold_in(n: TInExpr, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var lhs = match fold_expr(n.lhs, table, env, agg) { error as x => return x; TExpr as v => v }
    var elems = match fold_exprs(n.elems, table, env, agg) { error as x => return x; []TExpr as v => v }
    TExpr { kind = TInExpr { lhs = lhs; elems = elems }; type = e.type; line = e.line; col = e.col }
}

fn fold_if(f: TIfExpr, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var cond = match fold_expr(f.cond, table, env, agg) { error as x => return x; TExpr as v => v }
    var then_blk = match fold_block(f.then_blk, table, env, agg) { error as x => return x; []@TStatement() as v => v }
    var else_blk = match fold_block(f.else_blk, table, env, agg) { error as x => return x; []@TStatement() as v => v }
    TExpr { kind = TIfExpr { cond = cond; then_blk = then_blk; has_else = f.has_else; else_blk = else_blk }; type = e.type; line = e.line; col = e.col }
}

fn fold_compare(c: TCompare, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var first = match fold_expr(c.first, table, env, agg) { error as x => return x; TExpr as v => v }
    var terms: [c.rest.len]TCmpTerm = []
    var i: u64 = 0
    loop {
        if i >= c.rest.len { break }
        var operand = match fold_expr(c.rest[i].operand, table, env, agg) { error as x => return x; TExpr as v => v }
        terms[i] = TCmpTerm { op = c.rest[i].op; operand = operand }
        i++
    }
    TExpr { kind = TCompare { first = first; rest = terms }; type = e.type; line = e.line; col = e.col }
}

fn fold_match(m: TMatchExpr, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var subject = match fold_expr(m.subject, table, env, agg) { error as x => return x; TExpr as v => v }
    var arms: [m.arms.len]TArm = []
    var i: u64 = 0
    loop {
        if i >= m.arms.len { break }
        var arm = match fold_arm(m.arms[i], table, env, agg) { error as x => return x; TArm as a => a }
        arms[i] = arm
        i++
    }
    TExpr { kind = TMatchExpr { subject = subject; arms = arms }; type = e.type; line = e.line; col = e.col }
}

fn fold_arm(arm: TArm, table: TypeTable, env: Env, agg: AggConstMap): TArm | error {
    var guard = if arm.has_when {
        match fold_expr(arm.guard, table, env, agg) { error as x => return x; TExpr as v => v }
    } else { arm.guard }
    var body = match fold_block(arm.body, table, env, agg) { error as x => return x; []@TStatement() as v => v }
    TArm { pattern = arm.pattern; has_when = arm.has_when; guard = guard; body = body }
}

fn fold_lambda(lam: TLambda, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var body = match fold_block(lam.body, table, env, agg) { error as x => return x; []@TStatement() as v => v }
    TExpr { kind = TLambda { params = lam.params; body = body; captures = lam.captures; ret = lam.ret; lift_id = lam.lift_id }; type = e.type; line = e.line; col = e.col }
}

fn fold_rw_interp(in: TInterp, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var holes: [in.holes.len]TExpr = []
    var spec_n = if in.holes.len < in.specs.len { in.holes.len } else { in.specs.len }
    var specs: [spec_n]TFSpec = []
    var i: u64 = 0
    loop {
        if i >= in.holes.len { break }
        var hole = match fold_expr(in.holes[i], table, env, agg) { error as x => return x; TExpr as v => v }
        holes[i] = hole
        if i < in.specs.len {
            var sp = match fold_fspec(in.specs[i], table, env, agg) { error as x => return x; TFSpec as s => s }
            specs[i] = sp
        }
        i++
    }
    fold_interp(TInterp { pieces = in.pieces; holes = holes; specs = specs }, e, table, env, agg)
}

fn fold_fspec(sp: TFSpec, table: TypeTable, env: Env, agg: AggConstMap): TFSpec | error {
    match sp.kind {
        TFSpecDynamic as fd => {
            var args = match fold_exprs(fd.args, table, env, agg) { error as x => return x; []TExpr as a => a }
            TFSpec { kind = TFSpecDynamic { args = args } }
        }
        _ => sp
    }
}

fn fold_array(a: TArrayLit, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    var elems: [a.elements.len]TArrayElem = []
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        var ex = match fold_expr(a.elements[i].expr, table, env, agg) { error as x => return x; TExpr as v => v }
        elems[i] = TArrayElem { is_spread = a.elements[i].is_spread; expr = ex }
        i++
    }
    TExpr { kind = TArrayLit { elements = elems }; type = e.type; line = e.line; col = e.col }
}

fn fold_block(stmts: []@TStatement(), table: TypeTable, env: Env, agg: AggConstMap): []@TStatement() | error {
    var out: [stmts.len]@TStatement() = []
    var i: u64 = 0
    loop {
        if i >= stmts.len { break }
        var s = match fold_stmt(stmts[i], table, env, agg) { error as x => return x; (@TStatement()) as v => v }
        out[i] = s
        i++
    }
    out
}

fn fold_stmt(st: @TStatement(), table: TypeTable, env: Env, agg: AggConstMap): @TStatement() | error {
    match st {
        TBinding as b => {
            var v = match fold_expr(b.value, table, env, agg) { error as x => return x; TExpr as f => f }
            TBinding { kind = b.kind; target = b.target; bound = b.bound; value = v }
        }
        TAssign as a => fold_assign(a, table, env, agg)
        TReturn as r => fold_return(r, st, table, env, agg)
        TLoopStmt as l => {
            var init = match fold_block(l.init, table, env, agg) { error as x => return x; []@TStatement() as v => v }
            var body = match fold_block(l.body, table, env, agg) { error as x => return x; []@TStatement() as v => v }
            TLoopStmt { label = l.label; init = init; body = body }
        }
        TBreakStmt => st
        TContinueStmt => st
        TExprStmt as es => {
            var v = match fold_expr(es.expr, table, env, agg) { error as x => return x; TExpr as f => f }
            TExprStmt { expr = v }
        }
        TDeferStmt as d => {
            var body = match fold_block(d.body, table, env, agg) { error as x => return x; []@TStatement() as v => v }
            TDeferStmt { body = body }
        }
        TAdoptStmt as a => {
            var body = match fold_block(a.body, table, env, agg) { error as x => return x; []@TStatement() as v => v }
            TAdoptStmt { name = a.name; body = body }
        }
        TBlockStmt as b => {
            var body = match fold_block(b.body, table, env, agg) { error as x => return x; []@TStatement() as v => v }
            TBlockStmt { body = body }
        }
        TSpawn as sp => {
            var v = match fold_expr(sp.call, table, env, agg) { error as x => return x; TExpr as f => f }
            TSpawn { call = v; id = sp.id }
        }
    }
}

fn fold_return(r: TReturn, st: @TStatement(), table: TypeTable, env: Env, agg: AggConstMap): @TStatement() | error {
    if !r.has_value { return st }
    var v = match fold_expr(r.value, table, env, agg) { error as x => return x; TExpr as f => f }
    TReturn { has_value = true; value = v; values = [] }
}

fn fold_assign(a: TAssign, table: TypeTable, env: Env, agg: AggConstMap): @TStatement() | error {
    var value = match fold_expr(a.value, table, env, agg) { error as x => return x; TExpr as f => f }
    if parser::assign_has_target(a.kind) {
        var target = match fold_expr(a.target, table, env, agg) { error as x => return x; TExpr as f => f }
        return TAssign { kind = a.kind; name = a.name; op = a.op; bound = a.bound; value = value; deref = a.deref; target = target }
    }
    TAssign { kind = a.kind; name = a.name; op = a.op; bound = a.bound; value = value; deref = a.deref; target = a.target }
}

fn fold_empty_table(): TypeTable { tt_empty() }
fn fold_empty_agg(): AggConstMap { ScalarConstMap { names = []; nss = []; inits = [] } }

pub fn fold_program(prog: TProgram, agg: AggConstMap): TProgram | error {
    var table = fold_empty_table()
    var env = env_empty()
    var ctors = collect_const_ctors(prog.items)
    var out: [prog.items.len]@TItem() = []
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        var it = match fold_item(prog.items[i], table, env, agg, ctors) { error as x => return x; (@TItem()) as v => v }
        out[i] = it
        i++
    }
    TProgram { items = out }
}

fn fold_item(it: @TItem(), table: TypeTable, env: Env, agg: AggConstMap, ctors: []TFunction): @TItem() | error {
    match it {
        TFunction as f => fold_function(f, table, env, agg)
        TConstDecl as cd => fold_const_decl(cd, table, env, agg, ctors)
        (@TStatement()) as s => match fold_stmt(s, table, env, agg) { error as x => return x; (@TStatement()) as v => v }
        _ => it
    }
}

fn fold_function(f: TFunction, table: TypeTable, env: Env, agg: AggConstMap): @TItem() | error {
    var body = match fold_block(f.body, table, env, agg) { error as x => return x; []@TStatement() as v => v }
    TFunction { overload_suffix = f.overload_suffix; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; return_type = f.return_type; body = body; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = f.namespace; file = f.file; line = f.line; col = f.col; is_test = f.is_test; is_extern = f.is_extern; c_symbol = f.c_symbol; from_lib = f.from_lib; ret_extra = f.ret_extra; guard = f.guard }
}

fn fold_const_decl(cd: TConstDecl, table: TypeTable, env: Env, agg: AggConstMap, ctors: []TFunction): @TItem() | error {
    var init = match fold_expr(cd.init, table, env, agg) { error as x => return x; TExpr as v => v }
    TConstDecl { name = cd.name; namespace = cd.namespace; ty = cd.ty; init = canonicalize_const_ctors(init, ctors); vis = cd.vis; has_doc = cd.has_doc; doc = cd.doc; line = cd.line; col = cd.col; guard = cd.guard }
}

type LocalConstMap = struct { names: []str; inits: []TExpr }

type LpBlock = struct { stmts: []@TStatement(); map: LocalConstMap }

type LpStmt = struct { stmt: @TStatement(); map: LocalConstMap }

type LpItem = struct { item: @TItem(); map: LocalConstMap }

fn lp_empty(): LocalConstMap { LocalConstMap { names = []; inits = [] } }

fn lp_lookup(m: LocalConstMap, name: str): TExpr | null {
    var i: u64 = m.names.len
    loop {
        if i == 0 { break }
        i--
        if m.names[i] == name { return m.inits[i] }
    }
    null
}

fn lp_remove(m: LocalConstMap, name: str): LocalConstMap {
    var names: []str = []
    var inits: []TExpr = []
    var i: u64 = 0
    loop {
        if i >= m.names.len { break }
        if m.names[i] != name {
            names = [..names, m.names[i]]
            inits = [..inits, m.inits[i]]
        }
        i++
    }
    LocalConstMap { names = names; inits = inits }
}

fn lp_set(m: LocalConstMap, name: str, init: TExpr): LocalConstMap {
    var r = lp_remove(m, name)
    LocalConstMap { names = [..r.names, name]; inits = [..r.inits, init] }
}

fn lp_remove_names(m: LocalConstMap, names: []str): LocalConstMap {
    var cur = m
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        cur = lp_remove(cur, names[i])
        i++
    }
    cur
}

fn lp_is_const_binding(k: parser::BindKind): bool { k == parser::BindKind::Const }

fn pattern_binds(pat: @Pattern()): []str {
    match pat {
        parser::BindPattern as bp => if bp.has_binding { [bp.binding] } else { [] }
        parser::FieldPattern as fp => fp.fields
        parser::AltPattern as ap => pattern_binds_alts(ap.options)
        _ => []
    }
}

fn pattern_binds_alts(options: []@Pattern()): []str {
    var out: []str = []
    var i: u64 = 0
    loop {
        if i >= options.len { break }
        var names = pattern_binds(options[i])
        var j: u64 = 0
        loop {
            if j >= names.len { break }
            out = [..out, names[j]]
            j++
        }
        i++
    }
    out
}

fn lp_record_binding(m: LocalConstMap, kind: parser::BindKind, target: @BindTarget(), value: TExpr): LocalConstMap {
    match target {
        parser::SimpleName as sn => lp_record_simple(m, kind, sn.name, value)
        parser::DestructurePattern as dp => lp_remove_names(m, dp.names)
    }
}

fn lp_record_simple(m: LocalConstMap, kind: parser::BindKind, name: str, value: TExpr): LocalConstMap {
    if lp_is_const_binding(kind) && cf_int_value(value) { return lp_set(m, name, value) }
    lp_remove(m, name)
}

fn lp_var(v: TVar, e: TExpr, m: LocalConstMap): TExpr {
    if v.is_func { return e }
    match lp_lookup(m, v.name) {
        TExpr as sub => widen_inlined_const(e, sub)
        null => e
    }
}

fn lp_exprs(xs: []TExpr, m: LocalConstMap): []TExpr {
    var out: [xs.len]TExpr = []
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        out[i] = lp_expr(xs[i], m)
        i++
    }
    out
}

fn lp_expr(e: TExpr, m: LocalConstMap): TExpr {
    match e.kind {
        TNumber => e
        TStrLit => e
        TByteStrLit => e
        TByteLit => e
        TCharLit => e
        TBoolLit => e
        TNullLit => e
        TPathExpr => e
        TVar as v => lp_var(v, e, m)
        TBinary as b => TExpr { kind = TBinary { op = b.op; left = lp_expr(b.left, m); right = lp_expr(b.right, m) }; type = e.type; line = e.line; col = e.col }
        TUnary as u => TExpr { kind = TUnary { op = u.op; operand = lp_expr(u.operand, m) }; type = e.type; line = e.line; col = e.col }
        TCompare as c => lp_compare(c, e, m)
        TCall as cl => TExpr { kind = TCall { overload_suffix = cl.overload_suffix; callee = cl.callee; args = lp_exprs(cl.args, m); call_ns = cl.call_ns; is_closure_call = cl.is_closure_call; callee_type = cl.callee_type; is_iface_dispatch = cl.is_iface_dispatch; iface_slot = cl.iface_slot; type_args = cl.type_args; ret_extra = cl.ret_extra }; type = e.type; line = e.line; col = e.col }
        TIfExpr as f => lp_if(f, e, m)
        TMatchExpr as mm => lp_match(mm, e, m)
        TCast as c => TExpr { kind = TCast { expr = lp_expr(c.expr, m) }; type = e.type; line = e.line; col = e.col }
        TFieldAccess as fa => TExpr { kind = TFieldAccess { receiver = lp_expr(fa.receiver, m); field = fa.field }; type = e.type; line = e.line; col = e.col }
        TStructInit as si => TExpr { kind = TStructInit { field_names = si.field_names; field_vals = lp_exprs(si.field_vals, m) }; type = e.type; line = e.line; col = e.col }
        TIndex as ix => TExpr { kind = TIndex { receiver = lp_expr(ix.receiver, m); index = lp_expr(ix.index, m) }; type = e.type; line = e.line; col = e.col }
        TInterp as in => lp_interp(in, e, m)
        TInExpr as n => TExpr { kind = TInExpr { lhs = lp_expr(n.lhs, m); elems = lp_exprs(n.elems, m) }; type = e.type; line = e.line; col = e.col }
        TArrayLit as a => lp_array(a, e, m)
        TSliceOfLen as s => TExpr { kind = TSliceOfLen { size = lp_expr(s.size, m); element = s.element }; type = e.type; line = e.line; col = e.col }
        TZeroOf => e
        TLambda => e
        TBorrow as b => TExpr { kind = TBorrow { operand = lp_expr(b.operand, m) }; type = e.type; line = e.line; col = e.col }
        TBlockExpr as b => TExpr { kind = TBlockExpr { body = lp_scope_block(b.body, m) }; type = e.type; line = e.line; col = e.col }
    }
}

fn lp_compare(c: TCompare, e: TExpr, m: LocalConstMap): TExpr {
    var terms: [c.rest.len]TCmpTerm = []
    var i: u64 = 0
    loop {
        if i >= c.rest.len { break }
        terms[i] = TCmpTerm { op = c.rest[i].op; operand = lp_expr(c.rest[i].operand, m) }
        i++
    }
    TExpr { kind = TCompare { first = lp_expr(c.first, m); rest = terms }; type = e.type; line = e.line; col = e.col }
}

fn lp_if(f: TIfExpr, e: TExpr, m: LocalConstMap): TExpr {
    var cond = lp_expr(f.cond, m)
    var then_blk = lp_scope_block(f.then_blk, m)
    var else_blk = lp_scope_block(f.else_blk, m)
    TExpr { kind = TIfExpr { cond = cond; then_blk = then_blk; has_else = f.has_else; else_blk = else_blk }; type = e.type; line = e.line; col = e.col }
}

fn lp_match(mm: TMatchExpr, e: TExpr, m: LocalConstMap): TExpr {
    var subject = lp_expr(mm.subject, m)
    var arms: [mm.arms.len]TArm = []
    var i: u64 = 0
    loop {
        if i >= mm.arms.len { break }
        arms[i] = lp_arm(mm.arms[i], m)
        i++
    }
    TExpr { kind = TMatchExpr { subject = subject; arms = arms }; type = e.type; line = e.line; col = e.col }
}

fn lp_arm(arm: TArm, m: LocalConstMap): TArm {
    var scoped = lp_remove_names(m, pattern_binds(arm.pattern))
    var guard = if arm.has_when { lp_expr(arm.guard, scoped) } else { arm.guard }
    var body = lp_scope_block(arm.body, scoped)
    TArm { pattern = arm.pattern; has_when = arm.has_when; guard = guard; body = body }
}

fn lp_interp(in: TInterp, e: TExpr, m: LocalConstMap): TExpr {
    var holes: [in.holes.len]TExpr = []
    var spec_n = if in.holes.len < in.specs.len { in.holes.len } else { in.specs.len }
    var specs: [spec_n]TFSpec = []
    var i: u64 = 0
    loop {
        if i >= in.holes.len { break }
        holes[i] = lp_expr(in.holes[i], m)
        if i < in.specs.len { specs[i] = lp_fspec(in.specs[i], m) }
        i++
    }
    TExpr { kind = TInterp { pieces = in.pieces; holes = holes; specs = specs }; type = e.type; line = e.line; col = e.col }
}

fn lp_fspec(sp: TFSpec, m: LocalConstMap): TFSpec {
    match sp.kind {
        TFSpecDynamic as fd => TFSpec { kind = TFSpecDynamic { args = lp_exprs(fd.args, m) } }
        _ => sp
    }
}

fn lp_array(a: TArrayLit, e: TExpr, m: LocalConstMap): TExpr {
    var elems: [a.elements.len]TArrayElem = []
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        elems[i] = TArrayElem { is_spread = a.elements[i].is_spread; expr = lp_expr(a.elements[i].expr, m) }
        i++
    }
    TExpr { kind = TArrayLit { elements = elems }; type = e.type; line = e.line; col = e.col }
}

fn lp_scope_block(stmts: []@TStatement(), m: LocalConstMap): []@TStatement() { lp_block(stmts, m).stmts }

fn lp_block(stmts: []@TStatement(), m: LocalConstMap): LpBlock {
    var cur = m
    var out: [stmts.len]@TStatement() = []
    var i: u64 = 0
    loop {
        if i >= stmts.len { break }
        var r = lp_stmt(stmts[i], cur)
        out[i] = r.stmt
        cur = r.map
        i++
    }
    LpBlock { stmts = out; map = cur }
}

fn lp_stmt(st: @TStatement(), m: LocalConstMap): LpStmt {
    match st {
        TBinding as b => lp_binding(b, m)
        TAssign as a => LpStmt { stmt = lp_assign(a, m); map = m }
        TReturn as r => LpStmt { stmt = lp_return(r, st, m); map = m }
        TLoopStmt as l => LpStmt { stmt = lp_loop(l, m); map = m }
        TBreakStmt => LpStmt { stmt = st; map = m }
        TContinueStmt => LpStmt { stmt = st; map = m }
        TExprStmt as es => LpStmt { stmt = TExprStmt { expr = lp_expr(es.expr, m) }; map = m }
        TDeferStmt as d => LpStmt { stmt = TDeferStmt { body = lp_scope_block(d.body, m) }; map = m }
        TAdoptStmt as a => LpStmt { stmt = lp_adopt(a, m); map = m }
        TBlockStmt as b => LpStmt { stmt = TBlockStmt { body = lp_scope_block(b.body, m) }; map = m }
        TSpawn as sp => LpStmt { stmt = TSpawn { call = lp_expr(sp.call, m); id = sp.id }; map = m }
    }
}

fn lp_binding(b: TBinding, m: LocalConstMap): LpStmt {
    var value = lp_expr(b.value, m)
    var m2 = lp_record_binding(m, b.kind, b.target, value)
    LpStmt { stmt = TBinding { kind = b.kind; target = b.target; bound = b.bound; value = value }; map = m2 }
}

fn lp_loop(l: TLoopStmt, m: LocalConstMap): @TStatement() {
    var ib = lp_block(l.init, m)
    var body = lp_scope_block(l.body, ib.map)
    TLoopStmt { label = l.label; init = ib.stmts; body = body }
}

fn lp_adopt(a: TAdoptStmt, m: LocalConstMap): @TStatement() {
    var scoped = lp_remove(m, a.name)
    TAdoptStmt { name = a.name; body = lp_scope_block(a.body, scoped) }
}

fn lp_return(r: TReturn, st: @TStatement(), m: LocalConstMap): @TStatement() {
    if !r.has_value { return st }
    TReturn { has_value = true; value = lp_expr(r.value, m); values = [] }
}

fn lp_assign(a: TAssign, m: LocalConstMap): @TStatement() {
    var value = lp_expr(a.value, m)
    if parser::assign_has_target(a.kind) {
        return TAssign { kind = a.kind; name = a.name; op = a.op; bound = a.bound; value = value; deref = a.deref; target = lp_expr(a.target, m) }
    }
    TAssign { kind = a.kind; name = a.name; op = a.op; bound = a.bound; value = value; deref = a.deref; target = a.target }
}

fn lp_function(f: TFunction): @TItem() {
    var body = lp_block(f.body, lp_empty()).stmts
    TFunction { overload_suffix = f.overload_suffix; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; return_type = f.return_type; body = body; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = f.namespace; file = f.file; line = f.line; col = f.col; is_test = f.is_test; is_extern = f.is_extern; c_symbol = f.c_symbol; from_lib = f.from_lib; ret_extra = f.ret_extra; guard = f.guard }
}

fn lp_top_item(it: @TItem(), top: LocalConstMap): LpItem {
    match it {
        TFunction as f => LpItem { item = lp_function(f); map = top }
        (@TStatement()) as s => {
            var r = lp_stmt(s, top)
            LpItem { item = r.stmt; map = r.map }
        }
        _ => LpItem { item = it; map = top }
    }
}

pub fn propagate_locals(prog: TProgram): TProgram {
    var top = lp_empty()
    var out: [prog.items.len]@TItem() = []
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        var r = lp_top_item(prog.items[i], top)
        out[i] = r.item
        top = r.map
        i++
    }
    TProgram { items = out }
}

fn cf_single_byte(b: byte): []byte { [b] }

fn cf_append_bytes(a: []byte, b: []byte): []byte {
    var out = a
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        out = [..out, b[i]]
        i++
    }
    out
}

fn cf_reverse_bytes(a: []byte): []byte {
    var out: []byte = []
    var i: u64 = a.len
    loop {
        if i == (0 to u64) { break }
        i--
        out = [..out, a[i]]
    }
    out
}

fn cf_project_u64(bits: u64, info: IntInfo): u64 {
    var masked = mask_to_width(bits, info.width)
    if info.width >= 64 { return mask_to_width(masked, 64) }
    if info.is_signed && bit_set(masked, info.width - 1) { return masked | (width_mask(64) ^ width_mask(info.width)) }
    masked
}

fn cf_as_u64(ci: CVInt): u64 {
    match int_info(ci.ty) {
        error => 0 to u64
        IntInfo as info => cf_project_u64(ci.bits, info)
    }
}

fn cf_u64_decimal(v: u64): []byte {
    if v == (0 to u64) { return cf_single_byte(48 to byte) }
    var rev: []byte = []
    var x = v
    loop {
        if x == (0 to u64) { break }
        var d = x % (10 to u64)
        rev = [..rev, (48 + d) to byte]
        x = x / (10 to u64)
    }
    cf_reverse_bytes(rev)
}

fn cf_i64_decimal(u: u64): []byte {
    if bit_set(u, 63) { return cf_append_bytes(cf_single_byte(45 to byte), cf_u64_decimal(twos_neg(u, 64))) }
    cf_u64_decimal(u)
}

fn cf_hex_digit(d: u64, upper: bool): byte {
    if d < (10 to u64) { return (48 + d) to byte }
    if upper { return (65 + (d - (10 to u64))) to byte }
    (97 + (d - (10 to u64))) to byte
}

fn cf_hex(v: u64, upper: bool): []byte {
    if v == (0 to u64) { return cf_single_byte(48 to byte) }
    var rev: []byte = []
    var x = v
    loop {
        if x == (0 to u64) { break }
        var nib = x & (15 to u64)
        rev = [..rev, cf_hex_digit(nib, upper)]
        x = x >> (4 to u32)
    }
    cf_reverse_bytes(rev)
}

fn cf_binary(v: u64): []byte {
    if v == (0 to u64) { return cf_single_byte(48 to byte) }
    var rev: []byte = []
    var x = v
    loop {
        if x == (0 to u64) { break }
        rev = [..rev, (48 + (x & (1 to u64))) to byte]
        x = x >> (1 to u32)
    }
    cf_reverse_bytes(rev)
}

fn cf_fmt_d(u: u64, width: u64): []byte {
    var neg = bit_set(u, 63)
    var mag = if neg { twos_neg(u, 64) } else { u }
    var digits = cf_u64_decimal(mag)
    var sign_len = if neg { 1 to u64 } else { 0 to u64 }
    var body = sign_len + digits.len
    var pad = if width > body { width - body } else { 0 to u64 }
    var out: []byte = []
    if neg { out = [..out, 45 to byte] }
    var i: u64 = 0
    loop {
        if i >= pad { break }
        out = [..out, 48 to byte]
        i++
    }
    cf_append_bytes(out, digits)
}

fn cf_fmt_n(u: u64): []byte {
    var neg = bit_set(u, 63)
    var mag = if neg { twos_neg(u, 64) } else { u }
    var digits = cf_u64_decimal(mag)
    var ndigits = digits.len
    var out: []byte = []
    if neg { out = [..out, 45 to byte] }
    var k: u64 = 0
    loop {
        if k >= ndigits { break }
        out = [..out, digits[k]]
        var pos = ndigits - k - (1 to u64)
        if pos > (0 to u64) && (pos % (3 to u64)) == (0 to u64) { out = [..out, 44 to byte] }
        k++
    }
    out
}

fn cf_spec_lead_low(spec: str): byte {
    var fc0 = if spec.len > (0 to u64) { spec[0] } else { 102 to byte }
    if fc0 >= (65 to byte) && fc0 <= (90 to byte) { return (fc0 to u64 + 32) to byte }
    fc0
}

fn cf_spec_width(spec: str): u64 {
    var prec: u64 = 0
    var has: bool = false
    var si: u64 = 1
    loop {
        if si >= spec.len { break }
        var ch = spec[si]
        if ch >= (48 to byte) && ch <= (57 to byte) {
            prec = prec * (10 to u64) + ((ch to u64) - (48 to u64))
            has = true
        }
        si++
    }
    if !has { return 1 to u64 }
    prec
}

fn cf_format_static_int(ci: CVInt, spec: str): []byte | error {
    var fc_low = cf_spec_lead_low(spec)
    var u = cf_as_u64(ci)
    if fc_low == (120 to byte) { return cf_hex(u, spec.len > (0 to u64) && spec[0] == (88 to byte)) }
    if fc_low == (98 to byte) { return cf_binary(u) }
    if fc_low == (100 to byte) { return cf_fmt_d(u, cf_spec_width(spec)) }
    if fc_low == (110 to byte) { return cf_fmt_n(u) }
    error { message = "comptime fold: this static format spec is not folded" }
}

fn cf_format_static(v: ConstValue, spec: str): []byte | error {
    match v.kind {
        CVInt as ci => cf_format_static_int(ci, spec)
        _ => error { message = "comptime fold: a static format spec on a non-integer constant is not folded" }
    }
}

fn cf_bytes_value(v: ConstValue): []byte | error {
    match v.kind {
        CVBytes as cb => cb.data
        _ => error { message = "comptime fold: expected a string/char constant here" }
    }
}

fn cf_bool_value(v: ConstValue): []byte | error {
    match v.kind {
        CVBool as cb => if cb.v { "true".bytes() } else { "false".bytes() }
        _ => error { message = "comptime fold: expected a boolean constant here" }
    }
}

fn cf_int_none_value(ci: CVInt, pk: PrimKind): []byte {
    if prim_is_signed(pk) { return cf_i64_decimal(cf_as_u64(ci)) }
    cf_u64_decimal(cf_as_u64(ci))
}

fn cf_format_none_prim(v: ConstValue, p: Prim): []byte | error {
    if p.kind == PrimKind::Bool { return cf_bool_value(v) }
    if prim_is_int(p.kind) {
        match v.kind {
            CVInt as ci => cf_int_none_value(ci, p.kind)
            _ => error { message = "comptime fold: expected an integer constant here" }
        }
    } else {
        error { message = "comptime fold: this prim hole type is not folded" }
    }
}

fn cf_format_none(v: ConstValue, hole_ty: @Type()): []byte | error {
    if is_str_type(hole_ty) { return cf_bytes_value(v) }
    match hole_ty {
        Char => cf_bytes_value(v)
        Byte => match v.kind { CVInt as ci => cf_u64_decimal(cf_as_u64(ci)); _ => error { message = "comptime fold: expected a byte constant here" } }
        Prim as p => cf_format_none_prim(v, p)
        _ => error { message = "comptime fold: this interpolation hole type is not folded" }
    }
}

pub fn comptime_format(v: ConstValue, sp: TFSpec, hole_ty: @Type()): []byte | error {
    match sp.kind {
        TFSpecStatic as fs => cf_format_static(v, fs.s)
        TFSpecDynamic => error { message = "comptime fold: a dynamic format spec is not folded" }
        _ => cf_format_none(v, hole_ty)
    }
}

fn cf_is_const_literal(e: TExpr): bool {
    match e.kind {
        TNumber as n => !n.is_float
        TBoolLit => true
        TStrLit => true
        TCharLit => true
        TByteLit => true
        _ => false
    }
}

fn cf_none_spec_ok(t: @Type()): bool {
    if is_str_type(t) { return true }
    match t {
        Char => true
        Byte => true
        Prim as p => p.kind == PrimKind::Bool || prim_is_int(p.kind)
        _ => false
    }
}

fn cf_static_spec_ok(spec: str, t: @Type()): bool {
    if !cf_is_int_type(t) { return false }
    if spec.len == (0 to u64) { return false }
    var fc_low = cf_spec_lead_low(spec)
    fc_low == (120 to byte) || fc_low == (98 to byte) || fc_low == (100 to byte) || fc_low == (110 to byte)
}

fn cf_hole_foldable(hole: TExpr, sp: TFSpec): bool {
    if !cf_is_const_literal(hole) { return false }
    match sp.kind {
        TFSpecDynamic => false
        TFSpecStatic as fs => cf_static_spec_ok(fs.s, hole.type)
        _ => cf_none_spec_ok(hole.type)
    }
}

fn cf_spec_at(in: TInterp, i: u64): TFSpec {
    if i < in.specs.len { return in.specs[i] }
    TFSpec { kind = TFSpecNone { } }
}

fn cf_interp_foldable(in: TInterp): bool {
    var i: u64 = 0
    loop {
        if i >= in.holes.len { break }
        if !cf_hole_foldable(in.holes[i], cf_spec_at(in, i)) { return false }
        i++
    }
    true
}

fn cf_hole_bytes(hole: TExpr, sp: TFSpec, table: TypeTable, env: Env, agg: AggConstMap): []byte | error {
    match eval_const(hole, table, env, agg) {
        error as x => return x
        ConstValue as v => comptime_format(v, sp, hole.type)
    }
}

fn cf_interp_bytes(in: TInterp, table: TypeTable, env: Env, agg: AggConstMap): []byte | error {
    var out: []byte = []
    var i: u64 = 0
    loop {
        if i >= in.pieces.len { break }
        out = cf_append_bytes(out, in.pieces[i].bytes())
        if i < in.holes.len {
            var hb = match cf_hole_bytes(in.holes[i], cf_spec_at(in, i), table, env, agg) { error as x => return x; []byte as b => b }
            out = cf_append_bytes(out, hb)
        }
        i++
    }
    out
}

fn cf_interp_expr(in: TInterp, e: TExpr): TExpr {
    TExpr { kind = TInterp { pieces = in.pieces; holes = in.holes; specs = in.specs }; type = e.type; line = e.line; col = e.col }
}

pub fn fold_interp(in: TInterp, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap): TExpr | error {
    if !cf_interp_foldable(in) { return cf_interp_expr(in, e) }
    match cf_interp_bytes(in, table, env, agg) {
        error => cf_interp_expr(in, e)
        []byte as bs => TExpr { kind = TStrLit { text = str_of_bytes(bs) }; type = e.type; line = e.line; col = e.col }
    }
}
