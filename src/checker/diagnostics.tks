use teko::parser

fn diag_at(file: str, line: u32, col: u32, msg: str): str {
    if file != "" && line > 0 { return $"{file}:{line}:{col}: {msg}" }
    if file != "" { return $"{file}: {msg}" }
    if line > 0 { return $"{line}:{col}: {msg}" }
    msg
}

fn located_diag(file: str, decl_line: u32, decl_col: u32, inner: error): str {
    var line = if inner.line != 0 { inner.line } else { decl_line }
    var col = if inner.line != 0 { inner.col } else { decl_col }
    diag_at(file, line, col, inner.message)
}

fn concat_diags(a: []str, b: []str): []str {
    if b.len == 0 { return a }
    if a.len == 0 { return b }
    var out = a
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        out = [..out, b[i]]
        i = i + 1
    }
    out
}

fn one_diag(d: str): []str {
    [d]
}

pub fn join_checker_diags(diags: []str): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= diags.len { break }
        if i > 0 { out = out ~ "\n" }
        out = out ~ diags[i]
        i = i + 1
    }
    out
}

fn diags_error(diags: []str): error {
    error { message = join_checker_diags(diags) }
}

pub type DiagLevel = enum { Error; Warning; Info; Hint }

pub type Diagnostic = struct {
    file: str
    line: u32
    col: u32
    end_line: u32
    end_col: u32
    severity: DiagLevel
    message: str
}

type DiagNum = struct {
    value: u32
    next: u64
    ok: bool
}

fn diag_read_u32(s: str, from: u64): DiagNum {
    var i = from
    var n: u64 = 0
    var any = false
    loop {
        if i >= s.len { break }
        if s[i] < b'0' || s[i] > b'9' { break }
        n = n * 10 + ((s[i] to u64) - (b'0' to u64))
        any = true
        i = i + 1
    }
    DiagNum { value = n to u32; next = i; ok = any }
}

fn has_diag_prefix(s: str, prefix: str): bool {
    if s.len < prefix.len { return false }
    var i: u64 = 0
    loop {
        if i >= prefix.len { break }
        if s[i] != prefix[i] { return false }
        i = i + 1
    }
    true
}

fn matches_diag_file(diag: str, file: str): bool {
    if file == "" { return false }
    if diag.len <= file.len { return false }
    if diag[file.len] != b':' { return false }
    has_diag_prefix(diag, file)
}

fn file_prefix_of(diag: str, files: []str): str {
    var i: u64 = 0
    loop {
        if i >= files.len { break }
        if matches_diag_file(diag, files[i]) { return files[i] }
        i = i + 1
    }
    ""
}

fn strip_leading_diag_space(s: str): str {
    if s.len > 0 && s[0] == b' ' { return s.slice_from(1) }
    s
}

fn to_diagnostic(diag: str, files: []str, severity: DiagLevel): Diagnostic {
    var file = file_prefix_of(diag, files)
    if file == "" {
        return Diagnostic { file = ""; line = 0; col = 0; end_line = 0; end_col = 0; severity = severity; message = diag }
    }
    var rest = diag.slice_from(file.len + 1)
    var p1 = diag_read_u32(rest, 0)
    if !p1.ok || p1.next >= rest.len || rest[p1.next] != b':' {
        return Diagnostic { file = file; line = 0; col = 0; end_line = 0; end_col = 0; severity = severity; message = strip_leading_diag_space(rest) }
    }
    var p2 = diag_read_u32(rest, p1.next + 1)
    if !p2.ok || p2.next >= rest.len || rest[p2.next] != b':' {
        return Diagnostic { file = file; line = 0; col = 0; end_line = 0; end_col = 0; severity = severity; message = strip_leading_diag_space(rest) }
    }
    var j = p2.next + 1
    if j < rest.len && rest[j] == b' ' { j = j + 1 }
    var msg = rest.slice_from(j)
    var line = p1.value
    var col = p2.value
    Diagnostic { file = file; line = line; col = col; end_line = line; end_col = col + 1; severity = severity; message = msg }
}

fn structure_diags(diags: []str, files: []str, severity: DiagLevel): []Diagnostic {
    var out: []Diagnostic = []
    var i: u64 = 0
    loop {
        if i >= diags.len { break }
        out = [..out, to_diagnostic(diags[i], files, severity)]
        i = i + 1
    }
    out
}

fn concat_structured_diags(a: []Diagnostic, b: []Diagnostic): []Diagnostic {
    if b.len == 0 { return a }
    if a.len == 0 { return b }
    var out = a
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        out = [..out, b[i]]
        i = i + 1
    }
    out
}
