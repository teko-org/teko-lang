
use teko::parser

type Collected = struct { types: TypeTable; env: Env }

fn self_type_expr(): @TypeExpr() {
    parser::NamedType { path = parser::Path { segments = [parser::Segment { name = "self" }] }; args = [] }
}

fn iservice_ctor_sig(): parser::Function {
    parser::Function {
        name = "ctor"; type_params = []; type_constraints = []
        params = []; has_return = true; return_type = self_type_expr()
        body = []; vis = parser::Visibility::Exp; has_doc = false; doc = parser::docspan_none()
        line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""
        os_guard = ""; is_intern = false; is_abstract = false; is_virtual = false; is_override = false
        is_static = true
        is_getter = false; is_setter = false; accessor_prop = ""; ret_types = []
        is_operator = false
   ; is_global = false }
}

fn iservice_decl(): parser::TypeDecl {
    parser::TypeDecl {
        name = "IService"; type_params = []; type_constraints = []
        body = parser::InterfaceBody { extends = []; methods = [iservice_ctor_sig()] }
        vis = parser::Visibility::Exp; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0
   ; is_global = false }
}

fn collect_types(items: []parser::Item): TypeTable {
    var regs: [items.len + 1]TypeReg = []
    regs[0] = TypeReg { name = "IService"; namespace = ""; file = ""; vis = parser::Visibility::Exp; decl = iservice_decl() }
    var count: u64 = 1
    var i = 0
    loop {
        if i >= items.len { break }
        match items[i].content {
            parser::TypeDecl as td => {
                regs[count] = TypeReg { name = td.name; namespace = items[i].namespace; file = items[i].file; vis = td.vis; decl = td }
                count++
            }
            _ => { }
        }
        i++
    }
    tt_freeze(TypeTable { regs = teko::collections::arr_slice(regs, 0, count); by_last = nidx_empty(); comptimes = [] })
}

fn const_type_located(e: error, cd: parser::ConstDecl): error {
    if e.line != 0 { return e }
    teko::error::err_loc(e, cd.line, cd.col)
}

fn collect_const_sig(cd: parser::ConstDecl, table: TypeTable, ref_ns: str): @Type() | error {
    match resolve_type(cd.ty, table, ref_ns) {
        (@Type()) as t => t
        error as e => const_type_located(e, cd)
    }
}

fn func_type(f: parser::Function, table: TypeTable, ref_ns: str): @Type() | error {
    var tbl = type_param_table(f.type_params, f.type_constraints, "", table)
    var params: [f.params.len]@Type() = []
    var param_names: [f.params.len]str = []
    var defaults: [f.params.len]parser::Expr = []
    var ndefaults: u64 = 0
    var n_required: u64 = f.params.len
    var i = 0
    loop {
        if i >= f.params.len { break }
        if !f.params[i].has_type && f.params[i].name == "_" {
            return error { message = "a `_` discard parameter is only allowed when implementing an interface method or overriding a base method — a plain function must name its parameters" }
        }
        var pt = match resolve_type(f.params[i].type_ann, tbl, ref_ns) {
            (@Type()) as t => t
            error as e => return e
        }
        params[i] = pt
        param_names[i] = f.params[i].name
        if f.params[i].has_default {
            if n_required == f.params.len { n_required = i to u64 }
            defaults[ndefaults] = f.params[i].default_expr
            ndefaults++
        }
        i++
    }
    var ret = if f.has_return {
        match resolve_type(f.return_type, tbl, ref_ns) { (@Type()) as t => t; error as e => return e }
    } else {
        Void { }
    }
    var is_variadic = f.params.len > 0 && f.params[f.params.len - 1].is_params
    Func { params = params; ret = ret; variadic = is_variadic; param_names = param_names; n_required = n_required; defaults = teko::collections::arr_slice(defaults, 0, ndefaults); ret_extra = [] }
}

pub fn receiver_canonical_name(struct_name: str, ref_ns: str, table: TypeTable): str {
    if name_qualifier(struct_name) != "" { return struct_name }
    var qualified = qualify(ref_ns, struct_name)
    match type_table_find(table, qualified, "") {
        parser::TypeDecl => qualified
        error => struct_name
    }
}

fn return_type_is_self(te: @TypeExpr()): bool {
    match te {
        parser::NamedType as nt => nt.args.len == 0 && nt.path.segments.len == 1 && nt.path.segments[0].name == "self"
        _ => false
    }
}

fn method_func_type(f: parser::Function, struct_name: str, table: TypeTable, ref_ns: str): @Type() | error {
    var tbl = method_type_param_table(receiver_canonical_name(struct_name, ref_ns, table), f.type_params, f.type_constraints, "", table)
    var params: [f.params.len]@Type() = []
    var param_names: [f.params.len]str = []
    var defaults: [f.params.len]parser::Expr = []
    var ndefaults: u64 = 0
    var n_required: u64 = f.params.len
    var disc_gov: parser::Function | null = if params_have_discard(f.params) { discard_governing_sig(f, struct_name, ref_ns, table) } else { null }
    var i = 0
    loop {
        if i >= f.params.len { break }
        var pt = if !f.params[i].has_type && f.params[i].name == "_" {
            match discard_param_type(disc_gov, i to u64, tbl, ref_ns) { (@Type()) as t => t; error as e => return e }
        } else if !f.params[i].has_type {
            Named { name = receiver_canonical_name(struct_name, ref_ns, table) }
        } else if return_type_is_self(f.params[i].type_ann) {
            Named { name = receiver_canonical_name(struct_name, ref_ns, table) }
        } else {
            match resolve_type(f.params[i].type_ann, tbl, ref_ns) { (@Type()) as t => t; error as e => return e }
        }
        params[i] = pt
        param_names[i] = f.params[i].name
        if f.params[i].has_default {
            if n_required == f.params.len { n_required = i to u64 }
            defaults[ndefaults] = f.params[i].default_expr
            ndefaults++
        }
        i++
    }
    var ret = if f.has_return {
        if return_type_is_self(f.return_type) {
            Named { name = receiver_canonical_name(struct_name, ref_ns, table) }
        } else {
            match resolve_type(f.return_type, tbl, ref_ns) { (@Type()) as t => t; error as e => return e }
        }
    } else {
        Void { }
    }
    var is_variadic = f.params.len > 0 && f.params[f.params.len - 1].is_params
    Func { params = params; ret = ret; variadic = is_variadic; param_names = param_names; n_required = n_required; defaults = teko::collections::arr_slice(defaults, 0, ndefaults); ret_extra = [] }
}

type SigOutcome = struct {
    env: Env
    diags: []str
}

type ItemSig = struct {
    binds: []ValBinding
    diags: []str
}

fn collect_signatures(items: []parser::Item, table: TypeTable, env0: Env): SigOutcome {
    var per_item: [items.len]ItemSig = []
    var total: u64 = 0
    var i = 0
    loop {
        if i >= items.len { break }
        var s = item_signature(items[i], table)
        per_item[i] = s
        total = total + s.binds.len
        i++
    }
    var binds: [env0.bindings.len + total]ValBinding = []
    var count: u64 = 0
    loop {
        if count >= env0.bindings.len { break }
        binds[count] = env0.bindings[count]
        count++
    }
    var diags: []str = []
    var j: u64 = 0
    loop {
        if j >= items.len { break }
        var s = per_item[j]
        var k: u64 = 0
        loop {
            if k >= s.binds.len { break }
            binds[count] = s.binds[k]
            count++
            k++
        }
        diags = concat_diags(diags, s.diags)
        j++
    }
    SigOutcome { env = env_with_bindings(env0, binds); diags = diags }
}

fn item_signature(item: parser::Item, table: TypeTable): ItemSig {
    match item.content {
        parser::Function as f => fn_item_sig(item, f, table)
        parser::ConstDecl as cd => const_item_sig(item, cd, table)
        parser::TypeDecl as td => type_member_sig(item, td, table)
        _ => ItemSig { binds = []; diags = [] }
    }
}

fn fn_item_sig(item: parser::Item, f: parser::Function, table: TypeTable): ItemSig {
    match func_type(f, table, item.namespace) {
        (@Type()) as t => ItemSig { binds = [fn_binding(f.name, t, item.namespace, f.is_global)]; diags = [] }
        error as e => ItemSig { binds = []; diags = one_diag(located_diag(item.file, f.line, f.col, e)) }
    }
}

fn const_item_sig(item: parser::Item, cd: parser::ConstDecl, table: TypeTable): ItemSig {
    match collect_const_sig(cd, table, item.namespace) {
        (@Type()) as t => ItemSig { binds = [const_binding(cd.name, t, item.namespace, cd.vis, cd.is_global)]; diags = [] }
        error as e => ItemSig { binds = []; diags = one_diag(located_diag(item.file, cd.line, cd.col, e)) }
    }
}

fn type_member_sig(item: parser::Item, td: parser::TypeDecl, table: TypeTable): ItemSig {
    var method_ns = if item.namespace == "" { td.name } else { item.namespace ~ "::" ~ td.name }
    match td.body {
        parser::StructBody as sb => method_bindings(item, td, sb.methods, method_ns, table)
        parser::ClassBody as cb => {
            var eff = match effective_class_methods(cb, table) {
                []parser::Function as m => m
                error as e => return ItemSig { binds = []; diags = one_diag(located_diag(item.file, td.line, td.col, e)) }
            }
            method_bindings(item, td, eff, method_ns, table)
        }
        parser::NewtypeBody as nb => method_bindings(item, td, nb.methods, method_ns, table)
        parser::EnumBody as eb => method_bindings(item, td, eb.methods, method_ns, table)
        parser::FlagsBody as fb => method_bindings(item, td, fb.methods, method_ns, table)
        _ => ItemSig { binds = []; diags = [] }
    }
}

fn method_bindings(item: parser::Item, td: parser::TypeDecl, methods: []parser::Function, method_ns: str, table: TypeTable): ItemSig {
    var binds: [methods.len]ValBinding = []
    var count: u64 = 0
    var diags: []str = []
    var i = 0
    loop {
        if i >= methods.len { break }
        if methods[i].is_global {
            diags = [..diags, located_diag(item.file, methods[i].line, methods[i].col, error { message = "`global` is not allowed on a type member — only on a namespace-level fn, type, or const" })]
            i++
            continue
        }
        match method_func_type(methods[i], td.name, table, item.namespace) {
            (@Type()) as t => { binds[count] = fn_binding(methods[i].name, t, method_ns, false); count++ }
            error as e => { diags = [..diags, located_diag(item.file, methods[i].line, methods[i].col, e)] }
        }
        i++
    }
    ItemSig { binds = teko::collections::arr_slice(binds, 0, count); diags = diags }
}

pub fn register_instance_methods(env: Env, table: TypeTable): SigOutcome {
    var out = env
    var diags: []str = []
    var insts = table_generic_instance_regs(table)
    var i: u64 = 0
    loop {
        if i >= tt_len(insts) { break }
        var step = register_one_instance_methods(tt_at(insts, i), table, out)
        out = step.env
        diags = concat_diags(diags, step.diags)
        i++
    }
    SigOutcome { env = out; diags = diags }
}

fn register_one_instance_methods(inst: TypeReg, table: TypeTable, env: Env): SigOutcome {
    var out = env
    var diags: []str = []
    var methods = instance_methods_of(inst.decl)
    var mi = 0
    loop {
        if mi >= methods.len { break }
        match method_func_type(methods[mi], inst.name, table, "") {
            (@Type()) as t => { out = define_fn(out, methods[mi].name, t, inst.name, false) }
            error as e => { diags = [..diags, located_diag(inst.file, methods[mi].line, methods[mi].col, e)] }
        }
        mi++
    }
    SigOutcome { env = out; diags = diags }
}

fn instance_methods_of(decl: parser::TypeDecl): []parser::Function {
    match decl.body {
        parser::StructBody as sb => sb.methods
        parser::ClassBody as cb => cb.methods
        _ => []
    }
}

fn count_type_decls(prog: TProgram): u64 {
    var n: u64 = 0
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] { parser::TypeDecl => n = n + 1; _ => { } }
        i++
    }
    n
}

pub fn type_table_of(prog: TProgram): TypeTable {
    var total = count_type_decls(prog) + 1
    var regs: [total]TypeReg = []
    regs[0] = TypeReg { name = "IService"; namespace = ""; file = ""; vis = parser::Visibility::Exp; decl = iservice_decl() }
    var k: u64 = 1
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as td => {
                regs[k] = TypeReg { name = td.name; namespace = ""; file = ""; vis = td.vis; decl = td }
                k = k + 1
            }
            _ => { }
        }
        i++
    }
    tt_freeze(TypeTable { regs = regs; by_last = nidx_empty(); comptimes = [] })
}

fn canon_ref_name(name: str, table: TypeTable, ref_ns: str): str {
    match resolve_name_ref(name, table, ref_ns) {
        parser::TypeDecl as td => qualify(resolved_name_ns(name, table, ref_ns), name_last_segment(td.name))
        error => name
    }
}
fn canon_ref_list(names: []str, table: TypeTable, ref_ns: str): []str {
    var n = names.len
    var out: [n]str = []
    var i: u64 = 0
    loop { if i >= names.len { break }; out[i] = canon_ref_name(names[i], table, ref_ns); i++ }
    out
}
const MRET_PREFIX: str = "__mret"

fn mret_path_sym(p: parser::Path): str {
    var s = ""
    var i: u64 = 0
    loop {
        if i >= p.segments.len { break }
        if i > 0 { s = s ~ "_" }
        s = s ~ p.segments[i].name
        i = i + 1
    }
    s
}

fn mret_type_sym(te: @TypeExpr()): str {
    match te {
        parser::NamedType as nt => {
            if nt.args.len == 0 { return mret_path_sym(nt.path) }
            var s = mret_path_sym(nt.path) ~ "_of"
            var i: u64 = 0
            loop {
                if i >= nt.args.len { break }
                s = s ~ "_" ~ mret_type_sym(nt.args[i])
                i = i + 1
            }
            s
        }
        parser::SliceType as st => "sl_" ~ mret_type_sym(st.element)
        parser::SizedArrayType as sa => "sl_" ~ mret_type_sym(sa.element)
        parser::UnionType as ut => {
            var s = "un"
            var i: u64 = 0
            loop {
                if i >= ut.members.len { break }
                s = s ~ "_" ~ mret_type_sym(ut.members[i])
                i = i + 1
            }
            s
        }
        parser::FunctionType as ft => {
            var s = "fnq"
            var i: u64 = 0
            loop {
                if i >= ft.params.len { break }
                s = s ~ "_" ~ mret_type_sym(ft.params[i])
                i = i + 1
            }
            s ~ "_r_" ~ mret_type_sym(ft.ret)
        }
        parser::MacroType => ""
    }
}

fn mret_mangle(types: []@TypeExpr()): str {
    var s = MRET_PREFIX
    var i: u64 = 0
    loop {
        if i >= types.len { break }
        s = s ~ "_" ~ mret_type_sym(types[i])
        i = i + 1
    }
    s
}

fn mret_field_name(slot: u64): str {
    "_" ~ teko::u64_to_str(slot)
}

fn mret_struct_item(ns: str, file: str, mangle: str, types: []@TypeExpr()): parser::Item {
    var fields: [types.len]parser::Field = []
    var i: u64 = 0
    loop {
        if i >= types.len { break }
        fields[i] = parser::Field { name = mret_field_name(i); type_ann = types[i]; vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = parser::docspan_none(); is_readonly = false }
        i = i + 1
    }
    var body = parser::StructBody { fields = fields; methods = []; implements = []; consts = []; is_readonly = false }
    var decl = parser::TypeDecl { name = mangle; type_params = []; type_constraints = []; body = body; vis = parser::Visibility::Pub; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; is_global = false }
    parser::Item { content = decl; namespace = ns; file = file; guard = parser::pred_true() }
}

fn mret_named_type(mangle: str): @TypeExpr() {
    parser::NamedType { path = parser::Path { segments = [parser::Segment { name = mangle }] }; args = [] }
}

fn mret_return_struct_lit(mangle: str, values: []parser::Expr, line: u32, col: u32): @Statement() {
    var names: [values.len]str = []
    var i: u64 = 0
    loop {
        if i >= values.len { break }
        names[i] = mret_field_name(i)
        i = i + 1
    }
    var lit = parser::StructLit { type_path = parser::Path { segments = [parser::Segment { name = mangle }] }; type_args = []; field_names = names; field_vals = values }
    parser::Return { has_value = true; value = parser::Expr { kind = lit; line = line; col = col }; values = [] }
}

fn mret_rewrite_returns(stmts: []@Statement(), mangle: str): []@Statement() {
    var out: [stmts.len]@Statement() = []
    var i: u64 = 0
    loop {
        if i >= stmts.len { break }
        out[i] = mret_rewrite_stmt(stmts[i], mangle)
        i = i + 1
    }
    out
}

fn mret_rewrite_stmt(s: @Statement(), mangle: str): @Statement() {
    match s {
        parser::Return as r => if r.values.len >= 2 { mret_return_struct_lit(mangle, r.values, 0, 0) } else { s }
        parser::LoopStmt as l => parser::LoopStmt { label = l.label; init = mret_rewrite_returns(l.init, mangle); body = mret_rewrite_returns(l.body, mangle) }
        parser::DeferStmt as d => parser::DeferStmt { body = mret_rewrite_returns(d.body, mangle) }
        parser::AdoptStmt as a => parser::AdoptStmt { name = a.name; body = mret_rewrite_returns(a.body, mangle) }
        parser::BlockStmt as b => parser::BlockStmt { body = mret_rewrite_returns(b.body, mangle) }
        parser::ExprStmt as es => parser::ExprStmt { expr = mret_rewrite_expr_stmt(es.expr, mangle) }
        _ => s
    }
}

fn mret_rewrite_expr_stmt(e: parser::Expr, mangle: str): parser::Expr {
    match e.kind {
        parser::IfExpr as f => parser::Expr { kind = parser::IfExpr { cond = f.cond; then_blk = mret_rewrite_returns(f.then_blk, mangle); has_else = f.has_else; else_blk = mret_rewrite_returns(f.else_blk, mangle) }; line = e.line; col = e.col }
        parser::MatchExpr as m => parser::Expr { kind = parser::MatchExpr { subject = m.subject; arms = mret_rewrite_arms(m.arms, mangle) }; line = e.line; col = e.col }
        _ => e
    }
}

fn mret_rewrite_arms(arms: []parser::Arm, mangle: str): []parser::Arm {
    var out: [arms.len]parser::Arm = []
    var i: u64 = 0
    loop {
        if i >= arms.len { break }
        var a = arms[i]
        out[i] = parser::Arm { pattern = a.pattern; has_when = a.has_when; guard = a.guard; body = mret_rewrite_returns(a.body, mangle) }
        i = i + 1
    }
    out
}

fn mret_rewrite_fn(f: parser::Function, mangle: str): parser::Function {
    parser::Function { name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; has_return = true; return_type = mret_named_type(mangle); body = mret_rewrite_returns(f.body, mangle); vis = f.vis; has_doc = f.has_doc; doc = f.doc; line = f.line; col = f.col; is_test = f.is_test; is_extern = f.is_extern; c_symbol = f.c_symbol; from_lib = f.from_lib; os_guard = f.os_guard; is_intern = f.is_intern; is_abstract = f.is_abstract; is_virtual = f.is_virtual; is_override = f.is_override; is_static = f.is_static; is_getter = f.is_getter; is_setter = f.is_setter; accessor_prop = f.accessor_prop; ret_types = f.ret_types; is_operator = f.is_operator; is_global = f.is_global }
}

pub fn synthesize_mret_structs(program: parser::Program): parser::Program {
    var has_any = false
    var t: u64 = 0
    loop {
        if t >= program.items.len { break }
        match program.items[t].content {
            parser::Function as f => if f.ret_types.len >= 2 { has_any = true }
            _ => { }
        }
        t = t + 1
    }
    if !has_any { return program }
    var out: [program.items.len]parser::Item = []
    var made_keys: [program.items.len]str = []
    var nkeys: u64 = 0
    var new_structs: [program.items.len]parser::Item = []
    var nstructs: u64 = 0
    var i: u64 = 0
    loop {
        if i >= program.items.len { break }
        var it = program.items[i]
        match it.content {
            parser::Function as f => {
                if f.ret_types.len >= 2 {
                    var mangle = mret_mangle(f.ret_types)
                    var key = it.namespace ~ "#" ~ mangle
                    if !mret_key_seen_prefix(made_keys, nkeys, key) {
                        made_keys[nkeys] = key
                        nkeys++
                        new_structs[nstructs] = mret_struct_item(it.namespace, it.file, mangle, f.ret_types)
                        nstructs++
                    }
                    out[i] = parser::Item { content = mret_rewrite_fn(f, mangle); namespace = it.namespace; file = it.file; guard = it.guard }
                } else {
                    out[i] = it
                }
            }
            _ => { out[i] = it }
        }
        i = i + 1
    }
    parser::Program { items = [..out, ..teko::collections::arr_slice(new_structs, 0, nstructs)] }
}

fn mret_key_seen_prefix(keys: []str, upto: u64, key: str): bool {
    var i: u64 = 0
    loop {
        if i >= upto { break }
        if keys[i] == key { return true }
        i = i + 1
    }
    false
}

pub fn canon_class_bases(program: parser::Program): parser::Program {
    var table = collect_types(program.items)
    var any = false
    var t = 0
    loop {
        if t >= program.items.len { break }
        match program.items[t].content {
            parser::TypeDecl as td => match td.body {
                parser::ClassBody as cb => { if cb.has_base || cb.implements.len > 0 { any = true } }
                parser::StructBody as sb => { if sb.implements.len > 0 { any = true } }
                parser::InterfaceBody as b => { if b.extends.len > 0 { any = true } }
                _ => { }
            }
            _ => { }
        }
        t++
    }
    if !any { return program }
    var items: [program.items.len]parser::Item = []
    var i = 0
    loop {
        if i >= program.items.len { break }
        var it = program.items[i]
        var content = it.content
        match it.content {
            parser::TypeDecl as td => {
                match td.body {
                    parser::ClassBody as cb => {
                        if cb.has_base || cb.implements.len > 0 {
                            var cbase = if cb.has_base { canon_ref_name(cb.base_name, table, it.namespace) } else { cb.base_name }
                            content = parser::TypeDecl { name = td.name; type_params = td.type_params; type_constraints = td.type_constraints; body = parser::ClassBody { kind = cb.kind; has_base = cb.has_base; base_name = cbase; has_base_binding = cb.has_base_binding; base_binding_name = cb.base_binding_name; implements = canon_ref_list(cb.implements, table, it.namespace); fields = cb.fields; methods = cb.methods; consts = cb.consts; is_service = cb.is_service; service_lifetime = cb.service_lifetime }; vis = td.vis; has_doc = td.has_doc; doc = td.doc; line = td.line; col = td.col; is_global = td.is_global }
                        }
                    }
                    parser::StructBody as sb => {
                        if sb.implements.len > 0 {
                            content = parser::TypeDecl { name = td.name; type_params = td.type_params; type_constraints = td.type_constraints; body = parser::StructBody { fields = sb.fields; methods = sb.methods; implements = canon_ref_list(sb.implements, table, it.namespace); consts = sb.consts; is_readonly = sb.is_readonly }; vis = td.vis; has_doc = td.has_doc; doc = td.doc; line = td.line; col = td.col; is_global = td.is_global }
                        }
                    }
                    parser::InterfaceBody as ifb => {
                        if ifb.extends.len > 0 {
                            content = parser::TypeDecl { name = td.name; type_params = td.type_params; type_constraints = td.type_constraints; body = parser::InterfaceBody { extends = canon_ref_list(ifb.extends, table, it.namespace); methods = ifb.methods }; vis = td.vis; has_doc = td.has_doc; doc = td.doc; line = td.line; col = td.col; is_global = td.is_global }
                        }
                    }
                    _ => { }
                }
            }
            _ => { }
        }
        items[i] = parser::Item { content = content; namespace = it.namespace; file = it.file; guard = it.guard }
        i++
    }
    parser::Program { items = items }
}

pub fn find_class_body(name: str, table: TypeTable): parser::ClassBody | error {
    var decl = match type_decl_or_template(table, name) {
        parser::TypeDecl as td => td
        error => return error { message = $"unknown base class: {name}" }
    }
    match decl.body {
        parser::ClassBody as cb => cb
        _ => return error { message = $"{name} is not a class" }
    }
}

fn class_inheritance_acyclic(name: str, table: TypeTable): error | null {
    var seen: []str = [name]
    var cur = name
    loop {
        var cb = match find_class_body(cur, table) { parser::ClassBody as c => c; error => return null }
        if !cb.has_base { break }
        var b = cb.base_name
        var i = 0
        loop {
            if i >= seen.len { break }
            if seen[i] == b { return error { message = $"cyclic class inheritance: '{b}' inherits from itself (directly or transitively)" } }
            i++
        }
        seen = [..seen, b]
        cur = b
    }
    null
}

pub fn effective_class_fields(cb: parser::ClassBody, table: TypeTable): []parser::Field | error {
    var inherited: []parser::Field = []
    if cb.has_base {
        var base_cb = match find_class_body(cb.base_name, table) { parser::ClassBody as b => b; error as e => return e }
        inherited = match effective_class_fields(base_cb, table) { []parser::Field as f => f; error as e => return e }
    }
    [..inherited, ..cb.fields]
}

pub fn effective_class_methods(cb: parser::ClassBody, table: TypeTable): []parser::Function | error {
    var inherited: []parser::Function = []
    if cb.has_base {
        var base_cb = match find_class_body(cb.base_name, table) { parser::ClassBody as b => b; error as e => return e }
        inherited = match effective_class_methods(base_cb, table) { []parser::Function as f => f; error as e => return e }
    }
    var out: [inherited.len + cb.methods.len]parser::Function = []
    var count: u64 = 0
    var i = 0
    loop {
        if i >= inherited.len { break }
        var m = inherited[i]
        var j = 0
        loop {
            if j >= cb.methods.len { break }
            if cb.methods[j].name == m.name { m = cb.methods[j] }
            j++
        }
        out[count] = m
        count++
        i++
    }
    var k = 0
    loop {
        if k >= cb.methods.len { break }
        var is_new = true
        var bi = 0
        loop { if bi >= inherited.len { break }; if inherited[bi].name == cb.methods[k].name { is_new = false; break }; bi++ }
        if is_new { out[count] = cb.methods[k]; count++ }
        k++
    }
    teko::collections::arr_slice(out, 0, count)
}

pub fn effective_class_consts(cb: parser::ClassBody, table: TypeTable): []parser::ConstDecl | error {
    if !cb.has_base { return cb.consts }
    var base_cb = match find_class_body(cb.base_name, table) { parser::ClassBody as b => b; error as e => return e }
    var base_consts = match effective_class_consts(base_cb, table) { []parser::ConstDecl as c => c; error as e => return e }
    var out: [cb.consts.len + base_consts.len]parser::ConstDecl = []
    var count: u64 = 0
    loop {
        if count >= cb.consts.len { break }
        out[count] = cb.consts[count]
        count++
    }
    var i: u64 = 0
    loop {
        if i >= base_consts.len { break }
        if !consts_prefix_has_name(out, count, base_consts[i].name) { out[count] = base_consts[i]; count++ }
        i++
    }
    teko::collections::arr_slice(out, 0, count)
}

pub fn body_consts(body: @TypeBody()): []parser::ConstDecl {
    match body {
        parser::StructBody as sb => sb.consts
        parser::ClassBody as cb => cb.consts
        parser::TraitBody as tb => tb.consts
        parser::EnumBody as eb => eb.consts
        parser::FlagsBody as fb => fb.consts
        parser::NewtypeBody as nb => nb.consts
        _ => []
    }
}

pub fn is_subclass_of(class_name: str, ancestor_name: str, table: TypeTable): bool {
    if class_name == ancestor_name { return true }
    match find_class_body(class_name, table) {
        parser::ClassBody as cb => if cb.has_base { is_subclass_of(cb.base_name, ancestor_name, table) } else { false }
        error => false
    }
}

pub type MemberOwner = struct { declaring_class: str; vis: parser::Visibility; is_intern: bool }

pub fn find_field_owner(class_name: str, table: TypeTable, field_name: str): MemberOwner | error {
    var cb = match find_class_body(class_name, table) { parser::ClassBody as b => b; error as e => return e }
    var i = 0
    loop {
        if i >= cb.fields.len { break }
        if cb.fields[i].name == field_name { return MemberOwner { declaring_class = class_name; vis = cb.fields[i].vis; is_intern = cb.fields[i].is_intern } }
        i++
    }
    if cb.has_base { return find_field_owner(cb.base_name, table, field_name) }
    error { message = $"internal: field '{field_name}' not found in {class_name}'s class chain" }
}

pub fn find_method_owner(class_name: str, table: TypeTable, method_name: str): MemberOwner | error {
    var cb = match find_class_body(class_name, table) { parser::ClassBody as b => b; error as e => return e }
    var i = 0
    loop {
        if i >= cb.methods.len { break }
        if cb.methods[i].name == method_name { return MemberOwner { declaring_class = class_name; vis = cb.methods[i].vis; is_intern = cb.methods[i].is_intern } }
        i++
    }
    if cb.has_base { return find_method_owner(cb.base_name, table, method_name) }
    error { message = $"internal: method '{method_name}' not found in {class_name}'s class chain" }
}

pub fn member_accessible(owner: MemberOwner, accessor_type: str, table: TypeTable): bool {
    match owner.vis {
        parser::Visibility::Pub => true
        parser::Visibility::Exp => true
        parser::Visibility::Private => {
            if accessor_type == "" { return false }
            if name_last_segment(accessor_type) == name_last_segment(owner.declaring_class) { return true }
            if owner.is_intern { return is_subclass_of(accessor_type, owner.declaring_class, table) }
            false
        }
    }
}

pub fn class_name_from_method_ns(ns: str): str {
    var last_sep: i64 = -1
    var i: u64 = 0
    loop {
        if i + 1 >= ns.len { break }
        if ns[i] == b':' && ns[i + 1] == b':' { last_sep = i to i64 }
        i++
    }
    if last_sep < 0 { return ns }
    ns.slice_from((last_sep to u64) + 2)
}

fn default_restated_param(contract_params: []parser::Param, impl_params: []parser::Param): str {
    var k: u64 = 0
    var n = if contract_params.len < impl_params.len { contract_params.len } else { impl_params.len }
    loop {
        if k >= n { break }
        if contract_params[k].has_default && impl_params[k].has_default { return impl_params[k].name }
        k++
    }
    ""
}

fn validate_class_decl(cb: parser::ClassBody, table: TypeTable): error | null {
    if cb.has_base {
        var base_decl = match type_table_find(table, cb.base_name, "") {
            parser::TypeDecl as td => td
            error => return error { message = $"unknown base class: {cb.base_name}" }
        }
        var base_cb = match base_decl.body {
            parser::ClassBody as b => b
            _ => return error { message = $"{cb.base_name} is not a class" }
        }
        match base_cb.kind {
            parser::ClassKind::Sealed => return error { message = $"cannot inherit from `{cb.base_name}` — it is sealed (only `abstract`/`virtual` classes can be a base)" }
            _ => { }
        }
    }
    var base_methods = if cb.has_base {
        match find_class_body(cb.base_name, table) {
            parser::ClassBody as b => match effective_class_methods(b, table) { []parser::Function as f => f; error as e => return e }
            error as e => return e
        }
    } else {
        []
    }
    var i = 0
    loop {
        if i >= cb.methods.len { break }
        var m = cb.methods[i]
        if m.is_override {
            var found: parser::Function | null = null
            var j = 0
            loop {
                if j >= base_methods.len { break }
                if base_methods[j].name == m.name { found = base_methods[j]; break }
                j++
            }
            match found {
                null => return error { message = $"'{m.name}' has no matching base method to override" }
                parser::Function as bm => {
                    var overridable = bm.is_abstract || bm.is_virtual || bm.is_override
                    if !overridable { return error { message = $"'{m.name}' overrides a base method that is not `abstract`/`virtual`" } }
                    if bm.params.len != m.params.len { return error { message = $"'{m.name}' override must have the same parameter count as the base method" } }
                    var restated = default_restated_param(bm.params, m.params)
                    if restated != "" { return error { message = $"'{m.name}' override must not restate the default for '{restated}' — the base method '{cb.base_name}::{m.name}' owns its default" } }
                }
            }
        }
        i++
    }
    null
}

fn interface_extends_iservice(name: str, table: TypeTable): bool {
    if name_last_segment(name) == "IService" { return true }
    var decl = match type_table_find(table, name, "") { parser::TypeDecl as td => td; error => return false }
    var ib = match decl.body { parser::InterfaceBody as b => b; _ => return false }
    var i: u64 = 0
    loop {
        if i >= ib.extends.len { break }
        if interface_extends_iservice(ib.extends[i], table) { return true }
        i++
    }
    false
}

pub fn type_satisfies_iservice(name: str, table: TypeTable): bool {
    match type_table_find(table, name, "") {
        parser::TypeDecl as td => {
            match td.body {
                parser::ClassBody as cb => cb.is_service
                parser::InterfaceBody => interface_extends_iservice(name, table)
                _ => false
            }
        }
        error => false
    }
}

type IfaceHit = struct { decl: parser::TypeDecl; ns: str }
fn find_interface_decl(name: str, table: TypeTable, ref_ns: str): IfaceHit | error {
    match resolve_name_ref(name, table, ref_ns) {
        parser::TypeDecl as td => {
            match td.body {
                parser::InterfaceBody => return IfaceHit { decl = td; ns = resolved_name_ns(name, table, ref_ns) }
                _ => return error { message = $"{name} is not an interface" }
            }
        }
        error => { }
    }
    var qprobe = if name_qualifier(name) != "" { name } else { qualify(ref_ns, name) }
    var decl = match type_table_find(table, qprobe, "") { parser::TypeDecl as td => td; error => return error { message = $"unknown interface: {name}" } }
    match decl.body {
        parser::InterfaceBody => IfaceHit { decl = decl; ns = name_qualifier(decl.name) }
        _ => return error { message = $"{name} is not an interface" }
    }
}

pub fn effective_interface_methods(ib: parser::InterfaceBody, iface_ns: str, table: TypeTable, seen: []str): []parser::Function | error {
    var out: []parser::Function = []
    var ei = 0
    loop {
        if ei >= ib.extends.len { break }
        var ename = ib.extends[ei]
        var hit = match find_interface_decl(ename, table, iface_ns) { IfaceHit as h => h; error as e => return e }
        var key = qualify(hit.ns, name_last_segment(hit.decl.name))
        var si = 0
        loop {
            if si >= seen.len { break }
            if seen[si] == key { return error { message = $"cyclic interface `extends`: '{ename}' extends itself (directly or transitively)" } }
            si++
        }
        var base_ib = match hit.decl.body { parser::InterfaceBody as b => b; _ => return error { message = $"{ename} is not an interface" } }
        var bm = match effective_interface_methods(base_ib, hit.ns, table, [..seen, key]) { []parser::Function as f => f; error as e => return e }
        var bi = 0
        loop { if bi >= bm.len { break }; out = merge_iface_method(out, bm[bi]); bi++ }
        ei++
    }
    var mi = 0
    loop { if mi >= ib.methods.len { break }; out = merge_iface_method(out, ib.methods[mi]); mi++ }
    out
}

fn merge_iface_method(out: []parser::Function, m: parser::Function): []parser::Function {
    var i: u64 = 0
    loop {
        if i >= out.len { break }
        if out[i].name == m.name && functions_ast_equal(out[i], m) { return out }
        i++
    }
    [..out, m]
}

pub fn iface_methods_by_name(iface: str, table: TypeTable): []parser::Function | error {
    var decl = match type_table_find(table, iface, "") { parser::TypeDecl as td => td; error => return error { message = $"unknown interface: {iface}" } }
    var ib = match decl.body {
        parser::InterfaceBody as b => b
        parser::TraitBody => return error { message = $"trait '{iface}' is not an interface — a trait is not a dispatch contract" }
        _ => return error { message = $"{iface} is not an interface" }
    }
    var ns = type_ns_of(table, iface)
    if ns == "" { ns = name_qualifier(decl.name) }
    effective_interface_methods(ib, ns, table, [qualify(ns, name_last_segment(decl.name))])
}

pub fn base_vtable_methods(base_class: str, table: TypeTable): []parser::Function | error {
    var cb = match find_class_body(base_class, table) { parser::ClassBody as b => b; error as e => return e }
    effective_class_methods(cb, table)
}

pub fn base_vtable_slot(base_class: str, method: str, table: TypeTable): u32 | error {
    var ms = match base_vtable_methods(base_class, table) { []parser::Function as f => f; error as e => return e }
    var i: u64 = 0
    loop {
        if i >= ms.len { break }
        if ms[i].name == method { return i to u32 }
        i++
    }
    error { message = $"'{method}' is not a virtual method of base class '{base_class}'" }
}

fn method_sig_matches(req: parser::Function, impl_m: parser::Function, table: TypeTable, ref_ns: str, self_type: str): bool {
    var rstart: u64 = 0
    if req.params.len > 0 && !req.params[0].has_type { rstart = 1 }
    var istart: u64 = 0
    if impl_m.params.len > 0 && !impl_m.params[0].has_type { istart = 1 }
    if rstart != istart { return false }
    if req.is_static != impl_m.is_static { return false }
    if req.params.len - rstart != impl_m.params.len - istart { return false }
    var k: u64 = 0
    loop {
        if rstart + k >= req.params.len { break }
        var ip = impl_m.params[istart + k]
        if !ip.has_type && ip.name == "_" {
            k++
            continue
        }
        var rt = match sig_return_type(req.params[rstart + k].type_ann, table, ref_ns, self_type) { (@Type()) as t => t; error => return false }
        var it = match sig_return_type(ip.type_ann, table, ref_ns, self_type) { (@Type()) as t => t; error => return false }
        if !type_eq(rt, it) { return false }
        k++
    }
    if req.has_return != impl_m.has_return { return false }
    if req.has_return {
        var rr = match sig_return_type(req.return_type, table, ref_ns, self_type) { (@Type()) as t => t; error => return false }
        var ir = match sig_return_type(impl_m.return_type, table, ref_ns, self_type) { (@Type()) as t => t; error => return false }
        if !type_eq(rr, ir) { return false }
    }
    true
}

fn sig_return_type(te: @TypeExpr(), table: TypeTable, ref_ns: str, self_type: str): @Type() | error {
    if return_type_is_self(te) {
        if self_type == "" { return error { message = "a `self` return has no enclosing type in this context" } }
        return Named { name = receiver_canonical_name(self_type, ref_ns, table) }
    }
    resolve_type(te, table, ref_ns)
}

fn check_conformance(type_name: str, type_ns: str, own_methods: []parser::Function, implements: []str, table: TypeTable, members_all_public: bool): error | null {
    var ii = 0
    loop {
        if ii >= implements.len { break }
        var iname = implements[ii]
        if !is_trait_name(iname, table) {
            match check_one_interface(type_name, type_ns, own_methods, iname, table, members_all_public) { error as e => return e; null => { } }
        }
        ii++
    }
    null
}

fn check_one_interface(type_name: str, type_ns: str, own_methods: []parser::Function, iname: str, table: TypeTable, members_all_public: bool): error | null {
    var ihit = match find_interface_decl(iname, table, type_ns) { IfaceHit as h => h; error as e => return e }
    var ib = match ihit.decl.body { parser::InterfaceBody as b => b; _ => return error { message = $"{iname} is not an interface" } }
    var req_methods = match effective_interface_methods(ib, ihit.ns, table, [qualify(ihit.ns, name_last_segment(ihit.decl.name))]) { []parser::Function as f => f; error as e => return e }
    var ri = 0
    loop {
        if ri >= req_methods.len { break }
        match check_one_requirement(type_name, type_ns, own_methods, iname, req_methods[ri], table, members_all_public) { error as e => return e; null => { } }
        ri++
    }
    null
}

fn requirement_desc(req: parser::Function): str {
    if req.is_getter { return $"getter for property '{req.accessor_prop}'" }
    if req.is_setter { return $"setter for property '{req.accessor_prop}'" }
    $"method '{req.name}'"
}

fn check_one_requirement(type_name: str, type_ns: str, own_methods: []parser::Function, iname: str, req: parser::Function, table: TypeTable, members_all_public: bool): error | null {
    var desc = requirement_desc(req)
    var mi = 0
    loop {
        if mi >= own_methods.len { break }
        if own_methods[mi].name == req.name {
            if !method_sig_matches(req, own_methods[mi], table, type_ns, type_name) {
                return error { message = $"'{type_name}' {desc} does not match interface '{iname}'s signature" }
            }
            var restated = default_restated_param(req.params, own_methods[mi].params)
            if restated != "" { return error { message = $"'{type_name}' {desc} must not restate the default for '{restated}' — interface '{iname}' owns its default" } }
            if !members_all_public {
                match own_methods[mi].vis {
                    parser::Visibility::Pub => { }
                    parser::Visibility::Exp => { }
                    _ => return error { message = $"'{type_name}' {desc} must be `pub` to satisfy interface '{iname}'" }
                }
            }
            return null
        }
        mi++
    }
    error { message = $"'{type_name}' does not implement interface '{iname}' — missing {desc}" }
}

pub type FieldView = struct { name: str; type: @Type() }

fn resolve_field_view(f: parser::Field, table: TypeTable, owner_ns: str): FieldView | error {
    match resolve_type(f.type_ann, table, owner_ns) {
        (@Type()) as t => FieldView { name = f.name; type = t }
        error as e => e
    }
}

fn resolve_field_views(fields: []parser::Field, table: TypeTable, owner_ns: str): []FieldView | error {
    var out: [fields.len]FieldView = []
    var i: u64 = 0
    loop {
        if i >= fields.len { break }
        out[i] = match resolve_field_view(fields[i], table, owner_ns) { FieldView as v => v; error as e => return e }
        i++
    }
    out
}

pub fn deriver_field_view(type_name: str, table: TypeTable): []FieldView | error {
    var decl = match type_table_find(table, type_name, "") {
        parser::TypeDecl as td => td
        error => return error { message = $"unknown deriver: {type_name}" }
    }
    var owner_ns = type_ns_of(table, type_name)
    match decl.body {
        parser::StructBody as sb => resolve_field_views(sb.fields, table, owner_ns)
        parser::ClassBody as cb => {
            var fields = match effective_class_fields(cb, table) { []parser::Field as f => f; error as e => return e }
            resolve_field_views(fields, table, owner_ns)
        }
        _ => error { message = $"'{type_name}' is not a struct or a class — a field view needs a field-shaped type" }
    }
}

pub fn find_trait_body(name: str, table: TypeTable): parser::TraitBody | error {
    var decl = match type_table_find(table, name, "") { parser::TypeDecl as td => td; error => return error { message = $"unknown trait: {name}" } }
    match decl.body {
        parser::TraitBody as tb => tb
        _ => return error { message = $"{name} is not a trait" }
    }
}

type SplitImpls = struct { traits: []str; ifaces: []str }
type FoldedMembers = struct { fields: []parser::Field; methods: []parser::Function; consts: []parser::ConstDecl }

fn split_trait_derives(implements: []str, table: TypeTable, ref_ns: str): SplitImpls {
    var traits: [implements.len]str = []
    var ntraits: u64 = 0
    var ifaces: [implements.len]str = []
    var nifaces: u64 = 0
    var i: u64 = 0
    loop {
        if i >= implements.len { break }
        var is_trait = match resolve_name_ref(implements[i], table, ref_ns) {
            parser::TypeDecl as td => match td.body { parser::TraitBody => true; _ => false }
            error => false
        }
        if is_trait { traits[ntraits] = implements[i]; ntraits++ }
        else { ifaces[nifaces] = implements[i]; nifaces++ }
        i++
    }
    SplitImpls { traits = teko::collections::arr_slice(traits, 0, ntraits); ifaces = teko::collections::arr_slice(ifaces, 0, nifaces) }
}

fn fields_have_name(fields: []parser::Field, name: str): bool {
    var i: u64 = 0
    loop { if i >= fields.len { break }; if fields[i].name == name { return true }; i++ }
    false
}
fn methods_have_name(methods: []parser::Function, name: str): bool {
    var i: u64 = 0
    loop { if i >= methods.len { break }; if methods[i].name == name { return true }; i++ }
    false
}

fn field_index_by_name(fields: []parser::Field, name: str): i64 {
    var i: u64 = 0
    loop { if i >= fields.len { break }; if fields[i].name == name { return i to i64 }; i++ }
    -1
}

fn method_index_by_name(methods: []parser::Function, name: str): i64 {
    var i: u64 = 0
    loop { if i >= methods.len { break }; if methods[i].name == name { return i to i64 }; i++ }
    -1
}

fn const_index_by_name(consts: []parser::ConstDecl, name: str): i64 {
    var i: u64 = 0
    loop { if i >= consts.len { break }; if consts[i].name == name { return i to i64 }; i++ }
    -1
}

fn trait_method_as_member(tm: parser::Function): parser::Function {
    parser::Function { name = tm.name; type_params = tm.type_params; type_constraints = tm.type_constraints; params = tm.params; has_return = tm.has_return; return_type = tm.return_type; body = tm.body; vis = parser::Visibility::Pub; has_doc = tm.has_doc; doc = tm.doc; line = tm.line; col = tm.col; is_test = tm.is_test; is_extern = tm.is_extern; c_symbol = tm.c_symbol; from_lib = tm.from_lib; os_guard = tm.os_guard; is_intern = tm.is_intern; is_abstract = tm.is_abstract; is_virtual = tm.is_virtual; is_override = tm.is_override; is_static = tm.is_static; is_getter = tm.is_getter; is_setter = tm.is_setter; accessor_prop = tm.accessor_prop; ret_types = tm.ret_types; is_operator = tm.is_operator; is_global = tm.is_global }
}

fn consts_have_name(consts: []parser::ConstDecl, name: str): bool {
    consts_prefix_has_name(consts, consts.len, name)
}

fn consts_prefix_has_name(consts: []parser::ConstDecl, upto: u64, name: str): bool {
    var i: u64 = 0
    loop { if i >= upto { break }; if consts[i].name == name { return true }; i++ }
    false
}

fn fold_trait_members(type_name: str, own_fields: []parser::Field, own_methods: []parser::Function, own_consts: []parser::ConstDecl, trait_names: []str, table: TypeTable, into_class: bool): FoldedMembers | error {
    var fields = own_fields
    var methods = own_methods
    var consts = own_consts
    var i: u64 = 0
    loop {
        if i >= trait_names.len { break }
        var tname = trait_names[i]
        if trait_name_seen_before(trait_names, i, tname) { i++; continue }
        var tb = match find_trait_body(tname, table) { parser::TraitBody as t => t; error as e => return e }
        var eff = match flatten_trait_composition(tname, tb, table, []) { FoldedMembers as f => f; error as e => return e }
        var fmf = match fold_trait_fields(type_name, tname, fields, eff.fields, into_class) { []parser::Field as f => f; error as e => return e }
        fields = fmf
        var fmc = match fold_trait_consts(type_name, tname, consts, eff.consts) { []parser::ConstDecl as c => c; error as e => return e }
        consts = fmc
        var fmm = match fold_trait_methods(type_name, tname, own_methods, methods, eff.methods, table) { []parser::Function as m => m; error as e => return e }
        methods = fmm
        i++
    }
    FoldedMembers { fields = fields; methods = methods; consts = consts }
}

fn trait_name_seen_before(trait_names: []str, idx: u64, tname: str): bool {
    var di: u64 = 0
    loop { if di >= idx { break }; if trait_names[di] == tname { return true }; di++ }
    false
}

fn fold_trait_fields(type_name: str, tname: str, fields: []parser::Field, trait_fields: []parser::Field, into_class: bool): []parser::Field | error {
    var out = fields
    var fi: u64 = 0
    loop {
        if fi >= trait_fields.len { break }
        var tf = trait_fields[fi]
        var fvis = if into_class { parser::Visibility::Private } else { parser::Visibility::Pub }
        var member = parser::Field { name = tf.name; type_ann = tf.type_ann; vis = fvis; is_intern = false; has_doc = tf.has_doc; doc = tf.doc; is_readonly = tf.is_readonly }
        var idx = field_index_by_name(out, tf.name)
        if idx < 0 { out = [..out, member]; fi++; continue }
        if !fields_ast_equal(out[idx to u64], member) {
            return error { message = $"trait '{tname}' field '{tf.name}' collides with a different field on '{type_name}' — a field absorbs only when identical; rename it or reconcile its type" }
        }
        fi++
    }
    out
}

fn fold_trait_consts(type_name: str, tname: str, consts: []parser::ConstDecl, trait_consts: []parser::ConstDecl): []parser::ConstDecl | error {
    var out = consts
    var ci: u64 = 0
    loop {
        if ci >= trait_consts.len { break }
        var tc = trait_consts[ci]
        var idx = const_index_by_name(out, tc.name)
        if idx < 0 { out = [..out, tc]; ci++; continue }
        if !consts_ast_equal(out[idx to u64], tc) {
            return error { message = $"trait '{tname}' const '{tc.name}' collides with a different member const on '{type_name}' — a const absorbs only when identical; rename it or reconcile its value" }
        }
        ci++
    }
    out
}

fn fold_trait_methods(type_name: str, tname: str, own_methods: []parser::Function, methods: []parser::Function, trait_methods: []parser::Function, table: TypeTable): []parser::Function | error {
    var out = methods
    var mi: u64 = 0
    loop {
        if mi >= trait_methods.len { break }
        var tm = trait_methods[mi]
        if tm.body.len == 0 { mi++; continue }
        var idx = method_index_by_name(out, tm.name)
        if idx < 0 { out = [..out, trait_method_as_member(tm)]; mi++; continue }
        match reconcile_composed_method(type_name, tname, own_methods, out, tm, table) {
            []parser::Function as m => out = m
            error as e => return e
        }
        mi++
    }
    out
}

fn reconcile_composed_method(type_name: str, tname: str, own_methods: []parser::Function, out: []parser::Function, tm: parser::Function, table: TypeTable): []parser::Function | error {
    var i: u64 = 0
    loop {
        if i >= out.len { break }
        if out[i].name == tm.name {
            match merge_named_members(out[i], tm, table, "", type_name) {
                Absorb => return out
                Conflict => return method_merge_error(type_name, tname, tm.name, own_methods)
                Overload => { }
            }
        }
        i++
    }
    [..out, trait_method_as_member(tm)]
}

fn method_merge_error(type_name: str, tname: str, method_name: str, own_methods: []parser::Function): error {
    if methods_have_name(own_methods, method_name) {
        return error { message = $"'{type_name}' redefines '{method_name}' with a body different from trait '{tname}'s — a trait member absorbs only when identical; make them identical or drop the composition" }
    }
    error { message = $"method '{method_name}' is provided by composed traits with differing bodies — '{type_name}' cannot absorb them; reconcile the traits" }
}

fn program_needs_trait_fold(program: parser::Program, table: TypeTable): bool {
    var t: u64 = 0
    loop {
        if t >= tt_len(table) { break }
        match tt_at(table, t).decl.body { parser::TraitBody => { return true }; _ => { } }
        t++
    }
    false
}

type UserFoldResult = struct {
    items: []parser::Item
    diags: []str
}

type FoldedItem = struct {
    item: parser::Item
    diags: []str
}

fn fold_user_traits(program: parser::Program, table: TypeTable): UserFoldResult {
    var items: [program.items.len]parser::Item = []
    var diags: []str = []
    var i: u64 = 0
    loop {
        if i >= program.items.len { break }
        var folded = fold_one_item(program.items[i], table)
        items[i] = folded.item
        diags = concat_diags(diags, folded.diags)
        i++
    }
    UserFoldResult { items = items; diags = diags }
}

fn unfolded_item(it: parser::Item): FoldedItem {
    FoldedItem { item = it; diags = [] }
}

fn fold_one_item(it: parser::Item, table: TypeTable): FoldedItem {
    var td = match it.content { parser::TypeDecl as t => t; _ => return unfolded_item(it) }
    match td.body {
        parser::StructBody as sb => fold_struct_item(it, td, sb, table)
        parser::ClassBody as cb => fold_class_item(it, td, cb, table)
        _ => unfolded_item(it)
    }
}

fn fold_struct_item(it: parser::Item, td: parser::TypeDecl, sb: parser::StructBody, table: TypeTable): FoldedItem {
    var split = split_trait_derives(sb.implements, table, it.namespace)
    if split.traits.len == 0 { return unfolded_item(it) }
    var fm = match fold_trait_members(td.name, sb.fields, sb.methods, sb.consts, split.traits, table, false) {
        FoldedMembers as f => f
        error as e => return FoldedItem { item = it; diags = one_diag(located_diag(it.file, td.line, td.col, e)) }
    }
    var body = parser::StructBody { fields = fm.fields; methods = fm.methods; implements = sb.implements; consts = fm.consts; is_readonly = sb.is_readonly }
    FoldedItem { item = item_with_body(it, td, body); diags = [] }
}

fn fold_class_item(it: parser::Item, td: parser::TypeDecl, cb: parser::ClassBody, table: TypeTable): FoldedItem {
    var split = split_trait_derives(cb.implements, table, it.namespace)
    if split.traits.len == 0 { return unfolded_item(it) }
    var fm = match fold_trait_members(td.name, cb.fields, cb.methods, cb.consts, split.traits, table, true) {
        FoldedMembers as f => f
        error as e => return FoldedItem { item = it; diags = one_diag(located_diag(it.file, td.line, td.col, e)) }
    }
    var body = parser::ClassBody { kind = cb.kind; has_base = cb.has_base; base_name = cb.base_name; has_base_binding = cb.has_base_binding; base_binding_name = cb.base_binding_name; implements = cb.implements; fields = fm.fields; methods = fm.methods; consts = fm.consts; is_service = cb.is_service; service_lifetime = cb.service_lifetime }
    FoldedItem { item = item_with_body(it, td, body); diags = [] }
}

fn item_with_body(it: parser::Item, td: parser::TypeDecl, body: @TypeBody()): parser::Item {
    var decl = parser::TypeDecl { name = td.name; type_params = td.type_params; type_constraints = td.type_constraints; body = body; vis = td.vis; has_doc = td.has_doc; doc = td.doc; line = td.line; col = td.col; is_global = td.is_global }
    parser::Item { content = decl; namespace = it.namespace; file = it.file; guard = it.guard }
}

pub fn fold_traits(program: parser::Program): parser::Program | error {
    var folded = fold_traits_collected(program)
    if folded.diags.len > 0 { return diags_error(folded.diags) }
    folded.program
}

fn fold_traits_collected(program: parser::Program): FoldOutcome {
    var table = collect_types(program.items)
    if !program_needs_trait_fold(program, table) { return FoldOutcome { program = program; diags = [] } }
    var user = fold_user_traits(program, table)
    if user.diags.len > 0 { return FoldOutcome { program = program; diags = user.diags } }
    FoldOutcome { program = parser::Program { items = user.items }; diags = [] }
}

type FoldOutcome = struct {
    program: parser::Program
    diags: []str
}

fn w0_is_stamped_generic_reg(reg: TypeReg, table: TypeTable): bool {
    if reg.namespace != "" { return false }
    var name = reg.name
    var pos: u64 = name.len
    var i: u64 = 0
    loop {
        if i + 5 > name.len { break }
        if name[i] == b'_' && name[i + 1] == b'_' && name[i + 2] == b'g' && name[i + 3] == b'_' && name[i + 4] == b'_' { pos = i; break }
        i++
    }
    if pos == name.len { return false }
    if pos == 0 { return false }
    var stem = name.slice_to(pos)
    var cands = tt_cands(table, stem)
    var j: u64 = 0
    loop {
        if j >= cands.count { break }
        var r = tt_cand_reg(table, cands, j)
        if r.decl.type_params.len > 0 && r.name == stem { return true }
        j++
    }
    false
}

fn check_no_duplicate_types(table: TypeTable): []str {
    var diags: []str = []
    var i: u64 = 0
    loop {
        if i >= tt_len(table) { break }
        if w0_is_stamped_generic_reg(tt_at(table, i), table) { i++; continue }
        diags = concat_diags(diags, duplicates_of_reg(table, i))
        i++
    }
    diags
}

fn duplicates_of_reg(table: TypeTable, at: u64): []str {
    var diags: []str = []
    var reg = tt_at(table, at)
    var ns_label = if reg.namespace == "" { "<top-level>" } else { reg.namespace }
    var arity = reg.decl.type_params.len
    var j: u64 = at + 1
    loop {
        if j >= tt_len(table) { break }
        var other = tt_at(table, j)
        if !w0_is_stamped_generic_reg(other, table) && other.name == reg.name && other.namespace == reg.namespace && other.decl.type_params.len == arity {
            diags = [..diags, diag_at(other.file, other.decl.line, other.decl.col, $"duplicate type '{reg.name}' (arity {arity}) in namespace '{ns_label}'")]
        }
        j++
    }
    diags
}

fn validate_type_decls(table: TypeTable): []str {
    var diags = concat_diags(check_no_duplicate_types(table), service_conflict_diags(table))
    var i: u64 = 0
    loop {
        if i >= tt_len(table) { break }
        diags = concat_diags(diags, validate_one_type_decl(tt_at(table, i), table))
        i++
    }
    diags
}

fn decl_diag(reg: TypeReg, msg: str): str {
    diag_at(reg.file, reg.decl.line, reg.decl.col, msg)
}

fn decl_error_diag(reg: TypeReg, inner: error): str {
    located_diag(reg.file, reg.decl.line, reg.decl.col, inner)
}

fn validate_one_type_decl(reg: TypeReg, table: TypeTable): []str {
    var decl = reg.decl
    var tbl = type_param_table(decl.type_params, decl.type_constraints, "", table)
    match decl.body {
        parser::StructBody as sb => validate_struct_body(reg, sb, tbl, table)
        parser::AliasBody as ab => validate_field_slot(reg, "alias", ab.alias, tbl, table)
        parser::ClassBody as cb => validate_class_body(reg, cb, tbl, table)
        parser::TraitBody as trb => validate_trait_body(reg, trb, tbl, table)
        parser::InterfaceBody as ib => validate_interface_body(reg, ib, table)
        parser::ExternStructBody as esb => validate_extern_struct_body(reg, esb, table)
        _ => []
    }
}

fn extern_struct_field_ok(t: @Type(), table: TypeTable): bool {
    match t {
        Prim => true
        Byte => true
        Ptr => true
        Uptr => true
        Named as nm => match type_table_find(table, nm.name, "") {
            parser::TypeDecl as td => extern_named_body_ok(td.body)
            error => false
        }
        _ => false
    }
}

fn validate_extern_struct_body(reg: TypeReg, esb: parser::ExternStructBody, table: TypeTable): []str {
    var diags: []str = []
    var f: u64 = 0
    loop {
        if f >= esb.fields.len { break }
        diags = concat_diags(diags, extern_struct_field_diag(reg, esb.fields[f].type_ann, table))
        f++
    }
    diags
}

fn extern_struct_field_diag(reg: TypeReg, ann: @TypeExpr(), table: TypeTable): []str {
    var ft = match resolve_type(ann, table, reg.namespace) {
        (@Type()) as t => t
        error as e => return one_diag(decl_error_diag(reg, e))
    }
    if !extern_struct_field_ok(ft, table) {
        return one_diag(decl_diag(reg, "an extern type struct field must be a numeric prim, byte, ptr, uptr, or another extern struct"))
    }
    []
}

fn validate_field_slot(reg: TypeReg, field_name: str, ann: @TypeExpr(), tbl: TypeTable, table: TypeTable): []str {
    var ft = match resolve_type(ann, tbl, reg.namespace) {
        (@Type()) as t => t
        error as e => return one_diag(decl_error_diag(reg, e))
    }
    match ft {
        Reference => one_diag(decl_diag(reg, "a reference cannot be stored in a struct/variant/collection"))
        _ => []
    }
}

fn validate_body_fields(reg: TypeReg, fields: []parser::Field, tbl: TypeTable, table: TypeTable): []str {
    var diags: []str = []
    var f: u64 = 0
    loop {
        if f >= fields.len { break }
        diags = concat_diags(diags, validate_field_slot(reg, fields[f].name, fields[f].type_ann, tbl, table))
        f++
    }
    diags
}

fn conformance_diags(reg: TypeReg, methods: []parser::Function, implements: []str, table: TypeTable, members_public: bool): []str {
    match check_conformance(reg.decl.name, reg.namespace, methods, implements, table, members_public) {
        error as e => one_diag(decl_error_diag(reg, e))
        null => []
    }
}

fn validate_struct_body(reg: TypeReg, sb: parser::StructBody, tbl: TypeTable, table: TypeTable): []str {
    concat_diags(validate_body_fields(reg, sb.fields, tbl, table), conformance_diags(reg, sb.methods, sb.implements, table, true))
}

fn validate_class_body(reg: TypeReg, cb: parser::ClassBody, tbl: TypeTable, table: TypeTable): []str {
    match class_inheritance_acyclic(reg.decl.name, table) {
        error as e => return one_diag(decl_error_diag(reg, e))
        null => { }
    }
    var diags = validate_body_fields(reg, cb.fields, tbl, table)
    match validate_class_decl(cb, table) {
        error as e => diags = concat_diags(diags, one_diag(decl_error_diag(reg, e)))
        null => { }
    }
    if cb.is_service && !service_has_ctor(cb) {
        diags = concat_diags(diags, one_diag(decl_diag(reg, "a service must conform to IService: declare 'static fn ctor(): self'")))
    }
    var eff = match effective_class_methods(cb, table) {
        []parser::Function as m => m
        error as e => return concat_diags(diags, one_diag(decl_error_diag(reg, e)))
    }
    concat_diags(diags, conformance_diags(reg, eff, cb.implements, table, false))
}

fn service_has_ctor(cb: parser::ClassBody): bool {
    var i: u64 = 0
    loop {
        if i >= cb.methods.len { break }
        var m = cb.methods[i]
        if m.name == "ctor" && m.params.len == 0 { return true }
        i++
    }
    false
}

fn validate_trait_body(reg: TypeReg, trb: parser::TraitBody, tbl: TypeTable, table: TypeTable): []str {
    var decl = reg.decl
    if decl.type_params.len > 0 {
        return one_diag(decl_diag(reg, $"a generic trait ('{decl.name}<…>') is not supported — a trait is a concrete mixin"))
    }
    concat_diags(concat_diags(validate_body_fields(reg, trb.fields, tbl, table), trait_method_modifier_diags(reg, trb.methods)), trait_composition_diags(reg, trb, table))
}

fn trait_method_modifier_diags(reg: TypeReg, methods: []parser::Function): []str {
    var diags: []str = []
    var i: u64 = 0
    loop {
        if i >= methods.len { break }
        var m = methods[i]
        if m.is_abstract || m.is_virtual || m.is_override || m.is_intern {
            diags = [..diags, decl_diag(reg, $"trait method '{m.name}' may not be `abstract`/`virtual`/`override`/`intern` — a trait is a concrete mixin, not a dispatch contract")]
        }
        i++
    }
    diags
}

fn validate_interface_body(reg: TypeReg, ib: parser::InterfaceBody, table: TypeTable): []str {
    var diags = interface_bodyless_diags(reg, ib.methods)
    diags = concat_diags(diags, interface_operator_wellformed_diags(reg, ib.methods, table))
    var seen = [qualify(reg.namespace, name_last_segment(reg.decl.name))]
    var eff = match effective_interface_methods(ib, reg.namespace, table, seen) {
        []parser::Function as m => m
        error as e => return concat_diags(diags, one_diag(decl_error_diag(reg, e)))
    }
    diags = concat_diags(diags, interface_conflict_diags(reg, eff, table))
    concat_diags(diags, interface_operator_counterpart_diags(reg, eff))
}

fn interface_operator_wellformed_diags(reg: TypeReg, methods: []parser::Function, table: TypeTable): []str {
    var diags: []str = []
    var i: u64 = 0
    loop {
        if i >= methods.len { break }
        if methods[i].is_operator {
            match check_one_operator(reg.decl, methods[i], reg.namespace, table) {
                error as e => diags = [..diags, decl_error_diag(reg, e)]
                null => { }
            }
        }
        i++
    }
    diags
}

fn interface_operator_counterpart_diags(reg: TypeReg, eff: []parser::Function): []str {
    var diags: []str = []
    var i: u64 = 0
    loop {
        if i >= eff.len { break }
        if eff[i].is_operator {
            var want = comparator_counterpart(eff[i].name)
            if want != "" && !effective_lists_operator(eff, want) {
                diags = [..diags, decl_diag(reg, $"interface `operator {eff[i].name}` requires its counter-part `operator {want}` in the same contract — the contract must list both signatures")]
            }
        }
        i++
    }
    diags
}

fn effective_lists_operator(eff: []parser::Function, name: str): bool {
    var i: u64 = 0
    loop {
        if i >= eff.len { break }
        if eff[i].is_operator && eff[i].name == name { return true }
        i++
    }
    false
}

fn interface_bodyless_diags(reg: TypeReg, methods: []parser::Function): []str {
    var diags: []str = []
    var i: u64 = 0
    loop {
        if i >= methods.len { break }
        if methods[i].body.len > 0 {
            diags = [..diags, decl_diag(reg, $"interface method '{methods[i].name}' must be a bodyless signature (an interface is a pure contract — no default bodies)")]
        }
        i++
    }
    diags
}

fn interface_conflict_diags(reg: TypeReg, eff: []parser::Function, table: TypeTable): []str {
    var diags: []str = []
    var owner_ns = type_ns_of(table, reg.decl.name)
    var a: u64 = 0
    loop {
        if a >= eff.len { break }
        var b: u64 = a + 1
        loop {
            if b >= eff.len { break }
            if eff[a].name == eff[b].name && !method_sig_matches(eff[a], eff[b], table, owner_ns, reg.decl.name) {
                diags = [..diags, decl_diag(reg, $"interface '{reg.decl.name}' has conflicting signatures for method '{eff[a].name}' (an extended interface declares it differently)")]
            }
            b++
        }
        a++
    }
    diags
}

fn service_conflict_diags_pair(table: TypeTable, i: u64, reg: TypeReg, target: str, key: str): []str {
    var diags: []str = []
    var j: u64 = i + 1
    loop {
        if j >= tt_len(table) { break }
        var other = tt_at(table, j)
        match other.decl.body {
            parser::ClassBody as ocb => {
                if ocb.is_service && name_last_segment(other.name) == key && svc_service_implements(ocb, target) {
                    diags = [..diags, decl_diag(reg, $"duplicate service registration for '{target}' under key '{key}': same-type-same-key collides at compile time (distinct keys coexist)")]
                }
            }
            _ => { }
        }
        j++
    }
    diags
}

fn service_conflict_diags_from(table: TypeTable, i: u64, reg: TypeReg): []str {
    var cb = match reg.decl.body { parser::ClassBody as c => c; _ => return [] }
    if !cb.is_service { return [] }
    var diags: []str = []
    var key = name_last_segment(reg.name)
    var t: u64 = 0
    loop {
        if t >= cb.implements.len { break }
        diags = concat_diags(diags, service_conflict_diags_pair(table, i, reg, name_last_segment(cb.implements[t]), key))
        t++
    }
    diags
}

fn service_conflict_diags(table: TypeTable): []str {
    var diags: []str = []
    var i: u64 = 0
    loop {
        if i >= tt_len(table) { break }
        diags = concat_diags(diags, service_conflict_diags_from(table, i, tt_at(table, i)))
        i++
    }
    diags
}

type CollectOutcome = struct {
    collected: Collected
    decl_diags: []str
    sig_diags: []str
}

fn collect(program: parser::Program): CollectOutcome {
    collect_over(program, instantiate_types(program, collect_types(program.items)), env_empty())
}

fn collect_with_seed(program: parser::Program, seed: Collected): CollectOutcome {
    collect_over(program, instantiate_types(program, table_with_project_types(program, seed.types)), seed.env)
}

fn table_with_project_types(program: parser::Program, seeded: TypeTable): TypeTable {
    var nbase: u64 = seeded.regs.len
    var regs: [nbase + 1 + program.items.len]TypeReg = []
    var s: u64 = 0
    loop {
        if s >= nbase { break }
        regs[s] = seeded.regs[s]
        s++
    }
    regs[nbase] = TypeReg { name = "IService"; namespace = ""; file = ""; vis = parser::Visibility::Exp; decl = iservice_decl() }
    var count: u64 = nbase + 1
    var i = 0
    loop {
        if i >= program.items.len { break }
        match program.items[i].content {
            parser::TypeDecl as td => {
                regs[count] = TypeReg { name = td.name; namespace = program.items[i].namespace; file = program.items[i].file; vis = td.vis; decl = td }
                count++
            }
            _ => { }
        }
        i++
    }
    TypeTable { regs = teko::collections::arr_slice(regs, 0, count); by_last = nidx_empty(); comptimes = seeded.comptimes }
}

fn collect_over(program: parser::Program, table: TypeTable, env0: Env): CollectOutcome {
    var ftable = tt_freeze(table)
    var decl_diags = validate_type_decls(ftable)
    var sig = collect_signatures(program.items, ftable, env0)
    CollectOutcome { collected = Collected { types = ftable; env = sig.env }; decl_diags = decl_diags; sig_diags = sig.diags }
}

fn seed_from_dep(dep: TProgram, table: TypeTable, env: Env): Collected | error {
    var e = env
    var regs: [count_type_decls(dep)]TypeReg = []
    var k: u64 = 0
    var i: u64 = 0
    loop {
        if i >= dep.items.len { break }
        match dep.items[i] {
            parser::TypeDecl as td => {
                var ns = dep_item_ns(dep.items[i])
                regs[k] = TypeReg { name = td.name; namespace = ns; file = ""; vis = td.vis; decl = td }
                k = k + 1
            }
            _ => { }
        }
        i++
    }
    var t = tt_freeze(TypeTable { regs = [..table.regs, ..regs]; by_last = nidx_empty(); comptimes = table.comptimes })
    var j: u64 = 0
    loop {
        if j >= dep.items.len { break }
        match dep.items[j] {
            TFunction as f => {
                var dtbl = type_param_table(f.type_params, f.type_constraints, "", t)
                var params: [f.params.len]@Type() = []
                var param_names: [f.params.len]str = []
                var defaults: [f.params.len]parser::Expr = []
                var ndefaults: u64 = 0
                var n_required: u64 = f.params.len
                var pi: u64 = 0
                loop {
                    if pi >= f.params.len { break }
                    var pt = match resolve_type(f.params[pi].type_ann, dtbl, f.namespace) { (@Type()) as ty => ty; error as err => return err }
                    params[pi] = pt
                    param_names[pi] = f.params[pi].name
                    if f.params[pi].has_default {
                        if n_required == f.params.len { n_required = pi }
                        defaults[ndefaults] = f.params[pi].default_expr
                        ndefaults++
                    }
                    pi++
                }
                var is_variadic = f.params.len > 0 && f.params[f.params.len - 1].is_params
                var ft = Func { params = params; ret = f.return_type; variadic = is_variadic; param_names = param_names; n_required = n_required; defaults = teko::collections::arr_slice(defaults, 0, ndefaults); ret_extra = [] }
                e = define_fn(e, f.name, ft, f.namespace, false)
            }
            _ => { }
        }
        j++
    }
    Collected { types = t; env = seed_dep_consts(e, dep) }
}

fn seed_dep_consts(env: Env, dep: TProgram): Env {
    var e = env
    var k: u64 = 0
    loop {
        if k >= dep.items.len { break }
        match dep.items[k] {
            TConstDecl as c => if dep_const_is_exported(c) { e = define_const(e, c.name, c.ty, c.namespace, c.vis, false) }
            _ => { }
        }
        k++
    }
    e
}

fn dep_const_is_exported(c: TConstDecl): bool {
    match c.vis {
        parser::Visibility::Private => false
        parser::Visibility::Pub => true
        parser::Visibility::Exp => true
    }
}

fn dep_item_ns(item: @TItem()): str {
    match item {
        TFunction as f => f.namespace
        parser::TypeDecl => ""
        parser::UseDecl => ""
        (@TStatement()) as _gb1 => ""
        TConstDecl as c => c.namespace
    }
}
