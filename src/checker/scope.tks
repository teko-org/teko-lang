
use teko::parser

pub type ValBinding = struct {
    name: str
    type: @Type()
    is_mut: bool
    ns: str
    is_const: bool
    vis: parser::Visibility
    is_global: bool
}

pub fn fn_binding(name: str, t: @Type(), ns: str, is_global: bool): ValBinding {
    ValBinding { name = name; type = t; is_mut = false; ns = ns; is_const = false; vis = parser::Visibility::Pub; is_global = is_global }
}

pub fn const_binding(name: str, t: @Type(), ns: str, vis: parser::Visibility, is_global: bool): ValBinding {
    ValBinding { name = name; type = t; is_mut = false; ns = ns; is_const = true; vis = vis; is_global = is_global }
}

pub fn env_with_bindings(env: Env, bindings: []ValBinding): Env {
    Env { base_slots = env.base_slots; bindings = bindings; cur_ns = env.cur_ns; owner_type = env.owner_type; file = env.file; base_index = env.base_index; ret_expected = env.ret_expected; explicit = env.explicit }
}

pub type Env = struct { base_slots: []ValBinding; bindings: []ValBinding; cur_ns: str; owner_type: str; file: str; base_index: NameIndex; ret_expected: @Type(); explicit: bool }

pub fn env_empty(): Env { Env { base_slots = []; bindings = []; cur_ns = ""; owner_type = ""; file = ""; base_index = nidx_empty(); ret_expected = Void { }; explicit = false } }

pub fn with_explicit(env: Env, on: bool): Env { Env { base_slots = env.base_slots; bindings = env.bindings; cur_ns = env.cur_ns; owner_type = env.owner_type; file = env.file; base_index = env.base_index; ret_expected = env.ret_expected; explicit = on } }

pub fn seal(env: Env): Env {
    var b = [..env.base_slots, ..env.bindings];
    Env { base_slots = b; bindings = []; cur_ns = env.cur_ns; owner_type = env.owner_type; file = env.file; base_index = nidx_build(nidx_names_of(b)); ret_expected = env.ret_expected; explicit = env.explicit }
}

pub fn with_ns(env: Env, ns: str): Env { Env { base_slots = env.base_slots; bindings = env.bindings; cur_ns = ns; owner_type = env.owner_type; file = env.file; base_index = env.base_index; ret_expected = env.ret_expected; explicit = env.explicit } }

pub fn with_file(env: Env, file: str): Env { Env { base_slots = env.base_slots; bindings = env.bindings; cur_ns = env.cur_ns; owner_type = env.owner_type; file = file; base_index = env.base_index; ret_expected = env.ret_expected; explicit = env.explicit } }

pub fn with_owner(env: Env, owner: str): Env { Env { base_slots = env.base_slots; bindings = env.bindings; cur_ns = env.cur_ns; owner_type = owner; file = env.file; base_index = env.base_index; ret_expected = env.ret_expected; explicit = env.explicit } }

pub fn with_ret_expected(env: Env, t: @Type()): Env { Env { base_slots = env.base_slots; bindings = env.bindings; cur_ns = env.cur_ns; owner_type = env.owner_type; file = env.file; base_index = env.base_index; ret_expected = t; explicit = env.explicit } }

fn binding_is_writable(t: @Type(), is_mut: bool): bool {
    if is_mut { return true }
    match t { Reference => true; _ => false }
}

pub fn define(env: Env, name: str, t: @Type(), is_mut: bool): Env {
    Env { base_slots = env.base_slots; bindings = [..env.bindings, ValBinding { name = name; type = t; is_mut = binding_is_writable(t, is_mut); ns = ""; is_const = false; vis = parser::Visibility::Pub; is_global = false }]; cur_ns = env.cur_ns; owner_type = env.owner_type; file = env.file; base_index = env.base_index; ret_expected = env.ret_expected; explicit = env.explicit }
}

pub fn define_fn(env: Env, name: str, t: @Type(), ns: str, is_global: bool): Env {
    Env { base_slots = env.base_slots; bindings = [..env.bindings, ValBinding { name = name; type = t; is_mut = false; ns = ns; is_const = false; vis = parser::Visibility::Pub; is_global = is_global }]; cur_ns = env.cur_ns; owner_type = env.owner_type; file = env.file; base_index = env.base_index; ret_expected = env.ret_expected; explicit = env.explicit }
}

pub fn define_const(env: Env, name: str, t: @Type(), ns: str, vis: parser::Visibility, is_global: bool): Env {
    Env { base_slots = env.base_slots; bindings = [..env.bindings, ValBinding { name = name; type = t; is_mut = false; ns = ns; is_const = true; vis = vis; is_global = is_global }]; cur_ns = env.cur_ns; owner_type = env.owner_type; file = env.file; base_index = env.base_index; ret_expected = env.ret_expected; explicit = env.explicit }
}

fn bind_is_mut(k: parser::BindKind): bool { k == parser::BindKind::Var }

fn nidx_names_of(b: []ValBinding): []str {
    var names: [b.len]str = []
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        names[i] = b[i].name
        i++
    }
    names
}

fn lookup_binding(env: Env, name: str): ValBinding | error {
    var i = env.bindings.len
    loop {
        if i == 0 { break }
        i = i - 1
        if env.bindings[i].name == name { return env.bindings[i] }
    }
    var h = teko::runtime::str_hash(name)
    var best: i64 = -1
    var k = nidx_lower_bound(env.base_index, h)
    loop {
        if k >= env.base_index.slots.len { break }
        if env.base_index.slots[k].hash != h { break }
        var p = env.base_index.slots[k].pos
        if env.base_slots[p].name == name && (p to i64) > best { best = p to i64 }
        k++
    }
    if best >= 0 { return env.base_slots[best to u64] }
    error { message = $"undefined name: {name}" }
}

fn lookup_value_in_ns(env: Env, name: str, ns: str): ValBinding | error {
    var i = env.bindings.len
    loop {
        if i == 0 { break }
        i = i - 1
        if env.bindings[i].name == name && qualifier_selects_ns(env.bindings[i].ns, ns) { return env.bindings[i] }
    }
    var j = env.base_slots.len
    loop {
        if j == 0 { break }
        j = j - 1
        if env.base_slots[j].name == name && qualifier_selects_ns(env.base_slots[j].ns, ns) { return env.base_slots[j] }
    }
    error { message = $"unknown value: {ns}::{name}" }
}

fn lookup(env: Env, name: str): @Type() | error {
    match lookup_binding(env, name) { ValBinding as b => b.type; error as e => e }
}

fn ns_last_seg(ns: str): str {
    var cut: u64 = 0
    var i: u64 = 0
    loop {
        if i + 1 >= ns.len { break }
        if ns[i] == b':' && ns[i + 1] == b':' { cut = i + 2 }
        i++
    }
    ns.slice(cut, ns.len)
}

fn ns_matches_call_qualifier(b_ns: str, callee: parser::Path): bool {
    qualifier_selects_ns(b_ns, path_qualifier(callee, callee.segments.len - 1))
}

fn call_is_teko_shorthand(callee: parser::Path): bool {
    callee.segments.len == 2 && callee.segments[0].name == "teko"
}

fn ns_is_teko_surface(ns: str): bool {
    ns.len >= 6 && ns.slice(0, 6) == "teko::"
}

fn call_binding_matches(b: ValBinding, callee: parser::Path, cur_ns: str, qualified: bool): bool {
    if !qualified { return b.ns.len == 0 || b.ns == cur_ns || b.is_global }
    if call_is_teko_shorthand(callee) && b.is_global && ns_is_teko_surface(b.ns) { return true }
    b.ns.len != 0 && ns_matches_call_qualifier(b.ns, callee)
}

fn call_base_pos(env: Env, callee: parser::Path, name: str, qualified: bool): i64 {
    var h = teko::runtime::str_hash(name)
    var best: i64 = -1
    var k = nidx_lower_bound(env.base_index, h)
    loop {
        if k >= env.base_index.slots.len { break }
        if env.base_index.slots[k].hash != h { break }
        var p = env.base_index.slots[k].pos
        var b = env.base_slots[p]
        if b.name == name && call_binding_matches(b, callee, env.cur_ns, qualified) && (p to i64) > best { best = p to i64 }
        k++
    }
    best
}

fn lookup_call(env: Env, callee: parser::Path): @Type() | error {
    var name = callee.segments[callee.segments.len - 1].name
    var qualified = callee.segments.len > 1
    var i = env.bindings.len
    loop {
        if i == 0 { break }
        i = i - 1
        var b = env.bindings[i]
        if b.name == name && call_binding_matches(b, callee, env.cur_ns, qualified) { return b.type }
    }
    var p = call_base_pos(env, callee, name, qualified)
    if p >= 0 { return env.base_slots[p to u64].type }
    error { message = $"undefined name: {name}" }
}

fn call_ns(env: Env, callee: parser::Path): str {
    var name = callee.segments[callee.segments.len - 1].name
    var qualified = callee.segments.len > 1
    var i = env.bindings.len
    loop {
        if i == 0 { break }
        i = i - 1
        var b = env.bindings[i]
        if b.name == name && call_binding_matches(b, callee, env.cur_ns, qualified) { return b.ns }
    }
    var p = call_base_pos(env, callee, name, qualified)
    if p >= 0 { return env.base_slots[p to u64].ns }
    ""
}

fn binding_is_func(b: ValBinding): bool {
    match b.type { Func => true; _ => false }
}

pub fn lookup_call_candidates(env: Env, callee: parser::Path): []ValBinding {
    var name = callee.segments[callee.segments.len - 1].name
    var qualified = callee.segments.len > 1
    var out: []ValBinding = []
    var h = teko::runtime::str_hash(name)
    var k = nidx_lower_bound(env.base_index, h)
    loop {
        if k >= env.base_index.slots.len { break }
        if env.base_index.slots[k].hash != h { break }
        var p = env.base_index.slots[k].pos
        var b = env.base_slots[p]
        if b.name == name && call_binding_matches(b, callee, env.cur_ns, qualified) { out = [..out, b] }
        k++
    }
    var i: u64 = 0
    loop {
        if i >= env.bindings.len { break }
        var lb = env.bindings[i]
        if lb.name == name && call_binding_matches(lb, callee, env.cur_ns, qualified) { out = [..out, lb] }
        i++
    }
    out
}

pub fn call_has_global_overload(env: Env, callee: parser::Path): bool {
    var cands = lookup_call_candidates(env, callee)
    if cands.len < 2 { return false }
    var i: u64 = 0
    loop {
        if i >= cands.len { break }
        if cands[i].is_global { return true }
        i++
    }
    false
}

pub fn overload_func_bindings(env: Env, ns: str, name: str): []ValBinding {
    var h = teko::runtime::str_hash(name)
    var out: []ValBinding = []
    var k = nidx_lower_bound(env.base_index, h)
    loop {
        if k >= env.base_index.slots.len { break }
        if env.base_index.slots[k].hash != h { break }
        var p = env.base_index.slots[k].pos
        var b = env.base_slots[p]
        if b.name == name && b.ns == ns && !b.is_const && binding_is_func(b) { out = [..out, b] }
        k++
    }
    out
}

pub fn env_is_overloaded(env: Env, ns: str, name: str): bool {
    overload_func_bindings(env, ns, name).len >= 2
}

type NotBuiltinType = struct { }

fn builtin_type(name: str): @Type() | NotBuiltinType | error {
    if name == "u8" { return Prim { kind = PrimKind::U8 } }
    if name == "u16" { return Prim { kind = PrimKind::U16 } }
    if name == "u32" { return Prim { kind = PrimKind::U32 } }
    if name == "u64" { return Prim { kind = PrimKind::U64 } }
    if name == "i8" { return Prim { kind = PrimKind::I8 } }
    if name == "i16" { return Prim { kind = PrimKind::I16 } }
    if name == "i32" { return Prim { kind = PrimKind::I32 } }
    if name == "i64" { return Prim { kind = PrimKind::I64 } }
    if name == "f32" { return Prim { kind = PrimKind::F32 } }
    if name == "f64" { return Prim { kind = PrimKind::F64 } }
    if name == "bool" { return Prim { kind = PrimKind::Bool } }
    if name == "isize" { return Prim { kind = PrimKind::Isize } }
    if name == "usize" { return Prim { kind = PrimKind::Usize } }
    if name == "byte" { return Byte { } }
    if name == "char" { return Char { } }
    if name == "str" { return Named { name = "teko::base::str" } }
    if name == "bigint" { return Named { name = "teko::numeric::bigint::BigInt" } }
    if name == "dec" { return Named { name = "teko::numeric::dec::Decimal" } }
    if name == "error" { return Error { } }
    if name == "()" { return Void { } }
    if name == "ptr" { return Ptr { inner = null } }
    if name == "uptr" { return Uptr { } }
    NotBuiltinType { }
}

fn tempty(): []@Type() { [] }

fn buf_ptr_signature(): @Type() {
    var len_param: []@Type() = [..tempty(), Prim { kind = PrimKind::U64 }]
    Func { params = len_param; ret = Ptr { inner = null }; variadic = false; param_names = []; n_required = len_param.len; defaults = []; ret_extra = [] }
}

fn byte_ptr_signature(): @Type() {
    var bp: []@Type() = [..tempty(), Slice { element = Byte { } }, Prim { kind = PrimKind::U64 }]
    Func { params = bp; ret = Ptr { inner = null }; variadic = false; param_names = []; n_required = bp.len; defaults = []; ret_extra = [] }
}

fn as_cstr_signature(str_t: @Type()): @Type() {
    var p: []@Type() = [..tempty(), str_t]
    Func { params = p; ret = Ptr { inner = null }; variadic = false; param_names = []; n_required = p.len; defaults = []; ret_extra = [] }
}

fn str_from_c_signature(str_t: @Type()): @Type() {
    var sfc: []@Type() = [..tempty(), Ptr { inner = null }, Prim { kind = PrimKind::U64 }]
    Func { params = sfc; ret = str_t; variadic = false; param_names = []; n_required = sfc.len; defaults = []; ret_extra = [] }
}

fn region_buf_signature(str_t: @Type()): @Type() {
    var rb: []@Type() = [..tempty(), Uptr { }, Prim { kind = PrimKind::U64 }, str_t]
    Func { params = rb; ret = Ptr { inner = null }; variadic = false; param_names = []; n_required = rb.len; defaults = []; ret_extra = [] }
}

fn capture_panic_signature(): @Type() {
    var body_t: @Type() = Func { params = []; ret = Null { }; variadic = false; param_names = []; n_required = 0; defaults = []; ret_extra = [] }
    var params: []@Type() = [..tempty(), body_t]
    var members: []@Type() = [..tempty(), Named { name = "teko::base::str" }, Null { }]
    Func { params = params; ret = Variant { members = members }; variadic = false; param_names = []; n_required = params.len; defaults = []; ret_extra = [] }
}

fn capture_longjmp_signature(): @Type() {
    var params: []@Type() = [..tempty(), Prim { kind = PrimKind::U64 }]
    Func { params = params; ret = Void { }; variadic = false; param_names = []; n_required = params.len; defaults = []; ret_extra = [] }
}

fn load_u64_signature(): @Type() {
    var addr_param: []@Type() = [..tempty(), Prim { kind = PrimKind::U64 }]
    Func { params = addr_param; ret = Prim { kind = PrimKind::U64 }; variadic = false; param_names = []; n_required = addr_param.len; defaults = []; ret_extra = [] }
}

fn store_u64_signature(): @Type() {
    var params: []@Type() = [..tempty(), Prim { kind = PrimKind::U64 }, Prim { kind = PrimKind::U64 }]
    Func { params = params; ret = Void { }; variadic = false; param_names = []; n_required = params.len; defaults = []; ret_extra = [] }
}

fn host_str_or_error(): @Type() {
    var m: []@Type() = [..tempty(), Named { name = "teko::base::str" }, Error { }]
    Variant { members = m }
}

fn host_strslice_or_error(): @Type() {
    var m: []@Type() = [..tempty(), Slice { element = Named { name = "teko::base::str" } }, Error { }]
    Variant { members = m }
}

fn host_error_optional(): @Type() {
    var m: []@Type() = [..tempty(), Null { }, Error { }]
    Variant { members = m }
}

fn host_func(params: []@Type(), ret: @Type()): @Type() {
    Func { params = params; ret = ret; variadic = false; param_names = []; n_required = params.len; defaults = []; ret_extra = [] }
}

fn host_surface_fn(name: str): @Type() | error {
    var str_t: @Type() = Named { name = "teko::base::str" }
    var bytes_t = Slice { element = Byte { } }
    var str_slice_t = Slice { element = Named { name = "teko::base::str" } }
    if name == "args" { return host_func([], str_slice_t) }
    if name == "read_line" || name == "read_stdin" { return host_func([], str_t) }
    if name == "stdin_eof" { return host_func([], Prim { kind = PrimKind::Bool }) }
    if name == "cwd" { return host_func([], host_str_or_error()) }
    if name == "var" || name == "read_file" { return host_func([..tempty(), str_t], host_str_or_error()) }
    if name == "chdir" || name == "mkdir" || name == "remove_file" { return host_func([..tempty(), str_t], host_error_optional()) }
    if name == "set_var" || name == "write_file" { return host_func([..tempty(), str_t, str_t], host_error_optional()) }
    if name == "write_file_bytes" {
        var p: []@Type() = [..tempty(), str_t, bytes_t]
        return host_func(p, host_error_optional())
    }
    if name == "list_dir" { return host_func([..tempty(), str_t], host_strslice_or_error()) }
    if name == "run" || name == "run_quiet" { return host_func([..tempty(), str_slice_t], Prim { kind = PrimKind::I32 }) }
    error { message = "not a host surface function" }
}

fn assert_void_sig(params: []@Type()): @Type() {
    Func { params = params; ret = Void { }; variadic = false; param_names = []; n_required = params.len; defaults = []; ret_extra = [] }
}

fn assert_one_sig(t: @Type()): @Type() {
    var p: []@Type() = [..tempty(), t]
    assert_void_sig(p)
}

fn assert_pair_sig(t: @Type()): @Type() {
    var p: []@Type() = [..tempty(), t, t]
    assert_void_sig(p)
}

fn assert_named_flag_sig(): @Type() {
    var p: []@Type() = [..tempty(), Named { name = "teko::base::str" }, Prim { kind = PrimKind::Bool }]
    assert_void_sig(p)
}

fn assert_builtin_fn(name: str): @Type() | null {
    var str_t: @Type() = Named { name = "teko::base::str" }
    var bool_t = Prim { kind = PrimKind::Bool }
    if name == "is_true" || name == "is_false" { return assert_one_sig(bool_t) }
    if name == "scenario_begin" { return assert_one_sig(str_t) }
    if name == "scenario_ok" { return assert_void_sig([]) }
    if name == "eq_i64" || name == "ne_i64" || name == "lt_i64" || name == "le_i64" || name == "gt_i64" || name == "ge_i64" {
        return assert_pair_sig(Prim { kind = PrimKind::I64 })
    }
    if name == "eq_u64" || name == "len_eq" { return assert_pair_sig(Prim { kind = PrimKind::U64 }) }
    if name == "eq_f64" {
        var f64_t = Prim { kind = PrimKind::F64 }
        var fp: []@Type() = [..tempty(), f64_t, f64_t, f64_t]
        return assert_void_sig(fp)
    }
    if name == "eq_str" || name == "ne_str" || name == "str_contains" || name == "str_absent" || name == "str_starts_with" || name == "str_ends_with" {
        return assert_pair_sig(str_t)
    }
    if name == "bytes_eq" { return assert_pair_sig(Slice { element = Byte { } }) }
    if name == "is_present" || name == "is_absent" || name == "is_ok" || name == "is_error" { return assert_named_flag_sig() }
    null
}

pub fn assert_builtin_name(last: str): bool {
    match assert_builtin_fn(last) { (@Type()) as _gt4 => true; null => false }
}

fn type_is_fat_by_value(t: @Type()): bool {
    if is_str_type(t) { return true }
    match t {
        Slice => true
        _ => false
    }
}

fn count_leading_fat_params(f: Func): u64 {
    var n: u64 = 0
    loop {
        if n >= f.params.len { break }
        if !type_is_fat_by_value(f.params[n]) { break }
        n++
    }
    n
}

pub fn assert_fat_arg_arity(last: str): u64 {
    var none: u64 = 0 to u64
    var t = match assert_builtin_fn(last) { (@Type()) as x => x; null => return none }
    match t { Func as f => count_leading_fat_params(f); _ => none }
}

fn syscallN_signature(arity: u64): @Type() {
    var i64_t: @Type() = Prim { kind = PrimKind::I64 }
    var nparams = arity + (1 to u64)
    var ps: [nparams]@Type() = []
    var i: u64 = 0 to u64
    loop {
        if i >= nparams { break }
        ps[i] = i64_t
        i = i + (1 to u64)
    }
    Func { params = ps; ret = i64_t; variadic = false; param_names = []; n_required = ps.len; defaults = []; ret_extra = [] }
}

fn thread_clone_signature(): @Type() {
    var i64_t: @Type() = Prim { kind = PrimKind::I64 }
    var ps: []@Type() = [..tempty(), i64_t, i64_t, i64_t, i64_t, i64_t]
    Func { params = ps; ret = i64_t; variadic = false; param_names = []; n_required = ps.len; defaults = []; ret_extra = [] }
}

fn atomic_rmw_signature(nargs: u64): @Type() {
    var i64_t: @Type() = Prim { kind = PrimKind::I64 }
    var ps: [nargs]@Type() = []
    var i: u64 = 0 to u64
    loop {
        if i >= nargs { break }
        ps[i] = i64_t
        i = i + (1 to u64)
    }
    Func { params = ps; ret = i64_t; variadic = false; param_names = []; n_required = ps.len; defaults = []; ret_extra = [] }
}

fn weak_get_signature(): @Type() {
    var t_param: @Type() = Named { name = "T" }
    var p: []@Type() = [..tempty(), Ptr { inner = null }]
    var m: []@Type() = [..tempty(), t_param, Null { }]
    Func { params = p; ret = Variant { members = m }; variadic = false; param_names = []; n_required = p.len; defaults = []; ret_extra = [] }
}

fn deep_copy_signature(): @Type() {
    var t_param: @Type() = Named { name = "T" }
    var p: []@Type() = [..tempty(), t_param]
    var m: []@Type() = [..tempty(), t_param, Error { }]
    Func { params = p; ret = Variant { members = m }; variadic = false; param_names = []; n_required = p.len; defaults = []; ret_extra = [] }
}

fn builtin_fn(name: str): @Type() | error {
    var str_t: @Type() = Named { name = "teko::base::str" }
    var void_t = Void { }
    var bytes_t = Slice { element = Byte { } }
    if name == "version" { return Func { params = []; ret = str_t; variadic = false; param_names = []; n_required = 0; defaults = []; ret_extra = [] } }
    if name == "peak_rss" { return Func { params = []; ret = Prim { kind = PrimKind::U64 }; variadic = false; param_names = []; n_required = 0; defaults = []; ret_extra = [] } }
    if name == "append_fo" {
        var afp: []@Type() = [..tempty(), bytes_t, str_t]
        return Func { params = afp; ret = bytes_t; variadic = false; param_names = []; n_required = afp.len; defaults = []; ret_extra = [] }
    }
    if name == "abort" { return Func { params = []; ret = void_t; variadic = false; param_names = []; n_required = 0; defaults = []; ret_extra = [] } }
    if name == "arena_push" { return Func { params = []; ret = void_t; variadic = false; param_names = []; n_required = 0; defaults = []; ret_extra = [] } }
    if name == "arena_pop" { return Func { params = []; ret = void_t; variadic = false; param_names = []; n_required = 0; defaults = []; ret_extra = [] } }
    if name == "arena_commit" { return Func { params = []; ret = void_t; variadic = false; param_names = []; n_required = 0; defaults = []; ret_extra = [] } }
    if name == "task_reset" { return Func { params = []; ret = void_t; variadic = false; param_names = []; n_required = 0; defaults = []; ret_extra = [] } }
    if name == "fdiv" { return Func { params = [..tempty(), Prim { kind = PrimKind::F64 }, Prim { kind = PrimKind::F64 }]; ret = Prim { kind = PrimKind::F64 }; variadic = false; param_names = []; n_required = ([..tempty(), Prim { kind = PrimKind::F64 }, Prim { kind = PrimKind::F64 }]).len; defaults = []; ret_extra = [] } }
    if name == "floor" { return Func { params = [..tempty(), Prim { kind = PrimKind::F64 }]; ret = Prim { kind = PrimKind::F64 }; variadic = false; param_names = []; n_required = ([..tempty(), Prim { kind = PrimKind::F64 }]).len; defaults = []; ret_extra = [] } }
    if name == "f64_from_bits" { return Func { params = [..tempty(), Prim { kind = PrimKind::U64 }]; ret = Prim { kind = PrimKind::F64 }; variadic = false; param_names = []; n_required = ([..tempty(), Prim { kind = PrimKind::U64 }]).len; defaults = []; ret_extra = [] } }
    if name == "f64_bits" { return Func { params = [..tempty(), Prim { kind = PrimKind::F64 }]; ret = Prim { kind = PrimKind::U64 }; variadic = false; param_names = []; n_required = ([..tempty(), Prim { kind = PrimKind::F64 }]).len; defaults = []; ret_extra = [] } }
    if name == "syscall0" { return syscallN_signature(0 to u64) }
    if name == "syscall1" { return syscallN_signature(1 to u64) }
    if name == "syscall2" { return syscallN_signature(2 to u64) }
    if name == "syscall3" { return syscallN_signature(3 to u64) }
    if name == "syscall4" { return syscallN_signature(4 to u64) }
    if name == "syscall5" { return syscallN_signature(5 to u64) }
    if name == "syscall6" { return syscallN_signature(6 to u64) }
    if name == "thread_clone" { return thread_clone_signature() }
    if name == "atomic_cas_u32" { return atomic_rmw_signature(3 to u64) }
    if name == "atomic_xchg_u32" { return atomic_rmw_signature(2 to u64) }
    if name == "atomic_add_u32" { return atomic_rmw_signature(2 to u64) }
    if name == "atomic_load_u32" { return atomic_rmw_signature(1 to u64) }
    if name == "ptr_word" {
        var pwp: []@Type() = [..tempty(), Ptr { inner = null }]
        return Func { params = pwp; ret = Prim { kind = PrimKind::I64 }; variadic = false; param_names = []; n_required = pwp.len; defaults = []; ret_extra = [] }
    }
    if name == "word_ptr" {
        var wpp: []@Type() = [..tempty(), Prim { kind = PrimKind::I64 }]
        return Func { params = wpp; ret = Ptr { inner = null }; variadic = false; param_names = []; n_required = wpp.len; defaults = []; ret_extra = [] }
    }
    if name == "retain" || name == "release" {
        var rrp: []@Type() = [..tempty(), Ptr { inner = null }]
        return Func { params = rrp; ret = void_t; variadic = false; param_names = []; n_required = rrp.len; defaults = []; ret_extra = [] }
    }
    if name == "weak_get" { return weak_get_signature() }
    if name == "deep_copy" { return deep_copy_signature() }
    match assert_builtin_fn(name) { (@Type()) as at => return at; null => { } }
    if name == "slice_view" {
        var t_param: @Type() = Named { name = "T" }
        var p: []@Type() = [..tempty(), t_param, Prim { kind = PrimKind::U64 }, Prim { kind = PrimKind::U64 }]
        return Func { params = p; ret = t_param; variadic = false; param_names = []; n_required = (p).len; defaults = []; ret_extra = [] }
    }
    if name == "str" || name == "str_of_bytes" { return Func { params = [..tempty(), bytes_t]; ret = str_t; variadic = false; param_names = []; n_required = ([..tempty(), bytes_t]).len; defaults = []; ret_extra = [] } }
    if name == "one_byte" { return Func { params = [..tempty(), Byte { }]; ret = str_t; variadic = false; param_names = []; n_required = ([..tempty(), Byte { }]).len; defaults = []; ret_extra = [] } }
    if name == "str_concat" { return Func { params = [..tempty(), str_t, str_t]; ret = str_t; variadic = false; param_names = []; n_required = ([..tempty(), str_t, str_t]).len; defaults = []; ret_extra = [] } }
    if name == "i64_to_str" { return Func { params = [..tempty(), Prim { kind = PrimKind::I64 }]; ret = str_t; variadic = false; param_names = []; n_required = ([..tempty(), Prim { kind = PrimKind::I64 }]).len; defaults = []; ret_extra = [] } }
    if name == "u64_to_str" { return Func { params = [..tempty(), Prim { kind = PrimKind::U64 }]; ret = str_t; variadic = false; param_names = []; n_required = ([..tempty(), Prim { kind = PrimKind::U64 }]).len; defaults = []; ret_extra = [] } }
    if name == "ftoa" { return Func { params = [..tempty(), Prim { kind = PrimKind::F64 }]; ret = str_t; variadic = false; param_names = []; n_required = ([..tempty(), Prim { kind = PrimKind::F64 }]).len; defaults = []; ret_extra = [] } }
    if name == "parse" { return Func { params = [..tempty(), str_t]; ret = Prim { kind = PrimKind::F64 }; variadic = false; param_names = []; n_required = ([..tempty(), str_t]).len; defaults = []; ret_extra = [] } }
    if name == "concat" { return Func { params = [..tempty(), Slice { element = str_t }]; ret = str_t; variadic = true; param_names = []; n_required = ([..tempty(), Slice { element = str_t }]).len; defaults = []; ret_extra = [] } }
    if name == "str_from_utf8" {
        var m: []@Type() = [..tempty(), str_t, Error { }]
        return Func { params = [..tempty(), bytes_t]; ret = Variant { members = m }; variadic = false; param_names = []; n_required = ([..tempty(), bytes_t]).len; defaults = []; ret_extra = [] }
    }
    if name == "last_index_of" {
        var m: []@Type() = [..tempty(), Prim { kind = PrimKind::U64 }, Error { }]
        var u64_or_err = Variant { members = m }
        return Func { params = [..tempty(), str_t, str_t]; ret = u64_or_err; variadic = false; param_names = []; n_required = ([..tempty(), str_t, str_t]).len; defaults = []; ret_extra = [] }
    }
    if name == "err_loc" {
        var p: []@Type() = [..tempty(), Error { }, Prim { kind = PrimKind::U32 }, Prim { kind = PrimKind::U32 }]
        return Func { params = p; ret = Error { }; variadic = false; param_names = []; n_required = (p).len; defaults = []; ret_extra = [] }
    }
    if name == "err_typed" {
        var p: []@Type() = [..tempty(), Error { }, str_t, str_t]
        return Func { params = p; ret = Error { }; variadic = false; param_names = []; n_required = (p).len; defaults = []; ret_extra = [] }
    }
    if name == "as_cstr" { return as_cstr_signature(str_t) }
    if name == "str_from_c" { return str_from_c_signature(str_t) }
    if name == "bytes_from_ptr" {
        var bp: []@Type() = [..tempty(), Ptr { inner = null }, Prim { kind = PrimKind::U64 }]
        return Func { params = bp; ret = bytes_t; variadic = false; param_names = []; n_required = (bp).len; defaults = []; ret_extra = [] }
    }
    if name == "capture_panic" { return capture_panic_signature() }
    if name == "capture_longjmp" { return capture_longjmp_signature() }
    if name == "load_u64" { return load_u64_signature() }
    if name == "store_u64" { return store_u64_signature() }
    if name == "load_u8" { return load_u64_signature() }
    if name == "store_u8" { return store_u64_signature() }
    if name == "buf_ptr" { return buf_ptr_signature() }
    if name == "byte_ptr" { return byte_ptr_signature() }
    if name == "region_buf" { return region_buf_signature(str_t) }
    if name == "fmt_f" || name == "fmt_e" || name == "fmt_g" || name == "fmt_n_f" || name == "fmt_p" {
        var p: []@Type() = [..tempty(), Prim { kind = PrimKind::F64 }, Prim { kind = PrimKind::I64 }]
        return Func { params = p; ret = str_t; variadic = false; param_names = []; n_required = (p).len; defaults = []; ret_extra = [] }
    }
    if name == "fmt_d" {
        var p: []@Type() = [..tempty(), Prim { kind = PrimKind::I64 }, Prim { kind = PrimKind::I64 }]
        return Func { params = p; ret = str_t; variadic = false; param_names = []; n_required = (p).len; defaults = []; ret_extra = [] }
    }
    if name == "fmt_x_upper" || name == "fmt_x_lower" || name == "fmt_b" {
        return Func { params = [..tempty(), Prim { kind = PrimKind::U64 }]; ret = str_t; variadic = false; param_names = []; n_required = ([..tempty(), Prim { kind = PrimKind::U64 }]).len; defaults = []; ret_extra = [] }
    }
    if name == "fmt_n_i" { return Func { params = [..tempty(), Prim { kind = PrimKind::I64 }]; ret = str_t; variadic = false; param_names = []; n_required = ([..tempty(), Prim { kind = PrimKind::I64 }]).len; defaults = []; ret_extra = [] } }
    if name == "fmt_dyn_f64" {
        var p: []@Type() = [..tempty(), Prim { kind = PrimKind::F64 }, Named { name = "teko::base::str" }]
        return Func { params = p; ret = str_t; variadic = false; param_names = []; n_required = (p).len; defaults = []; ret_extra = [] }
    }
    if name == "fmt_dyn_i64" {
        var p: []@Type() = [..tempty(), Prim { kind = PrimKind::I64 }, Named { name = "teko::base::str" }]
        return Func { params = p; ret = str_t; variadic = false; param_names = []; n_required = (p).len; defaults = []; ret_extra = [] }
    }
    if name == "fmt_dyn_u64" {
        var p: []@Type() = [..tempty(), Prim { kind = PrimKind::U64 }, Named { name = "teko::base::str" }]
        return Func { params = p; ret = str_t; variadic = false; param_names = []; n_required = (p).len; defaults = []; ret_extra = [] }
    }
    match host_surface_fn(name) { (@Type()) as t => return t; error => { } }
    error { message = "not a built-in function" }
}

/**
 * is_runtime_alloc_builtin — true for the region-allocating runtime builtins whose bare-name calls the
 * codegen used to name-detect and hand-emit. Re-resolving these to `teko::runtime` lets the generic
 * call path emit the symbol and thread the implicit region argument automatically.
 *
 * @param name  the bare builtin name
 * @return      true iff `name` is a `teko::runtime` string/number-formatting allocator
 */
fn is_runtime_alloc_builtin(name: str): bool {
    if name == "one_byte" || name == "str_concat" || name == "i64_to_str" || name == "u64_to_str" || name == "ftoa" { return true }
    if name == "fmt_f" || name == "fmt_e" || name == "fmt_g" || name == "fmt_n_f" || name == "fmt_p" { return true }
    if name == "fmt_d" || name == "fmt_x_upper" || name == "fmt_x_lower" || name == "fmt_b" || name == "fmt_n_i" { return true }
    name == "fmt_dyn_f64" || name == "fmt_dyn_i64" || name == "fmt_dyn_u64"
}
