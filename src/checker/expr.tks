
use teko::lexer

fn is_bool(t: @Type()): bool {
    match t { Prim as p => p.kind == PrimKind::Bool; _ => false }
}

fn is_integer(t: @Type()): bool {
    match t { Prim as p => prim_is_int(p.kind); _ => false }
}

fn is_float(t: @Type()): bool {
    match t { Prim as p => prim_is_float(p.kind); _ => false }
}

fn is_numeric(t: @Type()): bool { is_integer(t) || is_float(t) }

fn variant_has_member(v: @Type(), t: @Type()): bool {
    match v {
        Variant as vv => {
            var i = 0
            loop {
                if i >= vv.members.len { break }
                if type_eq(vv.members[i], t) { return true }
                i++
            }
            false
        }
        _ => false
    }
}

fn is_comparable(a: @Type(), b: @Type()): bool {
    if is_integer(a) && is_integer(b) { return true }
    if is_float(a) && is_float(b) { return type_eq(a, b) }
    if variant_has_member(a, b) || variant_has_member(b, a) { return true }
    type_eq(a, b)
}

fn prim_kind_of(t: @Type()): PrimKind {
    match t { Prim as p => p.kind; _ => PrimKind::Bool }
}

fn int_arith_join(a: PrimKind, b: PrimKind): PrimKind | error {
    if a == b { return a }
    var aw = prim_width(a, host_target())
    var bw = prim_width(b, host_target())
    var a_signed = prim_is_signed(a)
    var b_signed = prim_is_signed(b)
    if a_signed == b_signed { return if aw >= bw { a } else { b } }
    var signed_kind = if a_signed { a } else { b }
    var unsigned_kind = if a_signed { b } else { a }
    if prim_width(signed_kind, host_target()) > prim_width(unsigned_kind, host_target()) { return signed_kind }
    error { message = "mixed-sign integer arithmetic has no lossless common type here (W-RULE — the signed side must be strictly wider than the unsigned side); use an explicit `to`" }
}

fn float_arith_join(a: PrimKind, b: PrimKind): PrimKind {
    if prim_width(a, host_target()) >= prim_width(b, host_target()) { a } else { b }
}

fn widen_operand(operand: TExpr, target: PrimKind): TExpr {
    var target_type = Prim { kind = target }
    if type_eq(operand.type, target_type) { return operand }
    TExpr { kind = TCast { expr = operand }; type = target_type; line = operand.line; col = operand.col }
}

pub fn numeric_widens_implicitly(from: @Type(), to: @Type()): bool {
    if type_eq(from, to) { return false }
    if is_integer(from) && is_integer(to) { return cast_is_lossless_widen(prim_kind_of(from), prim_kind_of(to)) }
    if is_float(from) && is_float(to) { return prim_width(prim_kind_of(to), host_target()) > prim_width(prim_kind_of(from), host_target()) }
    false
}

fn cast_widen_is_redundant(term: TExpr, other: @Type()): bool {
    if !is_integer(other) { return false }
    if !is_integer(term.type) { return false }
    match term.kind {
        TCast as tc => {
            if !is_integer(tc.expr.type) { return false }
            if !cast_is_lossless_widen(prim_kind_of(tc.expr.type), prim_kind_of(term.type)) { return false }
            join_unchanged_without_cast(prim_kind_of(tc.expr.type), prim_kind_of(term.type), prim_kind_of(other))
        }
        _ => false
    }
}

pub fn cast_is_lossless_widen(inner: PrimKind, outer: PrimKind): bool {
    if same_word_lateral(inner, outer) { return true }
    match int_arith_join(inner, outer) {
        PrimKind as k => k == outer
        error => false
    }
}

fn same_word_lateral(a: PrimKind, b: PrimKind): bool {
    if a == PrimKind::U64 && b == PrimKind::Usize { return true }
    if a == PrimKind::Usize && b == PrimKind::U64 { return true }
    if a == PrimKind::I64 && b == PrimKind::Isize { return true }
    if a == PrimKind::Isize && b == PrimKind::I64 { return true }
    false
}

fn join_unchanged_without_cast(inner: PrimKind, outer: PrimKind, other: PrimKind): bool {
    match int_arith_join(inner, other) {
        PrimKind as without => match int_arith_join(outer, other) {
            PrimKind as with_cast => without == with_cast
            error => false
        }
        error => false
    }
}

fn redundant_widen_cast_of(l: TExpr, r: TExpr): TExpr | null {
    if !operand_may_flag_partner(r) && cast_widen_is_redundant(l, r.type) { return l }
    if !operand_may_flag_partner(l) && cast_widen_is_redundant(r, l.type) { return r }
    null
}

fn operand_may_flag_partner(e: TExpr): bool {
    match e.kind {
        TNumber => true
        TCast => true
        _ => false
    }
}

fn op_is_shift(op: lexer::TokenKind): bool {
    op == lexer::TokenKind::Shl || op == lexer::TokenKind::Shr
}

fn op_is_eq_ne(op: lexer::TokenKind): bool {
    op == lexer::TokenKind::EqEq || op == lexer::TokenKind::Ne
}

fn op_is_arith(op: lexer::TokenKind): bool {
    op == lexer::TokenKind::Plus || op == lexer::TokenKind::Minus ||
    op == lexer::TokenKind::Star || op == lexer::TokenKind::Slash
}

fn op_is_arith_bitwise(op: lexer::TokenKind): bool {
    op == lexer::TokenKind::Percent ||
    op == lexer::TokenKind::Amp || op == lexer::TokenKind::Pipe || op == lexer::TokenKind::Caret
}

fn is_flags_named(t: @Type(), table: TypeTable): bool {
    match t {
        Named as n => {
            match type_table_find(table, n.name, "") {
                parser::TypeDecl as d => {
                    match d.body {
                        parser::FlagsBody => true
                        _ => false
                    }
                }
                error => false
            }
        }
        _ => false
    }
}

fn type_flags_binary(op: lexer::TokenKind, lt: @Type(), rt: @Type(), table: TypeTable): bool {
    if op != lexer::TokenKind::Amp && op != lexer::TokenKind::Pipe && op != lexer::TokenKind::Caret {
        return false
    }
    is_flags_named(lt, table)
}

fn is_flags_method(name: str): bool {
    name == "has" || name == "all" || name == "any" || name == "none" || name == "add" || name == "remove"
}
