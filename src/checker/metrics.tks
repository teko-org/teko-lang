
use teko::parser

pub type ArithCastRateReport = struct {
    total: u64
    with_conversion: u64
}

fn arith_cast_rate_empty(): ArithCastRateReport { ArithCastRateReport { total = 0; with_conversion = 0 } }

pub fn arith_cast_rate_from(total: u64, with_conversion: u64): ArithCastRateReport {
    ArithCastRateReport { total = total; with_conversion = with_conversion }
}

fn arith_cast_rate_note(w: ArithCastRateReport, e: TExpr): ArithCastRateReport {
    var bump: u64 = if expr_has_conversion(e) { 1 } else { 0 }
    ArithCastRateReport { total = w.total + 1; with_conversion = w.with_conversion + bump }
}

pub fn arith_cast_rate_pct(r: ArithCastRateReport): f64 {
    if r.total == 0 { return 0.0 }
    (100.0 * (r.with_conversion to f64)) / (r.total to f64)
}

pub const ARITH_CAST_RATE_CEILING: f64 = 5.0

pub fn arith_cast_rate_gate_ok(r: ArithCastRateReport): bool {
    arith_cast_rate_pct(r) <= ARITH_CAST_RATE_CEILING
}

fn call_is_casting(c: TCall): bool { c.call_ns == "teko::casting" }

fn expr_has_conversion(e: TExpr): bool {
    match e.kind {
        TCast => true
        TCall as c => {
            if call_is_casting(c) { return true }
            var i = 0
            loop { if i >= c.args.len { break }; if expr_has_conversion(c.args[i]) { return true }; i++ }
            false
        }
        TBinary as b => expr_has_conversion(b.left) || expr_has_conversion(b.right)
        TUnary as u => expr_has_conversion(u.operand)
        TCompare as cm => {
            if expr_has_conversion(cm.first) { return true }
            var i = 0
            loop { if i >= cm.rest.len { break }; if expr_has_conversion(cm.rest[i].operand) { return true }; i++ }
            false
        }
        TIfExpr as f => {
            if expr_has_conversion(f.cond) { return true }
            if block_has_conversion(f.then_blk) { return true }
            if f.has_else { return block_has_conversion(f.else_blk) }
            false
        }
        TMatchExpr as m => {
            if expr_has_conversion(m.subject) { return true }
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when && expr_has_conversion(m.arms[i].guard) { return true }
                if block_has_conversion(m.arms[i].body) { return true }
                i++
            }
            false
        }
        TFieldAccess as fa => expr_has_conversion(fa.receiver)
        TIndex as ix => expr_has_conversion(ix.receiver) || expr_has_conversion(ix.index)
        TStructInit as si => {
            var i = 0
            loop { if i >= si.field_vals.len { break }; if expr_has_conversion(si.field_vals[i]) { return true }; i++ }
            false
        }
        TInterp as ip => {
            var i = 0
            loop {
                if i >= ip.holes.len { break }
                if expr_has_conversion(ip.holes[i]) { return true }
                if i < ip.specs.len {
                    match ip.specs[i].kind {
                        TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; if expr_has_conversion(fd.args[k]) { return true }; k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            false
        }
        TInExpr as ie => {
            if expr_has_conversion(ie.lhs) { return true }
            var i = 0
            loop { if i >= ie.elems.len { break }; if expr_has_conversion(ie.elems[i]) { return true }; i++ }
            false
        }
        TArrayLit as al => {
            var i = 0
            loop { if i >= al.elements.len { break }; if expr_has_conversion(al.elements[i].expr) { return true }; i++ }
            false
        }
        TBorrow as bo => expr_has_conversion(bo.operand)
        TBlockExpr as b => block_has_conversion(b.body)
        _ => false
    }
}

fn block_has_conversion(stmts: []@TStatement()): bool {
    var i = 0
    loop { if i >= stmts.len { break }; if stmt_has_conversion(stmts[i]) { return true }; i++ }
    false
}

fn stmt_has_conversion(s: @TStatement()): bool {
    match s {
        TBinding as b => expr_has_conversion(b.value)
        TAssign as a => expr_has_conversion(a.value) || (parser::assign_has_target(a.kind) && expr_has_conversion(a.target))
        TReturn as r => r.has_value && expr_has_conversion(r.value)
        TLoopStmt as l => block_has_conversion(l.init) || block_has_conversion(l.body)
        TExprStmt as x => expr_has_conversion(x.expr)
        TAdoptStmt as ad => block_has_conversion(ad.body)
        TBlockStmt as b => block_has_conversion(b.body)
        _ => false
    }
}

fn arith_cast_rate_walk_expr(e: TExpr, w: ArithCastRateReport): ArithCastRateReport {
    match e.kind {
        TBinary as b => {
            var w1 = if op_is_arith(b.op) || op_is_arith_bitwise(b.op) { arith_cast_rate_note(w, e) } else { w }
            arith_cast_rate_walk_expr(b.right, arith_cast_rate_walk_expr(b.left, w1))
        }
        TUnary as u => arith_cast_rate_walk_expr(u.operand, w)
        TCompare as cm => {
            var a = arith_cast_rate_walk_expr(cm.first, w)
            var i = 0
            loop { if i >= cm.rest.len { break }; a = arith_cast_rate_walk_expr(cm.rest[i].operand, a); i++ }
            a
        }
        TCall as c => {
            var a = w
            var i = 0
            loop { if i >= c.args.len { break }; a = arith_cast_rate_walk_expr(c.args[i], a); i++ }
            a
        }
        TCast as c => arith_cast_rate_walk_expr(c.expr, w)
        TIfExpr as f => {
            var a1 = arith_cast_rate_walk_expr(f.cond, w)
            var a2 = arith_cast_rate_walk_block(f.then_blk, a1)
            if f.has_else { arith_cast_rate_walk_block(f.else_blk, a2) } else { a2 }
        }
        TMatchExpr as m => {
            var a = arith_cast_rate_walk_expr(m.subject, w)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { a = arith_cast_rate_walk_expr(m.arms[i].guard, a) }
                a = arith_cast_rate_walk_block(m.arms[i].body, a)
                i++
            }
            a
        }
        TFieldAccess as fa => arith_cast_rate_walk_expr(fa.receiver, w)
        TIndex as ix => arith_cast_rate_walk_expr(ix.index, arith_cast_rate_walk_expr(ix.receiver, w))
        TStructInit as si => {
            var a = w
            var i = 0
            loop { if i >= si.field_vals.len { break }; a = arith_cast_rate_walk_expr(si.field_vals[i], a); i++ }
            a
        }
        TInterp as ip => {
            var a = w
            var i = 0
            loop {
                if i >= ip.holes.len { break }
                a = arith_cast_rate_walk_expr(ip.holes[i], a)
                if i < ip.specs.len {
                    match ip.specs[i].kind {
                        TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; a = arith_cast_rate_walk_expr(fd.args[k], a); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            a
        }
        TInExpr as ie => {
            var a = arith_cast_rate_walk_expr(ie.lhs, w)
            var i = 0
            loop { if i >= ie.elems.len { break }; a = arith_cast_rate_walk_expr(ie.elems[i], a); i++ }
            a
        }
        TArrayLit as al => {
            var a = w
            var i = 0
            loop { if i >= al.elements.len { break }; a = arith_cast_rate_walk_expr(al.elements[i].expr, a); i++ }
            a
        }
        TBorrow as bo => arith_cast_rate_walk_expr(bo.operand, w)
        TBlockExpr as b => arith_cast_rate_walk_block(b.body, w)
        _ => w
    }
}

fn arith_cast_rate_walk_stmt(s: @TStatement(), w: ArithCastRateReport): ArithCastRateReport {
    match s {
        TBinding as b => arith_cast_rate_walk_expr(b.value, arith_cast_rate_note(w, b.value))
        TAssign as a => {
            var w1 = arith_cast_rate_note(w, a.value)
            var w2 = arith_cast_rate_walk_expr(a.value, w1)
            if parser::assign_has_target(a.kind) { arith_cast_rate_walk_expr(a.target, w2) } else { w2 }
        }
        TReturn as r => if r.has_value { arith_cast_rate_walk_expr(r.value, w) } else { w }
        TLoopStmt as l => arith_cast_rate_walk_block(l.body, arith_cast_rate_walk_block(l.init, w))
        TExprStmt as x => arith_cast_rate_walk_expr(x.expr, w)
        TAdoptStmt as ad => arith_cast_rate_walk_block(ad.body, w)
        TBlockStmt as b => arith_cast_rate_walk_block(b.body, w)
        _ => w
    }
}

fn arith_cast_rate_walk_block(stmts: []@TStatement(), w: ArithCastRateReport): ArithCastRateReport {
    var a = w
    var i = 0
    loop { if i >= stmts.len { break }; a = arith_cast_rate_walk_stmt(stmts[i], a); i++ }
    a
}

pub fn arith_cast_rate_report(prog: TProgram): ArithCastRateReport {
    var w = arith_cast_rate_empty()
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            TFunction as f => w = arith_cast_rate_walk_block(f.body, w)
            TConstDecl as cd => w = arith_cast_rate_walk_expr(cd.init, w)
            (@TStatement()) as s => w = arith_cast_rate_walk_stmt(s, w)
            _ => { }
        }
        i++
    }
    w
}
