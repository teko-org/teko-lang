
use teko::lexer
use teko::parser

pub type TExpr = struct {
    kind: @TExprKind()
    type: @Type()
    line: u32
    col: u32
}

pub type TNumber = struct { is_float: bool; value: parser::NumInt; fval: f64 }
pub type TVar = struct { name: str; is_func: bool; func_ns: str }
pub type TStrLit = struct { text: str }
pub type TByteStrLit = struct { text: str }
pub type TByteLit = struct { value: byte }
pub type TCharLit = struct { bytes: str }
pub type TBoolLit = struct { value: bool }
pub type TNullLit = struct { }
pub type TBinary = struct { op: lexer::TokenKind; left: TExpr; right: TExpr }
pub type TUnary = struct { op: lexer::TokenKind; operand: TExpr }
pub type TCmpTerm = struct { op: lexer::TokenKind; operand: TExpr }
pub type TCompare = struct { first: TExpr; rest: []TCmpTerm }
pub type TCall = struct { callee: parser::Path; args: []TExpr; call_ns: str; is_closure_call: bool; callee_type: @Type(); is_iface_dispatch: bool; iface_slot: u32; type_args: []@Type(); overload_suffix: str; ret_extra: []@Type() }

pub type TArm = struct { pattern: @Pattern(); has_when: bool; guard: TExpr; body: []@TStatement() }
pub type TIfExpr = struct { cond: TExpr; then_blk: []@TStatement(); has_else: bool; else_blk: []@TStatement() }
pub type TMatchExpr = struct { subject: TExpr; arms: []TArm }
pub type TCast = struct { expr: TExpr }
pub type TFieldAccess = struct { receiver: TExpr; field: str }
pub type TStructInit = struct { field_names: []str; field_vals: []TExpr }
pub type TIndex = struct { receiver: TExpr; index: TExpr }
pub type TFSpecNone = struct { }
pub type TFSpecStatic = struct { s: str }
pub type TFSpecDynamic = struct { args: []TExpr }
macro TFSpecKind() { lowering { checker::TFSpecNone | checker::TFSpecStatic | checker::TFSpecDynamic } }
pub type TFSpec = struct { kind: @TFSpecKind() }
pub type TInterp = struct { pieces: []str; holes: []TExpr; specs: []TFSpec }
pub type TInExpr = struct { lhs: TExpr; elems: []TExpr }
pub type TArrayElem = struct { is_spread: bool; expr: TExpr }
pub type TArrayLit = struct { elements: []TArrayElem }
pub type TSliceOfLen = struct { size: TExpr; element: @Type() }
pub type TPathExpr = struct { enum_name: str; member: str; ordinal: u64; value: u64 }
pub type TLambdaParam = struct { name: str; type: @Type() }
pub type TCapture = struct { name: str; type: @Type(); by_ref: bool }
pub type TLambda = struct { params: []TLambdaParam; body: []@TStatement(); captures: []TCapture; ret: @Type(); lift_id: u64 }

pub type TBorrow = struct { operand: TExpr }

pub type TBlockExpr = struct { body: []@TStatement() }
pub type TZeroOf = struct { element: @Type() }

macro TExprKind() { lowering { checker::TNumber | checker::TVar | checker::TStrLit | checker::TByteStrLit | checker::TByteLit | checker::TCharLit | checker::TBoolLit | checker::TNullLit | checker::TBinary | checker::TUnary | checker::TCompare | checker::TCall | checker::TIfExpr | checker::TMatchExpr | checker::TCast | checker::TFieldAccess | checker::TStructInit | checker::TIndex | checker::TInterp | checker::TInExpr | checker::TPathExpr | checker::TArrayLit | checker::TSliceOfLen | checker::TLambda | checker::TBorrow | checker::TBlockExpr | checker::TZeroOf } }

pub type TBinding = struct { kind: parser::BindKind; target: @BindTarget(); bound: @Type(); value: TExpr }
pub type TAssign = struct { kind: parser::AssignKind; name: str; op: lexer::TokenKind; bound: @Type(); value: TExpr; deref: bool; target: TExpr }
pub type TReturn = struct { has_value: bool; value: TExpr; values: []TExpr }
pub type TLoopStmt = struct { label: str; init: []@TStatement(); body: []@TStatement() }
pub type TBreakStmt = struct { label: str }
pub type TContinueStmt = struct { label: str }
pub type TExprStmt = struct { expr: TExpr }
pub type TDeferStmt = struct { body: []@TStatement() }

pub type TAdoptStmt = struct { name: str; body: []@TStatement() }

pub type TBlockStmt = struct { body: []@TStatement() }

pub type TSpawn = struct { call: TExpr; id: u64 }

macro TStatement() { lowering { checker::TBinding | checker::TAssign | checker::TReturn | checker::TLoopStmt | checker::TBreakStmt | checker::TContinueStmt | checker::TExprStmt | checker::TDeferStmt | checker::TAdoptStmt | checker::TBlockStmt | checker::TSpawn } }

pub type TFunction = struct {
    name: str
    type_params: []str
    type_constraints: []@ConstraintExpr()
    params: []parser::Param
    return_type: @Type()
    body: []@TStatement()
    vis: parser::Visibility
    has_doc: bool
    doc: parser::DocSpan
    namespace: str
    file: str
    line: u32
    col: u32
    is_test: bool
    is_extern: bool
    c_symbol: str
    from_lib: str
    overload_suffix: str
    ret_extra: []@Type()
    guard: parser::Pred
}
pub type TConstDecl = struct { name: str; namespace: str; ty: @Type(); init: TExpr; vis: parser::Visibility; has_doc: bool; doc: parser::DocSpan; line: u32; col: u32; guard: parser::Pred }

macro TItem() { lowering { checker::TFunction | parser::TypeDecl | parser::UseDecl | @TStatement() | checker::TConstDecl } }
pub type TProgram = struct { items: []@TItem() }

pub fn no_texpr(): TExpr {
    TExpr { kind = TNullLit { }; type = Void { }; line = 0; col = 0 }
}

type TypedStmt = struct { node: @TStatement(); env: Env }
type TypedBlock = struct { stmts: []@TStatement(); env: Env }
