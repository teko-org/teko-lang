
use teko::parser

type MonoInst = struct { fn_name: str; mangled: str; s: Subst; owner_ns: str }

fn type_matches_resolved(concrete: @Type(), resolved: @Type() | error): bool {
    match resolved {
        (@Type()) as t => match t {
            Variant as v => {
                var i = 0
                loop {
                    if i >= v.members.len { break }
                    if type_eq(concrete, v.members[i]) { return true }
                    i++
                }
                false
            }
            _ => type_eq(concrete, t)
        }
        error => false
    }
}
fn constraint_atom_satisfied(atom_name: str, concrete: @Type(), table: TypeTable): bool {
    match type_table_find(table, atom_name, "") {
        parser::TypeDecl as td => {
            match td.body {
                parser::VariantBody as vb => type_matches_resolved(concrete, resolve_type(vb.type_expr, table, ""))
                parser::InterfaceBody => match concrete {
                    Named as n => n.name == atom_name || type_conforms_to(n.name, atom_name, table) || (name_last_segment(atom_name) == "IService" && type_satisfies_iservice(n.name, table));
                    _ => false
                }
                parser::TraitBody => match concrete { Named as n => n.name == atom_name || type_conforms_to(n.name, atom_name, table); _ => false }
                _ => match concrete { Named as n => n.name == atom_name; _ => false }
            }
        }
        error => match builtin_type(atom_name) {
            (@Type()) as bt => type_eq(concrete, bt)
            NotBuiltinType => false
            error => false
        }
    }
}
fn constraint_type_interface_base(te: @TypeExpr(), table: TypeTable): str {
    match te {
        parser::NamedType as nt => {
            var nm = nt.path.segments[nt.path.segments.len - 1].name
            if is_interface_name(nm, table) { return nm }
            ""
        }
        _ => ""
    }
}
fn constraint_type_satisfied(te: @TypeExpr(), concrete: @Type(), table: TypeTable): bool {
    var iface_base = constraint_type_interface_base(te, table)
    if iface_base != "" {
        return match concrete { Named as n => n.name == iface_base || type_conforms_to(n.name, iface_base, table); _ => false }
    }
    type_matches_resolved(concrete, resolve_type(te, table, ""))
}
fn constraint_satisfied(c: @ConstraintExpr(), concrete: @Type(), table: TypeTable): bool {
    match c {
        parser::ConstraintAnd as a => constraint_satisfied(a.left, concrete, table) && constraint_satisfied(a.right, concrete, table)
        parser::ConstraintOr as o => constraint_satisfied(o.left, concrete, table) || constraint_satisfied(o.right, concrete, table)
        parser::ConstraintAtom as a => constraint_atom_satisfied(a.name, concrete, table)
        parser::ConstraintType as ct => constraint_type_satisfied(ct.ty, concrete, table)
        parser::ConstraintForm as f => constraint_form_satisfied(f, concrete, table)
        parser::ConstraintNotNull => constraint_notnull_satisfied(concrete, table)
        parser::NoConstraint => true
    }
}
fn constraint_form_satisfied(cf: parser::ConstraintForm, concrete: @Type(), table: TypeTable): bool {
    var name = match concrete { Named as n => n.name; _ => return false }
    if cf.form == "class" { return is_class_name(name, table) }
    if cf.form == "struct" { return is_struct_name(name, table) }
    if cf.form == "service" {
        if !is_service_name(name, table) { return false }
        if !cf.has_lifetime { return true }
        match service_lifetime_of(name, table) {
            parser::ServiceLifetime as lt => lifetime_eq(lt, cf.lifetime)
            null => false
        }
    } else {
        false
    }
}
fn constraint_notnull_satisfied(concrete: @Type(), table: TypeTable): bool {
    match concrete { Null => return false; _ => { } }
    match expand_variant(concrete, table) {
        Variant as v => {
            var i = 0
            loop {
                if i >= v.members.len { break }
                match v.members[i] { Null => return false; _ => { } }
                i++
            }
            true
        }
        _ => true
    }
}
fn check_constraints(type_params: []str, type_constraints: []@ConstraintExpr(), s: Subst, table: TypeTable): error | null {
    var i = 0
    loop {
        if i >= type_params.len { break }
        match type_constraints[i] {
            parser::NoConstraint => { }
            _ => {
                var bound = match subst_find_inst(s, type_params[i]) {
                    (@Type()) as t => t
                    null => return error { message = teko::string::concat("internal: monomorphization did not bind type parameter '", type_params[i], "'") }
                }
                if !constraint_satisfied(type_constraints[i], bound, table) {
                    return error { message = teko::string::concat("type parameter '", type_params[i], "' does not satisfy its constraint at this instantiation") }
                }
            }
        }
        i++
    }
    null
}

type WExpr = struct { expr: TExpr; insts: []MonoInst }
type WStmt = struct { stmt: @TStatement(); insts: []MonoInst }
type WBlock = struct { stmts: []@TStatement(); insts: []MonoInst }
type WArm = struct { arm: TArm; insts: []MonoInst }
type WFn = struct { func: TFunction; insts: []MonoInst }
type WFnList = struct { fns: []TFunction; insts: []MonoInst }

fn mono_type_mangle(t: @Type()): str {
    match t {
        Prim as p => prim_name(p.kind)
        Byte => "byte"
        Char => "char"
        Named as n => name_last_segment(n.name)
        Slice as sl => { var e = mono_type_mangle(sl.element); teko::str::concat("slice_", e) }
        Error => "error"
        Void => "void"
        Ptr => "ptr"
        Uptr => "uptr"
        Reference as r => teko::str::concat("ref_", mono_type_mangle(r.inner))
        Variant => "variant"
        Func => "func"
        Null => "null"
    }
}

fn mono_mangle_name(bare: str, type_params: []str, s: Subst): str {
    var out = teko::str::concat(bare, "__g__")
    var i = 0
    loop {
        if i >= type_params.len { break }
        if i > 0 { out = teko::str::concat(out, "__") }
        var ct = subst_type(Named { name = type_params[i] }, s)
        out = teko::str::concat(out, mono_type_mangle(ct))
        i++
    }
    out
}

fn mono_seen(insts: []MonoInst, mangled: str): bool {
    var i = 0
    loop {
        if i >= insts.len { break }
        if teko::runtime::str_eq(insts[i].mangled, mangled) { return true }
        i++
    }
    false
}

fn mono_inst_seen(insts: []MonoInst, inst: MonoInst): bool {
    var i = 0
    loop {
        if i >= insts.len { break }
        if teko::runtime::str_eq(insts[i].mangled, inst.mangled) && teko::runtime::str_eq(insts[i].owner_ns, inst.owner_ns) { return true }
        i++
    }
    false
}

fn mono_inst_concat(a: []MonoInst, b: []MonoInst): []MonoInst {
    if b.len == 0 { return a }
    if a.len == 0 { return b }
    [..a, ..b]
}

pub fn type_to_texpr(t: @Type()): @TypeExpr() {
    if is_str_type(t) { return mono_named_texpr("str") }
    match t {
        Prim as p => mono_named_texpr(prim_name(p.kind))
        Byte => mono_named_texpr("byte")
        Char => mono_named_texpr("char")
        Error => mono_named_texpr("error")
        Named as n => parser::NamedType { path = name_to_path(n.name); args = [] }
        Slice as sl => parser::SliceType { element = type_to_texpr(sl.element) }
        Ptr => mono_named_texpr("ptr")
        Uptr => mono_named_texpr("uptr")
        Reference as r => parser::NamedType { path = parser::Path { segments = [parser::Segment { name = "Ref" }] }; args = [type_to_texpr(r.inner)] }
        Null => mono_named_texpr("null")
        Void => mono_named_texpr("()")
        Variant => mono_named_texpr("variant")
        Func as f => {
            var ps: [f.params.len]@TypeExpr() = []
            var i = 0
            loop { if i >= f.params.len { break }; ps[i] = type_to_texpr(f.params[i]); i++ }
            parser::FunctionType { params = ps; ret = type_to_texpr(f.ret) }
        }
    }
}
fn mono_named_texpr(name: str): @TypeExpr() {
    var seg = parser::Segment { name = name }
    parser::NamedType { path = parser::Path { segments = [seg] }; args = [] }
}

fn subst_typeexpr(te: @TypeExpr(), s: Subst): @TypeExpr() {
    match te {
        parser::NamedType as nt => {
            var probe = if nt.path.segments.len == 1 { nt.path.segments[0].name } else { path_qualifier(nt.path, nt.path.segments.len) }
            if is_type_param(probe, s.params) {
                match subst_find_inst(s, probe) {
                    (@Type()) as ct => return type_to_texpr(ct)
                    null => { }
                }
            }
            parser::NamedType { path = nt.path; args = subst_typeexpr_args(nt.args, s) }
        }
        parser::SliceType as st => parser::SliceType { element = subst_typeexpr(st.element, s) }
        parser::SizedArrayType as sa => parser::SizedArrayType { size = sa.size; element = subst_typeexpr(sa.element, s) }
        parser::UnionType as ut => {
            var ms: [ut.members.len]@TypeExpr() = []
            var i = 0
            loop { if i >= ut.members.len { break }; ms[i] = subst_typeexpr(ut.members[i], s); i++ }
            parser::UnionType { members = ms }
        }
        parser::FunctionType as fnt => {
            var nps: [fnt.params.len]@TypeExpr() = []
            var i = 0
            loop { if i >= fnt.params.len { break }; nps[i] = subst_typeexpr(fnt.params[i], s); i++ }
            parser::FunctionType { params = nps; ret = subst_typeexpr(fnt.ret, s) }
        }
        parser::MacroType => te
    }
}

fn subst_typeexpr_args(args: []@TypeExpr(), s: Subst): []@TypeExpr() {
    var out: []@TypeExpr() = []
    var i: u64 = 0
    loop {
        if i >= args.len { break }
        out = [..out, subst_typeexpr(args[i], s)]
        i++
    }
    out
}

fn subst_find_inst(s: Subst, name: str): @Type() | null {
    var i = 0
    loop {
        if i >= s.names.len { break }
        if teko::runtime::str_eq(s.names[i], name) { return s.types[i] }
        i++
    }
    null
}

fn mono_rekey_call_ns(call_ns: str, s: Subst): str {
    if call_ns.len == 0 { return call_ns }
    match subst_find_inst(s, call_ns) {
        (@Type()) as ct => match ct { Named as n => n.name; _ => subst_instance_name(call_ns, s) }
        null => subst_instance_name(call_ns, s)
    }
}

fn mono_rekey_callee_qualifier(callee: parser::Path, s: Subst): parser::Path {
    if callee.segments.len < 2 { return callee }
    var qual = callee.segments[callee.segments.len - 2].name
    match subst_find_inst(s, qual) {
        (@Type()) as ct => match ct { Named as n => rewrite_iface_segment(callee, n.name); _ => rekey_phantom_qualifier(callee, qual, s) }
        null => rekey_phantom_qualifier(callee, qual, s)
    }
}

fn rekey_phantom_qualifier(callee: parser::Path, qual: str, s: Subst): parser::Path {
    var concrete = subst_instance_name(qual, s)
    if teko::runtime::str_eq(concrete, qual) { return callee }
    rewrite_iface_segment(callee, concrete)
}

fn is_floor_intrinsic_template(f: TFunction): bool {
    if !teko::runtime::str_eq(f.namespace, "teko::base") { return false }
    teko::runtime::str_eq(f.name, "sizeof") || teko::runtime::str_eq(f.name, "alignof")
}

fn find_generic_fn(items: []@TItem(), name: str): TFunction | null {
    var i = 0
    loop {
        if i >= items.len { break }
        match items[i] {
            TFunction as f => {
                if f.type_params.len > 0 && !is_floor_intrinsic_template(f) {
                    if teko::runtime::str_eq(f.name, name) { return f }
                }
            }
            _ => { }
        }
        i++
    }
    null
}

fn iface_method_slot(iface: str, method: str, table: TypeTable): u32 | null {
    var no_methods: []parser::Function = []
    var eff = match iface_methods_by_name(iface, table) { []parser::Function as f => f; error => no_methods }
    var i: u64 = 0
    loop {
        if i >= eff.len { break }
        if teko::runtime::str_eq(eff[i].name, method) { return i to u32 }
        i++
    }
    null
}

fn conformed_owner_iface(class_name: str, method: str, table: TypeTable): str | null {
    var i: u64 = 0
    loop {
        if i >= tt_len(table) { break }
        var reg = tt_at(table, i)
        var is_iface = match reg.decl.body { parser::InterfaceBody => true; _ => false }
        if is_iface && type_conforms_to(class_name, name_last_segment(reg.name), table) {
            match iface_method_slot(name_last_segment(reg.name), method, table) {
                u32 => return name_last_segment(reg.name)
                null => { }
            }
        }
        i++
    }
    null
}

fn rewrite_iface_segment(p: parser::Path, iface: str): parser::Path {
    var segs: [p.segments.len]parser::Segment = []
    var i: u64 = 0
    var key_idx = p.segments.len - 2
    loop {
        if i >= p.segments.len { break }
        if i == key_idx { segs[i] = parser::Segment { name = iface } }
        else { segs[i] = p.segments[i] }
        i++
    }
    parser::Path { segments = segs }
}

fn is_struct_named(table: TypeTable, name: str): bool {
    match type_table_find(table, name, "") {
        parser::TypeDecl as td => match td.body { parser::StructBody => true; _ => false }
        error => false
    }
}

fn struct_dispatch_callee(struct_name: str, method: str): parser::Path {
    parser::Path { segments = [parser::Segment { name = struct_name }, parser::Segment { name = method }] }
}

fn rekey_struct_constraint_dispatch(cl: TCall, args: []TExpr, table: TypeTable): TCall {
    if !cl.is_iface_dispatch || cl.callee.segments.len < 2 || args.len == 0 {
        return cl
    }
    var recv = match args[0].type { Named as n => n.name; _ => return cl }
    if !is_struct_named(table, recv) { return cl }
    var method = cl.callee.segments[cl.callee.segments.len - 1].name
    var direct = struct_dispatch_callee(recv, method)
    TCall { overload_suffix = cl.overload_suffix; callee = direct; args = cl.args; call_ns = recv; is_closure_call = false; callee_type = cl.callee_type; is_iface_dispatch = false; iface_slot = 0; type_args = cl.type_args; ret_extra = cl.ret_extra }
}

fn rekey_iface_dispatch(cl: TCall, args: []TExpr, table: TypeTable): TCall {
    var struct_direct = rekey_struct_constraint_dispatch(cl, args, table)
    if !struct_direct.is_iface_dispatch { return struct_direct }
    if !cl.is_iface_dispatch || cl.callee.segments.len < 2 || args.len == 0 {
        return cl
    }
    var recv_class = match args[0].type { Named as n => n.name; _ => return cl }
    var cur_iface = cl.callee.segments[cl.callee.segments.len - 2].name
    if type_conforms_to(recv_class, cur_iface, table) { return cl }
    var method = cl.callee.segments[cl.callee.segments.len - 1].name
    var owner = match conformed_owner_iface(recv_class, method, table) { str as o => o; null => return cl }
    var slot = match iface_method_slot(owner, method, table) { u32 as sv => sv; null => return cl }
    var newcallee = rewrite_iface_segment(cl.callee, owner)
    TCall { overload_suffix = cl.overload_suffix; callee = newcallee; args = cl.args; call_ns = cl.call_ns; is_closure_call = cl.is_closure_call; callee_type = cl.callee_type; is_iface_dispatch = cl.is_iface_dispatch; iface_slot = slot; type_args = cl.type_args; ret_extra = cl.ret_extra }
}

fn fn_sig_type_params(gf: TFunction, ptable: TypeTable, table: TypeTable): []str {
    var acc: []str = []
    var i = 0
    loop {
        if i >= gf.params.len { break }
        if gf.params[i].has_type {
            match resolve_type(gf.params[i].type_ann, ptable, gf.namespace) {
                (@Type()) as pt => acc = collect_sig_type_params(pt, table, acc)
                error => { }
            }
        }
        i++
    }
    collect_sig_type_params(gf.return_type, table, acc)
}

fn mono_call_subst(gf: TFunction, cl: TCall, args: []TExpr, s: Subst, owner_tps: []str, table: TypeTable): Subst | error {
    if cl.type_args.len > 0 {
        var ptable0 = type_param_table(gf.type_params, gf.type_constraints, "", table)
        var inst_tps = fn_sig_type_params(gf, ptable0, table)
        var xs = Subst { params = gf.type_params; names = []; types = [] }
        var xi = 0
        loop {
            if xi >= inst_tps.len { break }
            if xi >= cl.type_args.len { break }
            xs = Subst { params = gf.type_params; names = [..xs.names, inst_tps[xi]]; types = [..xs.types, subst_type(cl.type_args[xi], s)] }
            xi++
        }
        return xs
    }
    var lenient = owner_tps.len > 0
    var all_tps = gf.type_params
    var all_tcs = gf.type_constraints
    var oi = 0
    loop { if oi >= owner_tps.len { break }; all_tps = [..all_tps, owner_tps[oi]]; all_tcs = [..all_tcs, parser::NoConstraint { }]; oi++ }
    var ptable = type_param_table(all_tps, all_tcs, "", table)
    var infs = Subst { params = gf.type_params; names = []; types = [] }
    var gi = 0
    loop {
        if gi >= args.len { break }
        match resolve_type(gf.params[gi].type_ann, ptable, gf.namespace) {
            (@Type()) as pat => match unify(pat, args[gi].type, infs, table) {
                Subst as x => infs = x
                error as er => { if !lenient { return er } }
            }
            error as er => { if !lenient { return er } }
        }
        gi++
    }
    infs
}

fn find_instance_decl(table: TypeTable, name: str): parser::TypeDecl | null {
    match type_table_find(table, name, "") {
        parser::TypeDecl as td => td
        error => null
    }
}

fn mono_free_call_targets(cl: TCall, gf: TFunction): bool {
    if cl.call_ns.len == 0 { return true }
    teko::runtime::str_eq(cl.call_ns, gf.namespace)
}

fn is_generic_instance_method_call(gf: TFunction, call_ns: str, table: TypeTable): bool {
    if gf.type_params.len == 0 { return false }
    var stem = g_instance_base(call_ns)
    if teko::runtime::str_eq(stem, call_ns) { return false }
    if !method_ns_owns_base(gf.namespace, stem) { return false }
    match find_generic_template(table, stem) { TemplateReg => true; null => false }
}

fn compose_method_subst(inst_subst: Subst, msub: Subst): Subst {
    var out = inst_subst
    var i = 0
    loop {
        if i >= msub.names.len { break }
        out = Subst { params = [..out.params, msub.names[i]]; names = [..out.names, msub.names[i]]; types = [..out.types, msub.types[i]] }
        i++
    }
    out
}

fn is_floor_intrinsic_ns(ns: str): bool {
    ns == "teko::__sizeof" || ns == "teko::__alignof"
}

fn mono_texpr(e: TExpr, s: Subst, items: []@TItem(), table: TypeTable): WExpr | error {
    var nt = subst_type(e.type, s)
    match e.kind {
        TNumber => WExpr { expr = TExpr { kind = e.kind; type = nt; line = e.line; col = e.col }; insts = [] }
        TVar => WExpr { expr = TExpr { kind = e.kind; type = nt; line = e.line; col = e.col }; insts = [] }
        TStrLit => WExpr { expr = TExpr { kind = e.kind; type = nt; line = e.line; col = e.col }; insts = [] }
        TByteStrLit => WExpr { expr = TExpr { kind = e.kind; type = nt; line = e.line; col = e.col }; insts = [] }
        TByteLit => WExpr { expr = TExpr { kind = e.kind; type = nt; line = e.line; col = e.col }; insts = [] }
        TCharLit => WExpr { expr = TExpr { kind = e.kind; type = nt; line = e.line; col = e.col }; insts = [] }
        TBoolLit => WExpr { expr = TExpr { kind = e.kind; type = nt; line = e.line; col = e.col }; insts = [] }
        TNullLit => WExpr { expr = TExpr { kind = e.kind; type = nt; line = e.line; col = e.col }; insts = [] }
        TPathExpr => WExpr { expr = TExpr { kind = e.kind; type = nt; line = e.line; col = e.col }; insts = [] }
        TBinary as b => {
            var wl = match mono_texpr(b.left, s, items, table) { WExpr as w => w; error as er => return er }
            var wr = match mono_texpr(b.right, s, items, table) { WExpr as w => w; error as er => return er }
            WExpr { expr = TExpr { kind = TBinary { op = b.op; left = wl.expr; right = wr.expr }; type = nt; line = e.line; col = e.col }; insts = mono_inst_concat(wl.insts, wr.insts) }
        }
        TUnary as u => {
            var wo = match mono_texpr(u.operand, s, items, table) { WExpr as w => w; error as er => return er }
            WExpr { expr = TExpr { kind = TUnary { op = u.op; operand = wo.expr }; type = nt; line = e.line; col = e.col }; insts = wo.insts }
        }
        TCompare as c => {
            var wf = match mono_texpr(c.first, s, items, table) { WExpr as w => w; error as er => return er }
            var acc = wf.insts
            var terms: [c.rest.len]TCmpTerm = []
            var i = 0
            loop {
                if i >= c.rest.len { break }
                var wt = match mono_texpr(c.rest[i].operand, s, items, table) { WExpr as w => w; error as er => return er }
                terms[i] = TCmpTerm { op = c.rest[i].op; operand = wt.expr }
                acc = mono_inst_concat(acc, wt.insts)
                i++
            }
            WExpr { expr = TExpr { kind = TCompare { first = wf.expr; rest = terms }; type = nt; line = e.line; col = e.col }; insts = acc }
        }
        TCall as cl => {
            var acc: []MonoInst = []
            var args: [cl.args.len]TExpr = []
            var i = 0
            loop {
                if i >= cl.args.len { break }
                var wa = match mono_texpr(cl.args[i], s, items, table) { WExpr as w => w; error as er => return er }
                args[i] = wa.expr
                acc = mono_inst_concat(acc, wa.insts)
                i++
            }
            if is_floor_intrinsic_ns(cl.call_ns) {
                var sta: [cl.type_args.len]@Type() = []
                var ti = 0
                loop {
                    if ti >= cl.type_args.len { break }
                    sta[ti] = subst_type(cl.type_args[ti], s)
                    ti++
                }
                var floor = TCall { overload_suffix = cl.overload_suffix; callee = cl.callee; args = args; call_ns = cl.call_ns; is_closure_call = cl.is_closure_call; callee_type = cl.callee_type; is_iface_dispatch = cl.is_iface_dispatch; iface_slot = cl.iface_slot; type_args = sta; ret_extra = cl.ret_extra }
                return WExpr { expr = TExpr { kind = floor; type = nt; line = e.line; col = e.col }; insts = acc }
            }
            var bare = if cl.callee.segments.len == 0 { "" } else { cl.callee.segments[cl.callee.segments.len - 1].name }
            match find_generic_fn(items, bare) {
                TFunction as gf => {
                    if is_generic_instance_method_call(gf, cl.call_ns, table) {
                        var stem = g_instance_base(cl.call_ns)
                        var tpl = match find_generic_template(table, stem) { TemplateReg as tr => tr; null => return error { message = teko::str::concat("internal: monomorph lost the generic template for ", stem) } }
                        var idecl = match find_instance_decl(table, cl.call_ns) { parser::TypeDecl as d => d; null => return error { message = teko::str::concat("internal: monomorph lost the generic instance ", cl.call_ns) } }
                        var msub = match mono_call_subst(gf, cl, args, s, tpl.decl.type_params, table) { Subst as x => x; error as er => return er }
                        var mmangled = mono_mangle_name(bare, gf.type_params, msub)
                        var isub = instance_method_subst_l5(tpl.decl, tpl.namespace, idecl, table)
                        var composed = compose_method_subst(isub, msub)
                        var newcalleeM = rewrite_last_segment(cl.callee, mmangled)
                        var recM = MonoInst { fn_name = bare; mangled = mmangled; s = composed; owner_ns = cl.call_ns }
                        return WExpr { expr = TExpr { kind = TCall { overload_suffix = cl.overload_suffix; callee = newcalleeM; args = args; call_ns = cl.call_ns; is_closure_call = cl.is_closure_call; callee_type = cl.callee_type; is_iface_dispatch = cl.is_iface_dispatch; iface_slot = cl.iface_slot; type_args = cl.type_args; ret_extra = cl.ret_extra }; type = nt; line = e.line; col = e.col }; insts = [..acc, recM] }
                    }
                    if !mono_free_call_targets(cl, gf) {
                        var pt = TCall { overload_suffix = cl.overload_suffix; callee = mono_rekey_callee_qualifier(cl.callee, s); args = args; call_ns = mono_rekey_call_ns(cl.call_ns, s); is_closure_call = cl.is_closure_call; callee_type = cl.callee_type; is_iface_dispatch = cl.is_iface_dispatch; iface_slot = cl.iface_slot; type_args = cl.type_args; ret_extra = cl.ret_extra }
                        return WExpr { expr = TExpr { kind = rekey_iface_dispatch(pt, args, table); type = nt; line = e.line; col = e.col }; insts = acc }
                    }
                    var sub = match mono_call_subst(gf, cl, args, s, [], table) { Subst as x => x; error as er => return er }
                    var mangled = mono_mangle_name(bare, gf.type_params, sub)
                    var newcallee = mono_rekey_callee_qualifier(rewrite_last_segment(cl.callee, mangled), s)
                    var rec = MonoInst { fn_name = bare; mangled = mangled; s = sub; owner_ns = "" }
                    WExpr { expr = TExpr { kind = TCall { overload_suffix = cl.overload_suffix; callee = newcallee; args = args; call_ns = mono_rekey_call_ns(cl.call_ns, s); is_closure_call = cl.is_closure_call; callee_type = cl.callee_type; is_iface_dispatch = cl.is_iface_dispatch; iface_slot = cl.iface_slot; type_args = cl.type_args; ret_extra = cl.ret_extra }; type = nt; line = e.line; col = e.col }; insts = [..acc, rec] }
                }
                null => {
                    var passthrough = TCall { overload_suffix = cl.overload_suffix; callee = mono_rekey_callee_qualifier(cl.callee, s); args = args; call_ns = mono_rekey_call_ns(cl.call_ns, s); is_closure_call = cl.is_closure_call; callee_type = cl.callee_type; is_iface_dispatch = cl.is_iface_dispatch; iface_slot = cl.iface_slot; type_args = cl.type_args; ret_extra = cl.ret_extra }
                    var rekeyed = rekey_iface_dispatch(passthrough, args, table)
                    WExpr { expr = TExpr { kind = rekeyed; type = nt; line = e.line; col = e.col }; insts = acc }
                }
            }
        }
        TIfExpr as f => {
            var wc = match mono_texpr(f.cond, s, items, table) { WExpr as w => w; error as er => return er }
            var wtb = match mono_block(f.then_blk, s, items, table) { WBlock as w => w; error as er => return er }
            var acc = mono_inst_concat(wc.insts, wtb.insts)
            var eb: []@TStatement() = []
            if f.has_else {
                var web = match mono_block(f.else_blk, s, items, table) { WBlock as w => w; error as er => return er }
                eb = web.stmts
                acc = mono_inst_concat(acc, web.insts)
            }
            WExpr { expr = TExpr { kind = TIfExpr { cond = wc.expr; then_blk = wtb.stmts; has_else = f.has_else; else_blk = eb }; type = nt; line = e.line; col = e.col }; insts = acc }
        }
        TMatchExpr as m => {
            var ws = match mono_texpr(m.subject, s, items, table) { WExpr as w => w; error as er => return er }
            var acc = ws.insts
            var arms: [m.arms.len]TArm = []
            var i = 0
            loop {
                if i >= m.arms.len { break }
                var wa = match mono_arm(m.arms[i], s, items, table) { WArm as w => w; error as er => return er }
                arms[i] = wa.arm
                acc = mono_inst_concat(acc, wa.insts)
                i++
            }
            WExpr { expr = TExpr { kind = TMatchExpr { subject = ws.expr; arms = arms }; type = nt; line = e.line; col = e.col }; insts = acc }
        }
        TCast as c => {
            var wi = match mono_texpr(c.expr, s, items, table) { WExpr as w => w; error as er => return er }
            WExpr { expr = TExpr { kind = TCast { expr = wi.expr }; type = nt; line = e.line; col = e.col }; insts = wi.insts }
        }
        TFieldAccess as fa => {
            var wr = match mono_texpr(fa.receiver, s, items, table) { WExpr as w => w; error as er => return er }
            WExpr { expr = TExpr { kind = TFieldAccess { receiver = wr.expr; field = fa.field }; type = nt; line = e.line; col = e.col }; insts = wr.insts }
        }
        TStructInit as si => {
            var acc: []MonoInst = []
            var vals: [si.field_vals.len]TExpr = []
            var i = 0
            loop {
                if i >= si.field_vals.len { break }
                var wv = match mono_texpr(si.field_vals[i], s, items, table) { WExpr as w => w; error as er => return er }
                vals[i] = wv.expr
                acc = mono_inst_concat(acc, wv.insts)
                i++
            }
            WExpr { expr = TExpr { kind = TStructInit { field_names = si.field_names; field_vals = vals }; type = nt; line = e.line; col = e.col }; insts = acc }
        }
        TIndex as ix => {
            var wr = match mono_texpr(ix.receiver, s, items, table) { WExpr as w => w; error as er => return er }
            var wi = match mono_texpr(ix.index, s, items, table) { WExpr as w => w; error as er => return er }
            WExpr { expr = TExpr { kind = TIndex { receiver = wr.expr; index = wi.expr }; type = nt; line = e.line; col = e.col }; insts = mono_inst_concat(wr.insts, wi.insts) }
        }
        TInterp as in => {
            var acc: []MonoInst = []
            var holes: [in.holes.len]TExpr = []
            var spec_n = if in.holes.len < in.specs.len { in.holes.len } else { in.specs.len }
            var specs: [spec_n]TFSpec = []
            var i = 0
            loop {
                if i >= in.holes.len { break }
                var wh = match mono_texpr(in.holes[i], s, items, table) { WExpr as w => w; error as er => return er }
                holes[i] = wh.expr
                acc = mono_inst_concat(acc, wh.insts)
                if i < in.specs.len {
                    var sp = in.specs[i]
                    var lifted_sp = match sp.kind {
                        TFSpecDynamic as fd => {
                            var dyn_args: [fd.args.len]TExpr = []
                            var k = 0
                            loop {
                                if k >= fd.args.len { break }
                                var wa = match mono_texpr(fd.args[k], s, items, table) { WExpr as w => w; error as er => return er }
                                dyn_args[k] = wa.expr
                                acc = mono_inst_concat(acc, wa.insts)
                                k++
                            }
                            TFSpec { kind = TFSpecDynamic { args = dyn_args } }
                        }
                        _ => sp
                    }
                    specs[i] = lifted_sp
                }
                i++
            }
            WExpr { expr = TExpr { kind = TInterp { pieces = in.pieces; holes = holes; specs = specs }; type = nt; line = e.line; col = e.col }; insts = acc }
        }
        TInExpr as n => {
            var wl = match mono_texpr(n.lhs, s, items, table) { WExpr as w => w; error as er => return er }
            var acc = wl.insts
            var elems: [n.elems.len]TExpr = []
            var i = 0
            loop {
                if i >= n.elems.len { break }
                var we = match mono_texpr(n.elems[i], s, items, table) { WExpr as w => w; error as er => return er }
                elems[i] = we.expr
                acc = mono_inst_concat(acc, we.insts)
                i++
            }
            WExpr { expr = TExpr { kind = TInExpr { lhs = wl.expr; elems = elems }; type = nt; line = e.line; col = e.col }; insts = acc }
        }
        TArrayLit as a => {
            var acc: []MonoInst = []
            var elems: [a.elements.len]TArrayElem = []
            var i = 0
            loop {
                if i >= a.elements.len { break }
                var we = match mono_texpr(a.elements[i].expr, s, items, table) { WExpr as w => w; error as er => return er }
                elems[i] = TArrayElem { is_spread = a.elements[i].is_spread; expr = we.expr }
                acc = mono_inst_concat(acc, we.insts)
                i++
            }
            WExpr { expr = TExpr { kind = TArrayLit { elements = elems }; type = nt; line = e.line; col = e.col }; insts = acc }
        }
        TSliceOfLen as sol => {
            var wsz = match mono_texpr(sol.size, s, items, table) { WExpr as w => w; error as er => return er }
            var el = match nt { Slice as sl => sl.element; _ => subst_type(sol.element, s) }
            WExpr { expr = TExpr { kind = TSliceOfLen { size = wsz.expr; element = el }; type = nt; line = e.line; col = e.col }; insts = wsz.insts }
        }
        TZeroOf => WExpr { expr = TExpr { kind = TZeroOf { element = nt }; type = nt; line = e.line; col = e.col }; insts = [] }
        TLambda as lam => {
            var wb = match mono_block(lam.body, s, items, table) { WBlock as w => w; error as er => return er }
            var nps: [lam.params.len]TLambdaParam = []
            var pi = 0
            loop { if pi >= lam.params.len { break }; nps[pi] = TLambdaParam { name = lam.params[pi].name; type = subst_type(lam.params[pi].type, s) }; pi++ }
            var ncaps: [lam.captures.len]TCapture = []
            var ci = 0
            loop { if ci >= lam.captures.len { break }; ncaps[ci] = TCapture { name = lam.captures[ci].name; type = subst_type(lam.captures[ci].type, s); by_ref = lam.captures[ci].by_ref }; ci++ }
            WExpr { expr = TExpr { kind = TLambda { params = nps; body = wb.stmts; captures = ncaps; ret = subst_type(lam.ret, s); lift_id = lam.lift_id }; type = nt; line = e.line; col = e.col }; insts = wb.insts }
        }
        TBorrow as b => {
            var wo = match mono_texpr(b.operand, s, items, table) { WExpr as w => w; error as er => return er }
            WExpr { expr = TExpr { kind = TBorrow { operand = wo.expr }; type = nt; line = e.line; col = e.col }; insts = wo.insts }
        }
        TBlockExpr as b => {
            var wb = match mono_block(b.body, s, items, table) { WBlock as w => w; error as er => return er }
            WExpr { expr = TExpr { kind = TBlockExpr { body = wb.stmts }; type = nt; line = e.line; col = e.col }; insts = wb.insts }
        }
    }
}

fn rewrite_last_segment(p: parser::Path, name: str): parser::Path {
    var segs: [p.segments.len]parser::Segment = []
    var i = 0
    loop {
        if i >= p.segments.len { break }
        if i == p.segments.len - 1 { segs[i] = parser::Segment { name = name } }
        else { segs[i] = p.segments[i] }
        i++
    }
    parser::Path { segments = segs }
}

fn mono_arm(arm: TArm, s: Subst, items: []@TItem(), table: TypeTable): WArm | error {
    var acc: []MonoInst = []
    var guard = arm.guard
    if arm.has_when {
        var wg = match mono_texpr(arm.guard, s, items, table) { WExpr as w => w; error as er => return er }
        guard = wg.expr
        acc = wg.insts
    }
    var wb = match mono_block(arm.body, s, items, table) { WBlock as w => w; error as er => return er }
    acc = mono_inst_concat(acc, wb.insts)
    WArm { arm = TArm { pattern = arm.pattern; has_when = arm.has_when; guard = guard; body = wb.stmts }; insts = acc }
}

fn mono_tstmt(st: @TStatement(), s: Subst, items: []@TItem(), table: TypeTable): WStmt | error {
    match st {
        TBinding as b => {
            var wv = match mono_texpr(b.value, s, items, table) { WExpr as w => w; error as er => return er }
            WStmt { stmt = TBinding { kind = b.kind; target = b.target; bound = subst_type(b.bound, s); value = wv.expr }; insts = wv.insts }
        }
        TAssign as a => {
            var wv = match mono_texpr(a.value, s, items, table) { WExpr as w => w; error as er => return er }
            if parser::assign_has_target(a.kind) {
                var wt = match mono_texpr(a.target, s, items, table) { WExpr as w => w; error as er => return er }
                return WStmt { stmt = TAssign { kind = a.kind; name = a.name; op = a.op; bound = subst_type(a.bound, s); value = wv.expr; deref = a.deref; target = wt.expr }; insts = mono_inst_concat(wv.insts, wt.insts) }
            }
            WStmt { stmt = TAssign { kind = a.kind; name = a.name; op = a.op; bound = subst_type(a.bound, s); value = wv.expr; deref = a.deref; target = a.target }; insts = wv.insts }
        }
        TReturn as r => {
            if r.has_value {
                var wv = match mono_texpr(r.value, s, items, table) { WExpr as w => w; error as er => return er }
                WStmt { stmt = TReturn { has_value = true; value = wv.expr; values = [] }; insts = wv.insts }
            } else {
                WStmt { stmt = st; insts = [] }
            }
        }
        TLoopStmt as l => {
            var wi = match mono_block(l.init, s, items, table) { WBlock as w => w; error as er => return er }
            var wb = match mono_block(l.body, s, items, table) { WBlock as w => w; error as er => return er }
            WStmt { stmt = TLoopStmt { label = l.label; init = wi.stmts; body = wb.stmts }; insts = mono_inst_concat(wi.insts, wb.insts) }
        }
        TBreakStmt => WStmt { stmt = st; insts = [] }
        TContinueStmt => WStmt { stmt = st; insts = [] }
        TExprStmt as es => {
            var wv = match mono_texpr(es.expr, s, items, table) { WExpr as w => w; error as er => return er }
            WStmt { stmt = TExprStmt { expr = wv.expr }; insts = wv.insts }
        }
        TDeferStmt as d => {
            var wb = match mono_block(d.body, s, items, table) { WBlock as w => w; error as er => return er }
            WStmt { stmt = TDeferStmt { body = wb.stmts }; insts = wb.insts }
        }
        TAdoptStmt as a => {
            var wb = match mono_block(a.body, s, items, table) { WBlock as w => w; error as er => return er }
            WStmt { stmt = TAdoptStmt { name = a.name; body = wb.stmts }; insts = wb.insts }
        }
        TBlockStmt as b => {
            var wb = match mono_block(b.body, s, items, table) { WBlock as w => w; error as er => return er }
            WStmt { stmt = TBlockStmt { body = wb.stmts }; insts = wb.insts }
        }
        TSpawn as sp => {
            var wv = match mono_texpr(sp.call, s, items, table) { WExpr as w => w; error as er => return er }
            WStmt { stmt = TSpawn { call = wv.expr; id = sp.id }; insts = wv.insts }
        }
    }
}

fn mono_block(stmts: []@TStatement(), s: Subst, items: []@TItem(), table: TypeTable): WBlock | error {
    var out: [stmts.len]@TStatement() = []
    var acc: []MonoInst = []
    var i = 0
    loop {
        if i >= stmts.len { break }
        var ws = match mono_tstmt(stmts[i], s, items, table) { WStmt as w => w; error as er => return er }
        out[i] = ws.stmt
        acc = mono_inst_concat(acc, ws.insts)
        i++
    }
    WBlock { stmts = out; insts = acc }
}

fn g_instance_base(name: str): str {
    var i: u64 = 0
    loop {
        if i + 5 > name.len { break }
        if name[i] == b'_' && name[i + 1] == b'_' && name[i + 2] == b'g' && name[i + 3] == b'_' && name[i + 4] == b'_' {
            return name.slice_to(i)
        }
        i++
    }
    name
}

fn method_ns_owns_base(method_ns: str, stem: str): bool {
    teko::runtime::str_eq(name_last_segment(method_ns), stem)
}

fn find_template_method(items: []@TItem(), stem: str, method: str): TFunction | null {
    var i = 0
    loop {
        if i >= items.len { break }
        match items[i] {
            TFunction as f => {
                if teko::runtime::str_eq(f.name, method) && method_ns_owns_base(f.namespace, stem) && !f.is_extern {
                    return f
                }
            }
            _ => { }
        }
        i++
    }
    null
}

fn find_template_method_in_ns(items: []@TItem(), owner_ns: str, method: str): TFunction | null {
    var i = 0
    loop {
        if i >= items.len { break }
        match items[i] {
            TFunction as f => {
                if teko::runtime::str_eq(f.name, method) && teko::runtime::str_eq(f.namespace, owner_ns) && !f.is_extern {
                    return f
                }
            }
            _ => { }
        }
        i++
    }
    null
}

fn instance_type_subst(template: parser::TypeDecl, inst: parser::TypeDecl, table: TypeTable): Subst {
    var s = Subst { params = template.type_params; names = []; types = [] }
    var tf = decl_fields(template)
    var inf = decl_fields(inst)
    if tf.len != inf.len { return s }
    var visited: []str = [inst.name]
    var i = 0
    loop {
        if i >= tf.len { break }
        s = unify_inst_field(tf[i].type_ann, inf[i].type_ann, template.type_params, s, table, visited)
        i++
    }
    s
}

fn inst_texpr_is_null(te: @TypeExpr()): bool {
    match te {
        parser::NamedType as nt => nt.args.len == 0 && nt.path.segments.len == 1 && teko::runtime::str_eq(nt.path.segments[0].name, "null")
        _ => false
    }
}

fn unify_inst_union(put: parser::UnionType, cut: parser::UnionType, params: []str, s: Subst, table: TypeTable, visited: []str): Subst {
    var ss = s
    var pi = 0
    loop {
        if pi >= put.members.len { break }
        if inst_texpr_is_null(put.members[pi]) { pi++; continue }
        var ci = 0
        var matched = false
        loop {
            if ci >= cut.members.len { break }
            if !inst_texpr_is_null(cut.members[ci]) && !matched {
                ss = unify_inst_field(put.members[pi], cut.members[ci], params, ss, table, visited)
                matched = true
            }
            ci++
        }
        pi++
    }
    ss
}

fn unify_inst_named(pnt: parser::NamedType, cnt: parser::NamedType, params: []str, s: Subst, table: TypeTable, visited: []str): Subst {
    if pnt.args.len == 0 { return s }
    if cnt.args.len == pnt.args.len {
        var ss = s
        var i = 0
        loop {
            if i >= pnt.args.len { break }
            ss = unify_inst_field(pnt.args[i], cnt.args[i], params, ss, table, visited)
            i++
        }
        return ss
    }
    if cnt.args.len != 0 { return s }
    var cname = cnt.path.segments[cnt.path.segments.len - 1].name
    var cargs = inst_recovered_args(cname, table, visited)
    if cargs.len != pnt.args.len { return s }
    var ss = s
    var i = 0
    loop {
        if i >= pnt.args.len { break }
        ss = unify_inst_field(pnt.args[i], type_to_texpr(cargs[i]), params, ss, table, visited)
        i++
    }
    ss
}

fn unify_inst_field(pat: @TypeExpr(), con: @TypeExpr(), params: []str, s: Subst, table: TypeTable, visited: []str): Subst {
    match pat {
        parser::NamedType as pnt => {
            if pnt.path.segments.len == 1 && pnt.args.len == 0 && is_type_param(pnt.path.segments[0].name, params) {
                var nm = pnt.path.segments[0].name
                match subst_find_inst(s, nm) { (@Type()) as _bound => return s; null => { } }
                match resolve_type(con, table, "") {
                    (@Type()) as ct => return Subst { params = s.params; names = [..s.names, nm]; types = [..s.types, ct] }
                    error => return s
                }
            }
            match con {
                parser::NamedType as cnt => unify_inst_named(pnt, cnt, params, s, table, visited)
                _ => s
            }
        }
        parser::UnionType as put => match con {
            parser::UnionType as cut => unify_inst_union(put, cut, params, s, table, visited)
            _ => s
        }
        parser::SliceType as pst => match con { parser::SliceType as cst => unify_inst_field(pst.element, cst.element, params, s, table, visited); _ => s }
        parser::SizedArrayType as psa => match con { parser::SizedArrayType as csa => unify_inst_field(psa.element, csa.element, params, s, table, visited); _ => s }
        _ => s
    }
}

fn inst_recovered_args(inst_name: str, table: TypeTable, visited: []str): []@Type() {
    var split = split_generic_instance_name(name_last_segment(inst_name))
    if !split.is_generic { return [] }
    var vi = 0
    loop {
        if vi >= visited.len { break }
        if teko::runtime::str_eq(visited[vi], inst_name) { return [] }
        vi++
    }
    var tmpl = match find_generic_template(table, split.stem) { TemplateReg as tr => tr; null => return [] }
    var idecl = match type_table_find(table, inst_name, "") { parser::TypeDecl as d => d; error => return [] }
    var params = tmpl.decl.type_params
    var tf = decl_fields(tmpl.decl)
    var cf = decl_fields(idecl)
    if tf.len != cf.len { return [] }
    var nvisited = [..visited, inst_name]
    var s = Subst { params = params; names = []; types = [] }
    var i = 0
    loop {
        if i >= tf.len { break }
        s = unify_inst_field(tf[i].type_ann, cf[i].type_ann, params, s, table, nvisited)
        i++
    }
    var out: [params.len]@Type() = []
    var k = 0
    loop {
        if k >= params.len { break }
        out[k] = match subst_find_inst(s, params[k]) { (@Type()) as t => t; null => Named { name = params[k] } }
        k++
    }
    out
}

fn decl_fields(d: parser::TypeDecl): []parser::Field {
    match d.body {
        parser::StructBody as sb => sb.fields
        parser::ClassBody as cb => cb.fields
        _ => []
    }
}

fn mono_decl_methods(d: parser::TypeDecl): []parser::Function {
    match d.body {
        parser::StructBody as sb => sb.methods
        parser::ClassBody as cb => cb.methods
        _ => []
    }
}

fn stamp_one_instance_method(inst_name: str, tmpl: TFunction, s: Subst, items: []@TItem(), table: TypeTable): WFn | error {
    var nparams: [tmpl.params.len]parser::Param = []
    var pi = 0
    loop {
        if pi >= tmpl.params.len { break }
        nparams[pi] = parser::Param { name = tmpl.params[pi].name; has_type = true; type_ann = subst_typeexpr(tmpl.params[pi].type_ann, s); is_params = tmpl.params[pi].is_params; has_default = tmpl.params[pi].has_default; default_expr = tmpl.params[pi].default_expr }
        pi++
    }
    var wb = match mono_block(tmpl.body, s, items, table) { WBlock as w => w; error as e => return e }
    var no_tps: []str = []
    var no_tcs: []@ConstraintExpr() = []
    var sf = TFunction { overload_suffix = ""; name = tmpl.name; type_params = no_tps; type_constraints = no_tcs; params = nparams; return_type = subst_type(tmpl.return_type, s); body = wb.stmts; vis = tmpl.vis; has_doc = tmpl.has_doc; doc = tmpl.doc; namespace = inst_name; file = tmpl.file; line = tmpl.line; col = tmpl.col; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; ret_extra = tmpl.ret_extra; guard = tmpl.guard }
    WFn { func = sf; insts = wb.insts }
}

fn instance_method_subst(template: parser::TypeDecl, template_ns: str, inst: parser::TypeDecl, table: TypeTable): Subst {
    var stem = g_instance_base(inst.name)
    var s = instance_type_subst(template, inst, table)
    var canon = if template_ns == "" { stem } else { teko::str::concat(teko::str::concat(template_ns, "::"), stem) }
    var inst_named = Named { name = inst.name }
    var s1 = subst_add_type_remap(s, canon, inst_named)
    if teko::runtime::str_eq(stem, canon) { return s1 }
    subst_add_type_remap(s1, stem, inst_named)
}

fn subst_add_type_remap(s: Subst, from_name: str, to_type: @Type()): Subst {
    Subst { params = [..s.params, from_name]; names = [..s.names, from_name]; types = [..s.types, to_type] }
}

fn instance_method_subst_l5(template: parser::TypeDecl, template_ns: str, inst: parser::TypeDecl, table: TypeTable): Subst {
    var s = instance_method_subst(template, template_ns, inst, table)
    if template.type_params.len == 0 { return s }
    var stem = g_instance_base(inst.name)
    var phantom = self_inst_spelling(stem, template.type_params)
    if teko::runtime::str_eq(phantom, inst.name) { return s }
    subst_add_type_remap(s, phantom, Named { name = inst.name })
}

fn stamp_instance_methods(inst: parser::TypeDecl, items: []@TItem(), table: TypeTable): WFnList | error {
    var stem = g_instance_base(inst.name)
    var inst_ns = type_ns_of(table, inst.name)
    var template = match find_generic_template_in_ns(table, stem, inst_ns) {
        TemplateReg as tr => tr
        null => match find_generic_template(table, stem) { TemplateReg as tr => tr; null => return WFnList { fns = []; insts = [] } }
    }
    var s = instance_method_subst_l5(template.decl, template.namespace, inst, table)
    var owner_ns = if template.namespace == "" { stem } else { teko::str::concat(teko::str::concat(template.namespace, "::"), stem) }
    var methods = mono_decl_methods(inst)
    var fns: [methods.len]TFunction = []
    var nfns: u64 = 0
    var insts: []MonoInst = []
    var mi = 0
    loop {
        if mi >= methods.len { break }
        var found_tmpl = match find_template_method_in_ns(items, owner_ns, methods[mi].name) {
            TFunction as f => f
            null => find_template_method(items, stem, methods[mi].name)
        }
        match found_tmpl {
            TFunction as tmpl => {
                if tmpl.type_params.len == 0 {
                    var wf = match stamp_one_instance_method(inst.name, tmpl, s, items, table) { WFn as w => w; error as e => return e }
                    fns[nfns] = wf.func
                    nfns++
                    insts = mono_inst_concat(insts, wf.insts)
                }
            }
            null => { }
        }
        mi++
    }
    WFnList { fns = teko::collections::arr_slice(fns, 0, nfns); insts = insts }
}

fn stamp_all_instance_methods(items: []@TItem(), table: TypeTable): WFnList | error {
    var insts2 = table_generic_instances(table)
    var fns: []TFunction = []
    var mono_insts: []MonoInst = []
    var i = 0
    loop {
        if i >= insts2.len { break }
        var wl = match stamp_instance_methods(insts2[i], items, table) { WFnList as w => w; error as e => return e }
        var j = 0
        loop { if j >= wl.fns.len { break }; fns = [..fns, wl.fns[j]]; j++ }
        mono_insts = mono_inst_concat(mono_insts, wl.insts)
        i++
    }
    WFnList { fns = fns; insts = mono_insts }
}

fn check_instance_constraints(table: TypeTable): error | null {
    var insts = table_generic_instances(table)
    var i = 0
    loop {
        if i >= insts.len { break }
        var inst = insts[i]
        var stem = g_instance_base(inst.name)
        match find_generic_template(table, stem) {
            TemplateReg as tr => {
                if tr.decl.type_constraints.len > 0 {
                    var s = instance_type_subst(tr.decl, inst, table)
                    match check_constraints(tr.decl.type_params, tr.decl.type_constraints, s, table) { error as e => return e; null => { } }
                }
            }
            null => { }
        }
        i++
    }
    null
}

pub fn monomorphize(prog: TProgram, table: TypeTable): TProgram | error {
    var any_generic = false
    var g = 0
    loop {
        if g >= prog.items.len { break }
        match prog.items[g] {
            TFunction as f => { if f.type_params.len > 0 { any_generic = true } }
            parser::TypeDecl as d => { if d.type_params.len > 0 { any_generic = true } }
            _ => { }
        }
        g++
    }
    if !any_generic { return prog }

    match check_instance_constraints(table) { error as e => return e; null => { } }

    var empty_s = Subst { params = []; names = []; types = [] }

    var minsts = match stamp_all_instance_methods(prog.items, table) { WFnList as wl => wl; error as e => return e }
    var insts2 = table_generic_instances(table)
    var ceiling = 5000
    var kept: [prog.items.len + minsts.fns.len + (ceiling to u64) + insts2.len]@TItem() = []
    var kn: u64 = 0
    var queue: []MonoInst = []
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            TFunction as f => {
                var is_droppable = f.type_params.len > 0 || is_generic_template_method(f, table)
                if !is_droppable {
                    var wb = match mono_block(f.body, empty_s, prog.items, table) { WBlock as w => w; error as e => return e }
                    var nf = TFunction { overload_suffix = f.overload_suffix; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; return_type = f.return_type; body = wb.stmts; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = f.namespace; file = f.file; line = f.line; col = f.col; is_test = f.is_test; is_extern = f.is_extern; c_symbol = f.c_symbol; from_lib = f.from_lib; ret_extra = f.ret_extra; guard = f.guard }
                    kept[kn] = nf
                    kn++
                    queue = mono_inst_concat(queue, wb.insts)
                }
            }
            (@TStatement()) as ts => {
                var w = match mono_tstmt(ts, empty_s, prog.items, table) { WStmt as x => x; error as e => return e }
                kept[kn] = w.stmt
                kn++
                queue = mono_inst_concat(queue, w.insts)
            }
            parser::TypeDecl as d => {
                if d.type_params.len == 0 { kept[kn] = prog.items[i]; kn++ }
            }
            _ => { kept[kn] = prog.items[i]; kn++ }
        }
        i++
    }

    var mfi: u64 = 0
    loop {
        if mfi >= minsts.fns.len { break }
        kept[kn] = minsts.fns[mfi]
        kn++
        mfi++
    }
    queue = mono_inst_concat(queue, minsts.insts)

    var stamped: []MonoInst = []
    var qi = 0
    loop {
        if qi >= queue.len { break }
        var inst = queue[qi]
        qi++
        if mono_inst_seen(stamped, inst) { continue }
        if stamped.len >= ceiling {
            return error { message = "monomorphization exceeded the instantiation ceiling (5000) — likely unbounded polymorphic recursion" }
        }
        stamped = [..stamped, inst]
        var gf = match find_generic_fn(prog.items, inst.fn_name) {
            TFunction as f => f
            null => return error { message = teko::str::concat("internal: monomorph could not find generic fn ", inst.fn_name) }
        }
        match check_constraints(gf.type_params, gf.type_constraints, inst.s, table) { error as e => return e; null => { } }
        var nparams: [gf.params.len]parser::Param = []
        var pi = 0
        loop {
            if pi >= gf.params.len { break }
            nparams[pi] = parser::Param { name = gf.params[pi].name; has_type = true; type_ann = subst_typeexpr(gf.params[pi].type_ann, inst.s); is_params = gf.params[pi].is_params; has_default = gf.params[pi].has_default; default_expr = gf.params[pi].default_expr }
            pi++
        }
        var wb = match mono_block(gf.body, inst.s, prog.items, table) { WBlock as w => w; error as e => return e }
        queue = mono_inst_concat(queue, wb.insts)
        var no_tps: []str = []
        var no_tcs: []@ConstraintExpr() = []
        var stamp_ns = if inst.owner_ns.len > 0 { inst.owner_ns } else { gf.namespace }
        var sf = TFunction { overload_suffix = ""; name = inst.mangled; type_params = no_tps; type_constraints = no_tcs; params = nparams; return_type = subst_type(gf.return_type, inst.s); body = wb.stmts; vis = gf.vis; has_doc = gf.has_doc; doc = gf.doc; namespace = stamp_ns; file = gf.file; line = gf.line; col = gf.col; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; ret_extra = gf.ret_extra; guard = gf.guard }
        kept[kn] = sf
        kn++
    }

    var ii = 0
    loop {
        if ii >= insts2.len { break }
        var d = insts2[ii]
        ii++
        if mono_kept_has_type(kept, kn, d.name) { continue }
        kept[kn] = d
        kn++
    }

    var out_items: [kn]@TItem() = []
    var oi: u64 = 0
    loop {
        if oi >= kn { break }
        out_items[oi] = kept[oi]
        oi++
    }
    TProgram { items = out_items }
}

fn is_generic_template_method(f: TFunction, table: TypeTable): bool {
    if f.namespace == "" { return false }
    match find_generic_template(table, name_last_segment(f.namespace)) { TemplateReg => true; null => false }
}

fn mono_kept_has_type(kept: []@TItem(), n: u64, name: str): bool {
    var i: u64 = 0
    loop {
        if i >= n { break }
        match kept[i] { parser::TypeDecl as d => { if teko::runtime::str_eq(d.name, name) { return true } }; _ => { } }
        i++
    }
    false
}
