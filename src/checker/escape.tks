
use teko::parser
use teko::lexer

fn str_set_has(set: []str, name: str): bool {
    var i = 0
    loop {
        if i >= set.len { break }
        if set[i] == name { return true }
        i++
    }
    false
}

fn str_set_add(set: []str, name: str): []str {
    if str_set_has(set, name) { return set }
    [..set, name]
}

fn type_is_scalar(t: @Type()): bool {
    match t {
        Prim => true
        Byte => true
        _ => false
    }
}

fn expr_is_bare_var(e: TExpr): bool {
    match e.kind {
        TVar => true
        _ => false
    }
}

fn mark_expr(e: TExpr, escaping: bool, ref acc: []str) {
    match e.kind {
        TVar as v => if escaping { acc = str_set_add(acc.value, v.name) } else { }

        TNumber => { }
        TStrLit => { }
        TByteStrLit => { }
        TByteLit => { }
        TCharLit => { }
        TBoolLit => { }
        TNullLit => { }
        TPathExpr => { }

        TBinary as b => { mark_expr(b.left, escaping, acc); mark_expr(b.right, escaping, acc) }
        TUnary as u => mark_expr(u.operand, escaping, acc)
        TCompare as c => {
            mark_expr(c.first, escaping, acc)
            var i = 0
            loop {
                if i >= c.rest.len { break }
                mark_expr(c.rest[i].operand, escaping, acc)
                i++
            }
        }

        TCall as call => {
            var i = 0
            loop {
                if i >= call.args.len { break }
                mark_expr(call.args[i], true, acc)
                i++
            }
        }

        TIfExpr as f => {
            mark_expr(f.cond, escaping, acc)
            mark_block(f.then_blk, escaping, acc)
            if f.has_else { mark_block(f.else_blk, escaping, acc) }
        }
        TMatchExpr as m => {
            mark_expr(m.subject, escaping, acc)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { mark_expr(m.arms[i].guard, escaping, acc) }
                mark_block(m.arms[i].body, escaping, acc)
                i++
            }
        }

        TCast as ct => mark_expr(ct.expr, escaping, acc)

        TFieldAccess as fa => {
            var refine = type_is_scalar(e.type) && expr_is_bare_var(fa.receiver)
            var recv_ctx = if refine { false } else { escaping }
            mark_expr(fa.receiver, recv_ctx, acc)
        }

        TIndex as ix => {
            mark_expr(ix.receiver, escaping, acc)
            mark_expr(ix.index, escaping, acc)
        }

        TStructInit as si => {
            var i = 0
            loop {
                if i >= si.field_vals.len { break }
                mark_expr(si.field_vals[i], escaping, acc)
                i++
            }
        }
        TArrayLit as al => {
            var i = 0
            loop {
                if i >= al.elements.len { break }
                mark_expr(al.elements[i].expr, escaping, acc)
                i++
            }
        }
        TSliceOfLen as s => mark_expr(s.size, escaping, acc)
        TZeroOf => { }
        TInterp as ip => {
            var i = 0
            loop {
                if i >= ip.holes.len { break }
                mark_expr(ip.holes[i], escaping, acc)
                if i < ip.specs.len {
                    match ip.specs[i].kind {
                        TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; mark_expr(fd.args[k], escaping, acc); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
        }
        TInExpr as ine => {
            mark_expr(ine.lhs, escaping, acc)
            var i = 0
            loop {
                if i >= ine.elems.len { break }
                mark_expr(ine.elems[i], escaping, acc)
                i++
            }
        }
        TLambda as lam => {
            var i = 0
            loop {
                if i >= lam.captures.len { break }
                if escaping { acc = str_set_add(acc.value, lam.captures[i].name) }
                i++
            }
        }

        TBorrow as b => mark_expr(b.operand, escaping, acc)
        TBlockExpr as b => mark_block(b.body, escaping, acc)
    }
}

fn mark_class_holder_escape(elem: TExpr, ref acc: []str) {
    mark_expr(elem, true, acc)
}

fn mark_block(body: []@TStatement(), tail: bool, ref acc: []str) {
    var i = 0
    loop {
        if i >= body.len { break }
        var is_last = i + 1 == body.len
        mark_stmt(body[i], tail && is_last, acc)
        i++
    }
}

fn mark_stmt(s: @TStatement(), tail: bool, ref acc: []str) {
    match s {
        TBinding as b => mark_expr(b.value, true, acc)
        TAssign as a => {
            if assign_is_self_append(a) {
                mark_self_append_items(a, acc)
            } else {
                mark_expr(a.value, true, acc)
                if parser::assign_has_target(a.kind) { mark_expr(a.target, true, acc) }
            }
        }
        TReturn as r => if r.has_value { mark_expr(r.value, true, acc) } else { }
        TExprStmt as es => mark_expr(es.expr, tail, acc)
        TLoopStmt as l => { mark_block(l.init, false, acc); mark_block(l.body, false, acc) }
        TBreakStmt => { }
        TContinueStmt => { }
        TDeferStmt as d => mark_block(d.body, false, acc)
        TAdoptStmt as a => mark_block(a.body, false, acc)
        TBlockStmt as b => mark_block(b.body, false, acc)
        TSpawn as sp => mark_expr(sp.call, false, acc)
    }
}

pub fn fn_escaping_vars(f: TFunction): []str {
    var acc: []str = []
    mark_block(f.body, true, acc)
    acc
}

pub fn fn_frees_old_vars(f: TFunction): []str {
    var acc: []str = []
    collect_frees_old_names(f.body, f.body, acc)
    acc
}

fn collect_frees_old_names(fn_body: []@TStatement(), body: []@TStatement(), ref acc: []str) {
    var i = 0
    loop {
        if i >= body.len { break }
        collect_frees_old_stmt(fn_body, body[i], acc)
        i++
    }
}

fn collect_frees_old_stmt(fn_body: []@TStatement(), s: @TStatement(), ref acc: []str) {
    match s {
        TAssign as a => {
            if (assign_is_self_append(a) || assign_is_self_concat(a)) && !str_set_has(acc.value, a.name) && assign_frees_old(fn_body, a) {
                acc = str_set_add(acc.value, a.name)
            }
        }
        TExprStmt as es => collect_frees_old_expr(fn_body, es.expr, acc)
        TLoopStmt as l => { collect_frees_old_names(fn_body, l.init, acc); collect_frees_old_names(fn_body, l.body, acc) }
        TDeferStmt as d => collect_frees_old_names(fn_body, d.body, acc)
        TAdoptStmt as a => collect_frees_old_names(fn_body, a.body, acc)
        TBlockStmt as b => collect_frees_old_names(fn_body, b.body, acc)
        TBinding => { }
        TReturn => { }
        TBreakStmt => { }
        TContinueStmt => { }
        TSpawn as sp => collect_frees_old_expr(fn_body, sp.call, acc)
    }
}

fn collect_frees_old_expr(fn_body: []@TStatement(), e: TExpr, ref acc: []str) {
    match e.kind {
        TIfExpr as f => {
            collect_frees_old_names(fn_body, f.then_blk, acc)
            if f.has_else { collect_frees_old_names(fn_body, f.else_blk, acc) }
        }
        TMatchExpr as m => {
            var i = 0
            loop { if i >= m.arms.len { break }; collect_frees_old_names(fn_body, m.arms[i].body, acc); i++ }
        }
        _ => { }
    }
}

pub fn binding_is_frame_local(escaping: []str, b: TBinding): bool {
    var name = match b.target {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => return false
    }
    if name == "_" { return false }
    if b.kind == parser::BindKind::Const { return false }
    if str_set_has(escaping, name) { return false }
    true
}

fn tcall_is_list_push(c: TCall): bool {
    var segs = c.callee.segments
    if segs.len < 2 { return false }
    segs[segs.len - 1].name == "push" && segs[segs.len - 2].name == "list"
}

pub fn assign_is_self_append(a: TAssign): bool {
    match a.kind { parser::AssignKind::Simple => { }; _ => return false }
    match a.value.kind {
        TCall as c => {
            if !tcall_is_list_push(c) { return false }
            if c.args.len != 2 { return false }
            match c.args[0].kind {
                TVar as v => v.name == a.name
                _ => false
            }
        }
        TArrayLit as al => {
            if al.elements.len < 1 { return false }
            if !al.elements[0].is_spread { return false }
            match al.elements[0].expr.kind {
                TVar as v => v.name == a.name
                _ => false
            }
        }
        _ => false
    }
}

fn tcall_is_str_concat_callee(c: TCall): bool {
    var segs = c.callee.segments
    if segs.len == 0 { return false }
    var last = segs[segs.len - 1].name
    if last != "concat" && last != "str_concat" { return false }
    if segs.len == 1 { return true }
    segs[0].name == "teko"
}

fn concat_first_arg_is_var(c: TCall, name: str): bool {
    if c.args.len < 1 { return false }
    match c.args[0].kind {
        TVar as v => v.name == name
        TArrayLit as al => {
            if al.elements.len < 1 { return false }
            if al.elements[0].is_spread { return false }
            match al.elements[0].expr.kind {
                TVar as v => v.name == name
                _ => false
            }
        }
        _ => false
    }
}

pub fn assign_is_self_concat(a: TAssign): bool {
    match a.kind { parser::AssignKind::Simple => { }; _ => return false }
    if !is_str_type(a.bound) { return false }
    match a.value.kind {
        TCall as c => tcall_is_str_concat_callee(c) && concat_first_arg_is_var(c, a.name)
        _ => false
    }
}

fn mark_self_append_items(a: TAssign, ref acc: []str) {
    match a.value.kind {
        TCall as c => if c.args.len == 2 { mark_class_holder_escape(c.args[1], acc) } else { }
        TArrayLit as al => {
            var i: u64 = 1
            loop {
                if i >= al.elements.len { break }
                mark_class_holder_escape(al.elements[i].expr, acc)
                i++
            }
        }
        _ => { }
    }
}

pub fn assign_routes_to_frame(escaping: []str, a: TAssign): bool {
    if !assign_is_self_append(a) { return false }
    if str_set_has(escaping, a.name) { return false }
    match a.bound {
        Slice => true
        _ => false
    }
}

type ChainStats = struct { births_empty: i64; births_other: i64; other_writes: i64; self_appends: i64 }

fn cs_zero(): ChainStats { ChainStats { births_empty = 0; births_other = 0; other_writes = 0; self_appends = 0 } }
fn cs_add(a: ChainStats, b: ChainStats): ChainStats {
    ChainStats { births_empty = a.births_empty + b.births_empty; births_other = a.births_other + b.births_other; other_writes = a.other_writes + b.other_writes; self_appends = a.self_appends + b.self_appends }
}

fn binding_value_is_list_empty(b: TBinding): bool {
    match b.value.kind {
        TCall as c => {
            var segs = c.callee.segments
            if segs.len < 2 { return false }
            segs[segs.len - 1].name == "empty" && segs[segs.len - 2].name == "list"
        }
        TArrayLit as al => al.elements.len == 0
        _ => false
    }
}

fn binding_value_is_empty_str(b: TBinding): bool {
    match b.value.kind {
        TStrLit as s => s.text.len == 0
        _ => false
    }
}

fn chain_stats_expr(e: TExpr, name: str): ChainStats {
    match e.kind {
        TIfExpr as f => {
            var s = chain_stats_expr(f.cond, name)
            s = cs_add(s, chain_stats_block(f.then_blk, name))
            if f.has_else { s = cs_add(s, chain_stats_block(f.else_blk, name)) }
            s
        }
        TMatchExpr as m => {
            var s = chain_stats_expr(m.subject, name)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { s = cs_add(s, chain_stats_expr(m.arms[i].guard, name)) }
                s = cs_add(s, chain_stats_block(m.arms[i].body, name))
                i++
            }
            s
        }
        TBinary as b => cs_add(chain_stats_expr(b.left, name), chain_stats_expr(b.right, name))
        TUnary as u => chain_stats_expr(u.operand, name)
        TCompare as c => {
            var s = chain_stats_expr(c.first, name)
            var i = 0
            loop { if i >= c.rest.len { break }; s = cs_add(s, chain_stats_expr(c.rest[i].operand, name)); i++ }
            s
        }
        TCall as call => {
            var s = cs_zero()
            var i = 0
            loop { if i >= call.args.len { break }; s = cs_add(s, chain_stats_expr(call.args[i], name)); i++ }
            s
        }
        TCast as ct => chain_stats_expr(ct.expr, name)
        TFieldAccess as fa => chain_stats_expr(fa.receiver, name)
        TIndex as ix => cs_add(chain_stats_expr(ix.receiver, name), chain_stats_expr(ix.index, name))
        TStructInit as si => {
            var s = cs_zero()
            var i = 0
            loop { if i >= si.field_vals.len { break }; s = cs_add(s, chain_stats_expr(si.field_vals[i], name)); i++ }
            s
        }
        TArrayLit as al => {
            var s = cs_zero()
            var i = 0
            loop { if i >= al.elements.len { break }; s = cs_add(s, chain_stats_expr(al.elements[i].expr, name)); i++ }
            s
        }
        TInterp as ip => {
            var s = cs_zero()
            var i = 0
            loop {
                if i >= ip.holes.len { break }
                s = cs_add(s, chain_stats_expr(ip.holes[i], name))
                if i < ip.specs.len {
                    match ip.specs[i].kind {
                        TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; s = cs_add(s, chain_stats_expr(fd.args[k], name)); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            s
        }
        TInExpr as ine => {
            var s = chain_stats_expr(ine.lhs, name)
            var i = 0
            loop { if i >= ine.elems.len { break }; s = cs_add(s, chain_stats_expr(ine.elems[i], name)); i++ }
            s
        }
        TBlockExpr as b => chain_stats_block(b.body, name)
        _ => cs_zero()
    }
}

fn chain_stats_stmt(s: @TStatement(), name: str): ChainStats {
    match s {
        TBinding as b => {
            var st = chain_stats_expr(b.value, name)
            match b.target {
                parser::SimpleName as sn => {
                    if sn.name == name {
                        if binding_value_is_list_empty(b) || binding_value_is_empty_str(b) { st = cs_add(st, ChainStats { births_empty = 1; births_other = 0; other_writes = 0; self_appends = 0 }) }
                        else { st = cs_add(st, ChainStats { births_empty = 0; births_other = 1; other_writes = 0; self_appends = 0 }) }
                    }
                }
                parser::DestructurePattern => { }
            }
            st
        }
        TAssign as a => {
            var st = chain_stats_expr(a.value, name)
            if parser::assign_has_target(a.kind) { st = cs_add(st, chain_stats_expr(a.target, name)) }
            if a.name == name {
                if assign_is_self_append(a) || assign_is_self_concat(a) { st = cs_add(st, ChainStats { births_empty = 0; births_other = 0; other_writes = 0; self_appends = 1 }) }
                else { st = cs_add(st, ChainStats { births_empty = 0; births_other = 0; other_writes = 1; self_appends = 0 }) }
            }
            st
        }
        TReturn as r => if r.has_value { chain_stats_expr(r.value, name) } else { cs_zero() }
        TExprStmt as es => chain_stats_expr(es.expr, name)
        TLoopStmt as l => cs_add(chain_stats_block(l.init, name), chain_stats_block(l.body, name))
        TBreakStmt => cs_zero()
        TContinueStmt => cs_zero()
        TDeferStmt as d => chain_stats_block(d.body, name)
        TAdoptStmt as a => chain_stats_block(a.body, name)
        TBlockStmt as b => chain_stats_block(b.body, name)
        TSpawn as sp => chain_stats_expr(sp.call, name)
    }
}

fn chain_stats_block(body: []@TStatement(), name: str): ChainStats {
    var s = cs_zero()
    var i: u64 = 0
    loop { if i >= body.len { break }; s = cs_add(s, chain_stats_stmt(body[i], name)); i++ }
    s
}

fn name_escapes_body(fn_body: []@TStatement(), name: str): bool {
    var esc: []str = []
    mark_block(fn_body, true, esc)
    str_set_has(esc, name)
}

pub fn assign_frees_old(fn_body: []@TStatement(), a: TAssign): bool {
    if !assign_is_self_append(a) && !assign_is_self_concat(a) { return false }
    if name_escapes_body(fn_body, a.name) { return false }
    var st = chain_stats_block(fn_body, a.name)
    if st.births_empty != 1 { return false }
    if st.births_other != 0 { return false }
    if st.other_writes != 0 { return false }
    var total = count_reads_block(fn_body, a.name)
    if fn_body.len == 0 { return false }
    var last_reads = count_reads_stmt(fn_body[fn_body.len - 1], a.name)
    var last_st = chain_stats_stmt(fn_body[fn_body.len - 1], a.name)
    if last_st.self_appends > 0 {
        if last_reads != last_st.self_appends { return false }
        return total == st.self_appends
    }
    total - last_reads == st.self_appends
}

fn named_type_is_slice_backed(n: Named, table: TypeTable, visited: []str): bool {
    if str_set_has(visited, n.name) { return false }
    match type_table_find(table, n.name, "") {
        parser::TypeDecl as td => type_decl_is_slice_backed(td, table, str_set_add(visited, n.name))
        error => false
    }
}

fn type_decl_is_slice_backed(td: parser::TypeDecl, table: TypeTable, visited: []str): bool {
    match td.body {
        parser::NewtypeBody as nb => type_expr_is_slice_backed(nb.backing, table, visited, type_ns_of(table, td.name))
        parser::AliasBody as ab => type_expr_is_slice_backed(ab.alias, table, visited, type_ns_of(table, td.name))
        _ => false
    }
}

fn type_expr_is_slice_backed(te: @TypeExpr(), table: TypeTable, visited: []str, owner_ns: str): bool {
    match resolve_type(te, table, owner_ns) {
        (@Type()) as t => bound_type_is_slice_backed(t, table, visited)
        error => false
    }
}

fn bound_type_is_slice_backed(t: @Type(), table: TypeTable, visited: []str): bool {
    match t {
        Slice => true
        Named as n => named_type_is_slice_backed(n, table, visited)
        _ => false
    }
}

pub fn type_is_slice_backed(t: @Type(), table: TypeTable): bool {
    bound_type_is_slice_backed(t, table, [])
}

pub fn binding_is_frame_local_slice(escaping: []str, table: TypeTable, b: TBinding): bool {
    var name = match b.target {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => return false
    }
    if name == "_" { return false }
    if b.kind == parser::BindKind::Const { return false }
    if str_set_has(escaping, name) { return false }
    type_is_slice_backed(b.bound, table)
}

fn count_reads_expr(e: TExpr, name: str): i64 {
    match e.kind {
        TVar as v => if v.name == name { 1 } else { 0 }
        TNumber => 0
        TStrLit => 0
        TByteStrLit => 0
        TByteLit => 0
        TCharLit => 0
        TBoolLit => 0
        TNullLit => 0
        TPathExpr => 0
        TBinary as b => count_reads_expr(b.left, name) + count_reads_expr(b.right, name)
        TUnary as u => count_reads_expr(u.operand, name)
        TCompare as c => {
            var n = count_reads_expr(c.first, name)
            var i = 0
            loop {
                if i >= c.rest.len { break }
                n = n + count_reads_expr(c.rest[i].operand, name)
                i++
            }
            n
        }
        TCall as call => {
            var n: i64 = 0
            var i = 0
            loop {
                if i >= call.args.len { break }
                n = n + count_reads_expr(call.args[i], name)
                i++
            }
            n
        }
        TIfExpr as f => {
            var n = count_reads_expr(f.cond, name)
            n = n + count_reads_block(f.then_blk, name)
            if f.has_else { n = n + count_reads_block(f.else_blk, name) }
            n
        }
        TMatchExpr as m => {
            var n = count_reads_expr(m.subject, name)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { n = n + count_reads_expr(m.arms[i].guard, name) }
                n = n + count_reads_block(m.arms[i].body, name)
                i++
            }
            n
        }
        TCast as ct => count_reads_expr(ct.expr, name)
        TFieldAccess as fa => count_reads_expr(fa.receiver, name)
        TIndex as ix => count_reads_expr(ix.receiver, name) + count_reads_expr(ix.index, name)
        TStructInit as si => {
            var n: i64 = 0
            var i = 0
            loop {
                if i >= si.field_vals.len { break }
                n = n + count_reads_expr(si.field_vals[i], name)
                i++
            }
            n
        }
        TArrayLit as al => {
            var n: i64 = 0
            var i = 0
            loop {
                if i >= al.elements.len { break }
                n = n + count_reads_expr(al.elements[i].expr, name)
                i++
            }
            n
        }
        TSliceOfLen as s => count_reads_expr(s.size, name)
        TZeroOf => 0
        TInterp as ip => {
            var n: i64 = 0
            var i = 0
            loop {
                if i >= ip.holes.len { break }
                n = n + count_reads_expr(ip.holes[i], name)
                if i < ip.specs.len {
                    match ip.specs[i].kind {
                        TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; n = n + count_reads_expr(fd.args[k], name); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            n
        }
        TInExpr as ine => {
            var n = count_reads_expr(ine.lhs, name)
            var i = 0
            loop {
                if i >= ine.elems.len { break }
                n = n + count_reads_expr(ine.elems[i], name)
                i++
            }
            n
        }
        TLambda as lam => {
            var i = 0
            loop { if i >= lam.captures.len { break }; if lam.captures[i].name == name { return 1 }; i++ }
            0
        }
        TBorrow as b => count_reads_expr(b.operand, name)
        TBlockExpr as b => count_reads_block(b.body, name)
    }
}

fn count_reads_stmt(s: @TStatement(), name: str): i64 {
    match s {
        TBinding as b => count_reads_expr(b.value, name)
        TAssign as a => count_reads_expr(a.value, name) + (if parser::assign_has_target(a.kind) { count_reads_expr(a.target, name) } else { 0 })
        TReturn as r => if r.has_value { count_reads_expr(r.value, name) } else { 0 }
        TExprStmt as es => count_reads_expr(es.expr, name)
        TLoopStmt as l => count_reads_block(l.init, name) + count_reads_block(l.body, name)
        TBreakStmt => 0
        TContinueStmt => 0
        TDeferStmt as d => count_reads_block(d.body, name)
        TAdoptStmt as a => count_reads_block(a.body, name)
        TBlockStmt as b => count_reads_block(b.body, name)
        TSpawn as sp => count_reads_expr(sp.call, name)
    }
}

fn count_reads_block(body: []@TStatement(), name: str): i64 {
    var n: i64 = 0
    var i = 0
    loop {
        if i >= body.len { break }
        n = n + count_reads_stmt(body[i], name)
        i++
    }
    n
}

fn count_block_local_reads(body: []@TStatement(), name: str, is_value: bool): i64 {
    var n: i64 = 0
    var i = 0
    loop {
        if i >= body.len { break }
        var is_last = i + 1 == body.len
        match body[i] {
            TAssign as a => {
                if a.name == name && (assign_is_self_append(a) || assign_is_self_concat(a)) { n = n + count_reads_expr(a.value, name) }
            }
            TExprStmt as es => {
                if is_value && is_last { } else { n = n + count_reads_expr(es.expr, name) }
            }
            _ => { n = n + count_reads_stmt(body[i], name) }
        }
        i++
    }
    n
}

pub fn binding_is_block_local(escaping: []str, fn_body: []@TStatement(), block_body: []@TStatement(), is_value: bool, b: TBinding): bool {
    if !binding_is_frame_local(escaping, b) { return false }
    var name = match b.target {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => return false
    }
    var total = count_reads_block(fn_body, name)
    var inside = count_block_local_reads(block_body, name, is_value)
    total == inside
}
