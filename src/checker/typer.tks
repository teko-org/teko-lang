
use teko::lexer
use teko::parser

fn type_number(n: parser::Number): TExpr {
    var k = if n.is_float { PrimKind::F64 } else { PrimKind::I64 }
    TExpr { kind = TNumber { is_float = n.is_float; value = n.value; fval = n.fval }; type = Prim { kind = k }; line = 0; col = 0 }
}
fn type_strlit(s: parser::StrLit): TExpr {
    TExpr { kind = TStrLit { text = s.text }; type = Named { name = "teko::base::str" }; line = 0; col = 0 }
}
fn type_bytestrlit(s: parser::ByteStrLit): TExpr {
    TExpr { kind = TByteStrLit { text = s.text }; type = Slice { element = Byte { } }; line = 0; col = 0 }
}
fn type_bytelit(b: parser::ByteLit): TExpr {
    TExpr { kind = TByteLit { value = b.value }; type = Byte { }; line = 0; col = 0 }
}

fn type_charlit(c: parser::CharLit): TExpr {
    TExpr { kind = TCharLit { bytes = c.bytes }; type = Char { }; line = 0; col = 0 }
}
fn type_boollit(b: parser::BoolLit): TExpr {
    TExpr { kind = TBoolLit { value = b.value }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}
fn type_nulllit(n: parser::NullLit): TExpr | error {
    TExpr { kind = TNullLit { }; type = Null { }; line = 0; col = 0 }
}
fn type_var(v: parser::Var, env: Env): TExpr | error {
    var b = match lookup_binding(env, v.name) { ValBinding as bb => bb; error as e => return e }
    var is_fn = b.ns.len > 0 && (match b.type { Func => true; _ => false })
    TExpr { kind = TVar { name = v.name; is_func = is_fn; func_ns = b.ns }; type = b.type; line = 0; col = 0 }
}

fn lam_collect_block(stmts: []@Statement(), ref refs: []str, ref bound: []str, ref writes: []str) {
    var i = 0
    loop { if i >= stmts.len { break }; lam_collect_stmt(stmts[i], refs, bound, writes); i++ }
}
fn lam_collect_stmt(s: @Statement(), ref refs: []str, ref bound: []str, ref writes: []str) {
    match s {
        parser::Binding as b => {
            lam_collect_expr(b.value, refs, bound, writes)
            match b.target {
                parser::SimpleName as sn => bound = str_set_add(bound.value, sn.name)
                parser::DestructurePattern as dp => { var j = 0; loop { if j >= dp.names.len { break }; bound = str_set_add(bound.value, dp.names[j]); j++ } }
            }
        }
        parser::Assign as a => {
            lam_collect_expr(a.value, refs, bound, writes)
            if parser::assign_has_target(a.kind) {
                lam_collect_expr(a.target, refs, bound, writes)
            } else {
                refs = str_set_add(refs.value, a.name)
                writes = str_set_add(writes.value, a.name)
            }
        }
        parser::Return as r => if r.has_value { lam_collect_expr(r.value, refs, bound, writes) } else { }
        parser::LoopStmt as l => { lam_collect_block(l.init, refs, bound, writes); lam_collect_block(l.body, refs, bound, writes) }
        parser::ExprStmt as es => lam_collect_expr(es.expr, refs, bound, writes)
        parser::DeferStmt as d => lam_collect_block(d.body, refs, bound, writes)
        parser::AdoptStmt as a => lam_collect_block(a.body, refs, bound, writes)
        parser::BlockStmt as b => lam_collect_block(b.body, refs, bound, writes)
        parser::BreakStmt => { }
        parser::ContinueStmt => { }
        parser::MultiBind as mb => {
            var vi = 0
            loop {
                if vi >= mb.values.len { break }
                lam_collect_expr(mb.values[vi], refs, bound, writes)
                vi++
            }
            var ti = 0
            loop {
                if ti >= mb.targets.len { break }
                match mb.targets[ti] {
                    parser::BindName as bn => bound = str_set_add(bound.value, bn.name)
                    parser::BindSkip => { }
                    parser::BindRest => { }
                }
                ti++
            }
        }
        parser::LoweringFrag => { }
        parser::Spawn as sp => lam_collect_expr(sp.call, refs, bound, writes)
    }
}
fn lam_collect_expr(e: parser::Expr, ref refs: []str, ref bound: []str, ref writes: []str) {
    match e.kind {
        parser::Var as v => refs = str_set_add(refs.value, v.name)
        parser::Binary as b => { lam_collect_expr(b.left, refs, bound, writes); lam_collect_expr(b.right, refs, bound, writes) }
        parser::Unary as u => lam_collect_expr(u.operand, refs, bound, writes)
        parser::Compare as c => { lam_collect_expr(c.first, refs, bound, writes); var i = 0; loop { if i >= c.rest.len { break }; lam_collect_expr(c.rest[i].operand, refs, bound, writes); i++ } }
        parser::Call as cl => { if cl.callee.segments.len == 1 { refs = str_set_add(refs.value, cl.callee.segments[0].name) }; var i = 0; loop { if i >= cl.args.len { break }; lam_collect_expr(cl.args[i], refs, bound, writes); i++ } }
        parser::IfExpr as f => { lam_collect_expr(f.cond, refs, bound, writes); lam_collect_block(f.then_blk, refs, bound, writes); if f.has_else { lam_collect_block(f.else_blk, refs, bound, writes) } }
        parser::MatchExpr as m => { lam_collect_expr(m.subject, refs, bound, writes); var i = 0; loop { if i >= m.arms.len { break }; lam_collect_block(m.arms[i].body, refs, bound, writes); i++ } }
        parser::FieldAccess as fa => lam_collect_expr(fa.receiver, refs, bound, writes)
        parser::Cast as ct => lam_collect_expr(ct.expr, refs, bound, writes)
        parser::Borrow as b => lam_collect_expr(b.operand, refs, bound, writes)
        parser::MethodCall as mc => { lam_collect_expr(mc.receiver, refs, bound, writes); var i = 0; loop { if i >= mc.args.len { break }; lam_collect_expr(mc.args[i], refs, bound, writes); i++ } }
        parser::StructLit as sl => { var i = 0; loop { if i >= sl.field_vals.len { break }; lam_collect_expr(sl.field_vals[i], refs, bound, writes); i++ } }
        parser::Index as ix => { lam_collect_expr(ix.receiver, refs, bound, writes); lam_collect_expr(ix.index, refs, bound, writes) }
        parser::Interp as in => { var i = 0; loop { if i >= in.holes.len { break }; lam_collect_expr(in.holes[i], refs, bound, writes); i++ } }
        parser::InExpr as n => { lam_collect_expr(n.lhs, refs, bound, writes); var i = 0; loop { if i >= n.elems.len { break }; lam_collect_expr(n.elems[i], refs, bound, writes); i++ } }
        parser::ArrayLit as a => { var i = 0; loop { if i >= a.elements.len { break }; lam_collect_expr(a.elements[i].expr, refs, bound, writes); i++ } }
        parser::Lambda as lam => { var i = 0; loop { if i >= lam.params.len { break }; bound = str_set_add(bound.value, lam.params[i].name); i++ }; lam_collect_block(lam.body, refs, bound, writes) }
        parser::Block as blk => lam_collect_block(blk.body, refs, bound, writes)
        parser::MacroCall as mc => { var i = 0; loop { if i >= mc.args.len { break }; lam_collect_expr(mc.args[i], refs, bound, writes); i++ } }
        parser::Number => { }
        parser::StrLit => { }
        parser::ByteStrLit => { }
        parser::ByteLit => { }
        parser::CharLit => { }
        parser::BoolLit => { }
        parser::NullLit => { }
        parser::PathExpr => { }
    }
}

fn lam_param_type(p: parser::LambdaParam, idx: u64, exp_params: []@Type(), table: TypeTable, ref_ns: str): @Type() | error {
    if p.has_type { return resolve_type(p.type_ann, table, ref_ns) }
    if idx < exp_params.len { return exp_params[idx] }
    error { message = $"cannot infer the type of closure parameter `{p.name}` — annotate it (`{p.name}: T`) or give the closure a target type" }
}
fn lam_reject_copy_capture_write(writes: []str, bound: []str, env: Env): null | error {
    var i: u64 = 0
    loop {
        if i >= writes.len { break }
        var nm = writes[i]
        if !str_set_has(bound, nm) {
            match lookup_binding(env, nm) {
                ValBinding as b => {
                    var by_ref = match b.type { Reference => true; _ => false }
                    if b.ns.len == 0 && !by_ref {
                        return error { message = $"a lambda cannot assign to the captured variable `{nm}` — the capture is by COPY, so the write would be lost; take it as a `ref` parameter instead" }
                    }
                }
                error => { }
            }
        }
        i++
    }
    null
}

fn type_lambda(lam: parser::Lambda, expected: @Type(), env: Env, table: TypeTable): TExpr | error {
    var exp_params: []@Type() = []
    match expected { Func as ef => exp_params = ef.params; _ => { } }
    var tparams: [lam.params.len]TLambdaParam = []
    var cenv = env
    var i: u64 = 0
    loop {
        if i >= lam.params.len { break }
        var p = lam.params[i]
        var pt = match lam_param_type(p, i, exp_params, table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
        tparams[i] = TLambdaParam { name = p.name; type = pt }
        cenv = define(cenv, p.name, pt, false)
        i++
    }
    var tb = match type_block(lam.body, cenv, table) { TypedBlock as bk => bk; error as e => return e }
    var ret = match expected { Func as ef => ef.ret; _ => tblock_type(tb.stmts) }
    var refs: []str = []
    var bnd: []str = []
    var writes: []str = []
    var j = 0
    loop { if j >= lam.params.len { break }; bnd = str_set_add(bnd, lam.params[j].name); j++ }
    lam_collect_block(lam.body, refs, bnd, writes)
    match lam_reject_copy_capture_write(writes, bnd, env) { error as e => return e; null => { } }
    var captures: []TCapture = []
    var k = 0
    loop {
        if k >= refs.len { break }
        var nm = refs[k]
        if !str_set_has(bnd, nm) {
            match lookup_binding(env, nm) {
                ValBinding as b => {
                    if b.ns.len == 0 {
                        var by_ref = match b.type { Reference => true; _ => false }
                        captures = [..captures, TCapture { name = nm; type = b.type; by_ref = by_ref }]
                    }
                }
                error => { }
            }
        }
        k++
    }
    TExpr { kind = TLambda { params = tparams; body = tb.stmts; captures = captures; ret = ret; lift_id = 0 }; type = Func { params = lam_param_types(tparams); ret = ret; variadic = false; param_names = []; n_required = (lam_param_types(tparams)).len; defaults = []; ret_extra = [] }; line = 0; col = 0 }
}
fn lam_param_types(ps: []TLambdaParam): []@Type() {
    var out: [ps.len]@Type() = []
    var i = 0
    loop { if i >= ps.len { break }; out[i] = ps[i].type; i++ }
    out
}

fn flatten_tilde_chain(e: parser::Expr, acc: []parser::Expr): []parser::Expr {
    match e.kind {
        parser::Binary as b => {
            if b.op == lexer::TokenKind::Tilde {
                var acc2 = flatten_tilde_chain(b.left, acc)
                return flatten_tilde_chain(b.right, acc2)
            }
            [..acc, e]
        }
        _ => [..acc, e]
    }
}

fn tilde_str_lit_text(e: parser::Expr): str | null {
    match e.kind {
        parser::StrLit as s => s.text
        parser::Interp as it => if it.holes.len == 0 && it.pieces.len == 1 { it.pieces[0] } else { null }
        _ => null
    }
}

fn fold_tilde_pieces(pieces: []parser::Expr): []parser::Expr {
    var out: []parser::Expr = []
    var i: u64 = 0
    loop {
        if i >= pieces.len { break }
        match tilde_str_lit_text(pieces[i]) {
            str as t0 => {
                var merged = t0
                var j = i + 1
                loop {
                    if j >= pieces.len { break }
                    match tilde_str_lit_text(pieces[j]) {
                        str as tj => { merged = teko::string::concat(merged, tj); j++ }
                        null => { break }
                    }
                }
                out = [..out, parser::Expr { kind = parser::StrLit { text = merged }; line = pieces[i].line; col = pieces[i].col }]
                i = j
            }
            null => { out = [..out, pieces[i]]; i++ }
        }
    }
    out
}

fn type_tilde_chain(b: parser::Binary, env: Env, table: TypeTable): TExpr | error {
    var raw = flatten_tilde_chain(parser::Expr { kind = b; line = 0; col = 0 }, [])
    var folded = fold_tilde_pieces(raw)
    if folded.len == 1 { return type_expr(folded[0], env, table) }
    var seg_teko = parser::Segment { name = "teko" }
    var seg_string = parser::Segment { name = "string" }
    var seg_concat = parser::Segment { name = "concat" }
    var segs: []parser::Segment = [seg_teko]
    segs = [..segs, seg_string]
    segs = [..segs, seg_concat]
    var pos_names: []str = []
    var ni: u64 = 0
    loop { if ni >= folded.len { break }; pos_names = [..pos_names, ""]; ni++ }
    var call = parser::Call { callee = parser::Path { segments = segs }; args = folded; arg_names = pos_names; owner_type_args = []; callee_type_args = [] }
    type_call(call, null, env, table)
}
fn deref_ref_value(te: TExpr): TExpr {
    match te.type {
        Reference as rf => TExpr { kind = TFieldAccess { receiver = te; field = "value" }; type = rf.inner; line = te.line; col = te.col }
        _ => te
    }
}

fn bignum_kind(t: @Type()): str {
    match t {
        Named as n => {
            if n.name == "teko::numeric::bigint::BigInt" { return "bigint" }
            if n.name == "teko::numeric::dec::Decimal" { return "dec" }
            ""
        }
        _ => ""
    }
}

fn bignum_named(kind: str): @Type() {
    if kind == "bigint" { return Named { name = "teko::numeric::bigint::BigInt" } }
    Named { name = "teko::numeric::dec::Decimal" }
}

fn bignum_ns(kind: str): str {
    if kind == "bigint" { return "teko::numeric::bigint" }
    "teko::numeric::dec"
}

fn bignum_call(kind: str, fn_name: str, args: []TExpr, ret: @Type()): TExpr {
    var segs: []parser::Segment = [parser::Segment { name = "teko" }]
    segs = [..segs, parser::Segment { name = "numeric" }]
    segs = [..segs, parser::Segment { name = kind }]
    segs = [..segs, parser::Segment { name = fn_name }]
    var callee = parser::Path { segments = segs }
    TExpr { kind = TCall { overload_suffix = ""; callee = callee; args = args; call_ns = bignum_ns(kind); is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = []; ret_extra = [] }; type = ret; line = 0; col = 0 }
}

fn bignum_adopt_operand(e: TExpr, kind: str): TExpr | error {
    if bignum_kind(e.type) == kind { return e }
    if bignum_kind(e.type) != "" { return error { message = "cannot mix `bigint` and `dec` in one operation — convert explicitly" } }
    match e.kind {
        TNumber as n => {
            if n.is_float { return error { message = $"a floating-point literal cannot adopt `{kind}` — write it with a `bi`/`d` suffix or convert explicitly with `{kind}::of(...)`" } }
            if !numint_fits(n.value, PrimKind::I64) { return error { message = $"integer literal is too large to adopt into `{kind}` — write it with a `bi`/`d` suffix" } }
            var lit = TExpr { kind = e.kind; type = Prim { kind = PrimKind::I64 }; line = e.line; col = e.col }
            bignum_call(kind, "of", [lit], bignum_named(kind))
        }
        _ => error { message = $"no implicit conversion to `{kind}` — wrap the operand with `{kind}::of(x)` (no implicit promotion — B.22)" }
    }
}

fn bignum_op_fn(op: lexer::TokenKind, kind: str): str | error {
    if op == lexer::TokenKind::Plus { return "add" }
    if op == lexer::TokenKind::Minus { return "sub" }
    if op == lexer::TokenKind::Star { return "mul" }
    if op == lexer::TokenKind::Slash { return "div" }
    if op == lexer::TokenKind::Percent {
        if kind == "dec" { return error { message = "`%` (modulo) is not defined on `dec` — a decimal has no remainder operator" } }
        return "rem"
    }
    error { message = $"this operator is not defined on `{kind}` — `bigint` supports `+ - * / %`, `dec` supports `+ - * /`, and comparisons (`< > <= >= == !=`)" }
}

fn type_bignum_binop(op: lexer::TokenKind, l: TExpr, r: TExpr, lk: str, rk: str): TExpr | error {
    if lk != "" && rk != "" && lk != rk { return error { message = "cannot mix `bigint` and `dec` in one operation — convert explicitly" } }
    var kind = if lk != "" { lk } else { rk }
    var fn_name = match bignum_op_fn(op, kind) { str as s => s; error as e => return e }
    var la = match bignum_adopt_operand(l, kind) { TExpr as te => te; error as e => return e }
    var ra = match bignum_adopt_operand(r, kind) { TExpr as te => te; error as e => return e }
    bignum_call(kind, fn_name, [la, ra], bignum_named(kind))
}

fn combine_and(acc: TExpr | null, next: TExpr): TExpr {
    match acc {
        TExpr as a => TExpr { kind = TBinary { op = lexer::TokenKind::AndAnd; left = a; right = next }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
        null => next
    }
}

fn type_bignum_compare(first: TExpr, rest: []parser::CmpTerm, env: Env, table: TypeTable, kind: str): TExpr | error {
    var prev = match bignum_adopt_operand(first, kind) { TExpr as te => te; error as e => return e }
    var acc: TExpr | null = null
    var i = 0
    loop {
        if i >= rest.len { break }
        var cur_raw = deref_ref_value(match type_expr(rest[i].operand, env, table) { TExpr as te => te; error as e => return e })
        var cur = match bignum_adopt_operand(cur_raw, kind) { TExpr as te => te; error as e => return e }
        var cmp_call = bignum_call(kind, "cmp", [prev, cur], Prim { kind = PrimKind::I64 })
        var zero = TExpr { kind = TNumber { is_float = false; value = parser::numint_of_u64(0); fval = 0.0 }; type = Prim { kind = PrimKind::I64 }; line = 0; col = 0 }
        var term = TCmpTerm { op = rest[i].op; operand = zero }
        var one_cmp = TExpr { kind = TCompare { first = cmp_call; rest = [term] }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
        acc = combine_and(acc, one_cmp)
        prev = cur
        i = i + 1
    }
    match acc { TExpr as te => te; null => error { message = "a comparison needs at least one operator" } }
}

type BinOperands = struct {
    l: TExpr
    r: TExpr
}

fn adopt_binop_operands(l: TExpr, r: TExpr): BinOperands {
    if type_eq(l.type, r.type) { return BinOperands { l = l; r = r } }
    if literal_adopts(l, r.type) { return BinOperands { l = retype_literal(l, r.type); r = r } }
    if literal_adopts(r, l.type) { return BinOperands { l = l; r = retype_literal(r, l.type) } }
    BinOperands { l = l; r = r }
}

fn err_binop_type_mismatch(msg: str, l: TExpr, r: TExpr): error {
    teko::error::err_typed(error { message = msg }, type_render(l.type), type_render(r.type))
}

fn type_shift_binop(op: lexer::TokenKind, l: TExpr, r: TExpr): TExpr | error {
    if !is_integer(l.type) || !is_integer(r.type) { return error { message = "shift needs integer operands (no float bit-shifts — B.38)" } }
    TExpr { kind = TBinary { op = op; left = l; right = r }; type = l.type; line = 0; col = 0 }
}

fn widen_int_binop(op: lexer::TokenKind, l: TExpr, r: TExpr): TExpr | error {
    var joined = match int_arith_join(prim_kind_of(l.type), prim_kind_of(r.type)) {
        PrimKind as k => k
        error as e => return err_binop_type_mismatch(e.message, l, r)
    }
    var lw = widen_operand(l, joined)
    var rw = widen_operand(r, joined)
    TExpr { kind = TBinary { op = op; left = lw; right = rw }; type = Prim { kind = joined }; line = 0; col = 0 }
}

fn type_arith_binop(op: lexer::TokenKind, l: TExpr, r: TExpr): TExpr | error {
    if !is_numeric(l.type) { return error { message = "arithmetic needs a numeric operand (int or float)" } }
    if type_eq(l.type, r.type) { return TExpr { kind = TBinary { op = op; left = l; right = r }; type = l.type; line = 0; col = 0 } }
    if is_integer(l.type) && is_integer(r.type) { return widen_int_binop(op, l, r) }
    if is_float(l.type) && is_float(r.type) {
        var joined = float_arith_join(prim_kind_of(l.type), prim_kind_of(r.type))
        var lw = widen_operand(l, joined)
        var rw = widen_operand(r, joined)
        return TExpr { kind = TBinary { op = op; left = lw; right = rw }; type = Prim { kind = joined }; line = 0; col = 0 }
    }
    err_binop_type_mismatch("operands must be the same type (no promotion, no mixed int/float — B.22; use `to`)", l, r)
}

fn type_bitwise_binop(op: lexer::TokenKind, l: TExpr, r: TExpr): TExpr | error {
    if !is_integer(l.type) { return error { message = "bitwise/remainder needs an integer (not a float — B.38)" } }
    if type_eq(l.type, r.type) { return TExpr { kind = TBinary { op = op; left = l; right = r }; type = l.type; line = 0; col = 0 } }
    if !is_integer(r.type) { return err_binop_type_mismatch("operands must be the same type (no promotion — B.22)", l, r) }
    widen_int_binop(op, l, r)
}

fn type_logical_binop(op: lexer::TokenKind, l: TExpr, r: TExpr): TExpr | error {
    if !is_bool(l.type) || !is_bool(r.type) { return error { message = "logical `&&`/`||` need bool operands" } }
    TExpr { kind = TBinary { op = op; left = l; right = r }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

type NoOperator = struct { }

fn dunder_of_binop(op: lexer::TokenKind): str {
    if op == lexer::TokenKind::Plus { return "__add" }
    if op == lexer::TokenKind::Minus { return "__sub" }
    if op == lexer::TokenKind::Star { return "__mul" }
    if op == lexer::TokenKind::Slash { return "__div" }
    if op == lexer::TokenKind::Percent { return "__mod" }
    if op == lexer::TokenKind::EqEq { return "__eq" }
    if op == lexer::TokenKind::Ne { return "__ne" }
    if op == lexer::TokenKind::Lt { return "__lt" }
    if op == lexer::TokenKind::Gt { return "__gt" }
    if op == lexer::TokenKind::Le { return "__le" }
    if op == lexer::TokenKind::Ge { return "__ge" }
    if op == lexer::TokenKind::Amp { return "__band" }
    if op == lexer::TokenKind::Pipe { return "__bor" }
    if op == lexer::TokenKind::Caret { return "__bxor" }
    if op == lexer::TokenKind::Shl { return "__shl" }
    if op == lexer::TokenKind::Shr { return "__shr" }
    ""
}

fn value_type_body_methods(body: @TypeBody()): []parser::Function {
    match body {
        parser::NewtypeBody as nb => nb.methods
        parser::EnumBody as eb => eb.methods
        parser::FlagsBody as fb => fb.methods
        _ => []
    }
}

fn type_body_operators(body: @TypeBody()): []parser::Function {
    match body {
        parser::NewtypeBody as nb => operator_members(nb.methods)
        parser::EnumBody as eb => operator_members(eb.methods)
        parser::FlagsBody as fb => operator_members(fb.methods)
        parser::StructBody as sb => operator_members(sb.methods)
        parser::ClassBody as cb => operator_members(cb.methods)
        parser::InterfaceBody as ib => operator_members(ib.methods)
        _ => []
    }
}

fn methods_declare_operator(methods: []parser::Function): bool {
    var i = 0
    loop {
        if i >= methods.len { break }
        if methods[i].is_operator { return true }
        i++
    }
    false
}

fn body_declares_operator(body: @TypeBody()): bool {
    match body {
        parser::NewtypeBody as nb => methods_declare_operator(nb.methods)
        parser::EnumBody as eb => methods_declare_operator(eb.methods)
        parser::FlagsBody as fb => methods_declare_operator(fb.methods)
        parser::StructBody as sb => methods_declare_operator(sb.methods)
        parser::ClassBody as cb => methods_declare_operator(cb.methods)
        parser::InterfaceBody as ib => methods_declare_operator(ib.methods)
        _ => false
    }
}

fn is_value_type_body(body: @TypeBody()): bool {
    match body {
        parser::NewtypeBody => true
        parser::EnumBody => true
        parser::FlagsBody => true
        _ => false
    }
}

fn value_op_owner(t: @Type(), table: TypeTable): str {
    if is_str_type(t) { return "" }
    match t {
        Named as n => match type_table_find(table, n.name, "") {
            parser::TypeDecl as td => match td.body {
                parser::NewtypeBody => n.name
                parser::EnumBody => n.name
                parser::FlagsBody => n.name
                parser::StructBody => if body_declares_operator(td.body) { n.name } else { "" }
                parser::ClassBody => if body_declares_operator(td.body) { n.name } else { "" }
                _ => ""
            }
            error => ""
        }
        _ => ""
    }
}

fn operand_reduced_to_base(e: TExpr, table: TypeTable): TExpr {
    match value_type_base(e.type, table) {
        (@Type()) as bty => TExpr { kind = TCast { expr = e }; type = bty; line = e.line; col = e.col }
        NotValueType => e
    }
}

fn operator_operand_type(te: @TypeExpr(), owner_canonical: str, table: TypeTable): @Type() | error {
    if return_type_is_self(te) { return Named { name = owner_canonical } }
    resolve_type(te, table, name_qualifier(owner_canonical))
}

fn owner_has_matching_operator(owner_canonical: str, dn: str, l: TExpr, r: TExpr, table: TypeTable): bool {
    var methods = match type_table_find(table, owner_canonical, "") {
        parser::TypeDecl as td => type_body_operators(td.body)
        error => []
    }
    var i = 0
    loop {
        if i >= methods.len { break }
        if methods[i].is_operator && methods[i].name == dn && methods[i].params.len == 2 {
            var p0 = match operator_operand_type(methods[i].params[0].type_ann, owner_canonical, table) { (@Type()) as t => t; error => Void { } }
            var p1 = match operator_operand_type(methods[i].params[1].type_ann, owner_canonical, table) { (@Type()) as t => t; error => Void { } }
            if operator_operand_accepts(l, p0, table) && operator_operand_accepts(r, p1, table) { return true }
        }
        i++
    }
    false
}

fn operator_operand_accepts(arg: TExpr, param: @Type(), table: TypeTable): bool {
    if assignable_to(arg.type, param, table) { return true }
    match arg.kind {
        TNumber => is_numeric(param)
        _ => false
    }
}

fn build_operator_call(owner_canonical: str, dn: str, left: parser::Expr, right: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    var callee = method_dispatch_callee(owner_canonical, dn)
    var args: []parser::Expr = [left, right]
    var names: []str = ["", ""]
    type_call(parser::Call { callee = callee; args = args; arg_names = names; owner_type_args = []; callee_type_args = [] }, null, env, table)
}

fn dispatch_binop_operator(dn: str, left: parser::Expr, right: parser::Expr, l: TExpr, r: TExpr, env: Env, table: TypeTable): TExpr | NoOperator | error {
    var lo = value_op_owner(l.type, table)
    if lo != "" && owner_has_matching_operator(lo, dn, l, r, table) {
        match build_operator_call(lo, dn, left, right, env, table) { TExpr as te => return te; error as e => return e }
    }
    var ro = value_op_owner(r.type, table)
    if ro != "" && owner_has_matching_operator(ro, dn, l, r, table) {
        match build_operator_call(ro, dn, left, right, env, table) { TExpr as te => return te; error as e => return e }
    }
    NoOperator { }
}

type ConstraintOp = struct {
    iface: str
    ret: @Type()
}

type NoConstraintOp = struct { }

fn operand_is_type_param(t: @Type(), table: TypeTable): bool {
    var name = match t { Named as n => n.name; _ => return false }
    match type_table_find(table, name, "") {
        parser::TypeDecl as td => is_type_param_decl(td)
        error => false
    }
}

fn constraint_op_owner(t: @Type(), dn: str, table: TypeTable): ConstraintOp | NoConstraintOp {
    var name = match t { Named as n => n.name; _ => return NoConstraintOp { } }
    var decl = match type_table_find(table, name, "") { parser::TypeDecl as td => td; error => return NoConstraintOp { } }
    if !is_type_param_decl(decl) { return NoConstraintOp { } }
    var extends = match decl.body { parser::InterfaceBody as ib => ib.extends; _ => return NoConstraintOp { } }
    var owner = match method_owner_interface(extends, dn, table) { str as o => o; null => return NoConstraintOp { } }
    var ops = match iface_methods_by_name(owner, table) { []parser::Function as f => f; error => return NoConstraintOp { } }
    var k = 0
    loop {
        if k >= ops.len { break }
        if ops[k].is_operator && ops[k].name == dn {
            var rt = match operator_operand_type(ops[k].return_type, name, table) { (@Type()) as ty => ty; error => Prim { kind = PrimKind::Bool } }
            return ConstraintOp { iface = owner; ret = rt }
        }
        k++
    }
    NoConstraintOp { }
}

fn build_constraint_operator_call(dn: str, left: parser::Expr, right: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    var mc = parser::MethodCall { receiver = left; method = dn; args = [right]; arg_names = [""]; type_args = [] }
    type_method_call(mc, env, table)
}

fn dispatch_constraint_binop(dn: str, left: parser::Expr, right: parser::Expr, l: TExpr, r: TExpr, env: Env, table: TypeTable): TExpr | error {
    match constraint_op_owner(l.type, dn, table) {
        ConstraintOp => return build_constraint_operator_call(dn, left, right, env, table)
        NoConstraintOp => { }
    }
    match constraint_op_owner(r.type, dn, table) {
        ConstraintOp => return build_constraint_operator_call(dn, left, right, env, table)
        NoConstraintOp => { }
    }
    var tp = if operand_is_type_param(l.type, table) { type_render(l.type) } else { type_render(r.type) }
    error { message = $"`operator {dn}` is not guaranteed by the constraint on type parameter `{tp}` — constrain it with an interface that declares `operator {dn}` (e.g. `IEq`/`IOrd`)" }
}

fn owner_has_unary_operator(owner_canonical: str, dn: str, o: TExpr, table: TypeTable): bool {
    var methods = match type_table_find(table, owner_canonical, "") {
        parser::TypeDecl as td => type_body_operators(td.body)
        error => []
    }
    var i = 0
    loop {
        if i >= methods.len { break }
        if methods[i].is_operator && methods[i].name == dn && methods[i].params.len == 1 {
            var p0 = match operator_operand_type(methods[i].params[0].type_ann, owner_canonical, table) { (@Type()) as t => t; error => Void { } }
            if assignable_to(o.type, p0, table) { return true }
        }
        i++
    }
    false
}

fn build_unary_operator_call(owner_canonical: str, dn: str, operand: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    var callee = method_dispatch_callee(owner_canonical, dn)
    var args: []parser::Expr = [operand]
    var names: []str = [""]
    type_call(parser::Call { callee = callee; args = args; arg_names = names; owner_type_args = []; callee_type_args = [] }, null, env, table)
}

fn type_binary(b: parser::Binary, env: Env, table: TypeTable): TExpr | error {
    if b.op == lexer::TokenKind::Tilde { return type_tilde_chain(b, env, table) }
    var l0 = deref_ref_value(match type_expr(b.left, env, table) { TExpr as te => te; error as e => return e })
    var r0 = deref_ref_value(match type_expr(b.right, env, table) { TExpr as te => te; error as e => return e })
    if type_is_void(l0.type) || type_is_void(r0.type) { return error { message = "a `void` expression cannot be an operand" } }
    if is_ptr_or_uptr(l0.type) || is_ptr_or_uptr(r0.type) { return ptr_opaque_error() }
    var lk = bignum_kind(l0.type)
    var rk = bignum_kind(r0.type)
    if lk != "" || rk != "" { return type_bignum_binop(b.op, l0, r0, lk, rk) }
    var op_dn = dunder_of_binop(b.op)
    if op_dn != "" && (value_op_owner(l0.type, table) != "" || value_op_owner(r0.type, table) != "") {
        match dispatch_binop_operator(op_dn, b.left, b.right, l0, r0, env, table) {
            TExpr as te => return te
            NoOperator => {
                l0 = operand_reduced_to_base(l0, table)
                r0 = operand_reduced_to_base(r0, table)
            }
            error as e => return e
        }
    } else if op_dn != "" && (operand_is_type_param(l0.type, table) || operand_is_type_param(r0.type, table)) {
        return dispatch_constraint_binop(op_dn, b.left, b.right, l0, r0, env, table)
    }
    var ops = adopt_binop_operands(l0, r0)
    var l = ops.l
    var r = ops.r
    if op_is_arith(b.op) || op_is_arith_bitwise(b.op) {
        match redundant_widen_cast_of(l, r) { TExpr as bad => match explicit_cast_gate(env, bad) { error as ge => return ge; null => { } }; null => { } }
    }
    if op_is_shift(b.op) { return type_shift_binop(b.op, l, r) }
    if op_is_arith(b.op) { return type_arith_binop(b.op, l, r) }
    if op_is_arith_bitwise(b.op) { return type_bitwise_binop(b.op, l, r) }
    if b.op == lexer::TokenKind::AndAnd || b.op == lexer::TokenKind::OrOr { return type_logical_binop(b.op, l, r) }
    error { message = "not a binary operator" }
}

fn type_unary(u: parser::Unary, env: Env, table: TypeTable): TExpr | error {
    var o = deref_ref_value(match type_expr(u.operand, env, table) { TExpr as te => te; error as e => return e })
    if type_is_void(o.type) { return error { message = "a `void` expression cannot be an operand" } }
    if is_ptr_or_uptr(o.type) { return ptr_opaque_error() }
    var uk = bignum_kind(o.type)
    if uk != "" {
        if u.op == lexer::TokenKind::Minus { return bignum_call(uk, "neg", [o], bignum_named(uk)) }
        return error { message = $"unary `!`/`~` is not defined on `{uk}`" }
    }
    if u.op == lexer::TokenKind::Minus {
        if !is_numeric(o.type) { return error { message = "unary `-` needs a numeric operand (int or float)" } }
        return TExpr { kind = TUnary { op = u.op; operand = o }; type = o.type; line = 0; col = 0 }
    }
    if u.op == lexer::TokenKind::Tilde {
        var owner = value_op_owner(o.type, table)
        if owner != "" && owner_has_unary_operator(owner, "__bnot", o, table) {
            return build_unary_operator_call(owner, "__bnot", u.operand, env, table)
        }
        if !is_integer(o.type) { return error { message = "unary `~` needs an integer (not a float — B.38)" } }
        return TExpr { kind = TUnary { op = u.op; operand = o }; type = o.type; line = 0; col = 0 }
    }
    if u.op == lexer::TokenKind::Bang {
        if !is_bool(o.type) { return error { message = "! needs a bool" } }
        return TExpr { kind = TUnary { op = u.op; operand = o }; type = o.type; line = 0; col = 0 }
    }
    error { message = "not a unary operator" }
}

fn compare_has_value_type(c: parser::Compare, env: Env, table: TypeTable): bool {
    if operand_is_value_type(c.first, env, table) { return true }
    var i = 0
    loop {
        if i >= c.rest.len { break }
        if operand_is_value_type(c.rest[i].operand, env, table) { return true }
        i++
    }
    false
}

fn operand_is_value_type(e: parser::Expr, env: Env, table: TypeTable): bool {
    match type_expr(e, env, table) {
        TExpr as te => value_op_owner(te.type, table) != "" || operand_is_type_param(te.type, table)
        error => false
    }
}

fn single_primitive_compare(op: lexer::TokenKind, l: TExpr, r: TExpr): TExpr | error {
    var adopted = adopt_binop_operands(l, r)
    if !is_comparable(adopted.l.type, adopted.r.type) { return error { message = "operands are not comparable" } }
    var term = TCmpTerm { op = op; operand = adopted.r }
    TExpr { kind = TCompare { first = adopted.l; rest = [term] }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

fn compare_value_term(op: lexer::TokenKind, le: parser::Expr, l: TExpr, re: parser::Expr, r: TExpr, env: Env, table: TypeTable): TExpr | error {
    var dn = dunder_of_binop(op)
    match dispatch_binop_operator(dn, le, re, l, r, env, table) {
        TExpr as te => {
            if !is_bool(te.type) { return error { message = $"a comparison `operator {dn}` must return `bool`" } }
            return te
        }
        NoOperator => { }
        error as e => return e
    }
    if operand_is_type_param(l.type, table) || operand_is_type_param(r.type, table) {
        var te = match dispatch_constraint_binop(dn, le, re, l, r, env, table) { TExpr as t => t; error as e => return e }
        if !is_bool(te.type) { return error { message = $"a comparison `operator {dn}` must return `bool`" } }
        return te
    }
    single_primitive_compare(op, operand_reduced_to_base(l, table), operand_reduced_to_base(r, table))
}

fn type_compare_value_chain(c: parser::Compare, env: Env, table: TypeTable): TExpr | error {
    var prev_expr = c.first
    var prev = deref_ref_value(match type_expr(c.first, env, table) { TExpr as te => te; error as e => return e })
    if type_is_void(prev.type) { return error { message = "a `void` expression cannot be an operand" } }
    var acc = prev
    var has_acc = false
    var i = 0
    loop {
        if i >= c.rest.len { break }
        var cur_expr = c.rest[i].operand
        var cur = deref_ref_value(match type_expr(cur_expr, env, table) { TExpr as te => te; error as e => return e })
        if type_is_void(cur.type) { return error { message = "a `void` expression cannot be an operand" } }
        var term = match compare_value_term(c.rest[i].op, prev_expr, prev, cur_expr, cur, env, table) { TExpr as t => t; error as e => return e }
        acc = if !has_acc { term } else { TExpr { kind = TBinary { op = lexer::TokenKind::AndAnd; left = acc; right = term }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 } }
        has_acc = true
        prev_expr = cur_expr
        prev = cur
        i++
    }
    acc
}

fn type_compare(c: parser::Compare, env: Env, table: TypeTable): TExpr | error {
    var first = deref_ref_value(match type_expr(c.first, env, table) { TExpr as te => te; error as e => return e })
    if type_is_void(first.type) { return error { message = "a `void` expression cannot be an operand" } }
    var fk = bignum_kind(first.type)
    if fk != "" { return type_bignum_compare(first, c.rest, env, table, fk) }
    if compare_has_value_type(c, env, table) { return type_compare_value_chain(c, env, table) }
    var prev = first
    var terms: [c.rest.len]TCmpTerm = []
    var i = 0
    loop {
        if i >= c.rest.len { break }
        var raw = deref_ref_value(match type_expr(c.rest[i].operand, env, table) { TExpr as te => te; error as e => return e })
        if type_is_void(raw.type) { return error { message = "a `void` expression cannot be an operand" } }
        var adopted = adopt_binop_operands(prev, raw)
        if i == 0 { first = adopted.l }
        match redundant_widen_cast_of(adopted.l, adopted.r) { TExpr as bad => match explicit_cast_gate(env, bad) { error as ge => return ge; null => { } }; null => { } }
        if !is_comparable(adopted.l.type, adopted.r.type) { return error { message = "operands are not comparable" } }
        var is_variant_member_pair = variant_has_member(adopted.l.type, adopted.r.type) || variant_has_member(adopted.r.type, adopted.l.type)
        if is_variant_member_pair && !op_is_eq_ne(c.rest[i].op) {
            return error { message = "a union compares to one of its own members only with `==`/`!=` (ordering needs an explicit `to`)" }
        }
        terms[i] = TCmpTerm { op = c.rest[i].op; operand = adopted.r }
        prev = adopted.r
        i++
    }
    TExpr { kind = TCompare { first = first; rest = terms }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

type NotListBuiltin = struct { }

type NotZeroBuiltin = struct { }

fn call_is_zero_builtin(callee: parser::Path): bool {
    if callee.segments.len == 1 { return callee.segments[0].name == "zero" }
    if callee.segments.len == 2 { return callee.segments[0].name == "teko" && callee.segments[1].name == "zero" }
    false
}

fn zero_builtin_element(c: parser::Call, expected: @Type() | null, env: Env, table: TypeTable): @Type() | error {
    if c.callee_type_args.len == 1 { return resolve_type(c.callee_type_args[0], table, env.cur_ns) }
    if c.callee_type_args.len == 0 {
        match expected { (@Type()) as e => return e; null => { } }
    }
    error { message = "zero<T>() takes one explicit type argument" }
}

fn type_zero_builtin(c: parser::Call, expected: @Type() | null, env: Env, table: TypeTable): TExpr | NotZeroBuiltin | error {
    if !call_is_zero_builtin(c.callee) { return NotZeroBuiltin { } }
    var elem = match zero_builtin_element(c, expected, env, table) { (@Type()) as t => t; error as e => return e }
    if c.args.len != 0 { return error { message = "zero<T>() takes no arguments" } }
    match elem {
        Reference => return error { message = "a reference has no zero value" }
        Void => return error { message = "zero<void> is invalid — void is not a storable value" }
        _ => { }
    }
    TExpr { kind = TZeroOf { element = elem }; type = elem; line = 0; col = 0 }
}

fn type_of_len_builtin(c: parser::Call, env: Env, table: TypeTable): TExpr | error {
    if c.callee_type_args.len != 1 { return error { message = "teko::list::of_len<T> takes one explicit type argument (the element type)" } }
    if c.args.len != 1 { return error { message = "teko::list::of_len<T> expects one argument (the length, a `u64`)" } }
    var elem = match resolve_type(c.callee_type_args[0], table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
    match elem {
        Reference => return error { message = "a reference cannot be an of_len element" }
        Void => return error { message = "of_len<void> is invalid — void is not a storable element" }
        _ => { }
    }
    var n = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
    if !is_integer(n.type) { return error { message = "teko::list::of_len<T> length must be an integer" } }
    TExpr { kind = TSliceOfLen { size = n; element = elem }; type = Slice { element = elem }; line = 0; col = 0 }
}

fn mem_ptr_element(t: @Type()): @Type() | error {
    match t {
        Ptr as pt => match pt.inner {
            (@Type()) as inner => inner
            null => error { message = "a typed `*T` pointer is required — an opaque `ptr` has no element type" }
        }
        _ => error { message = "a `*T` pointer is required" }
    }
}

fn mem_value_call(callee: parser::Path, args: []TExpr, ret: @Type()): TExpr {
    TExpr { kind = TCall { overload_suffix = ""; callee = callee; args = args; call_ns = ""; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = []; ret_extra = [] }; type = ret; line = 0; col = 0 }
}

fn type_is_region_handle(t: @Type()): bool {
    match t { Ptr => true; _ => false }
}

fn type_mem_place(c: parser::Call, env: Env, table: TypeTable): TExpr | error {
    if c.args.len != 2 { return error { message = "teko::mem::place expects two arguments (the target region and the value to place)" } }
    var region = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
    if !type_is_region_handle(region.type) { return error { message = "teko::mem::place target region must be a `ptr` region handle" } }
    var v = match type_expr(c.args[1], env, table) { TExpr as te => te; error as e => return e }
    if type_is_void(v.type) { return error { message = "teko::mem::place cannot place a `void` expression" } }
    var pargs = [region, v]
    mem_value_call(c.callee, pargs, Ptr { inner = v.type })
}

fn type_mem_read(c: parser::Call, env: Env, table: TypeTable): TExpr | error {
    if c.args.len != 1 { return error { message = "teko::mem::read expects one argument (a `*T` pointer)" } }
    var p = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
    var inner = match mem_ptr_element(p.type) { (@Type()) as t => t; error as e => return error { message = teko::str::concat("teko::mem::read: ", e.message) } }
    var rargs = [p]
    mem_value_call(c.callee, rargs, inner)
}

fn type_mem_write(c: parser::Call, env: Env, table: TypeTable): TExpr | error {
    if c.args.len != 2 { return error { message = "teko::mem::write expects two arguments (a `*T` pointer and the new value)" } }
    var p = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
    var inner = match mem_ptr_element(p.type) { (@Type()) as t => t; error as e => return error { message = teko::str::concat("teko::mem::write: ", e.message) } }
    var x = match type_expr(c.args[1], env, table) { TExpr as te => te; error as e => return e }
    if type_is_void(x.type) { return error { message = "teko::mem::write value cannot be a `void` expression" } }
    if !widens_into(x.type, inner, table) && !literal_adopts(x, inner) { return error { message = "teko::mem::write value type does not match the pointer's element type" } }
    var x_typed = TExpr { kind = x.kind; type = inner; line = x.line; col = x.col }
    var wargs = [p, x_typed]
    mem_value_call(c.callee, wargs, Void { })
}

fn type_list_builtin(c: parser::Call, env: Env, table: TypeTable): TExpr | NotListBuiltin | error {
    if c.callee.segments.len < 2 { return NotListBuiltin { } }
    var last = c.callee.segments[c.callee.segments.len - 1].name
    var prev = c.callee.segments[c.callee.segments.len - 2].name
    var is_mem_value = prev == "mem" && (last == "place" || last == "read" || last == "write")
    if prev != "list" && !is_mem_value { return NotListBuiltin { } }
    var rooted = c.callee.segments.len == 2 || c.callee.segments[0].name == "teko"
    if !rooted { return NotListBuiltin { } }

    if last == "of_len" && prev == "list" {
        match type_of_len_builtin(c, env, table) { TExpr as te => return te; error as e => return e }
    }
    if is_mem_value && last == "place" {
        match type_mem_place(c, env, table) { TExpr as te => return te; error as e => return e }
    }
    if is_mem_value && last == "read" {
        match type_mem_read(c, env, table) { TExpr as te => return te; error as e => return e }
    }
    if is_mem_value && last == "write" {
        match type_mem_write(c, env, table) { TExpr as te => return te; error as e => return e }
    }
    NotListBuiltin { }
}

type NotPtrOp = struct { }

fn ptr_opaque_error(): error {
    error { message = "an opaque `ptr`/`uptr` cannot be an operand" }
}

fn is_ptr_or_uptr(t: @Type()): bool {
    match t { Ptr => true; Uptr => true; _ => false }
}

fn type_ptr_unwrap(c: parser::Call, env: Env, table: TypeTable): TExpr | NotPtrOp | error {
    if c.callee.segments.len != 2 { return NotPtrOp { } }
    var owner = c.callee.segments[0].name
    var last = c.callee.segments[1].name
    if last != "__unwrap" { return NotPtrOp { } }
    if owner != "ptr" && owner != "uptr" { return NotPtrOp { } }
    if c.callee_type_args.len != 1 { return error { message = $"`{owner}::__unwrap<T>` takes exactly one type argument" } }
    if c.args.len != 1 { return error { message = $"`{owner}::__unwrap<T>` expects one argument (an addressable `var` variable)" } }
    var rt = match resolve_type(c.callee_type_args[0], table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
    var a = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
    var is_mut_lvalue = match a.kind {
        TVar as v => match lookup_binding(env, v.name) { ValBinding as vb => vb.is_mut; error => false }
        _ => false
    }
    if !is_mut_lvalue { return error { message = $"`{owner}::__unwrap<T>` requires an addressable `var` variable (a `ref T`) — its address is what the opaque word wraps" } }
    if !type_eq(a.type, rt) { return error { message = $"`{owner}::__unwrap<{type_render(rt)}>` argument must be a `{type_render(rt)}` (got `{type_render(a.type)}`)" } }
    var uargs = [a]
    var xtypes = [rt]
    var restype: @Type() = Ptr { inner = null }
    if owner == "uptr" { restype = Uptr { } }
    TExpr { kind = TCall { overload_suffix = ""; callee = c.callee; args = uargs; call_ns = "teko::__ptr_unwrap"; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = xtypes; ret_extra = [] }; type = restype; line = 0; col = 0 }
}

fn type_ref_word(c: parser::Call, env: Env, table: TypeTable): TExpr | NotPtrOp | error {
    var last = c.callee.segments[c.callee.segments.len - 1].name
    if last != "ref_word" { return NotPtrOp { } }
    match lookup_call(env, c.callee) { (@Type()) as _gt_rw => return NotPtrOp { }; error => { } }
    if !builtin_qualifier_ok(c.callee) { return unresolved_builtin_qualifier_error(c.callee, last) }
    if c.callee_type_args.len != 0 { return error { message = "`ref_word` takes no explicit type arguments" } }
    if c.args.len != 1 { return error { message = "`ref_word` expects one argument (an addressable `var` variable)" } }
    var a = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
    var is_mut_lvalue = match a.kind {
        TVar as v => match lookup_binding(env, v.name) { ValBinding as vb => vb.is_mut; error => false }
        _ => false
    }
    if !is_mut_lvalue { return error { message = "`ref_word` requires an addressable `var` variable — its address is what the opaque word wraps" } }
    var rargs = [a]
    TExpr { kind = TCall { overload_suffix = ""; callee = c.callee; args = rargs; call_ns = "teko::__ref_word"; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = []; ret_extra = [] }; type = Prim { kind = PrimKind::I64 }; line = 0; col = 0 }
}

fn type_ptr_wrap(mc: parser::MethodCall, recv_t: @Type(), env: Env, table: TypeTable): TExpr | NotPtrOp | error {
    if mc.method != "__wrap" { return NotPtrOp { } }
    if !is_ptr_or_uptr(recv_t) { return NotPtrOp { } }
    if mc.type_args.len != 1 { return error { message = "`__wrap<T>` takes exactly one type argument" } }
    if mc.args.len != 0 { return error { message = "`__wrap<T>` takes no value arguments (its receiver is the opaque word)" } }
    var rt = match resolve_type(mc.type_args[0], table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
    match rt {
        Void => return error { message = "`__wrap<void>` is invalid — void is not a value" }
        Reference => return error { message = "`__wrap<T>` cannot recover a reference (a raw address is not a safe ref target, R4)" }
        Variant as v => if variant_has_null_member(Variant { members = v.members }) { return error { message = "`__wrap<T>` cannot recover an absence union `T | null` — the null arm would collide with `__wrap`'s own `null` (address 0)" } }
        _ => { }
    }
    var recv = match type_expr(mc.receiver, env, table) { TExpr as te => te; error as e => return e }
    var members = [rt]
    members = [..members, Error { }]
    members = [..members, Null { }]
    var wargs = [recv]
    var xtypes = [rt]
    var wseg = [parser::Segment { name = "__wrap" }]
    TExpr { kind = TCall { overload_suffix = ""; callee = parser::Path { segments = wseg }; args = wargs; call_ns = "teko::__ptr_wrap"; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = xtypes; ret_extra = [] }; type = Variant { members = union_normalize_null(members) }; line = 0; col = 0 }
}

type NotSvcOp = struct { }

fn expr_is_svc_claim(e: parser::Expr): bool {
    match e.kind {
        parser::Call as c => c.callee.segments.len == 1 && c.callee.segments[0].name == "svc" && c.callee_type_args.len == 1
        _ => false
    }
}

fn svc_escape_error(): error {
    error { message = "a claimed service value is arena-bounded: it may not be stored, passed as an argument, or returned — re-claim it with svc<T>() where needed" }
}

fn svc_guard_arg_list(args: []parser::Expr): error | null {
    var i: u64 = 0
    loop {
        if i >= args.len { break }
        if expr_is_svc_claim(args[i]) { return svc_escape_error() }
        i++
    }
    null
}

type SvcProvider = struct { canon: str; key: str }

fn svc_target_name(c: parser::Call, env: Env, table: TypeTable): str | error {
    var t = match resolve_type(c.callee_type_args[0], table, env.cur_ns) { (@Type()) as ty => ty; error as e => return e }
    match t {
        Named as nm => nm.name
        _ => error { message = "svc<T> requires T to be a nominal `service` or `interface & IService` type" }
    }
}

fn svc_target_is_concrete(tname: str, table: TypeTable): bool {
    match type_table_find(table, tname, "") {
        parser::TypeDecl as td => match td.body { parser::ClassBody as cb => cb.is_service; _ => false }
        error => false
    }
}

fn svc_providers(tname: str, table: TypeTable): []SvcProvider {
    var out: []SvcProvider = []
    var want = name_last_segment(tname)
    var concrete = svc_target_is_concrete(tname, table)
    var i: u64 = 0
    loop {
        if i >= tt_len(table) { break }
        var reg = tt_at(table, i)
        i++
        match reg.decl.body {
            parser::ClassBody as cb => {
                if cb.is_service {
                    var scanon = qualify(reg.namespace, name_last_segment(reg.name))
                    var sbare = name_last_segment(reg.name)
                    var matches = if concrete { sbare == want } else { svc_service_implements(cb, want) }
                    if matches { out = [..out, SvcProvider { canon = scanon; key = sbare }] }
                }
            }
            _ => { }
        }
    }
    out
}

fn svc_service_implements(cb: parser::ClassBody, want: str): bool {
    var j: u64 = 0
    loop {
        if j >= cb.implements.len { break }
        if name_last_segment(cb.implements[j]) == want { return true }
        j++
    }
    false
}

fn svc_ctor_texpr(canon: str, env: Env, table: TypeTable): TExpr | error {
    var bpath = name_to_path(canon)
    var segs = [..bpath.segments, parser::Segment { name = "ctor" }]
    type_call(parser::Call { callee = parser::Path { segments = segs }; args = []; arg_names = []; owner_type_args = []; callee_type_args = [] }, null, env, table)
}

fn svc_str_lit(s: str): TExpr {
    TExpr { kind = TStrLit { text = s }; type = Named { name = "teko::base::str" }; line = 0; col = 0 }
}

fn svc_bool_lit(b: bool): TExpr {
    TExpr { kind = TBoolLit { value = b }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

fn svc_key_eq(key: TExpr, lit: str): TExpr {
    var term = TCmpTerm { op = lexer::TokenKind::EqEq; operand = svc_str_lit(lit) }
    TExpr { kind = TCompare { first = key; rest = [term] }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

fn svc_tail_block(e: TExpr): []@TStatement() {
    [TExprStmt { expr = e }]
}

fn svc_panic_str_suffix(env: Env): str {
    var str_params: []@Type() = [..tempty(), Named { name = "teko::base::str" }]
    var str_sig = Func { params = str_params; ret = Void { }; variadic = false; param_names = []; n_required = 1; defaults = []; ret_extra = [] }
    overload_suffix_of(str_sig, overload_func_bindings(env, "teko::runtime", "panic"))
}

fn svc_panic_block(tname: str, env: Env): []@TStatement() {
    var msg = svc_str_lit($"svc<{name_last_segment(tname)}>: no provider registered for the runtime key")
    var pseg = [parser::Segment { name = "panic" }]
    var pcall = TExpr { kind = TCall { overload_suffix = svc_panic_str_suffix(env); callee = parser::Path { segments = pseg }; args = [msg]; call_ns = "teko::runtime"; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = []; ret_extra = [] }; type = Void { }; line = 0; col = 0 }
    svc_tail_block(pcall)
}

fn svc_runtime_chain(key: TExpr, providers: []SvcProvider, rtype: @Type(), tname: str, env: Env, table: TypeTable): TExpr | error {
    var elseblk = svc_panic_block(tname, env)
    var out: TExpr = svc_bool_lit(false)
    var built = false
    var n = providers.len
    loop {
        if n == 0 { break }
        n--
        var ctor = match svc_ctor_texpr(providers[n].canon, env, table) { TExpr as te => te; error as e => return e }
        var cond = svc_key_eq(key, providers[n].key)
        var ifx = TExpr { kind = TIfExpr { cond = cond; then_blk = svc_tail_block(ctor); has_else = true; else_blk = elseblk }; type = rtype; line = 0; col = 0 }
        elseblk = svc_tail_block(ifx)
        out = ifx
        built = true
    }
    if !built { return error { message = "svc: no provider" } }
    out
}

fn svc_has_runtime_chain(key: TExpr, providers: []SvcProvider): TExpr {
    var out = svc_bool_lit(false)
    var elseblk = svc_tail_block(svc_bool_lit(false))
    var n = providers.len
    loop {
        if n == 0 { break }
        n--
        var cond = svc_key_eq(key, providers[n].key)
        var ifx = TExpr { kind = TIfExpr { cond = cond; then_blk = svc_tail_block(svc_bool_lit(true)); has_else = true; else_blk = elseblk }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
        elseblk = svc_tail_block(ifx)
        out = ifx
    }
    out
}

fn svc_const_key(key: TExpr): str | NotSvcOp {
    match key.kind {
        TStrLit as sl => sl.text
        _ => NotSvcOp { }
    }
}

fn svc_not_iservice_error(tname: str): error {
    error { message = $"svc<T> requires T to satisfy IService — a 'service' type, or an 'interface & IService'; '{name_last_segment(tname)}' does not" }
}

fn type_svc(c: parser::Call, env: Env, table: TypeTable): TExpr | NotSvcOp | error {
    if c.callee.segments.len != 1 { return NotSvcOp { } }
    if c.callee.segments[0].name != "svc" { return NotSvcOp { } }
    if c.callee_type_args.len != 1 { return NotSvcOp { } }
    if c.args.len > 1 { return error { message = "svc<T>(key) takes at most one argument (an optional string key)" } }
    var tname = match svc_target_name(c, env, table) { str as s => s; error as e => return e }
    if !type_satisfies_iservice(tname, table) { return svc_not_iservice_error(tname) }
    var providers = svc_providers(tname, table)
    var concrete = svc_target_is_concrete(tname, table)
    if c.args.len == 0 {
        if !concrete { return error { message = $"svc<{name_last_segment(tname)}>() over an interface needs a key — write svc<{name_last_segment(tname)}>(\"Impl\")" } }
        if providers.len == 0 { return error { message = $"svc<{name_last_segment(tname)}>(): no service provider" } }
        match svc_ctor_texpr(providers[0].canon, env, table) { TExpr as te => return te; error as e => return e }
    }
    var key = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
    if !is_str_type(key.type) { return error { message = "svc<T>(key)'s key must be a `str`" } }
    match svc_const_key(key) {
        str as k => {
            var hit = svc_provider_for_key(providers, k)
            match hit {
                SvcProvider as p => match svc_ctor_texpr(p.canon, env, table) { TExpr as te => return te; error as e => return e }
                NotSvcOp => return error { message = $"svc<{name_last_segment(tname)}>(\"{k}\"): no service provider registered under that key" }
            }
        }
        NotSvcOp => { }
    }
    var rtype: @Type() = Named { name = tname }
    match svc_runtime_chain(key, providers, rtype, tname, env, table) { TExpr as te => return te; error as e => return e }
}

fn svc_provider_for_key(providers: []SvcProvider, k: str): SvcProvider | NotSvcOp {
    var i: u64 = 0
    loop {
        if i >= providers.len { break }
        if providers[i].key == k { return providers[i] }
        i++
    }
    NotSvcOp { }
}

fn type_has_svc(c: parser::Call, env: Env, table: TypeTable): TExpr | NotSvcOp | error {
    if c.callee.segments.len != 1 { return NotSvcOp { } }
    if c.callee.segments[0].name != "has_svc" { return NotSvcOp { } }
    if c.callee_type_args.len != 1 { return NotSvcOp { } }
    if c.args.len != 1 { return error { message = "has_svc<T>(key) requires exactly one argument (the string key)" } }
    var tname = match svc_target_name(c, env, table) { str as s => s; error as e => return e }
    if !type_satisfies_iservice(tname, table) { return svc_not_iservice_error(tname) }
    var providers = svc_providers(tname, table)
    var key = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
    if !is_str_type(key.type) { return error { message = "has_svc<T>(key)'s key must be a `str`" } }
    match svc_const_key(key) {
        str as k => {
            match svc_provider_for_key(providers, k) {
                SvcProvider => return svc_bool_lit(true)
                NotSvcOp => return svc_bool_lit(false)
            }
        }
        NotSvcOp => { }
    }
    svc_has_runtime_chain(key, providers)
}

fn resolve_call_args(f: Func, args: []parser::Expr, arg_names: []str, env: Env, table: TypeTable): []parser::Expr | error {
    if f.variadic { return pack_variadic_args(f, args, arg_names, env, table) }
    resolve_defargs(f, args, arg_names)
}

fn positional_prefix_len(arg_names: []str): u64 {
    var n: u64 = 0
    loop { if n >= arg_names.len { break }; if arg_names[n] != "" { break }; n++ }
    n
}

fn named_arg_expr(pname: str, args: []parser::Expr, arg_names: []str, npos: u64): parser::Expr | null {
    var k: u64 = npos
    loop {
        if k >= args.len { break }
        if arg_names[k] == pname { return args[k] }
        k++
    }
    null
}

fn validate_variadic_named(f: Func, args: []parser::Expr, arg_names: []str, npos: u64, nfixed: u64): error | null {
    var vk: u64 = npos
    loop {
        if vk >= args.len { break }
        var nm = arg_names[vk]
        var fidx: u64 = 0
        var matched = false
        loop { if fidx >= f.param_names.len { break }; if f.param_names[fidx] == nm { matched = true; break }; fidx++ }
        if !matched { return error { message = $"unknown named argument '{nm}'" } }
        if fidx >= nfixed { return error { message = $"the variadic 'params' parameter '{nm}' cannot be passed by name" } }
        if fidx < npos { return error { message = $"named argument '{nm}' was already provided positionally" } }
        vk++
    }
    null
}

fn pack_variadic_args(f: Func, args: []parser::Expr, arg_names: []str, env: Env, table: TypeTable): []parser::Expr | error {
    var nfixed = f.params.len - 1
    var elem_ty = match f.params[nfixed] { Slice as s => s.element; _ => Void { } }
    var npos = positional_prefix_len(arg_names)
    var any_named = npos < args.len
    if !any_named && args.len == f.params.len {
        var last = match type_expr(args[nfixed], env, table) { TExpr as te => te; error as e => return e }
        if type_eq(last.type, Slice { element = elem_ty }) { return args }
    }
    if any_named && npos > nfixed { return error { message = "wrong number of arguments" } }
    match validate_variadic_named(f, args, arg_names, npos, nfixed) { error as e => return e; null => { } }
    var fixed_pos = if npos < nfixed { npos } else { nfixed }
    var out: [nfixed]parser::Expr = []
    var idx: u64 = 0
    loop {
        if idx >= nfixed { break }
        if idx < fixed_pos {
            out[idx] = args[idx]
        } else {
            match named_arg_expr(f.param_names[idx], args, arg_names, npos) {
                parser::Expr as e => out[idx] = e
                null => {
                    if idx < f.n_required { return error { message = $"missing required argument '{f.param_names[idx]}'" } }
                    out[idx] = f.defaults[idx - f.n_required]
                }
            }
        }
        idx++
    }
    var elems: []parser::ArrayElem = []
    var i = fixed_pos
    loop {
        if i >= args.len { break }
        if arg_names[i] != "" { break }
        elems = [..elems, parser::ArrayElem { is_spread = false; expr = args[i] }]
        i++
    }
    var synth = parser::Expr { kind = parser::ArrayLit { elements = elems }; line = 0; col = 0 }
    [..out, synth]
}

fn resolve_defargs(f: Func, args: []parser::Expr, arg_names: []str): []parser::Expr | error {
    var any_named = false
    var ai: u64 = 0
    loop { if ai >= arg_names.len { break }; if arg_names[ai] != "" { any_named = true }; ai++ }
    if !any_named && args.len == f.params.len { return args }
    if any_named && f.param_names.len != f.params.len {
        return error { message = "this function cannot be called with named arguments (only a plain, named `fn` declaration supports named-call — not a closure value or builtin)" }
    }
    var npos: u64 = 0
    loop { if npos >= arg_names.len { break }; if arg_names[npos] != "" { break }; npos++ }
    if npos > f.params.len { return error { message = "wrong number of arguments" } }
    var vk: u64 = npos
    loop {
        if vk >= args.len { break }
        var nm = arg_names[vk]
        var fidx: u64 = 0
        var matched = false
        loop { if fidx >= f.param_names.len { break }; if f.param_names[fidx] == nm { matched = true; break }; fidx++ }
        if !matched { return error { message = $"unknown named argument '{nm}'" } }
        if fidx < npos { return error { message = $"named argument '{nm}' was already provided positionally" } }
        vk++
    }
    var resolved: [f.params.len]parser::Expr = []
    var idx: u64 = 0
    loop {
        if idx >= f.params.len { break }
        if idx < npos {
            resolved[idx] = args[idx]
        } else {
            var found = false
            var found_expr = parser::no_expr()
            var k: u64 = npos
            loop {
                if k >= args.len { break }
                if arg_names[k] == f.param_names[idx] { found = true; found_expr = args[k]; break }
                k++
            }
            if found {
                resolved[idx] = found_expr
            } else if idx < f.n_required {
                return error { message = $"missing required argument '{f.param_names[idx]}'" }
            } else {
                resolved[idx] = f.defaults[idx - f.n_required]
            }
        }
        idx++
    }
    resolved
}

fn flags_named_has_user_method(t: @Type(), name: str, table: TypeTable): bool {
    match t {
        Named as n => match type_table_find(table, n.name, "") {
            parser::TypeDecl as td => match td.body {
                parser::FlagsBody as fb => func_list_has_name(fb.methods, name)
                _ => false
            }
            error => false
        }
        _ => false
    }
}

fn func_list_has_name(fns: []parser::Function, name: str): bool {
    var i = 0
    loop {
        if i >= fns.len { break }
        if fns[i].name == name { return true }
        i++
    }
    false
}

fn type_flags_method(mc: parser::MethodCall, env: Env, table: TypeTable): TExpr | error {
    var recv = match type_expr(mc.receiver, env, table) { TExpr as te => te; error as e => return e }
    var rt = recv.type
    if !is_flags_named(rt, table) { return error { message = "method call on a non-flags receiver (flags methods: has/all/any/none/add/remove)" } }
    if mc.args.len != 1 { return error { message = "flags methods take exactly one argument (the mask)" } }
    var mask = match type_expr(mc.args[0], env, table) { TExpr as te => te; error as e => return e }
    if !type_eq(rt, mask.type) {
        return teko::error::err_typed(error { message = "flags method argument must be the same flags type as the receiver" }, type_render(rt), type_render(mask.type))
    }
    var is_has = mc.method == "has"
    var is_all = mc.method == "all"
    var is_any = mc.method == "any"
    var is_none = mc.method == "none"
    var is_add = mc.method == "add"
    var is_rem = mc.method == "remove"
    if !is_has && !is_all && !is_any && !is_none && !is_add && !is_rem {
        return error { message = "unknown flags method (has/all/any/none/add/remove)" }
    }
    if is_add {
        return TExpr { kind = TBinary { op = lexer::TokenKind::Pipe; left = recv; right = mask }; type = rt; line = 0; col = 0 }
    }
    if is_rem {
        var notmask = TExpr { kind = TUnary { op = lexer::TokenKind::Tilde; operand = mask }; type = rt; line = 0; col = 0 }
        return TExpr { kind = TBinary { op = lexer::TokenKind::Amp; left = recv; right = notmask }; type = rt; line = 0; col = 0 }
    }
    var andexpr = TExpr { kind = TBinary { op = lexer::TokenKind::Amp; left = recv; right = mask }; type = rt; line = 0; col = 0 }
    if is_has || is_all {
        var term = TCmpTerm { op = lexer::TokenKind::EqEq; operand = mask }
        return TExpr { kind = TCompare { first = andexpr; rest = [term] }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
    }
    var zero = TExpr { kind = TNumber { is_float = false; value = parser::numint_of_u64(0); fval = 0.0 }; type = rt; line = 0; col = 0 }
    var cmp_op = if is_none { lexer::TokenKind::EqEq } else { lexer::TokenKind::Ne }
    var term = TCmpTerm { op = cmp_op; operand = zero }
    TExpr { kind = TCompare { first = andexpr; rest = [term] }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

type IfaceDispatch = struct { iface: str; method: parser::Function; slot: u32 }

fn find_method_slot(eff: []parser::Function, method: str): IfaceDispatch | null {
    var i: u64 = 0
    loop {
        if i >= eff.len { break }
        if eff[i].name == method { return IfaceDispatch { iface = ""; method = eff[i]; slot = i to u32 } }
        i++
    }
    null
}

fn resolve_iface_dispatch(ib: parser::InterfaceBody, struct_name: str, method: str, table: TypeTable): IfaceDispatch | error {
    if ib.methods.len > 0 {
        var eff = match iface_methods_by_name(struct_name, table) { []parser::Function as f => f; error as e => return e }
        return match find_method_slot(eff, method) {
            IfaceDispatch as d => IfaceDispatch { iface = struct_name; method = d.method; slot = d.slot }
            null => error { message = $"no such method '{method}' on interface '{struct_name}'" }
        }
    }
    var owner = match method_owner_interface(ib.extends, method, table) {
        str as o => o
        null => return error { message = $"method '{method}' is not guaranteed by the constraint on type parameter '{struct_name}' ({type_param_surface_message(ib.extends, table)})" }
    }
    var eff = match iface_methods_by_name(owner, table) { []parser::Function as f => f; error as e => return e }
    match find_method_slot(eff, method) {
        IfaceDispatch as d => IfaceDispatch { iface = owner; method = d.method; slot = d.slot }
        null => error { message = $"internal: method_owner_interface named '{owner}' as owner of '{method}' but its effective methods do not contain it" }
    }
}

fn type_param_surface_message(extends: []str, table: TypeTable): str {
    var names = ""
    var i = 0
    loop {
        if i >= extends.len { break }
        var ms = match iface_methods_by_name(extends[i], table) { []parser::Function as f => f; error => [] }
        var j = 0
        loop {
            if j >= ms.len { break }
            if names == "" { names = ms[j].name } else { names = $"{names}, {ms[j].name}" }
            j++
        }
        i++
    }
    if names == "" { return "available: none" }
    $"available: {names}"
}

fn is_type_param_decl(decl: parser::TypeDecl): bool {
    decl.type_params.len == 0 && decl.type_constraints.len == 1
}

fn name_is_phantom_instance(name: str, table: TypeTable): bool {
    if !name_is_g_instance(name) { return false }
    var i: u64 = 0
    loop {
        if i >= name.len { break }
        if name[i] == b'_' { i++; continue }
        var j = i
        loop { if j >= name.len { break }; if name[j] == b'_' { break }; j++ }
        var tok = name.slice(i, j)
        match type_table_find(table, tok, "") {
            parser::TypeDecl as td => { if is_type_param_decl(td) { return true } }
            error => { }
        }
        i = j
    }
    false
}

fn type_param_call_error(decl: parser::TypeDecl, table: TypeTable): error | null {
    if !is_type_param_decl(decl) { return null }
    match constraint_interfaces(decl.type_constraints[0], table) {
        []str => null
        error as e => e
    }
}

fn method_dispatch_callee(struct_name: str, method: str): parser::Path {
    parser::Path { segments = [parser::Segment { name = struct_name }, parser::Segment { name = method }] }
}

fn method_call_arg_names(mc: parser::MethodCall): []str {
    ["", ..mc.arg_names]
}

fn expr_roots_at_name(e: parser::Expr, nm: str): bool {
    match e.kind {
        parser::Var as v => v.name == nm
        parser::FieldAccess as fa => expr_roots_at_name(fa.receiver, nm)
        parser::Index as ix => expr_roots_at_name(ix.receiver, nm)
        _ => false
    }
}

fn assign_target_is_self(a: parser::Assign): bool {
    match a.kind {
        parser::AssignKind::Simple => a.name == "self"
        parser::AssignKind::RefDeref => a.name == "self"
        parser::AssignKind::Field => expr_roots_at_name(a.target, "self")
        parser::AssignKind::Index => expr_roots_at_name(a.target, "self")
    }
}

fn find_instance_method_named(sname: str, mname: str, table: TypeTable): parser::Function | null {
    var decl = match type_table_find(table, sname, "") { parser::TypeDecl as td => td; error => return null }
    var methods = match decl.body {
        parser::StructBody as sb => sb.methods
        parser::ClassBody as cb => match effective_class_methods(cb, table) { []parser::Function as f => f; error => return null }
        parser::NewtypeBody as nb => nb.methods
        parser::EnumBody as eb => eb.methods
        parser::FlagsBody as fb => fb.methods
        _ => return null
    }
    var i = 0 to u64
    loop {
        if i >= methods.len { break }
        if methods[i].name == mname { return methods[i] }
        i++
    }
    null
}

fn method_name_visited(visited: []str, nm: str): bool {
    var i = 0 to u64
    loop {
        if i >= visited.len { break }
        if visited[i] == nm { return true }
        i++
    }
    false
}

fn method_mutates_self(sname: str, m: parser::Function, table: TypeTable): bool {
    method_mutates_self_guarded(sname, m, table, [])
}

fn method_mutates_self_guarded(sname: str, m: parser::Function, table: TypeTable, visited: []str): bool {
    if method_name_visited(visited, m.name) { return false }
    stmts_mutate_self(sname, m.body, table, [..visited, m.name])
}

fn stmts_mutate_self(sname: str, stmts: []@Statement(), table: TypeTable, visited: []str): bool {
    var i = 0 to u64
    loop {
        if i >= stmts.len { break }
        if stmt_mutates_self(sname, stmts[i], table, visited) { return true }
        i++
    }
    false
}

fn stmt_mutates_self(sname: str, s: @Statement(), table: TypeTable, visited: []str): bool {
    match s {
        parser::Assign as a => {
            if assign_target_is_self(a) { return true }
            if expr_mutates_self(sname, a.value, table, visited) { return true }
            parser::assign_has_target(a.kind) && expr_mutates_self(sname, a.target, table, visited)
        }
        parser::Binding as b => expr_mutates_self(sname, b.value, table, visited)
        parser::MultiBind as mb => exprs_mutate_self(sname, mb.values, table, visited)
        parser::Return as r => (r.has_value && expr_mutates_self(sname, r.value, table, visited)) || exprs_mutate_self(sname, r.values, table, visited)
        parser::ExprStmt as es => expr_mutates_self(sname, es.expr, table, visited)
        parser::LoopStmt as l => stmts_mutate_self(sname, l.init, table, visited) || stmts_mutate_self(sname, l.body, table, visited)
        parser::DeferStmt as d => stmts_mutate_self(sname, d.body, table, visited)
        parser::AdoptStmt as ad => stmts_mutate_self(sname, ad.body, table, visited)
        parser::BlockStmt as bl => stmts_mutate_self(sname, bl.body, table, visited)
        _ => false
    }
}

fn exprs_mutate_self(sname: str, es: []parser::Expr, table: TypeTable, visited: []str): bool {
    var i = 0 to u64
    loop {
        if i >= es.len { break }
        if expr_mutates_self(sname, es[i], table, visited) { return true }
        i++
    }
    false
}

fn arms_mutate_self(sname: str, arms: []parser::Arm, table: TypeTable, visited: []str): bool {
    var i = 0 to u64
    loop {
        if i >= arms.len { break }
        if arms[i].has_when && expr_mutates_self(sname, arms[i].guard, table, visited) { return true }
        if stmts_mutate_self(sname, arms[i].body, table, visited) { return true }
        i++
    }
    false
}

fn expr_mutates_self(sname: str, e: parser::Expr, table: TypeTable, visited: []str): bool {
    match e.kind {
        parser::MethodCall as mc => {
            if expr_roots_at_name(mc.receiver, "self") {
                match find_instance_method_named(sname, mc.method, table) {
                    parser::Function as cm => if method_mutates_self_guarded(sname, cm, table, visited) { return true }
                    null => { }
                }
            }
            expr_mutates_self(sname, mc.receiver, table, visited) || exprs_mutate_self(sname, mc.args, table, visited)
        }
        parser::Call as c => exprs_mutate_self(sname, c.args, table, visited)
        parser::Binary as b => expr_mutates_self(sname, b.left, table, visited) || expr_mutates_self(sname, b.right, table, visited)
        parser::Unary as u => expr_mutates_self(sname, u.operand, table, visited)
        parser::Compare as cmp => expr_mutates_self(sname, cmp.first, table, visited) || cmpterms_mutate_self(sname, cmp.rest, table, visited)
        parser::FieldAccess as fa => expr_mutates_self(sname, fa.receiver, table, visited)
        parser::Index as ix => expr_mutates_self(sname, ix.receiver, table, visited) || expr_mutates_self(sname, ix.index, table, visited)
        parser::Cast as ct => expr_mutates_self(sname, ct.expr, table, visited)
        parser::IfExpr as iff => expr_mutates_self(sname, iff.cond, table, visited) || stmts_mutate_self(sname, iff.then_blk, table, visited) || stmts_mutate_self(sname, iff.else_blk, table, visited)
        parser::MatchExpr as mx => expr_mutates_self(sname, mx.subject, table, visited) || arms_mutate_self(sname, mx.arms, table, visited)
        parser::StructLit as sl => exprs_mutate_self(sname, sl.field_vals, table, visited)
        parser::ArrayLit as al => arrayelems_mutate_self(sname, al.elements, table, visited)
        parser::Interp as ip => exprs_mutate_self(sname, ip.holes, table, visited)
        parser::InExpr as ie => expr_mutates_self(sname, ie.lhs, table, visited) || exprs_mutate_self(sname, ie.elems, table, visited)
        parser::Borrow as bo => expr_mutates_self(sname, bo.operand, table, visited)
        parser::Block as blk => stmts_mutate_self(sname, blk.body, table, visited)
        parser::Lambda as lm => stmts_mutate_self(sname, lm.body, table, visited)
        _ => false
    }
}

fn cmpterms_mutate_self(sname: str, ts: []parser::CmpTerm, table: TypeTable, visited: []str): bool {
    var i = 0 to u64
    loop {
        if i >= ts.len { break }
        if expr_mutates_self(sname, ts[i].operand, table, visited) { return true }
        i++
    }
    false
}

fn arrayelems_mutate_self(sname: str, els: []parser::ArrayElem, table: TypeTable, visited: []str): bool {
    var i = 0 to u64
    loop {
        if i >= els.len { break }
        if expr_mutates_self(sname, els[i].expr, table, visited) { return true }
        i++
    }
    false
}

fn struct_is_readonly_named(sname: str, table: TypeTable): bool {
    var decl = match type_table_find(table, sname, "") { parser::TypeDecl as td => td; error => return false }
    match decl.body { parser::StructBody as sb => sb.is_readonly; _ => false }
}

fn receiver_is_immutable_target(recv: parser::Expr, rt: @Type(), env: Env, table: TypeTable): bool {
    if !lvalue_root(recv).reachable { return true }
    match rt {
        Named as n => struct_is_readonly_named(n.name, table)
        _ => false
    }
}

fn type_method_call(mc: parser::MethodCall, env: Env, table: TypeTable): TExpr | error {
    var recv_t = match type_expr(mc.receiver, env, table) { TExpr as te => te.type; error as e => return e }
    if is_flags_named(recv_t, table) && !flags_named_has_user_method(recv_t, mc.method, table) {
        return type_flags_method(mc, env, table)
    }
    match recv_t {
        Variant => if variant_has_null_member(recv_t) { return require_narrowed(recv_t) }
        _ => { }
    }
    match recv_t {
        Named as rn => {
            if name_is_g_instance(rn.name) {
                var psegs = method_dispatch_callee(rn.name, mc.method).segments
                var pcargs: []parser::Expr = [mc.receiver, ..mc.args]
                return type_call(parser::Call { callee = parser::Path { segments = psegs }; args = pcargs; arg_names = method_call_arg_names(mc); owner_type_args = []; callee_type_args = mc.type_args }, null, env, table)
            }
        }
        _ => { }
    }
    var struct_name = match recv_t { Named as n => n.name; _ => return error { message = "method typing is deferred" } }
    var decl = match type_table_find(table, struct_name, "") { parser::TypeDecl as td => td; error => return error { message = "method typing is deferred" } }
    match type_param_call_error(decl, table) { error as e => return e; null => { } }
    match decl.body {
        parser::InterfaceBody as ib => return type_contract_dispatch(ib, struct_name, mc, env, table)
        parser::TraitBody as tb => return type_contract_dispatch(parser::InterfaceBody { extends = []; methods = tb.methods }, struct_name, mc, env, table)
        _ => { }
    }
    var methods = match decl.body {
        parser::StructBody as sb => sb.methods
        parser::ClassBody as cb => match effective_class_methods(cb, table) { []parser::Function as f => f; error as e => return e }
        parser::NewtypeBody as nb => nb.methods
        parser::EnumBody as eb => eb.methods
        parser::FlagsBody as fb => fb.methods
        _ => return error { message = "method typing is deferred" }
    }
    if methods.len == 0 { return error { message = $"no such method '{mc.method}' on struct '{struct_name}'" } }
    var mi: u64 = 0
    var found = false
    var mfn = methods[0]
    loop {
        if mi >= methods.len { break }
        if methods[mi].name == mc.method { found = true; mfn = methods[mi]; break }
        mi++
    }
    if !found { return error { message = $"no such method '{mc.method}' on struct '{struct_name}'" } }
    var is_instance = mfn.params.len > 0 && !mfn.params[0].has_type
    if !is_instance { return error { message = $"'{mc.method}' is a static method — call it as {struct_name}::{mc.method}(…)" } }
    match decl.body {
        parser::StructBody => {
            if method_mutates_self(struct_name, mfn, table) && receiver_is_immutable_target(mc.receiver, recv_t, env, table) {
                return error { message = $"cannot call mutating method `{mc.method}` on an immutable `{struct_name}` — the receiver is a literal or a `readonly struct`" }
            }
        }
        _ => { }
    }
    match decl.body {
        parser::ClassBody => {
            var owner = match find_method_owner(struct_name, table, mc.method) { MemberOwner as mo => mo; error as e => return e }
            if !member_accessible(owner, env.owner_type, table) {
                return error { message = $"method '{mc.method}' is private to {owner.declaring_class}" }
            }
        }
        _ => { }
    }
    match decl.body {
        parser::ClassBody as bcb => {
            if is_polymorphic_base(struct_name, table) {
                var slot_res = base_vtable_slot(struct_name, mc.method, table)
                match slot_res {
                    u32 as bslot => {
                        var bft = match method_func_type(mfn, struct_name, table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
                        var bf = match bft { Func as ff => ff; _ => return error { message = "internal: base method signature is not a function type" } }
                        var bcargs: []parser::Expr = [mc.receiver, ..mc.args]
                        var bcnames: []str = method_call_arg_names(mc)
                        var bdargs = match resolve_call_args(bf, bcargs, bcnames, env, table) { []parser::Expr as x => x; error as e => return e }
                        if bdargs.len != bf.params.len { return error { message = "wrong number of arguments" } }
                        var biargs: [bdargs.len]TExpr = []
                        var bii: u64 = 0
                        loop {
                            if bii >= bdargs.len { break }
                            var ba = match type_expr(bdargs[bii], env, table) { TExpr as te => te; error as e => return e }
                            if type_is_void(ba.type) { return error { message = "a `void` expression cannot be passed as an argument" } }
                            var bpt = bf.params[bii]
                            ba = match coerce_argument_into(ba, bpt, table) { TExpr as x => x; error as e => return e }
                            biargs[bii] = ba
                            bii++
                        }
                        var bsegs: []parser::Segment = [parser::Segment { name = struct_name }, parser::Segment { name = mc.method }]
                        return TExpr { kind = TCall { overload_suffix = ""; callee = parser::Path { segments = bsegs }; args = biargs; call_ns = ""; is_closure_call = false; callee_type = bft; is_iface_dispatch = true; iface_slot = bslot; type_args = []; ret_extra = [] }; type = bf.ret; line = 0; col = 0 }
                    }
                    error => { }
                }
            }
        }
        _ => { }
    }
    var segs = method_dispatch_callee(struct_name, mc.method).segments
    var cargs: []parser::Expr = [mc.receiver, ..mc.args]
    var cnames: []str = method_call_arg_names(mc)
    type_call(parser::Call { callee = parser::Path { segments = segs }; args = cargs; arg_names = cnames; owner_type_args = []; callee_type_args = mc.type_args }, null, env, table)
}

fn struct_iface_named_stop(from: @Type(), to: @Type(), table: TypeTable): error | null {
    if !struct_conforms_but_not_class(from, to, table) { return null }
    teko::error::err_typed(error { message = "a `struct` value cannot be used as the interface `<Iface>` — a struct has no stable address to dispatch through; use a `class` (`type T = class & <Iface>`) or a generic contract-bound parameter (`fn f<T: <Iface>>(x: T)`) instead" }, type_render(to), type_render(from))
}

fn type_contract_dispatch(ib: parser::InterfaceBody, struct_name: str, mc: parser::MethodCall, env: Env, table: TypeTable): TExpr | error {
    var dispatch = match resolve_iface_dispatch(ib, struct_name, mc.method, table) { IfaceDispatch as d => d; error as e => return e }
    var iface_canon = dispatch.iface
    var imfn = dispatch.method
    var slot = dispatch.slot
    var ift = match method_func_type(imfn, struct_name, table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
    var f = match ift { Func as ff => ff; _ => return error { message = "internal: interface method signature is not a function type" } }
    var icargs: []parser::Expr = [mc.receiver, ..mc.args]
    var icnames: []str = method_call_arg_names(mc)
    var dargs = match resolve_call_args(f, icargs, icnames, env, table) { []parser::Expr as x => x; error as e => return e }
    if dargs.len != f.params.len { return error { message = "wrong number of arguments" } }
    var iargs: [dargs.len]TExpr = []
    var ii: u64 = 0
    loop {
        if ii >= dargs.len { break }
        var a = match type_expr(dargs[ii], env, table) { TExpr as te => te; error as e => return e }
        if type_is_void(a.type) { return error { message = "a `void` expression cannot be passed as an argument" } }
        var pt = f.params[ii]
        a = match coerce_argument_into(a, pt, table) { TExpr as x => x; error as e => return e }
        iargs[ii] = a
        ii++
    }
    var isegs: []parser::Segment = [parser::Segment { name = iface_canon }, parser::Segment { name = mc.method }]
    TExpr { kind = TCall { overload_suffix = ""; callee = parser::Path { segments = isegs }; args = iargs; call_ns = ""; is_closure_call = false; callee_type = ift; is_iface_dispatch = true; iface_slot = slot; type_args = []; ret_extra = [] }; type = f.ret; line = 0; col = 0 }
}

fn single_seg_path(name: str): parser::Path {
    parser::Path { segments = [parser::Segment { name = name }] }
}

fn rewrite_segment_at(p: parser::Path, idx: u64, name: str): parser::Path {
    var segs: [p.segments.len]parser::Segment = []
    var i: u64 = 0
    loop {
        if i >= p.segments.len { break }
        if i == idx { segs[i] = parser::Segment { name = name } }
        else { segs[i] = p.segments[i] }
        i++
    }
    parser::Path { segments = segs }
}

fn path_prefix_through(p: parser::Path, idx: u64): parser::Path {
    var segs: [idx + 1]parser::Segment = []
    var i: u64 = 0
    loop {
        if i > idx { break }
        segs[i] = p.segments[i]
        i++
    }
    parser::Path { segments = segs }
}

fn retarget_generic_static_callee(c: parser::Call, table: TypeTable, ref_ns: str): parser::Path | error {
    if c.owner_type_args.len == 0 || c.callee.segments.len < 2 { return c.callee }
    var owner_idx = c.callee.segments.len - 2
    var nt = parser::NamedType { path = path_prefix_through(c.callee, owner_idx); args = c.owner_type_args }
    var rt = match resolve_type(nt, table, ref_ns) { (@Type()) as t => t; error as e => return e }
    var inst = match rt { Named as n => n.name; _ => return c.callee }
    rewrite_segment_at(c.callee, owner_idx, name_last_segment(inst))
}

fn split_phantom_args(suffix: str): []str {
    var out: []str = []
    var start: u64 = 0
    var i: u64 = 0
    loop {
        if i + 1 >= suffix.len { break }
        if suffix[i] == b'_' && suffix[i + 1] == b'_' {
            out = [..out, suffix.slice(start, i)]
            i = i + 2
            start = i
            continue
        }
        i++
    }
    out = [..out, suffix.slice(start, suffix.len)]
    out
}

fn phantom_owner_subst(phantom: str, template: parser::TypeDecl, table: TypeTable, ref_ns: str): Subst | error {
    var stem = split_generic_instance_name(phantom).stem
    var start = stem.len + 5
    if start >= phantom.len { return error { message = $"internal: malformed phantom instance name '{phantom}'" } }
    var suffix = phantom.slice(start, phantom.len)
    var toks = split_phantom_args(suffix)
    if toks.len != template.type_params.len {
        return error { message = $"cannot resolve the generic factory owner '{phantom}' — a nested generic type-argument is not supported here" }
    }
    var types: []@Type() = []
    var i: u64 = 0
    loop {
        if i >= toks.len { break }
        var at = match resolve_phantom_arg_token(toks[i], table, ref_ns) { (@Type()) as tt => tt; error as e => return e }
        types = [..types, at]
        i++
    }
    Subst { params = template.type_params; names = template.type_params; types = types }
}

fn resolve_phantom_arg_token(tok: str, table: TypeTable, ref_ns: str): @Type() | error {
    match resolve_type(parser::NamedType { path = single_seg_path(tok); args = [] }, table, ref_ns) {
        (@Type()) as t => return t
        error => { }
    }
    var qualified = qualified_type_name_by_last(tok, table)
    if teko::runtime::str_eq(qualified, tok) {
        return error { message = $"cannot resolve generic factory owner argument '{tok}'" }
    }
    Named { name = qualified }
}

fn type_phantom_instance_call(c: parser::Call, env: Env, table: TypeTable): TExpr | error {
    var nseg = c.callee.segments.len
    var phantom = c.callee.segments[nseg - 2].name
    var mname = c.callee.segments[nseg - 1].name
    var stem = split_generic_instance_name(phantom).stem
    var inst_ns = match resolve_bare_g_instance(phantom, table) { TypeReg as r => r.namespace; null => "" }
    var template = match find_generic_template_in_ns(table, stem, inst_ns) {
        TemplateReg as tr => tr
        null => match find_generic_template(table, stem) { TemplateReg as tr => tr; null => return error { message = $"unknown function: {mname}" } }
    }
    var s = match phantom_owner_subst(phantom, template.decl, table, env.cur_ns) { Subst as sub => sub; error as e => return e }
    var methods = match template.decl.body {
        parser::ClassBody as cb => cb.methods
        parser::StructBody as sb => sb.methods
        _ => return error { message = $"unknown function: {mname}" }
    }
    var found = false
    var mfn = methods[0]
    var mi: u64 = 0
    loop {
        if mi >= methods.len { break }
        if teko::runtime::str_eq(methods[mi].name, mname) { found = true; mfn = methods[mi]; break }
        mi++
    }
    if !found { return error { message = $"unknown function: {mname}" } }
    var raw = match method_func_type(mfn, stem, table, template.namespace) { (@Type()) as t => t; error as e => return e }
    var f0 = match raw { Func as ff => ff; _ => return error { message = "internal: phantom factory signature is not a function type" } }
    var fsub = match subst_type(raw, s) { Func as ff => ff; _ => return error { message = "internal: phantom factory signature is not a function type" } }
    var is_instance = mfn.params.len > 0 && !mfn.params[0].has_type
    var want: [fsub.params.len]@Type() = []
    var wi: u64 = 0
    loop {
        if wi >= fsub.params.len { break }
        if wi == 0 && is_instance { want[wi] = Named { name = phantom } } else { want[wi] = fsub.params[wi] }
        wi++
    }
    var dargs = match resolve_call_args(f0, c.args, c.arg_names, env, table) { []parser::Expr as x => x; error as e => return e }
    if dargs.len != want.len { return error { message = $"'{mname}' expects {want.len} argument(s), but {dargs.len} were given" } }
    var targs: [dargs.len]TExpr = []
    var ai: u64 = 0
    loop {
        if ai >= dargs.len { break }
        var a = match type_expr(dargs[ai], env, table) { TExpr as te => te; error as e => return e }
        if type_is_void(a.type) { return error { message = "a `void` expression cannot be passed as an argument" } }
        a = match coerce_argument_into(a, want[ai], table) { TExpr as x => x; error as e => return e }
        targs[ai] = a
        ai++
    }
    TExpr { kind = TCall { overload_suffix = ""; callee = c.callee; args = targs; call_ns = phantom; is_closure_call = false; callee_type = fsub; is_iface_dispatch = false; iface_slot = 0; type_args = []; ret_extra = [] }; type = fsub.ret; line = 0; col = 0 }
}

fn builtin_qualifier_ok(callee: parser::Path): bool {
    callee.segments.len == 1 || callee.segments[0].name == "teko"
}

fn unresolved_builtin_qualifier_error(callee: parser::Path, name: str): error {
    var qualifier = path_qualifier(callee, callee.segments.len - 1)
    error { message = $"unknown function: {path_str(callee)} — `{qualifier}` is not a recognized namespace; the built-in `{name}` is called bare (`{name}(...)`) or fully qualified rooted at `teko::` (`teko::...::{name}(...)`)" }
}

fn overload_suffix_for_binding(env: Env, b: ValBinding): str {
    match b.type {
        Func as f => overload_suffix_of(f, overload_func_bindings(env, b.ns, b.name))
        _ => ""
    }
}

fn build_overload_sig(tf: TFunction, ns: str, table: TypeTable): Func | error {
    var ptypes: [tf.params.len]@Type() = []
    var pnames: [tf.params.len]str = []
    var variadic = false
    var i: u64 = 0
    loop {
        if i >= tf.params.len { break }
        var pt = match resolve_type(tf.params[i].type_ann, table, ns) { (@Type()) as t => t; error as e => return e }
        ptypes[i] = pt
        pnames[i] = tf.params[i].name
        if tf.params[i].is_params { variadic = true }
        i++
    }
    Func { params = ptypes; ret = tf.return_type; variadic = variadic; param_names = pnames; n_required = 0; defaults = []; ret_extra = [] }
}

fn overload_suffix_for_decl(env: Env, ns: str, name: str, tf: TFunction, table: TypeTable): str {
    if !env_is_overloaded(env, ns, name) { return "" }
    match build_overload_sig(tf, ns, table) {
        Func as f => overload_suffix_of(f, overload_func_bindings(env, ns, name))
        error => ""
    }
}

fn overload_suffix_for_method(env: Env, method_ns: str, m: parser::Function, owner_bare: str, ref_ns: str, table: TypeTable): str {
    if !env_is_overloaded(env, method_ns, m.name) { return "" }
    var ft = match method_func_type(m, owner_bare, table, ref_ns) { (@Type()) as t => t; error => return "" }
    match ft {
        Func as f => overload_suffix_of(f, overload_func_bindings(env, method_ns, m.name))
        _ => ""
    }
}

fn bindings_same_signature(bs: []ValBinding): bool {
    if bs.len < 2 { return true }
    var i: u64 = 1
    loop {
        if i >= bs.len { break }
        if !type_eq(bs[0].type, bs[i].type) { return false }
        i++
    }
    true
}

fn select_overload(cands: []ValBinding, c: parser::Call, env: Env, table: TypeTable): ValBinding | error {
    var name = c.callee.segments[c.callee.segments.len - 1].name
    var exacts: []ValBinding = []
    var widens: []ValBinding = []
    var ci: u64 = 0
    loop {
        if ci >= cands.len { break }
        var cb = cands[ci]
        ci++
        match cb.type {
            Func as f => {
                var shaped = resolve_call_args(f, c.args, c.arg_names, env, table)
                match shaped {
                    []parser::Expr as dargs => {
                        if dargs.len == f.params.len {
                            var fits = true
                            var exact = true
                            var j: u64 = 0
                            loop {
                                if j >= dargs.len { break }
                                match type_expr(dargs[j], env, table) {
                                    TExpr as plain => {
                                        if type_is_void(plain.type) { fits = false; break }
                                        match type_value_expected(dargs[j], f.params[j], env, table) {
                                            TExpr as fa => {
                                                if !assignable_to(fa.type, f.params[j], table) { fits = false; break }
                                                if !type_eq(plain.type, f.params[j]) { exact = false }
                                            }
                                            error => { fits = false; break }
                                        }
                                    }
                                    error => { fits = false; break }
                                }
                                j++
                            }
                            if fits {
                                if exact { exacts = [..exacts, cb] } else { widens = [..widens, cb] }
                            }
                        }
                    }
                    error => { }
                }
            }
            _ => { }
        }
    }
    if exacts.len == 1 { return exacts[0] }
    if exacts.len >= 2 {
        if bindings_same_signature(exacts) { return exacts[0] }
        return error { message = $"ambiguous call to overloaded '{name}': {exacts.len} candidates match with an exact signature — disambiguate with an explicit cast (e.g. `x to T`)" }
    }
    if widens.len == 1 { return widens[0] }
    if widens.len >= 2 {
        if bindings_same_signature(widens) { return widens[0] }
        return error { message = $"ambiguous call to overloaded '{name}': {widens.len} candidates match by implicit widening — disambiguate with an explicit cast (e.g. `x to T`)" }
    }
    error { message = $"no matching overload for '{name}' with the given argument types" }
}

fn reject_multivalue_in_value_position(call: TCall): error | null {
    if call.ret_extra.len > 0 {
        return error { message = "a multiple-return call is valid only as the sole right-hand side of a `var …, … = …` binding or of a matched `return` — there is no tuple value" }
    }
    return null
}

fn unify_ret_with_expected(ret: @Type(), expected: @Type() | null, s: Subst, table: TypeTable): Subst | error {
    match expected {
        (@Type()) as e => unify(ret, e, s, table)
        null => s
    }
}

fn first_unbound_type_param(names: []str, s: Subst): str | null {
    var i = 0
    loop {
        if i >= names.len { break }
        match subst_find(s, names[i]) { (@Type()) as _bound => { }; null => return names[i] }
        i++
    }
    null
}

fn mono_type_args_of(names: []str, s: Subst, needed: bool): []@Type() {
    if !needed { return [] }
    var out: [names.len]@Type() = []
    var i = 0
    loop {
        if i >= names.len { break }
        out[i] = match subst_find(s, names[i]) { (@Type()) as t => t; null => Void { } }
        i++
    }
    out
}

type NotFloorIntrinsic = struct { }

fn floor_intrinsic_tag(resolved_ns: str, name: str): str {
    if resolved_ns != "teko::base" { return "" }
    if name == "sizeof" { return "teko::__sizeof" }
    if name == "alignof" { return "teko::__alignof" }
    ""
}

fn type_floor_intrinsic(c: parser::Call, resolved_ns: str, in_scope: bool, env: Env, table: TypeTable): TExpr | NotFloorIntrinsic | error {
    if !in_scope { return NotFloorIntrinsic { } }
    var name = c.callee.segments[c.callee.segments.len - 1].name
    var tag = floor_intrinsic_tag(resolved_ns, name)
    if tag == "" { return NotFloorIntrinsic { } }
    if c.callee_type_args.len != 1 || c.args.len != 0 { return NotFloorIntrinsic { } }
    var rt = match resolve_type(c.callee_type_args[0], table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
    match rt { Void => return error { message = $"`{name}<void>` is invalid — void has no size" }; _ => { } }
    var xtypes = [rt]
    TExpr { kind = TCall { overload_suffix = ""; callee = c.callee; args = []; call_ns = tag; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = xtypes; ret_extra = [] }; type = Prim { kind = PrimKind::Usize }; line = 0; col = 0 }
}

fn type_call(c0: parser::Call, expected: @Type() | null, env: Env, table: TypeTable): TExpr | error {
    if c0.owner_type_args.len > max_generic_arity() || c0.callee_type_args.len > max_generic_arity() {
        return error { message = "at most 16 explicit type arguments" }
    }
    var explicit_fn_args: []@TypeExpr() = c0.callee_type_args
    var c = c0
    if c0.owner_type_args.len > 0 {
        var rc = match retarget_generic_static_callee(c0, table, env.cur_ns) { parser::Path as p => p; error as e => return e }
        c = parser::Call { callee = rc; args = c0.args; arg_names = c0.arg_names; owner_type_args = c0.owner_type_args; callee_type_args = c0.callee_type_args }
    }
    if c.callee.segments.len >= 2 && name_is_g_instance(c.callee.segments[c.callee.segments.len - 2].name) {
        return type_phantom_instance_call(c, env, table)
    }
    match type_list_builtin(c, env, table) {
        TExpr as te => return te
        error as e => return e
        NotListBuiltin => { }
    }
    match lookup_call(env, c.callee) {
        (@Type()) as _zero_shadow => { }
        error => match type_zero_builtin(c, expected, env, table) {
            TExpr as te => return te
            error as e => return e
            NotZeroBuiltin => { }
        }
    }
    match type_ptr_unwrap(c, env, table) {
        TExpr as te => return te
        error as e => return e
        NotPtrOp => { }
    }
    match type_ref_word(c, env, table) {
        TExpr as te => return te
        error as e => return e
        NotPtrOp => { }
    }
    match type_svc(c, env, table) {
        TExpr as te => return te
        error as e => return e
        NotSvcOp => { }
    }
    match type_has_svc(c, env, table) {
        TExpr as te => return te
        error as e => return e
        NotSvcOp => { }
    }
    var name = c.callee.segments[c.callee.segments.len - 1].name
    var in_scope = match lookup_call(env, c.callee) { (@Type()) as _gt6 => true; error => false }
    var resolved_ns = match lookup_call(env, c.callee) { (@Type()) as _gt7 => call_ns(env, c.callee); error => "" }
    match type_floor_intrinsic(c, resolved_ns, in_scope, env, table) {
        TExpr as te => return te
        error as e => return e
        NotFloorIntrinsic => { }
    }
    var ft = match lookup_call(env, c.callee) {
        (@Type()) as t => t
        error => match builtin_fn(name) {
            (@Type()) as t => {
                if !builtin_qualifier_ok(c.callee) { return unresolved_builtin_qualifier_error(c.callee, name) }
                if resolved_ns == "" && is_runtime_alloc_builtin(name) { resolved_ns = "teko::runtime" }
                t
            }
            error => return error { message = $"unknown function: {name}" }
        }
    }
    var ov_suffix = ""
    if in_scope && (env_is_overloaded(env, resolved_ns, name) || call_has_global_overload(env, c.callee)) {
        var wb = match select_overload(lookup_call_candidates(env, c.callee), c, env, table) { ValBinding as b => b; error as e => return e }
        ft = wb.type
        resolved_ns = wb.ns
        ov_suffix = overload_suffix_for_binding(env, wb)
    }
    if resolved_ns != "" {
        match find_class_body(class_name_from_method_ns(resolved_ns), table) {
            parser::ClassBody => {
                var owner = match find_method_owner(class_name_from_method_ns(resolved_ns), table, name) { MemberOwner as mo => mo; error as e => return e }
                if !member_accessible(owner, env.owner_type, table) {
                    return error { message = $"method '{name}' is private to {owner.declaring_class}" }
                }
            }
            error => { }
        }
    }
    match ft {
        Func as f => {
            var dargs = match resolve_call_args(f, c.args, c.arg_names, env, table) { []parser::Expr as x => x; error as e => return e }
            if dargs.len != f.params.len { return error { message = "wrong number of arguments" } }
            var targs: []TExpr = []
            var ti = 0
            loop {
                if ti >= dargs.len { break }
                var is_lam = match dargs[ti].kind { parser::Lambda => true; _ => false }
                var pt_is_func = match f.params[ti] { Func => true; _ => false }
                var is_arr = match dargs[ti].kind { parser::ArrayLit => true; _ => false }
                var iface_arr_target = is_arr && is_iface_slice(f.params[ti], table)
                var is_dot_arg = expr_is_dot_construction(dargs[ti])
                var a = if (is_lam && pt_is_func) || iface_arr_target || is_dot_arg || arg_wants_expected(dargs[ti], f.params[ti]) {
                    match type_value_expected(dargs[ti], f.params[ti], env, table) { TExpr as te => te; error as e => return e }
                } else {
                    match type_expr(dargs[ti], env, table) { TExpr as te => te; error as e => return e }
                }
                if type_is_void(a.type) { return error { message = "a `void` expression cannot be passed as an argument" } }
                targs = [..targs, a]
                ti++
            }
            var all_tps = collect_sig_type_params(ft, table, [])
            if explicit_fn_args.len > 0 && all_tps.len == 0 {
                return error { message = $"'{name}' is not generic — it takes no explicit type arguments" }
            }
            if all_tps.len > 0 {
                if explicit_fn_args.len > 0 {
                    if explicit_fn_args.len != all_tps.len {
                        return error { message = $"'{name}' takes {all_tps.len} type argument(s), but {explicit_fn_args.len} were given" }
                    }
                    var s = Subst { params = all_tps; names = []; types = [] }
                    var xtypes: [all_tps.len]@Type() = []
                    var xi = 0
                    loop {
                        if xi >= all_tps.len { break }
                        var rt = match resolve_type(explicit_fn_args[xi], table, env.cur_ns) { (@Type()) as tt => tt; error as e => return e }
                        match rt { Reference => return error { message = "a reference cannot be an explicit generic type argument (it would be stored / escape)" }; _ => { } }
                        s = Subst { params = all_tps; names = [..s.names, all_tps[xi]]; types = [..s.types, rt] }
                        xtypes[xi] = rt
                        xi++
                    }
                    var vi = 0
                    loop {
                        if vi >= targs.len { break }
                        var want = subst_type(f.params[vi], s)
                        if !assignable_to(targs[vi].type, want, table) {
                            return error { message = $"argument {vi + 1} of '{name}' does not fit the explicit instantiation (expected {type_render(want)}, got {type_render(targs[vi].type)})" }
                        }
                        vi++
                    }
                    return TExpr { kind = TCall { overload_suffix = ov_suffix; callee = c.callee; args = reinterpret_generic_args(targs, f.params, s, table); call_ns = resolved_ns; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = xtypes; ret_extra = [] }; type = subst_type(f.ret, s); line = 0; col = 0 }
                }
                var s = Subst { params = all_tps; names = []; types = [] }
                var gi = 0
                loop {
                    if gi >= targs.len { break }
                    s = match unify(f.params[gi], targs[gi].type, s, table) { Subst as x => x; error as e => return e }
                    gi++
                }
                var ret_only_inferred = false
                match first_unbound_type_param(all_tps, s) {
                    str => {
                        ret_only_inferred = true
                        s = match unify_ret_with_expected(f.ret, expected, s, table) { Subst as x => x; error as e => return e }
                    }
                    null => { }
                }
                match first_unbound_type_param(all_tps, s) {
                    str as missing => return error { message = $"cannot infer type parameter {missing} — it appears only in the return type; annotate the call" }
                    null => { }
                }
                var inferred_type_args: []@Type() = mono_type_args_of(all_tps, s, ret_only_inferred)
                return TExpr { kind = TCall { overload_suffix = ov_suffix; callee = c.callee; args = reinterpret_generic_args(targs, f.params, s, table); call_ns = resolved_ns; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = inferred_type_args; ret_extra = [] }; type = subst_type(f.ret, s); line = 0; col = 0 }
            }
            var args: [targs.len]TExpr = []
            var i = 0
            loop {
                if i >= targs.len { break }
                var a = targs[i]
                if !assignable_to(a.type, f.params[i], table) { a = deref_ref_value(a) }
                var auto_reffed = false
                match f.params[i] {
                    Reference as rf => {
                        if !assignable_to(a.type, f.params[i], table) && type_eq(a.type, rf.inner) {
                            match a.kind {
                                TVar as v => match lookup_binding(env, v.name) {
                                    ValBinding as vb => {
                                        if !vb.is_mut { return error { message = $"cannot take a reference to immutable `{v.name}` (a reference needs a mutable target)" } }
                                        auto_reffed = true
                                    }
                                    error => return error { message = "auto-ref requires a mutable variable (a `var` binding)" }
                                }
                                _ => return error { message = "a `ref<T>` argument must be a mutable variable (a `var` binding) — only an lvalue can be referenced" }
                            }
                        }
                    }
                    _ => { }
                }
                if !auto_reffed {
                    a = match coerce_argument_into(a, f.params[i], table) { TExpr as x => x; error as e => return e }
                }
                args[i] = a
                i++
            }
            var is_closure = in_scope && resolved_ns.len == 0
            TExpr { kind = TCall { overload_suffix = ov_suffix; callee = c.callee; args = args; call_ns = resolved_ns; is_closure_call = is_closure; callee_type = ft; is_iface_dispatch = false; iface_slot = 0; type_args = []; ret_extra = [] }; type = f.ret; line = 0; col = 0 }
        }
        _ => error { message = $"not a function: {name}" }
    }
}

fn numint_fits(v: parser::NumInt, k: PrimKind): bool {
    if prim_is_float(k) { return false }
    if k == PrimKind::U8 { return !v.neg && v.mag <= 255 }
    if k == PrimKind::U16 { return !v.neg && v.mag <= 65535 }
    if k == PrimKind::U32 { return !v.neg && v.mag <= 4294967295 }
    if k == PrimKind::U64 { return !v.neg && v.mag <= 18446744073709551615 }
    if k == PrimKind::I8 { return if v.neg { v.mag <= 128 } else { v.mag <= 127 } }
    if k == PrimKind::I16 { return if v.neg { v.mag <= 32768 } else { v.mag <= 32767 } }
    if k == PrimKind::I32 { return if v.neg { v.mag <= 2147483648 } else { v.mag <= 2147483647 } }
    if k == PrimKind::I64 { return if v.neg { v.mag <= 9223372036854775808 } else { v.mag <= 9223372036854775807 } }
    if k == PrimKind::Usize { return !v.neg && v.mag <= 18446744073709551615 }
    if k == PrimKind::Isize { return if v.neg { v.mag <= 9223372036854775808 } else { v.mag <= 9223372036854775807 } }
    false
}

fn float_fits(v: f64, k: PrimKind): bool { prim_is_float(k) }

fn cast_kind(t: @Type()): PrimKind | error {
    match t {
        Prim as p => {
            if p.kind == PrimKind::Bool { error { message = "bool casts are not defined in the seed" } }
            else { p.kind }
        }
        Byte => PrimKind::U8
        Ptr as p => cast_kind_of_ptr(p)
        Uptr => PrimKind::U64
        _ => error { message = "cast not defined for this type in the seed (Named/Slice/… — pending)" }
    }
}

fn cast_kind_of_ptr(p: Ptr): PrimKind | error {
    PrimKind::U64
}

fn cast_ptr_partner_ok(from: @Type(), to: @Type()): error | null {
    var from_ptr = is_bare_ptr(from)
    var to_ptr = is_bare_ptr(to)
    if !from_ptr && !to_ptr { return null }
    if from_ptr && to_ptr {
        return error { message = "cast not defined between two pointer types in the seed (only `ptr<byte> <-> u64`, the arena address carrier, is defined)" }
    }
    var partner = if from_ptr { to } else { from }
    if is_u64_prim(partner) { return null }
    error { message = "cast not defined for this pointer/numeric pairing in the seed (only `ptr<byte> <-> u64`, the arena address carrier, is defined)" }
}

fn is_bare_ptr(t: @Type()): bool {
    match t { Ptr => true; _ => false }
}

fn is_u64_prim(t: @Type()): bool {
    match t { Prim as p => p.kind == PrimKind::U64; _ => false }
}

fn cast_check(from: @Type(), to: @Type()): error | null {
    if type_eq(from, to) { return null }
    match cast_ptr_partner_ok(from, to) { null => { }; error as e => return e }
    match cast_kind(from) { PrimKind => { }; error as e => return e }
    match cast_kind(to) { PrimKind => { }; error as e => return e }
    null
}

fn const_range_check(e: parser::Expr, target: @Type()): error | null {
    match e.kind {
        parser::Number as n => match cast_kind(target) {
            PrimKind as k => {
                if n.is_float || !prim_is_int(k) { null }
                else if numint_fits(n.value, k) { null }
                else { error { message = "constant out of range for the cast target (fail early)" } }
            }
            error => null
        }
        _ => null
    }
}

fn annotated_literal_ok(value: parser::Expr, ann: @Type()): error | null {
    match value.kind {
        parser::ArrayLit as al => match ann {
            Slice as s => {
                var i = 0
                var result: error | null = null
                loop {
                    if i >= al.elements.len { break }
                    if !al.elements[i].is_spread {
                        match annotated_literal_ok(al.elements[i].expr, s.element) {
                            null => { }
                            error as e => { result = e; break }
                        }
                    }
                    i++
                }
                result
            }
            _ => error { message = "value type does not match annotation" }
        }
        parser::Unary as u => {
            if u.op == lexer::TokenKind::Minus {
                match u.operand.kind {
                    parser::Number as n => match ann {
                        Prim as p => {
                            if n.is_float {
                                if !prim_is_float(p.kind) { error { message = "a float literal cannot be annotated as an integer type" } }
                                else if float_fits(n.fval, p.kind) { null }
                                else { error { message = "float literal out of range for the annotated type (fail early)" } }
                            } else {
                                if prim_is_float(p.kind) { error { message = "an integer literal cannot be annotated as a float type (write it with a `.` — B.38)" } }
                                else if !prim_is_signed(p.kind) { error { message = "a negative literal cannot be annotated as an unsigned type" } }
                                else if numint_fits(n.value, p.kind) { null }
                                else { error { message = "literal out of range for the annotated type (fail early)" } }
                            }
                        }
                        _ => error { message = "value type does not match annotation" }
                    }
                    _ => error { message = "value type does not match annotation" }
                }
            } else {
                error { message = "value type does not match annotation" }
            }
        }
        parser::Number as n => match ann {
            Prim as p => {
                if n.is_float {
                    if !prim_is_float(p.kind) { error { message = "a float literal cannot be annotated as an integer type" } }
                    else if float_fits(n.fval, p.kind) { null }
                    else { error { message = "float literal out of range for the annotated type (fail early)" } }
                } else {
                    if prim_is_float(p.kind) { error { message = "an integer literal cannot be annotated as a float type (write it with a `.` — B.38)" } }
                    else if numint_fits(n.value, p.kind) { null }
                    else { error { message = "literal out of range for the annotated type (fail early)" } }
                }
            }
            _ => error { message = "value type does not match annotation" }
        }
        _ => error { message = "value type does not match annotation" }
    }
}

fn is_enum_named(t: @Type(), table: TypeTable): bool {
    match t {
        Named as n => match type_table_find(table, n.name, "") {
            parser::TypeDecl as td => match td.body { parser::EnumBody => true; _ => false }
            error => false
        }
        _ => false
    }
}

fn is_int_cast_end(t: @Type()): bool {
    match t {
        Byte => true
        Prim as p => prim_is_int(p.kind)
        _ => false
    }
}

fn is_char_decode_target(t: @Type()): bool {
    match t {
        Prim as p => p.kind == PrimKind::U32 || p.kind == PrimKind::U64 || p.kind == PrimKind::I64
        _ => false
    }
}

fn is_flags_wire_cast(from: @Type(), to: @Type(), table: TypeTable): bool {
    (is_flags_named(from, table) && is_int_cast_end(to)) ||
    (is_int_cast_end(from) && is_flags_named(to, table))
}

type NotValueType = struct { }

fn value_type_base(t: @Type(), table: TypeTable): @Type() | NotValueType {
    if is_str_type(t) { return NotValueType { } }
    match t {
        Named as n => match type_table_find(table, n.name, "") {
            parser::TypeDecl as td => match td.body {
                parser::NewtypeBody as nb => match resolve_type(nb.backing, table, "") {
                    (@Type()) as bt => bt
                    error => NotValueType { }
                }
                _ => NotValueType { }
            }
            error => NotValueType { }
        }
        _ => NotValueType { }
    }
}

fn value_type_reduce(t: @Type(), table: TypeTable): @Type() {
    match value_type_base(t, table) {
        (@Type()) as bty => bty
        NotValueType => t
    }
}

fn explicit_cast_gate(env: Env, e: TExpr): error | null {
    if !env.explicit { return null }
    teko::error::err_loc(error { message = $"conversão desnecessária: `to {type_render(e.type)}` é um no-op provável — remova-o (--explicit)" }, e.line, e.col)
}

fn type_cast(c: parser::Cast, env: Env, table: TypeTable): TExpr | error {
    var inner = match type_expr(c.expr, env, table) { TExpr as te => te; error as e => return e }
    if type_is_void(inner.type) { return error { message = "a `void` expression cannot be cast" } }
    var target = match resolve_type(c.target, table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
    if type_eq(inner.type, target) {
        var noop = TExpr { kind = TCast { expr = inner }; type = target; line = inner.line; col = inner.col }
        match explicit_cast_gate(env, noop) { error as ge => return ge; null => { } }
        return noop
    }
    match inner.type {
        Char => {
            if is_char_decode_target(target) {
                return TExpr { kind = TCast { expr = inner }; type = target; line = 0; col = 0 }
            }
            return error { message = "a `char` may only be cast to u32/u64/i64 (its codepoint value); other casts are not defined" }
        }
        _ => { }
    }
    var inner_r = value_type_reduce(inner.type, table)
    var target_r = value_type_reduce(target, table)
    var e7 = (is_enum_named(inner_r, table) && is_int_cast_end(target_r)) ||
    (is_int_cast_end(inner_r) && is_enum_named(target_r, table))
    var e8 = is_flags_wire_cast(inner_r, target_r, table)
    if !e7 && !e8 {
        match cast_check(inner_r, target_r) { null => { }; error as e => return e }
    }
    match const_range_check(c.expr, target_r) { null => { }; error as e => return e }
    TExpr { kind = TCast { expr = inner }; type = target; line = 0; col = 0 }
}

fn field_type(fields: []parser::Field, field: str, table: TypeTable, ref_ns: str): @Type() | error {
    var i = 0
    loop {
        if i >= fields.len { break }
        if fields[i].name == field { return resolve_type(fields[i].type_ann, table, ref_ns) }
        i++
    }
    error { message = $"no such field: {field}" }
}

fn require_narrowed(t: @Type()): error {
    if is_ref_null_variant(t) {
        return error { message = "cannot dereference a `Ref<T> | null` — narrow it to a bare `Ref<T>` first (`match r { null => …; Ref<T> as v => v.value }`), the deref fence keeping the never-null reference promise sound" }
    }
    error { message = "cannot use `.` on a `T | null` value before narrowing — narrow it first (`match x { null => …; T as v => v.… }`)" }
}

pub type PropInfo = struct { has_get: bool; has_set: bool; getter: parser::Function; setter: parser::Function }

fn property_surface_of(decl: parser::TypeDecl, name: str, table: TypeTable): []parser::Function | null {
    match decl.body {
        parser::InterfaceBody => match iface_methods_by_name(name, table) { []parser::Function as f => f; error => null }
        parser::TraitBody => match iface_methods_by_name(name, table) { []parser::Function as f => f; error => null }
        parser::ClassBody as cb => match effective_class_methods(cb, table) { []parser::Function as f => f; error => null }
        parser::StructBody as sb => sb.methods
        _ => null
    }
}

fn find_property(type_name: str, prop: str, table: TypeTable): PropInfo | null {
    var decl = match type_table_find(table, type_name, "") { parser::TypeDecl as td => td; error => return null }
    var methods = match property_surface_of(decl, type_name, table) { []parser::Function as f => f; null => return null }
    if methods.len == 0 to u64 { return null }
    var has_get = false
    var has_set = false
    var getter = methods[0]
    var setter = methods[0]
    var i = 0 to u64
    loop {
        if i >= methods.len { break }
        var m = methods[i]
        if m.accessor_prop == prop {
            if m.is_getter { has_get = true; getter = m }
            else if m.is_setter { has_set = true; setter = m }
        }
        i = i + 1
    }
    if !has_get && !has_set { return null }
    PropInfo { has_get = has_get; has_set = has_set; getter = getter; setter = setter }
}

fn class_field_visible_to(owner: MemberOwner, env: Env, table: TypeTable): bool {
    member_accessible(owner, env.owner_type, table)
}

fn desugar_getter(recv: parser::Expr, prop: str, env: Env, table: TypeTable): TExpr | error {
    var mc = parser::MethodCall { receiver = recv; method = "__get_" ~ prop; args = []; arg_names = []; type_args = [] }
    type_method_call(mc, env, table)
}

fn property_read_or(orig_err: error, type_name: str, recv: parser::Expr, prop: str, env: Env, table: TypeTable): TExpr | error {
    match find_property(type_name, prop, table) {
        PropInfo as pinfo => {
            if pinfo.has_get { return desugar_getter(recv, prop, env, table) }
            return error { message = $"property '{prop}' is write-only — it has a setter but no getter" }
        }
        null => orig_err
    }
}

fn type_field_access(fa: parser::FieldAccess, env: Env, table: TypeTable): TExpr | error {
    var recv = match type_expr(fa.receiver, env, table) { TExpr as te => te; error as e => return e }
    var is_str_or_slice = is_str_type(recv.type) || (match recv.type { Slice => true; _ => false })
    if is_str_or_slice && fa.field == "len" {
        return TExpr { kind = TFieldAccess { receiver = recv; field = fa.field }; type = Prim { kind = PrimKind::U64 }; line = 0; col = 0 }
    }
    var is_error = match recv.type { Error => true; _ => false }
    if is_error {
        if fa.field == "message" || fa.field == "file" || fa.field == "expected" || fa.field == "actual" {
            return TExpr { kind = TFieldAccess { receiver = recv; field = fa.field }; type = Named { name = "teko::base::str" }; line = 0; col = 0 }
        }
        if fa.field == "line" || fa.field == "col" {
            return TExpr { kind = TFieldAccess { receiver = recv; field = fa.field }; type = Prim { kind = PrimKind::U32 }; line = 0; col = 0 }
        }
        return error { message = "no such field on error (message/file/expected/actual: str; line/col: u32)" }
    }
    match recv.type {
        Reference as rf => {
            if fa.field == "value" {
                return TExpr { kind = TFieldAccess { receiver = recv; field = fa.field }; type = rf.inner; line = 0; col = 0 }
            }
            recv = deref_ref_value(recv)
        }
        _ => { }
    }
    match recv.type {
        Variant => if variant_has_null_member(recv.type) { return require_narrowed(recv.type) }
        _ => { }
    }
    var name = match recv.type {
        Named as n => n.name
        _ => return error { message = "field access requires a struct receiver" }
    }
    var decl = match type_decl_or_template(table, name) {
        parser::TypeDecl as td => td
        error => return error { message = $"unknown type for field access: {name}" }
    }
    match decl.body {
        parser::StructBody as sb => {
            match field_type(sb.fields, fa.field, table, type_ns_of(table, name)) {
                (@Type()) as t => return TExpr { kind = TFieldAccess { receiver = recv; field = fa.field }; type = t; line = 0; col = 0 }
                error as e => return property_read_or(e, name, fa.receiver, fa.field, env, table)
            }
        }
        parser::ClassBody as cb => {
            var fs = match effective_class_fields(cb, table) { []parser::Field as x => x; error as e => return e }
            match field_type(fs, fa.field, table, type_ns_of(table, name)) {
                (@Type()) as t => {
                    var owner = match find_field_owner(name, table, fa.field) { MemberOwner as mo => mo; error as e => return e }
                    if !class_field_visible_to(owner, env, table) {
                        return error { message = $"field '{fa.field}' is private to {owner.declaring_class}" }
                    }
                    return TExpr { kind = TFieldAccess { receiver = recv; field = fa.field }; type = t; line = 0; col = 0 }
                }
                error as e => return property_read_or(e, name, fa.receiver, fa.field, env, table)
            }
        }
        parser::ExternStructBody as esb => {
            match field_type(esb.fields, fa.field, table, type_ns_of(table, name)) {
                (@Type()) as t => return TExpr { kind = TFieldAccess { receiver = recv; field = fa.field }; type = t; line = 0; col = 0 }
                error as e => return e
            }
        }
        parser::InterfaceBody => return property_read_or(error { message = "an interface value exposes no fields — only its contract methods" }, name, fa.receiver, fa.field, env, table)
        _ => return error { message = $"type {name} is not a struct (no fields)" }
    }
}

fn unread_guard_placeholder(): TExpr {
    TExpr { kind = TNumber { is_float = false; value = parser::numint_of_u64(0); fval = 0.0 }; type = Void { }; line = 0; col = 0 }
}

fn is_foreach_elem_placeholder(p: @Pattern()): bool {
    match p {
        parser::BindPattern as bp => bp.type_name.segments.len == 0 && !bp.is_slice && bp.has_binding
        _ => false
    }
}

fn elem_type_name(t: @Type()): str | error {
    match t {
        Prim as p => prim_name(p.kind)
        Byte => "byte"
        Char => "char"
        Named as n => name_last_segment(n.name)
        _ => error { message = "internal: a for-each iterator's element type must be a nameable type (prim/byte/char/str/named) — this shape is not yet supported" }
    }
}

fn strip_null_member_or_self(t: @Type()): @Type() {
    match t {
        Variant as v => {
            if v.members.len != 2 { return t }
            var null_count = 0
            var other: @Type() | null = null
            var i = 0
            loop {
                if i >= v.members.len { break }
                match v.members[i] { Null => null_count = null_count + 1; _ => other = v.members[i] }
                i++
            }
            if null_count != 1 { return t }
            match other { (@Type()) as o => o; null => t }
        }
        _ => t
    }
}

fn resolve_foreach_arm(a: parser::Arm, subject: @Type()): parser::Arm | error {
    if !is_foreach_elem_placeholder(a.pattern) { return a }
    var bp = match a.pattern { parser::BindPattern as b => b; _ => return a }
    var inner = strip_null_member_or_self(subject)
    var tn = match elem_type_name(inner) { str as s => s; error as e => return e }
    var segs = [parser::Segment { name = tn }]
    var real = parser::BindPattern { type_name = parser::Path { segments = segs }; has_binding = bp.has_binding; binding = bp.binding; is_slice = false; slice_type = null; type_args = [] }
    parser::Arm { pattern = real; has_when = a.has_when; guard = a.guard; body = a.body }
}

fn resolve_foreach_placeholders(arms: []parser::Arm, subject: @Type()): []parser::Arm | error {
    var out: []parser::Arm = []
    var i: u64 = 0
    loop {
        if i >= arms.len { break }
        var ra = match resolve_foreach_arm(arms[i], subject) { parser::Arm as a => a; error as e => return e }
        out = [..out, ra]
        i++
    }
    out
}

fn type_foreach_elem_arm(a: parser::Arm, subject: @Type(), env: Env, table: TypeTable): TArm | error {
    var bp = match a.pattern { parser::BindPattern as b => b; _ => return error { message = "internal: for-each placeholder must be a BindPattern" } }
    var inner = strip_null_member_or_self(subject)
    var tn = match elem_type_name(inner) { str as s => s; error as e => return e }
    var e2 = define(env, bp.binding, inner, false)
    var body = match type_block(a.body, e2, table) { TypedBlock as bk => bk; error as err => return err }
    var guard = TExpr { kind = TNumber { is_float = false; value = parser::numint_of_u64(0); fval = 0.0 }; type = Void { }; line = 0; col = 0 }
    if a.has_when {
        var g = match type_expr(a.guard, e2, table) { TExpr as te => te; error as err => return err }
        if !is_bool(g.type) { return error { message = "a `when` guard must be a bool" } }
        guard = g
    }
    var segs = [parser::Segment { name = tn }]
    var real = parser::BindPattern { type_name = parser::Path { segments = segs }; has_binding = bp.has_binding; binding = bp.binding; is_slice = false; slice_type = null; type_args = [] }
    TArm { pattern = real; has_when = a.has_when; guard = guard; body = body.stmts }
}

fn type_match_arm(a: parser::Arm, subject: @Type(), env: Env, table: TypeTable): TArm | error {
    if is_foreach_elem_placeholder(a.pattern) { return type_foreach_elem_arm(a, subject, env, table) }
    type_arm(a, subject, env, table)
}

type ConstructTarget = struct {
    name: str
    decl: parser::TypeDecl
    is_self: bool
}

fn is_dot_sentinel(path: parser::Path): bool {
    path.segments.len == 0
}

fn dot_no_target_error(): error {
    error { message = "`.{ … }` needs a known target type here — annotate the binding/return or write the type explicitly (`Name { … }`)" }
}

fn dot_construct_target(expected: @Type(), env: Env, table: TypeTable): ConstructTarget | error {
    var en = match expected { Named as n => n; _ => return dot_no_target_error() }
    match type_table_find(table, en.name, "") {
        parser::TypeDecl as td => {
            if td.type_params.len > 0 {
                if !dot_targets_owner(en.name, env) { return dot_no_target_error() }
                var phantom = self_inst_spelling(name_last_segment(en.name), td.type_params)
                return ConstructTarget { name = phantom; decl = td; is_self = true }
            }
            ConstructTarget { name = en.name; decl = td; is_self = dot_targets_owner(en.name, env) }
        }
        error => {
            if !name_is_g_instance(en.name) { return dot_no_target_error() }
            var stem = split_generic_instance_name(en.name).stem
            var tmpl = match stem_decl_in_ns(table, stem, env.cur_ns) {
                parser::TypeDecl as t => t
                null => match type_table_find(table, stem, "") { parser::TypeDecl as t => t; error => return dot_no_target_error() }
            }
            ConstructTarget { name = en.name; decl = tmpl; is_self = dot_targets_owner(en.name, env) }
        }
    }
}

fn dot_targets_owner(name: str, env: Env): bool {
    if env.owner_type == "" { return false }
    named_case_name(name) == named_case_name(env.owner_type)
}

fn self_return_named(struct_name: str, cur_ns: str, table: TypeTable): @Type() {
    var canon = qualify(cur_ns, struct_name)
    match type_table_find(table, canon, "") {
        parser::TypeDecl as td => if td.type_params.len == 0 { Named { name = canon } } else { Named { name = self_inst_spelling(name_last_segment(canon), td.type_params) } }
        error => Named { name = canon }
    }
}

fn is_error_literal_prefix(sl: parser::StructLit): bool {
    sl.type_args.len == 0 && sl.type_path.segments.len == 1 && sl.type_path.segments[0].name == "error"
}

fn type_error_literal(sl: parser::StructLit, env: Env, table: TypeTable): TExpr | error {
    if sl.field_names.len != 1 || sl.field_names[0] != "message" {
        return error { message = "`error` is constructed as `error { message = <str> }` (one `message` field)" }
    }
    var v = match type_expr(sl.field_vals[0], env, table) { TExpr as te => te; error as e => return e }
    if !is_str_type(v.type) { return error { message = "`error`'s `message` must be a `str`" } }
    var enames = ["message"]
    var evals = [v]
    TExpr { kind = TStructInit { field_names = enames; field_vals = evals }; type = Error { }; line = 0; col = 0 }
}

fn explicit_inst_target(sl: parser::StructLit, expected: @Type(), env: Env, table: TypeTable): ConstructTarget | error {
    var stem = sl.type_path.segments[sl.type_path.segments.len - 1].name
    var gte = parser::NamedType { path = sl.type_path; args = sl.type_args }
    var git = match resolve_type(gte, table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
    var ginst = match git { Named as gn => gn.name; _ => return error { message = "explicit type-arguments did not resolve to a struct instance" } }
    match expected {
        Named as en => { if name_has_generic_base(en.name, stem) && en.name != ginst { return error { message = "the explicit type-arguments at construction disagree with the annotated type" } } }
        _ => { }
    }
    match type_table_find(table, ginst, "") {
        parser::TypeDecl as td => ConstructTarget { name = ginst; decl = td; is_self = false }
        error => {
            if !name_is_phantom_instance(ginst, table) {
                return error { message = $"internal: generic instance `{ginst}` was not stamped" }
            }
            var tmpl = match type_table_find_arity(table, stem, sl.type_args.len) { parser::TypeDecl as t => t; error as e => return e }
            ConstructTarget { name = ginst; decl = tmpl; is_self = false }
        }
    }
}

fn bare_construct_target(sl: parser::StructLit, env: Env, table: TypeTable): ConstructTarget | error {
    var nt = match resolve_named(sl.type_path, table, env.cur_ns, 0) { (@Type()) as t => t; error as e => return e }
    var canon = match nt { Named as n => n.name; _ => return error { message = "a struct literal requires a named struct type" } }
    var decl = match type_table_find_arity(table, canon, 0) {
        parser::TypeDecl as td => td
        error => return error { message = $"unknown type in a struct literal: {canon}" }
    }
    ConstructTarget { name = canon; decl = decl; is_self = false }
}

fn construct_target(sl: parser::StructLit, expected: @Type(), env: Env, table: TypeTable): ConstructTarget | error {
    if is_dot_sentinel(sl.type_path) { return dot_construct_target(expected, env, table) }
    if sl.type_args.len > 0 { return explicit_inst_target(sl, expected, env, table) }
    bare_construct_target(sl, env, table)
}

fn type_struct_lit(sl: parser::StructLit, expected: @Type(), env: Env, table: TypeTable): TExpr | error {
    if is_error_literal_prefix(sl) { return type_error_literal(sl, env, table) }
    var ct = match construct_target(sl, expected, env, table) { ConstructTarget as c => c; error as e => return e }
    var name = ct.name
    var decl = ct.decl
    var is_self_construct = ct.is_self
    var sb_fields = match decl.body {
        parser::StructBody as s => s.fields
        parser::ExternStructBody as esb => esb.fields
        parser::ClassBody as c => {
            match c.kind { ClassKind::Abstract => return error { message = $"`{name}` is abstract and cannot be instantiated directly" }; _ => { } }
            if !is_self_construct && name_last_segment(env.owner_type) != name_last_segment(name) {
                return error { message = $"a class literal is only legal inside the class's own methods — construct it via a static factory: {name}" }
            }
            match effective_class_fields(c, table) { []parser::Field as fs => fs; error as e => return e }
        }
        parser::TraitBody => return error { message = $"'{name}' is a trait and cannot be instantiated — derive it from a struct or class instead (`type X = struct {name} …`)" }
        _ => return error { message = $"struct-literal target {name} is not a struct" }
    }
    if sl.field_names.len != sb_fields.len { return error { message = "a struct literal must set exactly the declared fields (count mismatch)" } }

    var field_ns = if is_self_construct { env.cur_ns } else { type_ns_of(table, name) }
    var names: [sb_fields.len]str = []
    var vals: [sb_fields.len]TExpr = []
    var d = 0
    loop {
        if d >= sb_fields.len { break }
        var fname = sb_fields[d].name
        var found = sl.field_names.len
        var hits = 0
        var i: u64 = 0
        loop {
            if i >= sl.field_names.len { break }
            if sl.field_names[i] == fname { found = i; hits++ }
            i++
        }
        if hits == 0 { return error { message = "a struct literal is missing a declared field" } }
        if hits > 1 { return error { message = "a struct literal sets a field more than once" } }
        var ft = match resolve_type(sb_fields[d].type_ann, table, field_ns) { (@Type()) as t => t; error as e => return e }
        var val = match type_value_expected(sl.field_vals[found], ft, env, table) { TExpr as te => te; error as e => return e }
        match val.kind {
            TNumber as num => match ft {
                Prim as p => {
                    if !type_eq(val.type, ft) {
                        var fits = if num.is_float { prim_is_float(p.kind) }
                        else { prim_is_int(p.kind) && numint_fits(num.value, p.kind) }
                        if fits { val = TExpr { kind = val.kind; type = ft; line = val.line; col = val.col } }
                    }
                }
                _ => { }
            }
            _ => { }
        }
        var val_is_sentinel_slice = match val.type { Slice as vs => match vs.element { Void => true; _ => false }; _ => false }
        var ft_is_concrete_slice = match ft { Slice as fs => match fs.element { Void => false; _ => true }; _ => false }
        if val_is_sentinel_slice {
            if ft_is_concrete_slice {
                val = TExpr { kind = val.kind; type = ft; line = val.line; col = val.col }
            }
        }
        if !widens_into(val.type, ft, table) {
            if literal_adopts(val, ft) {
                val = TExpr { kind = val.kind; type = ft; line = val.line; col = val.col }
            } else {
                return error { message = "a struct-literal field value does not match the field's declared type" }
            }
        }
        names[d] = fname
        vals[d] = val
        d++
    }
    TExpr { kind = TStructInit { field_names = names; field_vals = vals }; type = Named { name = name }; line = 0; col = 0 }
}

fn name_has_generic_base(mname: str, stem: str): bool {
    var pfx = teko::str::concat(stem, "__g__")
    if mname.len < pfx.len { return false }
    var i = 0
    loop {
        if i >= pfx.len { break }
        if mname[i] != pfx[i] { return false }
        i++
    }
    true
}

fn type_index(ix: parser::Index, env: Env, table: TypeTable): TExpr | error {
    var recv = match type_expr(ix.receiver, env, table) { TExpr as te => te; error as e => return e }
    var idx = match type_expr(ix.index, env, table) { TExpr as te => te; error as e => return e }
    var iowner = value_op_owner(recv.type, table)
    if iowner != "" && owner_has_matching_operator(iowner, "__index", recv, idx, table) {
        return build_operator_call(iowner, "__index", ix.receiver, ix.index, env, table)
    }
    if !is_integer(idx.type) { return error { message = "a subscript index must be an integer" } }
    if is_str_type(recv.type) { return TExpr { kind = TIndex { receiver = recv; index = idx }; type = Byte { }; line = 0; col = 0 } }
    match recv.type {
        Slice as s => TExpr { kind = TIndex { receiver = recv; index = idx }; type = s.element; line = 0; col = 0 }
        Ptr => ptr_opaque_error()
        Uptr => ptr_opaque_error()
        _ => error { message = "cannot index a value of this type" }
    }
}

fn is_interp_formattable(t: @Type()): bool {
    if is_str_type(t) { return true }
    match t {
        Char => true
        Byte => true
        Error => true
        Prim => true
        _ => false
    }
}
fn interp_is_numeric(t: @Type()): bool {
    match t { Prim as p => true; _ => false }
}

fn datetime_formatter_of(t: @Type()): str {
    match t {
        Named as n => {
            var bare = name_last_segment(n.name)
            if bare == "Date" || bare == "DateTime" || bare == "date" || bare == "datetime" { return "date_to_string" }
            if bare == "Time" || bare == "time" { return "time_to_string" }
            ""
        }
        _ => ""
    }
}

fn desugar_datetime_hole(raw_hole: parser::Expr, hole_ns: str, fn_name: str, pattern: str, env: Env, table: TypeTable): TExpr | error {
    var segs: []parser::Segment = []
    if hole_ns != "" {
        var qi: u64 = 0
        var seg_start: u64 = 0
        loop {
            if qi + 1 >= hole_ns.len { break }
            if hole_ns[qi] == b':' && hole_ns[qi + 1] == b':' {
                segs = [..segs, parser::Segment { name = hole_ns.slice(seg_start, qi) }]
                qi = qi + 2
                seg_start = qi
            } else { qi++ }
        }
        segs = [..segs, parser::Segment { name = hole_ns.slice_from(seg_start) }]
    }
    segs = [..segs, parser::Segment { name = fn_name }]
    var pat_expr = parser::Expr { kind = parser::StrLit { text = pattern }; line = 0; col = 0 }
    var args: []parser::Expr = [raw_hole]
    args = [..args, pat_expr]
    var arg_names: []str = [""]
    arg_names = [..arg_names, ""]
    var call = parser::Call { callee = parser::Path { segments = segs }; args = args; arg_names = arg_names; owner_type_args = []; callee_type_args = [] }
    type_call(call, null, env, table)
}

fn type_interp(in: parser::Interp, env: Env, table: TypeTable): TExpr | error {
    var holes: []TExpr = []
    var specs: []TFSpec = []
    var i = 0
    loop {
        if i >= in.holes.len { break }
        var h = match type_expr(in.holes[i], env, table) { TExpr as te => te; error as e => return e }
        var dt_fmt = datetime_formatter_of(h.type)
        if dt_fmt != "" && i < in.specs.len {
            match in.specs[i].kind {
                parser::FSpecStatic as fs => {
                    var hole_ns = match h.type { Named as n => name_qualifier(n.name); _ => "" }
                    var dh = match desugar_datetime_hole(in.holes[i], hole_ns, dt_fmt, fs.s, env, table) { TExpr as te => te; error as e => return e }
                    holes = [..holes, dh]
                    specs = [..specs, TFSpec { kind = TFSpecNone { } }]
                    i++
                    continue
                }
                _ => { }
            }
        }
        if !is_interp_formattable(h.type) {
            return error { message = "interpolation hole type not supported in ROUND 0 (must be str/char/bool/byte/error/int/float)" }
        }
        holes = [..holes, h]
        if i < in.specs.len {
            var raw_sp = in.specs[i]
            var typed_sp = match raw_sp.kind {
                parser::FSpecNone => TFSpec { kind = TFSpecNone { } }
                parser::FSpecStatic as fs => {
                    if !interp_is_numeric(h.type) {
                        return error { message = "format spec requires a numeric hole (int or float)" }
                    }
                    TFSpec { kind = TFSpecStatic { s = fs.s } }
                }
                parser::FSpecDynamic as fd => {
                    if !interp_is_numeric(h.type) {
                        return error { message = "format spec requires a numeric hole (int or float)" }
                    }
                    var dyn_args: []TExpr = []
                    var k = 0
                    loop {
                        if k >= fd.args.len { break }
                        var da = match type_expr(fd.args[k], env, table) { TExpr as te => te; error as e => return e }
                        if !is_str_type(da.type) { return error { message = "dynamic format spec argument must be str" } }
                        dyn_args = [..dyn_args, da]
                        k++
                    }
                    TFSpec { kind = TFSpecDynamic { args = dyn_args } }
                }
            }
            specs = [..specs, typed_sp]
        } else {
            specs = [..specs, TFSpec { kind = TFSpecNone { } }]
        }
        i++
    }
    TExpr { kind = TInterp { pieces = in.pieces; holes = holes; specs = specs }; type = Named { name = "teko::base::str" }; line = 0; col = 0 }
}

fn type_in(n: parser::InExpr, env: Env, table: TypeTable): TExpr | error {
    var lhs = match type_expr(n.lhs, env, table) { TExpr as te => te; error as e => return e }
    if type_is_void(lhs.type) { return error { message = "a `void` expression cannot be an operand" } }
    if type_contains_ref(lhs.type) { return error { message = "a reference cannot be stored in a struct/variant/collection" } }
    var elems: [n.elems.len]TExpr = []
    var i = 0
    loop {
        if i >= n.elems.len { break }
        var el = match type_expr(n.elems[i], env, table) { TExpr as te => te; error as e => return e }
        if type_is_void(el.type) { return error { message = "a `void` expression cannot be an operand" } }
        if type_contains_ref(el.type) { return error { message = "a reference cannot be stored in a struct/variant/collection" } }
        if !is_comparable(lhs.type, el.type) { return error { message = "`in` element is not comparable to the left-hand operand" } }
        elems[i] = el
        i++
    }
    TExpr { kind = TInExpr { lhs = lhs; elems = elems }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

fn array_elem_contrib_type(ae: TArrayElem): @Type() {
    if ae.is_spread {
        match ae.expr.type { Slice as s => s.element; _ => ae.expr.type }
    } else {
        ae.expr.type
    }
}

fn array_elem_bare_literal(ae: TArrayElem): TExpr | null {
    if ae.is_spread { return null }
    match ae.expr.kind { TNumber => ae.expr; _ => null }
}

fn array_join_anchor(elems: []TArrayElem): @Type() | null {
    var i = 0
    loop {
        if i >= elems.len { break }
        match array_elem_bare_literal(elems[i]) {
            TExpr => { }
            null => return array_elem_contrib_type(elems[i])
        }
        i++
    }
    null
}

fn adopt_array_elem_literals(elems: []TArrayElem, anchor: @Type()): []TArrayElem {
    var out: []TArrayElem = []
    var i = 0
    loop {
        if i >= elems.len { break }
        var ae = elems[i]
        var next = match array_elem_bare_literal(ae) {
            TExpr as t => if literal_adopts(t, anchor) { TArrayElem { is_spread = false; expr = retype_literal(t, anchor) } } else { ae }
            null => ae
        }
        out = [..out, next]
        i++
    }
    out
}

fn type_array_lit(a: parser::ArrayLit, env: Env, table: TypeTable): TExpr | error {
    var typed: [a.elements.len]TArrayElem = []
    var i = 0
    loop {
        if i >= a.elements.len { break }
        var ae = a.elements[i]
        var el = match type_expr(ae.expr, env, table) { TExpr as te => te; error as e => return e }
        if ae.is_spread {
            var spread_elem = match el.type {
                Slice as s => s.element
                _ => return error { message = "a spread element (`..xs`) must be a slice (`[]T`)" }
            }
            if type_is_void(spread_elem) { return error { message = "a spread element cannot be an untyped empty slice" } }
        } else {
            if type_is_void(el.type) { return error { message = "a `void` expression cannot be an array element" } }
        }
        typed[i] = TArrayElem { is_spread = ae.is_spread; expr = el }
        i++
    }
    var elems = match array_join_anchor(typed) { (@Type()) as anchor => adopt_array_elem_literals(typed, anchor); null => typed }
    var et: @Type() = Void { }
    var i2 = 0
    loop {
        if i2 >= elems.len { break }
        var contrib = array_elem_contrib_type(elems[i2])
        if type_is_void(et) { et = contrib } else { et = type_join(et, contrib, table) }
        i2++
    }
    if type_contains_ref(et) { return error { message = "a reference cannot be stored in a struct/variant/collection" } }
    var final_elems = if a.elements.len != 0 && !type_has_sentinel(et) {
        var out: [elems.len]TArrayElem = []
        var j = 0
        loop {
            if j >= elems.len { break }
            var ael = elems[j]
            var retyped = !ael.is_spread && type_has_sentinel(ael.expr.type) && type_eq(ael.expr.type, et)
            out[j] = if retyped {
                    TArrayElem { is_spread = ael.is_spread; expr = TExpr { kind = ael.expr.kind; type = et; line = ael.expr.line; col = ael.expr.col } }
                } else {
                    ael
            }
            j++
        }
        out
    } else {
        elems
    }
    TExpr { kind = TArrayLit { elements = final_elems }; type = Slice { element = et }; line = 0; col = 0 }
}

fn member_const_symbol(type_canonical: str, member: str): str {
    teko::str::concat(type_canonical, teko::str::concat("::", member))
}

type MemberConstHit = struct { cd: parser::ConstDecl; declaring: parser::TypeDecl }

fn resolve_member_const_hit(owner: parser::TypeDecl, seg: str, table: TypeTable): MemberConstHit | null {
    var own = body_consts(owner.body)
    var i: u64 = 0
    loop {
        if i >= own.len { break }
        if own[i].name == seg { return MemberConstHit { cd = own[i]; declaring = owner } }
        i++
    }
    match owner.body {
        parser::ClassBody as cb => {
            if !cb.has_base { return null }
            var base_decl = match type_table_find(table, cb.base_name, "") { parser::TypeDecl as td => td; error => return null }
            resolve_member_const_hit(base_decl, seg, table)
        }
        _ => null
    }
}

fn member_const_visible(hit: MemberConstHit, table: TypeTable, ref_ns: str): error | null {
    match hit.cd.vis {
        parser::Visibility::Private => {
            var decl_ns = type_ns_of(table, hit.declaring.name)
            if decl_ns != ref_ns {
                return teko::error::err_loc(error { message = $"member const `{hit.cd.name}` is private to `{hit.declaring.name}` — mark it `pub`/`exp` to use it from another module" }, hit.cd.line, hit.cd.col)
            }
            null
        }
        _ => null
    }
}

fn find_member_const(owner: parser::TypeDecl, seg: str, table: TypeTable): TExpr | null {
    var hit = match resolve_member_const_hit(owner, seg, table) { MemberConstHit as h => h; null => return null }
    var owner_ns = type_ns_of(table, owner.name)
    var rty = match resolve_type(hit.cd.ty, table, owner_ns) { (@Type()) as t => t; error => return null }
    var sym = member_const_symbol(qualify(owner_ns, owner.name), seg)
    TExpr { kind = TVar { name = sym; is_func = false; func_ns = owner_ns }; type = rty; line = 0; col = 0 }
}

fn ns_value_visible(b: ValBinding, ref_ns: str): error | null {
    match b.vis {
        parser::Visibility::Private => {
            if b.ns != ref_ns {
                return error { message = $"const `{b.name}` is private to `{b.ns}` — mark it `pub`/`exp` to use it from another module" }
            }
            null
        }
        _ => null
    }
}

fn type_ns_qualified_value(pe: parser::PathExpr, member: str, type_err: error, env: Env): TExpr | error {
    var qualifier = path_qualifier(pe.path, pe.path.segments.len - 1)
    var b = match lookup_value_in_ns(env, member, qualifier) { ValBinding as vb => vb; error => return type_err }
    match ns_value_visible(b, env.cur_ns) { error as e => return e; null => { } }
    var is_fn = b.ns.len > 0 && (match b.type { Func => true; _ => false })
    TExpr { kind = TVar { name = member; is_func = is_fn; func_ns = b.ns }; type = b.type; line = 0; col = 0 }
}

fn type_path_expr(pe: parser::PathExpr, table: TypeTable, env: Env): TExpr | error {
    var p = pe.path
    if p.segments.len < 2 { return error { message = "a path expression must name an enum or flags member (`Type::Member`)" } }
    var member = p.segments[p.segments.len - 1].name
    var segs: []parser::Segment = []
    var i: u64 = 0
    loop {
        if i >= p.segments.len - 1 { break }
        segs = [..segs, p.segments[i]]
        i++
    }
    var et = match resolve_named(parser::Path { segments = segs }, table, env.cur_ns, 0) {
        (@Type()) as t => t
        error as e => return type_ns_qualified_value(pe, member, e, env)
    }
    var tname = match et { Named as n => n.name; _ => return error { message = "`Type::Member` requires a named enum or flags type" } }
    var decl = match type_table_find(table, tname, "") { parser::TypeDecl as td => td; error => return error { message = $"unknown type in a `Type::Member` path: {tname}" } }
    match resolve_member_const_hit(decl, member, table) {
        MemberConstHit as hit => {
            match member_const_visible(hit, table, env.cur_ns) { error as e => return e; null => { } }
            match find_member_const(decl, member, table) { TExpr as mref => return mref; null => { } }
        }
        null => { }
    }
    match decl.body {
        parser::EnumBody as eb => {
            var j: u64 = 0
            loop {
                if j >= eb.members.len { break }
                if eb.members[j] == member { return TExpr { kind = TPathExpr { enum_name = tname; member = member; ordinal = j; value = j }; type = et; line = 0; col = 0 } }
                j++
            }
            error { message = $"no member `{member}` in enum `{tname}`" }
        }
        parser::FlagsBody as fb => {
            if fb.members.len > 64 { return error { message = "a flags type may declare at most 64 members (bit 63 is the last) — write this as two flags types instead" } }
            var j: u64 = 0
            loop {
                if j >= fb.members.len { break }
                if fb.members[j] == member { return TExpr { kind = TPathExpr { enum_name = tname; member = member; ordinal = j; value = (1 to u64) << j }; type = et; line = 0; col = 0 } }
                j++
            }
            error { message = $"no member `{member}` in the flags type `{tname}`" }
        }
        _ => error { message = "`Type::Member` requires an `enum` or `flags` type" }
    }
}

fn type_borrow_expr(b: parser::Borrow, env: Env, table: TypeTable): TExpr | error {
    var to = match type_expr(b.operand, env, table) { TExpr as x => x; error as e => return e }
    if is_ptr_or_uptr(to.type) { return ptr_opaque_error() }
    match to.kind {
        TVar as v => match lookup_binding(env, v.name) {
            ValBinding as vb => {
                if !vb.is_mut { return error { message = $"cannot take a reference to immutable `{v.name}` (a borrow needs a mutable target)" } }
                TExpr { kind = TBorrow { operand = to }; type = Reference { inner = to.type }; line = 0; col = 0 }
            }
            error as e => e
        }
        _ => error { message = "only a mutable variable can be borrowed with `&` (an lvalue) — got a non-lvalue expression" }
    }
}

fn type_dispatch(e: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    match e.kind {
        parser::Number as n => type_number(n)
        parser::StrLit as s => type_strlit(s)
        parser::ByteStrLit as bs => type_bytestrlit(bs)
        parser::ByteLit as b => type_bytelit(b)
        parser::CharLit as c => type_charlit(c)
        parser::BoolLit as bl => type_boollit(bl)
        parser::NullLit as nl => type_nulllit(nl)
        parser::Var as v => type_var(v, env)
        parser::Binary as b => type_binary(b, env, table)
        parser::Unary as u => type_unary(u, env, table)
        parser::Compare as c => type_compare(c, env, table)
        parser::Call as cl => {
            match svc_guard_arg_list(cl.args) { error as e => return e; null => { } }
            type_call(cl, null, env, table)
        }
        parser::IfExpr as f => type_if(f, env, table)
        parser::MatchExpr as m => type_match(m, env, table)
        parser::FieldAccess as fa => type_field_access(fa, env, table)
        parser::Cast as c => type_cast(c, env, table)
        parser::MethodCall as mc => {
            match svc_guard_arg_list(mc.args) { error as e => return e; null => { } }
            match type_expr(mc.receiver, env, table) {
                TExpr as te => {
                    if is_ptr_or_uptr(te.type) {
                        match type_ptr_wrap(mc, te.type, env, table) {
                            TExpr as we => we
                            error as e => e
                            NotPtrOp => error { message = $"the opaque `{type_render(te.type)}` has only `__wrap<T>()` — got `.{mc.method}(…)`" }
                        }
                    } else if is_flags_named(te.type, table) {
                        if flags_named_has_user_method(te.type, mc.method, table) { type_method_call(mc, env, table) } else { type_flags_method(mc, env, table) }
                    } else { type_method_call(mc, env, table) }
                }
                error => type_method_call(mc, env, table)
            }
        }
        parser::PathExpr as pe => type_path_expr(pe, table, env)
        parser::StructLit as sl => type_struct_lit(sl, Void { }, env, table)
        parser::Index as ix => type_index(ix, env, table)
        parser::Interp as in => type_interp(in, env, table)
        parser::InExpr as n => type_in(n, env, table)
        parser::ArrayLit as a => type_array_lit(a, env, table)
        parser::Lambda as lam => type_lambda(lam, Void { }, env, table)
        parser::Borrow as b => type_borrow_expr(b, env, table)
        parser::Block as blk => type_block_expr(blk, env, table)
        parser::MacroCall as mc => type_macro_call(mc, env, table)
    }
}

fn type_macro_call(mc: parser::MacroCall, env: Env, table: TypeTable): TExpr | error {
    var name = if mc.callee.segments.len > 0 { mc.callee.segments[mc.callee.segments.len - 1].name } else { "" }
    match tt_find_comptime(table, name) {
        ComptimeReg as reg => type_comptime_call(mc, reg.decl, env, table)
        null => error { message = $"`@{name}` names no `comptime` in scope — a `@name(...)` call must resolve to a `comptime` declaration" }
    }
}

fn type_comptime_call(mc: parser::MacroCall, cd: parser::ComptimeDecl, env: Env, table: TypeTable): TExpr | error {
    var args = match type_comptime_args(mc.args, env, table) { []TExpr as a => a; error as e => return e }
    var targs = match resolve_type_args(mc.callee_type_args, table, env.cur_ns) { []@Type() as t => t; error as e => return e }
    var ret = match resolve_type(cd.ret, table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
    TExpr { kind = TCall { overload_suffix = ""; callee = mc.callee; args = args; call_ns = comptime_call_ns(); is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = targs; ret_extra = [] }; type = ret; line = 0; col = 0 }
}

pub fn comptime_call_ns(): str { "@comptime" }

fn type_comptime_args(args: []parser::Expr, env: Env, table: TypeTable): []TExpr | error {
    var out: []TExpr = []
    var i: u64 = 0
    loop {
        if i >= args.len { break }
        var a = match type_expr(args[i], env, table) { TExpr as te => te; error as e => return e }
        out = [..out, a]
        i++
    }
    out
}

fn resolve_type_args(targs: []@TypeExpr(), table: TypeTable, ref_ns: str): []@Type() | error {
    var out: []@Type() = []
    var i: u64 = 0
    loop {
        if i >= targs.len { break }
        var t = match resolve_type(targs[i], table, ref_ns) { (@Type()) as ty => ty; error as e => return e }
        out = [..out, t]
        i++
    }
    out
}

fn type_block_expr(blk: parser::Block, env: Env, table: TypeTable): TExpr | error {
    var tb = match type_block(blk.body, env, table) { TypedBlock as bk => bk; error as e => return e }
    if tblock_diverges(tb.stmts) { return error { message = "a block used as a value cannot diverge — it must end in a value expression" } }
    var vt = tblock_type(tb.stmts)
    if type_is_void(vt) { return error { message = "a block used as a value must end in a value expression, not a statement" } }
    TExpr { kind = TBlockExpr { body = tb.stmts }; type = vt; line = 0; col = 0 }
}

fn type_expr(e: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    match type_dispatch(e, env, table) {
        TExpr as te => TExpr { kind = te.kind; type = te.type; line = e.line; col = e.col }
        error as inner => {
            if inner.line == 0 { teko::error::err_loc(inner, e.line, e.col) } else { inner }
        }
    }
}

fn tblock_type(stmts: []@TStatement()): @Type() {
    if stmts.len == 0 { return Void { } }
    match stmts[stmts.len - 1] {
        TExprStmt as es => es.expr.type
        _ => Void { }
    }
}

pub fn tcall_is_diverging_builtin(c: TCall): bool {
    if c.is_closure_call || c.is_iface_dispatch { return false }
    if c.call_ns != "teko::runtime" { return false }
    var name = c.callee.segments[c.callee.segments.len - 1].name
    name == "panic" || name == "exit"
}

pub fn texpr_diverges(e: TExpr): bool {
    match e.kind {
        TCall as c => tcall_is_diverging_builtin(c)
        TMatchExpr as m => {
            if m.arms.len == 0 { return false }
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if !tblock_diverges(m.arms[i].body) { return false }
                i++
            }
            true
        }
        TIfExpr as f => f.has_else && tblock_diverges(f.then_blk) && tblock_diverges(f.else_blk)
        _ => false
    }
}

fn tblock_diverges(stmts: []@TStatement()): bool {
    if stmts.len == 0 { return false }
    match stmts[stmts.len - 1] {
        TReturn => true
        TBreakStmt => true
        TContinueStmt => true
        TExprStmt as es => {
            if texpr_diverges(es.expr) { return true }
            match es.expr.kind {
                TIfExpr as f => f.has_else && tblock_diverges(f.then_blk) && tblock_diverges(f.else_blk)
                TMatchExpr as m => {
                    if m.arms.len == 0 { return false }
                    var i = 0
                    loop {
                        if i >= m.arms.len { break }
                        if !tblock_diverges(m.arms[i].body) { return false }
                        i++
                    }
                    true
                }
                _ => false
            }
        }
        _ => false
    }
}

fn type_block_out_cap(stmts: []@Statement()): u64 {
    var cap: u64 = 0
    var i: u64 = 0
    loop {
        if i >= stmts.len { break }
        match stmts[i] {
            MultiBind as mb => { cap = cap + mb.targets.len + mb.values.len + 2 }
            _ => { cap = cap + 1 }
        }
        i++
    }
    cap
}

fn type_block(stmts: []@Statement(), env: Env, table: TypeTable): TypedBlock | error {
    var cur = env
    var out: [type_block_out_cap(stmts)]@TStatement() = []
    var k: u64 = 0
    var i = 0
    loop {
        if i >= stmts.len { break }
        var handled = false
        if i + 1 == stmts.len {
            match stmts[i] {
                ExprStmt as es => {
                    if expr_is_dot_construction(es.expr) && !type_is_void(cur.ret_expected) {
                        var te = match type_dot_tail(es.expr, cur, table) { TExpr as x => x; error as e => return e }
                        out[k] = TExprStmt { expr = te }
                        k++
                        handled = true
                    }
                    match es.expr.kind {
                        IfExpr as f => {
                            if f.has_else {
                                var te = match type_expr(es.expr, cur, table) { TExpr as x => x; error as e => return e }
                                out[k] = TExprStmt { expr = te }
                                k++
                                handled = true
                            }
                        }
                        MatchExpr => {
                            var te = match type_expr(es.expr, cur, table) { TExpr as x => x; error as e => return e }
                            out[k] = TExprStmt { expr = te }
                            k++
                            handled = true
                        }
                        _ => { }
                    }
                }
                _ => { }
            }
        }
        if !handled {
            match stmts[i] {
                MultiBind as mb => {
                    var seq = match type_multibind(mb, cur, table) { TStmtSeq as sq => sq; error as e => return e }
                    var j: u64 = 0
                    loop {
                        if j >= seq.stmts.len { break }
                        out[k] = seq.stmts[j]
                        k++
                        j++
                    }
                    cur = seq.env
                    handled = true
                }
                _ => { }
            }
        }
        if !handled {
            var ts = match type_statement(stmts[i], cur, table) { TypedStmt as t => t; error as e => return e }
            out[k] = ts.node
            k++
            cur = ts.env
        }
        i++
    }
    var trimmed: [k]@TStatement() = []
    var ti: u64 = 0
    loop {
        if ti >= k { break }
        trimmed[ti] = out[ti]
        ti++
    }
    TypedBlock { stmts = trimmed; env = cur }
}

fn type_if(f: parser::IfExpr, env: Env, table: TypeTable): TExpr | error {
    var c = match type_expr(f.cond, env, table) { TExpr as te => te; error as e => return e }
    if !is_bool(c.type) { return error { message = "an `if` condition must be a bool" } }
    if !f.has_else { return error { message = "an `if` used as a value needs an `else`" } }
    var tb = match type_block(f.then_blk, env, table) { TypedBlock as bk => bk; error as e => return e }
    var eb = match type_block(f.else_blk, env, table) { TypedBlock as bk => bk; error as e => return e }
    var tt = tblock_type(tb.stmts)
    var et = tblock_type(eb.stmts)
    var tl = trailing_number(tb.stmts)
    var el = trailing_number(eb.stmts)
    var then_adopts = match tl { TExpr as t => literal_adopts(t, et); null => false }
    if then_adopts { tt = et }
    else {
        var else_adopts = match el { TExpr as t => literal_adopts(t, tt); null => false }
        if else_adopts { et = tt }
    }
    var joined = type_join(tt, et, table)
    TExpr { kind = TIfExpr { cond = c; then_blk = tb.stmts; has_else = true; else_blk = eb.stmts }; type = joined; line = 0; col = 0 }
}

fn type_if_stmt(f: parser::IfExpr, env: Env, table: TypeTable): TExpr | error {
    var c = match type_expr(f.cond, env, table) { TExpr as te => te; error as e => return e }
    if !is_bool(c.type) { return error { message = "an `if` condition must be a bool" } }
    var tb = match type_block(f.then_blk, env, table) { TypedBlock as bk => bk; error as e => return e }
    if f.has_else {
        var eb = match type_block(f.else_blk, env, table) { TypedBlock as bk => bk; error as e => return e }
        return TExpr { kind = TIfExpr { cond = c; then_blk = tb.stmts; has_else = true; else_blk = eb.stmts }; type = Void { }; line = 0; col = 0 }
    }
    TExpr { kind = TIfExpr { cond = c; then_blk = tb.stmts; has_else = false; else_blk = tb.stmts }; type = Void { }; line = 0; col = 0 }
}

fn type_arm(a: parser::Arm, subject: @Type(), env: Env, table: TypeTable): TArm | error {
    var e2 = match check_pattern(a.pattern, subject, env, table) { Env as e => e; error as err => return err }
    var body = match type_block(a.body, e2, table) { TypedBlock as bk => bk; error as err => return err }
    var guard = unread_guard_placeholder()
    if a.has_when {
        var g = match type_expr(a.guard, e2, table) { TExpr as te => te; error as err => return err }
        if !is_bool(g.type) { return error { message = "a `when` guard must be a bool" } }
        guard = g
    }
    TArm { pattern = a.pattern; has_when = a.has_when; guard = guard; body = body.stmts }
}

fn match_arm_literal_leaf(a: TArm): TExpr | null {
    if tblock_diverges(a.body) { return null }
    trailing_number(a.body)
}

fn match_join_anchor(arms: []TArm): @Type() | null {
    var i = 0
    loop {
        if i >= arms.len { break }
        var a = arms[i]
        if !tblock_diverges(a.body) {
            match match_arm_literal_leaf(a) {
                TExpr => { }
                null => return tblock_type(a.body)
            }
        }
        i++
    }
    null
}

fn adopt_match_arm_literals(arms: []TArm, anchor: @Type()): []TArm {
    var out: [arms.len]TArm = []
    var i = 0
    loop {
        if i >= arms.len { break }
        var a = arms[i]
        var next = match match_arm_literal_leaf(a) {
            TExpr as t => if literal_adopts(t, anchor) { TArm { pattern = a.pattern; has_when = a.has_when; guard = a.guard; body = retype_block_trailing(a.body, anchor) } } else { a }
            null => a
        }
        out[i] = next
        i++
    }
    out
}

fn type_match(m: parser::MatchExpr, env: Env, table: TypeTable): TExpr | error {
    var s = match type_expr(m.subject, env, table) { TExpr as te => te; error as e => return e }
    if m.arms.len == 0 { return error { message = "a `match` needs at least one arm" } }
    var typed: [m.arms.len]TArm = []
    var i = 0
    loop {
        if i >= m.arms.len { break }
        var ai = match type_match_arm(m.arms[i], s.type, env, table) { TArm as a => a; error as e => return e }
        typed[i] = ai
        i++
    }
    var arms = match match_join_anchor(typed) { (@Type()) as anchor => adopt_match_arm_literals(typed, anchor); null => typed }
    var have_type = false
    var first: @Type() = Void { }
    var j = 0
    loop {
        if j >= arms.len { break }
        if !tblock_diverges(arms[j].body) {
            var t = tblock_type(arms[j].body)
            if !have_type { first = t; have_type = true }
            else { first = type_join(first, t, table) }
        }
        j++
    }
    var rarms = match resolve_foreach_placeholders(m.arms, s.type) { []parser::Arm as a => a; error as e => return e }
    if !exhaustive(rarms, s.type, table, env.cur_ns) { return error { message = "non-exhaustive `match` (cover all cases or add `_`)" } }
    var result = if have_type { first } else { Void { } }
    TExpr { kind = TMatchExpr { subject = s; arms = arms }; type = result; line = 0; col = 0 }
}

fn type_match_stmt(m: parser::MatchExpr, env: Env, table: TypeTable): TExpr | error {
    var s = match type_expr(m.subject, env, table) { TExpr as te => te; error as e => return e }
    var arms: [m.arms.len]TArm = []
    var i = 0
    loop {
        if i >= m.arms.len { break }
        var ai = match type_match_arm(m.arms[i], s.type, env, table) { TArm as a => a; error as e => return e }
        arms[i] = ai
        i++
    }
    var rarms = match resolve_foreach_placeholders(m.arms, s.type) { []parser::Arm as a => a; error as e => return e }
    if !exhaustive(rarms, s.type, table, env.cur_ns) { return error { message = "non-exhaustive `match` (cover all cases or add `_`)" } }
    TExpr { kind = TMatchExpr { subject = s; arms = arms }; type = Void { }; line = 0; col = 0 }
}

fn type_value_expected(e: parser::Expr, expected: @Type(), env: Env, table: TypeTable): TExpr | error {
    match e.kind {
        parser::StructLit as sl => type_struct_lit(sl, expected, env, table)
        parser::Lambda as lam => type_lambda(lam, expected, env, table)
        parser::ArrayLit as al => {
            if is_iface_slice(expected, table) { return type_array_lit_expected(al, expected, env, table) }
            adopt_value_to_expected(e, expected, env, table)
        }
        parser::NullLit => {
            if null_widens_into(expected, table) { return TExpr { kind = TNullLit { }; type = Null { }; line = e.line; col = e.col } }
            adopt_value_to_expected(e, expected, env, table)
        }
        parser::Call as cl => {
            match svc_guard_arg_list(cl.args) { error as se => return se; null => { } }
            type_call(cl, expected, env, table)
        }
        _ => adopt_value_to_expected(e, expected, env, table)
    }
}

fn adopt_value_to_expected(e: parser::Expr, expected: @Type(), env: Env, table: TypeTable): TExpr | error {
    var t = match type_expr(e, env, table) { TExpr as te => te; error as err => return err }
    if assignable_to(t.type, expected, table) { return t }
    if literal_adopts(t, expected) { return retype_literal(t, expected) }
    t
}

fn param_takes_born_literal(t: @Type()): bool {
    match t {
        Byte => true
        Prim as p => prim_is_int(p.kind) || prim_is_float(p.kind)
        Slice => true
        _ => false
    }
}

fn arg_wants_expected(arg: parser::Expr, param: @Type()): bool {
    var composite = match arg.kind {
        parser::IfExpr => true
        parser::MatchExpr => true
        parser::ArrayLit => true
        _ => false
    }
    if !composite { return false }
    param_takes_born_literal(param)
}

fn is_iface_slice(t: @Type(), table: TypeTable): bool {
    match t {
        Slice as s => match s.element {
            Named as n => is_interface_name(n.name, table)
            _ => false
        }
        _ => false
    }
}

fn type_array_lit_expected(a: parser::ArrayLit, expected: @Type(), env: Env, table: TypeTable): TExpr | error {
    var elem = match expected { Slice as s => s.element; _ => return error { message = "internal: type_array_lit_expected needs a slice expected type" } }
    var elems: [a.elements.len]TArrayElem = []
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        var e = match type_expr(a.elements[i].expr, env, table) { TExpr as te => te; error as err2 => return err2 }
        if a.elements[i].is_spread {
            var selem = match e.type {
                Slice as fs => fs.element
                _ => return error { message = "a spread element (`..xs`) must be a slice (`[]T`)" }
            }
            var selem_is_void = match selem { Void => true; _ => false }
            if selem_is_void { return error { message = "a spread element (`..xs`) must be a slice (`[]T`)" } }
            if !assignable_to(selem, elem, table) {
                return teko::error::err_typed(error { message = "array element type mismatch" }, type_render(elem), type_render(selem))
            }
        } else {
            if type_is_void(e.type) { return error { message = "a `void` expression cannot be an array element" } }
            if !assignable_to(e.type, elem, table) {
                return teko::error::err_typed(error { message = "array element type mismatch" }, type_render(elem), type_render(e.type))
            }
        }
        elems[i] = TArrayElem { is_spread = a.elements[i].is_spread; expr = e }
        i++
    }
    TExpr { kind = TArrayLit { elements = elems }; type = expected; line = 0; col = 0 }
}

fn type_ref_binding_value(bv: parser::Expr, rf: Reference, env: Env, table: TypeTable): TExpr | error {
    var v = match type_expr(bv, env, table) { TExpr as te => te; error as e => return e }
    match v.type {
        Reference as src => {
            if !type_eq(src.inner, rf.inner) {
                return teko::error::err_typed(error { message = "a forwarded `ref` binding must name the SAME referent type as the reference it aliases" }, type_render(rf.inner), type_render(src.inner))
            }
            return v
        }
        _ => { }
    }
    if !type_eq(v.type, rf.inner) {
        return teko::error::err_typed(error { message = "a `ref` binding's source must be the referent's own type (or another reference)" }, type_render(rf.inner), type_render(v.type))
    }
    ref_source_mutable_var(bv, v, env)
}

fn ref_source_mutable_var(bv: parser::Expr, v: TExpr, env: Env): TExpr | error {
    var var = match bv.kind { parser::Var as x => x; _ => return error { message = "a `ref` binding's source must be a mutable variable (a `var`) or another reference — not an expression" } }
    var vb = match lookup_binding(env, var.name) { ValBinding as b => b; error => return error { message = "a `ref` binding's source must be a mutable variable (a `var`) or another reference" } }
    if vb.is_mut { return v }
    error { message = $"cannot take a reference to immutable `{var.name}` — a `ref` binding needs a mutable source (a `var`) or another reference" }
}

fn type_inferred_ref_value(bv: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    var v = match type_expr(bv, env, table) { TExpr as te => te; error as e => return e }
    match v.type { Reference => return v; _ => { } }
    ref_source_mutable_var(bv, v, env)
}

fn ref_bound_of(t: @Type()): @Type() {
    match t { Reference => t; _ => Reference { inner = t } }
}

fn value_is_empty_array_lit(e: parser::Expr): bool {
    match e.kind { parser::ArrayLit as al => al.elements.len == 0; _ => false }
}

fn type_sized_array_binding(b: parser::Binding, sa: parser::SizedArrayType, env: Env, table: TypeTable): TExpr | error {
    var elem = match resolve_type(sa.element, table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
    match elem { Reference => return error { message = "a reference cannot be a sized-array element" }; _ => { } }
    if !value_is_empty_array_lit(b.value) { return error { message = "a `[n]T` binding initializes to `[]` — n zeroed slots; write positions with `x[i] = v`" } }
    var sz = match type_expr(sa.size, env, table) { TExpr as te => te; error as e => return e }
    if !is_integer(sz.type) { return error { message = "a sized-array length `[n]T` must be an integer" } }
    TExpr { kind = TSliceOfLen { size = sz; element = elem }; type = Slice { element = elem }; line = b.value.line; col = b.value.col }
}

fn type_binding_value(b: parser::Binding, env: Env, table: TypeTable): TExpr | error {
    if b.is_ref && !b.has_type { return type_inferred_ref_value(b.value, env, table) }
    if b.has_type {
        match b.type_ann { parser::SizedArrayType as sa => return type_sized_array_binding(b, sa, env, table); _ => { } }
        var at = match resolve_type(b.type_ann, table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
        match at { Reference as rf => return type_ref_binding_value(b.value, rf, env, table); _ => { } }
        return type_value_expected(b.value, at, env, table)
    }
    type_expr(b.value, env, table)
}

fn bind_value_into_annotation(v: TExpr, raw: parser::Expr, ann: @Type(), table: TypeTable): TExpr | error {
    match struct_iface_named_stop(v.type, ann, table) { error as se => return se; null => { } }
    match widen_value_into(v, ann) { TExpr as w => return w; null => { } }
    match bytes_str_reinterpret(v, ann) { TExpr as w => return w; null => { } }
    match annotated_literal_ok(raw, ann) {
        null => retype_literal(v, ann)
        error as e => teko::error::err_typed(e, type_render(ann), type_render(v.type))
    }
}

fn explicit_binding_gate(b: parser::Binding, env: Env): error | null {
    if !env.explicit { return null }
    if b.has_type { return null }
    match b.target {
        parser::SimpleName as sn => {
            if sn.name == "_" { return null }
            teko::error::err_loc(error { message = $"`{sn.name}`: declaração precisa de tipo explícito (--explicit)" }, b.value.line, b.value.col)
        }
        _ => null
    }
}

fn type_binding(b: parser::Binding, env: Env, table: TypeTable): TypedStmt | error {
    match explicit_binding_gate(b, env) { error as e => return e; null => { } }
    var v = match type_binding_value(b, env, table) { TExpr as te => te; error as e => return e }
    if type_is_mret_aggregate(v.type) {
        return error { message = "a multiple-return value cannot be bound to a single name — destructure it, e.g. `var a, b = f(…)` (a multiple-return call yields no first-class tuple value to capture)" }
    }
    var bound = if b.is_ref && !b.has_type { ref_bound_of(v.type) } else { v.type }
    if type_is_void(bound) { return error { message = "cannot bind a `void` expression — it yields no value" } }
    if b.has_type {
        var at = match resolve_type(b.type_ann, table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
        var is_ref_binding = match at { Reference => true; _ => false }
        if !is_ref_binding && !assignable_to(v.type, at, table) {
            v = match bind_value_into_annotation(v, b.value, at, table) { TExpr as x => x; error as e => return e }
        }
        bound = at
        v = adopt_sentinel_slice_type(v, bound)
    }
    var bound_is_sentinel_slice = match bound { Slice as bs2 => match bs2.element { Void => true; _ => false }; _ => false }
    if bound_is_sentinel_slice {
        return error { message = "an empty list needs a known element type; annotate the binding (e.g. `var xs: []i32 = …`)" }
    }
    match bound {
        Reference => if b.kind != parser::BindKind::Var { return error { message = "a reference binding is spelled `ref r: T = x` (write-through, requires a mutable source)" } }
        _ => if type_contains_ref(bound) && !is_ref_null_variant(bound) { return error { message = "a reference cannot be bound to a local (parameter-only in this version)" } }
    }
    var node = TBinding { kind = b.kind; target = b.target; bound = bound; value = v }
    match b.target {
        parser::SimpleName as sn => TypedStmt { node = node; env = define(env, sn.name, bound, bind_is_mut(b.kind)) }
        parser::DestructurePattern => TypedStmt { node = node; env = env }
    }
}

type LvalueRoot = struct { reachable: bool; name: str }
fn lvalue_root(e: parser::Expr): LvalueRoot {
    match e.kind {
        parser::Var as v => LvalueRoot { reachable = true; name = v.name }
        parser::FieldAccess as fa => lvalue_root(fa.receiver)
        _ => LvalueRoot { reachable = false; name = "" }
    }
}

fn field_write_root_writable(receiver: parser::Expr, env: Env): error | null {
    var root = lvalue_root(receiver)
    if !root.reachable { return error { message = "cannot assign to a field of a temporary value — the receiver is not a mutable variable" } }
    var rb = match lookup_binding(env, root.name) { ValBinding as vb => vb; error as e => return e }
    if rb.is_mut { return null }
    error { message = $"cannot assign to a field of immutable `{root.name}` — only the declaring type's own method can write it" }
}

fn property_write_dispatch(fa: parser::FieldAccess, a: parser::Assign, pinfo: PropInfo, env: Env, table: TypeTable): TypedStmt | error {
    if !pinfo.has_set {
        return error { message = $"property '{fa.field}' is read-only — it has a getter but no setter" }
    }
    if a.op != lexer::TokenKind::Assign {
        return error { message = $"a compound assignment on property '{fa.field}' is not supported yet — write `x.{fa.field} = x.{fa.field} <op> v` explicitly" }
    }
    var mc = parser::MethodCall { receiver = fa.receiver; method = "__set_" ~ fa.field; args = [a.value]; arg_names = [""]; type_args = [] }
    var call = match type_method_call(mc, env, table) { TExpr as te => te; error as e => return e }
    TypedStmt { node = TExprStmt { expr = call }; env = env }
}

fn property_write(fa: parser::FieldAccess, a: parser::Assign, env: Env, table: TypeTable): TypedStmt | null | error {
    var recv = match type_expr(fa.receiver, env, table) { TExpr as te => te; error => return null }
    var name = match recv.type { Named as n => n.name; _ => return null }
    match find_property(name, fa.field, table) {
        PropInfo as pinfo => match property_write_dispatch(fa, a, pinfo, env, table) {
            TypedStmt as ts => ts
            error as e => e
        }
        null => null
    }
}

fn field_is_readonly(sname: str, fname: str, table: TypeTable): bool {
    var decl = match type_table_find(table, sname, "") { parser::TypeDecl as td => td; error => return false }
    var sb = match decl.body { parser::StructBody as s => s; _ => return false }
    if sb.is_readonly { return true }
    var i = 0 to u64
    loop {
        if i >= sb.fields.len { break }
        if sb.fields[i].name == fname { return sb.fields[i].is_readonly }
        i++
    }
    false
}

fn type_field_assign(a: parser::Assign, env: Env, table: TypeTable): TypedStmt | error {
    var probe_fa = match a.target.kind { parser::FieldAccess as fa => fa; _ => return error { message = "assignment target is not a field access (internal: parser guarantees a field LHS)" } }
    match property_write(probe_fa, a, env, table) {
        TypedStmt as ts => return ts
        error as e => return e
        null => { }
    }
    var lhs = match type_expr(a.target, env, table) { TExpr as te => te; error as e => return e }
    var lhs_fa = match a.target.kind { parser::FieldAccess as fa => fa; _ => return error { message = "assignment target is not a field access (internal: parser guarantees a field LHS)" } }
    var recv = match type_expr(lhs_fa.receiver, env, table) { TExpr as te => te; error as e => return e }
    var field_t = lhs.type
    var ref_inner = match recv.type { Reference as rf => rf.inner; _ => Void { } }
    var is_ref_deref = match recv.type { Reference => (lhs_fa.field == "value"); _ => false }
    if is_ref_deref {
        var ref_name = match lhs_fa.receiver.kind { parser::Var as v => v.name; _ => return error { message = "`.value` deref-assignment requires a bare `Ref<T>` handle on the left" } }
        var dv = match type_expr(a.value, env, table) { TExpr as te => te; error as e => return e }
        if !assignable_to(dv.type, ref_inner, table) {
            if !literal_adopts(dv, ref_inner) { return teko::error::err_typed(error { message = "assigned value does not match the referenced type" }, type_render(ref_inner), type_render(dv.type)) }
            dv = TExpr { kind = dv.kind; type = ref_inner; line = dv.line; col = dv.col }
        }
        return TypedStmt { node = TAssign { kind = parser::AssignKind::RefDeref; name = ref_name; op = a.op; bound = ref_inner; value = dv; deref = true; target = no_texpr() }; env = env }
    }

    match recv.type {
        Named as n => if field_is_readonly(n.name, lhs_fa.field, table) {
            return error { message = $"cannot assign to readonly field `{lhs_fa.field}` of `{n.name}` — a readonly field is set only at construction (`{n.name} {{ … }}`) or by a declaration default" }
        }
        _ => { }
    }

    match field_write_root_writable(lhs_fa.receiver, env) { error as e => return e; null => { } }

    var v = match type_expr(a.value, env, table) { TExpr as te => te; error as e => return e }
    if type_contains_ref(field_t) || type_contains_ref(v.type) { return error { message = "a reference cannot be stored in a field (parameter-only in this version)" } }
    var coerced = match coerce_value_into(v, field_t, table, "assigned value does not match the field type") { TExpr as x => x; error as e => return e }
    TypedStmt { node = TAssign { kind = parser::AssignKind::Field; name = ""; op = a.op; bound = field_t; value = adopt_sentinel_slice_type(coerced, field_t); deref = false; target = lhs }; env = env }
}

fn index_assign_slice_element(recv: TExpr): @Type() | error {
    match recv.type {
        Slice as sl => match sl.element { Void => error { message = "cannot assign into an untyped empty slice — its element type is unknown" }; _ => sl.element }
        _ => teko::error::err_typed(error { message = "index-assignment target is not a slice — only a slice `[]T` supports `ids[i] = v`" }, "[]T", type_render(recv.type))
    }
}

fn type_index_assign(a: parser::Assign, env: Env, table: TypeTable): TypedStmt | error {
    var ix = match a.target.kind { parser::Index as x => x; _ => return error { message = "assignment target is not an index access (internal: parser guarantees an index LHS)" } }
    var recv0 = match type_expr(ix.receiver, env, table) { TExpr as te => te; error as e => return e }
    var recv = deref_ref_value(recv0)
    var elem = match index_assign_slice_element(recv) { (@Type()) as t => t; error as e => return e }
    var root = lvalue_root(ix.receiver)
    if !root.reachable { return error { message = "cannot assign into an element of a temporary value — the receiver is not a mutable variable" } }
    var rb = match lookup_binding(env, root.name) { ValBinding as vb => vb; error as e => return e }
    if !rb.is_mut { return error { message = $"cannot assign into an element of immutable `{root.name}` — pass it as `ref []T` to write positions" } }
    var idxe = match type_expr(ix.index, env, table) { TExpr as te => te; error as e => return e }
    if !is_integer(idxe.type) { return error { message = "a subscript index must be an integer" } }
    var lhs = TExpr { kind = TIndex { receiver = recv; index = idxe }; type = elem; line = a.target.line; col = a.target.col }
    var v = match type_expr(a.value, env, table) { TExpr as te => te; error as e => return e }
    if type_contains_ref(elem) || type_contains_ref(v.type) { return error { message = "a reference cannot be stored in a slice element (parameter-only in this version)" } }
    v = match coerce_value_into(v, elem, table, "assigned value does not match the slice element type") { TExpr as x => x; error as e => return e }
    TypedStmt { node = TAssign { kind = parser::AssignKind::Index; name = ""; op = a.op; bound = elem; value = v; deref = false; target = lhs }; env = env }
}

fn type_assign(a: parser::Assign, env: Env, table: TypeTable): TypedStmt | error {
    if expr_is_svc_claim(a.value) { return svc_escape_error() }
    var is_field = match a.kind { parser::AssignKind::Field => true; _ => false }
    if is_field { return type_field_assign(a, env, table) }
    var is_index = match a.kind { parser::AssignKind::Index => true; _ => false }
    if is_index { return type_index_assign(a, env, table) }
    var tb = match lookup_binding(env, a.name) { ValBinding as vb => vb; error as e => return e }
    if !a.deref {
        match tb.type {
            Reference as rf => {
                var wv = match type_expr(a.value, env, table) { TExpr as te => te; error as e => return e }
                var rhs_is_ref = match wv.type { Reference => true; _ => false }
                if !rhs_is_ref {
                    if !assignable_to(wv.type, rf.inner, table) {
                        if !literal_adopts(wv, rf.inner) { return teko::error::err_typed(error { message = "assigned value does not match the referenced type" }, type_render(rf.inner), type_render(wv.type)) }
                        wv = retype_literal(wv, rf.inner)
                    }
                    return TypedStmt { node = TAssign { kind = parser::AssignKind::RefDeref; name = a.name; op = a.op; bound = rf.inner; value = wv; deref = true; target = no_texpr() }; env = env }
                }
            }
            _ => { }
        }
    }
    if a.deref {
        var inner = match tb.type {
            Reference as rf => rf.inner
            _ => return error { message = $"`{a.name}.value` requires a reference (`Ref<T>`) — `{a.name}` is not a reference" }
        }
        var dv = match type_expr(a.value, env, table) { TExpr as te => te; error as e => return e }
        if !assignable_to(dv.type, inner, table) {
            if !literal_adopts(dv, inner) { return teko::error::err_typed(error { message = "assigned value does not match the referenced type" }, type_render(inner), type_render(dv.type)) }
            dv = TExpr { kind = dv.kind; type = inner; line = dv.line; col = dv.col }
        }
        return TypedStmt { node = TAssign { kind = parser::AssignKind::RefDeref; name = a.name; op = a.op; bound = inner; value = dv; deref = true; target = no_texpr() }; env = env }
    }
    if !tb.is_mut { return error { message = $"cannot assign to immutable `{a.name}`" } }
    var v = match type_expr(a.value, env, table) { TExpr as te => te; error as e => return e }
    var both_bare_ref = (match tb.type { Reference => true; _ => false }) && (match v.type { Reference => true; _ => false })
    if !both_bare_ref {
        if type_contains_ref(tb.type) || type_contains_ref(v.type) { return error { message = "a reference cannot be bound to a local (parameter-only in this version)" } }
    }
    var coerced = match coerce_value_into(v, tb.type, table, "assigned value does not match the target type") { TExpr as x => x; error as e => return e }
    TypedStmt { node = TAssign { kind = parser::AssignKind::Simple; name = a.name; op = a.op; bound = tb.type; value = adopt_sentinel_slice_type(coerced, tb.type); deref = false; target = no_texpr() }; env = env }
}

fn expr_is_dot_construction(e: parser::Expr): bool {
    match e.kind { parser::StructLit as sl => is_dot_sentinel(sl.type_path); _ => false }
}

fn type_dot_tail(e: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    match type_value_expected(e, env.ret_expected, env, table) {
        TExpr as te => TExpr { kind = te.kind; type = te.type; line = e.line; col = e.col }
        error as inner => if inner.line == 0 { teko::error::err_loc(inner, e.line, e.col) } else { inner }
    }
}

fn type_return(r: parser::Return, env: Env, table: TypeTable): TypedStmt | error {
    if r.has_value && expr_is_svc_claim(r.value) { return svc_escape_error() }
    var v = if r.has_value && expr_is_dot_construction(r.value) && !type_is_void(env.ret_expected) {
        match type_dot_tail(r.value, env, table) { TExpr as te => te; error as e => return e }
    } else {
        match type_expr(r.value, env, table) { TExpr as te => te; error as e => return e }
    }
    TypedStmt { node = TReturn { has_value = r.has_value; value = v; values = [] }; env = env }
}

fn type_loop(l: parser::LoopStmt, env: Env, table: TypeTable): TypedStmt | error {
    var ib = match type_block(l.init, with_explicit(env, false), table) { TypedBlock as bk => bk; error as e => return e }
    var body_env = with_explicit(ib.env, env.explicit)
    var bb = match type_block(l.body, body_env, table) { TypedBlock as bk => bk; error as e => return e }
    TypedStmt { node = TLoopStmt { label = l.label; init = ib.stmts; body = bb.stmts }; env = env }
}

fn type_exprstmt(es: parser::ExprStmt, env: Env, table: TypeTable): TypedStmt | error {
    match es.expr.kind {
        parser::IfExpr as f => {
            var te = match type_if_stmt(f, env, table) { TExpr as x => x; error as e => return e }
            TypedStmt { node = TExprStmt { expr = te }; env = env }
        }
        parser::MatchExpr as m => {
            var te = match type_match_stmt(m, env, table) { TExpr as x => x; error as e => return e }
            TypedStmt { node = TExprStmt { expr = te }; env = env }
        }
        _ => {
            var te = match type_expr(es.expr, env, table) { TExpr as x => x; error as e => return e }
            TypedStmt { node = TExprStmt { expr = te }; env = env }
        }
    }
}

type TStmtSeq = struct { stmts: []@TStatement(); env: Env }

fn mb_expr(kind: @ExprKind()): parser::Expr {
    parser::Expr { kind = kind; line = 0; col = 0 }
}

fn mb_var(name: str): parser::Expr {
    mb_expr(parser::Var { name = name })
}

fn mb_u64_lit(v: u64): parser::Expr {
    mb_expr(parser::Number { is_float = false; value = parser::numint_of_u64(v); fval = 0.0 })
}

fn mb_field(recv: parser::Expr, field: str): parser::Expr {
    mb_expr(parser::FieldAccess { receiver = recv; field = field })
}

fn mb_index(recv: parser::Expr, idx: parser::Expr): parser::Expr {
    mb_expr(parser::Index { receiver = recv; index = idx })
}

fn mb_binary(op: lexer::TokenKind, left: parser::Expr, right: parser::Expr): parser::Expr {
    mb_expr(parser::Binary { op = op; left = left; right = right })
}

fn mb_len(recv: parser::Expr): parser::Expr {
    mb_field(recv, "len")
}

fn mb_binding_stmt(kind: parser::BindKind, name: str, has_type: bool, ann: @TypeExpr(), value: parser::Expr): @Statement() {
    parser::Binding { kind = kind; target = parser::SimpleName { name = name }; has_type = has_type; type_ann = ann; is_ref = false; value = value }
}

fn mb_guard_stmt(temp: str, op: lexer::TokenKind, bound: u64, msg: str): @Statement() {
    var term = parser::CmpTerm { op = op; operand = mb_u64_lit(bound) }
    var cond = mb_expr(parser::Compare { first = mb_len(mb_var(temp)); rest = [term] })
    var pseg = [parser::Segment { name = "panic" }]
    var pargs = [mb_expr(parser::StrLit { text = msg })]
    var pnames = [""]
    var pcall = mb_expr(parser::Call { callee = parser::Path { segments = pseg }; args = pargs; arg_names = pnames; owner_type_args = []; callee_type_args = [] })
    var then_blk: []@Statement() = [parser::ExprStmt { expr = pcall }]
    parser::ExprStmt { expr = mb_expr(parser::IfExpr { cond = cond; then_blk = then_blk; has_else = false; else_blk = [] }) }
}

fn mb_temp_name(mb: parser::MultiBind, slot: u64): str {
    "_mb_" ~ teko::u64_to_str(mb.line to u64) ~ "_" ~ teko::u64_to_str(mb.col to u64) ~ "_" ~ teko::u64_to_str(slot)
}

type MbArrayShape = struct { head_n: u64; tail_n: u64; has_rest: bool }

fn mb_array_shape(targets: []@BindElem()): MbArrayShape {
    var head_n: u64 = 0
    var tail_n: u64 = 0
    var has_rest = false
    var i: u64 = 0
    loop {
        if i >= targets.len { break }
        match targets[i] {
            parser::BindRest => has_rest = true
            _ => if has_rest { tail_n = tail_n + 1 } else { head_n = head_n + 1 }
        }
        i = i + 1
    }
    MbArrayShape { head_n = head_n; tail_n = tail_n; has_rest = has_rest }
}

fn type_multibind_mret(mb: parser::MultiBind, env: Env, table: TypeTable): TStmtSeq | error {
    var call = match type_expr(mb.values[0], env, table) { TExpr as x => x; error as e => return e }
    if !type_is_mret_aggregate(call.type) {
        return error { message = "a multiple binding `var a, b = …` with one right-hand value needs a multiple-return call there (a `fn f(): (A, B)`); this value is not one" }
    }
    var aggname = match call.type { Named as nm => nm.name; _ => "" }
    var decl = match type_table_find(table, aggname, env.cur_ns) { parser::TypeDecl as d => d; error as e => return e }
    var nfields = match decl.body { parser::StructBody as sb => sb.fields.len; _ => 0 }
    if mb.targets.len != nfields {
        return error { message = "multiple-return destructuring: the call returns " ~ teko::u64_to_str(nfields) ~ " values but " ~ teko::u64_to_str(mb.targets.len) ~ " targets were given" }
    }
    var tname = mb_temp_name(mb, 0)
    var cur = define(env, tname, call.type, true)
    var body: [1 + mb.targets.len]@TStatement() = []
    body[0] = TBinding { kind = parser::BindKind::Var; target = parser::SimpleName { name = tname }; bound = call.type; value = call }
    var nbody: u64 = 1
    var i: u64 = 0
    loop {
        if i >= mb.targets.len { break }
        match mb.targets[i] {
            parser::BindName as bn => {
                var vstmt = mb_binding_stmt(mb.kind, bn.name, false, mb.type_ann, mb_field(mb_var(tname), mret_field_name(i)))
                var ts = match type_statement(vstmt, cur, table) { TypedStmt as t => t; error as e => return e }
                body[nbody] = ts.node
                nbody++
                cur = ts.env
            }
            parser::BindSkip => { }
            parser::BindRest => return error { message = "`..` skip-range is not valid in a multiple-return destructuring" }
        }
        i = i + 1
    }
    TStmtSeq { stmts = tstmt_prefix(body, nbody); env = cur }
}

fn str_has_prefix(s: str, p: str): bool {
    if s.len < p.len { return false }
    var i: u64 = 0
    loop {
        if i >= p.len { break }
        if s[i] != p[i] { return false }
        i = i + 1
    }
    true
}

fn type_is_mret_aggregate(t: @Type()): bool {
    match t {
        Named as nm => str_has_prefix(name_last_segment(nm.name), MRET_PREFIX)
        _ => false
    }
}

fn type_multibind_parallel(mb: parser::MultiBind, env: Env, table: TypeTable): TStmtSeq | error {
    if mb.values.len == 1 {
        return type_multibind_mret(mb, env, table)
    }
    if mb.targets.len != mb.values.len {
        return error { message = "multiple assignment: the number of targets and values must match (got " ~ teko::u64_to_str(mb.targets.len) ~ " targets, " ~ teko::u64_to_str(mb.values.len) ~ " values)" }
    }
    var cur = env
    var body: [mb.values.len + mb.targets.len]@TStatement() = []
    var nbody: u64 = 0
    var i: u64 = 0
    loop {
        if i >= mb.values.len { break }
        var tstmt = mb_binding_stmt(parser::BindKind::Var, mb_temp_name(mb, i), mb.has_type, mb.type_ann, mb.values[i])
        var ts = match type_statement(tstmt, cur, table) { TypedStmt as t => t; error as e => return e }
        body[nbody] = ts.node
        nbody++
        cur = ts.env
        i = i + 1
    }
    i = 0
    loop {
        if i >= mb.targets.len { break }
        match mb.targets[i] {
            parser::BindName as bn => {
                var vstmt = mb_binding_stmt(mb.kind, bn.name, false, mb.type_ann, mb_var(mb_temp_name(mb, i)))
                var ts = match type_statement(vstmt, cur, table) { TypedStmt as t => t; error as e => return e }
                body[nbody] = ts.node
                nbody++
                cur = ts.env
            }
            parser::BindSkip => { }
            parser::BindRest => return error { message = "`..` skip-range is not valid in a parallel multiple assignment" }
        }
        i = i + 1
    }
    TStmtSeq { stmts = tstmt_prefix(body, nbody); env = cur }
}

fn type_multibind_array(mb: parser::MultiBind, env: Env, table: TypeTable): TStmtSeq | error {
    if mb.values.len != 1 {
        return error { message = "array decomposition binds exactly one array value" }
    }
    var shape = mb_array_shape(mb.targets)
    var cur = env
    var body: [2 + mb.targets.len]@TStatement() = []
    var nbody: u64 = 0
    var aname = mb_temp_name(mb, 0)
    var astmt = mb_binding_stmt(parser::BindKind::Var, aname, false, mb.type_ann, mb.values[0])
    var ats = match type_statement(astmt, cur, table) { TypedStmt as t => t; error as e => return e }
    body[nbody] = ats.node
    nbody++
    cur = ats.env
    var guard = if shape.has_rest {
        mb_guard_stmt(aname, lexer::TokenKind::Lt, shape.head_n + shape.tail_n, "array decomposition: expected at least " ~ teko::u64_to_str(shape.head_n + shape.tail_n) ~ " elements")
    } else {
        mb_guard_stmt(aname, lexer::TokenKind::Ne, shape.head_n, "array decomposition: expected exactly " ~ teko::u64_to_str(shape.head_n) ~ " elements")
    }
    var gts = match type_statement(guard, cur, table) { TypedStmt as t => t; error as e => return e }
    body[nbody] = gts.node
    nbody++
    cur = gts.env
    var slot: u64 = 0
    var j: u64 = 0
    var in_tail = false
    var i: u64 = 0
    loop {
        if i >= mb.targets.len { break }
        match mb.targets[i] {
            parser::BindRest => { in_tail = true }
            parser::BindSkip => if in_tail { j = j + 1 } else { slot = slot + 1 }
            parser::BindName as bn => {
                var idx_expr = if in_tail {
                    mb_index(mb_var(aname), mb_binary(lexer::TokenKind::Minus, mb_len(mb_var(aname)), mb_u64_lit(shape.tail_n - j)))
                } else {
                    mb_index(mb_var(aname), mb_u64_lit(slot))
                }
                var vstmt = mb_binding_stmt(mb.kind, bn.name, mb.has_type, mb.type_ann, idx_expr)
                var ts = match type_statement(vstmt, cur, table) { TypedStmt as t => t; error as e => return e }
                body[nbody] = ts.node
                nbody++
                cur = ts.env
                if in_tail { j = j + 1 } else { slot = slot + 1 }
            }
        }
        i = i + 1
    }
    TStmtSeq { stmts = tstmt_prefix(body, nbody); env = cur }
}

fn type_multibind(mb: parser::MultiBind, env: Env, table: TypeTable): TStmtSeq | error {
    match mb.shape {
        parser::MultiTargetKind::Parallel => type_multibind_parallel(mb, env, table)
        parser::MultiTargetKind::ArrayDecomp => type_multibind_array(mb, env, table)
    }
}

fn top_level_stmt_nodes(s: @Statement(), env: Env, table: TypeTable): TStmtSeq | error {
    match s {
        parser::MultiBind as mb => type_multibind(mb, env, table)
        _ => {
            var ts = match type_statement(s, env, table) { TypedStmt as x => x; error as e => return e }
            TStmtSeq { stmts = [ts.node]; env = ts.env }
        }
    }
}

fn type_statement(s: @Statement(), env: Env, table: TypeTable): TypedStmt | error {
    match s {
        parser::Binding as b => type_binding(b, env, table)
        parser::Assign as a => type_assign(a, env, table)
        parser::Return as r => type_return(r, env, table)
        parser::LoopStmt as l => type_loop(l, env, table)
        parser::BreakStmt as b => TypedStmt { node = TBreakStmt { label = b.label }; env = env }
        parser::ContinueStmt as c => TypedStmt { node = TContinueStmt { label = c.label }; env = env }
        parser::ExprStmt as es => type_exprstmt(es, env, table)
        parser::DeferStmt as d => {
            var vi: u64 = 0
            loop {
                if vi >= d.body.len { break }
                match d.body[vi] {
                    parser::Return => return error { message = "defer block may not return" }
                    parser::BreakStmt => return error { message = "defer block may not break" }
                    parser::DeferStmt => return error { message = "nested defer is not allowed" }
                    _ => { }
                }
                vi++
            }
            var tb = match type_block(d.body, env, table) { TypedBlock as x => x; error as e => return e }
            TypedStmt { node = TDeferStmt { body = tb.stmts }; env = env }
        }
        parser::AdoptStmt as a => type_adopt(a, env, table)
        parser::BlockStmt as bs => type_block_stmt(bs, env, table)
        parser::MultiBind => error { message = "internal: a multiple binding must be spliced by the statement sequencer, not typed as a single statement" }
        parser::LoweringFrag => error { message = "a `lowering { … }` fragment is legal only inside a Family-A macro body — the macro expansion pass consumes it" }
        parser::Spawn as sp => type_spawn(sp, env, table)
    }
}

fn type_block_stmt(bs: parser::BlockStmt, env: Env, table: TypeTable): TypedStmt | error {
    var tb = match type_block(bs.body, env, table) { TypedBlock as x => x; error as e => return e }
    TypedStmt { node = TBlockStmt { body = tb.stmts }; env = env }
}

fn type_adopt(a: parser::AdoptStmt, env: Env, table: TypeTable): TypedStmt | error {
    var tb = match type_block(a.body, env, table) { TypedBlock as x => x; error as e => return e }
    TypedStmt { node = TAdoptStmt { name = a.name; body = tb.stmts }; env = env }
}

fn type_spawn(s: parser::Spawn, env: Env, table: TypeTable): TypedStmt | error {
    var te = match type_expr(s.call, env, table) { TExpr as x => x; error as e => return e }
    var tc = match te.kind { TCall as c => c; _ => return error { message = "`spawn` must be followed by a call, e.g. `spawn worker(n, msg)`" } }
    var f = match tspawn_resolve_func(tc, env) { Func as fn0 => fn0; error as e => return e }
    match tspawn_reject_ref_params(f, tc.callee) { error as e => return e; bool => { } }
    match tspawn_reject_uncopyable_args(f, tc.callee) { error as e => return e; bool => { } }
    TypedStmt { node = TSpawn { call = te; id = 0 to u64 }; env = env }
}

fn tspawn_resolve_func(tc: TCall, env: Env): Func | error {
    match tc.callee_type {
        Func as f => return f
        _ => { }
    }
    match lookup_call(env, tc.callee) {
        (@Type()) as t => match t { Func as f => f; _ => error { message = "internal: spawn target did not resolve to a function type" } }
        error as e => e
    }
}

fn tspawn_reject_ref_params(f: Func, callee: parser::Path): bool | error {
    var i: u64 = 0
    loop {
        if i >= f.params.len { break }
        match f.params[i] {
            Reference => return error { message = $"{tspawn_target_name(callee)}: a `ref` parameter may not cross a `spawn` boundary — the reference names memory in the spawning thread's arena, which is freed when that scope exits. Pass the value by copy instead." }
            _ => { }
        }
        i = i + 1
    }
    true
}

fn tspawn_reject_uncopyable_args(f: Func, callee: parser::Path): bool | error {
    var i: u64 = 0
    loop {
        if i >= f.params.len { break }
        if !tspawn_type_copyable(f.params[i]) {
            return error { message = $"{tspawn_target_name(callee)}: a `spawn` argument of type `{type_render(f.params[i])}` cannot yet be copied across the thread boundary (batch 1 supports scalars, `str`, and slices of scalars; struct/class/closure/ref/pointer args are a later batch)" }
        }
        i = i + 1
    }
    true
}

fn tspawn_type_copyable(t: @Type()): bool {
    if is_str_type(t) { return true }
    match t {
        Prim => true
        Byte => true
        Slice as sl => tspawn_scalar_type(sl.element)
        _ => false
    }
}

fn tspawn_scalar_type(t: @Type()): bool {
    match t {
        Prim => true
        Byte => true
        _ => false
    }
}

fn tspawn_target_name(p: parser::Path): str {
    if p.segments.len == 0 { return "spawn target" }
    p.segments[p.segments.len - 1].name
}

fn function_return(f: parser::Function, table: TypeTable, ref_ns: str): @Type() | error {
    if !f.has_return { return Void { } }
    resolve_type(f.return_type, table, ref_ns)
}

fn assignable_to(from: @Type(), to: @Type(), table: TypeTable): bool { widens_into(from, to, table) }

fn bignum_ctor_of(from: @Type()): str {
    if prim_kind_of(from) == PrimKind::U64 { return "of_u64" }
    if prim_kind_of(from) == PrimKind::Usize { return "of_u64" }
    "of"
}

fn widen_int_into_bignum(v: TExpr, target: @Type()): TExpr | null {
    var kind = bignum_kind(target)
    if kind == "" { return null }
    if !is_integer(v.type) { return null }
    var ctor = bignum_ctor_of(v.type)
    var arg = bignum_ctor_argument(v, ctor)
    bignum_call(kind, ctor, [arg], bignum_named(kind))
}

fn bignum_ctor_argument(v: TExpr, ctor: str): TExpr {
    if ctor == "of_u64" { return v }
    var carrier = Prim { kind = PrimKind::I64 }
    if type_eq(v.type, carrier) { return v }
    TExpr { kind = TCast { expr = v }; type = carrier; line = v.line; col = v.col }
}

fn widen_value_into(v: TExpr, target: @Type()): TExpr | null {
    if numeric_widens_implicitly(v.type, target) {
        return TExpr { kind = TCast { expr = v }; type = target; line = v.line; col = v.col }
    }
    widen_int_into_bignum(v, target)
}

fn adopt_sentinel_slice_type(v: TExpr, target: @Type()): TExpr {
    var v_is_sentinel = match v.type { Slice as vs => match vs.element { Void => true; _ => false }; _ => false }
    if !v_is_sentinel { return v }
    var target_is_concrete = match target { Slice as bs => match bs.element { Void => false; _ => true }; _ => false }
    if !target_is_concrete { return v }
    TExpr { kind = v.kind; type = target; line = v.line; col = v.col }
}

fn bytes_str_is_str(t: @Type()): bool { is_str_type(t) }

fn bytes_str_is_byte_slice(t: @Type()): bool {
    match t { Slice as sl => match sl.element { Byte => true; _ => false }; _ => false }
}

fn bytes_str_reinterpret(v: TExpr, target: @Type()): TExpr | null {
    if !bytes_str_convertible(v.type, target) { return null }
    TExpr { kind = TCast { expr = v }; type = target; line = v.line; col = v.col }
}

fn coerce_value_into(v: TExpr, target: @Type(), table: TypeTable, what: str): TExpr | error {
    if assignable_to(v.type, target, table) { return v }
    match widen_value_into(v, target) { TExpr as w => return w; null => { } }
    match bytes_str_reinterpret(v, target) { TExpr as w => return w; null => { } }
    if literal_adopts(v, target) { return retype_literal(v, target) }
    teko::error::err_typed(error { message = what }, type_render(target), type_render(v.type))
}

fn reinterpret_generic_args(targs: []TExpr, params: []@Type(), s: Subst, table: TypeTable): []TExpr {
    var out: [targs.len]TExpr = []
    var i: u64 = 0
    loop {
        if i >= targs.len { break }
        var a = targs[i]
        if i < params.len {
            var want = subst_type(params[i], s)
            if !assignable_to(a.type, want, table) && bytes_str_convertible(a.type, want) {
                a = TExpr { kind = TCast { expr = a }; type = want; line = a.line; col = a.col }
            }
        }
        out[i] = a
        i++
    }
    out
}

fn coerce_argument_into(a: TExpr, pt: @Type(), table: TypeTable): TExpr | error {
    if assignable_to(a.type, pt, table) {
        if arg_keeps_narrow_type(pt, a.type, table) { return a }
        return TExpr { kind = a.kind; type = pt; line = a.line; col = a.col }
    }
    match struct_iface_named_stop(a.type, pt, table) { error as se => return se; null => { } }
    match widen_value_into(a, pt) { TExpr as w => return w; null => { } }
    match bytes_str_reinterpret(a, pt) { TExpr as w => return w; null => { } }
    if literal_adopts(a, pt) { return TExpr { kind = a.kind; type = pt; line = a.line; col = a.col } }
    teko::error::err_typed(error { message = "argument type mismatch" }, type_render(pt), type_render(a.type))
}

fn arg_keeps_narrow_type(pt: @Type(), arg_type: @Type(), table: TypeTable): bool {
    var pt_is_variant = match expand_variant(pt, table) { Variant => true; _ => false }
    if pt_is_variant { return true }
    if arg_class_upcast(pt, arg_type, table) { return true }
    slice_element_widens(pt, arg_type)
}

fn arg_class_upcast(pt: @Type(), arg_type: @Type(), table: TypeTable): bool {
    match pt {
        Named as ptn => match arg_type {
            Named as atn => (is_interface_name(ptn.name, table) || is_polymorphic_base(ptn.name, table)) && is_class_name(atn.name, table) && ptn.name != atn.name
            _ => false
        }
        _ => false
    }
}

fn slice_element_widens(pt: @Type(), arg_type: @Type()): bool {
    match pt {
        Slice as ps => match arg_type {
            Slice as as_ => !type_is_void(as_.element) && !type_eq(ps.element, as_.element)
            _ => false
        }
        _ => false
    }
}

fn check_returns(stmts: []@TStatement(), ret: @Type(), table: TypeTable): error | null {
    var i = 0
    loop {
        if i >= stmts.len { break }
        match check_return_stmt(stmts[i], ret, table) { null => { }; error as e => return e }
        i++
    }
    null
}

fn tblock_trailing(stmts: []@TStatement()): TExpr | null {
    if stmts.len == 0 { return null }
    match stmts[stmts.len - 1] {
        TExprStmt as es => es.expr
        _ => null
    }
}

fn trailing_number(stmts: []@TStatement()): TExpr | null {
    match tblock_trailing(stmts) {
        TExpr as t => match t.kind { TNumber => t; _ => null }
        null => null
    }
}

fn number_fits_member(n: TNumber, m: @Type()): bool {
    match cast_kind(m) {
        PrimKind as k => {
            if n.is_float { prim_is_float(k) && float_fits(n.fval, k) }
            else { prim_is_int(k) && numint_fits(n.value, k) }
        }
        error => false
    }
}

fn union_sole_numeric_member(n: TNumber, members: []@Type()): @Type() | error {
    var found: @Type() = Void { }
    var count = 0
    var i = 0
    loop {
        if i >= members.len { break }
        if number_fits_member(n, members[i]) { found = members[i]; count = count + 1 }
        i++
    }
    if count == 1 { found } else { error { message = "not exactly one numeric union member fits the literal" } }
}

fn union_lists_null(members: []@Type()): bool {
    var i = 0
    loop {
        if i >= members.len { break }
        match members[i] { Null => return true; _ => { } }
        i++
    }
    false
}

fn literal_adopts(e: TExpr, to: @Type()): bool {
    match e.kind {
        TNumber as n => match to {
            Variant as v => match union_sole_numeric_member(n, v.members) { (@Type()) as _gt8 => true; error => false }
            _ => number_fits_member(n, to)
        }
        TMatchExpr as m => {
            var any = false
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if !tblock_diverges(m.arms[i].body) {
                    match tblock_trailing(m.arms[i].body) {
                        TExpr as t => { if !literal_adopts(t, to) { return false }; any = true }
                        null => return false
                    }
                }
                i++
            }
            any
        }
        TIfExpr as f => {
            if !f.has_else { return false }
            var any = false
            if !tblock_diverges(f.then_blk) {
                match tblock_trailing(f.then_blk) {
                    TExpr as t => { if !literal_adopts(t, to) { return false }; any = true }
                    null => return false
                }
            }
            if !tblock_diverges(f.else_blk) {
                match tblock_trailing(f.else_blk) {
                    TExpr as t => { if !literal_adopts(t, to) { return false }; any = true }
                    null => return false
                }
            }
            any
        }
        TArrayLit as a => match to {
            Slice as s => {
                var i = 0
                loop {
                    if i >= a.elements.len { break }
                    if !a.elements[i].is_spread {
                        if !literal_adopts(a.elements[i].expr, s.element) { return false }
                    }
                    i++
                }
                true
            }
            _ => false
        }
        TNullLit => match to {
            Variant as v => union_lists_null(v.members)
            Null => true
            _ => false
        }
        _ => false
    }
}

fn retype_literal(e: TExpr, to: @Type()): TExpr {
    match e.kind {
        TNumber as n => match to {
            Variant as v => match union_sole_numeric_member(n, v.members) {
                (@Type()) as mem => TExpr { kind = e.kind; type = mem; line = e.line; col = e.col }
                error => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
            }
            _ => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
        }
        TNullLit => match to {
            Variant => TExpr { kind = e.kind; type = Null { }; line = e.line; col = e.col }
            _ => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
        }
        TArrayLit as a => match to {
            Slice as s => {
                var elems: [a.elements.len]TArrayElem = []
                var i = 0
                loop {
                    if i >= a.elements.len { break }
                    var el = a.elements[i]
                    if el.is_spread {
                        elems[i] = el
                    } else {
                        elems[i] = TArrayElem { is_spread = false; expr = retype_literal(el.expr, s.element) }
                    }
                    i++
                }
                TExpr { kind = TArrayLit { elements = elems }; type = to; line = e.line; col = e.col }
            }
            _ => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
        }
        TIfExpr as f => {
            var then_blk = retype_block_trailing(f.then_blk, to)
            var else_blk = if f.has_else { retype_block_trailing(f.else_blk, to) } else { f.else_blk }
            TExpr { kind = TIfExpr { cond = f.cond; then_blk = then_blk; has_else = f.has_else; else_blk = else_blk }; type = to; line = e.line; col = e.col }
        }
        TMatchExpr as m => {
            var arms: [m.arms.len]TArm = []
            var i = 0
            loop {
                if i >= m.arms.len { break }
                var ar = m.arms[i]
                arms[i] = TArm { pattern = ar.pattern; has_when = ar.has_when; guard = ar.guard; body = retype_block_trailing(ar.body, to) }
                i++
            }
            TExpr { kind = TMatchExpr { subject = m.subject; arms = arms }; type = to; line = e.line; col = e.col }
        }
        _ => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
    }
}

fn retype_block_trailing(stmts: []@TStatement(), to: @Type()): []@TStatement() {
    if stmts.len == 0 { return stmts }
    if tblock_diverges(stmts) { return stmts }
    match stmts[stmts.len - 1] {
        TExprStmt as es => {
            var last_index = stmts.len - 1
            var out: [stmts.len]@TStatement() = []
            var i = 0
            loop {
                if i >= last_index { break }
                out[i] = stmts[i]
                i++
            }
            out[last_index] = TExprStmt { expr = retype_literal(es.expr, to) }
            out
        }
        _ => stmts
    }
}

fn retype_union_returns(stmts: []@TStatement(), ret: @Type(), table: TypeTable): []@TStatement() {
    match ret {
        Variant => retype_return_positions(stmts, ret, table, true)
        _ => stmts
    }
}

fn retype_return_positions(stmts: []@TStatement(), ret: @Type(), table: TypeTable, retype_trailing: bool): []@TStatement() {
    if stmts.len == 0 { return stmts }
    var last = stmts.len - 1
    var out: [stmts.len]@TStatement() = []
    var i = 0
    loop {
        if i >= stmts.len { break }
        out[i] = retype_return_stmt(stmts[i], ret, table, retype_trailing && i == last)
        i++
    }
    out
}

fn retype_return_stmt(s: @TStatement(), ret: @Type(), table: TypeTable, is_trailing: bool): @TStatement() {
    match s {
        TReturn as r => {
            if !r.has_value { return s }
            if !literal_adopts(r.value, ret) { return s }
            TReturn { has_value = true; value = retype_literal(r.value, ret); values = [] }
        }
        TLoopStmt as l => TLoopStmt { label = l.label; init = l.init; body = retype_return_positions(l.body, ret, table, false) }
        TAdoptStmt as a => TAdoptStmt { name = a.name; body = retype_return_positions(a.body, ret, table, false) }
        TBlockStmt as b => TBlockStmt { body = retype_return_positions(b.body, ret, table, false) }
        TExprStmt as es => {
            var inner = retype_returns_in_expr(es.expr, ret, table)
            if is_trailing && !texpr_diverges(inner) && literal_adopts(inner, ret) {
                TExprStmt { expr = retype_literal(inner, ret) }
            } else {
                TExprStmt { expr = inner }
            }
        }
        _ => s
    }
}

fn retype_returns_in_expr(e: TExpr, ret: @Type(), table: TypeTable): TExpr {
    match e.kind {
        TIfExpr as f => {
            var then_blk = retype_return_positions(f.then_blk, ret, table, false)
            var else_blk = if f.has_else { retype_return_positions(f.else_blk, ret, table, false) } else { f.else_blk }
            TExpr { kind = TIfExpr { cond = f.cond; then_blk = then_blk; has_else = f.has_else; else_blk = else_blk }; type = e.type; line = e.line; col = e.col }
        }
        TMatchExpr as m => {
            var arms: [m.arms.len]TArm = []
            var i = 0
            loop {
                if i >= m.arms.len { break }
                var ar = m.arms[i]
                arms[i] = TArm { pattern = ar.pattern; has_when = ar.has_when; guard = ar.guard; body = retype_return_positions(ar.body, ret, table, false) }
                i++
            }
            TExpr { kind = TMatchExpr { subject = m.subject; arms = arms }; type = e.type; line = e.line; col = e.col }
        }
        _ => e
    }
}

fn bytes_str_is_char(t: @Type()): bool { match t { Char => true; _ => false } }

fn bytes_str_convertible(from: @Type(), to: @Type()): bool {
    (bytes_str_is_str(from) && bytes_str_is_byte_slice(to)) || (bytes_str_is_byte_slice(from) && bytes_str_is_str(to)) ||
    (bytes_str_is_str(from) && bytes_str_is_char(to)) || (bytes_str_is_char(from) && bytes_str_is_str(to))
}

fn yields_declared_return(value: TExpr, ret: @Type(), table: TypeTable): bool {
    assignable_to(value.type, ret, table) || numeric_widens_implicitly(value.type, ret) || literal_adopts(value, ret) || bytes_str_convertible(value.type, ret)
}

fn check_return_stmt(s: @TStatement(), ret: @Type(), table: TypeTable): error | null {
    match s {
        TReturn as r => {
            if r.has_value {
                if yields_declared_return(r.value, ret, table) { null }
                else { teko::error::err_typed(error { message = "return value does not match the function's declared return type" }, type_render(ret), type_render(r.value.type)) }
            } else {
                if type_is_void(ret) { null }
                else { error { message = "bare `return` in a function that declares a value-returning (non-void) return type" } }
            }
        }
        TLoopStmt as l => check_returns(l.body, ret, table)
        TExprStmt as es => check_returns_inexpr(es.expr, ret, table)
        TAdoptStmt as a => check_returns(a.body, ret, table)
        TBlockStmt as b => check_returns(b.body, ret, table)
        _ => null
    }
}

fn check_returns_inexpr(e: TExpr, ret: @Type(), table: TypeTable): error | null {
    match e.kind {
        TIfExpr as f => {
            match check_returns(f.then_blk, ret, table) { null => { }; error as e => return e }
            check_returns(f.else_blk, ret, table)
        }
        TMatchExpr as m => {
            var i = 0
            loop {
                if i >= m.arms.len { break }
                match check_returns(m.arms[i].body, ret, table) { null => { }; error as e => return e }
                i++
            }
            null
        }
        _ => null
    }
}

fn name_in_set(set: []str, name: str): bool {
    var i = 0
    loop {
        if i >= set.len { break }
        if set[i] == name { return true }
        i++
    }
    false
}

fn reject_ref_return(ret: @Type()): error | null {
    match ret {
        Reference => return error { message = "a function cannot return a reference" }
        _ => { }
    }
    null
}

fn check_trailing_value(stmts: []@TStatement(), ret: @Type(), table: TypeTable): error | null {
    if stmts.len == 0 { return null }
    match stmts[stmts.len - 1] {
        TExprStmt as es => {
            if texpr_diverges(es.expr) { null }
            else { if yields_declared_return(es.expr, ret, table) { null }
                else { teko::error::err_typed(error { message = "the function's final expression does not match its declared return type" }, type_render(ret), type_render(es.expr.type)) } }
        }
        _ => null
    }
}

type LabelCheck = struct { failed: bool; message: str; seen: []str }

fn lbl_eq(a: str, b: str): bool { a == b }

fn lbl_enclosing(scope: []str, label: str): bool {
    var i = 0
    loop {
        if i >= scope.len { break }
        if lbl_eq(scope[i], label) { return true }
        i++
    }
    false
}

fn check_labels_inexpr(e: TExpr, scope: []str, in_loop: bool, seen: []str): LabelCheck {
    match e.kind {
        TIfExpr as f => {
            var t = check_labels(f.then_blk, scope, in_loop, seen)
            if t.failed { return t }
            check_labels(f.else_blk, scope, in_loop, t.seen)
        }
        TMatchExpr as m => {
            var acc = seen
            var i = 0
            loop {
                if i >= m.arms.len { break }
                var t = check_labels(m.arms[i].body, scope, in_loop, acc)
                if t.failed { return t }
                acc = t.seen
                i++
            }
            LabelCheck { failed = false; message = ""; seen = acc }
        }
        _ => LabelCheck { failed = false; message = ""; seen = seen }
    }
}

fn check_labels(stmts: []@TStatement(), scope: []str, in_loop: bool, seen: []str): LabelCheck {
    var acc = seen
    var i = 0
    loop {
        if i >= stmts.len { break }
        match stmts[i] {
            TLoopStmt as l => {
                if l.label.len > 0 {
                    if !lexer::is_upper_snake(l.label) { return LabelCheck { failed = true; message = "loop label must be UPPER_SNAKE"; seen = acc } }
                    if lbl_enclosing(acc, l.label) { return LabelCheck { failed = true; message = "duplicate loop label within the same body"; seen = acc } }
                    acc = [..acc, l.label]
                }
                var frame = [..scope, l.label]
                var t = check_labels(l.body, frame, true, acc)
                if t.failed { return t }
                acc = t.seen
            }
            TBreakStmt as b => {
                if b.label.len == 0 {
                    if !in_loop { return LabelCheck { failed = true; message = "`break`/`continue` outside a loop"; seen = acc } }
                } else if !lbl_enclosing(scope, b.label) {
                    return LabelCheck { failed = true; message = "`break`/`continue` to an unknown loop label (no enclosing loop carries that label)"; seen = acc }
                }
            }
            TContinueStmt as c => {
                if c.label.len == 0 {
                    if !in_loop { return LabelCheck { failed = true; message = "`break`/`continue` outside a loop"; seen = acc } }
                } else if !lbl_enclosing(scope, c.label) {
                    return LabelCheck { failed = true; message = "`break`/`continue` to an unknown loop label (no enclosing loop carries that label)"; seen = acc }
                }
            }
            TExprStmt as es => {
                var t = check_labels_inexpr(es.expr, scope, in_loop, acc)
                if t.failed { return t }
                acc = t.seen
            }
            TAdoptStmt as a => {
                var t = check_labels(a.body, scope, in_loop, acc)
                if t.failed { return t }
                acc = t.seen
            }
            TBlockStmt as b => {
                var t = check_labels(b.body, scope, in_loop, acc)
                if t.failed { return t }
                acc = t.seen
            }
            _ => { }
        }
        i++
    }
    LabelCheck { failed = false; message = ""; seen = acc }
}

fn extern_null_union_ok(v: Variant): bool {
    if v.members.len != 2 { return false }
    var null_count = 0
    var other: @Type() | null = null
    var i = 0
    loop {
        if i >= v.members.len { break }
        match v.members[i] {
            Null => null_count = null_count + 1
            _ => other = v.members[i]
        }
        i++
    }
    if null_count != 1 { return false }
    match other {
        (@Type()) as t => match t { Ptr => true; _ => false }
        null => false
    }
}

fn extern_type_ok(t: @Type(), table: TypeTable): bool {
    match t {
        Prim => true
        Byte => true
        Ptr => true
        Uptr => true
        Named as nm => match type_table_find(table, nm.name, "") {
            parser::TypeDecl as td => extern_named_body_ok(td.body)
            error => false
        }
        Reference as rf => extern_type_ok(rf.inner, table)
        Variant as v => extern_null_union_ok(v)
        _ => false
    }
}

fn extern_named_body_ok(body: @TypeBody()): bool {
    match body {
        parser::ExternBody => true
        parser::ExternStructBody => true
        _ => false
    }
}

fn teko_rt_type_ok(t: @Type()): bool {
    if is_str_type(t) { return true }
    match t {
        Void => true
        Prim => true
        Byte => true
        Ptr => true
        Uptr => true
        Slice => true
        Variant => true
        Named => true
        _ => false
    }
}

fn params_have_discard(ps: []parser::Param): bool {
    var i: u64 = 0
    loop {
        if i >= ps.len { break }
        if !ps[i].has_type && ps[i].name == "_" { return true }
        i++
    }
    false
}

fn method_named(ms: []parser::Function, name: str): parser::Function | null {
    var i: u64 = 0
    loop {
        if i >= ms.len { break }
        if ms[i].name == name { return ms[i] }
        i++
    }
    null
}

fn type_implements_list(name: str, ref_ns: str, table: TypeTable): []str {
    match type_table_find(table, name, ref_ns) {
        parser::TypeDecl as td => match td.body {
            parser::ClassBody as cb => cb.implements
            parser::StructBody as sb => sb.implements
            _ => []
        }
        error => []
    }
}

fn find_interface_method(impls: []str, name: str, table: TypeTable, ref_ns: str): parser::Function | null {
    var i: u64 = 0
    loop {
        if i >= impls.len { break }
        match find_interface_decl(impls[i], table, ref_ns) {
            IfaceHit as h => match h.decl.body {
                parser::InterfaceBody as ib => match effective_interface_methods(ib, h.ns, table, [qualify(h.ns, name_last_segment(h.decl.name))]) {
                    []parser::Function as ms => match method_named(ms, name) { parser::Function as m => return m; null => { } }
                    error => { }
                }
                _ => { }
            }
            error => { }
        }
        i++
    }
    null
}

fn discard_governing_sig(f: parser::Function, struct_name: str, ref_ns: str, table: TypeTable): parser::Function | null {
    match type_table_find(table, struct_name, ref_ns) {
        parser::TypeDecl as td => match td.body {
            parser::ClassBody as cb => {
                if cb.has_base {
                    match find_class_body(cb.base_name, table) {
                        parser::ClassBody as bcb => match effective_class_methods(bcb, table) {
                            []parser::Function as ms => match method_named(ms, f.name) { parser::Function as m => return m; null => { } }
                            error => { }
                        }
                        error => { }
                    }
                }
            }
            _ => { }
        }
        error => { }
    }
    find_interface_method(type_implements_list(struct_name, ref_ns, table), f.name, table, ref_ns)
}

fn discard_param_name(idx: u64): str { $"_tk_discard_{idx}" }

fn discard_param_type(gov: parser::Function | null, idx: u64, table: TypeTable, ref_ns: str): @Type() | error {
    match gov {
        parser::Function as g => {
            if idx >= g.params.len { return error { message = "a `_` discard parameter has no matching slot in the implemented/overridden signature" } }
            resolve_type(g.params[idx].type_ann, table, ref_ns)
        }
        null => error { message = "a `_` discard parameter is only allowed when implementing an interface method or overriding a base method — a plain function must name its parameters" }
    }
}

fn canonical_base_type(base_name: str, cur_ns: str): @Type() {
    if name_qualifier(base_name) != "" { return Named { name = base_name } }
    Named { name = qualify(cur_ns, base_name) }
}

fn is_method_receiver(f: parser::Function, i: u64): bool {
    if i != 0 { return false }
    !f.params[0].has_type
}

fn type_method(f: parser::Function, struct_name: str, env: Env, table: TypeTable, has_base: bool, base_name: str, declaring_class: str): TFunction | error {
    var local = with_owner(env, declaring_class)
    var tbl = method_type_param_table(receiver_canonical_name(struct_name, env.cur_ns, table), f.type_params, f.type_constraints, "", table)
    var is_teko_rt = f.is_extern && f.from_lib == "teko_rt"
    var is_instance_method = f.params.len > 0 && !f.params[0].has_type
    var inject_base = has_base && is_instance_method
    var discard_gov: parser::Function | null = if params_have_discard(f.params) { discard_governing_sig(f, struct_name, env.cur_ns, table) } else { null }
    var fixed_params: []parser::Param = []
    var i: u64 = 0
    loop {
        if i >= f.params.len { break }
        if !f.params[i].has_type && f.params[i].name == "_" {
            var dpt = match discard_param_type(discard_gov, i, tbl, env.cur_ns) { (@Type()) as t => t; error as e => return e }
            fixed_params = [..fixed_params, parser::Param { name = discard_param_name(i); has_type = true; type_ann = type_to_texpr(dpt); is_params = false; has_default = false; default_expr = parser::no_expr() }]
            i++
            continue
        }
        var is_self_typed = f.params[i].has_type && return_type_is_self(f.params[i].type_ann)
        var pt = if !f.params[i].has_type || is_self_typed {
            Named { name = qualify(env.cur_ns, struct_name) }
        } else {
            match resolve_type(f.params[i].type_ann, tbl, env.cur_ns) { (@Type()) as t => t; error as e => return e }
        }
        fixed_params = [..fixed_params, if !f.params[i].has_type || is_self_typed {
                parser::Param { name = f.params[i].name; has_type = true; type_ann = type_to_texpr(pt); is_params = false; has_default = false; default_expr = parser::no_expr() }
            } else {
                f.params[i]
        }]
        if f.is_extern {
            if is_teko_rt {
                if !teko_rt_type_ok(pt) {
                    return error { message = "a `teko_rt` extern function parameter must be a primitive, `str`, slice, variant, or optional" }
                }
            } else {
                if !extern_type_ok(pt, table) {
                    return error { message = "an `extern` function parameter must be a primitive (int/float/bool), `byte`, `ptr`, `uptr`, or an `extern type` handle" }
                }
            }
        }
        local = define(local, f.params[i].name, pt, is_method_receiver(f, i))
        i++
    }
    if inject_base { local = define(local, "base", canonical_base_type(base_name, env.cur_ns), true) }
    var ret = if f.has_return && return_type_is_self(f.return_type) {
        self_return_named(struct_name, env.cur_ns, table)
    } else {
        match function_return(f, tbl, env.cur_ns) { (@Type()) as t => t; error as e => return e }
    }
    if is_ref_null_variant(ret) { return error { message = "a function cannot return an optional reference (`Ref<T> | null`) — references are pass-down only" } }
    if f.is_extern {
        var ret_ok = if is_teko_rt {
            teko_rt_type_ok(ret)
        } else {
            match ret { Void => true; _ => extern_type_ok(ret, table) }
        }
        if !ret_ok {
            return error { message = "an `extern` function return must be a primitive (int/float/bool), `byte`, `ptr`, `uptr`, an `extern type` handle, or absent" }
        }
        var no_body: []@TStatement() = []
        return TFunction { overload_suffix = ""; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = fixed_params; return_type = ret; body = no_body; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = ""; file = ""; line = 0; col = 0; is_test = f.is_test; is_extern = true; c_symbol = f.c_symbol; from_lib = f.from_lib; ret_extra = []; guard = parser::pred_true() }
    }
    match check_param_defaults(f, local, tbl) { null => { }; error as e => return e }
    var tb = match type_block(f.body, with_ret_expected(local, ret), tbl) { TypedBlock as bk => bk; error as e => return e }
    match check_returns(tb.stmts, ret, table) { null => { }; error as e => return e }
    match check_trailing_value(tb.stmts, ret, table) { null => { }; error as e => return e }
    match reject_ref_return(ret) { null => { }; error as e => return e }
    var lc = check_labels(tb.stmts, [], false, [])
    if lc.failed { return error { message = lc.message } }
    var ret_stmts = retype_union_returns(tb.stmts, ret, table)
    var body = if inject_base {
        var receiver_name = f.params[0].name
        var cast_val = TExpr {
            kind = TVar { name = receiver_name; is_func = false; func_ns = "" }
            type = Named { name = qualify(env.cur_ns, struct_name) }
            line = 0; col = 0
        }
        var base_bound = Named { name = if name_qualifier(base_name) != "" { base_name } else { qualify(env.cur_ns, base_name) } }
        var base_kw_stmt = TBinding { kind = parser::BindKind::Var; target = parser::SimpleName { name = "base" }; bound = base_bound; value = cast_val }
        var prefixed: []@TStatement() = [base_kw_stmt]
        var si = 0
        loop { if si >= ret_stmts.len { break }; prefixed = [..prefixed, ret_stmts[si]]; si++ }
        prefixed
    } else {
        ret_stmts
    }
    var tf = TFunction { overload_suffix = ""; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = fixed_params; return_type = ret; body = body; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = ""; file = ""; line = 0; col = 0; is_test = f.is_test; is_extern = false; c_symbol = f.c_symbol; from_lib = ""; ret_extra = []; guard = parser::pred_true() }
    match check_ref_storability(tf) { null => { }; error as e => return e }
    tf
}

fn check_ref_storability(tf: TFunction): error | null {
    if !fn_has_ref_param(tf) { return null }
    check_ref_storability_block(tf.body, fn_spine(tf))
}

fn fn_has_ref_param(tf: TFunction): bool {
    var i = 0
    loop {
        if i >= tf.params.len { break }
        var p = tf.params[i]
        if p.has_type {
            if type_ann_is_ref(p.type_ann) { return true }
        }
        i++
    }
    false
}

fn check_ref_storability_block(stmts: []@TStatement(), spine: Spine): error | null {
    var i = 0
    loop {
        if i >= stmts.len { break }
        match check_ref_storability_stmt(stmts[i], spine) { error as e => return e; null => { } }
        i++
    }
    null
}

fn check_ref_storability_stmt(s: @TStatement(), spine: Spine): error | null {
    match s {
        TBinding as b => match check_ref_bind_storable(b, spine) { error as e => return e; null => check_ref_storability_expr(b.value, spine) }
        TAssign as a => match check_ref_assign_storable(a, spine) { error as e => return e; null => check_ref_storability_expr(a.value, spine) }
        TLoopStmt as l => match check_ref_storability_block(l.init, spine) { error as e => return e; null => check_ref_storability_block(l.body, spine) }
        TDeferStmt as d => check_ref_storability_block(d.body, spine)
        TAdoptStmt as a => check_ref_storability_block(a.body, spine)
        TBlockStmt as b => check_ref_storability_block(b.body, spine)
        TReturn as r => if r.has_value { check_ref_storability_expr(r.value, spine) } else { null }
        TExprStmt as es => check_ref_storability_expr(es.expr, spine)
        TBreakStmt => null
        TContinueStmt => null
        TSpawn as sp => check_ref_storability_expr(sp.call, spine)
    }
}

fn check_ref_storability_expr(e: TExpr, spine: Spine): error | null {
    match e.kind {
        TIfExpr as f => match check_ref_storability_block(f.then_blk, spine) { error as er => return er; null => if f.has_else { check_ref_storability_block(f.else_blk, spine) } else { null } }
        TMatchExpr as m => check_ref_storability_match(m, spine)
        _ => null
    }
}

fn check_ref_storability_match(m: TMatchExpr, spine: Spine): error | null {
    var i = 0
    loop {
        if i >= m.arms.len { break }
        match check_ref_storability_block(m.arms[i].body, spine) { error as e => return e; null => { } }
        i++
    }
    null
}

fn check_ref_bind_storable(b: TBinding, spine: Spine): error | null {
    var is_ref_bind = match b.bound {
        Reference => true
        _ => is_ref_null_variant(b.bound) && type_contains_ref(b.value.type)
    }
    if !is_ref_bind { return null }
    match b.target {
        parser::SimpleName as sn => ref_borrow_or_error(spine, sn.name, b.value)
        parser::DestructurePattern => null
    }
}

fn check_ref_assign_storable(a: TAssign, spine: Spine): error | null {
    match a.kind {
        parser::AssignKind::Simple => match a.bound { Reference => ref_borrow_or_error(spine, a.name, a.value); _ => null }
        _ => null
    }
}

fn ref_bind_referent_name(value: TExpr): str {
    match value.kind {
        TBorrow as tb => match tb.operand.kind {
            TVar as v => v.name
            _ => ""
        }
        _ => alias_src_name(value)
    }
}

fn ref_borrow_or_error(spine: Spine, target: str, value: TExpr): error | null {
    var borrow = cell_of(spine, target)
    var referent = cell_of(spine, ref_bind_referent_name(value))
    if borrow >= 0 {
        if referent >= 0 {
            if ref_target_outlives(spine, borrow to u32, referent to u32) { return null }
        }
    }
    error { message = "a reference cannot be bound to a local (parameter-only in this version)" }
}

fn check_param_defaults(f: parser::Function, env: Env, table: TypeTable): error | null {
    var i: u64 = 0
    loop {
        if i >= f.params.len { break }
        if f.params[i].has_default {
            var te = match type_expr(f.params[i].default_expr, env, table) { TExpr as x => x; error as e => return e }
            match is_const_expr(te, table, env) {
                null => { }
                error => return error { message = $"the default for parameter '{f.params[i].name}' must be a compile-time constant expression" }
            }
        }
        i++
    }
    null
}

fn type_function(f: parser::Function, env: Env, table: TypeTable): TFunction | error {
    var local = env
    var tbl = type_param_table(f.type_params, f.type_constraints, "", table)
    var is_teko_rt = f.is_extern && f.from_lib == "teko_rt"
    var i = 0
    loop {
        if i >= f.params.len { break }
        if !f.params[i].has_type && f.params[i].name == "_" {
            return error { message = "a `_` discard parameter is only allowed when implementing an interface method or overriding a base method — a plain function must name its parameters" }
        }
        var pt = match resolve_type(f.params[i].type_ann, tbl, env.cur_ns) { (@Type()) as t => t; error as e => return e }
        if f.is_extern {
            if is_teko_rt {
                if !teko_rt_type_ok(pt) {
                    return error { message = "a `teko_rt` extern function parameter must be a primitive, `str`, slice, variant, or optional" }
                }
            } else {
                if !extern_type_ok(pt, table) {
                    return error { message = "an `extern` function parameter must be a primitive (int/float/bool), `byte`, `ptr`, `uptr`, or an `extern type` handle" }
                }
            }
        }
        local = define(local, f.params[i].name, pt, false)
        i++
    }
    var ret = match function_return(f, tbl, env.cur_ns) { (@Type()) as t => t; error as e => return e }
    if is_ref_null_variant(ret) { return error { message = "a function cannot return an optional reference (`Ref<T> | null`) — references are pass-down only" } }
    if f.is_extern {
        var ret_ok = if is_teko_rt {
            teko_rt_type_ok(ret)
        } else {
            match ret { Void => true; _ => extern_type_ok(ret, table) }
        }
        if !ret_ok {
            return error { message = "an `extern` function return must be a primitive (int/float/bool), `byte`, `ptr`, `uptr`, an `extern type` handle, or absent" }
        }
        var no_body: []@TStatement() = []
        return TFunction { overload_suffix = ""; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; return_type = ret; body = no_body; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = ""; file = ""; line = 0; col = 0; is_test = f.is_test; is_extern = true; c_symbol = f.c_symbol; from_lib = f.from_lib; ret_extra = []; guard = parser::pred_true() }
    }
    match check_param_defaults(f, local, tbl) { null => { }; error as e => return e }
    var tb = match type_block(f.body, with_ret_expected(local, ret), tbl) { TypedBlock as bk => bk; error as e => return e }
    match check_returns(tb.stmts, ret, table) { null => { }; error as e => return e }
    match check_trailing_value(tb.stmts, ret, table) { null => { }; error as e => return e }
    match reject_ref_return(ret) { null => { }; error as e => return e }
    var lc = check_labels(tb.stmts, [], false, [])
    if lc.failed { return error { message = lc.message } }
    var ret_stmts = retype_union_returns(tb.stmts, ret, table)
    var tf = TFunction { overload_suffix = ""; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; return_type = ret; body = ret_stmts; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = ""; file = ""; line = 0; col = 0; is_test = f.is_test; is_extern = false; c_symbol = f.c_symbol; from_lib = ""; ret_extra = []; guard = parser::pred_true() }
    match check_ref_storability(tf) { null => { }; error as e => return e }
    tf
}

fn operator_return_class(name: str): str {
    if name == "__add" || name == "__sub" || name == "__mul" || name == "__div" || name == "__mod" { return "self" }
    if name == "__band" || name == "__bor" || name == "__bxor" || name == "__shl" || name == "__shr" || name == "__bnot" { return "self" }
    if name == "__eq" || name == "__ne" || name == "__lt" || name == "__gt" || name == "__le" || name == "__ge" { return "bool" }
    if name == "__index" { return "element" }
    ""
}

fn operator_expected_arity(name: str): u64 {
    if name == "__bnot" { return 1 to u64 }
    2 to u64
}

fn type_is_indexed(t: @Type()): bool {
    if is_str_type(t) { return true }
    match t {
        Slice => true
        _ => false
    }
}

fn newtype_base_is_indexed(td: parser::TypeDecl, ref_ns: str, table: TypeTable): bool {
    match td.body {
        parser::NewtypeBody as nb => match resolve_type(nb.backing, table, ref_ns) {
            (@Type()) as bt => type_is_indexed(bt)
            error => false
        }
        _ => false
    }
}

fn comparator_counterpart(name: str): str {
    if name == "__eq" { return "__ne" }
    if name == "__ne" { return "__eq" }
    if name == "__lt" { return "__ge" }
    if name == "__ge" { return "__lt" }
    if name == "__gt" { return "__le" }
    if name == "__le" { return "__gt" }
    ""
}

fn op_diag(op: parser::Function, msg: str): error {
    teko::error::err_loc(error { message = msg }, op.line, op.col)
}

fn check_one_operator(td: parser::TypeDecl, op: parser::Function, ref_ns: str, table: TypeTable): null | error {
    var cls = operator_return_class(op.name)
    if cls == "" {
        return op_diag(op, $"`operator {op.name}` is not a recognized overloadable operator")
    }
    var arity = operator_expected_arity(op.name)
    if op.params.len != arity {
        return op_diag(op, $"`operator {op.name}` must take exactly {arity} operand(s)")
    }
    var saw_self = false
    var j = 0
    loop {
        if j >= op.params.len { break }
        if !op.params[j].has_type {
            return op_diag(op, $"every operand of `operator {op.name}` must be explicitly typed")
        }
        if return_type_is_self(op.params[j].type_ann) { saw_self = true }
        j++
    }
    if !saw_self {
        return op_diag(op, $"at least one operand of `operator {op.name}` must be `self`")
    }
    if !op.has_return {
        return op_diag(op, $"`operator {op.name}` must declare a return type")
    }
    if cls == "self" && !return_type_is_self(op.return_type) {
        return op_diag(op, $"an arithmetic/bitwise `operator {op.name}` must return `self`")
    }
    if cls == "bool" {
        if return_type_is_self(op.return_type) {
            return op_diag(op, $"a comparison `operator {op.name}` must return `bool`")
        }
        match resolve_type(op.return_type, table, ref_ns) {
            (@Type()) as rt => if !is_bool(rt) { return op_diag(op, $"a comparison `operator {op.name}` must return `bool`") }
            error as e => return e
        }
    }
    if op.name == "__index" && !newtype_base_is_indexed(td, ref_ns, table) {
        return op_diag(op, $"`operator __index` is allowed only on an indexed value-type (over `str` or `[]T`), never a scalar newtype")
    }
    null
}

fn check_comparator_counterparts(methods: []parser::Function): null | error {
    var i = 0
    loop {
        if i >= methods.len { break }
        if methods[i].is_operator {
            var want = comparator_counterpart(methods[i].name)
            if want != "" && !func_list_has_name(operator_members(methods), want) {
                return op_diag(methods[i], $"defining `operator {methods[i].name}` requires its counterpart `operator {want}`")
            }
        }
        i++
    }
    null
}

fn titem_prefix(xs: []@TItem(), n: u64): []@TItem() {
    var out: [n]@TItem() = []
    var i: u64 = 0
    loop { if i >= n { break }; out[i] = xs[i]; i++ }
    out
}

fn tstmt_prefix(xs: []@TStatement(), n: u64): []@TStatement() {
    var out: [n]@TStatement() = []
    var i: u64 = 0
    loop { if i >= n { break }; out[i] = xs[i]; i++ }
    out
}

fn operator_members(methods: []parser::Function): []parser::Function {
    var out: [methods.len]parser::Function = []
    var count: u64 = 0
    var i = 0
    loop {
        if i >= methods.len { break }
        if methods[i].is_operator { out[count] = methods[i]; count++ }
        i++
    }
    teko::collections::arr_slice(out, 0, count)
}

fn check_operator_invariants(td: parser::TypeDecl, ref_ns: str, table: TypeTable): null | error {
    var ops = type_body_operators(td.body)
    var i = 0
    loop {
        if i >= ops.len { break }
        match check_one_operator(td, ops[i], ref_ns, table) { error as e => return e; null => { } }
        i++
    }
    if is_value_type_body(td.body) {
        var vmethods = value_type_body_methods(td.body)
        match check_value_type_self_readonly(td, vmethods, table) { error as e => return e; null => { } }
        match check_comparator_counterparts(vmethods) { error as e => return e; null => { } }
    }
    null
}

fn check_value_type_self_readonly(td: parser::TypeDecl, methods: []parser::Function, table: TypeTable): null | error {
    var i = 0 to u64
    loop {
        if i >= methods.len { break }
        var m = methods[i]
        var is_instance = !m.is_operator && !m.is_static && m.params.len > 0 && !m.params[0].has_type
        if is_instance && method_mutates_self(td.name, m, table) {
            return error { message = $"cannot mutate `self` in method `{m.name}` of value-type `{td.name}` — a subtype of a primitive/enum/flags carries a readonly `self` (the value IS the primitive)" }
        }
        i++
    }
    null
}

fn type_struct_methods(td: parser::TypeDecl, item_ns: str, file: str, env: Env, table: TypeTable): []@TItem() | error {
    match check_operator_invariants(td, item_ns, table) { error as e => return e; null => { } }
    var methods: []parser::Function = []
    var base_name = ""
    var is_class = false
    var own_names: []str = []
    match td.body {
        parser::StructBody as sb => { methods = sb.methods }
        parser::ClassBody as cb => {
            methods = match effective_class_methods(cb, table) { []parser::Function as f => f; error as e => return e }
            base_name = cb.base_name
            is_class = true
            var names_buf: [cb.methods.len]str = []
            var oi = 0
            loop { if oi >= cb.methods.len { break }; names_buf[oi] = cb.methods[oi].name; oi++ }
            own_names = names_buf
        }
        parser::NewtypeBody as nb => { methods = nb.methods }
        parser::EnumBody as eb => { methods = eb.methods }
        parser::FlagsBody as fb => { methods = fb.methods }
        _ => { }
    }
    var out: [methods.len]@TItem() = []
    var nout: u64 = 0
    var method_ns = if item_ns == "" { td.name } else { item_ns ~ "::" ~ td.name }
    var mi = 0
    loop {
        if mi >= methods.len { break }
        if methods[mi].is_abstract { mi++; continue }
        var use_base = base_name != "" && str_set_has(own_names, methods[mi].name)
        var declaring_class = if is_class {
            match find_method_owner(td.name, table, methods[mi].name) { MemberOwner as mo => mo.declaring_class; error => td.name }
        } else {
            td.name
        }
        var mf = match type_method(methods[mi], td.name, with_file(env, file), table, use_base, base_name, declaring_class) {
            TFunction as x => x
            error as e => return surface_at(file, methods[mi].line, methods[mi].col, e)
        }
        var mov = overload_suffix_for_method(env, method_ns, methods[mi], td.name, item_ns, table)
        var stamped = TFunction { overload_suffix = mov; name = mf.name; type_params = mf.type_params; type_constraints = mf.type_constraints; params = mf.params; return_type = mf.return_type; body = mf.body; vis = mf.vis; has_doc = mf.has_doc; doc = mf.doc; namespace = method_ns; file = file; line = methods[mi].line; col = methods[mi].col; is_test = mf.is_test; is_extern = mf.is_extern; c_symbol = mf.c_symbol; from_lib = mf.from_lib; ret_extra = mf.ret_extra; guard = parser::pred_true() }
        out[nout] = stamped
        nout++
        mi++
    }
    titem_prefix(out, nout)
}

fn type_type_member_consts(td: parser::TypeDecl, item_ns: str, file: str, env: Env, table: TypeTable): []@TItem() | error {
    var eff = match td.body {
        parser::ClassBody as cb => match effective_class_consts(cb, table) { []parser::ConstDecl as c => c; error as e => return e }
        _ => body_consts(td.body)
    }
    var type_canonical = qualify(item_ns, td.name)
    var out: [eff.len]@TItem() = []
    var i: u64 = 0
    loop {
        if i >= eff.len { break }
        var cd = eff[i]
        var ti = match type_const_decl(cd, with_file(env, file), table) { TConstDecl as x => x; error as e => return surface_at(file, cd.line, cd.col, e) }
        out[i] = TConstDecl { name = member_const_symbol(type_canonical, cd.name); namespace = item_ns; ty = ti.ty; init = ti.init; vis = ti.vis; has_doc = ti.has_doc; doc = ti.doc; line = cd.line; col = cd.col; guard = parser::pred_true() }
        i++
    }
    out
}

fn type_const_decl(cd: parser::ConstDecl, env: Env, table: TypeTable): TConstDecl | error {
    var at = match resolve_type(cd.ty, table, env.cur_ns) { (@Type()) as t => t; error as e => return e }
    var v = match type_value_expected(cd.init, at, env, table) { TExpr as te => te; error as e => return e }
    if type_is_void(v.type) { return error { message = "a const initializer cannot be a `void` expression — it yields no value" } }
    if !assignable_to(v.type, at, table) {
        match annotated_literal_ok(cd.init, at) {
            null => v = retype_literal(v, at)
            error as e => return teko::error::err_typed(e, type_render(at), type_render(v.type))
        }
    }
    var at_is_sentinel_slice = match at { Slice as bs => match bs.element { Void => true; _ => false }; _ => false }
    if at_is_sentinel_slice {
        return error { message = "a const of an element-less slice type needs a concrete element (e.g. `const XS: []u8 = …`)" }
    }
    var v_is_sentinel_slice = match v.type { Slice as vs => match vs.element { Void => true; _ => false }; _ => false }
    if v_is_sentinel_slice { v = TExpr { kind = v.kind; type = at; line = v.line; col = v.col } }
    match is_const_expr(v, table, env) { error as e => return e; null => { } }
    TConstDecl { name = cd.name; namespace = env.cur_ns; ty = at; init = v; vis = cd.vis; has_doc = cd.has_doc; doc = cd.doc; line = cd.line; col = cd.col; guard = parser::pred_true() }
}

fn type_item(item: parser::Item, env: Env, table: TypeTable): @TItem() | error {
    var fenv = with_file(env, item.file)
    match item.content {
        parser::Function as f => {
            var tf = match type_function(f, fenv, table) { TFunction as x => x; error as e => return e }
            var ov = overload_suffix_for_decl(env, item.namespace, tf.name, tf, table)
            TFunction { overload_suffix = ov; name = tf.name; type_params = tf.type_params; type_constraints = tf.type_constraints; params = tf.params; return_type = tf.return_type; body = tf.body; vis = tf.vis; has_doc = tf.has_doc; doc = tf.doc; namespace = item.namespace; file = item.file; line = f.line; col = f.col; is_test = tf.is_test; is_extern = tf.is_extern; c_symbol = tf.c_symbol; from_lib = tf.from_lib; ret_extra = tf.ret_extra; guard = item.guard }
        }
        parser::TypeDecl as td => {
            var cd = if name_is_g_instance(td.name) { td } else {
                parser::TypeDecl { name = qualify(item.namespace, td.name); type_params = td.type_params; type_constraints = td.type_constraints; body = td.body; vis = td.vis; has_doc = td.has_doc; doc = td.doc; line = td.line; col = td.col; is_global = false }
            }
            normalize_inst_decl(cd, table)
        }
        parser::UseDecl as ud => ud
        (@Statement()) as s => {
            var ts = match type_statement(s, fenv, table) { TypedStmt as x => x; error as e => return e }
            ts.node
        }
        parser::ConstDecl as cd => {
            var ti = match type_const_decl(cd, fenv, table) { TConstDecl as x => x; error as e => return e }
            TConstDecl { name = ti.name; namespace = item.namespace; ty = ti.ty; init = ti.init; vis = ti.vis; has_doc = ti.has_doc; doc = ti.doc; line = cd.line; col = cd.col; guard = item.guard }
        }
        parser::MacroDecl => return error { message = "internal: a `macro` declaration reached typed-item production — a Family-A macro is expanded pre-type-check" }
        parser::ComptimeDecl => return error { message = "internal: a `comptime` declaration reached typed-item production — a Family-B comptime decl is captured by the comptime registry and dropped before the item walk" }
    }
}

fn surface_at(file: str, item_line: u32, item_col: u32, inner: error): error {
    var el = if inner.line != 0 { inner.line } else { item_line }
    var ec = if inner.line != 0 { inner.col } else { item_col }
    var located = error { message = diag_at(file, el, ec, inner.message) }
    var positioned = teko::error::err_loc(located, el, ec)
    teko::error::err_typed(positioned, inner.expected, inner.actual)
}

pub type ProgressFn = action<u64, u64>

pub type PreMono = struct {
    prog: TProgram
    table: TypeTable
    diags: []str
}

fn no_item_progress(done: u64, total: u64) { }

pub fn type_program_with_deps(raw_program: parser::Program, dep_prog: TProgram): TProgram | error {
    var pre = match type_program_with_deps_pre_mono(raw_program, dep_prog, no_item_progress, false) { PreMono as p => p; error as e => return e }
    if pre.diags.len > 0 { return error { message = join_checker_diags(pre.diags) } }
    var mono = match monomorphize(pre.prog, pre.table) { TProgram as mp => mp; error as e => return e }
    inline_consts(mono)
}

type PreMonoItemOut = struct {
    contrib: []@TItem()
    body_stmts: []@TStatement()
}

type TypeDeclExtra = struct {
    method_items: []@TItem()
    const_items: []@TItem()
    diags: []str
}

fn pre_mono_type_decl_extra(td: parser::TypeDecl, ns: str, file: str, line: u32, col: u32, ienv: Env, types: TypeTable): TypeDeclExtra {
    var method_items: []@TItem() = []
    var const_items: []@TItem() = []
    var diags: []str = []
    match type_struct_methods(td, ns, file, ienv, types) {
        []@TItem() as mitems => { method_items = mitems }
        error as e => { diags = [..diags, located_diag(file, line, col, e)] }
    }
    match type_type_member_consts(td, ns, file, ienv, types) {
        []@TItem() as citems => { const_items = citems }
        error as e => { diags = [..diags, located_diag(file, line, col, e)] }
    }
    TypeDeclExtra { method_items = method_items; const_items = const_items; diags = diags }
}

fn pre_mono_type_decl_items(ti: @TItem(), extra: TypeDeclExtra): []@TItem() {
    var combined: [1 + extra.method_items.len + extra.const_items.len]@TItem() = []
    combined[0] = ti
    var ci: u64 = 1
    var mi2: u64 = 0
    loop { if mi2 >= extra.method_items.len { break }; combined[ci] = extra.method_items[mi2]; ci++; mi2++ }
    var ci2: u64 = 0
    loop { if ci2 >= extra.const_items.len { break }; combined[ci] = extra.const_items[ci2]; ci++; ci2++ }
    combined
}

pub fn type_program_with_deps_pre_mono(raw_program: parser::Program, dep_prog: TProgram, on_item: ProgressFn, explicit: bool): PreMono | error {
    var folded = fold_traits_collected(raw_program)
    if folded.diags.len > 0 { return PreMono { prog = TProgram { items = [] }; table = tt_empty(); diags = folded.diags } }
    var program = synthesize_mret_structs(canon_class_bases(folded.program))
    var seed_empty = Collected { types = tt_empty(); env = with_explicit(env_empty(), explicit) }
    var seed = match seed_from_dep(dep_prog, seed_empty.types, seed_empty.env) {
        Collected as s => s
        error as e => return e
    }
    var pre = pre_walk(program, collect_with_seed(program, seed))
    if pre.cut { return PreMono { prog = TProgram { items = [] }; table = pre.types; diags = pre.diags } }
    var types = pre.types
    var cenv = pre.env
    program = drop_comptime_items(program)
    var per_item: [program.items.len]PreMonoItemOut = []
    var diags: []str = pre.diags
    var cur = cenv
    var i = 0
    loop {
        if i >= program.items.len { break }
        var it = program.items[i]
        cur = with_ns(cur, it.namespace)
        var ienv = with_ns(cenv, it.namespace)
        var line: u32 = 0
        var col: u32 = 0
        match it.content {
            parser::Function as f => { line = f.line; col = f.col }
            parser::TypeDecl as td => { line = td.line; col = td.col }
            parser::ConstDecl as cd => { line = cd.line; col = cd.col }
            _ => { }
        }
        var contrib: []@TItem() = []
        var body_stmts: []@TStatement() = []
        match it.content {
            (@Statement()) as s => match top_level_stmt_nodes(s, with_file(cur, it.file), types) {
                TStmtSeq as seq => {
                    var conv: [seq.stmts.len]@TItem() = []
                    var sci: u64 = 0
                    loop { if sci >= seq.stmts.len { break }; conv[sci] = seq.stmts[sci]; sci++ }
                    contrib = conv
                    body_stmts = seq.stmts
                    cur = seq.env
                }
                error as e => { diags = [..diags, located_diag(it.file, line, col, e)] }
            }
            _ => {
                match type_item(it, ienv, types) {
                    (@TItem()) as ti => {
                        match it.content {
                            parser::TypeDecl as td => {
                                var extra = pre_mono_type_decl_extra(td, it.namespace, it.file, line, col, ienv, types)
                                diags = [..diags, ..extra.diags]
                                contrib = pre_mono_type_decl_items(ti, extra)
                            }
                            _ => { contrib = [ti] }
                        }
                    }
                    error as e => { diags = [..diags, located_diag(it.file, line, col, e)] }
                }
            }
        }
        per_item[i] = PreMonoItemOut { contrib = contrib; body_stmts = body_stmts }
        i++
        on_item(i to u64, program.items.len)
    }
    var items_total: u64 = 0
    var mainbody_total: u64 = 0
    var si2: u64 = 0
    loop {
        if si2 >= per_item.len { break }
        items_total = items_total + per_item[si2].contrib.len
        mainbody_total = mainbody_total + per_item[si2].body_stmts.len
        si2++
    }
    var items: [items_total]@TItem() = []
    var mainbody: [mainbody_total]@TStatement() = []
    var ik: u64 = 0
    var bk: u64 = 0
    var si3: u64 = 0
    loop {
        if si3 >= per_item.len { break }
        var po = per_item[si3]
        var cj: u64 = 0
        loop { if cj >= po.contrib.len { break }; items[ik] = po.contrib[cj]; ik++; cj++ }
        var bj: u64 = 0
        loop { if bj >= po.body_stmts.len { break }; mainbody[bk] = po.body_stmts[bj]; bk++; bj++ }
        si3++
    }
    var lc = check_labels(mainbody, [], false, [])
    if lc.failed { diags = [..diags, lc.message] }
    var all_items: [dep_prog.items.len + items.len]@TItem() = []
    var ak: u64 = 0
    var di: u64 = 0
    loop {
        if di >= dep_prog.items.len { break }
        all_items[ak] = dep_prog.items[di]
        ak++
        di++
    }
    var pi: u64 = 0
    loop {
        if pi >= items.len { break }
        all_items[ak] = items[pi]
        ak++
        pi++
    }
    var tp = TProgram { items = all_items }
    PreMono { prog = tp; table = types; diags = diags }
}

type PreWalk = struct {
    types: TypeTable
    env: Env
    diags: []str
    cut: bool
}

fn pre_walk(program: parser::Program, col: CollectOutcome): PreWalk {
    var table = col.collected.types
    var module_diags = check_modules(program, table)
    var types = tt_with_comptimes(tt_freeze(instantiate_types(program, table)), collect_comptime_decls(program))
    var insts = register_instance_methods(col.collected.env, types)
    var diags = concat_diags(col.decl_diags, col.sig_diags)
    diags = concat_diags(diags, module_diags)
    diags = concat_diags(diags, insts.diags)
    var cut = col.sig_diags.len > 0 || insts.diags.len > 0
    PreWalk { types = types; env = seal(insts.env); diags = diags; cut = cut }
}

fn collect_comptime_decls(program: parser::Program): []ComptimeReg {
    var out: [program.items.len]ComptimeReg = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= program.items.len { break }
        match program.items[i].content {
            parser::ComptimeDecl as cd => { out[count] = ComptimeReg { decl = cd; namespace = program.items[i].namespace }; count = count + 1 }
            _ => { }
        }
        i++
    }
    teko::collections::arr_slice(out, 0, count)
}

fn item_is_comptime_decl(it: parser::Item): bool {
    match it.content { parser::ComptimeDecl => true; _ => false }
}

fn drop_comptime_items(program: parser::Program): parser::Program {
    var out: [program.items.len]parser::Item = []
    var count: u64 = 0
    var i: u64 = 0
    loop {
        if i >= program.items.len { break }
        if !item_is_comptime_decl(program.items[i]) {
            out[count] = program.items[i]
            count++
        }
        i++
    }
    parser::Program { items = teko::collections::arr_slice(out, 0, count) }
}

pub fn type_program(raw_program: parser::Program): TProgram | error {
    var folded = fold_traits_collected(raw_program)
    if folded.diags.len > 0 { return diags_error(folded.diags) }
    var program = synthesize_mret_structs(canon_class_bases(folded.program))
    var pre = pre_walk(program, collect(program))
    if pre.diags.len > 0 { return diags_error(pre.diags) }
    var types = pre.types
    var cenv = pre.env
    program = drop_comptime_items(program)
    var outs: [program.items.len]TopItemOut = []
    var total: u64 = 0
    var mbtotal: u64 = 0
    var cur = cenv
    var i = 0
    loop {
        if i >= program.items.len { break }
        var out = match type_top_level_item(program.items[i], cur, cenv, types) { TopItemOut as x => x; error as e => return e }
        outs[i] = out
        total = total + out.items.len
        mbtotal = mbtotal + out.mainbody.len
        cur = out.env
        i++
    }
    var items = flatten_titem_chunks(outs, total)
    var mainbody = flatten_tstmt_chunks(outs, mbtotal)
    var lc = check_labels(mainbody, [], false, [])
    if lc.failed { return error { message = lc.message } }
    var tp = TProgram { items = items }
    var mono = match monomorphize(tp, types) { TProgram as mp => mp; error as e => return e }
    inline_consts(mono)
}

type TopItemOut = struct {
    items: []@TItem()
    mainbody: []@TStatement()
    env: Env
}

fn type_top_level_item(it: parser::Item, cur: Env, cenv: Env, types: TypeTable): TopItemOut | error {
    var ns_cur = with_ns(cur, it.namespace)
    var ienv = with_ns(cenv, it.namespace)
    var line: u32 = 0
    var col: u32 = 0
    match it.content {
        parser::Function as f => { line = f.line; col = f.col }
        parser::TypeDecl as td => { line = td.line; col = td.col }
        parser::ConstDecl as cd => { line = cd.line; col = cd.col }
        _ => { }
    }
    match it.content {
        (@Statement()) as s => {
            var seq = match top_level_stmt_nodes(s, with_file(ns_cur, it.file), types) {
                TStmtSeq as x => x
                error as e => return surface_at(it.file, line, col, e)
            }
            return TopItemOut { items = stmts_as_items(seq.stmts); mainbody = seq.stmts; env = seq.env }
        }
        _ => { }
    }
    var ti = match type_item(it, ienv, types) {
        (@TItem()) as x => x
        error as e => return surface_at(it.file, line, col, e)
    }
    match it.content {
        parser::TypeDecl as td => {
            var mitems = match type_struct_methods(td, it.namespace, it.file, ienv, types) { []@TItem() as x => x; error as e => return e }
            var citems = match type_type_member_consts(td, it.namespace, it.file, ienv, types) { []@TItem() as x => x; error as e => return e }
            return TopItemOut { items = [..[ti], ..mitems, ..citems]; mainbody = []; env = ns_cur }
        }
        _ => { }
    }
    TopItemOut { items = [ti]; mainbody = []; env = ns_cur }
}

fn stmts_as_items(stmts: []@TStatement()): []@TItem() {
    var out: [stmts.len]@TItem() = []
    var i: u64 = 0
    loop { if i >= stmts.len { break }; out[i] = stmts[i]; i++ }
    out
}

fn flatten_titem_chunks(outs: []TopItemOut, total: u64): []@TItem() {
    var out: [total]@TItem() = []
    var k: u64 = 0
    var ci: u64 = 0
    loop {
        if ci >= outs.len { break }
        var chunk = outs[ci].items
        var cj: u64 = 0
        loop { if cj >= chunk.len { break }; out[k] = chunk[cj]; k++; cj++ }
        ci++
    }
    out
}

fn flatten_tstmt_chunks(outs: []TopItemOut, total: u64): []@TStatement() {
    var out: [total]@TStatement() = []
    var k: u64 = 0
    var ci: u64 = 0
    loop {
        if ci >= outs.len { break }
        var chunk = outs[ci].mainbody
        var cj: u64 = 0
        loop { if cj >= chunk.len { break }; out[k] = chunk[cj]; k++; cj++ }
        ci++
    }
    out
}
