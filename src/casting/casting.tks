use teko::math

fn cast_error(reason: str): error { error { message = reason } }

/** teko::casting::u64_to_u32 — checked narrowing of a `u64` to `u32` (no panic).
 * @throws error when `v > u32::MAX`. */
exp fn u64_to_u32(v: u64): u32 | error {
    if v > math::U32_MAX { return cast_error("casting::u64_to_u32: value does not fit u32") }
    v to u32
}

/** teko::casting::i64_to_u32 — checked narrowing of an `i64` to `u32` (no panic).
 * @throws error when `v` is negative or exceeds `u32::MAX`. */
exp fn i64_to_u32(v: i64): u32 | error {
    if v < 0 { return cast_error("casting::i64_to_u32: negative value does not fit u32") }
    if v > math::U32_MAX { return cast_error("casting::i64_to_u32: value does not fit u32") }
    v to u32
}

/** teko::casting::u64_to_u8 — checked narrowing of a `u64` to `u8` (no panic).
 * @throws error when `v > u8::MAX`. */
exp fn u64_to_u8(v: u64): u8 | error {
    if v > math::U8_MAX { return cast_error("casting::u64_to_u8: value does not fit u8") }
    v to u8
}

/** teko::casting::u32_to_u8 — checked narrowing of a `u32` to `u8` (no panic).
 * @throws error when `v > u8::MAX`. */
exp fn u32_to_u8(v: u32): u8 | error {
    if v > math::U8_MAX { return cast_error("casting::u32_to_u8: value does not fit u8") }
    v to u8
}

/** teko::casting::u64_to_u16 — checked narrowing of a `u64` to `u16` (no panic).
 * @throws error when `v > u16::MAX`. */
exp fn u64_to_u16(v: u64): u16 | error {
    if v > math::U16_MAX { return cast_error("casting::u64_to_u16: value does not fit u16") }
    v to u16
}

/** teko::casting::u32_to_u16 — checked narrowing of a `u32` to `u16` (no panic).
 * @throws error when `v > u16::MAX`. */
exp fn u32_to_u16(v: u32): u16 | error {
    if v > math::U16_MAX { return cast_error("casting::u32_to_u16: value does not fit u16") }
    v to u16
}

/** teko::casting::i64_to_i32 — checked narrowing of an `i64` to `i32` (no panic).
 * @throws error when `v` is outside the `i32` range. */
exp fn i64_to_i32(v: i64): i32 | error {
    if v < math::i32_min() { return cast_error("casting::i64_to_i32: value below i32::MIN") }
    if v > math::I32_MAX { return cast_error("casting::i64_to_i32: value above i32::MAX") }
    v to i32
}

/** teko::casting::u32_to_i32 — checked narrowing of a `u32` to `i32` (no panic).
 * @throws error when `v > i32::MAX`. */
exp fn u32_to_i32(v: u32): i32 | error {
    if v > math::I32_MAX { return cast_error("casting::u32_to_i32: value above i32::MAX") }
    v to i32
}

/** teko::casting::u64_to_i32 — checked narrowing of a `u64` to `i32` (no panic).
 * @throws error when `v > i32::MAX`. */
exp fn u64_to_i32(v: u64): i32 | error {
    if v > math::I32_MAX { return cast_error("casting::u64_to_i32: value above i32::MAX") }
    v to i32
}
