const ZLIB_CMF: u32 = 0x78

fn zlib_flg(cmf: u32): u32 {
    var header = cmf * 256
    var remainder = header % 31
    if remainder == 0 { return 0 }
    31 - remainder
}

/** teko::compress::zlib_compress — compress `data` into a complete zlib stream (RFC 1950). */
exp fn zlib_compress(data: []byte): []byte {
    var cmf = ZLIB_CMF
    var flg = zlib_flg(cmf)
    var payload = teko::compress::deflate(data)
    var checksum = teko::compress::adler32_of(data)
    [
        cmf to byte,
        flg to byte,
        ..payload,
        ((checksum >> 24) & 0xFF) to byte,
        ((checksum >> 16) & 0xFF) to byte,
        ((checksum >> 8) & 0xFF) to byte,
        (checksum & 0xFF) to byte,
    ]
}

/** teko::compress::zlib_decompress — decompress a complete zlib stream, verifying the header
 * checksum and the trailing Adler-32.
 * @throws when `data.len < 6`, `CM != 8`, the header check fails, `FDICT` is set, or the
 * trailing checksum mismatches. */
exp fn zlib_decompress(data: []byte): []byte | error {
    if data.len < 6 { return error { message = "zlib: stream too short for header + trailer" } }

    var cmf = data[0] to u32
    var flg = data[1] to u32
    if (cmf & 0x0F) != 8 { return error { message = "zlib: unsupported compression method (CM != 8)" } }
    if ((cmf * 256) + flg) % 31 != 0 { return error { message = "zlib: header check (FCHECK) failed" } }
    if (flg & 0x20) != 0 { return error { message = "zlib: preset dictionary (FDICT) is not supported" } }

    var payload = slice_bytes(data, 2, data.len - 4)
    var decompressed = match teko::compress::inflate(payload) { []byte as b => b; error as e => return e }

    var trailer_pos = data.len - 4
    var expected = (data[trailer_pos] to u32 << 24) | (data[trailer_pos + 1] to u32 << 16) | (data[trailer_pos + 2] to u32 << 8) | (data[trailer_pos + 3] to u32)
    var actual = teko::compress::adler32_of(decompressed)
    if expected != actual { return error { message = "zlib: Adler-32 checksum mismatch" } }

    decompressed
}
