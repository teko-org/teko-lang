const MAX_STORED_BLOCK_LEN: u64 = 65535

const DEFLATE_STORED_LEN_MASK: u32 = 0xFFFF

const DEFLATE_BYTE_MASK: u32 = 0xFF

fn stored_block(chunk: []byte, is_final: bool): []byte {
    var bfinal_bit: u32 = if is_final { 1 to u32 } else { 0 to u32 }
    var len = chunk.len to u32
    var nlen = (~len) & DEFLATE_STORED_LEN_MASK
    var out: [5 + chunk.len]byte = []
    out[0] = bfinal_bit to byte
    out[1] = (len & DEFLATE_BYTE_MASK) to byte
    out[2] = ((len >> 8) & DEFLATE_BYTE_MASK) to byte
    out[3] = (nlen & DEFLATE_BYTE_MASK) to byte
    out[4] = ((nlen >> 8) & DEFLATE_BYTE_MASK) to byte
    var i: u64 = 0
    loop {
        if i >= chunk.len { break }
        out[5 + i] = chunk[i]
        i++
    }
    out
}

fn slice_bytes(data: []byte, from: u64, to: u64): []byte {
    var n = to - from
    var out: [n]byte = []
    var i: u64 = 0
    loop {
        if i >= n { break }
        out[i] = data[from + i]
        i++
    }
    out
}

/** teko::compress::deflate — compress `data` into a raw DEFLATE stream (RFC 1951); the inverse of
 * `inflate`. Used by `#embed` `Deflate` and by the gzip/zlib containers.
 * @param data  the bytes to compress
 * @return the raw DEFLATE-compressed bytes. */
exp fn deflate(data: []byte): []byte {
    var block_len = MAX_STORED_BLOCK_LEN

    if data.len == 0 {
        return stored_block(data, true)
    }

    var nblocks = (data.len + block_len - 1) / block_len
    var parts: [nblocks][]byte = []
    var total: u64 = 0
    var pos: u64 = 0
    var k: u64 = 0
    loop {
        var remaining = data.len - pos
        var this_len = if remaining < block_len { remaining } else { block_len }
        var chunk = slice_bytes(data, pos, pos + this_len)
        var is_final = pos + this_len >= data.len
        var blk = stored_block(chunk, is_final)
        parts[k] = blk
        total = total + blk.len
        k++
        pos = pos + this_len
        if is_final { break }
    }
    var out: [total]byte = []
    var op: u64 = 0
    var i: u64 = 0
    loop {
        if i >= k { break }
        var blk = parts[i]
        var j: u64 = 0
        loop {
            if j >= blk.len { break }
            out[op] = blk[j]
            op++
            j++
        }
        i++
    }
    out
}
