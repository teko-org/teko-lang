fn crc32_row(i: u32): u32 {
    var crc = i
    var k = 0
    loop {
        if k >= 8 { break }
        if (crc & 1) != 0 {
            crc = (crc >> 1) ^ 0xEDB88320
        } else {
            crc = crc >> 1
        }
        k++
    }
    crc
}

/** teko::compress::crc32_of — the CRC-32 (polynomial 0xEDB88320) of `data`, standard
 * (post-inverted) form (`0` for an empty slice). */
exp fn crc32_of(data: []byte): u32 {
    var crc: u32 = 0xFFFFFFFF
    var i = 0
    loop {
        if i >= data.len { break }
        var byte_val = data[i] to u32
        var idx = (crc ^ byte_val) & 0xFF
        crc = crc32_row(idx) ^ (crc >> 8)
        i++
    }
    crc ^ 0xFFFFFFFF
}

const ADLER32_MODULUS: u32 = 65521

/** teko::compress::adler32_of — the Adler-32 checksum of `data` (RFC 1950 §9), `1` for an
 * empty slice. */
exp fn adler32_of(data: []byte): u32 {
    var a: u32 = 1
    var b: u32 = 0
    var m = ADLER32_MODULUS
    var i = 0
    loop {
        if i >= data.len { break }
        a = (a + (data[i] to u32)) % m
        b = (b + a) % m
        i++
    }
    (b << 16) | a
}

fn zip_u16(buf: []byte, x: u32): []byte {
    var b = buf
    b = [..b, (x & 0xFF) to byte]
    b = [..b, ((x >> 8) & 0xFF) to byte]
    b
}

fn zip_u32(buf: []byte, x: u32): []byte {
    var b = buf
    b = [..b, (x & 0xFF) to byte]
    b = [..b, ((x >> 8) & 0xFF) to byte]
    b = [..b, ((x >> 16) & 0xFF) to byte]
    b = [..b, ((x >> 24) & 0xFF) to byte]
    b
}

fn zip_bytes(buf: []byte, src: []byte): []byte {
    var b = buf
    var i = 0
    loop {
        if i >= src.len { break }
        b = [..b, src[i]]
        i++
    }
    b
}

fn zip_str(buf: []byte, s: str): []byte {
    var b = buf
    var i = 0
    loop {
        if i >= s.len { break }
        b = [..b, s[i]]
        i++
    }
    b
}

fn zip_fixed_dos_date(): u32 { 0x5A21 }

/** ZipMethod — the PKZIP compression-method tag: `Store` (verbatim) or `Deflate` (RFC 1951). */
exp type ZipMethod = enum { Store; Deflate }

fn zip_method_wire(m: ZipMethod): u32 {
    match m { Store => 0; Deflate => 8 }
}

type ZipCDEntry = struct {
    name: str
    crc32: u32
    uncompressed_size: u32
    compressed_size: u32
    method: u32
    offset: u32
}

/** ZipEntry — one archive member: its filename and raw (uncompressed) bytes. */
exp type ZipEntry = struct { name: str; data: []byte }

fn zip_read_u32(data: []byte, pos: u64): u32 {
    (data[pos] to u32) | ((data[pos + 1] to u32) << 8) | ((data[pos + 2] to u32) << 16) | ((data[pos + 3] to u32) << 24)
}

fn zip_read_u16(data: []byte, pos: u64): u64 {
    (data[pos] to u64) | ((data[pos + 1] to u64) << 8)
}

fn zip_extract(data: []byte, pos: u64, len: u64): []byte {
    var out: []byte = []
    var i: u64 = 0
    loop {
        if i >= len { break }
        out = [..out, data[pos + i]]
        i++
    }
    out
}

fn zip_decode_entry(method: u32, stored_bytes: []byte): []byte | error {
    if method == zip_method_wire(ZipMethod::Store) { return stored_bytes }
    if method == zip_method_wire(ZipMethod::Deflate) {
        return match teko::compress::inflate(stored_bytes) {
            []byte as out => out
            error as e => e
        }
    }
    error { message = "read_zip: unsupported compression method" }
}

/** teko::compress::read_zip — parse a PKZIP archive (STORE and/or DEFLATE entries) into its
 * members, decompressing DEFLATE entries transparently. Reads only the local file headers, not
 * the central directory.
 * @throws when a local header's declared sizes run past the end of `data`, or an entry uses an
 * unsupported compression method. */
exp fn read_zip(data: []byte): []ZipEntry | error {
    var pos: u64 = 0
    var result: []ZipEntry = []

    loop {
        if pos + 30 > data.len { break }
        if data[pos] != 0x50 || data[pos + 1] != 0x4B || data[pos + 2] != 0x03 || data[pos + 3] != 0x04 {
            break
        }

        var method = zip_read_u16(data, pos + 8) to u32
        var comp_size = zip_read_u32(data, pos + 18)
        var fname_len = zip_read_u16(data, pos + 26)
        var extra_len = zip_read_u16(data, pos + 28)

        var header_end = pos + 30 + fname_len + extra_len
        if header_end + comp_size > data.len {
            return error { message = "truncated ZIP entry data" }
        }

        var entry_name = str(zip_extract(data, pos + 30, fname_len))
        var stored_bytes = zip_extract(data, header_end, comp_size to u64)
        var entry_data = match zip_decode_entry(method, stored_bytes) {
            []byte as out => out
            error as e => return e
        }

        result = [..result, ZipEntry { name = entry_name; data = entry_data }]
        pos = header_end + comp_size
    }

    result
}

fn zip_encode_entry(method: ZipMethod, data: []byte): []byte {
    match method { Deflate => teko::compress::deflate(data); Store => data }
}

fn write_zip_entries(entries: []ZipEntry, method: ZipMethod): []byte {
    var wire = zip_method_wire(method)
    var buf: []byte = []
    var cd: []ZipCDEntry = []

    var i = 0
    loop {
        if i >= entries.len { break }
        var entry = entries[i]
        var crc = crc32_of(entry.data)
        var uncompressed_size = entry.data.len to u32
        var stored_bytes = zip_encode_entry(method, entry.data)
        var compressed_size = stored_bytes.len to u32
        var off = buf.len to u32

        buf = [..buf, 0x50 to byte]
        buf = [..buf, 0x4B to byte]
        buf = [..buf, 0x03 to byte]
        buf = [..buf, 0x04 to byte]
        buf = zip_u16(buf, 20)
        buf = zip_u16(buf, 0)
        buf = zip_u16(buf, wire)
        buf = zip_u16(buf, 0)
        buf = zip_u16(buf, zip_fixed_dos_date())
        buf = zip_u32(buf, crc)
        buf = zip_u32(buf, compressed_size)
        buf = zip_u32(buf, uncompressed_size)
        buf = zip_u16(buf, entry.name.len to u32)
        buf = zip_u16(buf, 0)
        buf = zip_str(buf, entry.name)
        buf = zip_bytes(buf, stored_bytes)

        cd = [..cd, ZipCDEntry { name = entry.name; crc32 = crc; uncompressed_size = uncompressed_size; compressed_size = compressed_size; method = wire; offset = off }]
        i++
    }

    var cd_offset = buf.len to u32
    var j = 0
    loop {
        if j >= cd.len { break }
        var rec = cd[j]

        buf = [..buf, 0x50 to byte]
        buf = [..buf, 0x4B to byte]
        buf = [..buf, 0x01 to byte]
        buf = [..buf, 0x02 to byte]
        buf = zip_u16(buf, 20)
        buf = zip_u16(buf, 20)
        buf = zip_u16(buf, 0)
        buf = zip_u16(buf, rec.method)
        buf = zip_u16(buf, 0)
        buf = zip_u16(buf, zip_fixed_dos_date())
        buf = zip_u32(buf, rec.crc32)
        buf = zip_u32(buf, rec.compressed_size)
        buf = zip_u32(buf, rec.uncompressed_size)
        buf = zip_u16(buf, rec.name.len to u32)
        buf = zip_u16(buf, 0)
        buf = zip_u16(buf, 0)
        buf = zip_u16(buf, 0)
        buf = zip_u16(buf, 0)
        buf = zip_u32(buf, 0)
        buf = zip_u32(buf, rec.offset)
        buf = zip_str(buf, rec.name)

        j++
    }

    var cd_size = (buf.len to u32) - cd_offset

    buf = [..buf, 0x50 to byte]
    buf = [..buf, 0x4B to byte]
    buf = [..buf, 0x05 to byte]
    buf = [..buf, 0x06 to byte]
    buf = zip_u16(buf, 0)
    buf = zip_u16(buf, 0)
    buf = zip_u16(buf, entries.len to u32)
    buf = zip_u16(buf, entries.len to u32)
    buf = zip_u32(buf, cd_size)
    buf = zip_u32(buf, cd_offset)
    buf = zip_u16(buf, 0)

    buf
}

/** teko::compress::write_zip — assemble a complete ZIP archive with every entry STORED verbatim
 * (method 0). Fully deterministic. */
exp fn write_zip(entries: []ZipEntry): []byte {
    write_zip_entries(entries, ZipMethod::Store)
}

/** teko::compress::write_zip_deflate — assemble a complete ZIP archive with every entry
 * DEFLATE-compressed (method 8); `read_zip` decompresses these transparently. */
exp fn write_zip_deflate(entries: []ZipEntry): []byte {
    write_zip_entries(entries, ZipMethod::Deflate)
}
