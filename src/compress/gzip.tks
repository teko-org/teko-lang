pub const GZIP_MAGIC: []byte = [0x1F to byte, 0x8B to byte]

fn gzip_cm_deflate(): byte { 8 to byte }

fn gzip_header(): []byte {
    var magic = GZIP_MAGIC
    [
        magic[0],
        magic[1],
        gzip_cm_deflate(),
        0 to byte,
        0 to byte,
        0 to byte,
        0 to byte,
        0 to byte,
        0 to byte,
        255 to byte,
    ]
}

/** teko::compress::gzip_compress — compress `data` into a complete gzip member (RFC 1952). */
exp fn gzip_compress(data: []byte): []byte {
    var payload = teko::compress::deflate(data)
    var crc = teko::compress::crc32_of(data)
    var isize = (data.len % 4294967296) to u32
    [
        ..gzip_header(),
        ..payload,
        (crc & 0xFF) to byte,
        ((crc >> 8) & 0xFF) to byte,
        ((crc >> 16) & 0xFF) to byte,
        ((crc >> 24) & 0xFF) to byte,
        (isize & 0xFF) to byte,
        ((isize >> 8) & 0xFF) to byte,
        ((isize >> 16) & 0xFF) to byte,
        ((isize >> 24) & 0xFF) to byte,
    ]
}

/** teko::compress::gzip_decompress — decompress a complete gzip member, verifying magic, method,
 * and the CRC-32/ISIZE trailer; optional header fields are rejected (only members this module
 * wrote are accepted).
 * @throws when `data.len < 18`, the magic/method/flags are wrong, or the trailer mismatches. */
exp fn gzip_decompress(data: []byte): []byte | error {
    if data.len < 18 { return error { message = "gzip: stream too short for header + trailer" } }

    var magic = GZIP_MAGIC
    if data[0] != magic[0] || data[1] != magic[1] { return error { message = "gzip: bad magic bytes" } }
    if data[2] != gzip_cm_deflate() { return error { message = "gzip: unsupported compression method" } }
    if data[3] != (0 to byte) { return error { message = "gzip: optional header fields are not supported" } }

    var payload = slice_bytes(data, 10, data.len - 8)
    var decompressed = match teko::compress::inflate(payload) { []byte as b => b; error as e => return e }

    var trailer_pos = data.len - 8
    var expected_crc = (data[trailer_pos] to u32) | ((data[trailer_pos + 1] to u32) << 8) | ((data[trailer_pos + 2] to u32) << 16) | ((data[trailer_pos + 3] to u32) << 24)
    var actual_crc = teko::compress::crc32_of(decompressed)
    if expected_crc != actual_crc { return error { message = "gzip: CRC-32 checksum mismatch" } }

    var isize_pos = trailer_pos + 4
    var expected_isize = (data[isize_pos] to u32) | ((data[isize_pos + 1] to u32) << 8) | ((data[isize_pos + 2] to u32) << 16) | ((data[isize_pos + 3] to u32) << 24)
    var actual_isize = (decompressed.len % 4294967296) to u32
    if expected_isize != actual_isize { return error { message = "gzip: ISIZE mismatch" } }

    decompressed
}
