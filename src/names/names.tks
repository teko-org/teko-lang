pub const STATUS_OK: i64 = 0

pub const STATUS_UNKNOWN: i64 = -1

pub const STATUS_CLOSED: i64 = -2

pub const STATUS_KIND: i64 = -3

pub const STATUS_FULL: i64 = -4

pub const STATUS_RESERVED: i64 = -5

pub const NO_VALUE: i64 = -9223372036854775807 - 1

/**
 * Opens a program-region cell holding `value`, delegating to the Teko name registry.
 *
 * @param value  the initial cell value
 * @return       the fresh name, or 0 on refusal or slot exhaustion
 */
fn cell_open_raw(value: i64): u64 { teko::runtime::names_cell_open(value) }

/**
 * Reads the cell named `name`, delegating to the Teko name registry.
 *
 * @param name  the cell's name
 * @return      the cell's value, or the reserved no-value payload for a dead name
 */
fn cell_read_raw(name: u64): i64 { teko::runtime::names_cell_read(name) }

/**
 * Reports the cell status of `name`, delegating to the Teko name registry.
 *
 * @param name  the name to check
 * @return      the OK/failure status
 */
fn cell_status_raw(name: u64): i64 { teko::runtime::names_cell_status(name) }

/**
 * Reports the kind-agnostic status of `name`, delegating to the Teko name registry.
 *
 * @param name  the name to classify
 * @return      the OK/failure status
 */
fn status_raw(name: u64): i64 { teko::runtime::names_status(name) }

/**
 * Closes `name`, delegating to the Teko name registry.
 *
 * @param name  the name to close
 * @return      the OK/failure status
 */
fn close_raw(name: u64): i64 { teko::runtime::names_close(name) }

/**
 * Returns the live-name count, delegating to the Teko name registry.
 *
 * @return  the number of live names
 */
fn live_count_raw(): u64 { teko::runtime::names_live_count() }

/**
 * Returns the registry capacity, delegating to the Teko name registry.
 *
 * @return  the slot-array capacity
 */
fn capacity_raw(): u64 { teko::runtime::names_capacity() }

/**
 * Extracts the slot index of `name`, delegating to the Teko name registry.
 *
 * @param name  the packed name
 * @return      the slot index
 */
fn slot_of_raw(name: u64): u64 { teko::runtime::names_slot_of(name) }

/**
 * Extracts the generation stamp of `name`, delegating to the Teko name registry.
 *
 * @param name  the packed name
 * @return      the generation stamp
 */
fn generation_of_raw(name: u64): u64 { teko::runtime::names_generation_of(name) }

pub fn status_text(status: i64): str {
    if status == STATUS_UNKNOWN { return "no such name was ever issued" }
    if status == STATUS_CLOSED { return "the name was closed — it is stale" }
    if status == STATUS_KIND { return "the name stands for another kind of resource" }
    if status == STATUS_FULL { return "the registry has no name left to issue" }
    if status == STATUS_RESERVED { return "a cell cannot hold the reserved payload" }
    "the name is live"
}

fn failure(what: str, status: i64): error {
    error { message = $"teko::names::{what}: {status_text(status)}" }
}

pub fn open_cell(value: i64): u64 | error {
    if value == NO_VALUE { return failure("open_cell", STATUS_RESERVED) }
    var name = cell_open_raw(value)
    if name == 0 { return failure("open_cell", STATUS_FULL) }
    name
}

pub fn read_cell(name: u64): i64 | error {
    var status = cell_status_raw(name)
    if status != STATUS_OK { return failure("read_cell", status) }
    cell_read_raw(name)
}

pub fn close(name: u64): null | error {
    var status = close_raw(name)
    if status != STATUS_OK { return failure("close", status) }
    null
}

pub fn status_of(name: u64): i64 { status_raw(name) }

pub fn is_live(name: u64): bool { status_raw(name) == STATUS_OK }

pub fn live_count(): u64 { live_count_raw() }

pub fn capacity(): u64 { capacity_raw() }

pub fn slot_of(name: u64): u64 { slot_of_raw(name) }

pub fn generation_of(name: u64): u64 { generation_of_raw(name) }
