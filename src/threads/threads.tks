/** IChannelKind — the transport contract for a `chan<T>`: binds a key to a medium and moves
 * values of `T` across it. */
exp type IChannelKind<T> = interface {
    /** init — bind this transport to the channel's constant key. */
    fn init(key: str)
    /** send — move one value across the transport (blocking per the channel's bounds). */
    fn send(v: T)
    /** recv — receive one value from the transport (blocking). */
    fn recv(): T
    /** end — close and drain the transport. */
    fn end()
}

/** Closed — the `Rx.pop` sentinel meaning the channel is closed and drained. */
exp type Closed = struct { }

/** Rx — the single-reader handle of a `chan<T>`, resolved by key via `svc<Rx<T>>(key)`. Never
 * constructed by hand. */
exp type Rx<T> = struct {
    _id: u64

    /** pop — receive the next value, or `Closed` once the channel is closed and drained. */
    pub fn pop(): T | Closed { Closed { } }

    /** add — register one consumer on the channel's WaitGroup by this handle. */
    pub fn add() { }

    /** done — signal this consumer's completion on the WaitGroup by this handle. */
    pub fn done() { }
}

/** Tx — a writer handle of a `chan<T>` (N per channel), resolved by `svc<Tx<T>>(key)`. The
 * producer closes; `closed` observes drain. */
exp type Tx<T> = struct {
    _id: u64
    _closed: bool

    /** send — send one value (by copy). `closed` reports drain. */
    pub fn send(v: T): null { null }

    /** close — the producer closes: invoke the transport `end` (close + drain); idempotent. */
    pub fn close() { }

    /** add — register one producer on the WaitGroup by this handle. */
    pub fn add() { }

    /** done — signal this producer's completion on the WaitGroup by this handle. */
    pub fn done() { }

    /** closed — has the channel been closed (and is it draining/drained)? */
    pub get closed(): bool { self._closed }
}

/** Ctx — the channel's owner handle: a manual WaitGroup plus the channel-lifetime teardown. The
 * creator alone holds it. */
exp type Ctx = struct {
    _id: u64

    /** add — register `n` awaited tasks on the WaitGroup (call before spawn). */
    pub fn add(n: usize) { }

    /** wait — block until the WaitGroup counter reaches zero. */
    pub fn wait() { }

    /** close — the reserve close of the channel (invoke transport `end`); idempotent with the
     * producer's close. */
    pub fn close() { }
}
