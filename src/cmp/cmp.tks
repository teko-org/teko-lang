/** Equality capability: implement `operator __eq`; its counter-part `__ne` is part of the contract. */
exp type IEq = interface {
    /** True iff `left` equals `right`. */
    operator __eq(left: self, right: self): bool
    /** True iff `left` differs from `right`. */
    operator __ne(left: self, right: self): bool
}

/** Total-ordering capability: implement all four comparators. */
exp type IOrd = interface {
    /** True iff `left` orders strictly before `right`. */
    operator __lt(left: self, right: self): bool
    /** True iff `left` orders strictly after `right`. */
    operator __gt(left: self, right: self): bool
    /** True iff `left` does not order after `right`. */
    operator __le(left: self, right: self): bool
    /** True iff `left` does not order before `right`. */
    operator __ge(left: self, right: self): bool
}

/** Hashing capability: implement `hash(): u64`, consistent with `IEq`. */
exp type IHash = interface {
    /** 64-bit hash of the receiver; two `__eq`-equal receivers must hash equal. */
    fn hash(): u64
}

/** Derives `__ne` for an `IEq` composer as `!(left == right)`. */
exp type NeByEq = trait {
    operator __ne(left: self, right: self): bool { !(left == right) }
}

/** Derives `__gt` for an `IOrd` composer as `right < left`. */
exp type GtByLt = trait {
    operator __gt(left: self, right: self): bool { right < left }
}

/** Derives `__le` for an `IOrd` composer as `!(right < left)`. */
exp type LeByLt = trait {
    operator __le(left: self, right: self): bool { !(right < left) }
}

/** Derives `__ge` for an `IOrd` composer as `!(left < right)`. */
exp type GeByLt = trait {
    operator __ge(left: self, right: self): bool { !(left < right) }
}
