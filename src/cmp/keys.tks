/** `str` wrapped as a hashable, totally-ordered key for `Dictionary`/`HashSet`/`SortedSet`/… */
exp type StrKey = struct IEq & IHash & NeByEq & IOrd & GtByLt & LeByLt & GeByLt {
    key: str
    /** True iff the wrapped strings are byte-equal. */
    operator __eq(left: self, right: self): bool { left.key == right.key }
    /** True iff `left` orders lexicographically before `right`. */
    operator __lt(left: self, right: self): bool { teko::runtime::str_compare(left.key, right.key) < 0 }
    /** FNV-1a hash of the wrapped key's bytes. */
    fn hash(): u64 { teko::runtime::str_hash(self.key) }
}

/** `i64` wrapped as a hashable, totally-ordered key for `Dictionary`/`HashSet`/`SortedSet`/… */
exp type I64Key = struct IEq & IHash & NeByEq & IOrd & GtByLt & LeByLt & GeByLt {
    n: i64
    /** True iff the wrapped integers are equal. */
    operator __eq(left: self, right: self): bool { left.n == right.n }
    /** True iff `left`'s integer is less than `right`'s. */
    operator __lt(left: self, right: self): bool { left.n < right.n }
    /** Zig-zag hash of `n` to a non-negative `u64` (sign-safe). */
    fn hash(): u64 {
        var v = self.n
        if v < 0 { return ((0 - (v + 1)) to u64) * 2 + 1 }
        (v to u64) * 2
    }
}
