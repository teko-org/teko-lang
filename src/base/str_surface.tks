/**
 * str — the UTF-8 string surface: a newtype over `[]byte` that shares its `{ptr, len}` fat layout,
 * carrying the string methods. A reserved name; only base-provenance may declare it. It is a
 * borrowed value-view over its bytes, never an owner of an arena.
 */
exp global type str = []byte {
    /**
     * Reports whether `self` ends with `needle`.
     *
     * @param needle  the candidate suffix
     * @return        true iff `self`'s final bytes equal `needle`
     */
    fn ends_with(needle: str): bool { teko::runtime::str_ends_with(self, needle) }

    /**
     * Reports whether `needle` occurs anywhere in `self`.
     *
     * @param needle  the candidate substring
     * @return        true iff `self` contains `needle` (always true for an empty needle)
     */
    fn contains(needle: str): bool { teko::runtime::str_contains(self, needle) }

    /**
     * The `char` at 0-based codepoint index `i`.
     *
     * @param i  the codepoint index, zero-based
     * @return   the codepoint at `i`, borrowing into `self`
     * @throws   when `i` is negative or past the last codepoint
     */
    fn char_at(i: i64): char { teko::runtime::char_at(self, i) }

    /**
     * `self` split into one `char` per UTF-8 codepoint.
     *
     * @return  a slice of codepoints, each borrowing into `self`
     */
    fn chars(): []char { teko::runtime::chars(self) }

    /**
     * The number of UTF-8 codepoints in `self`.
     *
     * @return  the codepoint count
     */
    fn len_chars(): i64 { teko::runtime::len_chars(self) }

    /**
     * The number of bytes in `self`.
     *
     * @return  the byte length
     */
    fn len(): u64 { teko::runtime::str_len(self) }

    /**
     * The byte substring `[start, end)` of `self`, as a zero-copy view sharing `self`'s buffer.
     *
     * @param start  the inclusive start byte index
     * @param end    the exclusive end byte index
     * @return       the substring view into `self`
     * @throws       when the range is inverted or past the end
     */
    fn slice(start: u64, end: u64): str { teko::runtime::str_slice(self, start, end) }

    /**
     * The byte prefix `[0, end)` of `self`, as a zero-copy view sharing `self`'s buffer.
     *
     * @param end  the exclusive end byte index
     * @return     the prefix view into `self`
     * @throws     when `end` is past the end
     */
    fn slice_to(end: u64): str { teko::runtime::str_slice_to(self, end) }

    /**
     * The byte suffix `[start, len)` of `self`, as a zero-copy view sharing `self`'s buffer.
     *
     * @param start  the inclusive start byte index
     * @return       the suffix view into `self`
     * @throws       when `start` is past the end
     */
    fn slice_from(start: u64): str { teko::runtime::str_slice_from(self, start) }

    /**
     * The substring of `self` from codepoint index `from` (inclusive) to `to` (exclusive), as a
     * zero-copy view.
     *
     * @param from  the inclusive start codepoint index
     * @param to    the exclusive end codepoint index
     * @return      the codepoint-bounded view into `self`
     * @throws      when the range is negative, inverted, or out of range
     */
    fn slice_chars(from: i64, to: i64): str { teko::runtime::str_slice_chars(self, from, to) }

    /**
     * `self`'s bytes as a `[]byte`, a zero-copy reinterpret sharing the same `{ptr, len}`.
     *
     * @return  the borrowed byte slice
     */
    fn bytes(): []byte { teko::runtime::bytes_of_str(self) }

    /**
     * The raw byte address of `self`'s buffer (NOT NUL-terminated).
     *
     * @return  the base address, as an opaque `ptr`
     */
    fn as_ptr(): ptr { teko::runtime::as_ptr(self) }
}
