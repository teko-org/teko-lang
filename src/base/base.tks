/**
 * ptr — an opaque machine pointer: a newtype over the signed arch-word `isize` with no arithmetic
 * operators declared, so pointer math (`p + n`, `p[n]`) does not type-check by construction. It is the
 * address half of the zero-copy marshall surface; the unsigned address word is `uptr`. Reinterpreting
 * an opaque pointer to a value of a same-representation type is the direct same-base conversion.
 */
exp global type ptr = isize { }

/**
 * uptr — an opaque unsigned machine pointer: a newtype over the unsigned arch-word `usize` with no
 * arithmetic operators, the unsigned address word carried in fat pointers and region handles. Its
 * crossing to `usize` is a Marshall bridge (an explicit `to`, never implicit), keeping a measure and an
 * address from silently interchanging.
 */
exp global type uptr = usize { }

/**
 * sizeof — the byte size of `T` in the target ABI, a monomorphisation fact. A floor primitive recognised
 * by the canonical identity of this declaration, whose call the backend lowers to the concrete constant;
 * a user `sizeof` in scope shadows it like any global. The body is never emitted.
 * @param T the type whose storage size is taken.
 * @return the size of `T` in bytes.
 */
exp global fn sizeof<T>(): usize { 0 }

/**
 * alignof — the byte alignment of `T` in the target ABI, a monomorphisation fact. A floor primitive
 * recognised by the canonical identity of this declaration, lowered by the backend to the concrete
 * constant. The body is never emitted.
 * @param T the type whose alignment is taken.
 * @return the alignment of `T` in bytes.
 */
exp global fn alignof<T>(): usize { 0 }

/**
 * slice — a zero-copy view of the half-open range `[pos, min(pos + len, xs.len))` of `xs`, sharing the
 * backing storage. It is the target of the `recv[pos..len]` subscript-range sugar. `pos` past the end
 * yields an empty view and `len` past the end is clamped to what remains.
 * @param xs  the array to view into.
 * @param pos the start index of the view.
 * @param len the requested length of the view, clamped to `xs.len - pos`.
 * @return a view over the clamped range of `xs`.
 */
exp global fn slice<E>(xs: []E, pos: u64, len: u64): []E {
    if pos > xs.len { return slice_view(xs, xs.len, xs.len) }
    var avail = xs.len - pos
    var n = if len > avail { avail } else { len }
    slice_view(xs, pos, pos + n)
}

/**
 * os — the host operating-system token ("linux", "macos", or "windows"), a compile-time constant
 * fixed to the target the compiler emits for.
 * @return the lowercase OS name.
 */
exp global fn os(): str { os_name() }

#os("linux")
fn os_name(): str { "linux" }

#os("macos")
fn os_name(): str { "macos" }

#os("windows")
fn os_name(): str { "windows" }

/**
 * arch — the host CPU architecture token ("x86_64" or "arm64"), a compile-time constant fixed to the
 * target the compiler emits for.
 * @return the canonical lowercase architecture name.
 */
exp global fn arch(): str { arch_name() }

#arch("x86_64")
fn arch_name(): str { "x86_64" }

#arch("arm64")
fn arch_name(): str { "arm64" }
