/** A calendar date: `i32` days since 1970-01-01 (Gregorian proleptic). No time-of-day, no zone. */
exp type date = struct {
    /** days since 1970-01-01 (may be negative for a pre-epoch date) */
    days: i32
}

/** A time-of-day: `u64` nanoseconds since midnight. Domain `0..86_399_999_999_999`. */
exp type time = struct {
    /** nanoseconds since 00:00:00.000000000 (< 86_400_000_000_000) */
    ticks: u64
}

/** A signed duration/delta: `i64` nanoseconds, +-292 years. Also a monotonic-clock reading. */
exp type span = struct {
    /** the signed nanosecond count (negative = a duration into the past) */
    ticks: i64
}

/** A civil date+time-of-day with no timezone: a `date` and a `time` flattened into one value. */
exp type datetime = struct {
    /** the date component — days since 1970-01-01 */
    days: i32
    /** the time-of-day component — ns since midnight */
    ticks: u64
}

/** A `datetime` with a fixed UTC offset (no geographic zone id). */
exp type dto = struct {
    /** the date component — days since 1970-01-01 */
    days: i32
    /** the time-of-day component — ns since midnight */
    ticks: u64
    /** the fixed UTC offset, in minutes (positive = east of UTC) */
    offset_minutes: i16
}

const NS_PER_DAY: i64 = 86400000000000

const SPAN_MAX: i64 = 9223372036854775807

const SPAN_MIN: i64 = -9223372036854775808

const SPAN_MAX_WHOLE_DAYS: i64 = 106750

const DATE_DAYS_MAX: i64 = 2147483647

const DATE_DAYS_MIN: i64 = -2147483648

#os("linux")
fn clock_read_ns(clockid: i64): i64 {
    var ts = teko::sys::ptr_word(teko::mem::buf_ptr(16))
    _ = teko::sys::syscall2(teko::sys::SYS_CLOCK_GETTIME, clockid, ts)
    (teko::mem::load_u64(ts to u64) to i64) * 1000000000 + (teko::mem::load_u64((ts + 8) to u64) to i64)
}

#os("linux")
fn wall_now_ns(): i64 {
    clock_read_ns(teko::sys::CLOCK_REALTIME to i64)
}

#os("linux")
fn mono_now_ns(): i64 {
    clock_read_ns(teko::sys::CLOCK_MONOTONIC to i64)
}

#os("macos")
fn clock_read_ns(clockid: i32): i64 {
    var ts = teko::sys::ptr_word(teko::mem::buf_ptr(16))
    _ = teko::sys::abi::os_clock_gettime(clockid, ts to u64)
    (teko::mem::load_u64(ts to u64) to i64) * 1000000000 + (teko::mem::load_u64((ts + 8) to u64) to i64)
}

#os("macos")
fn wall_now_ns(): i64 {
    clock_read_ns(teko::sys::CLOCK_REALTIME)
}

#os("macos")
fn mono_now_ns(): i64 {
    clock_read_ns(teko::sys::CLOCK_MONOTONIC)
}

#os("windows")
fn wall_now_ns(): i64 {
    var ft = teko::sys::ptr_word(teko::mem::buf_ptr(8))
    teko::sys::abi::GetSystemTimePreciseAsFileTime(ft to u64)
    var ticks = teko::mem::load_u64(ft to u64) to i64
    (ticks - 116444736000000000) * 100
}

#os("windows")
fn mono_now_ns(): i64 {
    var f = teko::sys::ptr_word(teko::mem::buf_ptr(8))
    var c = teko::sys::ptr_word(teko::mem::buf_ptr(8))
    _ = teko::sys::abi::QueryPerformanceFrequency(f to u64)
    _ = teko::sys::abi::QueryPerformanceCounter(c to u64)
    var freq = teko::mem::load_u64(f to u64) to i64
    var cnt = teko::mem::load_u64(c to u64) to i64
    if freq == 0 { return 0 }
    (cnt / freq) * 1000000000 + ((cnt % freq) * 1000000000) / freq
}

extern fn wall_offset_minutes(): i16 = "tk_rt_wall_offset_minutes" from "teko_rt"

fn wall_days(): i32 {
    var secs = wall_now_ns() / 1000000000
    if secs >= 0 { return (secs / 86400) to i32 }
    ((secs - 86399) / 86400) to i32
}

fn wall_ns_of_day(): u64 {
    var ns = wall_now_ns()
    var day_ns: i64 = 86400 * 1000000000
    var rem = ns % day_ns
    if rem < 0 { rem = rem + day_ns }
    rem to u64
}

/** teko::time::monotonic_ns — a monotonic-clock reading in nanoseconds; meaningful only against
 * another reading from the same process run. */
exp fn monotonic_ns(): i64 {
    mono_now_ns()
}

/** teko::time::date_from_days — a `date` from an explicit days-since-epoch value. */
exp fn date_from_days(days: i32): date {
    date { days = days }
}

/** teko::time::time_from_ns — a `time` from an explicit ns-since-midnight value.
 * @throws panics when `ns` is at or past the next midnight (>= 86_400_000_000_000). */
exp fn time_from_ns(ns: u64): time {
    if ns >= 86400000000000 { panic("teko::time: time-of-day ns out of range (must be < 86_400_000_000_000, i.e. < 24h)") }
    time { ticks = ns }
}

/** teko::time::span_from_ns — a `span` from an explicit signed nanosecond count. */
exp fn span_from_ns(ns: i64): span {
    span { ticks = ns }
}

/** teko::time::datetime_of — combine a `date` and a `time` into a `datetime`. */
exp fn datetime_of(d: date, t: time): datetime {
    datetime { days = d.days; ticks = t.ticks }
}

/** teko::time::dto_of — attach a fixed UTC offset to a `datetime`, producing a `dto`. */
exp fn dto_of(dt: datetime, offset_minutes: i16): dto {
    dto { days = dt.days; ticks = dt.ticks; offset_minutes = offset_minutes }
}

/** teko::time::date_today — today's date (UTC, host wall clock). */
exp fn date_today(): date {
    date_from_days(wall_days())
}

/** teko::time::time_now_utc — the current time-of-day (UTC, host wall clock). */
exp fn time_now_utc(): time {
    time_from_ns(wall_ns_of_day())
}

/** teko::time::datetime_now — the current UTC `datetime` (host wall clock). */
exp fn datetime_now(): datetime {
    datetime_of(date_today(), time_now_utc())
}

/** teko::time::dto_local_now — the current local `dto` (host wall clock + local UTC offset). */
exp fn dto_local_now(): dto {
    dto_of(datetime_now(), wall_offset_minutes())
}

/** teko::time::span_monotonic_now — a fresh monotonic-clock reading, as a `span`. Meaningful
 * only against another reading from the SAME process run. */
exp fn span_monotonic_now(): span {
    span_from_ns(monotonic_ns())
}

fn floor_div(a: i64, b: i64): i64 {
    var q = a / b
    var r = a % b
    if r != 0 && (r < 0) != (b < 0) { q - 1 } else { q }
}

fn date_days_checked(days: i64): i32 {
    if days > DATE_DAYS_MAX || days < DATE_DAYS_MIN {
        panic("teko::time: date out of range (a `date` holds +-5.88M years, the i32 day carrier)")
    }
    days to i32
}

/** teko::time::datetime_add — `dt` advanced by `sp` (may be negative), normalizing the
 * ticks-of-day back into `[0, 24h)` and carrying the remainder into the date component.
 * @throws panics when `sp` overflows the ns sum, or the resulting date leaves `date`'s domain. */
exp fn datetime_add(dt: datetime, sp: span): datetime {
    if sp.ticks > SPAN_MAX - (dt.ticks to i64) {
        panic("teko::time: datetime_add overflows the ns span domain (+-292 years)")
    }
    var combined = (dt.ticks to i64) + sp.ticks
    var day_delta = floor_div(combined, NS_PER_DAY)
    var new_ticks = combined - day_delta * NS_PER_DAY
    datetime { days = date_days_checked(dt.days + day_delta); ticks = new_ticks to u64 }
}

/** teko::time::datetime_sub — `dt` moved back by `sp` (`datetime_add(dt, -sp)`).
 * @throws panics when `sp` is `i64::MIN`, or from `datetime_add` on the shifted value. */
exp fn datetime_sub(dt: datetime, sp: span): datetime {
    if sp.ticks == SPAN_MIN {
        panic("teko::time: datetime_sub cannot negate the most negative span (i64::MIN)")
    }
    datetime_add(dt, span { ticks = 0 - sp.ticks })
}

/** teko::time::datetime_diff — the signed duration `a - b`, as a `span`.
 * @throws panics when the true difference exceeds `span`'s +-292-year domain. */
exp fn datetime_diff(a: datetime, b: datetime): span {
    var day_diff = (a.days to i64) - (b.days to i64)
    if day_diff > SPAN_MAX_WHOLE_DAYS || day_diff < 0 - SPAN_MAX_WHOLE_DAYS {
        panic("teko::time: datetime_diff exceeds the span domain (+-292 years)")
    }
    var tick_diff = (a.ticks to i64) - (b.ticks to i64)
    span { ticks = day_diff * NS_PER_DAY + tick_diff }
}

/** teko::time::span_add — the sum of two `span`s.
 * @throws panics when the sum leaves the `i64` nanosecond domain. */
exp fn span_add(a: span, b: span): span {
    if b.ticks >= 0 && a.ticks > SPAN_MAX - b.ticks {
        panic("teko::time: span_add overflows the ns span domain (+-292 years)")
    }
    if b.ticks < 0 && a.ticks < SPAN_MIN - b.ticks {
        panic("teko::time: span_add underflows the ns span domain (+-292 years)")
    }
    span { ticks = a.ticks + b.ticks }
}

/** teko::time::span_sub — the difference of two `span`s (`a - b`).
 * @throws panics when the difference leaves the `i64` nanosecond domain. */
exp fn span_sub(a: span, b: span): span {
    if b.ticks <= 0 && a.ticks > SPAN_MAX + b.ticks {
        panic("teko::time: span_sub overflows the ns span domain (+-292 years)")
    }
    if b.ticks > 0 && a.ticks < SPAN_MIN + b.ticks {
        panic("teko::time: span_sub underflows the ns span domain (+-292 years)")
    }
    span { ticks = a.ticks - b.ticks }
}

/** teko::time::date_add_days — `d` shifted by a signed day count (may be negative).
 * @throws panics when the shifted date leaves `date`'s `i32` domain. */
exp fn date_add_days(d: date, days: i32): date {
    date { days = date_days_checked((d.days to i64) + (days to i64)) }
}

/** teko::time::date_diff_days — the signed day difference `a - b`.
 * @throws panics when the difference does not fit `i32`. */
exp fn date_diff_days(a: date, b: date): i32 {
    date_days_checked((a.days to i64) - (b.days to i64))
}

/** teko::time::timestamp_from_datetime — `dt` as a UNIX timestamp (whole seconds since
 * 1970-01-01T00:00:00Z); lossy — any sub-second remainder is truncated. */
exp fn timestamp_from_datetime(dt: datetime): i64 {
    (dt.days to i64) * 86400 + ((dt.ticks / 1000000000) to i64)
}

/** teko::time::timestamp_to_datetime — a UNIX timestamp as a civil `datetime`.
 * @throws panics when `ts` names a day count outside `date`'s `i32` domain. */
exp fn timestamp_to_datetime(ts: i64): datetime {
    var days = floor_div(ts, 86400)
    var secs_of_day = ts - days * 86400
    datetime { days = days to i32; ticks = (secs_of_day to u64) * 1000000000 }
}

pub type CivilDate = struct {
    year: i64
    month: i64
    day: i64
}

pub fn civil_from_days(days: i64): CivilDate {
    var jdn = days + 2440588
    var f = jdn + 1401 + (((4 * jdn + 274277) / 146097) * 3 / 4) - 38
    var e = 4 * f + 3
    var g = (e % 1461) / 4
    var h = 5 * g + 2
    var day = (h % 153) / 5 + 1
    var month = (h / 153 + 2) % 12 + 1
    var year = e / 1461 - 4716 + (14 - month) / 12
    CivilDate { year = year; month = month; day = day }
}

fn pad_zeros(v: i64, width: i64): str {
    if v < 0 { return teko::str::concat("-", pad_zeros_magnitude(magnitude_of(v), width)) }
    pad_zeros_magnitude(v to u64, width)
}

fn pad_zeros_magnitude(mag: u64, width: i64): str {
    var s = digits_of_magnitude(mag)
    loop {
        if s.len to i64 >= width { break }
        s = teko::str::concat("0", s)
    }
    s
}

fn digits_of(v: i64): str {
    if v < 0 { return teko::str::concat("-", digits_of_magnitude(magnitude_of(v))) }
    digits_of_magnitude(v to u64)
}

fn magnitude_of(v: i64): u64 {
    if v >= 0 { return v to u64 }
    ((0 - (v + 1)) to u64) + 1
}

fn digits_of_magnitude(mag: u64): str {
    if mag == 0 { return "0" }
    var digits: []byte = []
    var n = mag
    loop {
        if n == 0 { break }
        digits = [..digits, (48 + (n % 10)) to byte]
        n = n / 10
    }
    var xs: []byte = []
    var k = digits.len
    loop { if k == 0 { break }; k = k - 1; xs = [..xs, digits[k]] }
    str(xs)
}

fn run_length(pattern: str, i: u64): u64 {
    var c = pattern[i]
    var j = i
    loop { if j >= pattern.len { break }; if pattern[j] != c { break }; j++ }
    j - i
}

/** teko::time::date_to_string — format `d` against a calendar pattern (`yyyy`/`yy`, `MM`/`M`,
 * `dd`/`d`; any other byte passes through literally). */
exp fn date_to_string(d: date, pattern: str): str {
    var civ = civil_from_days(d.days to i64)
    var out = ""
    var i = 0 to u64
    loop {
        if i >= pattern.len { break }
        var c = pattern[i]
        if c == b'y' {
            var n = run_length(pattern, i)
            if n >= 4 { out = teko::str::concat(out, pad_zeros(civ.year, 4)) }
            else { out = teko::str::concat(out, pad_zeros(civ.year % 100, 2)) }
            i = i + n
        } else if c == b'M' {
            var n = run_length(pattern, i)
            if n >= 2 { out = teko::str::concat(out, pad_zeros(civ.month, 2)) }
            else { out = teko::str::concat(out, digits_of(civ.month)) }
            i = i + n
        } else if c == b'd' {
            var n = run_length(pattern, i)
            if n >= 2 { out = teko::str::concat(out, pad_zeros(civ.day, 2)) }
            else { out = teko::str::concat(out, digits_of(civ.day)) }
            i = i + n
        } else {
            out = teko::str::concat(out, teko::one_byte(c))
            i++
        }
    }
    out
}

/** teko::time::time_to_string — format `t` against a clock pattern (`HH`/`H`, `mm`/`m`, `ss`/`s`;
 * any other byte passes through literally). */
exp fn time_to_string(t: time, pattern: str): str {
    var secs = (t.ticks / 1000000000) to i64
    var hour = secs / 3600
    var minute = (secs % 3600) / 60
    var second = secs % 60
    var out = ""
    var i = 0 to u64
    loop {
        if i >= pattern.len { break }
        var c = pattern[i]
        if c == b'H' {
            var n = run_length(pattern, i)
            if n >= 2 { out = teko::str::concat(out, pad_zeros(hour, 2)) }
            else { out = teko::str::concat(out, digits_of(hour)) }
            i = i + n
        } else if c == b'm' {
            var n = run_length(pattern, i)
            if n >= 2 { out = teko::str::concat(out, pad_zeros(minute, 2)) }
            else { out = teko::str::concat(out, digits_of(minute)) }
            i = i + n
        } else if c == b's' {
            var n = run_length(pattern, i)
            if n >= 2 { out = teko::str::concat(out, pad_zeros(second, 2)) }
            else { out = teko::str::concat(out, digits_of(second)) }
            i = i + n
        } else {
            out = teko::str::concat(out, teko::one_byte(c))
            i++
        }
    }
    out
}
