// teko_typeof.tk -- the static-type oracle (delivery 4, crumb C3), and the one
// thing it already pays for: a member access whose receiver is a PARAMETER.
//
// The core answers what a declaration declares -- `decl_find`, `decl_ret`,
// `decl_param_type` (mc docs/reference/hooks.md § "Asking about a declaration
// the core already parsed") -- but only for what it has already parsed, and a
// function is appended to the unit AFTER its own body. So inside `i64 report(
// Shape s) { return s.area(); }` nothing can be asked about `s` while the body
// is being read; the answer exists one phase later, in a `pass()`, where the
// whole unit is there. That is the entire reason this file registers a pass.
//
// Three sources answer, in this order:
//
//   1. the node table teko_struct.tk builds (`tk_xt_ty`) -- a node THIS module
//      produced, so its type is known exactly, scalar fields included;
//   2. the scope of the function being walked -- its N_PARAM list and the
//      N_VAR of its body, which is what `pass()` makes readable;
//   3. the callee's declared return type, for an N_CALL, the type the core
//      itself put on a literal or a cast, and -- for a binary or a unary --
//      the core's own rule over the operands.
//
// It does NOT read `tk_local` (teko_struct.tk): that table belongs to the parse,
// and by the time the pass runs it is empty. It builds its own scope over the
// tree, under the same rule -- a mark per block, cut back on the way out -- so a
// name declared in an inner block answers only there. A name this oracle cannot
// decide -- a scalar global, a receiver it never saw -- answers -1, and only
// THEN does the member's own name get to resolve the access
// (`tk_pend_by_name`). ONE exception (G1, §50): a global `T[]` of heap
// (teko_array.tk's own `tk_ty_global_ha`) IS decided, the same way a global
// scalar array is a compile-time bound instead -- `g.Length` is otherwise
// indistinguishable from any other unknown member.
//
// The consumer here is `.` on a receiver the parser could not type: teko_expr.tk
// DEFERS every one of them rather than guessing from the member's name, because
// a name that only another type declares is not this receiver's member. The
// access is RECORDED and rebuilt in the pass, in the same shapes teko_expr.tk emits
// (field load, field store, direct call, vtable call, itab call). "The same
// shapes" includes the two things a call resolves by: the SIGNATURE the
// argument count picks, whose symbol carries the overload suffix, and the
// arguments the site left out, which come from that same declaration's
// defaults -- a rebuild that skipped either would call another method than the
// one written.
//
// The walk carries a SECOND rewrite, teko_this.tk's: an unqualified name inside
// a method is a member of `this` unless a local or a parameter answers first,
// and the scope this file already maintains is what answers that. A program
// with no deferred `.` and no method at all never enters that walk -- so a tree
// that is not this pass's business is not this pass's to move.
//
// The pass carries one CHECK as well, and it rewrites nothing: Q3's definite
// assignment (D46, `docs/specs/nullable.md` § 8), at the bottom of this file. It
// runs over every unit, because a local read before it is assigned is wrong in a
// program with no deferred `.` exactly as it is in one with a hundred.

#define TK_MAXSCOPE 256               // names of one function: parameters and locals
#define TK_MAXPEND  128               // member accesses waiting for the pass

// what the deferred access still has to become
#define TK_PLOAD  0                   // p.m
#define TK_PSTORE 1                   // p.m = e
#define TK_PCALL  2                   // p.m(...)
#define TK_PIXLOAD  3                 // p.m[i], m an array field the receiver's type only the pass knows
#define TK_PIXSTORE 4                 // p.m[i] = e

// the argument list of a deferred call is read at parse time, by the same
// function teko_expr.tk uses for a call it can resolve at once
i64 tk_args(uptr pn);

// the teko_expr.tk pieces a rebuilt call needs to be the SAME call the parser
// would have produced: the arguments the site left out, taken from the
// declaration the call resolves against, and the two refusals a resolution that
// did not land on a single signature gets -- one for a pick inside a known type,
// one for a pick by name alone
i64 tk_fill_defaults(i64 args, i64 na, i64 np, i64 nreq, i64 d0);
void tk_pick_refuse(i64 mi, uptr m, i64 line, uptr fl);
void tk_loose_refuse(i64 mi, uptr m, i64 line, uptr fl);

// docs/specs/datetime.md § 2: the primitive-member mechanism (teko_prim.tk,
// included after this file because it reads the `pd_*` tables below). Two
// questions only: is this type id a primitive, and what does the deferred
// access on one become.
i64 tk_prim_is(i64 ty);
i64 tk_prim_pend(i64 pi, i64 ty, uptr pty, uptr ppure, uptr pown);
void tk_prim_own_cast_moved(i64 from, i64 to);
i64 tk_prim_op_ret(i64 tok, i64 ta, i64 tb);

// D226 compat crumb: `tk_pend_field`'s own store branch resolves the value
// early when it is itself a deferred access, the same way a receiver already
// does below
void tk_pend_do(i64 pi);

uptr sc_name[TK_MAXSCOPE];            // the names in scope, innermost last
i64  sc_ty[TK_MAXSCOPE];              // the type each was declared with
i64  tk_nscope = 0;

// K4c (D221/§41): the N_FUNC this walk (or teko_deleg.tk's own, same shape)
// is standing on, read by `p_decl_name()`'s fallback once parsing is over --
// `tk_taint_owner()`, teko_deleg.tk's own header.
uptr tk_cur_fn_name = 0;

i64  pd_node[TK_MAXPEND];             // the placeholder the pass rewrites in place
i64  pd_recv[TK_MAXPEND];             // the receiver, parsed and typed later
uptr pd_name[TK_MAXPEND];             // the member on the right of the `.`
i64  pd_arg[TK_MAXPEND];              // the argument list, or the assigned value
i64  pd_na[TK_MAXPEND];
i64  pd_form[TK_MAXPEND];
i64  pd_line[TK_MAXPEND];
uptr pd_file[TK_MAXPEND];
i64  pd_done[TK_MAXPEND];
i64  tk_npend = 0;

// ---- table accessors (no raw ld64/st64 outside this section) ----
uptr sc_name_at(i64 i) { return ld64(sc_name + i * 8); }
i64  sc_ty_at(i64 i)   { return ld64(sc_ty + i * 8); }
i64  pd_node_at(i64 i) { return ld64(pd_node + i * 8); }
i64  pd_recv_at(i64 i) { return ld64(pd_recv + i * 8); }
uptr pd_name_at(i64 i) { return ld64(pd_name + i * 8); }
i64  pd_arg_at(i64 i)  { return ld64(pd_arg + i * 8); }
i64  pd_na_at(i64 i)   { return ld64(pd_na + i * 8); }
i64  pd_form_at(i64 i) { return ld64(pd_form + i * 8); }
i64  pd_line_at(i64 i) { return ld64(pd_line + i * 8); }
uptr pd_file_at(i64 i) { return ld64(pd_file + i * 8); }
i64  pd_done_at(i64 i) { return ld64(pd_done + i * 8); }

void set_sc_name_at(i64 i, uptr v) { st64(sc_name + i * 8, v); }
void set_sc_ty_at(i64 i, i64 v)    { st64(sc_ty + i * 8, v); }
void set_pd_node_at(i64 i, i64 v)  { st64(pd_node + i * 8, v); }
void set_pd_recv_at(i64 i, i64 v)  { st64(pd_recv + i * 8, v); }
void set_pd_name_at(i64 i, uptr v) { st64(pd_name + i * 8, v); }
void set_pd_arg_at(i64 i, i64 v)   { st64(pd_arg + i * 8, v); }
void set_pd_na_at(i64 i, i64 v)    { st64(pd_na + i * 8, v); }
void set_pd_form_at(i64 i, i64 v)  { st64(pd_form + i * 8, v); }
void set_pd_line_at(i64 i, i64 v)  { st64(pd_line + i * 8, v); }
void set_pd_file_at(i64 i, uptr v) { st64(pd_file + i * 8, v); }
void set_pd_done_at(i64 i, i64 v)  { st64(pd_done + i * 8, v); }

// ---- the scope of one function ----
// A STACK, marked at every N_BLOCK the walk enters and cut back when it leaves,
// which is the same shape teko_struct.tk's table of locals has at parse time.
// The newest entry wins, so a declaration inside a block shadows the parameter
// of the same name only while that block is open -- and, once it closes, the
// parameter answers with its own type again instead of being poisoned by a name
// it has nothing to do with.
void tk_ty_scope_add(uptr name, i64 ty) {
    if (tk_nscope == TK_MAXSCOPE) return;        // beyond the table: answers -1
    set_sc_name_at(tk_nscope, name);
    set_sc_ty_at(tk_nscope, ty);
    tk_nscope = tk_nscope + 1;
}

i64 tk_ty_scope_find(uptr name) {
    i64 i = tk_nscope - 1;
    loop {
        if (i < 0) break;
        if (str_eq(sc_name_at(i), name)) return sc_ty_at(i);
        i = i - 1;
    }
    return 0 - 1;
}

// a local the body declares. `nd_val` is the array length, so `Point tbl[4]` --
// four references, not one object -- is skipped, exactly as teko_struct.tk's
// on_stmt hook skips it.
void tk_ty_scope_var(i64 n) {
    if (nd_kind(n) != N_VAR) return;
    if (nd_val(n) != 0) return;
    tk_ty_scope_add(nd_name(n), nd_type(n));
}

// the N_PARAM list carries the declared type as the parser read it -- the id
// `type_new` returned, not a collapsed TY_*, which is what makes a parameter of
// class type answerable at all. A `ref`/`out` parameter is declared at POINTER
// width (K2w), so what the oracle is to report is its POINTEE, which is what
// `tk_param_ty` (teko_ref.tk) answers with.
void tk_ty_scope_params(i64 p) {
    loop {
        if (p == 0) break;
        tk_ty_scope_add(nd_name(p), tk_param_ty(p));
        p = nd_next(p);
    }
}

// ---- the static type of a node, under the scope currently entered ----
i64 tk_ty_of(i64 n);

// teko_deleg.tk is included after this file as well: the N_IDENT a by-value
// `use (...)` reads its local through, which Q3's own walk at the bottom counts
// as an assignment rather than as a read (D46, its own comment there).
i64 tk_capread_is(i64 n);

// teko_null.tk is included after this file: the three members a NULLABLE
// receiver answers, at the deferred position this file owns (Q1a), and the
// one node rule 1 does not judge -- a `null` this project wrote itself.
i64 tk_nl_pend(i64 pi, i64 si, uptr pty, uptr ppure, uptr pown);
i64 tk_nl_own_null_is(i64 n);
// ...and, since Q1b, the two halves of the BOX: the verdict a value gets when
// the slot is a nullable over a value type, and the wrap that writes the box.
void tk_nl_check_value(i64 tty, i64 ti, i64 ety, i64 en, i64 line, uptr fl);
i64 tk_nl_wrap(i64 tty, i64 ety, i64 e);

// A composite expression answers by the CORE's own rule, the one codegen will
// apply to the very same node (mc/src/gen_resolve.mc, res_binary and res_expr's
// N_UNARY arm): a logical operator and a comparison are `i64`, and every other
// binary keeps the LEFT operand's type -- which is the rule the divide and the
// shift already read to pick their signed form. An operand nothing types makes
// the whole expression untyped: -1 travels outward instead of being guessed at.
i64 tk_ty_binary(i64 n) {
    i64 op = nd_op(n);
    if (op == K_ANDAND || op == K_OROR) return TY_I64;
    if (cmp_cond(op) >= 0) return TY_I64;
    i64 ta = tk_ty_of(nd_a(n));
    // docs/specs/datetime.md § 4: a binary with a PRIMITIVE operand answers
    // what its own row answers, which is the one place the core's left-operand
    // rule is not the truth -- `3 * hour` is a `TimeSpan`. The row is asked
    // only when an operand IS a primitive, so every other binary in the
    // language keeps the rule it had, byte for byte.
    if (tk_prim_is(ta)) return tk_prim_op_ret(op, ta, tk_ty_of(nd_b(n)));
    i64 tb = tk_ty_of(nd_b(n));
    if (tk_prim_is(tb)) return tk_prim_op_ret(op, ta, tb);
    return ta;
}

// a `ref`/`out` call argument is an ADDRESS (`p + offset`, `base + idx*width`,
// `&a`), structurally indistinguishable from an ordinary expression that adds
// to a pointer -- so the generic rules below, read over its SHAPE, land on
// whatever the address happens to be built from (`p + offset`'s own LEFT
// operand is `p` itself, `tk_ty_binary`'s rule, so the address of a field of
// a `Point` answered `Point`, not the field's own `i64`). `tk_rfarg_pointee`
// (teko_ref.tk) is the POINTEE the argument was tagged with when `ref`/`out`
// parsed it, the one answer a call-argument check (`tk_rc_call_args`,
// teko_rc.tk) needs -- the same lookup `tk_ov_arg_ty` (teko_over.tk) already
// makes for the overload matcher. A bare local's pointee may still be -1 at
// this point (parsed before its own declaration read the scope this pass
// now has live), so the fallback is the same scope lookup by name.
i64 tk_ty_of(i64 n) {
    if (n == 0) return 0 - 1;
    if (tk_rfarg_kind(n) != TK_RP_NONE) {
        i64 pty = tk_rfarg_pointee(n);
        if (pty >= 0) return pty;
        if (nd_kind(n) == N_ADDR) return tk_ty_scope_find(nd_name(n));
        return 0 - 1;
    }
    i64 t = tk_xt_ty(n);
    if (t >= 0) return t;
    i64 k = nd_kind(n);
    if (k == N_IDENT) {
        i64 s = tk_ty_scope_find(nd_name(n));
        if (s >= 0) return s;
        return tk_ty_global_ha(nd_name(n));         // G1: a global `T[]` of heap
    }
    if (k == N_CALL) {
        i64 d = decl_find(nd_name(n));
        if (d < 0) return 0 - 1;
        return decl_ret(d);
    }
    if (k == N_INT) return nd_type(n);
    if (k == N_STR) return nd_type(n);
    if (k == N_CAST) return nd_type(n);
    if (k == N_BINARY) return tk_ty_binary(n);
    if (k == N_UNARY) {
        if (nd_op(n) == K_BANG) return TY_I64;
        return tk_ty_of(nd_a(n));
    }
    return 0 - 1;
}

// a receiver whose type IS known but names no row of teko_struct.tk's type
// table -- a scalar (`i64`, `uptr`, a field's own width, ...) -- declares no
// member at all, so a `.` on it is always wrong. Distinguishing this from
// "the type is not known" (where the member's own name gets to answer,
// tk_pend_by_name) is the whole point of the oracle knowing `tk_ty_of`.
void tk_reject_scalar_member(uptr fl, i64 line, i64 ty, uptr m) {
    err_at2(fl, line, tk_join3("teko: ", type_name(ty), " has no members"), m);
}

// ---- C# §10.2.3, the implicit numeric conversion ----

// the ids a slot of INTEGER type can have. Every integer word teko teaches
// down to `TY_I64` is an alias collapsing to one of the core's five raw ids
// (teko_type.tk). `TY_VOID` sits below the five and `TY_UPTR` above them, and
// neither is a number.
//
// The KIND cannot answer this question on its own: a class, an interface, a
// delegate and `ref`/`out`/`params` are all registered `TK_INT` too
// (teko_struct.tk's, teko_access.tk's and teko_ref.tk's own `type_new`,
// because the core carries a pointer-sized value the same way it carries an
// integer), and every core type -- `TY_VOID` and `TY_UPTR` included --
// answers `TK_INT` from `type_kind` as well (`hooks.md`, "every core type
// answers `TK_INT`"). `TK_SINT` is not the right question EITHER, and not
// merely an approximation of one: it is the kind `docs/specs/datetime.md`
// registers `TimeSpan`/`DateTime` with and every `enum` on `docs/specs/enum.md`
// is registered with, none of which is a number, so `type_kind(t) == TK_SINT`
// here would silently widen a `DateTime` into `f64` and accept a bare `i64`
// into a `Color` slot the moment either lands (D20: no silently wrong
// result). So this is a POSITIVE LIST, by ID, not by kind, and the rule that
// keeps it one: **a `type_new` id joins `tk_is_int_ty` only when the module
// that registered it says so by name, here.** `i32` is the core's own
// registration (`ty_i32`, `src/hooks.mc` -- `core_types_init()` runs before
// any module's `user_init()`, so it is always the FIRST registration,
// `hooks.md` § "the id a registration returns"); `i8`/`i16` are this
// project's own (`tk_ty_i8`/`tk_ty_i16`, teko_type.tk,
// `docs/specs/small-ints.md` § 2). `decimal`, `DateTime`, `TimeSpan`, `Guid`,
// every `enum`, `ref`, `out`, `params` and every class/struct/interface/
// delegate teko registers stay outside it by construction, with nothing to
// list for them.
i64 tk_is_int_ty(i64 t) {
    return (t >= TY_U8 && t <= TY_I64)
        || t == ty_i32
        || t == tk_ty_i8 || t == tk_ty_i16;
}

// the half of the compatibility check that needs no row of the type table.
// `tk_check_compat` below opens with it, and so does the field store, which
// reads its value's type by another route (teko_struct.tk's
// `tk_check_field_store`) and would otherwise be the one slot of the language
// where a float lands on an integer in silence.
//
// Three values do not convert, in either direction of C#'s rule. A FLOAT in a
// slot of any other type is a narrowing, and C# has none without a cast
// written down. `null` is a REFERENCE (D32) and a number is not a reference:
// it lands on a row of the type table or on a raw `uptr`, and on no integer
// and no float. A plain `uptr` value is left alone -- the core converts it to
// an integer of its own accord, and only the LITERAL is judged here.
//
// D34: neither is a NON-null reference. A struct, a class, an interface, a
// delegate and a `T[]` of heap are all a row of the type table
// (`tk_struct_by_ty(ety) >= 0`), the same identity `tk_check_compat` below
// asks for a row target -- but that function returns at once when the
// TARGET is not a row (`ti < 0`), which is exactly a numeric slot, so a
// reference reaching a numeric slot was never asked about at all: the core
// takes whatever bit pattern the pointer carries and reads it as the
// number. C# has no such conversion in either direction, so the value's
// type is what is judged here, never the slot's -- a `ref`/`out`/`params`
// slot (teko_ref.tk's, teko_access.tk's own `type_new`) is a POINTER-width
// id outside `tk_is_int_ty`'s range, so the slot itself never matches.
void tk_check_scalar_compat(i64 tty, i64 ety, i64 en, i64 line, uptr fl) {
    if (tty < 0) return;
    i64 ti = tk_struct_by_ty(tty);
    i64 tenum = tk_is_enum(ti);
    if (tk_is_null_lit(en)) {
        if (tk_is_int_ty(tty) || type_kind(tty) == TK_FLOAT || tenum || tk_prim_is(tty))
            tk_reject_compat(type_name(TY_UPTR), type_name(tty), line, fl);
        // Q1a (docs/specs/nullable.md, rule 1): `null` lands ONLY in a slot
        // declared `T?`. A raw `uptr` still takes it -- `0` is an ordinary
        // value of a raw pointer -- and a COMPARISON never reaches this check
        // at all, which is what keeps `c == null` legal on any reference.
        if (ti >= 0 && !tk_is_nl(ti) && !tk_nl_own_null_is(en))
            err_at(fl, line, tk_join3("teko: null needs a slot declared ", sr_name_at(ti), "?"));
        return;
    }
    if (ety < 0) return;
    // Q1b (docs/specs/nullable.md § 4): a slot declared `T?` over a VALUE
    // takes what `T` itself takes -- `i64? n = 5;`, `f64? x = 5;`,
    // `Color? c = Color.Red;` -- and refuses everything else under the
    // NULLABLE's own name, which is the slot the source actually wrote. The
    // reference arm owns no clause here: its handle IS the pointer, so the row
    // check does answer it.
    if (tk_is_nl(ti) && tk_nl_boxes(nl_of_at(ti))) {
        tk_nl_check_value(tty, ti, ety, en, line, fl);
        return;
    }
    if (type_kind(ety) == TK_FLOAT && type_kind(tty) != TK_FLOAT)
        tk_reject_compat(type_name(ety), type_name(tty), line, fl);
    if (tk_is_int_ty(tty) || type_kind(tty) == TK_FLOAT) {
        i64 ei = tk_struct_by_ty(ety);
        if (ei >= 0) tk_reject_compat(sr_name_at(ei), type_name(tty), line, fl);
    }
    // docs/specs/enum.md § 5: an enum slot converts from nothing but itself --
    // not a bare integer, not the literal `0` (an ordinary TY_I64 N_INT, so no
    // separate case is needed for it), not another enum. Neither a reference
    // (D32/D34's own clause above does not reach it: `tenum` is not a numeric
    // `tty`) nor a number (`tk_is_int_ty` excludes it, by name, D38's rule) --
    // this is the one clause `docs/specs/datetime.md` § 5 shares with it.
    if (tenum && tty != ety) {
        uptr ename = type_name(ety);
        i64 ei = tk_struct_by_ty(ety);
        if (ei >= 0) ename = sr_name_at(ei);
        tk_reject_compat(ename, sr_name_at(ti), line, fl);
    }
    // docs/specs/datetime.md § 5, the same clause one type table lower: a
    // PRIMITIVE with members (`TimeSpan`, and `DateTime`/`decimal`/`Guid`
    // after it -- teko_prim.tk) converts to nothing but itself either. It is
    // a `type_new` id outside `tk_is_int_ty` (D38's own rule) and outside the
    // struct table, so neither the enum clause above nor D34's row clause
    // reaches it: `i64 n = span;`, `f64 x = span;`, `TimeSpan t = 5;` and a
    // second primitive in the slot are all refused with the wording every
    // mismatched value already gets.
    if (tk_prim_is(tty) || tk_prim_is(ety)) {
        if (tty == ety) return;
        uptr ename = type_name(ety);
        i64 ei = tk_struct_by_ty(ety);
        if (ei >= 0) ename = sr_name_at(ei);
        uptr tname = type_name(tty);
        if (ti >= 0) tname = sr_name_at(ti);
        tk_reject_compat(ename, tname, line, fl);
    }
}

// the OTHER direction, the one that converts: an integer in a slot of float
// type becomes that float, C# §10.2.3's implicit numeric conversion. The core
// has none -- `walk_narrow` (mc/src/gen_walk.mc) answers 0 for `TK_FLOAT`, so
// the eight bytes of the integer would reach the slot unchanged and be read as
// a mantissa -- and the one surface form that lowers to `scvtf` is the cast
// (`tk_cast`, teko_array.tk, and `<float>`'s own `fa_cast`), so the conversion
// IS a cast, written by the compiler where the source did not have to.
//
// The node is handed BACK rather than rewritten in place: an argument is a
// link of a sibling list and an operand is a child, so the caller is the one
// that knows how to put it back. `ety` is the type the caller already had to
// ask for -- the pass-time oracle answers a different question from the
// parse-time one -- and nothing outside `tk_is_int_ty` converts, so `null`, a
// class, a `T[]` and an `f32` in an `f64` slot all travel untouched.
//
// The wrapped node stops being a SIBLING the moment it becomes a child, so its
// own `nd_next` is cut here: a caller splicing into an argument list has read
// the link it needs before calling, and one that leaves it in place would give
// the walk two ways to reach the rest of the list.
i64 tk_num_widen(i64 tty, i64 ety, i64 e) {
    if (e == 0) return e;
    if (tty < 0) return e;
    if (type_kind(tty) != TK_FLOAT) return e;
    if (!tk_is_int_ty(ety)) return e;
    tk_line = nd_line(e);
    tk_file = nd_file(e);
    set_nd_next(e, 0);
    return tk_cast(tty, e);
}

// D226 compat crumb (assignment/initializer/argument/return): `tty`/`ety` as
// the ORACLE answers them -- `ety < 0` is "not known", never a rejection, so
// the check only ever recuses what it is SURE about. `en` is the value's own
// node, read once for the one shape `null` takes (teko_struct.tk's
// tk_is_null_lit); `tk_row_fits` (same file) is the identical/derives/
// implements rule itself.
//
// The two SCALAR verdicts come first, above: a float in a slot of another kind
// and `null` in a numeric one, neither of which needs a row to be answered.
// They are what tell an argument no overload search takes part in (a name
// declared once) the same thing an overloaded one is told (teko_over.tk's
// `tk_ov_float_refuse`), and they reach a `return`, an initializer and an
// assignment through the same three call sites. What is left here is the row
// question, and `null` is silent on it: a reference fits any row.
void tk_check_compat(i64 tty, i64 ety, i64 en, i64 line, uptr fl) {
    tk_check_scalar_compat(tty, ety, en, line, fl);
    i64 ti = tk_struct_by_ty(tty);
    if (ti < 0) return;
    if (tk_is_null_lit(en)) return;
    // Q1b: a boxed `T?` slot was judged in full above, by TYPE -- the row
    // question below would ask about `i64`, which names no row, and would
    // refuse the very value the slot takes.
    if (tk_is_nl(ti) && tk_nl_boxes(nl_of_at(ti))) return;
    if (ety < 0) return;
    if (tty == ety) return;
    i64 ei = tk_struct_by_ty(ety);
    if (tk_row_fits(ti, ei)) return;
    uptr ename = type_name(ety);
    if (ei >= 0) ename = sr_name_at(ei);
    tk_reject_compat(ename, sr_name_at(ti), line, fl);
}

// the value a field store actually writes, at the two PARSE-TIME sites that
// build one -- `p.f = e` (teko_expr.tk's `tk_field_use`) and `p.items[i] = e`
// (teko_struct.tk's `tk_array_index`). The row check those two already had
// (`tk_check_field_store`) reads the value through `tk_struct_of_expr`, which
// answers about objects only, so the two scalar verdicts are asked here
// instead and the widened node is what the store is built over. A field is a
// slot like any other: `f64 w; p.w = 4;` writes four point zero, and
// `i64 n; p.n = 2.5;` does not compile.
i64 tk_field_store_val(i64 fty, i64 v, i64 line, uptr fl) {
    i64 vty = tk_pty_of(v);
    tk_check_scalar_compat(fty, vty, v, line, fl);
    tk_check_field_store(fty, v, line, fl);
    // Q1b: `h.count = 5;` on an `i64? count` field writes the box right here,
    // the same way the widening beside it writes the float conversion.
    return tk_nl_wrap(fty, vty, tk_num_widen(fty, vty, v));
}

// ---- the walk a pass drives ----
// `visit` is called on every node of every function body, in the order the
// source wrote it and under the scope that holds AT that node: a block pushes a
// mark and pops it, and a local joins the scope only after the statement that
// declares it has been walked, so its own initializer still reads the outer
// name. A visitor may rewrite the node it is given in place; the walk reads its
// children afterwards, so what a rewrite produces is walked as well.
void tk_ty_walk_list(i64 n, uptr visit) {
    loop {
        if (n == 0) break;
        callp(visit, n);
        if (nd_kind(n) == N_BLOCK) {
            i64 mark = tk_nscope;
            tk_ty_walk_list(nd_a(n), visit);
            tk_nscope = mark;
        } else {
            tk_ty_walk_list(nd_a(n), visit);
            tk_ty_walk_list(nd_b(n), visit);
            tk_ty_walk_list(nd_c(n), visit);
            tk_ty_walk_list(nd_d(n), visit);
            tk_ty_scope_var(n);
        }
        n = nd_next(n);
    }
}

void tk_ty_pass_walk(i64 root, uptr visit) {
    i64 f = root;
    loop {
        if (f == 0) break;
        if (nd_kind(f) == N_FUNC) {
            tk_nscope = 0;
            tk_cur_fn_name = nd_name(f);         // K4c: this function's own taint bucket
            tk_this_enter_fn(nd_name(f));        // the type an unqualified name belongs to
            tk_pass_proj = tk_origin_of_file(nd_file(f));   // ...and where its code came from
            tk_ty_scope_params(nd_a(f));
            tk_ty_walk_list(nd_b(f), visit);
        }
        f = nd_next(f);
    }
    tk_nscope = 0;
    tk_pass_proj = 0 - 1;
    tk_cur_fn_name = 0;
    tk_this_leave_fn();
}

// ---- the deferred member access ----
i64 tk_pend_at(i64 n) {
    i64 i = tk_npend - 1;
    loop {
        if (i < 0) break;
        if (pd_node_at(i) == n) return i;
        i = i - 1;
    }
    return 0 - 1;
}

void tk_pend_add(i64 n, i64 recv, uptr m, i64 arg, i64 na, i64 form, i64 line, uptr fl) {
    if (tk_npend == TK_MAXPEND) err_at(fl, line, "teko: too many member accesses on a value of unknown type");
    set_pd_node_at(tk_npend, n);
    set_pd_recv_at(tk_npend, recv);
    set_pd_name_at(tk_npend, m);
    set_pd_arg_at(tk_npend, arg);
    set_pd_na_at(tk_npend, na);
    set_pd_form_at(tk_npend, form);
    set_pd_line_at(tk_npend, line);
    set_pd_file_at(tk_npend, fl);
    set_pd_done_at(tk_npend, 0);
    tk_npend = tk_npend + 1;
}

// `left . m` with the rest of the access still unread: what follows decides the
// FORM (a call, a store, a load) without knowing the type, which is the half of
// the work that has to happen while the parser is here. The placeholder node
// keeps the expression's place in its parent until the pass fills it.
//
// It is a call to a symbol NOTHING declares, and deliberately so. A literal
// would COMPILE: a `.` this pass never got to rewrite -- because the pass was
// not registered, or because one that runs later put the node there -- would be
// a silent `0` in the middle of an expression, and the program would run and
// answer wrong (measured, with the pass unregistered: types_class.tk built and
// exited 12 instead of 42). A name nothing declares cannot end that way: the
// core's own resolver refuses the call where it is written (`call to unknown
// function`, mc/src/gen_resolve.mc res_call), and a declared-but-undefined one
// would stop at the link. It costs nothing when the rewrite does happen -- the
// node is overwritten in place, so the name never reaches codegen.
// `h.items[0]` / `h.items[0] = e` on a receiver only the pass could type: the
// index is read here, at parse time, exactly as the STATIC path
// (`tk_array_index`, teko_struct.tk) reads it -- `na` carries it through to
// the pass (idle for every other form), since `pd_na` otherwise only ever
// holds a call's own argument count
i64 tk_defer_member(i64 left, uptr m, i64 line, uptr fl) {
    i64 form = TK_PLOAD;
    i64 arg = 0;
    i64 na = 0;
    if (p_id() == K_LPAR) {
        form = TK_PCALL;
        arg = tk_args(&na);
    } else if (p_accept(K_LBRACK)) {
        na = parse_expr(0);
        p_expect(K_RBRACK, "expected ] after the index");
        form = TK_PIXLOAD;
        if (p_accept(K_ASSIGN)) {
            form = TK_PIXSTORE;
            arg = parse_expr(0);
        }
    } else if (p_accept(K_ASSIGN)) {
        form = TK_PSTORE;
        arg = parse_expr(0);
    }
    tk_line = line;
    tk_file = fl;
    i64 n = tk_call("tk_unresolved_member", 0);
    tk_pend_add(n, left, m, arg, na, form, line, fl);
    return n;
}

// ---- rebuilding the access, once the receiver's type is known ----
// The three below emit exactly what teko_expr.tk emits for a receiver it could
// type: the load or store of the field's own width, a direct call to the
// mangled Owner_method, the vtable call for a virtual one, and the itab call
// for an interface. `pty` reports the result's own TYPE -- a scalar one as much
// as a struct one, so `a.b.c` chains through a deferred link and `f(p.side)`
// has an argument type to be resolved by. `ppure` and `pown` are the two
// answers the registration needs and they are separate questions: a load is
// pure AND borrowed, a call is neither.
i64 tk_pend_field(i64 pi, i64 fi, uptr pty, uptr ppure, uptr pown) {
    uptr m = pd_name_at(pi);
    i64 form = pd_form_at(pi);
    i64 fty = fd_ty_at(fi);
    i64 nel = fd_nel_at(fi);
    i64 addr = tk_bin(K_ADD, pd_recv_at(pi), tk_int(fd_off_at(fi)));
    if (form == TK_PCALL)
        err_at2(tk_file, tk_line, "teko: the member is a field, not a method", m);
    if ((form == TK_PIXLOAD || form == TK_PIXSTORE) && nel == 0)
        err_at2(tk_file, tk_line, "teko: the field is not an array", m);
    if (form == TK_PLOAD && nel > 0)
        err_at2(tk_file, tk_line, "teko: an array field is read one element at a time", m);
    if (form == TK_PSTORE && nel > 0)
        err_at2(tk_file, tk_line, "teko: an array field is assigned one element at a time", m);
    if (form == TK_PIXLOAD || form == TK_PIXSTORE) {
        i64 k = tk_ax_index(pd_na_at(pi), nel, m, tk_line, tk_file);
        addr = tk_bin(K_ADD, addr, tk_bin(K_MUL, k, tk_int(type_width(fty))));
    }
    if (form == TK_PSTORE || form == TK_PIXSTORE) {
        i64 val = pd_arg_at(pi);
        i64 vp = tk_pend_at(val);
        if (vp >= 0) tk_pend_do(vp);
        i64 vty = tk_ty_of(val);
        tk_check_compat(fty, vty, val, tk_line, tk_file);
        val = tk_num_widen(fty, vty, val);
        tk_line = pd_line_at(pi);
        tk_file = pd_file_at(pi);
        return tk_os_mark(tk_call2(tk_stn(fty), addr, val), fty);
    }
    st64(pty, fty);
    st64(ppure, 1);
    st64(pown, TK_BORROWED);
    return tk_ld(fty, addr);
}

// the call itself, once the declaration is known: the declaration's own symbol
// carries the overload suffix, the arguments the site left out come from that
// declaration's defaults, and a virtual one goes through the object's vtable --
// the shapes teko_expr.tk's tk_emit_call produces for a receiver it could type
i64 tk_pend_emit_call(i64 pi, i64 mi, i64 args, i64 na, uptr pty, uptr ppure, uptr pown) {
    uptr m = pd_name_at(pi);
    args = tk_fill_defaults(args, na, mt_np_at(mi), mt_nreq_at(mi), mt_d0_at(mi));
    st64(pty, mt_ret_at(mi));
    st64(ppure, 0);
    st64(pown, TK_OWNED);
    i64 left = pd_recv_at(pi);
    i64 slot = mt_slot_at(mi);
    if (slot < 0) return tk_call(mt_fn_at(mi), list_append(left, args));
    if (!tk_pure(left))
        err_at2(tk_file, tk_line, "teko: a virtual call needs a name or a field on the left", m);
    i64 vt = tk_call("ld64", tk_clone(left));
    i64 fnp = tk_call("ld64", tk_bin(K_ADD, vt, tk_int((TK_VT_FIXED + slot) * 8)));
    return tk_callp_ret(mt_ret_at(mi),
                        tk_call("callp", list_append(list_append(fnp, left), args)));
}

i64 tk_pend_emit_method(i64 pi, i64 mi, uptr pty, uptr ppure, uptr pown) {
    return tk_pend_emit_call(pi, mi, pd_arg_at(pi), pd_na_at(pi), pty, ppure, pown);
}

// `p.X` / `p.X = e` on a receiver only the oracle could type: the accessor the
// property resolves to, and the very call teko_expr.tk's tk_prop_use emits
i64 tk_pend_prop(i64 pi, i64 si, uptr pty, uptr ppure, uptr pown) {
    uptr m = pd_name_at(pi);
    if (pd_form_at(pi) == TK_PCALL)
        err_at2(tk_file, tk_line, "teko: the member is a property; it is not called", m);
    i64 wantset = 0;
    i64 args = 0;
    i64 na = 0;
    if (pd_form_at(pi) == TK_PSTORE) {
        wantset = 1;
        args = pd_arg_at(pi);
        na = 1;
    }
    i64 mi = tk_prop_accessor_of(si, m, wantset, tk_line, tk_file);
    if (mt_static_at(mi)) tk_reject_static_member(si, m, tk_line, tk_file);
    return tk_pend_emit_call(pi, mi, args, na, pty, ppure, pown);
}

// The arguments the site wrote decide WHICH signature of the name is called,
// exactly as they do at parse time (teko_expr.tk's tk_call_method): the pick
// answers the declaration, inside the receiver's own type and its bases.
i64 tk_pend_method(i64 pi, i64 si, uptr pty, uptr ppure, uptr pown) {
    uptr m = pd_name_at(pi);
    if (pd_form_at(pi) != TK_PCALL)
        err_at2(tk_file, tk_line, "teko: the member is a method; call it with ()", m);
    i64 mi = tk_method_pick(si, m, pd_na_at(pi));
    if (mi < 0) tk_pick_refuse(mi, m, tk_line, tk_file);
    tk_check_member(mt_cls_at(mi), mt_vis_at(mi), m, tk_line, tk_file);
    if (mt_static_at(mi)) tk_reject_static_member(si, m, tk_line, tk_file);
    return tk_pend_emit_method(pi, mi, pty, ppure, pown);
}

// `s.X` / `s.X = e` on an interface-typed receiver the oracle answered for;
// `si` is already the interface that DECLARES `X` (the caller resolved the
// closure -- item 2 of this crumb)
i64 tk_pend_iface_prop(i64 pi, i64 si, uptr pty, uptr ppure, uptr pown) {
    uptr m = pd_name_at(pi);
    if (pd_form_at(pi) == TK_PCALL)
        err_at2(tk_file, tk_line, "teko: the member is a property; it is not called", m);
    i64 wantset = 0;
    i64 args = 0;
    if (pd_form_at(pi) == TK_PSTORE) {
        wantset = 1;
        args = pd_arg_at(pi);
    }
    i64 j = tk_ifprop_pick(si, m, wantset, tk_line, tk_file);
    st64(pty, im_ret_at(sr_m0_at(si) + j));
    st64(ppure, 0);
    st64(pown, TK_OWNED);
    return tk_itab_emit(pd_recv_at(pi), si, j, args, m, tk_line, tk_file);
}

// `m` may belong to `si` itself or to an interface it extends (§50 I1, and
// item 2 of this crumb for a property) -- the same deep lookup
// `tk_iface_call`/`tk_iface_member_of` (teko_expr.tk) make, dispatch through
// whichever interface actually declares it.
i64 tk_pend_iface(i64 pi, i64 si, uptr pty, uptr ppure, uptr pown) {
    uptr m = pd_name_at(pi);
    tk_check_type_use(si, tk_line, tk_file);     // an interface's members are public
    uptr propdecl = xalloc(8);
    if (tk_ifprop_find_deep(si, m, propdecl)) return tk_pend_iface_prop(pi, ld64(propdecl), pty, ppure, pown);
    uptr pdecl = xalloc(8);
    if (tk_ifmeth_find_deep(si, m, pdecl) < 0)
        err_at2(tk_file, tk_line, tk_join("teko: unknown member of ", sr_name_at(si)), m);
    i64 di = ld64(pdecl);
    if (pd_form_at(pi) != TK_PCALL)
        err_at2(tk_file, tk_line, "teko: the member is a method; call it with ()", m);
    i64 na = pd_na_at(pi);
    i64 j = tk_ifmeth_pick(di, m, na);
    if (j < 0) tk_pick_refuse(j, m, tk_line, tk_file);
    i64 k = sr_m0_at(di) + j;
    i64 args = tk_fill_defaults(pd_arg_at(pi), na, im_np_at(k), im_nreq_at(k), im_d0_at(k));
    st64(pty, im_ret_at(k));
    st64(ppure, 0);
    st64(pown, TK_OWNED);
    return tk_itab_emit(pd_recv_at(pi), di, j, args, m, tk_line, tk_file);
}

// `g.Length` on a global `T[]` of heap (G1): the receiver only the oracle
// could type (a global is never a LOCAL, so `tk_struct_of_expr` never sees
// it at parse time), the one member teko_heaparr.tk's own parse-time
// `tk_ha_member_of` answers for every OTHER receiver shape.
i64 tk_pend_ha_length(i64 pi, uptr m, uptr pty, uptr ppure, uptr pown) {
    if (!str_eq(m, "Length")) err_at2(tk_file, tk_line, "teko: an array has no member", m);
    i64 form = pd_form_at(pi);
    if (form == TK_PCALL) err_at2(tk_file, tk_line, "teko: the member is a field, not a method", m);
    if (form == TK_PSTORE) err_at2(tk_file, tk_line, "teko: is read-only", m);
    st64(pty, TY_I64);
    st64(ppure, 1);
    st64(pown, TK_BORROWED);
    return tk_call("ld64", tk_bin(K_ADD, pd_recv_at(pi), tk_int(16)));
}

i64 tk_pend_emit(i64 pi, i64 si, uptr pty, uptr ppure, uptr pown) {
    uptr m = pd_name_at(pi);
    if (tk_is_iface(si)) return tk_pend_iface(pi, si, pty, ppure, pown);
    if (tk_is_ha(si)) return tk_pend_ha_length(pi, m, pty, ppure, pown);
    if (tk_is_nl(si)) return tk_nl_pend(pi, si, pty, ppure, pown);      // Q1a
    i64 fi = tk_field_find(si, m);
    if (fi >= 0) {
        tk_check_member(tk_field_owner(fi), fd_vis_at(fi), m, tk_line, tk_file);
        if (fd_sym_at(fi)) tk_reject_static_member(si, m, tk_line, tk_file);
        return tk_pend_field(pi, fi, pty, ppure, pown);
    }
    if (tk_prop_find(si, m) >= 0) return tk_pend_prop(pi, si, pty, ppure, pown);
    if (tk_method_named_find(si, m) >= 0) return tk_pend_method(pi, si, pty, ppure, pown);
    err_at2(tk_file, tk_line, tk_join("teko: unknown member of ", sr_name_at(si)), m);
    return 0;
}

// the LAST resort, and only after the oracle has said it does not know the
// receiver's type: a global, or an expression whose type nothing reports. The
// member's name then has to belong to exactly one type. An interface answers
// ahead of a class, because its dispatch is the one that stays correct for every
// conforming class -- the itab is walked at run time, so no vtable slot is
// guessed.
i64 tk_pend_by_name(i64 pi, uptr pty, uptr ppure, uptr pown) {
    uptr m = pd_name_at(pi);
    i64 fi = tk_field_by_name(m);
    if (fi == 0 - 2)
        err_at2(tk_file, tk_line, "teko: the type of the left side of `.` is not known here", m);
    if (fi >= 0) {
        i64 owner = tk_field_owner(fi);
        tk_check_member(owner, fd_vis_at(fi), m, tk_line, tk_file);
        if (fd_sym_at(fi)) tk_reject_static_member(owner, m, tk_line, tk_file);
        return tk_pend_field(pi, fi, pty, ppure, pown);
    }
    i64 pj = tk_prop_by_name(m);
    if (pj == 0 - 2)
        err_at2(tk_file, tk_line, "teko: the type of the left side of `.` is not known here", m);
    if (pj >= 0) {
        i64 owner = pr_cls_at(pj);
        if (tk_is_iface(owner)) return tk_pend_iface_prop(pi, owner, pty, ppure, pown);
        return tk_pend_prop(pi, owner, pty, ppure, pown);
    }
    i64 si = tk_ifmeth_by_name(m);
    if (si == 0 - 2)
        err_at2(tk_file, tk_line, "teko: the type of the left side of `.` is not known here", m);
    if (si >= 0) return tk_pend_iface(pi, si, pty, ppure, pown);
    if (!tk_method_has_name(m)) err_at2(tk_file, tk_line, "teko: unknown member", m);
    if (pd_form_at(pi) != TK_PCALL)
        err_at2(tk_file, tk_line, "teko: the member is a method; call it with ()", m);
    i64 mi = tk_method_by_name(m, pd_na_at(pi));
    if (mi < 0) tk_loose_refuse(mi, m, tk_line, tk_file);
    tk_check_member(mt_cls_at(mi), mt_vis_at(mi), m, tk_line, tk_file);
    if (mt_static_at(mi)) tk_reject_static_member(mt_cls_at(mi), m, tk_line, tk_file);
    return tk_pend_emit_method(pi, mi, pty, ppure, pown);
}

// The rewrite is IN PLACE, so the node index stays what the parent points at
// and the sibling list is put back untouched -- `mc` docs/reference/hooks.md
// § pass(). A receiver that is itself deferred is resolved first, which is what
// makes `p.inner.x` on a parameter work: the inner link registers its own type
// on the very node the outer one reads.
void tk_pend_do(i64 pi) {
    if (pd_done_at(pi)) return;
    set_pd_done_at(pi, 1);
    i64 recv = pd_recv_at(pi);
    i64 rp = tk_pend_at(recv);
    if (rp >= 0) tk_pend_do(rp);
    tk_this_fix(recv);                           // `inner.x`: the receiver is a field of `this`
    // `cs[i].area()` on a GLOBAL `T[]` (G1): `cs[i]` never enters the tree
    // teko_array.tk's own pass walks -- the `.` deferred it as a RECEIVER,
    // an orphan reachable only through `pd_recv`, same as an inner `.` in a
    // chain -- so it is resolved here, on the very same chase, before its
    // type is asked for.
    if (nd_kind(recv) == N_INDEX) tk_array_maybe_rewrite_index(recv);
    tk_line = pd_line_at(pi);
    tk_file = pd_file_at(pi);
    i64 recv_ty = tk_ty_of(recv);
    i64 si = 0 - 1;
    if (recv_ty >= 0) si = tk_struct_by_ty(recv_ty);
    i64 rty = 0 - 1;
    i64 pure = 0;
    i64 own = TK_OWNED;
    i64 r = 0;
    if (si >= 0)                        r = tk_pend_emit(pi, si, &rty, &pure, &own);
    // docs/specs/datetime.md § 2: a receiver of PRIMITIVE type, which is
    // exactly the case `tk_reject_scalar_member` answered for before the
    // member table existed (the P0 probe measured it:
    // `teko: TimeSpan has no members: Ticks`)
    else if (tk_prim_is(recv_ty)) r = tk_prim_pend(pi, recv_ty, &rty, &pure, &own);
    else if (recv_ty >= 0)  tk_reject_scalar_member(tk_file, tk_line, recv_ty, pd_name_at(pi));
    else                    r = tk_pend_by_name(pi, &rty, &pure, &own);
    i64 n = pd_node_at(pi);
    i64 keep = nd_next(n);
    node_assign(n, r);
    set_nd_next(n, keep);
    // a cast the lowering wrote keeps being the COMPILER's after the
    // replacement, under the placeholder's own index (docs/specs/datetime.md
    // § 3, teko_prim.tk's `tk_prim_own_cast_moved`)
    tk_prim_own_cast_moved(r, n);
    // the node that ends up in the TREE is the placeholder, not what was built
    // for it, so a store into a slot of counted type is re-marked under the
    // identity the reclaim pass will walk (teko_rc.tk)
    if (tk_os_has(r)) tk_os_add(n);
    if (rty >= 0) tk_xt_put(n, tk_struct_by_ty(rty), rty, pure, own);
}

// One walk, two rewrites: the deferred `.` this file owns, and the unqualified
// member teko_this.tk owns. They share the walk because they share what it
// carries -- the scope that says whether a name is a local, and the position in
// the tree where a node may be replaced by what it stood for.
void tk_pend_visit(i64 n) {
    i64 pi = tk_pend_at(n);
    if (pi >= 0) {
        tk_pend_do(pi);
        return;
    }
    tk_this_fix(n);
}

// a deferred access the walk never reached -- a `.` outside any function body --
// is reported with the position it was written at, not left in the tree
void tk_pend_check() {
    i64 i = 0;
    loop {
        if (i >= tk_npend) break;
        if (!pd_done_at(i))
            err_at2(pd_file_at(i), pd_line_at(i),
                    "teko: the type of the left side of `.` is not known here", pd_name_at(i));
        i = i + 1;
    }
}

// ---- Q3 (D46): definite assignment ----
//
// One bit per LOCAL, over the tree this pass has just finished resolving:
// `docs/specs/nullable.md` § 8's rule at its minimum useful strength -- a local
// declared WITHOUT `?` and WITHOUT an initializer, read before any assignment to
// it appears anywhere earlier in source order, is refused where it is read.
//
// It is deliberately an OVER-APPROXIMATION of "assigned", so it can never
// refuse a correct program: an `x = e` inside an `if`, a `loop` or a nested
// block counts from the moment the walk passes it, with no dominator tree and
// no question about whether that branch runs. What it catches is the whole
// class D42 named -- a `struct`, a class or a scalar local declared and then
// read with nothing ever written to it, which until now reached the run as
// whatever the stack held.
//
// Why HERE and not a pass of its own: this file already owns the walk that
// visits every node of every body in source order, and the tree is at its
// closest to what the source wrote at exactly this point -- the deferred `.`
// above has just become the load/store/call it stood for (so `p.x = 4` is the
// `st64(p + off, 4)` whose `p` is the read this rule judges), and nothing
// below has run yet, so none of the reads `tk_rc_pass` INJECTS -- the
// `rc_dec(x)` of a block's own releases -- exists to be mistaken for one the
// source wrote. Zero pass registrations; `mc limits`' `passes` row does not
// move (Q0's probe 9, docs/internals/nullable-probes.md).
//
// The four shapes § 8 lists as assignments reduce to two node kinds by the time
// the walk sees them, which is why three of the four need no clause at all:
//
//   an initializer, and any later `x = e`   N_VAR with `nd_a`, and N_ASSIGN
//   `f(out x)` / `f(ref x)` / `use (&x)`    N_ADDR (`tk_ref_addr`, teko_ref.tk)
//   a `foreach` variable, a `for` initial   N_VAR with `nd_a`: both constructs
//                                           lower to a declaration that has one
//   `use (x)`, by value                     an ordinary N_IDENT, told apart by
//                                           the node teko_deleg.tk recorded for
//                                           it (`tk_capread_is`)
//
// The assignment is recorded AFTER the value is walked, so `i64 a; a = a + 1;`
// is refused on its own right-hand side, C#'s own answer for it.

#define TK_MAXDA 256                  // locals of one function the rule judges

uptr da_name[TK_MAXDA];               // the local, innermost last
i64  da_set[TK_MAXDA];                // 1 once an assignment to it has been walked
i64  tk_nda = 0;
i64  tk_da_off = 0;                   // 1 when the table overflowed: the rule steps aside

uptr da_name_at(i64 i) { return ld64(da_name + i * 8); }
i64  da_set_at(i64 i)  { return ld64(da_set + i * 8); }

void set_da_name_at(i64 i, uptr v) { st64(da_name + i * 8, v); }
void set_da_set_at(i64 i, i64 v)   { st64(da_set + i * 8, v); }

// A local the rule has anything to judge. Three declarations are born assigned:
// one with an initializer, a local ARRAY (`i64 a[4]` -- `nd_val` is the length,
// and the name IS the storage, exactly as `tk_ty_scope_var` reads it), and a
// `T?` (`T? x;` is `T? x = null;`, nullable.md § 19.2 -- the `?` is the licence
// to hold nothing). Everything else starts at 0 and has to earn its bit.
i64 tk_da_starts_set(i64 n) {
    if (nd_val(n) != 0) return 1;
    if (nd_a(n) != 0) return 1;
    return tk_is_nl(tk_struct_by_ty(nd_type(n)));
}

// A name is pushed for EVERY declaration, assigned or not: an inner `i64 a = 1;`
// has to shadow an outer `i64 a;` while its own block is open, or a read of the
// inner one would be judged against the outer one's bit.
void tk_da_add(uptr name, i64 set) {
    if (tk_nda == TK_MAXDA) { tk_da_off = 1; return; }
    set_da_name_at(tk_nda, name);
    set_da_set_at(tk_nda, set);
    tk_nda = tk_nda + 1;
}

i64 tk_da_find(uptr name) {
    i64 i = tk_nda - 1;
    loop {
        if (i < 0) break;
        if (str_eq(da_name_at(i), name)) return i;
        i = i - 1;
    }
    return 0 - 1;
}

// the newest entry of that name -- a global, a parameter and a name from an
// enclosing function are all "not found", and none of them is this rule's
// to judge: an assignment to one of those marks nothing.
void tk_da_assign(uptr name) {
    i64 i = tk_da_find(name);
    if (i >= 0) set_da_set_at(i, 1);
}

void tk_da_read(i64 n) {
    if (tk_da_off) return;
    i64 i = tk_da_find(nd_name(n));
    if (i < 0) return;
    if (da_set_at(i)) return;
    err_at(nd_file(n), nd_line(n),
           tk_join3("teko: ", nd_name(n), " is used before it is assigned"));
}

// The same shape `tk_ty_walk_list` has -- a mark per N_BLOCK, cut back on the
// way out -- with the three node kinds this rule reads differently: a
// declaration (the name joins the scope AFTER its own initializer), an
// assignment (the target is not a read of itself, and the value is walked
// first), and an address (the callee's own store, so the name counts assigned
// and is not read here). Every other kind is its children in order, which is
// what makes an `if` arm, a loop body and a ternary arm -- an N_CALL argument
// list by then (`tk_ternary`'s placeholder) -- all reachable with no clause.
void tk_da_walk(i64 n) {
    loop {
        if (n == 0) break;
        i64 k = nd_kind(n);
        if (k == N_BLOCK) {
            i64 mark = tk_nda;
            tk_da_walk(nd_a(n));
            tk_nda = mark;
        } else if (k == N_VAR) {
            tk_da_walk(nd_a(n));
            tk_da_add(nd_name(n), tk_da_starts_set(n));
        } else if (k == N_ASSIGN) {
            tk_da_walk(nd_a(n));
            tk_da_assign(nd_name(n));
        } else if (k == N_ADDR) {
            tk_da_assign(nd_name(n));
        } else if (k == N_IDENT) {
            if (tk_capread_is(n)) tk_da_assign(nd_name(n));
            else tk_da_read(n);
        } else {
            tk_da_walk(nd_a(n));
            tk_da_walk(nd_b(n));
            tk_da_walk(nd_c(n));
            tk_da_walk(nd_d(n));
        }
        n = nd_next(n);
    }
}

// A parameter is not judged (it arrives with a value) and neither is a field, a
// global or an element of `new T[n]` -- § 8's own "out of scope, and stated
// so". So the table starts EMPTY at every function: a name nothing declared in
// this body is simply not found, and not found is not refused.
void tk_da_check(i64 root) {
    i64 f = root;
    loop {
        if (f == 0) break;
        if (nd_kind(f) == N_FUNC) {
            tk_nda = 0;
            tk_da_off = 0;
            tk_da_walk(nd_b(f));
        }
        f = nd_next(f);
    }
    tk_nda = 0;
    tk_da_off = 0;
}

i64 tk_typeof_pass(i64 root) {
    if (tk_npend != 0 || tk_nmethod != 0) {
        tk_ty_pass_walk(root, &tk_pend_visit);
        tk_pend_check();
    }
    tk_da_check(root);                           // Q3: after the `.` above is resolved
    return root;
}
