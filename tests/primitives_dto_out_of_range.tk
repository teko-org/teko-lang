// primitives_dto_out_of_range.tk -- the LOCAL clock of a `DateTimeOffset` is a
// `DateTime` too: `MaxValue` (UTC, offset 0) moved to `+01:00` would read a
// year past 9999 through `.DateTime`, so `tk_dto_make` (lib/time.tk) refuses
// it where the value is built, as C# does at construction (Copilot on #729).
//
// expect-exit: 70

#include "../lib/rt.tk"
#include "../lib/time.tk"

i64 main() {
    DateTimeOffset top = DateTimeOffset.MaxValue;
    DateTimeOffset moved = top.ToOffset(TimeSpan.FromHours(1));
    return moved.Year;
}
