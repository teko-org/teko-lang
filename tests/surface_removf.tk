// surface_removf.tk -- D82 (the PR's fourth review): `MinValue % -1` panics
// exactly as `MinValue / -1` does, signed only. The remainder itself would
// be 0, but the machine computes it through the same quotient the register
// cannot hold: x86_64's `idiv` traps on the pair for `%` as for `/`, and
// .NET throws `OverflowException` for `int.MinValue % -1` on x64 and arm64
// alike (the C# specification ties the remainder's overflow to the
// quotient's) -- which is what this project gives everywhere too (D3).
//
// `teko: an integer division overflowed`, exit 70.
//
// expect-exit: 70

#include "../lib/rt.tk"

i64 min() { return (0 - 9223372036854775807) - 1; }

i64 remby(i64 a, i64 m) {
    return a % m;
}

i64 main() {
    i64 r = remby(min(), 0 - 1);
    // unreachable: the panic above exits 70
    if (r == 0) return 1;
    return 42;
}
