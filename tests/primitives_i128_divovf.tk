// primitives_i128_divovf.tk -- D82's amendment to D81's ruling 3:
// `i128.MinValue / -1i` panics rather than wraps. Measured before this crumb:
// `tests/primitives_i128_math.tk` never actually asserted the wrap (no row
// named it), so nothing there needed moving -- this fixture is the only
// assertion `MinValue / -1i` has ever had.
//
// `tk_w_sdiv_ovf` (`lib/wide.tk`) reads the two ORIGINAL 128-bit operands
// directly, ahead of the magnitude split every other divide takes: `MinValue`
// is the one value whose own negation is a no-op (`-MinValue == MinValue`,
// D81's own two's complement fixed point), and `-1i` is the one divisor whose
// magnitude is 1 -- the same pair `int.MinValue / -1` throws
// `OverflowException` on in C#, and the same pair x86_64's `idiv` traps on
// while aarch64's `sdiv` answers `MinValue` back in silence.
//
// `teko: an integer division overflowed`, exit 70 -- the divisor is behind a
// call the folder cannot see through, so this is measured at RUN time, not
// refused at compile time.
//
// expect-exit: 70

#include "rt.tk"
#include "wide.tk"

i128 negone() { return 0i - 1i; }

i64 main() {
    i128 mn = (0i - 170141183460469231731687303715884105727i) - 1i;
    i128 q = mn / negone();
    // unreachable: the panic above exits 70
    if (q == mn) return 1;
    return 42;
}
