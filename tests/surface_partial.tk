// surface_partial.tk -- `partial class` as C# writes it (D224, entrega 5): the
// same class declared in more than one place and united at compile time. There
// is no partial METHOD: `partial` on a member is refused by name.
//
// The first part opens the row; every part after it adds members to that row,
// and the type CLOSES at its first use -- `new Shape` here, which is what the
// constructor, the vtable and the conformance check are emitted for. A part
// written after that is refused where it stands, so either every part is read
// before the first use or the source is told that one was not.
//
// Three things this proves beyond the union itself:
//
//   1. the parts are in TWO FILES: the second one arrives through `#include`,
//      and `area()` up here reads `h`, which only that file declares -- an
//      unqualified name is resolved in the pass, where the whole unit exists;
//   2. `class Between` is declared BETWEEN the two parts, so the fields, the
//      vtable slots and the interfaces of `Shape` are not a contiguous run of
//      any table -- each row owns its own, whatever is declared in the middle;
//   3. a GENERIC is partial by the same rule (`Cell`), one recorded region per
//      part in the file that declared it, replayed as the very parts it was
//      written as.
//
// The base class and the interface are named in the first part: the interfaces
// are a union and may come in any part, but the base decides where the class's
// own fields start, so it is named before any member is laid out.
//
// expect-exit: 42

#include "../lib/rt.tk"

interface Named {
    i64 tag();
}

class Base {
    public i64 b;

    public virtual i64 f() {
        return b;
    }
}

partial class Shape : Base, Named {
    public i64 w;

    public i64 area() {
        return w * h;
    }
}

class Between {
    public i64 z;

    public virtual i64 g() {
        return z + 1;
    }
}

#include "parts/shape_part2.tk"

partial class Cell<T, const N: i64> {
    public T items[N];
}

partial class Cell<T, const N: i64> {
    public i64 cap() {
        return N;
    }
}

i64 main() {
    Shape s = new Shape;
    s.b = 1;
    s.w = 6;
    s.h = 7;

    if (s.area() != 42) return 1;                // `w` here, `h` in the other file
    if (s.Both != 13) return 2;                  // a property the other part declared

    Base o = s;
    if (o.f() != 14) return 3;                   // the override the other part wrote

    Named n = s;
    if (n.tag() != 7) return 4;                  // the interface the first part named

    Between t = new Between;
    t.z = 41;
    if (t.g() != 42) return 5;                   // declared between the two parts

    Cell<i64, 3> c = new Cell<i64, 3>;
    if (c.cap() != 3) return 6;                  // a partial generic, one part each

    return s.area();
}
