// primitives_scalar.tk -- char/byte/isize/usize (docs/design/port-teko-mc.md
// §3): each is a `type_alias` over a core type id, not a new representation
// -- `isize` IS `i64` and `usize` IS `u64` (DECISION_LOG D131: 64-bit today,
// so the coercion between an alias and its own base costs nothing, it is the
// identity, not a conversion), `byte` IS `u8`, `char` is the scalar `u32`
// the mc host uses. Mixing an alias with its own base needs no cast.
//
// expect-exit: 42

isize sum_isize(isize a, i64 b) {
    return a + b;
}

i64 main() {
    byte  b = 20;
    char  c = 12;
    usize u = (usize) b + (usize) c;
    isize n = sum_isize(10, 0);
    return (i64) u + (i64) n;
}
