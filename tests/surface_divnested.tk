// surface_divnested.tk -- D82 (the PR's fourth review): a guarded division
// whose DIVISOR is itself a guarded division evaluates left to right. The
// dividend is hoisted before the divisor is walked, so the inner division's
// own prelude (its zero check) lands after the outer dividend's call:
// `left() / (x() / y())` runs `left()`, then `x()`, then `y()`, each once,
// as C# does. Before this row the inner prelude was emitted first and
// `left()` ran last.
//
// expect-exit: 42

#include "../lib/rt.tk"

i64 order = 0;
i64 left()  { order = order * 10 + 1; return 40; }
i64 x()     { order = order * 10 + 2; return 8; }
i64 y()     { order = order * 10 + 3; return 3; }

i64 main() {
    order = 0;
    i64 q = left() / (x() / y());       // 40 / (8 / 3) == 40 / 2 == 20
    if (q != 20) return 10;
    if (order != 123) return 11;
    order = 0;
    i64 r = left() % (x() % y());       // 40 % (8 % 3) == 40 % 2 == 0
    if (r != 0) return 12;
    if (order != 123) return 13;
    return 42;
}
