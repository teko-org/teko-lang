// surface_string_index.tk -- N8 (docs/specs/string.md § 6, D89): `s[i]` on
// ASCII, 2-byte, 3-byte and 4-byte code points, `s[0]`, `s[Length - 1]` and a
// loop summing every code point.
// expect-exit: 42
#include "rt.tk"
#include "string.tk"

i64 main() {
    string a = new string("hello");            // ASCII, one byte per char
    if (a[0] != 'h') return 1;
    if (a[4] != 'o') return 2;
    if (a[a.Length - 1] != 'o') return 3;

    string b = new string("hπllo");            // one 2-byte code point (π)
    if (b.Length != 5) return 4;
    if (b[1] != 960) return 5;                  // U+03C0 GREEK SMALL LETTER PI
    if (b[4] != 'o') return 6;

    string c = new string("h中i");              // one 3-byte code point (U+4E2D)
    if (c.Length != 3) return 7;
    if (c[1] != 20013) return 8;
    if (c[2] != 'i') return 9;

    string d = new string("a😀b");              // one 4-byte code point (U+1F600)
    if (d.Length != 3) return 10;
    if (d[1] != 128512) return 11;
    if (d[2] != 'b') return 12;

    i64 sum = 0;
    i64 i = 0;
    loop {
        if (i >= a.Length) break;
        sum = sum + a[i];
        i = i + 1;
    }
    if (sum != 532) return 13;                  // 'h'+'e'+'l'+'l'+'o'

    return 42;
}
