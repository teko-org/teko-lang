// primitives_i128_decovf.tk -- N6b-2 of docs/specs/small-ints.md (§ 8; D84):
// `(decimal) x` panics when the `i128` magnitude is at or past `2^96` --
// `decimal.MaxValue` is `2^96 - 1`, and `1i << 96i` is one past it. The
// value is behind a call the folder cannot see through, so this is measured
// at RUN time and never refused at compile time, exactly `primitives_i128_
// divovf.tk`'s own shape for the SAME reason: `2^96` is not a literal a
// program writes by hand into a `decimal`-bound expression the folder could
// catch earlier.
//
// `teko: decimal overflow`, exit 70 -- `tk_dv_over96` (`lib/limbs.tk`) reads
// limb 3 of the magnitude, which the shift below sets for the first time.
//
// expect-exit: 70

#include "rt.tk"
#include "wide.tk"
#include "decimal.tk"

i128 past96() { return 1i << 96i; }

i64 main() {
    i128 x = past96();
    decimal d = (decimal) x;
    // unreachable: the panic above exits 70
    if (d == 0m) return 1;
    return 42;
}
