// primitives_decimal_overflow.tk -- docs/specs/decimal.md § 5 and § 11: the
// overflow is LOUD. A result that needs more than 96 bits of mantissa at a
// scale that cannot be reduced any further is `panic("decimal overflow")`,
// which is `rt_panic` -- `teko: decimal overflow` on stderr and exit 70, the
// same road an array guard already takes (docs/reference/memory.md).
//
// 79228162514264337593543950335m is 2^96 - 1, the whole mantissa at scale
// zero; one more is a value `decimal` does not hold, and there is no scale to
// spend. C# raises OverflowException here; teko has no exceptions, so it
// panics (D77).
//
// expect-exit: 70

#include "rt.tk"
#include "decimal.tk"

i64 main() {
    decimal big = 79228162514264337593543950335m;
    decimal over = big + 1m;
    if (over == big) return 1;
    return 0;
}
