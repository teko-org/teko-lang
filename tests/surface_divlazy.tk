// surface_divlazy.tk -- D82 amended (the PR's F1): the guard around a
// division behind `&&`/`||` rides the SAME branch the division does, so it
// is silent while the short-circuit keeps the division out of reach
// (`tests/surface_divguard.tk`'s own rows) and fires the moment the left
// side lets it through -- this file.
//
// `a > 0` is TRUE, so `a / n` with `n == 0` is genuinely evaluated and
// `teko: division by zero`, exit 70, is the answer -- exactly what the same
// division written outside an `&&` already gives
// (`tests/surface_divzero.tk`).
//
// expect-exit: 70

#include "../lib/rt.tk"

i64 main() {
    i64 n = 0;
    i64 a = 10;
    if (a > 0 && a / n > 1) return 1;
    // unreachable: the panic above exits 70
    return 42;
}
