// primitives_i128_parse_bad.tk -- docs/specs/small-ints.md § 7 (N6b-3, D85):
// `i128.Parse` panics on a string that is not an i128 -- C#'s own `Parse`, an
// exception, never a sentinel value no caller could tell from a parsed one.
// `TryParse` is the other half and never panics
// (`tests/primitives_i128_text.tk`). `rt_panic` exits 70, the same abort
// every other guard in this port takes.
//
// expect-exit: 70

#include "rt.tk"
#include "wide.tk"

i64 main() {
    i128 v = i128.Parse("x");
    if (v == 0i) return 1;
    return 42;
}
