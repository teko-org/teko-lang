// surface_dateonly_panic.tk -- the other half of the calendar for a
// `DateOnly` (docs/specs/datetime-extras.md § 2): a date that does not exist
// is not a date, and it is the SAME check `new DateTime(2023, 2, 29)` takes,
// because `tk_do_ymd` calls the very function the date constructor calls.
// C# raises `ArgumentOutOfRangeException`; a teko program has no exceptions,
// so the answer is `panic` -- `teko: a date does not exist`, exit 70.
//
// 2024 IS A LEAP YEAR, so `2024-02-30` is the date the program dies on: a day
// past the end of a month that really does have 29 days, which a wrong clamp
// would happily answer as 1 March. Every check ABOVE it is one that must NOT
// fire -- the leap day itself, both ends of the range, and the edges of the
// arithmetic C# accepts -- so that reaching the panic is a proof and not a
// false positive.
//
// expect-exit: 70

#include "../lib/time.tk"

i64 main() {
    // the leap day that DOES exist, in the very same month
    DateOnly real = new DateOnly(2024, 2, 29);
    if (real.Day != 29) return 1;
    if (real.Month != 2) return 2;
    if (real.DayNumber != 738944) return 3;

    // the two ends of the range, reachable and comparable
    DateOnly min = DateOnly.MinValue;
    DateOnly max = DateOnly.MaxValue;
    if (min.DayNumber != 0) return 4;
    if (max.DayNumber != 3652058) return 5;
    if (!(min < max)) return 6;

    // ...and the edges of the arithmetic that do not leave the range
    if (max.AddDays(0).DayNumber != 3652058) return 7;
    if (min.AddDays(0).DayNumber != 0) return 8;
    if (new DateOnly(9999, 12, 31).Year != 9999) return 9;
    if (new DateOnly(1, 1, 1).DayNumber != 0) return 10;
    if (DateOnly.FromDayNumber(3652058).Day != 31) return 11;

    // ...and the date that does not exist: February has 29 days in 2024
    DateOnly impossible = new DateOnly(2024, 2, 30);
    return impossible.Day;                        // never reached: the build panicked
}
