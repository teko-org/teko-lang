// primitives_decimal_order.tk -- docs/specs/decimal.md § 3 and § 13, D74: the
// literal handlers run in REGISTRATION order and the first non-zero node wins,
// so `tk_dec_init()` is registered BEFORE `tk_float_init()` in `teko.tk`.
// Registered the other way round, `<float>`'s own `fl_lit` reads `0.5` and
// stops before the `m`, and `0.5m` silently becomes an `f64` followed by a
// stray identifier.
//
// The two literals sit in one program and are never compared to each other:
// what is asserted is that each one kept its own type and its own value.
//
// expect-exit: 42

#include "decimal.tk"

i64 lo_of(decimal d) { ptr p = &d; return ld64(p); }
i64 hi_of(decimal d) { ptr p = &d; return ld64(p + 8); }

f64 twice(f64 x) { return x + x; }

i64 main() {
    f64 x = 0.5;
    decimal d = 0.5m;

    if (x != 0.5) return 1;
    if (twice(x) != 1.0) return 2;

    if (lo_of(d) != 5) return 3;
    if (((hi_of(d) >> 32) & 0xff) != 1) return 4;

    // ...and the plain forms on either side of them, unchanged
    i64 n = 5;
    f32 f = 0.25f;
    if (n != 5) return 5;
    if (f != 0.25) return 6;

    // `1.5` and `1.5m` in the same expression list
    if (twice(1.5) != 3.0) return 7;
    if (lo_of(1.5m) != 15) return 8;

    return 42;
}
