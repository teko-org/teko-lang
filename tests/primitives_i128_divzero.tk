// primitives_i128_divzero.tk -- N6a of docs/specs/small-ints.md (§ 6; D81):
// `x / 0i` panics. The divisor is asked about BEFORE the long division runs,
// because `tk_dv_divmod` over a zero divisor answers every bit set rather than
// failing, and a wrong quotient is worse than an abort.
//
// `teko: division by zero`, exit 70 -- `rt_panic`'s own road, the same one an
// index guard and a null delegate already take. It is a RUN-TIME refusal and
// not a compile-time one: the zero comes back from a function the folder
// cannot see through, which is what every real division by zero looks like.
// Plain `i64 / 0` behind the same kind of call panics the same way since
// D82 (`tests/surface_divzero.tk`) -- every integer width, wide or core,
// answers alike on every leg now.
//
// expect-exit: 70

#include "rt.tk"
#include "wide.tk"

i128 zero() { return 0i; }

i64 main() {
    i128 a = 7i;
    i128 q = a / zero();
    // unreachable: the panic above exits 70
    if (q == 0i) return 1;
    return 42;
}
