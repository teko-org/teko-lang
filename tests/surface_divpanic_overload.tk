// surface_divpanic_overload.tk -- D82 ruling 5 (the PR's second review): the
// guard needs the RUNTIME's `panic`, and looks for it over the whole unit,
// not through `decl_find`'s first declaration of the name alone. An
// unrelated overload of the program's own declared AHEAD of the include --
// `panic(i64)` here -- leaves the runtime's `panic(str)` declared and
// selectable (teko_over.tk), so the division compiles and its guard calls
// the runtime's, exactly as without the overload.
//
// expect-exit: 42

i64 panic(i64 code) { return code + 1; }

#include "../lib/rt.tk"

i64 main() {
    i64 n = 2;
    i64 a = 84;
    if (panic(1) != 2) return 10;
    return a / n;
}
