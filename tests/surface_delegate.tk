// surface_delegate.tk -- a NAMED delegate (K1, D221 §41): a typed pointer to
// a function, over `callp`, plus `null`.
//
// What each helper proves, in order:
//
//   1. `dcheck` -- `Op f = add;` (contextual) and `Op g = new Op(mul);`
//      (explicit) both wrap a plain function in a thunk generated once per
//      (delegate, function) pair; `f(3, 4)` rebaixes to a typed `callp`;
//      `Op` as a PARAMETER (`apply`) and as a RETURN (`choose`), and the
//      free-function overload `apply(Op)` vs `apply(i64)`;
//   2. `fcheck` -- a class field of delegate type, called where it is read
//      (`h.cb(2, 3)`), and released along with the object that holds it;
//      the store is the plain function's own NAME (`h.cb = add;`, D62), the
//      same wrap the local slot beside it gets;
//   3. `ncheck` -- `null`, an `N_INT` 0, guarded by an `if`;
//   4. `geo.use_gop()` -- the same declaration, INSIDE a namespace.
//   5. `rcheck` -- a delegate whose RETURN is a counted class (`Make`):
//      `Cell c = f(7);` takes the reference `f(7)` already owns with no
//      extra increment; `c = null;` then runs the destructor -- the bug K1b
//      fixed, an increment `rt_own` never sheds because the reclaim looked
//      up the count under the ORPHANED node the delegate rewrite built
//      rather than the one it copied into (teko_deleg.tk's `tk_deleg_call`).
//      Also covers a reassignment (`c = f(8)`, the prior reference released),
//      `return f(x)` from a function declared to answer `Cell`, `f(x)` as an
//      argument (parked and swept with the statement), and a delegate whose
//      own return is ANOTHER delegate (`Chooser`, itself counted).
//   6. `fdcheck` -- a delegate whose RETURN is a float (V1): the indirect call
//      carries the cast that declares its return type to the core, so
//      `1.0 + d(2.0)` is 5.0 and not the 3.0 the untyped `callp` left in the
//      register; the same by `new Scale(dbl)`, from a class field, and in
//      `f32`, where the value travels in the single-precision half.
//   7. `argcheck` -- D59, every argument of an indirect call judged and
//      widened exactly as a direct call's, over all four roads;
//   8. `pfcheck` -- D65, a delegate FIELD reached on the roads that had no
//      call at all: a receiver only the PASS can type (a parameter, and a
//      field of a field under one), and the BARE name inside a method;
//   9. `shadowcheck` -- D65's precedence, both halves: a bare name inside a
//      method is the class's own member -- method, then delegate field --
//      before any FREE function of that name, and from outside the class
//      that free function still answers. `shd.NShad` is the same pair inside
//      a NAMESPACE, where the free function is the namespace's own, and
//      `nsh.cgo()` is the CONST road the same index fix repaired.
//  10. `dfcheck` -- D62, the three other field-store sites a bare function
//      name reaches: `this.cb = add;` and the implicit `made = mul;` inside a
//      CONSTRUCTOR, and a STATIC field (`D62H.scb = add;`). Plus the name that
//      is NOT a function: `setcb` stores its PARAMETER `p` into the field
//      while a free function `p` stands right above it, and the call
//      afterwards proves the parameter is what landed there.
//  11. `dfcheck2` -- D62, the same door's other callers: a receiver the parser
//      cannot type yet, an element of an ARRAY FIELD, and a STATIC field
//      reached before its own type is read.
//  12. `sfcheck` -- D65 on the two slots that OUTLIVE the helper: a STATIC
//      field (`PH.scb(20, 1)`, and its bare name from a static method) and a
//      GLOBAL receiver (`g_ph.cb(3, 4)`).
//  13. `pcheck` -- a `ref`/`out` delegate whose POINTEE is a CLASS (`ref Box`,
//      `out Cell`) or a STRUCT (`ref Pt`), on both roads (D63, third pass).
//      The thunk forwards the caller's address as a bare name of a slot
//      declared `uptr`, and the reclaim's own argument check asked the
//      ordinary compatibility question about it: harmless for a scalar
//      pointee, `teko: a value of type uptr does not convert to Box` for a
//      class or struct one. The target mutates through the ref (`b.v = 3`)
//      and rebinds the caller's slot (`b = new Box(7)`, the prior reference
//      released), and the caller sees both.
//  14. D67: `new Op(f)` resolves `f` LATE now, the same walk the contextual
//      road already resolves at, so three roads the parse-time thunk got
//      wrong or refused are open -- `ovcheck` (an OVERLOADED target: `decl_
//      find` answered about whichever signature came first, wrong or no
//      match either way), `belowcheck` (a target declared BELOW the `new`,
//      `teko: unknown function` on the base) and `geo.ns_roads`'s own eighth
//      road (`new Op(col)` from INSIDE `geo`, `call to unknown function` --
//      no `teko:` at all -- on the base, the seventh road D62 measured and
//      left open). `usingcheck` is the fourth: a namespaced-only target
//      (`geo.gadd`, no flat twin) reached through `using geo;` alone.
//
// `rt_live()` is back to its floor after every helper returns: the reclaim
// (teko_rc.tk) already scopes a delegate value exactly as it scopes a class
// reference, teko_struct.tk's `tk_is_counted` the only line that changed. Four
// helpers raise that floor and all four run last, so the floor is 0 through
// `shadowcheck`: `dfcheck` and `dfcheck2` each leave a STATIC field alive by
// definition, `sfcheck` leaves a static delegate plus a global object holding
// one of its own, and `pcheck` allocates the one `Pt` -- a struct carries no
// count and is live for the run (`lib/rt.tk`). `main` asserts the exact count
// each of those four leaves rather than the floor.
//
// expect-exit: 42

#include "../lib/rt.tk"

delegate i64 Op(i64 a, i64 b);

i64 add(i64 a, i64 b) {
    return a + b;
}

i64 mul(i64 a, i64 b) {
    return a * b;
}

i64 apply(Op f) {
    return f(3, 4);
}

i64 apply(i64 k) {
    return k;
}

Op choose(i64 which, Op a, Op b) {
    if (which != 0) return a;
    return b;
}

class H {
    public Op cb;
}

delegate f64 Scale(f64 x);
delegate f32 Scale32(f32 x);

f64 dbl(f64 x) {
    return x * 2.0;
}

f32 half32(f32 x) {
    return x * 0.5f;
}

class FH {
    public Scale cb;
}

i64 dcheck() {
    Op f = add;
    if (f(3, 4) != 7) return 1;

    Op g = new Op(mul);
    if (g(3, 4) != 12) return 2;

    if (apply(f) != 7) return 3;                  // apply__Op
    if (apply(9) != 9) return 4;                  // apply__i64

    Op picked = choose(1, f, g);
    if (picked(3, 4) != 7) return 5;
    picked = choose(0, f, g);
    if (picked(3, 4) != 12) return 6;

    return 0;
}

// D62: the store is the FUNCTION's own name. A local of delegate type held
// the wrap here (`Op cb = add; h.cb = cb;`) because the field door could not
// type a bare name at all -- `teko: the type of this value is not known here`
// on a program the slot one line up accepts.
i64 fcheck() {
    H h = new H;
    h.cb = add;
    if (h.cb(2, 3) != 5) return 1;
    return 0;
}

// ---- D62: the constructor, the implicit `f = e` and the static field ----

class D62H {
    public Op cb;
    public Op made;
    public static Op scb;

    public D62H() {
        this.cb = add;                            // teko_this.tk's `tk_this_assign`
        made = mul;                               // ...and its implicit form
    }
}

i64 p(i64 a, i64 b) {                             // a free function named `p`
    return a + b + 100;
}

// the name stored here is the PARAMETER `p`, which shadows the function above
// for the whole body: the judge runs in `tk_deleg_pass`, where the lexical
// scope answers, and never at the parse-time door, where no table can tell
// the two apart (D51's own sixth pass, one slot over on an element).
void setcb(D62H h, Op p) {
    h.cb = p;
}

i64 dfcheck() {
    D62H h = new D62H();
    if (h.cb(2, 3) != 5) return 1;
    if (h.made(2, 3) != 6) return 2;

    D62H.scb = add;                               // teko_access.tk's `tk_static_use`
    Op s = D62H.scb;
    if (s(2, 3) != 5) return 3;

    setcb(h, mul);
    if (h.cb(2, 3) != 6) return 4;
    return 0;
}

// ---- D62, the door's other callers ----
// `tk_field_store_val` is entered from more than the four stores `dfcheck`
// covers, and a detection AT the door reaches every one of them. These are the
// three that had no fixture: a receiver the parser cannot type yet (a class
// declared BELOW the function that takes one, resolved in `tk_pend_field`,
// teko_typeof.tk), an element of an ARRAY FIELD (`tk_array_index`,
// teko_struct.tk) and a STATIC field reached before its own type is read
// (`tk_fwd_resolve_static_one`, teko_access.tk). All three answered
// `teko: the type of this value is not known here` on the base compiler.
void set_late(LateH h) {                          // `h` is typed at PASS time
    h.cb = add;
}

i64 set_late_static() {
    LateH.scb = mul;                              // the forward-referenced static store
    return 0;
}

class LateH {
    public Op cb;
    public Op cbs[2];
    public static Op scb;
}

i64 dfcheck2() {
    LateH h = new LateH;

    set_late(h);                                  // the deferred receiver
    if (h.cb(2, 3) != 5) return 1;

    h.cbs[0] = mul;                               // an element of an array FIELD
    Op e = h.cbs[0];                              // (the call through it is not taught:
    if (e(2, 3) != 6) return 2;                   //  docs/reference/not-yet.md)

    set_late_static();
    Op s = LateH.scb;
    if (s(2, 3) != 6) return 3;

    return 0;
}

i64 ncheck() {
    Op? maybe = null;
    if (maybe == null) return 0;
    return 1;
}

i64 fdcheck() {
    Scale d = dbl;
    if (d(2.0) != 4.0) return 1;
    if (1.0 + d(2.0) != 5.0) return 2;            // the nested form, at a moved depth
    if (1.0 + (2.0 + (4.0 + d(8.0))) != 23.0) return 3;

    Scale g = new Scale(dbl);
    if (1.0 + g(3.0) != 7.0) return 4;

    FH h = new FH;
    h.cb = d;
    if (1.0 + h.cb(2.0) != 5.0) return 5;         // the same call from a class FIELD

    Scale32 s = half32;
    if (1.0f + s(3.0f) != 2.5f) return 6;

    return 0;
}

// ---- D62, the namespace half: which `col` a bare name wraps ----
// `col` is declared BOTH flat and inside `geo`, with the same signature and a
// different answer, so the road that picks the wrong one is visible in the
// exit code rather than silent. Every road that wraps a bare function name
// goes through one resolver (`tk_deleg_resolve_fn`, teko_deleg.tk), which
// reads the order `tk_ns_rewrite_call` (teko_ns.tk) gives a CALL: the site's
// own namespace and its prefixes outward first, a flat declaration of the
// exact name only when the namespace has none.
i64 col(i64 a, i64 b) {                           // the FLAT one
    return a + b + 1000;
}

i64 takes_op(Op f) {                              // a call argument's own road
    return f(2, 3);
}

namespace geo {
    delegate i64 GOp(i64 a, i64 b);

    i64 gadd(i64 a, i64 b) {
        return a + b;
    }

    i64 use_gop() {
        GOp f = gadd;
        return f(10, 20);
    }

    i64 col(i64 a, i64 b) {                       // `geo__col`, the namespaced one
        return a * b;
    }

    Op ret_col() {
        return col;                               // a `return` of a bare name
    }

    // every road the shared resolver serves, from INSIDE `geo`: 6 is the
    // namespaced `col`, 1005 the flat one, 5 the flat `add` no namespaced
    // twin competes with
    i64 ns_roads() {
        Op a = col;                               // a local initializer
        if (a(2, 3) != 6) return 1;

        Op b = add;                               // no `geo__add`: the FLAT one
        if (b(2, 3) != 5) return 2;

        b = col;                                  // an assignment
        if (b(2, 3) != 6) return 3;

        if (takes_op(col) != 6) return 4;         // a call argument

        Op c = ret_col();                         // a `return`
        if (c(2, 3) != 6) return 5;

        Op[] ops = new Op[1];
        ops[0] = col;                             // an element of an `Op[]`
        if (ops[0](2, 3) != 6) return 6;

        H h = new H;
        h.cb = col;                               // a FIELD -- D62's own road
        if (h.cb(2, 3) != 6) return 7;

        Op d = new Op(col);                       // D67: the EXPLICIT thunk, the
        if (d(2, 3) != 6) return 8;               // seventh road D62 left open

        return 0;
    }
}

using geo;                                        // D67: `usingcheck`'s own road

// ---- D67: `new Op(f)` resolves `f` LATE, at the same walk the contextual
// road already resolves at ----

i64 ov700(i64 a) {                                // declared FIRST -- `decl_find`'s
    return a + 700;                               // own pick, on the base
}

i64 ov700(i64 a, i64 b) {                         // arity 2, the ONE that matches `Op`
    return a + b + 700;
}

i64 ovcheck() {
    Op f = new Op(ov700);
    if (f(2, 3) != 705) return 1;
    return 0;
}

i64 belowcheck() {
    Op f = new Op(laterfn);                       // `laterfn` is declared BELOW
    if (f(2, 3) != 805) return 1;
    return 0;
}

i64 laterfn(i64 a, i64 b) {
    return a + b + 800;
}

// `geo.gadd` has no flat twin: `using geo;` above is the ONLY road that
// answers for its bare name here, outside the namespace and with no
// enclosing one of its own to try first.
i64 usingcheck() {
    Op f = new Op(gadd);
    if (f(2, 3) != 5) return 1;
    return 0;
}

i64 cell_dtors = 0;

class Cell {
    public i64 v;

    public Cell(i64 x) {
        v = x;
    }

    ~Cell() {
        cell_dtors = cell_dtors + 1;
    }
}

delegate Cell Make(i64 x);
delegate Make Chooser(i64 which);

Cell mkcell(i64 x) {
    return new Cell(x);
}

Cell mkcell2(i64 x) {
    return new Cell(x + 100);
}

Make choose_make(i64 which) {
    if (which != 0) return new Make(mkcell2);
    return new Make(mkcell);
}

Cell via_return(Make f, i64 x) {
    return f(x);
}

i64 via_arg(Cell c) {
    return c.v;
}

i64 rcheck() {
    Make f = mkcell;
    {
        Cell c = f(7);
        if (c.v != 7) return 1;
    }                                             // the block closes the cell's life
    if (cell_dtors != 1) return 2;                // the reference `f(7)` owned, freed once

    Cell c = f(8);                                // a fresh slot: none to release first
    if (c.v != 8) return 3;

    Cell r = via_return(f, 9);                     // `return f(x);` from a Cell-returning fn
    if (r.v != 9) return 4;

    if (via_arg(f(10)) != 10) return 5;            // `f(x)` as an argument, parked and swept

    Chooser pick = choose_make;
    Make picked = pick(1);                         // a delegate returning ANOTHER delegate
    Cell got = picked(5);
    if (got.v != 105) return 6;

    return 0;
}

// ---- 7. an argument JUDGED and CONVERTED at a delegate call (D59) ----
// All three roads into a delegate `callp` are built by one function
// (`tk_deleg_build`, teko_deleg.tk) and pass one door, and until D59 that door
// read the `ref`/`out` KIND alone: an integer handed to an `f64` parameter
// crossed as its own raw bits, and a value of the wrong type crossed at all.
// What runs below is the accepted side -- the widening C# 10.2.3 owes the
// argument, on the LOCAL, PARAMETER, FIELD and ELEMENT roads, an
// integer LITERAL and an integer NAME alike; an argument that is a COMPOSITE
// EXPRESSION -- a binary, a ternary, a negation -- which the parse-time oracle
// types no better than a global and which D59's second pass added to the park;
// an argument that is a call to an
// OVERLOADED name, whose type is the pick's and not the first declaration's;
// a right-typed global; and a `ref` global whose pointee is the one the
// signature declares, through a FIELD slot -- the road whose parse-time door
// could not read a pointee at all. Every refusal this door now gives is a
// fixture of its own (tests/refuse/deleg_arg_*.tk, deleg_field_*.tk,
// deleg_elem_*.tk).

delegate f64 Sc(f64 x);
delegate void MutD(ref f64 x);

f64 five(f64 x) {
    return x * 5.0;
}

void bumpd(ref f64 x) {
    x = x + 1.0;
}

// an overloaded name: `tk_pty_of` answers the FIRST declaration's return at
// the door, and `pick(2)` reaches the second -- so the argument is parked and
// typed by the pick, at pass 14
f64 pick(f64 k) {
    return k + 0.5;
}

i64 pick(i64 k) {
    return k;
}

class SH {
    public Sc cb;
    public MutD mut;
}

i64 g_n = 3;
f64 g_rate = 4.0;
f64 g_bumped = 1.0;

i64 use_sc(Sc f) {                                // the PARAMETER road
    return (i64)f(2);
}

i64 use_sce(Sc f, i64 k) {                        // ...with a composite argument
    return (i64)f(k * 2);
}

i64 argcheck() {
    Sc f = five;
    i64 li = 3;

    if (f(5) != 25.0) return 1;                   // LOCAL road, integer LITERAL
    if (f(li) != 15.0) return 2;                  // LOCAL road, integer NAME
    if (f(g_n) != 15.0) return 3;                 // ...a GLOBAL integer
    if (f(g_rate) != 20.0) return 4;              // ...a right-typed global
    if (f(pick(2)) != 10.0) return 5;             // ...a call to an OVERLOADED name

    if (use_sc(f) != 10) return 6;                // the PARAMETER slot

    SH h = new SH;
    h.cb = new Sc(five);
    if (h.cb(5) != 25.0) return 7;                // the FIELD road, literal
    if (h.cb(li) != 15.0) return 8;               // ...and a name

    Sc[] scs = new Sc[1];
    scs[0] = new Sc(five);
    if (scs[0](5) != 25.0) return 9;              // the ELEMENT road, literal
    if (scs[0](li) != 15.0) return 10;            // ...and a name

    MutD m = bumpd;                               // a `ref` pointee through a FIELD
    h.mut = m;
    h.mut(ref g_bumped);
    if (g_bumped != 2.0) return 11;

    // ...and an argument that is a COMPOSITE EXPRESSION, which no oracle types
    // at the door: parked like every other one and judged at pass 14 (D59,
    // second pass). Each row below handed its integer's own raw bits to the
    // `f64` parameter before that, on this road and on the three below it.
    if (f(1 + 2) != 15.0) return 12;              // a binary over two literals
    if (f(li * 2) != 30.0) return 13;             // ...over a name
    if (f(li > 0 ? 3 : 4) != 15.0) return 14;     // a ternary
    if (f(0 - li) != 0.0 - 15.0) return 15;       // a negation

    if (h.cb(li * 2) != 30.0) return 16;          // the FIELD road
    if (scs[0](1 + 2) != 15.0) return 17;         // the ELEMENT road
    if (use_sce(f, li) != 30) return 18;          // the PARAMETER road

    return 0;
}

// ---- D65: a delegate FIELD is callable on every road it can be READ ----
// The parse-time road (`fcheck`, above) was the only one with a call. Three
// had none: a receiver the PARSER cannot type defers to teko_typeof.tk's
// pass and came out `teko: the member is a field, not a method`; the bare
// name inside a method reached no rewrite and was left to the core, `call to
// unknown function`; and `PH.scb(...)` on a STATIC field came out
// `teko: unknown member`.
class PH {
    public Op cb;
    public static Op scb;

    // the BARE name -- `this.cb(a, b)` written without the receiver
    public i64 go(i64 a, i64 b) {
        return cb(a, b);
    }

    // ...and from a STATIC method, where the field is a global of its own
    public static i64 sgo(i64 a, i64 b) {
        return scb(a, b);
    }
}

class PA {
    public PH inner;
}

PH g_ph;                                          // the GLOBAL receiver road

i64 use_ph(PH h) {                                // a PARAMETER receiver
    return h.cb(2, 3);
}

i64 use_pa(PA a) {                                // ...a field of a field under one
    return a.inner.cb(4, 5);
}

i64 pfcheck() {
    PH h = new PH;
    h.cb = new Op(add);

    if (use_ph(h) != 5) return 1;                 // a receiver only the pass types
    if (h.go(6, 7) != 13) return 2;               // the bare name inside a method

    PA a = new PA;
    a.inner = h;
    if (use_pa(a) != 9) return 3;                 // `a.inner.cb`, root a parameter

    return 0;
}

// ---- D65: a member of the class shadows a free function of the same name ----
// A bare name inside a method resolves to the class's OWN member -- method
// first, then a delegate field -- before any free function of that name.
// That is C#'s rule for the nearest form it has (a static method of an
// enclosing class, a top-level local function): the member wins, silently.
// The METHOD half was already so before D65 (`tag` below answers +1, not
// +100, on the base compiler too); the FIELD half is what D65 added, and it
// is the same rule written at the one door that did not have it.
//
// From OUTSIDE the class the free function is untouched: `cb(5)` in `main`
// is still the free `cb`, and `sh.cb(5)` through the receiver is the field.
//
// The same rule holds INSIDE a namespace (`shd` below), and that is the door
// D65 first missed: the namespace rewrite (teko_ns.tk's `tk_ns_rewrite_call`)
// renames a bare call to the namespace's own free function BEFORE
// `tk_this_deleg_call` can see it, so `shd.NShad.go` ran `shd__cb` and
// answered +100. It now stops on a delegate field exactly as it already
// stopped on a method, and the class index it reads that member table with is
// the class's, not the method row's. A namespaced free function with no
// member of its name is untouched (`plain`), and so is a call written outside
// the class but inside the namespace (`shd.outside`).
delegate i64 Op1(i64 a);

i64 add1(i64 a) {
    return a + 1;
}

i64 cb(i64 a) {                                   // a FREE function named like
    return a + 100;                               // Shad's delegate field
}

i64 tag(i64 a) {                                  // ...and like Shad's method
    return a + 100;
}

class Shad {
    public Op1 cb;

    public i64 tag(i64 a) {
        return a + 1;
    }

    public i64 go(i64 x) {                        // the FIELD shadows free `cb`
        return cb(x);
    }

    public i64 tgo(i64 x) {                       // the METHOD shadows free `tag`
        return tag(x);
    }
}

namespace shd {
    i64 cb(i64 a) {                               // a free function of the NAMESPACE,
        return a + 100;                           // named like NShad's delegate field
    }

    i64 tag(i64 a) {                              // ...and like NShad's method
        return a + 100;
    }

    i64 lone(i64 a) {                             // ...and named like no member at all
        return a + 100;
    }

    const i64 CX = 105;                           // ...and named like NShad's own const

    class NShad {
        public Op1 cb;

        public const i64 CX = 6;

        public i64 tag(i64 a) {
            return a + 1;
        }

        public i64 cgo() {                        // the CONST road of the same rewrite
            return CX;
        }

        public i64 go(i64 x) {                    // the FIELD shadows `shd.cb`
            return cb(x);
        }

        public i64 tgo(i64 x) {                   // the METHOD shadows `shd.tag`
            return tag(x);
        }

        public i64 plain(i64 x) {                 // no member named `lone`: the free fn
            return lone(x);
        }
    }

    i64 outside(i64 x) {                          // outside the class: the free fn
        return cb(x);
    }
}

i64 shadowcheck() {
    Shad sh = new Shad;
    sh.cb = new Op1(add1);

    if (sh.go(5) != 6) return 1;                  // the field, not the free `cb`
    if (sh.tgo(5) != 6) return 2;                 // the method, not the free `tag`
    if (sh.cb(5) != 6) return 3;                  // the field through a receiver

    shd.NShad nsh = new shd.NShad;
    nsh.cb = new Op1(add1);

    if (nsh.go(5) != 6) return 4;                 // the field, not `shd__cb`
    if (nsh.tgo(5) != 6) return 5;                // the method, not `shd__tag`
    if (nsh.plain(5) != 105) return 6;            // no member of that name: the free fn
    if (shd.outside(5) != 105) return 7;          // outside the class, inside the namespace
    if (nsh.cgo() != 6) return 8;                 // the member const, not `shd__CX`

    return 0;
}

// the two slots that OUTLIVE the helper -- a static field and a global -- so
// the live count after this one is not the floor, and `main` asserts what it
// is instead
i64 sfcheck() {
    PH.scb = new Op(add);
    if (PH.scb(20, 1) != 21) return 1;            // `Type.field(...)`
    if (PH.sgo(30, 2) != 32) return 2;            // ...and its bare name

    g_ph = new PH;
    g_ph.cb = new Op(mul);
    if (g_ph.cb(3, 4) != 12) return 3;            // a GLOBAL receiver

    return 0;
}

// ---- 13. a `ref`/`out` delegate whose POINTEE is a class or a struct ----

class Box {
    public i64 v;

    public Box(i64 x) {
        v = x;
    }
}

struct Pt {
    public i64 x;
    public i64 y;
}

delegate void Fill(ref Box b);
delegate void Move(ref Pt p);
delegate void Mk(out Cell c);

void fill(ref Box b) {
    b.v = 3;                                       // through the ref, into the caller's object
}

void rebind(ref Box b) {
    b = new Box(7);                                // ...and the caller's SLOT, rebound
}

void mv(ref Pt p) {
    p.x = 9;
}

void mkcellout(out Cell c) {
    c = new Cell(5);
}

i64 pcheck() {
    Box b = new Box(1);
    Fill f = fill;
    f(ref b);
    if (b.v != 3) return 1;
    Fill nf = new Fill(fill);                      // the same thunk, the explicit road
    b.v = 1;
    nf(ref b);
    if (b.v != 3) return 2;

    Fill r = rebind;
    r(ref b);
    if (b.v != 7) return 3;                        // the old Box released, the new one here
    Fill nr = new Fill(rebind);
    nr(ref b);
    if (b.v != 7) return 4;

    Pt p = new Pt();
    p.x = 0;
    Move m = mv;
    m(ref p);
    if (p.x != 9) return 5;
    p.x = 0;
    Move nm = new Move(mv);
    nm(ref p);
    if (p.x != 9) return 6;

    Cell c = new Cell(0);
    Mk k = mkcellout;
    k(out c);
    if (c.v != 5) return 7;
    Mk nk = new Mk(mkcellout);
    nk(out c);
    if (c.v != 5) return 8;

    return 0;
}

i64 main() {
    i64 bad = dcheck();
    if (bad != 0) return 10 + bad;
    if (rt_live() != 0) return 20;

    bad = fcheck();
    if (bad != 0) return 30 + bad;
    if (rt_live() != 0) return 40;

    bad = ncheck();
    if (bad != 0) return 50 + bad;
    if (rt_live() != 0) return 60;

    bad = fdcheck();
    if (bad != 0) return 120 + bad;
    if (rt_live() != 0) return 130;

    if (geo.use_gop() != 30) return 70;
    if (rt_live() != 0) return 80;

    bad = argcheck();
    if (bad != 0) return 140 + bad;
    if (rt_live() != 0) return 160;

    bad = rcheck();
    if (bad != 0) return 90 + bad;
    if (rt_live() != 0) return 100;
    if (cell_dtors != 5) return 110 + cell_dtors;

    bad = pfcheck();
    if (bad != 0) return 161 + bad;
    if (rt_live() != 0) return 165;               // borrowed by the call, not kept

    bad = shadowcheck();
    if (bad != 0) return 166 + bad;
    if (rt_live() != 0) return 175;
    if (cb(5) != 105) return 176;                 // outside the class, the FREE
    if (tag(5) != 105) return 177;                // functions still answer

    bad = dfcheck();
    if (bad != 0) return 178 + bad;
    if (rt_live() != 1) return 183;               // the STATIC field's own delegate

    bad = dfcheck2();
    if (bad != 0) return 184 + bad;
    if (rt_live() != 2) return 188;               // ...and this helper's own static

    bad = geo.ns_roads();
    if (bad != 0) return 189 + bad;
    if (rt_live() != 2) return 198;

    bad = sfcheck();
    if (bad != 0) return 198 + bad;
    if (rt_live() != 5) return 202;               // the two statics above, plus
                                                  // `PH.scb`, `g_ph` and the
                                                  // delegate `g_ph` holds

    bad = pcheck();
    if (bad != 0) return 203 + bad;
    if (rt_live() != 6) return 212;                // ...plus the one `Pt`
    if (cell_dtors != 8) return 213 + cell_dtors;  // the two `out` rebinds, then the slot

    bad = ovcheck();                               // D67: an OVERLOADED target
    if (bad != 0) return 220 + bad;
    if (rt_live() != 6) return 225;                // purely local, the floor unmoved

    bad = belowcheck();                            // D67: a target declared BELOW
    if (bad != 0) return 226 + bad;
    if (rt_live() != 6) return 231;

    bad = usingcheck();                            // D67: a namespaced target through `using`
    if (bad != 0) return 232 + bad;
    if (rt_live() != 6) return 237;

    return 42;
}
