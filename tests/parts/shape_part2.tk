// shape_part2.tk -- the SECOND part of `Shape`, in a file of its own; the first
// one is tests/surface_partial.tk, which pulls this in with `#include`. It is
// not a fixture: the CI's glob is `tests/*.tk`, and this lives one directory
// down, so nothing ever tries to compile it on its own.
//
// It adds a field, a method, an `override` of the slot the base declared and a
// property -- all of them members of the very row the first part opened, which
// is why `w`, declared over there, is readable here.

partial class Shape {
    public i64 h;

    public i64 tag() {
        return 7;
    }

    public override i64 f() {
        return b + w + h;
    }

    public i64 Both {
        get => w + h;
    }
}
