// tests/parts/ns_file.tk -- the file-scoped form of `namespace` (C# 10),
// brought in by `#include` from surface_namespace.tk; excluded from the
// fixture glob on purpose (it declares no `main`).
//
// `namespace parts;` names the namespace for the REST OF THIS FILE and
// nothing else: teko_ns.tk's `tk_ns_current` looks the answer up by the file
// the parser stands in, so once the `#include` that brought this file in
// returns to the includer, the current namespace is gone again -- there is
// no state to unwind for that half of the design at all.

namespace parts;

class Marker {
    public i64 m;
}
