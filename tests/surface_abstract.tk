// surface_abstract.tk -- `abstract` as C# writes it (D224, entrega 5): a class
// with no object of its own, and a member with no body at all.
//
// `abstract class Shape` emits no vtable and no constructor -- `new Shape` is
// refused -- and `public abstract i64 area();` takes a vtable slot with NOTHING
// in it. The first class down the chain that is NOT abstract is the one that has
// to fill every such slot with an `override`, which is the same conformance
// check an interface gets; an abstract class in between (`Sided`) may leave what
// it inherited open and add its own members.
//
// A concrete method of the abstract class calls the abstract one (`twice`), and
// the call goes through the vtable, so the implementation the object carries is
// the one that answers. A property is abstract by the same rule, one slot per
// accessor and no backing field. And the interface an abstract class names is
// answered by the class that has an object: `Shape` declares `tag` and every
// concrete class down the chain publishes it.
//
// expect-exit: 42

#include "../lib/rt.tk"

interface Named {
    i64 tag();
}

abstract class Shape : Named {
    public i64 side;

    public abstract i64 area();

    public abstract i64 Scale { get; }

    public i64 twice() {
        return area() * 2;
    }

    public i64 tag() {
        return 7;
    }
}

abstract class Sided : Shape {
    public i64 doubled() {
        return side * 2;
    }
}

class Square : Sided {
    public override i64 area() {
        return side * side;
    }

    public override i64 Scale {
        get => side + 1;
    }
}

class Rect : Sided {
    public i64 h;

    public override i64 area() {
        return side * h;
    }

    public override i64 Scale {
        get => h;
    }

    public i64 twice_plus() {
        return twice() + 1;
    }
}

i64 main() {
    Square q = new Square;
    q.side = 4;
    Rect r = new Rect;
    r.side = 3;
    r.h = 5;

    if (q.area() != 16) return 1;
    if (r.area() != 15) return 2;

    Shape s = q;
    if (s.area() != 16) return 3;                // the vtable of the abstract base
    if (s.twice() != 32) return 4;               // a concrete method calling the abstract one
    if (s.Scale != 5) return 5;                  // the abstract property

    Shape t = r;
    if (t.area() != 15) return 6;
    if (t.Scale != 5) return 7;

    Sided d = r;
    if (d.doubled() != 6) return 8;              // an abstract class in the middle

    Named n = q;
    if (n.tag() != 7) return 9;                  // the interface the abstract class named

    if (r.twice_plus() != 31) return 10;
    return 42;
}
