// primitives_guid_parse_bad.tk -- docs/specs/guid.md § 4: `Guid.Parse` panics
// on a string that is not a `Guid`, which is C#'s own `Parse` (an exception,
// never a sentinel value no caller could tell from a parsed one). `rt_panic`
// exits 70, the same abort every other guard in this port takes.
//
// expect-exit: 70

#include "rt.tk"
#include "guid.tk"

i64 main() {
    Guid g = Guid.Parse("nope");
    if (g.IsEmpty) return 1;
    return 42;
}
