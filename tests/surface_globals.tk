// surface_globals.tk -- a GLOBAL, on the five oracle sites that only ever
// asked the pass-time SCOPE (`tk_ty_scope_find`, teko_typeof.tk) and never
// fell back to `tk_ty_global` (teko_array.tk) once that scope answered -1: a
// global is not "not known here", it is in scope in every body, exactly as
// D48 already made true for a bare `N_IDENT` read (D51).
//
// What each helper proves, in order:
//
//   1. `refoutcheck`   -- `ref`/`out` over a scalar global, `i64` and `f64`:
//      the dedicated pointee check (`tk_ref_arg_pointee`, teko_ref.tk) used
//      to answer "not known" for a global and skip its own identity check in
//      silence -- the same gap the fallback here closes, over the SAME table
//      `tk_ty_global` reads (a global not resolvable through it is a probe:
//      `ref f64` given an `i64` global refuses `teko: a value of type i64
//      does not convert to f64`, the wording a local of the wrong type
//      already gets).
//   2. `overloadcheck` -- two overloads that differ only by the pointee of a
//      `ref` parameter, resolved by a GLOBAL argument (`teko_over.tk`'s own
//      `tk_ov_arg_ty`): before this crumb, `pick(ref g_f)` refused `teko:
//      the type of argument 1 of pick is not known here`, a legal call with
//      no ambiguity at all.
//   3. `delegcheck`    -- a GLOBAL of delegate type: assigned a plain
//      function name, called; reassigned a lambda literal, called; and
//      called from INSIDE another function (`useOp`), which is what exposed
//      the sharpest form of the gap -- `teko_deleg.tk`'s own dispatch fell
//      through to a bare `N_CALL` of a name nothing declares, `unknown name`
//      from the core, never a `teko: ...` refusal (D20's own rule).
//   3b. `delegarrcheck` -- the ELEMENT of an `Op[]`, the one slot whose
//      coercion runs where no oracle answers at all: `tk_ha_store`
//      (teko_heaparr.tk) is reached at PARSE time for a local array and
//      inside `tk_array_pass` for a global one, so every NAME written there
//      -- a global, a local, a parameter, a function declared below the store
//      -- read as -1 and was wrapped as a FUNCTION,
//      `teko: unknown function: ...`. A global `Op[]` was coerced by nothing
//      at all and handed the bare name to the core, `unknown name`. The value
//      waits for `tk_deleg_pass` now (D51, third pass).
//   4. `paramscheck`   -- a `params i64[]` call with a global SCALAR element
//      among its tail (`teko_params.tk`'s own `tk_pm_arg_ty`, which read only
//      `tk_ty_global_ha` -- a global `T[]` of heap -- before this crumb; a
//      mismatched element was already caught downstream by
//      `tk_rc_call_args`, so widening it to `tk_ty_global` changes no
//      observed message, only which pass answers first). `shadowparam` and
//      `plainparam` add the other half: a local shadows a PARAMETER at the
//      site, which the function-wide parameter table this site read first
//      could not express (D51, second pass).
//   6. `sibcheck`       -- a global two SIBLING blocks of one function shadow
//      under two different types: `ref g_sib` inside a block is that block's
//      own local, and the same `ref g_sib` written after both blocks have
//      closed is the global -- one LEXICAL answer per site, never a body-wide
//      scan calling the name "ambiguous" (D51, verifier finding).
//   7. `addrcheck`      -- a bare `&x` at a parameter that is NOT `ref`/`out`:
//      the N_ADDR guard `tk_rc_call_args` (teko_rc.tk) grew for D51 skipped
//      the compatibility rule for EVERY address, where only a `ref`/`out`
//      parameter has a different rule to take (the identity one over
//      pointees). An untagged address takes the ordinary one now, and is
//      widened never either way (D51, second pass).
//   5. `regressioncheck` -- an enum global (D48) and `T?` over a reference
//      global (D48) still read correctly: neither of those two sites is
//      `tk_ty_scope_find`, and this crumb does not touch them, so this is a
//      regression check, not new coverage.
//
// expect-exit: 42

#include "../lib/rt.tk"

i64 g_i = 7;
f64 g_f = 1.5;

// ---- 1. `ref`/`out` over a scalar global ----

void bumpi(ref i64 x) { x = x + 1; }
void bumpf(ref f64 x) { x = x + 1.0; }
void outi(out i64 x) { x = 99; }
void outf(out f64 x) { x = 9.5; }

i64 refoutcheck() {
    bumpi(ref g_i);
    if (g_i != 8) return 1;
    bumpf(ref g_f);
    if (g_f != 2.5) return 2;
    outi(out g_i);
    if (g_i != 99) return 3;
    outf(out g_f);
    if (g_f != 9.5) return 4;
    return 0;
}

// ---- 2. overload resolution over a `ref` global ----

i64 pick(ref f64 x) { return 1; }
i64 pick(ref i64 x) { return 2; }

i64 overloadcheck() {
    if (pick(ref g_f) != 1) return 1;
    if (pick(ref g_i) != 2) return 2;
    return 0;
}

// ---- 3. a delegate-typed global ----

delegate i64 Op(i64 a);

i64 addOne(i64 a) { return a + 1; }

Op g_op;

i64 useOp(i64 v) { return g_op(v); }             // called from INSIDE another function

i64 takeOp(Op h) { return h(3); }                // ...handed over as an argument
Op giveOp() { return g_op; }                     // ...and handed back as a result

i64 delegcheck() {
    g_op = addOne;                                // a plain function name
    if (g_op(10) != 11) return 1;
    if (useOp(20) != 21) return 2;

    g_op = new Op((i64 x) => x * 2);              // reassigned to a lambda
    if (g_op(10) != 20) return 3;
    if (useOp(5) != 10) return 4;

    // the delegate-typed global on the RIGHT of every slot that takes one.
    // `tk_deleg_coerce`'s own wrap guard read the pass-time scope alone, so a
    // global read there as "no slot declares this name" and was wrapped as a
    // FUNCTION: `teko: unknown function: g_op` on a program with no error.
    g_op = addOne;
    Op h;
    h = g_op;                                     // an assignment
    if (h(10) != 11) return 5;
    if (takeOp(g_op) != 4) return 6;              // a call argument
    Op k = giveOp();                              // a `return`
    if (k(1) != 2) return 7;
    Op m = g_op;                                  // a var initializer
    if (m(2) != 3) return 8;

    return 0;
}

// ---- 3b. the ELEMENT of an `Op[]`, the one slot coerced where no oracle
// answers (D51, third pass) ----

Op[] g_ops;                                       // a GLOBAL array of them

i64 addTwo(i64 a) { return a + 2; }

// the store is written here, and the name is a PARAMETER: neither the
// pass-time scope nor the parser's own table of locals holds one
i64 storeParam(Op p) {
    Op[] ops = new Op[1];
    ops[0] = p;
    return ops[0](1);
}

i64 delegarrcheck() {
    g_op = addOne;
    Op lo = addTwo;

    // `tk_ha_store` (teko_heaparr.tk) coerces the value of an element store,
    // and the store is built where NO oracle can type a name -- at parse time
    // for a local array, inside `tk_array_pass` for a global one. Every name
    // below read as -1 there and was wrapped as a FUNCTION,
    // `teko: unknown function: g_op` / `: lo` / `: p` / `: addLater`, on a
    // program with no error in it. The coercion waits for `tk_deleg_pass` now,
    // which is the one walk that has the lexical scope and the global rows at
    // once.
    Op[] ops = new Op[4];
    ops[0] = g_op;                                // a global
    ops[1] = lo;                                  // a local
    ops[2] = addOne;                              // a plain function: wrapped as it always was
    ops[3] = addLater;                            // ...declared BELOW this body
    if (ops[0](10) != 11) return 1;
    if (ops[1](10) != 12) return 2;
    if (ops[2](10) != 11) return 3;
    if (ops[3](10) != 13) return 4;

    Op h = ops[1];                                // read back out of the element
    if (h(1) != 3) return 5;

    if (storeParam(addTwo) != 3) return 6;        // a parameter

    // a GLOBAL `Op[]`: its store is built by `tk_array_resolve_write`
    // (teko_array.tk), which coerced nothing at all -- the raw function name
    // reached the core, `unknown name`, never a `teko: ...` refusal (D20)
    g_ops = new Op[2];
    g_ops[0] = addOne;
    g_ops[1] = lo;
    Op a0 = g_ops[0];
    Op a1 = g_ops[1];
    if (a0(10) != 11) return 7;
    if (a1(10) != 12) return 8;

    return 0;
}

i64 addLater(i64 a) { return a + 3; }

// ---- 4. `params` over a global scalar element ----

i64 sumall(params i64[] xs) {
    i64 t = 0;
    i64 i = 0;
    loop {
        if (i >= xs.Length) break;
        t = t + xs[i];
        i = i + 1;
    }
    return t;
}

// a LOCAL of the same name as the global, in ANOTHER function: the unit-wide
// most-recent-wins table this pass used to read (`tk_slv_find_unit`) answered
// with THIS `f64` for the `g_i` of `sumall(1, g_i, 2)` below, masking the
// global the call really passes
f64 maskgi() {
    f64 g_i = 1.5;
    return g_i + 1.0;
}

// a LOCAL shadowing a PARAMETER of the SAME function. The function-wide
// parameter table this pass asked BEFORE the scope (`tk_pm_param_ty`) carried
// no position, so the `f64 x` of the signature answered for the `i64 x` the
// block declares and the legal call below was refused, `teko: a value of type
// f64 does not convert to i64` (D51, second pass). One lexical oracle answers
// now: a parameter opens the scope, a local shadows it, and the innermost
// declaration visible AT the site is the type.
i64 shadowparam(f64 x) {
    if (x > 0.0) {
        i64 x = 2;
        return sumall(1, x, 3);
    }
    return 0;
}

// the same call with NO shadow in sight: the parameter itself is what the
// scope answers, which is what the deleted table used to be there for
i64 plainparam(i64 x) {
    return sumall(x, 4);
}

i64 paramscheck() {
    g_i = 5;
    if (sumall(1, g_i, 2) != 8) return 1;
    if (maskgi() != 2.5) return 2;
    if (g_i != 5) return 3;                       // the global is the one that was passed
    if (shadowparam(1.5) != 6) return 4;          // 1 + 2 + 3, the LOCAL `x`
    if (plainparam(6) != 10) return 5;            // 6 + 4, the PARAMETER `x`
    return 0;
}

// ---- 6. a global two SIBLING blocks shadow under two different types ----

i64 g_sib = 7;

// The pointee is read LEXICALLY, at the site, by the one oracle every pass
// shares (`tk_ty_scope_or_global`, teko_typeof.tk): INSIDE the second block
// `g_sib` is that block's own `f64`, so `ref g_sib` there is a legal
// `ref f64`; AFTER both blocks have closed no block declares the name, so the
// same `ref g_sib` is the `i64` global, and `bumpi` is what takes it --
// `bumpf(ref g_sib)` written there refuses instead, `teko: a value of type
// i64 does not convert to f64` (diagnostics.md). The body-wide SCAN the check
// used to take was blind to the site: it called the name "ambiguous" for the
// whole function and skipped its own check, while `tk_rc_call_args`
// (teko_rc.tk), reading the scope, answered the global and widened the
// ADDRESS into a float -- D51's own verifier finding, a segfault.
i64 sibcheck(i64 c) {
    if (c == 0) {
        i64 g_sib = 1;
        if (g_sib != 1) return 1;
    }
    if (c != 0) {
        f64 g_sib = 2.0;
        bumpf(ref g_sib);
        if (g_sib != 3.0) return 2;
    }
    bumpi(ref g_sib);                             // outside both: the i64 global
    return 0;
}

// ---- 7. a bare `&x` at a parameter that is NOT `ref`/`out` ----

// `tk_rc_call_args` (teko_rc.tk) never widens an N_ADDR -- D51's own segfault
// was D33's `scvtf` run on a pointer -- but WHICH check an address takes is
// the PARAMETER's question, not the argument's (D51, second pass): a
// `ref`/`out` parameter takes the identity rule over pointees, and any other
// parameter takes the ordinary compatibility rule every value takes. An
// untagged address is typed by nothing today (`tk_ty_of` answers -1 for it),
// so nothing is refused on it and this call stands; what the line proves is
// that it goes through the check at all instead of past it.
i64 peek(uptr p) { return ld64(p); }

i64 addrcheck() {
    i64 v = 11;
    if (peek(&v) != 11) return 1;
    return 0;
}

// ---- 5. regression: an enum global and `T?` over a reference global (D48) ----

enum Color { Red, Green, Blue }
Color g_color = Color.Blue;

class Cell {
    public i64 v;
    public Cell(i64 x) { v = x; }
}

Cell? g_cell;

i64 regressioncheck() {
    if (g_color != Color.Blue) return 1;
    if (g_cell.HasValue) return 2;
    g_cell = new Cell(3);
    if (!g_cell.HasValue) return 3;
    Cell got = g_cell.Value;
    if (got.v != 3) return 4;
    g_cell = null;                                // written back through the slot
    return 0;
}

i64 main() {
    i64 bad = refoutcheck();
    if (bad != 0) return 10 + bad;

    bad = overloadcheck();
    if (bad != 0) return 20 + bad;

    bad = delegcheck();
    if (bad != 0) return 30 + bad;

    bad = delegarrcheck();
    if (bad != 0) return 80 + bad;

    bad = paramscheck();
    if (bad != 0) return 40 + bad;

    bad = regressioncheck();
    if (bad != 0) return 50 + bad;

    bad = sibcheck(0);
    if (bad != 0) return 60 + bad;
    if (g_sib != 8) return 68;                    // the global, bumped as an `i64`
    bad = sibcheck(1);
    if (bad != 0) return 60 + bad;
    if (g_sib != 9) return 69;

    bad = addrcheck();
    if (bad != 0) return 70 + bad;

    return 42;
}
