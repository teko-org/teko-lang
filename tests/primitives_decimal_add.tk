// primitives_decimal_add.tk -- the fixture C3 wrote as a REFUSAL
// (`tests/refuse/decimal_add.tk`: "no operator `+` takes these operands") and
// C4 turns into a run case, unchanged below the header. `decimal` now carries
// twelve operator rows (teko_decimal.tk's `tk_dec_ops`), every one of them a
// call into `lib/decimal.tk`'s limb arithmetic, and the raw `+` the core would
// have emitted over sixteen bytes is still unreachable -- `tw_bin`
// (teko_wide.tk) `die`s on one and no fixture has ever made it fire.
//
// docs/specs/decimal.md § 5, § 12 "C4"; D77.
//
// expect-exit: 40

#include "decimal.tk"

i64 main() {
    decimal a = 1.5m;
    decimal b = 2.5m;
    decimal c = a + b;
    if (c != 4m) return 1;
    return 40;
}
