// expect-exit: 32
// D65, two roads Copilot asked about on #716:
//   - `LateH.scb(k, 2)` on a `static Op` of a type declared BELOW the call: the
//     forward static resolver builds the delegate `callp` over the arguments it
//     recorded at the site (`tk_fwd_resolve_static_one`, teko_access.tk);
//   - a bare `cb(5)` inside a method of a namespaced class whose FIELD `cb` is an
//     ARRAY of delegates keeps resolving to the namespace's free `cb`
//     (`tk_ns_deleg_field`, teko_ns.tk, excludes array fields as every other
//     delegate-call door does).
#include "../lib/rt.tk"
delegate i64 Op(i64 a, i64 b);
delegate i64 Un(i64 a);
i64 add(i64 a, i64 b) { return a + b; }
i64 go(i64 k) { return LateH.scb(k, 2); }
class LateH { public static Op scb; }
namespace geo {
    i64 cb(i64 x) { return x + 4; }
    class W { public Un cb[2]; public i64 go() { return cb(5); } }
}
i64 main() {
    LateH.scb = add;
    i64 y = go(20);                    // 22
    geo.W w = new geo.W;
    return y + LateH.scb(1, 0) + w.go();   // 22 + 1 + 9
}
