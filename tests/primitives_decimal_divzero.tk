// primitives_decimal_divzero.tk -- docs/specs/decimal.md § 5 and § 11: a
// division by zero is `panic("decimal division by zero")` -- `teko: decimal
// division by zero` on stderr and exit 70, the same `rt_panic` road every
// other run-time guard takes. `%` answers with the identical message, and
// `0m`, `0.00m` and `-0m` are all the same zero, which is what
// `tk_dec_is_zero` (lib/decimal.tk) asks before anything else.
//
// expect-exit: 70

#include "rt.tk"
#include "decimal.tk"

decimal zero() { return 0.00m; }

i64 main() {
    decimal q = 1m / zero();
    if (q == 0m) return 1;
    return 0;
}
