// primitives_i128_removf.tk -- N6b's own amendment beside D82's ruling 7:
// `i128.MinValue % -1i` panics rather than answer `0i` -- the quotient it
// would need (`MinValue / -1`) is the one value the width cannot hold, so
// `tk_w_smod` reads `tk_w_sdiv_ovf` unchanged before either operand's sign is
// touched (`lib/wide.tk`), the same check `tests/primitives_i128_divovf.tk`
// already exercises for `/`.
//
// `teko: an integer division overflowed`, exit 70 -- the divisor is behind a
// call the folder cannot see through, so this is measured at RUN time, not
// refused at compile time.
//
// expect-exit: 70

#include "rt.tk"
#include "wide.tk"

i128 negone() { return 0i - 1i; }

i64 main() {
    i128 mn = (0i - 170141183460469231731687303715884105727i) - 1i;
    i128 r = mn % negone();
    // unreachable: the panic above exits 70
    if (r == mn) return 1;
    return 42;
}
