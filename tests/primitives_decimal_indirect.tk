// primitives_decimal_indirect.tk -- C3, D74: a `decimal` RETURNED through an
// INDIRECT call -- a delegate (D57) and an interface method -- comes back
// through the same return buffer a direct call uses. The first draft of
// `tw_callp` (teko_wide.tk) skipped the copy-out and read the depth's own
// uninitialised slot: stack-garbage-dependent, which is why the value below is
// checked twice, through both roads, with a local in between.
//
// expect-exit: 42

#include "../lib/rt.tk"
#include "../lib/decimal.tk"

delegate decimal Op0();
delegate decimal Op1(decimal a);

interface Giver { decimal Get(); }
class Seven : Giver { public decimal Get() { return 7.5m; } }

decimal give() { return 7.5m; }
decimal same(decimal a) { return a; }

i64 lo(decimal d) { ptr p = &d; return ld64(p); }

i64 main() {
    Op0 o = give;
    decimal r = o();
    i64 x = 1;
    if (lo(r) != lo(give())) return 10 + x;
    Op1 s = same;
    decimal t = s(r);
    if (lo(t) != lo(r)) return 20;
    Giver g = new Seven();
    decimal u = g.Get();
    if (lo(u) != lo(r)) return 30;
    return 42;
}
