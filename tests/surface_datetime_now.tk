// surface_datetime_now.tk -- `DateTime.Now`/`UtcNow`/`Today` and
// `DateTimeOffset.Now`/`UtcNow` (docs/specs/datetime.md § 8, crumb C6;
// docs/specs/datetime-extras.md's own N5 rows; D90). A wall clock cannot be
// asserted against a literal value -- what is asserted here is what STAYS
// TRUE regardless of the instant the fixture happens to run at, and each
// assertion says why it is the stable one:
//
//   the year is >= 2026        this file cannot run before it was written
//   two reads never go BACKWARDS   a clock is monotone non-decreasing even
//                               though ticks are read twice a few
//                               instructions apart (never EQUAL is not
//                               asserted: two reads can land in the same
//                               100 ns tick on a fast host)
//   `UtcNow.Kind`               `DateTimeKind.Utc`, C#'s own, always
//   `Now.Kind`                  `DateTimeKind.Local`, C#'s own spelling --
//                               D90's ruling is that its VALUE is the same
//                               clock read `UtcNow` answers, teko having no
//                               time-zone database, so `Now` and `UtcNow`
//                               read the SAME instant under two `Kind`s
//   `Today`'s time of day       always zero: `Today` is `Now` truncated to
//                               midnight, whatever the wall clock answers
//   `Today.Kind`                `DateTimeKind.Local`, `Now`'s own
//   `DateTimeOffset.UtcNow.Offset`   always `TimeSpan.Zero`: the `+0` half
//                               of a `DateTimeOffset` is always UTC
//   `DateTimeOffset.Now.Offset`      also `TimeSpan.Zero` here, D90's same
//                               ruling carried to the wide type
//   the round trip                `DateTimeOffset.UtcNow.UtcDateTime` and
//                               `DateTime.UtcNow` never go backwards of one
//                               another either, for the reason the first
//                               monotonicity check gives
//
// expect-exit: 42

#include "../lib/time.tk"

i64 main() {
    // ---- `DateTime.UtcNow` ----
    DateTime u1 = DateTime.UtcNow;
    if (u1.Year < 2026) return 1;
    if (u1.Kind != DateTimeKind.Utc) return 2;

    DateTime u2 = DateTime.UtcNow;
    if (u2.Ticks < u1.Ticks) return 3;               // monotone, never backwards

    // ---- `DateTime.Now` ----
    DateTime n1 = DateTime.Now;
    if (n1.Kind != DateTimeKind.Local) return 4;
    if (n1.Ticks < u1.Ticks) return 5;                // same clock, read after u1

    // ---- `DateTime.Today` ----
    DateTime t = DateTime.Today;
    if (t.Kind != DateTimeKind.Local) return 6;
    if (t.TimeOfDay.Ticks != 0) return 7;             // truncated to midnight
    if (t.Year != n1.Year) return 8;                  // the same day `Now` is in
    if (t.Month != n1.Month) return 9;
    if (t.Day != n1.Day) return 10;
    if (t.Date != t) return 11;                       // already at midnight

    // ---- `DateTimeOffset.UtcNow` ----
    DateTimeOffset o1 = DateTimeOffset.UtcNow;
    if (o1.Offset != TimeSpan.Zero) return 12;         // the `+0` half is always UTC
    if (o1.TotalOffsetMinutes != 0) return 13;
    if (o1.UtcDateTime.Kind != DateTimeKind.Utc) return 14;
    if (o1.UtcDateTime.Ticks < u1.Ticks) return 15;    // read after `u1`

    // ---- `DateTimeOffset.Now` ----
    DateTimeOffset o2 = DateTimeOffset.Now;
    if (o2.Offset != TimeSpan.Zero) return 16;         // D90: no time-zone database
    if (o2.UtcDateTime.Ticks < o1.UtcDateTime.Ticks) return 17;

    // ---- the round trip ----
    DateTime u3 = DateTime.UtcNow;
    if (u3.Ticks < o2.UtcDateTime.Ticks) return 18;

    return 42;
}
