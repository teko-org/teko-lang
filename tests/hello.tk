// hello.tk -- the vertical slice of the port: everything below except `bool`
// is the mc core, unchanged (DECISION_LOG.md D3 -- adopt the core's own
// fn/type/return, teach only the delta). `bool` is the one primitive teko
// adds that the core does not already have; teko.tk aliases it to TY_U8
// (teko_type.tk), so a program that uses it is proof the first hook taught
// actually fires.
//
// expect-exit: 42

bool is_the_answer(i64 x) {
    return x == 42;
}

i64 main() {
    if (is_the_answer(42)) return 42;
    return 1;
}
