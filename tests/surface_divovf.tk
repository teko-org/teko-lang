// surface_divovf.tk -- D82: `MinValue / -1` panics, signed only, the one
// quotient the machine cannot hold. Before this crumb x86_64's `idiv`
// trapped on it (SIGFPE) while aarch64's `sdiv` answered `MinValue` straight
// back in silence -- C#'s own `OverflowException`, on both its ISAs, is what
// this project now gives everywhere too (D3).
//
// The dividend is `i64.MinValue`, written as C# itself has to (there is no
// literal for it: the positive magnitude is one past `i64`'s own ceiling),
// and the divisor is a PARAMETER so the guard cannot fold it away.
//
// `teko: an integer division overflowed`, exit 70.
//
// expect-exit: 70

#include "../lib/rt.tk"

i64 min() { return (0 - 9223372036854775807) - 1; }

i64 divby(i64 a, i64 m) {
    return a / m;
}

i64 main() {
    i64 q = divby(min(), 0 - 1);
    // unreachable: the panic above exits 70
    if (q == min()) return 1;
    return 42;
}
