// primitives_str.tk -- `str` (docs/reference/types.md): teko's
// `str` is the same `uptr` mc's own C-flavoured strings already are, so
// `tk_str_len`/`tk_str_slice` (lib/rt.tk) are ordinary functions over it --
// `tk_str_slice` is pointer arithmetic only, a view with zero copy.
//
// expect-exit: 42

#include "../lib/rt.tk"

i64 main() {
    str s = "hi";
    i64 a = tk_str_len(s);
    str tail = tk_str_slice(s, 1);
    i64 b = tk_str_len(tail);
    return a * 10 + b * 10 + 12;
}
