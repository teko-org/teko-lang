// surface_const.tk -- `const` as sugar over the mc core's own `#define`
// (D218, entrega 5's own `const` crumb, teko_const.tk): a top-level const
// (bare, used in an expression, as a fixed array's size and as a generic's
// own `const` bound; namespace-qualified and namespace-bare) and a
// class/struct member const (`Nome.MAX` from outside, bare -- public and
// private -- from inside), no slot in either shape.
//
// expect-exit: 42

#include "../lib/rt.tk"

const i64 BASE = 30;
const i64 SIZE = 4;

namespace geo {
    const i64 N = 5;

    i64 doubled() {
        return N + N;
    }
}

class Box<T, const N: i64> {
    T items[N];

    public i64 cap() {
        return N;
    }
}

class Counter {
    public const i64 MAX = 4;
    private const i64 STEP = 2;

    public i64 sum() {
        return MAX + STEP;
    }
}

i64 arr[SIZE];

i64 main() {
    if (BASE != 30) return 2;

    Box<i64, SIZE> b = new Box<i64, SIZE>;
    if (b.cap() != SIZE) return 3;

    if (geo.N != 5) return 4;
    if (geo.doubled() != 10) return 5;

    if (Counter.MAX != 4) return 6;

    Counter c = new Counter;
    if (c.sum() != 6) return 7;

    return 42;
}
