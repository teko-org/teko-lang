// primitives_i128_udec_neg.tk -- N6b-2 of docs/specs/small-ints.md (§ 8;
// D84): `(u128) d` panics on a NEGATIVE `decimal` whose truncated magnitude
// is still nonzero -- C# throws `OverflowException` reading any negative
// decimal into an unsigned integer type. `-0.5m` truncates to 0 and is fine
// (`primitives_i128_convert.tk` asserts the positive half of that rule,
// `docs/reference/not-yet.md`'s neighbour list does not need a THIRD
// fixture for it); `-1m` does not, which is the one this fixture measures.
//
// The value is behind a call the folder cannot see through, matching every
// other panic fixture this page has.
//
// `teko: decimal overflow`, exit 70.
//
// expect-exit: 70

#include "rt.tk"
#include "wide.tk"
#include "decimal.tk"

decimal negone() { return 0m - 1m; }

i64 main() {
    decimal d = negone();
    u128 u = (u128) d;
    // unreachable: the panic above exits 70
    if (u == 0u) return 1;
    return 42;
}
