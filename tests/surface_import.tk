// surface_import.tk -- `import A.B;` (entrega 5, crumb N3; plano-ngen-
// entrega4.md §31 items 11-13). teko_ns.tk's `tk_import`/`tk_ns_path_of` are
// the module.
//
// What each part of `main` proves, in order:
//
//   1. `import parts.geo;`, TWICE -- the once-only contract the core's own
//      `lex_seen` already gives a plain `#include`, and `import`'s own
//      implicit `using parts.geo;`;
//   2. `Circle` -- no modifier, `internal` by default (D220) -- reached from
//      THIS file because it sits inside the same project the imported file
//      does;
//   3. `parts.geo.Circle` / `parts.geo.twice(4)` -- the qualified forms, the
//      same segment-walk machinery a `namespace` block already gives a
//      qualified type and a qualified call (N1/N2);
//   4. `twice(3)` -- bare, resolved through the implicit `using`;
//   5. `&twice` and `&parts.geo.twice`, each passed to `callp` -- a
//      namespaced free function's own address, bare (sweep 2's new `N_ADDR`
//      rewrite) and qualified (`tk_ns_seg_expr`'s new non-call branch),
//      closing the N2 verifier's debt.
//
// expect-exit: 42

#include "../lib/rt.tk"

import parts.geo;
import parts.geo;

i64 main() {
    Circle c = new Circle();
    c.r = 3;
    if (c.area() != 9) return 1;

    parts.geo.Circle c2 = new parts.geo.Circle();
    c2.r = 4;
    if (c2.area() != 16) return 2;

    if (twice(3) != 6) return 3;
    if (parts.geo.twice(4) != 8) return 4;

    uptr p = &twice;
    if (callp(p, 5) != 10) return 5;

    if (callp(&parts.geo.twice, 6) != 12) return 6;

    return 42;
}
