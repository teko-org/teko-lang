// surface_import.tk -- `import A.B;` (teko_ns.tk's `tk_import`/
// `tk_ns_path_of`).
//
// What each part of `main` proves, in order:
//
//   1. `import parts.geo;`, twice -- the once-only contract a plain
//      `#include` already gives, and `import`'s own implicit
//      `using parts.geo;`;
//   2. `Circle` -- no modifier, `internal` by default -- reached from
//      this file because it sits inside the same project the imported
//      file does;
//   3. `parts.geo.Circle` / `parts.geo.twice(4)` -- the qualified forms,
//      the same segment-walk machinery a `namespace` block already gives
//      a qualified type and a qualified call;
//   4. `twice(3)` -- bare, resolved through the implicit `using`;
//   5. `&twice` and `&parts.geo.twice`, each passed to `callp` -- a
//      namespaced free function's own address, bare and qualified.
//
// expect-exit: 42

#include "../lib/rt.tk"

import parts.geo;
import parts.geo;

i64 main() {
    Circle c = new Circle();
    c.r = 3;
    if (c.area() != 9) return 1;

    parts.geo.Circle c2 = new parts.geo.Circle();
    c2.r = 4;
    if (c2.area() != 16) return 2;

    if (twice(3) != 6) return 3;
    if (parts.geo.twice(4) != 8) return 4;

    uptr p = &twice;
    if (callp(p, 5) != 10) return 5;

    if (callp(&parts.geo.twice, 6) != 12) return 6;

    return 42;
}
