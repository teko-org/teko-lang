// surface_divlazy_value.tk -- D82 ruling 9 (the PR's second review): an
// `&&`/`||` whose right operand carries a guarded division is lowered into a
// branch, and the temporary that branch writes holds the operator's OWN
// value -- a normalized truth value, never the right operand itself.
// `n != 0 && a / n` is 1, not the quotient (the first draft of the lowering
// assigned `a / n` raw and answered 3 here).
//
// expect-exit: 42

#include "../lib/rt.tk"

i64 main() {
    i64 n = 2;
    i64 a = 7;
    i64 r = (n != 0 && a / n);
    if (r != 1) return 10;
    i64 s = (n == 0 || a / n);
    if (s != 1) return 11;
    i64 z = 0;
    i64 t = (z != 0 && a / z);
    if (t != 0) return 12;
    i64 u = (n != 0 && a / n - 3);       // 7 / 2 - 3 == 0: false
    if (u != 0) return 13;
    return 42;
}
