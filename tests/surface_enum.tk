// surface_enum.tk -- `enum` as C#'s own: the type, the members (implicit and
// explicit values, the default underlying `i32`, an explicit `: u8` and an
// explicit signed `: i16`), the six comparisons, the bitwise trio plus unary
// `~`, both explicit conversions, an enum global/field/array element/
// parameter/return, a duplicate value used as an alias, a `switch` with a
// fallthrough pair of case labels and a `default`, and overload resolution
// on an enum member (docs/specs/enum.md N2a; the overload half is the fix
// for `teko-org/teko-lang#685`'s review, `tk_ov_args_fit`/`tk_pm_elem_fits`
// treating every `N_INT` as the untyped integer literal without asking
// whether its own `nd_type` names a row of the type table first).
//
// expect-exit: 42

#include "../lib/rt.tk"

enum Color { Red, Green, Blue }                  // default underlying: i32
enum Level : u8 { Low = 10, Mid, High }          // 10, 11, 12
enum Signed : i16 { Neg = 0 - 100, Zero = 0, Pos = 100 }
enum Perm { None = 0, Read = 1, Write = 2, All = 3, Alias = 3 }   // Alias aliases All
enum Other { X }                                 // a second, unrelated enum

Color g_color = Color.Blue;                      // a global of enum type

class Box {
    public Signed s;                             // a field of a SIGNED narrow enum
}

// a parameter and a return of enum type; the switch reads a LOCAL copy of
// the parameter (not the parameter itself), which is what the parse-time
// oracle `tk_switch_stmt` leans on can already see (docs/specs/enum.md's
// own not-yet row on this)
i64 describe(Color c) {
    Color d = c;
    i64 r = 0;
    switch (d) {
        case Color.Red:
        case Color.Green:
            r = 1;
            break;
        case Color.Blue:
            r = 2;
            break;
        default:
            r = 3;
            break;
    }
    return r;
}

// overload resolution: an enum member is an `N_INT` (`teko_enum.tk`'s own
// declaration retags the folded node's type to the enum's row, D39), and it
// is judged as a TYPED value -- never the untyped integer literal every
// other `N_INT` is, past the check whether `nd_type` names a row of the type
// table (`tk_struct_by_ty(nd_type(a)) >= 0`).
i64 pick_ci(Color c) { return 100; }             // f(Color) / f(i64): `Color.Red`
i64 pick_ci(i64 n)   { return 200; }             // picks Color, `1` still picks i64

i64 pick_co(Color c) { return 300; }             // f(Color) / f(Other): arity ties,
i64 pick_co(Other o)  { return 400; }            // the TYPE is what has to decide

i64 pick_ar(Color c)          { return 500; }    // f(Color) / f(Color, i64): arity
i64 pick_ar(Color c, i64 n)   { return 600; }    // alone decides, the type never in doubt

i64 sum_colors(params Color[] cs) {              // `tk_pm_elem_fits`'s own rule
    i64 s = 0;
    i64 i = 0;
    while (i < cs.Length) {
        Color v = cs[i];                         // a cast binds tighter than `[`, the
        s = s + (i64) v;                         // same pre-existing ambiguity as `.` (D2)
        i = i + 1;
    }
    return s;
}

i64 main() {
    // implicit values, and the default underlying type
    if (Color.Red != (Color) 0) return 1;
    if (Color.Green != (Color) 1) return 2;
    if (Color.Blue != (Color) 2) return 3;

    // explicit values, u8 underlying
    if ((i64) Level.Low != 10) return 4;
    if ((i64) Level.Mid != 11) return 5;
    if ((i64) Level.High != 12) return 6;

    // the global
    if (g_color != Color.Blue) return 7;

    // the six comparisons -- `rc`/`gc`/`bc` are plain locals rather than
    // `Color.Red`/`Color.Green`/`Color.Blue` spelled directly after `!(`:
    // `mc`'s own cast-detection, right after a unary prefix, does not
    // backtrack past a type word followed by `.` (a pre-existing core
    // ambiguity, reproduced the same way with a plain class const in
    // parens -- not this crumb's to fix, D2)
    Color c = Color.Green;
    Color rc = Color.Red;
    Color gc = Color.Green;
    Color bc = Color.Blue;
    if (c != Color.Green) return 8;
    if (c == Color.Red) return 9;
    if (!(rc < gc)) return 10;
    if (gc <= rc) return 11;
    if (!(bc > gc)) return 12;
    if (gc >= bc) return 13;

    // a duplicate value used as an alias
    if (Perm.Alias != Perm.All) return 14;

    // flags: | & ^ ~
    Perm p = Perm.Read | Perm.Write;
    if (p != Perm.All) return 15;
    if ((p & Perm.Read) == Perm.None) return 16;
    if ((p ^ Perm.All) != Perm.None) return 17;
    if (~(~Perm.None) != Perm.None) return 18;

    // a field of a SIGNED narrow (i16) underlying enum -- sign preserved
    // through the struct field's own indirect load (tk_ld, N0/D38)
    Box b = new Box();
    b.s = Signed.Neg;
    if (b.s != Signed.Neg) return 19;
    if ((i64) (b.s) != 0 - 100) return 20;        // the negative value round-trips --
                                                    // parenthesized: a cast binds tighter
                                                    // than `.` in this grammar, a pre-
                                                    // existing ambiguity, not this crumb's
    if (b.s >= Signed.Zero) return 21;             // a signed comparison, not unsigned

    // an enum array element
    Color tbl[3];
    tbl[0] = Color.Red;
    tbl[1] = Color.Green;
    tbl[2] = Color.Blue;
    if (tbl[0] != Color.Red) return 22;
    if (tbl[2] != Color.Blue) return 23;

    // a switch with a fallthrough pair of case labels and a default,
    // through a parameter and a return of enum type
    if (describe(Color.Red) != 1) return 24;
    if (describe(Color.Green) != 1) return 25;
    if (describe(Color.Blue) != 2) return 26;

    // overload resolution on an enum member -- the review's own defect 1
    if (pick_ci(Color.Red) != 100) return 27;      // Color.Red picks f(Color), not f(i64)
    if (pick_ci(1) != 200) return 28;               // a plain literal still picks f(i64)
    if (pick_co(Color.Red) != 300) return 29;       // f(Color) over f(Other), same arity
    if (pick_ar(Color.Red) != 500) return 30;       // arity alone decides between the two
    if (pick_ar(Color.Red, 7) != 600) return 31;

    // `params Color[]` with enum members (`tk_pm_elem_fits`)
    if (sum_colors(Color.Red, Color.Green, Color.Blue) != 3) return 32;

    return 42;
}
