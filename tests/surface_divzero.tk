// surface_divzero.tk -- D82: `/` over a plain integer refuses a zero
// divisor at RUN time, on every leg alike. Before this crumb the raw
// `sdiv`/`idiv` the core emits answered three different things depending on
// which CI leg ran it: aarch64's `sdiv` answered 0 in silence, x86_64's
// `idiv` trapped (SIGFPE, exit 136 on Linux); C#'s own `DivideByZeroException`
// is the one answer this project now gives everywhere (D3).
//
// The divisor is a PARAMETER -- not a literal -- so `teko_ternary.tk`'s own
// `tk_div_guard` cannot fold it away; a literal divisor (`tests/
// surface_divguard.tk`) needs no guard at all and is left exactly as the
// core wrote it.
//
// `teko: division by zero`, exit 70.
//
// expect-exit: 70

#include "../lib/rt.tk"

i64 divby(i64 a, i64 n) {
    return a / n;
}

i64 main() {
    i64 q = divby(7, 0);
    // unreachable: the panic above exits 70
    if (q == 0) return 1;
    return 42;
}
