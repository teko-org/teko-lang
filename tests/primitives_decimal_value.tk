// primitives_decimal_value.tk -- C3 of docs/specs/decimal.md (§ 1, § 11; D74):
// a sixteen-byte value MOVES, on every one of the five roads, and its raw bytes
// read back exactly the layout § 1 fixes. There is no arithmetic here and no
// comparison: C3 carries neither, and every value is judged by the two halves
// its own frame slot holds.
//
// `&d` on a local or on a parameter of `decimal` type is the address of its own
// sixteen-byte frame slot -- the core's own `MTASK_LOCAL_ADDR`, untouched by
// the wide machine -- so `lo_of`/`hi_of` need no intrinsic and no accessor to
// reach the halves.
//
// expect-exit: 42

#include "rt.tk"
#include "decimal.tk"

// ---- the layout (docs/specs/decimal.md § 1) ----
//   +0  bits  0..63   the low 64 bits of the 96-bit mantissa
//   +8  bits  0..31   the high 32 bits of the mantissa
//   +8  bits 32..39   the scale, 0..28
//   +8  bit  63       the sign
i64 lo_of(decimal d) { ptr p = &d; return ld64(p); }
i64 hi_of(decimal d) { ptr p = &d; return ld64(p + 8); }

i64 scale_of(decimal d) { return (hi_of(d) >> 32) & 0xff; }
i64 mant_hi_of(decimal d) { return hi_of(d) & 0xffffffff; }

// a global, and a fixed global array
decimal g;
decimal garr[3];

// a field of a class and a field of a struct
class Box {
    public decimal amount;
    public i64 tag;
}

struct Pair {
    public decimal left;
    public i64 n;
}

// a parameter, and a return
decimal echo(decimal d) { return d; }

// a `decimal` and an `f64` in one call: the wide argument takes an INTEGER
// argument position (it is a pointer) and the float machine's own accounting is
// untouched, which is the claim § 1 makes about mixing the two.
decimal pick(i64 k, decimal d, f64 x, decimal e) {
    if (k == 0) return d;
    if (x != 0.5) return d;
    return e;
}

// the return buffer under recursion: the call site copies the sixteen bytes out
// IMMEDIATELY after the branch, so a nested call can never find them stale
decimal countdown(i64 n, decimal d) {
    if (n == 0) return d;
    return countdown(n - 1, d);
}

decimal deeper(i64 n) {
    if (n == 0) return 1.25m;
    return echo(deeper(n - 1));
}

i64 main() {
    // ---- a literal through a local, and the layout it wrote
    decimal a = 1.5m;
    if (lo_of(a) != 15) return 1;
    if (scale_of(a) != 1) return 2;
    if (mant_hi_of(a) != 0) return 3;
    if ((hi_of(a) >> 63) & 1) return 4;           // a literal is never negative

    decimal one = 1M;                              // C#'s suffix, case-insensitive
    if (lo_of(one) != 1) return 5;
    if (hi_of(one) != 0) return 6;

    decimal z = 0.0000000000000000000000000001m;   // 28 places, the maximum scale
    if (lo_of(z) != 1) return 7;
    if (scale_of(z) != 28) return 8;

    decimal big = 79228162514264337593543950335m;  // 2^96 - 1, the whole mantissa
    if (lo_of(big) != 0 - 1) return 9;
    if (mant_hi_of(big) != 0xffffffff) return 10;
    if (scale_of(big) != 0) return 11;

    decimal ex = 1.5e3m;                           // the exponent shifts the scale
    if (lo_of(ex) != 1500) return 12;
    if (scale_of(ex) != 0) return 13;

    decimal exn = 15e-2m;
    if (lo_of(exn) != 15) return 14;
    if (scale_of(exn) != 2) return 15;

    // ---- a local into a local
    decimal b = a;
    if (lo_of(b) != 15) return 16;
    if (hi_of(b) != hi_of(a)) return 17;

    // ---- a parameter and a return
    decimal c = echo(12.34m);
    if (lo_of(c) != 1234) return 18;
    if (scale_of(c) != 2) return 19;

    // ---- a global
    g = 9.99m;
    if (lo_of(g) != 999) return 20;
    decimal fromg = g;
    if (lo_of(fromg) != 999) return 21;
    if (scale_of(fromg) != 2) return 22;

    // ---- an element of a `decimal[]`
    garr[0] = 0.25m;
    garr[2] = 7.5m;
    if (lo_of(garr[0]) != 25) return 23;
    if (scale_of(garr[0]) != 2) return 24;
    if (lo_of(garr[1]) != 0) return 25;            // never written: still zero
    if (lo_of(garr[2]) != 75) return 26;

    decimal larr[2];
    larr[1] = 3.5m;
    if (lo_of(larr[1]) != 35) return 27;

    decimal[] harr = new decimal[3];                // the heap array, the same road
    harr[1] = 6.25m;
    if (lo_of(harr[1]) != 625) return 28;
    if (scale_of(harr[1]) != 2) return 29;
    if (harr.Length != 3) return 30;

    // ---- a field, of a class and of a struct
    Box box = new Box();
    box.amount = 2.75m;
    box.tag = 7;
    if (lo_of(box.amount) != 275) return 31;
    if (scale_of(box.amount) != 2) return 32;
    if (box.tag != 7) return 33;                    // the neighbour field is intact

    Pair pr = new Pair();
    pr.left = 4.125m;
    pr.n = 3;
    if (lo_of(pr.left) != 4125) return 34;
    if (scale_of(pr.left) != 3) return 35;
    if (pr.n != 3) return 36;

    // ---- the two copy helpers, over a raw address (docs/specs/decimal.md § 1)
    decimal cell = 0m;
    tk_dec_st(&cell, 8.125m);
    if (lo_of(cell) != 8125) return 37;
    decimal back = tk_dec_ld(&cell);
    if (lo_of(back) != 8125) return 38;
    if (hi_of(back) != hi_of(cell)) return 39;

    // ---- a `decimal` beside an `f64` and an `i64` in one call
    decimal mixed = pick(1, 1.5m, 0.5, 2.5m);
    if (lo_of(mixed) != 25) return 40;
    if (lo_of(pick(0, 1.5m, 0.5, 2.5m)) != 15) return 41;

    // ---- the return buffer, under recursion and under nesting
    if (lo_of(countdown(8, 5.5m)) != 55) return 47;   // 42 is this fixture's own success code
    if (scale_of(countdown(8, 5.5m)) != 1) return 43;
    if (lo_of(deeper(6)) != 125) return 44;
    if (scale_of(deeper(6)) != 2) return 45;

    // two wide returns alive in one expression: each is copied out at its own
    // call site, so the second cannot overwrite the first
    if (lo_of(echo(countdown(2, 1.5m))) != 15) return 46;

    return 42;
}
