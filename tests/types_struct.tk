// types_struct.tk -- `struct`: the declaration, the `#define` of every
// field's offset, `new` and the C-like `p.field` / `p.field = e` that
// teko_struct.tk/teko_expr.tk teach. The three fields are deliberately
// of three different widths, so the offsets below are the natural
// alignment (u8 at 0, i64 at 8 and not at 1, u32 at 16) and not a
// coincidence; `Line` proves a field can be another struct and that
// `l.a.x` chains through it.
//
// The members carry C#'s modifiers, and `made`/`tally` are the static
// pair: the field is one global of its own, reached as `Point.made`,
// and the method takes no receiver, so it is called as `Point.tally()`
// and reads the static field by its bare name. POINT_SIZE below is what
// proves a static field is no part of the object -- it is 24 with the
// field written and 24 without it, and `y` still sits at 16.
//
// expect-exit: 42

#include "../lib/rt.tk"

struct Point {
    public u8  tag;
    public i64 x;
    public u32 y;

    public static i64 made;

    public static i64 tally() {
        return made;
    }
}

struct Line {
    public Point a;
    public i64   len;
}

i64 main() {
    if (POINT_TAG != 0) return 1;
    if (POINT_X != 8) return 2;
    if (POINT_Y != 16) return 3;
    if (POINT_SIZE != 24) return 4;              // the static field takes none of it
    if (LINE_LEN != 8) return 5;

    Point p = new Point;
    if (p.x != 0) return 6;                  // rt_alloc hands out zeroed bytes
    p.tag = 2;
    p.x = 30;
    p.y = 10;

    if (Point.made != 0) return 7;               // a global, zeroed like any other
    Point.made = 4;
    if (Point.tally() != 4) return 8;            // no receiver: the bare `made`
    Point.made = Point.made + 1;
    if (Point.tally() != 5) return 9;

    Line l = new Line();
    l.a = p;
    l.len = 0;
    return l.a.x + l.a.y + l.a.tag + l.len - Point.tally() + 5;
}
