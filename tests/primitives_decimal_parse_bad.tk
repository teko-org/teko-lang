// primitives_decimal_parse_bad.tk -- docs/specs/decimal.md § 7, § 11 (C5,
// D79): `decimal.Parse` panics on a string that is not a decimal, which is
// C#'s own `Parse` -- an exception, never a sentinel value no caller could
// tell from a parsed one. `TryParse` is the other half and never panics
// (`tests/primitives_decimal_text.tk`). `rt_panic` exits 70, the same abort
// every other guard in this port takes.
//
// expect-exit: 70

#include "rt.tk"
#include "decimal.tk"

i64 main() {
    decimal d = decimal.Parse("x");
    if (d == 0m) return 1;
    return 42;
}
