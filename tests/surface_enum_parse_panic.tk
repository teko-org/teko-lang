// surface_enum_parse_panic.tk -- `Color.Parse("Nope")` panics (exit 70) on a
// name no member spells, C#'s own `FormatException` road, this language's
// own answer to it since teko has no exceptions (docs/specs/enum.md § 6,
// N2b, D47).
//
// expect-exit: 70

#include "../lib/rt.tk"

enum Color { Red, Green, Blue }

i64 main() {
    Color c = Color.Parse("Nope");
    return (i64) c;
}
