// primitives_decimal_cast.tk -- the fixture C3 wrote as a REFUSAL
// (`tests/refuse/decimal_cast.tk`: "a decimal does not cast yet") and C4 turns
// into a run case, unchanged below the header. `(i64) a` is no longer a cast
// at all: teko_prim.tk's own conversion table rewrites it into
// `(i64) tk_dec_to_i64(a)`, whose remaining cast is the compiler's own
// identity and reaches no `MTASK_CAST` over sixteen bytes.
//
// docs/specs/decimal.md § 6, § 12 "C4"; D77.
//
// expect-exit: 2

#include "decimal.tk"

i64 main() {
    decimal a = 2.5m;
    i64 n = (i64) a;
    return n;
}
