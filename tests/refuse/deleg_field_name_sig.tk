// deleg_field_name_sig.tk -- a bare function name stored into a FIELD of
// delegate type is wrapped like every other delegate slot (D62), so it is
// judged like one too: a function whose signature is not the delegate's is
// refused in the delegate's own words, the very sentence `Op cb = wrong;`
// already gives one slot over (`tk_deleg_check_sig`, teko_deleg.tk).
//
// expect-refuse: teko: wrong does not match the delegate Op(i64)
// expect-refuse-line: 18

delegate i64 Op(i64 x);

i64 wrong(i64 a, i64 b) { return a + b; }

class H { public Op cb; }

i64 main() {
    H h = new H;
    h.cb = wrong;
    return 0;
}
