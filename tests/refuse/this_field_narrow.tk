// this_field_narrow.tk -- an instance field store through `this` narrows
// the same way (D50).
//
// expect-refuse: teko: a value of type f64 does not convert to i64
// expect-refuse-line: 10
#include "../../lib/rt.tk"

class Box {
    public i64 v;
    public i64 set() { this.v = 1.5; return 42; }
}
i64 main() { Box b = new Box(); return b.set(); }
