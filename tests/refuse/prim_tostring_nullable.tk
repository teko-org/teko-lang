// prim_tostring_nullable.tk -- D98: a `T?` is not the scalar `T`. The box is
// read through `.Value` (Q1b) and `.ToString()` on the nullable itself is not
// taught.
//
// expect-refuse: teko: unknown member of i64?: ToString
// expect-refuse-line: 12
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    i64? x = 5;
    string s = x.ToString();
    return 0;
}
