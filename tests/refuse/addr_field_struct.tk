// addr_field_struct.tk -- D104: `&s.n` on a STRUCT local. A struct local is
// the buffer itself, so `(&s) + OFF` happens to be the right ADDRESS -- and
// the field load the deferred row builds on top of it is still one
// dereference too many: `ld64(&s + 8)` read the field and `ld64` of that
// answered 0 at `f81e0217`, against a field worth 42. At offset ZERO the same
// program answers 42 by coincidence, which is exactly the kind of accident a
// refusal is for.
//
// expect-refuse: teko: the address of a field is not taught yet; pass it as `ref` or `out`: n
// expect-refuse-line: 19
#include "../../lib/rt.tk"

struct S { public i64 a; public i64 n; }

i64 main() {
    S s = new S();
    s.a = 1;
    s.n = 42;
    return ld64(&s.n);
}
