// this_compound_assign.tk -- the compound spellings are the same write through a
// different word. `this += o`, `this -= o`, `this++` and `this--` all compiled
// SILENTLY before D102, exactly as `this = o;` did and for the same reason: the
// receiver parameter reads `uptr`, so no reference count is asked for. One guard
// covers the whole set; refusing only `=` would leave the siblings wrong.
//
// expect-refuse: teko: `this` is read-only
// expect-refuse-line: 13
#include "../../lib/rt.tk"

class C {
    public i64 v;
    public C() { v = 0; this++; }
}
i64 main() {
    C c = new C();
    return c.v;
}
