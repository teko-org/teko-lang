// thiscall_ref_missing.tk -- thiscall_ref_extra.tk's mirror on the same
// unqualified road: a value where the method declares `ref f64`, written
// through by the callee (measured on `d0fbe9a4`: SIGSEGV). D57, Copilot's
// second pass.
//
// expect-refuse: teko: argument 2 needs `ref` at the call site
// expect-refuse-line: 16
#include "../../lib/rt.tk"

class Box {
    public i64 w;
    public Box(i64 v) { w = v; }
    public virtual i64 bump(ref f64 d) { d = 2.0; return 42; }
    public virtual i64 mine() {
        f64 x = 1.0;
        return bump(x);
    }
}

i64 main() {
    Box b = new Box(9);
    return b.mine();
}
