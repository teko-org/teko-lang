// ref_field_array_local.tk -- D104: a FIXED-ARRAY local shadows an object, and
// `ref h.n` on it is refused rather than written into the array's storage.
//
// A fixed-array local is in NEITHER table `tk_ref_addr` used to read: it never
// reaches `tk_slv_add` (`tk_on_stmt` returns first for a declaration with a
// length) and it is no object for `tk_local_find`; it lives in `tk_arr_find`'s
// own scoped table (teko_array.tk). Without that third question the inner
// `i64 h[2]` here was invisible and the enclosing `H h` PARAMETER answered, so
// `h + OFF` was built against the ARRAY's storage -- accepted and silently
// wrong, found by the Copilot review of #770. `f81e0217` refuses this program
// because the parameter road did not exist there at all.
//
// expect-refuse: teko: not an object of a known type: h
// expect-refuse-line: 25
#include "../../lib/rt.tk"

class H { public i64 n; public H() { n = 41; } }

void bump(ref i64 v) { v = v + 1; }

i64 f(H h) {
    {
        i64 h[2];
        h[0] = 5;
        bump(ref h.n);
    }
    return 7;
}

i64 main() {
    H a = new H();
    return f(a);
}
