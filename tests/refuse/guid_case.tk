// guid_case.tk -- docs/specs/guid.md § 2: a `switch` label is a constant
// expression the folder can evaluate, and sixteen bytes are not one -- exactly
// as for `decimal` (teko_switch.tk).
//
// expect-refuse: teko: a case label must be a constant expression
// expect-refuse-line: 13

#include "guid.tk"

i64 main() {
    Guid g = Guid.Empty;
    switch (g) {
        case Guid.Empty:
            return 1;
    }
    return 0;
}
