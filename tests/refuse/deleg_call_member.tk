// deleg_call_member.tk -- a call through a delegate slot is typed by the
// slot's row (D61), so a member that row does not declare is refused BY THAT
// TYPE, exactly as a member of any other `DateOnly` receiver is. Before D61
// the same line was refused by member name alone,
// `teko: unknown member: DayNumber`, which said nothing about the type -- and
// said it about every member, the right ones included.
//
// expect-refuse: teko: unknown member of DateOnly: Nope
// expect-refuse-line: 19

#include "../../lib/time.tk"

delegate DateOnly DOp();

DateOnly mkday() { return new DateOnly(2024, 2, 29); }

i64 main() {
    DOp f = mkday;
    return f().Nope;
}
