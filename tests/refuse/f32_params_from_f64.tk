// f32_params_from_f64.tk -- D78: the same narrowing, through a `params`
// element: `tk_pm_elem_fits`'s width-aware clause refuses an `f64` element
// against a `params f32[]` exactly as `tk_check_scalar_compat` refuses it at
// a plain slot -- the narrowing direction never reaches `tk_pm_pack`'s own
// cast at all.
//
// expect-refuse: teko: a value of type f64 does not convert to f32
// expect-refuse-line: 13

f32 total(params f32[] xs) { return xs[0]; }

i64 main() {
    f64 r = total(2.5);
    return 42;
}
