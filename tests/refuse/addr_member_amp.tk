// addr_member_amp.tk -- D97: `&n` on a BARE INSTANCE FIELD shadowed by a
// same-named global. `tk_this_fix` (teko_this.tk) dispatched `N_IDENT`,
// `N_ASSIGN` and `N_CALL` and not `N_ADDR`, so the name under `&` was left to
// the core's resolver and took the GLOBAL's address: measured on `55cdf69e`,
// this program exited 100 -- the global -- where the field holds 5.
//
// expect-refuse: teko: the address of a member is not taught yet: n
// expect-refuse-line: 16
#include "../../lib/rt.tk"

i64 n = 100;

class H {
    public i64 n;
    public H() { n = 5; }
    public i64 go() { uptr p = &n; return ld64(p); }
}

i64 main() {
    H h = new H();
    return h.go();
}
