// addr_member_qualified_unknown.tk -- D104: `&h.missing`, a qualified address
// over a name NO type in the unit declares.
//
// The judge D104 puts in front of an `N_ADDR` receiver does NOT answer this
// one: there is no field to pass as `ref`, so promising one would be a lie.
// The deferred road's own `teko: unknown member` is the truth, and it is what
// `f81e0217` says too -- the one shape of a qualified address that does not
// change here. Found by the Copilot review of #770, which measured the judge
// answering `the address of a field is not taught yet: missing` for it.
//
// expect-refuse: teko: unknown member: missing
// expect-refuse-line: 19
#include "../../lib/rt.tk"

class H { public i64 n; public H() { n = 42; } }

i64 main() {
    H h = new H();
    return ld64(&h.missing);
}
