// string_interp_ternary.tk -- docs/specs/string.md § 9, N10: `?`, `??` and
// `?.` each park as a marker call (`tk_ternary`/`tk_coalesce`/`tk_qdot`,
// teko_ternary.tk) that `tk_ternary_pass` unpacks -- and that pass runs
// AFTER the one a hole is typed in, so `tk_ty_of` has nothing to answer
// with. Named here rather than falling through to the generic
// `the type of this value is not known here` (docs/reference/not-yet.md).
//
// expect-refuse: teko: an interpolation hole holds no ternary, ?? or ?.
// expect-refuse-line: 15
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    i64 x = 1;
    string s = $"{(x > 0 ? 5 : 6)}";
    return s.Length;
}
