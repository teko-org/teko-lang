// addr_member_ref.tk -- D97: `ref n` on a BARE INSTANCE FIELD shadowed by a
// same-named global. The split was exact: measured on `55cdf69e`, `bump(ref n)`
// incremented the GLOBAL to 101 while `return this.n;` one line later read the
// FIELD and answered 5. One name, two bindings, no diagnostic. C# answers 6.
//
// expect-refuse: teko: the address of a member is not taught yet: n
// expect-refuse-line: 17
#include "../../lib/rt.tk"

i64 n = 100;

void bump(ref i64 v) { v = v + 1; }

class H {
    public i64 n;
    public H() { n = 5; }
    public i64 go() { bump(ref n); return this.n; }
}

i64 main() {
    H h = new H();
    return h.go();
}
