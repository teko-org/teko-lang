// decimal_cast.tk -- docs/specs/decimal.md § 6: the explicit conversions land
// in C4, where each becomes a call (`tk_dec_to_i64` and its siblings). Until
// then a `decimal` casts to nothing: `MTASK_CAST` on a sixteen-byte value has
// no meaning, and a cast that reached the machine would move eight bytes.
// `decimal` is registered with no reader and no constructor, so the refusal
// names neither (teko_prim.tk, D74).
//
// expect-refuse: teko: a decimal does not cast yet
// expect-refuse-line: 15

#include "decimal.tk"

i64 main() {
    decimal a = 2.5m;
    i64 n = (i64) a;
    return n;
}
