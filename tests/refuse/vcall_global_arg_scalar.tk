// vcall_global_arg_scalar.tk -- the scalar half of the same rule: an `f64`
// global handed to an `i64` parameter through a VIRTUAL call narrows, and
// narrowing has no implicit conversion (D33, D57). The identical LOCAL was
// already refused here.
//
// expect-refuse: teko: a value of type f64 does not convert to i64
// expect-refuse-line: 20
#include "../../lib/rt.tk"

class Box {
    public i64 w;
    public Box(i64 v) { w = v; }
    public virtual i64 takei(i64 n) { return n; }
}

f64 gf;
i64 main() {
    gf = 1.5;
    Box b = new Box(9);
    return b.takei(gf);
}
