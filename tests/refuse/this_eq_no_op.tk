// this_eq_no_op.tk -- `this == o` is a comparison of two class references, and
// it gets the rule every class reference gets. It compiled into a raw pointer
// compare before D102, because `this` typed `uptr`; that was the one hole in
// the rule, and `C a; C b; a == b;` was already refused by this same sentence.
//
// expect-refuse: teko: C declares no operator `==`
// expect-refuse-line: 13
#include "../../lib/rt.tk"

class C {
    public i64 v;
    public C() { v = 0; }
    public bool Same(C o) { return this == o; }
}
i64 main() {
    C c = new C();
    if (c.Same(c)) return 1;
    return 0;
}
