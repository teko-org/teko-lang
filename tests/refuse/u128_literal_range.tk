// u128_literal_range.tk -- N6a of docs/specs/small-ints.md (§ 6; D81): the
// other half of the range check. A `u128` literal spends all 128 bits, so its
// ceiling is 2^128-1 and 2^128 is one too many -- the carry out of the top
// limb is remembered by `tk_wl_muladd` (teko_i128.tk) rather than dropped.
//
// expect-refuse: teko: a u128 literal is out of range
// expect-refuse-line: 12

#include "wide.tk"

i64 main() {
    u128 a = 340282366920938463463374607431768211456u;
    if (a == 0u) return 1;
    return 0;
}
