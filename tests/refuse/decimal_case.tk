// decimal_case.tk -- docs/specs/decimal.md § 9: a `decimal` `case` label is out
// for the reason a `const decimal` is, and it earns the same existing wording.
//
// expect-refuse: teko: a case label must be a constant expression
// expect-refuse-line: 11

#include "decimal.tk"

i64 main() {
    switch (3) {
        case 1m: return 1;
        default: return 0;
    }
}
