// vcall_arg_expr_narrow.tk -- the same rule one road over: a VIRTUAL call's
// argument that is a COMPOSITE EXPRESSION is judged like a direct call's.
// D57 documented the gap as a silent skip -- "a by-value argument that is
// neither a bare name nor an overloaded call" -- and D59's second pass closed
// it by parking every by-value argument the parse-time oracle cannot type.
// Measured compiling on `9b6c4180`, the double's bits read as an integer.
//
// expect-refuse: teko: a value of type f64 does not convert to i64
// expect-refuse-line: 20

#include "../../lib/rt.tk"

class Box {
    public virtual i64 takei(i64 n) { return n; }
}

i64 main() {
    Box b = new Box;
    f64 lf = 8.5;
    return b.takei(lf * 2.0);
}
