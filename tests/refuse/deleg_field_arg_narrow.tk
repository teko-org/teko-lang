// deleg_field_arg_narrow.tk -- the FIELD road (`tk_field_use`, teko_expr.tk),
// which builds its `callp` at PARSE time: the argument is parked and judged at
// pass 14, the same door the bare-name road takes. It exited 128 before.
//
// expect-refuse: teko: a value of type f64 does not convert to i64
// expect-refuse-line: 20

#include "../../lib/rt.tk"

delegate i64 Op(i64 a);

i64 twice(i64 a) { return a + a; }

class H { public Op cb; }

i64 main() {
    H h = new H;
    h.cb = new Op(twice);
    f64 lf = 8.5;
    return h.cb(lf);
}
