// i128_tryparse_instance.tk -- N6b-3 of docs/specs/small-ints.md (§ 7; D85):
// `i128.TryParse` is a STATIC (`tk_i128_statics`, teko_i128.tk), registered
// as a `TK_PMSFUN` row so an instance reaching for it through `.` gets a sane
// message instead of reading as a member nobody ever heard of --
// `decimal`'s own shape (`teko_decimal.tk`, D79), measured and pinned here.
//
// expect-refuse: teko: i128.TryParse is static; reach it through its type
// expect-refuse-line: 15

#include "wide.tk"

i64 main() {
    i128 a = 5i;
    i128 out_v = 0i;
    a.TryParse("5", out out_v);
    return 0;
}
