// dateonly_plus_datetime.tk -- C# declares NO arithmetic operator on a
// `DateOnly`, so the operator table registers none and the six comparisons are
// all it claims (docs/specs/datetime-extras.md § 3).
// `d1.DayNumber - d2.DayNumber` is the form for a difference.
//
// expect-refuse: teko: no operator `+` takes these operands
// expect-refuse-line: 13

#include "../../lib/time.tk"
i64 main() {
    DateOnly d = new DateOnly(2024, 2, 29);
    DateTime t = new DateTime(2024, 2, 29);
    DateTime x = d + t;
    return 42;
}
