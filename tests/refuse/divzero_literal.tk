// divzero_literal.tk -- D82 amended (the PR's F3): a LITERAL zero divisor is
// answered where it is written, never guarded at run time. C# refuses the
// same line outright (CS0020, "Division by constant zero") whatever the
// dividend is; mc's own folder only reaches the case where BOTH sides are
// constant (`12 / 0`, refused `division by zero`, no `teko:` prefix), so a
// dividend the folder cannot see through is this refusal's own.
//
// expect-refuse: teko: division by zero
// expect-refuse-line: 13

#include "../../lib/rt.tk"

i64 main() { i64 a = 12; return a / 0; }
