// decimal_bitand.tk -- the bitwise half of decimal_shift.tk's own rule
// (docs/specs/decimal.md § 4): a `decimal` is a number in base ten and not a
// pattern of bits, so `&` has no row and earns no lowering. It is the case
// where BOTH operands are the primitive, which is the one a promotion could
// never turn into anything else.
//
// expect-refuse: teko: no operator `&` takes these operands
// expect-refuse-line: 14

#include "decimal.tk"

i64 main() {
    decimal d = 1.5m;
    decimal s = d & d;
    return 0;
}
