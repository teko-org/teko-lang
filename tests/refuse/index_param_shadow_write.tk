// index_param_shadow_write.tk -- D96, the WRITE half over a FIXED global: a
// store into `src[0]` is deferred at parse time (`tk_arr_defer_write`) and
// resolved by `tk_array_resolve_write` (teko_array.tk), which takes the base
// by NAME out of `tk_garr_find` exactly as the read rewriter does. The store's
// address was therefore the parameter's own VALUE. Its base is marked beside
// the reads, so the same judge in the typeof pass answers it.
//
// expect-refuse: teko: `[` needs an array: src
// expect-refuse-line: 14
#include "../../lib/rt.tk"

i64 src[3];

i64 f(i64 src) { src[0] = 1; return 0; }

i64 main() {
    return f(7);
}
