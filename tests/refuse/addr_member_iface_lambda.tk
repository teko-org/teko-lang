// addr_member_iface_lambda.tk -- D97, the Copilot review's own finding: an
// interface property a BASE interface declares (`interface I2 : I1`), reached
// bare under `&` INSIDE A LAMBDA in `I2`'s default body. `tk_prop_find` answers
// an interface's OWN property and stops there, so `tk_addr_is_member` caught
// every shallow shape -- the direct default body, and a lambda over `I2`'s own
// property -- while this one still answered the global 100 against an
// implementing `Label` worth 5. `tk_ifprop_find_deep` is what the READ road has
// been asking all along (`tk_this_iface_prop`), and the address road now asks it
// in the same place, for all three walks at once.
//
// expect-refuse: teko: the address of a member is not taught yet: Label
// expect-refuse-line: 24
#include "../../lib/rt.tk"

i64 Label = 100;

delegate i64 Op(i64 x);

interface I1 {
    i64 Label { get; set; }
}

interface I2 : I1 {
    i64 peek() { Op f = new Op((i64 x) => ld64(&Label) + x); return f(0); }
}

class Sq : I2 {
    public i64 Label { get; set; }
}

i64 main() {
    Sq q = new Sq();
    q.Label = 5;
    I2 s = q;
    return s.peek();
}
