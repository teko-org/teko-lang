// f32_from_f64_global.tk -- D78 ruling 2, at a global initializer: `f32 c =
// 2.5;` is refused before `tk_rc_glb_widen` (teko_rc.tk) ever reads the
// literal's bits, the same wording every other slot gets -- not the raw
// four-byte copy `docs/reference/not-yet.md` used to record.
//
// expect-refuse: teko: a value of type f64 does not convert to f32
// expect-refuse-line: 9

f32 c = 2.5;

i64 main() {
    return 42;
}
