// prim_tostring_no_include.tk -- D98: `.ToString()` on a scalar BUILDS a
// `string`, so the class has to be declared first, exactly as an
// interpolation hole needs it. Named rather than left to the member-name
// refusal, which would blame `ToString` for a missing `#include`.
//
// expect-refuse: teko: .ToString() needs #include "string.tk" before it is used
// expect-refuse-line: 12
#include "../../lib/rt.tk"

i64 main() {
    i64 v = 1;
    uptr s = v.ToString();
    return 0;
}
