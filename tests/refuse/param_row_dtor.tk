// param_row_dtor.tk -- D104: a DESTRUCTOR's parameter window is empty.
//
// A destructor takes no parameter and so never goes through `tk_params`
// (teko_class.tk), which is where every other member empties the window. The
// window still held the PREVIOUS declaration's rows, and `tk_hp_own` --
// reached through the shared `tk_member_fn` -- relabelled them as this body's,
// so `ref h.n` in the destructor resolved a parameter it never had: with the
// global `i64 h` for mc to resolve the name against, `<the global> + OFF` and
// SIGSEGV, found by the Copilot review of #770. `f81e0217` refuses it. The
// reset is `tk_member_dtor`'s own line, the destructor's analogue of
// `tk_params`'s first and of `tk_prop_params`'s.
//
// expect-refuse: teko: not an object of a known type: h
// expect-refuse-line: 26
#include "../../lib/rt.tk"

class H { public i64 pad; public i64 n; public H() { pad = 0; n = 41; } }

i64 h = 100;

void bump(ref i64 v) { v = v + 1; }

class C {
    public C() { }
    public i64 go(H h) { return h.n; }
    ~C() { bump(ref h.n); }
}

i64 main() {
    C c = new C();
    H a = new H();
    return c.go(a);
}
