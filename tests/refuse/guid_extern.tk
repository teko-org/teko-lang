// declaration rather than left to disagree at run time (teko_over.tk, D74).
//
// expect-refuse: teko: an `extern` takes no Guid
// expect-refuse-line: 12

#include "guid.tk"

extern i64 write_id(Guid g);

i64 main() {
    return 0;
}
