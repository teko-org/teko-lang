// dateonly_cast.tk -- a cast is the one syntax that would convert what
// converts to nothing but itself, so the surface may not write it; the
// compiler writes its own and knows them apart by node
// (docs/specs/datetime.md § 3, docs/specs/datetime-extras.md § 2). The
// member the message names is the type's OWN reader: a `DateOnly` has no
// `.Ticks` at all (D54).
//
// expect-refuse: teko: a DateOnly does not cast; `.DayNumber` reads it and `new DateOnly(...)` builds it
// expect-refuse-line: 14

#include "../../lib/time.tk"
i64 main() {
    DateOnly d = new DateOnly(2024, 2, 29);
    i64 n = (i64) d;
    return 42;
}
