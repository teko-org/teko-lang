// param_row_accessor_arrow.tk -- D104: the `=>` half of
// `tests/refuse/param_row_accessor.tk`. `tk_prop_arrow_body` (teko_prop.tk)
// reads the body itself rather than handing it to `parse_function`, and it is
// where the accessor says whose body it is (`p_set_decl_name(fn)`, K6); the
// reset that empties the parameter window for it is the shared one in
// `tk_prop_params`. Measured at `f81e0217`: refused, exactly as here.
//
// expect-refuse: teko: not an object of a known type: h
// expect-refuse-line: 21
#include "../../lib/rt.tk"

class H { public i64 pad; public i64 n; public H() { pad = 0; n = 41; } }

i64 h = 100;

void bump(ref i64 v) { v = v + 1; }

i64 first(H h) { return h.n; }

class C {
    public i64 Side { set => bump(ref h.n); }
    public C() { }
}

i64 main() {
    H a = new H();
    C c = new C();
    c.Side = 1;
    return first(a);
}
