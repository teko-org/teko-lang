// global_row_mismatch.tk -- one class does not convert to an unrelated one,
// in a global slot as in a local one (D53).
//
// expect-refuse: teko: a value of type Box does not convert to Cell
// expect-refuse-line: 12

class Cell { public i64 v; }
class Box { public i64 w; }
Cell gc;
i64 main() {
    Box b = new Box();
    gc = b;
    return 42;
}
