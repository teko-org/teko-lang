// dto_add.tk -- docs/specs/datetime-extras.md § 3: `DateTimeOffset` declares
// no `o + o` operator -- C# has none either, `o - o` (a `TimeSpan`) is the
// form -- so the pass CLAIMS the binary with a primitive operand and refuses
// it where it is written instead of reaching the core's own raw add over a
// sixteen-byte value.
//
// expect-refuse: teko: no operator `+` takes these operands
// expect-refuse-line: 16

#include "rt.tk"
#include "time.tk"

i64 main() {
    DateTimeOffset a = DateTimeOffset.MinValue;
    DateTimeOffset b = DateTimeOffset.MinValue;
    DateTimeOffset c = a + b;
    return 0;
}
