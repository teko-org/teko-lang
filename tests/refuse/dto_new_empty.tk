// dto_new_empty.tk -- Ruling 3 (D76): `new DateTimeOffset()` is not taught.
// A wide type's zero-argument constructor would reach `tk_cast(ty, tk_int(0))`
// and then `tw_cast`'s own `die` on a sixteen-byte destination -- there is no
// zero BIT PATTERN this cast could write, since a wide value moves by
// address and never through a register (`tk_prim_new`, teko_prim.tk). The
// type's own named zero is the written form.
//
// expect-refuse: teko: new DateTimeOffset() is not taught; write DateTimeOffset.MinValue
// expect-refuse-line: 15

#include "rt.tk"
#include "time.tk"

i64 main() {
    DateTimeOffset o = new DateTimeOffset();
    return o.Year;
}
