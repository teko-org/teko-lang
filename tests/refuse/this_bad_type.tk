// this_bad_type.tk -- `this` is a value of its own class, so a return typed as
// an unrelated class is refused by the name of that class. The message used to
// say `uptr`, which named the receiver parameter and not the receiver (D102).
//
// expect-refuse: teko: a value of type D does not convert to U
// expect-refuse-line: 12
#include "../../lib/rt.tk"

class U { public i64 u; public U() { u = 0; } }
class D {
    public D() {}
    public U Bad() { return this; }
}
i64 main() {
    D d = new D();
    return d.Bad().u;
}
