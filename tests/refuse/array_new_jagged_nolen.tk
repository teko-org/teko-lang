// array_new_jagged_nolen.tk -- a RANK is not a length. `new i64[][]` (D101)
// gives the allocator no `n` for the outer array, and the empty first `[]` is
// refused before the rank loop is ever reached -- the outer length is always
// written, and only the ranks after it are empty.

// expect-refuse: teko: `new T[]` needs a length; write `new T[n]`
// expect-refuse-line: 10

i64 main() {
    i64[][] m = new i64[][];
    return 0;
}
