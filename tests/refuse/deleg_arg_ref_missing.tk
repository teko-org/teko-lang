// deleg_arg_ref_missing.tk -- the KIND of a delegate call's argument, in the
// direct call's own words (`tk_ref_check_kind`, teko_ref.tk, which this door
// now calls instead of repeating): a `ref` parameter takes an address, and a
// value handed to one would be written through as if it were one.
//
// expect-refuse: teko: argument 1 needs `ref` at the call site
// expect-refuse-line: 18

#include "../../lib/rt.tk"

delegate void Mut(ref f64 x);

void bumpf(ref f64 x) { x = x + 1.0; }

i64 main() {
    Mut m = bumpf;
    f64 v = 1.0;
    m(v);
    return 0;
}
