// thiscall_virtual_arg.tk -- the UNQUALIFIED form of a virtual call, written
// inside a method of the same class, is the same `callp` as `this.m(x)` and
// takes the same judgement (D57). It built that call and called no check at
// all, so a plain `f64` LOCAL reached an `i64` parameter here -- the one road
// on which even a local crossed unread, since the rewrite runs from a pass
// where the parser's own stack of locals is long closed.
//
// expect-refuse: teko: a value of type f64 does not convert to i64
// expect-refuse-line: 18
#include "../../lib/rt.tk"

class Box {
    public i64 w;
    public Box(i64 v) { w = v; }
    public virtual i64 takei(i64 n) { return n; }
    public virtual i64 mine() {
        f64 lf = 1.5;
        return takei(lf);
    }
}

i64 main() {
    Box b = new Box(9);
    return b.mine();
}
