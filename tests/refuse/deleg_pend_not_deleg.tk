// deleg_pend_not_deleg.tk -- D65 taught `tk_pend_field` (teko_typeof.tk) to
// call a field of DELEGATE type through a receiver only the pass can type.
// A field of any other type keeps the refusal that road always gave, in the
// words `tk_field_use` gives it at parse time.
//
// expect-refuse: teko: the member is a field, not a method: n
// expect-refuse-line: 15

#include "../../lib/rt.tk"

class H {
    public i64 n;
}

i64 use(H h) { return h.n(1); }

i64 main() {
    H h = new H;
    return use(h);
}
