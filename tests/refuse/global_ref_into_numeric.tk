// global_ref_into_numeric.tk -- a non-null reference does not convert to a
// numeric global slot either (D34, D53).
//
// expect-refuse: teko: a value of type Cell does not convert to i64
// expect-refuse-line: 12
#include "../../lib/rt.tk"

class Cell { public i64 v; }
i64 gn;
i64 main() {
    Cell c = new Cell();
    gn = c;
    return gn;
}
