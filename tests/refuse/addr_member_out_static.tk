// addr_member_out_static.tk -- D97: `out n` on a BARE STATIC FIELD shadowed by
// a same-named global. Measured on `55cdf69e`: `setit(out n)` wrote 7 into the
// GLOBAL, the static stayed 5, and `H.n * 1000 + n` answered 5005 (141 as an
// exit code) where C# answers 7007. A static field is a global of its own
// (`fd_sym_at`), so this road is as reachable from a static method as from an
// instance one.
//
// expect-refuse: teko: the address of a member is not taught yet: n
// expect-refuse-line: 18
#include "../../lib/rt.tk"

i64 n = 100;

void setit(out i64 v) { v = 7; }

class H {
    public static i64 n;
    public static i64 go() { setit(out n); return H.n * 1000 + n; }
}

i64 main() {
    H.n = 5;
    return H.go();
}
