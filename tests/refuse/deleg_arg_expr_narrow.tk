// deleg_arg_expr_narrow.tk -- an argument of a delegate call that is a
// COMPOSITE EXPRESSION is judged like a direct call's. `twice(lf * 2.0)`
// written out is refused, and until D59's second pass the delegate spelling
// compiled and handed the double's own bits to the `i64` parameter (measured
// on `9b6c4180`: exit 64). D57's park read a bare NAME and a call to an
// overloaded one only, so a binary reached the door's `at < 0` path and
// crossed unread; every by-value argument the parse-time oracle cannot type
// is parked now, and the pass answers for this one.
//
// expect-refuse: teko: a value of type f64 does not convert to i64
// expect-refuse-line: 22

#include "../../lib/rt.tk"

delegate i64 Op(i64 k);

i64 twice(i64 k) { return k * 2; }

i64 main() {
    Op f = twice;
    f64 lf = 8.5;
    return f(lf * 2.0);
}
