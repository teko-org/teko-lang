// ref_field_private.tk -- D104: `ref h.secret` on a `private` field is refused
// from outside the declaring type, exactly as reading it is.
//
// `tk_ref_addr` (teko_ref.tk) had neither of the two gates `tk_member_of`
// (teko_expr.tk) puts in front of an ordinary field read -- and `name + OFF`
// is an address the callee then WRITES through, so this door was the laxer of
// the two: `f81e0217` compiles this program and writes the private field
// (measured, exit 42), while `h.secret` as a plain read is refused there.
// Found by the Copilot review of #770, which reached it through the PARAMETER
// receiver this decision adds; the gate goes where BOTH receivers pass, so the
// local one below is answered by the same line.
//
// expect-refuse: teko: H.secret is private
// expect-refuse-line: 27
#include "../../lib/rt.tk"

class H {
    private i64 secret;
    public H() { secret = 41; }
    public i64 peek() { return secret; }
}

void bump(ref i64 v) { v = v + 1; }

i64 main() {
    H h = new H();
    bump(ref h.secret);
    return h.peek();
}
