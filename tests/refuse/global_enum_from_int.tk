// global_enum_from_int.tk -- an enum global accepts nothing but its own
// members, exactly as an enum local does (docs/specs/enum.md S 5, D53).
//
// expect-refuse: teko: a value of type i64 does not convert to Color
// expect-refuse-line: 8

enum Color { Red, Green, Blue }
Color gk = 1;
i64 main() {
    return 42;
}
