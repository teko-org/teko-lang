// index_mconst_below.tk -- D96, the same over a member CONST declared below:
// `tk_this_ident`'s order is field, then const, then property, and the const's
// VALUE was read as the array's handle. Exit 139, measured.
//
// expect-refuse: teko: `[` needs an array: src
// expect-refuse-line: 12
#include "../../lib/rt.tk"

i64 src[3];

class H {
    public i64 go() { return src[0]; }
    public const i64 src = 9;
    public H() { }
}

i64 main() {
    src[0] = 5;
    H h = new H();
    return h.go();
}
