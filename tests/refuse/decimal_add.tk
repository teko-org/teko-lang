// decimal_add.tk -- C3 moves a sixteen-byte value and does not compute with
// one: the arithmetic is C4 (docs/specs/decimal.md § 12,
// docs/reference/not-yet.md). `decimal` is registered as a primitive with an
// EMPTY member table, so it claims no operator and every one of them is
// refused where it is written, with the wording teko_ops.tk already gives.
//
// expect-refuse: teko: no operator `+` takes these operands
// expect-refuse-line: 15

#include "decimal.tk"

i64 main() {
    decimal a = 1.5m;
    decimal b = 2.5m;
    decimal c = a + b;
    return 0;
}
