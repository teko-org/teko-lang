// string_interp_no_include.tk -- docs/specs/string.md § 9, N10: `$"..."`
// lowers into the `string` class's own `operator+`, which needs the class
// declared first.
//
// expect-refuse: teko: string interpolation needs #include "string.tk" before it is used
// expect-refuse-line: 11
#include "../../lib/rt.tk"

i64 main() {
    i64 x = 1;
    uptr s = $"{x}";
    return 0;
}
