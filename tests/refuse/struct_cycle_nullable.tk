// struct_cycle_nullable.tk -- the `?` opens no door around the cycle rule. Q1a
// makes a nullable over a reference the reference itself, so `Node? next` holds
// exactly what `Node next` holds and a memberwise copy recurses through it the
// same way -- for ever on a cyclic list. C# refuses the same shape as CS0523,
// `S?` over a struct being `Nullable<S>`, which contains an `S`
// (docs/specs/struct-value.md § 4.4).
//
// expect-refuse: teko: a struct cannot contain itself
// expect-refuse-line: 12
#include "../../lib/rt.tk"

struct Node {
    public i64   v;
    public Node? next;
}

i64 main() {
    Node n = new Node;
    return 42;
}
