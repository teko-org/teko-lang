// i128_mixed_signedness.tk -- N6a of docs/specs/small-ints.md (§ 6; D81):
// `i128` and `u128` do not mix without a cast, which is C#'s own rule for
// `Int128` and `UInt128`. The two carry eighteen operator rows EACH (D81's eleven, D83's seven) and not one
// mixed row, and no promotion opens a door between them either:
// `tk_num_wide_widens` (teko_typeof.tk) asks `tk_is_int_ty` of the source,
// which answers 0 for every wide id (D38). `(i128) u` and `(u128) x` are the
// two spellings that convert, and neither moves a bit.
//
// expect-refuse: teko: no operator `+` takes these operands
// expect-refuse-line: 17

#include "wide.tk"

i64 main() {
    i128 a = 1i;
    u128 b = 1u;
    if (a + b != 2i) return 1;
    return 0;
}
