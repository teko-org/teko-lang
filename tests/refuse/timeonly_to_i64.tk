// timeonly_to_i64.tk -- the other direction: a `TimeOnly` becomes no integer
// without `.Ticks` (docs/specs/datetime-extras.md § 4).
//
// expect-refuse: teko: a value of type TimeOnly does not convert to i64
// expect-refuse-line: 10

#include "../../lib/time.tk"
i64 main() {
    TimeOnly t = new TimeOnly(13, 45, 30);
    i64 n = t;
    return 42;
}
