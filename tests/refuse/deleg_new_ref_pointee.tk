// deleg_new_ref_pointee.tk -- D63, third pass: the reclaim's own argument
// check no longer judges a thunk's forwarded `ref`/`out` argument, so a
// CLASS pointee (`ref Box`) travels through a delegate at last. What still
// has to be refused is the target whose pointee is ANOTHER class: `fillc`
// takes `ref Cell` where `Fill` declares `ref Box`, and the signature check
// (`tk_deleg_check_sig`, teko_deleg.tk) compares kind and pointee parameter
// by parameter before any thunk exists -- the same words, at the same line,
// the contextual `Fill f = fillc;` gives.
//
// expect-refuse: teko: fillc does not match the delegate Fill(ref Box)
// expect-refuse-line: 21
#include "../../lib/rt.tk"

class Box { public i64 v; }
class Cell { public i64 v; }

delegate void Fill(ref Box b);
void fillc(ref Cell c) { c.v = 3; }

i64 main() {
    Fill f = new Fill(fillc);
    return 0;
}
