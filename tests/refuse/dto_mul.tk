// dto_mul.tk -- the same claim as `dto_add.tk`, over `*`: `DateTimeOffset`
// declares no arithmetic operator with an `i64` either, C# has none, and the
// table registers only the nine rows § 3 lists.
//
// expect-refuse: teko: no operator `*` takes these operands
// expect-refuse-line: 13

#include "rt.tk"
#include "time.tk"

i64 main() {
    DateTimeOffset a = DateTimeOffset.MinValue;
    DateTimeOffset c = a * 2;
    return 0;
}
