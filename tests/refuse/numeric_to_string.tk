// numeric_to_string.tk -- the other half of D34's pair: a number does not
// convert to a class-typed slot, `string` included, with N7a adding no code
// of its own for this row (docs/specs/string.md § 5).
//
// expect-refuse: teko: a value of type i64 does not convert to string
// expect-refuse-line: 11
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    string t = 5;
    return 0;
}
