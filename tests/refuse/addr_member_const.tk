// addr_member_const.tk -- D97: `&C` on a member CONST shadowed by a same-named
// global. `tk_this_ident` asks `tk_this_const` for a bare read; the address road
// asked nothing, so the global answered -- measured 100 on `55cdf69e` against a
// member const worth 9. A const has no slot to address at all, which is why the
// refusal is the whole answer here rather than a deferred teaching.
//
// expect-refuse: teko: the address of a member is not taught yet: C
// expect-refuse-line: 15
#include "../../lib/rt.tk"

i64 C = 100;

class H {
    const i64 C = 9;
    public i64 go() { uptr p = &C; return ld64(p); }
}

i64 main() {
    H h = new H();
    return h.go();
}
