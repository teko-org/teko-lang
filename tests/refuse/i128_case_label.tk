// i128_case_label.tk -- N6a of docs/specs/small-ints.md (§ 9; D81): the same
// missing folded form one construct over. A `case` label has to be a constant
// the switch lowering can compare against, and an `i128` literal is a
// sixteen-byte global whose comparison is a CALL.
//
// expect-refuse: teko: a case label must be a constant expression
// expect-refuse-line: 14

#include "wide.tk"

i64 main() {
    i64 n = 1;
    switch (n) {
        case 1i: return 1;
    }
    return 0;
}
