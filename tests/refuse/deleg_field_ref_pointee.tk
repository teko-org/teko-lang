// deleg_field_ref_pointee.tk -- a `ref` argument through a delegate FIELD: the
// pointee is judged where the scope that names it is live (pass 14), not at
// the parse-time door that built the `callp` and answered -1 for it. Before
// D59 this compiled and let the callee write a double through an `i64`'s own
// slot -- `g` came back holding 1.0's bit pattern -- while the bare-name road
// already refused it (D57).
//
// expect-refuse: teko: a value of type i64 does not convert to f64
// expect-refuse-line: 24

#include "../../lib/rt.tk"

delegate void Mut(ref f64 x);

void bumpf(ref f64 x) { x = x + 1.0; }

class H { public Mut cb; }

i64 main() {
    H h = new H;
    Mut m = bumpf;
    h.cb = m;
    i64 g = 0;
    h.cb(ref g);
    return g;
}
