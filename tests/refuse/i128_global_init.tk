// i128_global_init.tk -- N6a of docs/specs/small-ints.md (§ 9; D81), the same
// rule D77's fifth ruling fixed for `decimal`: a global of a wide type is a
// SLOT and an assignment. `i128 g = 1i;` dies one phase earlier with mc's own
// `global initializer must be constant`, because the literal is the `N_IDENT`
// of its own blob global and `parse_global` (mc src/parse.mc) takes none but
// an `N_INT`.
//
// `i128 g = 5;` is the one spelling that gets PAST that rule -- `5` IS an
// `N_INT` -- and the conversion it would need is a call to
// `tk_i128_from_i64`, which a global initializer may not be either.
//
// expect-refuse: teko: a global i128 takes no initializer
// expect-refuse-line: 17

#include "wide.tk"

i128 g = 5;

i64 main() {
    return 0;
}
