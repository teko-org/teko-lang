// rem_float_left.tk -- D95, the mirror of rem_float_right.tk: `2.5 % 7`
// already failed before this crumb, but at the mc level (`mc: no float
// remainder`, no `file:line`, unpinnable by a D52 fixture). The same guard in
// `tk_ops_binary` (teko_ops.tk) catches the float on the LEFT too and
// upgrades it to a `teko:` message this harness can pin.
//
// expect-refuse: teko: `%` takes no float operand
// expect-refuse-line: 10

i64 main() { f64 r = 2.5 % 7; return (i64) r; }
