// addr_field_this_class.tk -- D104: the same `(&this).n` miscompile over a
// field of CLASS type. The garbage word read past the frame is then used as a
// handle, so this half faults instead of answering: SIGSEGV at `f81e0217`,
// exit 139.
//
// expect-refuse: teko: the address of a field is not taught yet; pass it as `ref` or `out`: k
// expect-refuse-line: 15
#include "../../lib/rt.tk"

class K { public i64 v; public K() { v = 7; } }

class H {
    public K k;
    public H() { k = new K(); }
    public i64 go() { return ld64(&this.k); }
}

i64 main() {
    H h = new H();
    return h.go();
}
