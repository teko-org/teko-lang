// addr_field_this_class.tk -- D104: the same `(&this).n` miscompile over a
// field of CLASS type. `f81e0217` compiles it and answers **233** -- the
// garbage word read past the frame, returned as the exit code. This header
// first claimed a SIGSEGV; an independent verification measured 233 three
// times over, and the shape cannot fault: `ld64` returns the word and nothing
// dereferences it. A garbage HANDLE is the worse half, not a crash.
//
// expect-refuse: teko: the address of a field is not taught yet; pass it as `ref` or `out`: k
// expect-refuse-line: 17
#include "../../lib/rt.tk"

class K { public i64 v; public K() { v = 7; } }

class H {
    public K k;
    public H() { k = new K(); }
    public i64 go() { return ld64(&this.k); }
}

i64 main() {
    H h = new H();
    return h.go();
}
