// field_store_void.tk -- a void-returning call stored into a typed field is
// refused; every field store is one gate (D50).
//
// expect-refuse: teko: a value of type void does not convert to i64
// expect-refuse-line: 11

void nothing() { return; }
class Holder { public i64 v; }
i64 main() {
    Holder h = new Holder();
    h.v = nothing();
    return 42;
}
