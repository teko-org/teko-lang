// addr_field_store.tk -- D104: the STORE half, `st64(&this.n, 42)`. The
// address handed to `st64` is the same field load past the frame, so the
// write lands on whatever that word points at: SIGBUS at `f81e0217`, exit
// 138. The judge is one point for both halves -- the receiver is an `N_ADDR`
// whatever the `.` is being read for -- so no separate arm is needed for a
// write.
//
// expect-refuse: teko: the address of a field is not taught yet; pass it as `ref` or `out`: n
// expect-refuse-line: 15
#include "../../lib/rt.tk"

class H {
    public i64 n;
    public H() { n = 0; }
    public i64 go() { st64(&this.n, 42); return this.n; }
}

i64 main() {
    H h = new H();
    return h.go();
}
