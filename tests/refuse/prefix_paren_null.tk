// prefix_paren_null.tk -- D80: `?.` after a parenthesized `-` binds to the
// group, so `(-oc)?.M()` is `(-oc)` first -- a class declares no unary `-`
// (`teko_ops.tk`'s own "no operator" rule, unrelated to this crumb and
// pre-existing) -- refused pointing at the receiver a program actually
// wrote, `Cell?`.
//
// Measured: before this fix, the sink read `(-oc)?.M()` as `-(oc?.M())`,
// which still failed, but LATE and on the WRONG type -- `teko: i64?
// declares no operator -` (`M`'s own return, boxed by `?.`), not the
// `Cell?` a reader actually negated. The fix does not add a refusal of its own: it
// stops sinking, and the unary-over-a-nullable rule already in force
// (`tk_nl_unary_check`, teko_ops.tk) now sees the real receiver.
//
// expect-refuse: teko: Cell? declares no operator `-`
// expect-refuse-line: 27

#include "../../lib/rt.tk"

class Cell {
    public i64 v;
    public Cell(i64 x) { v = x; }
    public i64 M() { return v; }
}

i64 main() {
    Cell? oc = new Cell(5);
    i64? r = (-oc)?.M();
    return 0;
}
