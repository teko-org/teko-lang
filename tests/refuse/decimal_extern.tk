// declaration rather than left to disagree at run time (teko_over.tk, D74).
//
// expect-refuse: teko: an `extern` takes no decimal
// expect-refuse-line: 12

#include "decimal.tk"

extern i64 write_amount(decimal d);

i64 main() {
    return 0;
}
