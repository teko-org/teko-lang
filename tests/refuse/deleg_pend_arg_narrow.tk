// deleg_pend_arg_narrow.tk -- the road D65 opened carries D59's argument
// judge with it: `tk_pend_field` builds its `callp` through `tk_deleg_build`,
// the one builder, so an argument that does not convert is refused here as it
// is on the four roads that already had a call. This one is judged at pass
// 14, where the park is read.
//
// expect-refuse: teko: a value of type f64 does not convert to i64
// expect-refuse-line: 18

#include "../../lib/rt.tk"

delegate i64 Op(i64 a);

i64 twice(i64 a) { return a + a; }

class H { public Op cb; }

i64 use(H h, f64 lf) { return h.cb(lf); }

i64 main() {
    H h = new H;
    h.cb = new Op(twice);
    f64 lf = 8.5;
    return use(h, lf);
}
