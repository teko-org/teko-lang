// string_interp_null.tk -- D92 amended (PR #754's review, after the merge):
// `str`, `ptr`, `uptr` and the `null` literal are ONE type to mc (types.md
// § Limits), and `new string(str)` measures its argument with `tk_str_len`.
// A `null` hole is the one member of that family this pass can tell apart
// (`tk_is_null_lit`, teko_struct.tk), so it is refused where it is written
// rather than dereferenced at run time. A `str` VARIABLE that happens to
// hold 0 is caught by the constructor's own guard instead (the empty
// string, `tests/surface_string_interp.tk`'s own row).
//
// expect-refuse: teko: an interpolation hole holds no null
// expect-refuse-line: 16

#include "../lib/rt.tk"
#include "../lib/string.tk"

i64 main() { string s = $"{null}"; return 0; }
