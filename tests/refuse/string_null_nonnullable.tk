// string_null_nonnullable.tk -- `null` lands only in a slot declared `T?`
// (D43), which post-dates docs/specs/string.md's own § 5/§ 8 sample
// (`string e = null;`, written under D32's older rule): the newest ruling
// wins, so a plain `string` slot refuses `null` exactly as a plain `Cell`
// one does, and `string?` is the spelling this crumb's own fixtures use.
// No code of this crumb's -- D43's mechanism answers for `string` the
// moment the class exists.
//
// expect-refuse: teko: null needs a slot declared string?
// expect-refuse-line: 16
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    string s = new string("hi");
    s = null;
    return 0;
}
