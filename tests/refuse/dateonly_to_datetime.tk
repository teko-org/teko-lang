// dateonly_to_datetime.tk -- the two date types do not convert into each
// other either: `DateOnly.FromDateTime(d)` is the one road, and
// `.ToDateTime(TimeOnly)` will be the other once `TimeOnly` lands
// (docs/specs/datetime-extras.md § 2).
//
// expect-refuse: teko: a value of type DateOnly does not convert to DateTime
// expect-refuse-line: 12

#include "../../lib/time.tk"
i64 main() {
    DateOnly d = new DateOnly(2024, 2, 29);
    DateTime x = d;
    return 42;
}
