// addr_field_chain.tk -- D104: `&this.k.n`, a CHAIN through the address. The
// refusal lands on the INNER link (`k`), which is the receiver the outer one
// would read: the inner row is resolved first (`tk_pend_do` chases
// `pd_recv`), so the `N_ADDR` is judged before any offset is added to it.
// SIGSEGV at `f81e0217`, exit 139.
//
// expect-refuse: teko: the address of a field is not taught yet; pass it as `ref` or `out`: k
// expect-refuse-line: 16
#include "../../lib/rt.tk"

class K { public i64 n; public K() { n = 42; } }

class H {
    public K k;
    public H() { k = new K(); }
    public i64 go() { return ld64(&this.k.n); }
}

i64 main() {
    H h = new H();
    return h.go();
}
