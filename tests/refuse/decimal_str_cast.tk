// decimal_str_cast.tk -- C4 opens FOUR casts over a `decimal` (§ 6: the two
// integer directions and the two float ones) and not a fifth. `(str) d` is
// text, and text is a `.ToString()` and a `decimal.Parse(s)` -- so the cast
// refusal names the pair C5 taught (D79), where C3 and C4 had a `decimal` that
// registered no reader and no builder and said only "does not cast yet".
//
// expect-refuse: teko: a decimal does not cast; `.ToString()` writes it and `decimal.Parse(s)` reads it
// expect-refuse-line: 14

#include "decimal.tk"

i64 main() {
    decimal d = 1.5m;
    str s = (str) d;
    return 0;
}
