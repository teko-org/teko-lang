// decimal_str_cast.tk -- C4 opens FOUR casts over a `decimal` (§ 6: the two
// integer directions and the two float ones) and not a fifth. `(str) d` is
// text, and text is C5's `ToString`/`Parse` -- so the wording C3 left in place
// for every cast stands for the ones the conversion table does not name
// (`tk_prim_cast_find`, teko_prim.tk). `decimal` still registers no reader and
// no builder, which is why the refusal names neither (D74).
//
// expect-refuse: teko: a decimal does not cast yet
// expect-refuse-line: 15

#include "decimal.tk"

i64 main() {
    decimal d = 1.5m;
    str s = (str) d;
    return 0;
}
