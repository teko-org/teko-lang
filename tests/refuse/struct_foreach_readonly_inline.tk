// struct_foreach_readonly_inline.tk -- V6/D108, the INLINE ARRAY reach of the
// same rule: `t.a[0] = 9` inside a `foreach (T t in x)` writes an element of an
// inline array field of the array's own row. It compiled and mutated the array
// before this crumb (measured, exit 9), and the store passes the same one door
// every other element store passes (`tk_os_mark`, teko_struct.tk) -- the
// address carries an index term this time, and the receiver is still the name
// at the root of its spine.
//
// expect-refuse: teko: a foreach variable of struct type is read-only
// expect-refuse-line: 20
#include "../../lib/rt.tk"

struct T { public i64 a[2]; }

i64 main() {
    T[] x = new T[1];
    x[0] = new T;
    x[0].a[0] = 1;
    foreach (T t in x) {
        t.a[0] = 9;
    }
    return x[0].a[0];
}
