// addr_member_qualified_static.tk -- D104: `&h.tally`, a qualified address
// over a uniquely named STATIC field.
//
// It is a FIELD, so the field wording would have been chosen -- and it would
// have named a road that refuses: `ref h.tally` is rejected by
// `tk_ref_addr`'s own static gate (`tests/refuse/ref_field_static.tk`), a
// static's storage being a symbol of its own rather than a word inside the
// object. `f81e0217` reported the static diagnostic here, through
// `tk_pend_by_name`; D104's judge stands ahead of that road, so it owes a
// sentence of its own, and the honest one is D97's: not taught yet, and no
// road named. Found by the Copilot review of #770.
//
// expect-refuse: teko: the address of a member is not taught yet: tally
// expect-refuse-line: 26
#include "../../lib/rt.tk"

class H {
    public static i64 tally;
    public i64 n;
    public H() { n = 1; }
}

i64 main() {
    H.tally = 42;
    H h = new H();
    return ld64(&h.tally);
}
