// deleg_new_kind.tk -- D63: `new Op(f)` forwards a `ref`/`out` parameter by
// KIND now, so the thunk it builds no longer refuses itself. What still has
// to be refused is the target that does not match: `byval` takes an `f64` BY
// VALUE where `Mut` declares `ref f64`, and the signature check runs before
// any thunk exists (`tk_deleg_check_sig`, teko_deleg.tk) -- the same words,
// at the same line, the contextual `Mut m = byval;` gives.
//
// expect-refuse: teko: byval does not match the delegate Mut(ref f64)
// expect-refuse-line: 16
#include "../../lib/rt.tk"

delegate void Mut(ref f64 x);
void byval(f64 x) { }

i64 main() {
    Mut m = new Mut(byval);
    return 0;
}
