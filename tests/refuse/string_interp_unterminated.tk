// string_interp_unterminated.tk -- docs/specs/string.md § 9, N10: a `{`
// opens a hole and the string literal ends before the matching `}` does.
//
// expect-refuse: teko: unterminated interpolation hole
// expect-refuse-line: 11
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    i64 x = 1;
    string s = $"{x";
    i64 len = s.Length;
    return len;
}
