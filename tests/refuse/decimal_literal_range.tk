// decimal_literal_range.tk -- docs/specs/decimal.md § 3: the mantissa is 96
// bits and a literal that needs more is refused where it is written, not
// wrapped. The digits are accumulated into four 32-bit limbs and a carry out of
// the top one is remembered rather than dropped (teko_decimal.tk).
//
// expect-refuse: teko: decimal literal out of range
// expect-refuse-line: 11

#include "decimal.tk"

decimal g = 79228162514264337593543950336m;

i64 main() {
    return 0;
}
