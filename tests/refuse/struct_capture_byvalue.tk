// struct_capture_byvalue.tk -- V6/D108: a struct is captured with `&` and not
// by value. The closure slot's layout is teko_deleg.tk's own and copying a
// struct into it is a seventh landing no crumb of the copy design builds
// (docs/specs/struct-value.md § 7.3), so the by-value capture is refused --
// but with words that name the struct and the road, instead of the generic
// `teko: a value of type S does not convert to i64` it died with before, a
// type the user never wrote. `use (&a)` captures the same struct by reference
// and compiles today (tests/surface_lambda_capture.tk's own shapes).
//
// expect-refuse: teko: a struct is captured with `&`; there is no capture by value of a struct
// expect-refuse-line: 21
#include "../../lib/rt.tk"

struct S { public i64 n; }

delegate i64 Op();

i64 main() {
    S a = new S;
    a.n = 7;
    Op d = new Op(() use (a) => a.n);
    return d();
}
