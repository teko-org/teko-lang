// thiscall_ref_extra.tk -- the UNQUALIFIED form of a virtual call, written
// inside a method of the same class: a different door (`tk_this_emit`,
// teko_this.tk, which runs from a PASS), the same `callp` and the same rule.
// `takei(ref x)` handed an address to an `i64` parameter (measured on
// `d0fbe9a4`: exit 177). D57, Copilot's second pass.
//
// expect-refuse: teko: argument 2 is not passed by reference
// expect-refuse-line: 17
#include "../../lib/rt.tk"

class Box {
    public i64 w;
    public Box(i64 v) { w = v; }
    public virtual i64 takei(i64 n) { return n + 1; }
    public virtual i64 mine() {
        i64 x = 7;
        return takei(ref x);
    }
}

i64 main() {
    Box b = new Box(9);
    return b.mine();
}
