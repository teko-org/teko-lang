// vcall_ref_pointee.tk -- a `ref` argument of a VIRTUAL call answers for its
// POINTEE, by the identity rule every `ref`/`out` argument takes (D51, D57).
// `tk_pty_of` has no arm for an address at all, so the site skipped the check
// entirely and the callee stored eight bytes of `f64` through an `i64` slot.
//
// expect-refuse: teko: a value of type i64 does not convert to f64
// expect-refuse-line: 20
#include "../../lib/rt.tk"

class Box {
    public i64 w;
    public Box(i64 v) { w = v; }
    public virtual i64 bump(ref f64 d) { d = 2.0; return 42; }
}

i64 gi;
i64 main() {
    gi = 3;
    Box b = new Box(9);
    return b.bump(ref gi);
}
