// struct_foreach_readonly_prop.tk -- V6/D108 through the PROPERTY door: a
// `set` writes the receiver's own fields, so `s.P = 9` inside a
// `foreach (S s in a)` reaches the array's row exactly as `s.n = 9` does. It
// compiled and mutated the array before this crumb (measured, exit 9), C#
// names it with the same CS1654 as the field, and it is judged at its own door
// (`tk_prop_use`, teko_prop.tk) -- a property store is a CALL to the accessor,
// not a slot store, so `tk_os_mark` never sees it. The `get` is a read and
// stays legal.
//
// expect-refuse: teko: a foreach variable of struct type is read-only
// expect-refuse-line: 24
#include "../../lib/rt.tk"

struct S {
    public i64 n;
    public i64 P { get { return n; } set { n = value; } }
}

i64 main() {
    S[] a = new S[1];
    a[0] = new S;
    a[0].n = 1;
    foreach (S s in a) {
        s.P = 9;
    }
    return a[0].n;
}
