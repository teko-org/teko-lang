// vcall_global_arg.tk -- a VIRTUAL call's argument is judged like a direct
// call's, whatever the site can type it as. A GLOBAL has its type in a
// pass-time table, so the site that builds the `callp` answers "not known"
// for it: until D57 the reference crossed whole and the callee read a `Box`
// as a `Point`.
//
// expect-refuse: teko: a value of type Box does not convert to Point
// expect-refuse-line: 23
#include "../../lib/rt.tk"

class Point { public i64 x; public Point(i64 v) { x = v; } }

class Box {
    public i64 w;
    public Box(i64 v) { w = v; }
    public virtual i64 take(Point p) { return p.x; }
}

Box gb;
i64 main() {
    gb = new Box(7);
    Box b = new Box(9);
    return b.take(gb);
}
