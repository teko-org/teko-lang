// lambda_field_name_write.tk -- D70: the WRITE twin of `lambda_field_name.tk`
// -- a lambda's own bare name on the LEFT of `=` resolves to the enclosing
// class's own MEMBER, never to a global that merely shares the name.
// `n = x;` inside `arm()`'s own lambda used to write the GLOBAL `n`
// silently: the read half of the identical name already answered the
// FIELD (`tk_lam_member`), so the closure read two different `n`s for one
// spelling, one on each side of `=` -- D70's own adjacent finding, closed
// here (`tk_lam_member_store`, teko_deleg.tk). A lambda captures nothing
// implicitly (D11), so an INSTANCE member is refused exactly as the read
// side already is.
//
// expect-refuse: teko: n is not captured; add it to use (...)
// expect-refuse-line: 24
#include "../../lib/rt.tk"

i64 n = 100;

delegate i64 Op(i64 x);

class Holder {
    public i64 n;
    public Op cb;
    public i64 direct() { return n; }
    public void arm() { this.cb = new Op((i64 x) => { n = x; return n; }); }
}

i64 main() {
    Holder h = new Holder;
    h.n = 1;
    h.arm();
    return h.direct() * 1000 + h.cb(2);
}
