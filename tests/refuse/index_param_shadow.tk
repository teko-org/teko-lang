// index_param_shadow.tk -- D96: an index whose base names a PARAMETER that
// shadows a global array. `tk_bracket`'s index judge (teko_params.tk) runs at
// PARSE time, and a parameter is in no scope table there (teko_struct.tk's own
// invariant), so the site took the global road: `tk_array_maybe_rewrite_index`
// (teko_array.tk) matches `src` by NAME ALONE and built the fixed array's
// address out of the base identifier, which mc's resolver binds to the
// PARAMETER -- the parameter's VALUE used as an address. The program compiled
// and ran wrong, exit 139, and `f(0)` and `f(7)` faulted at 8 and 15.
//
// expect-refuse: teko: `[` needs an array: src
// expect-refuse-line: 16
#include "../../lib/rt.tk"

i64 src[3];

i64 f(i64 src) { return src[0]; }

i64 main() {
    src[0] = 5;
    return f(7);
}
