// string_unknown_member.tk -- a misspelled member of `string` reaches the
// SAME generic "unknown member of <Class>: <name>" row every class member
// lookup already answers with (`teko_expr.tk`). This page's own § 5 writes
// the message as `teko: string has no member Lenght`; the mechanism this
// crumb reuses (no code of its own) answers the wording measured below
// instead, and this fixture pins the ACTUAL one rather than the page's
// prose -- `docs/specs/string.md` is corrected in the same pull request.
//
// expect-refuse: teko: unknown member of string: Lenght
// expect-refuse-line: 16
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    string s = new string("hi");
    i64 n = s.Lenght;
    return n;
}
