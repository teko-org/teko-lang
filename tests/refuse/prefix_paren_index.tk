// prefix_paren_index.tk -- D80: `[` after a parenthesized `-` binds to the
// group, so `(-arr)[0]` is `(-arr)` first -- an array declares no unary `-`
// (`teko_ops.tk`'s own "no operator" rule, unrelated to this crumb and
// pre-existing) -- exactly what C# itself refuses.
//
// Measured: before this fix, the sink read `(-arr)[0]` as `-(arr[0])`,
// which COMPILED and answered the wrong value silently (`arr[0]` negated,
// never the array itself). The fix does not add a refusal of its own: it
// stops sinking, and the array negation already refused everywhere else
// (`i64[] narr = -arr;`) now also catches this receiver.
//
// expect-refuse: teko: i64[] declares no operator `-`
// expect-refuse-line: 20

#include "../../lib/rt.tk"

i64 main() {
    i64[] arr = new i64[3];
    arr[0] = 5;
    i64 v = (-arr)[0];
    return v;
}
