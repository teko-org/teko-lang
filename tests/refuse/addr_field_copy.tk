// addr_field_copy.tk -- D104: the address COPIED into a `uptr` local first.
// `uptr p = &this.n;` puts the field LOAD in the local -- `--dump-ast` at
// `f81e0217` showed `VAR type=uptr name=p / CALL ld64 / BINARY + / ADDR
// name=this / INT val=16` -- so `ld64(p)` then dereferences a value that was
// never an address at all. 233 against a field worth 42.
//
// This is the shape that shows the refusal has to sit at the `.`, not at the
// dereference: by the time `p` is read there is nothing left to judge.
//
// expect-refuse: teko: the address of a field is not taught yet; pass it as `ref` or `out`: n
// expect-refuse-line: 17
#include "../../lib/rt.tk"

class H {
    public i64 n;
    public H() { n = 42; }
    public i64 go() { uptr p = &this.n; return ld64(p); }
}

i64 main() {
    H h = new H();
    return h.go();
}
