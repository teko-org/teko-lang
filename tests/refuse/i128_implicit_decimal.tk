// i128_implicit_decimal.tk -- N6b-2 of docs/specs/small-ints.md (§ 8; D84):
// the `decimal` conversion of an `i128`/`u128` is EXPLICIT only, both
// directions -- the same rule `i128_implicit_f64.tk` measures for `f64`, and
// `decimal x = 5;` already accepted for the SAME reason `decimal.tk`'s own
// header states: the compiler writes the call under the cast the source
// spelled (`tk_prim_cast_check`), and a plain assignment writes no cast.
//
// expect-refuse: teko: a value of type i128 does not convert to decimal
// expect-refuse-line: 16

#include "wide.tk"
#include "decimal.tk"

i64 main() {
    i128 a = 5i;
    decimal d = a;
    if (d == 5m) return 1;
    return 0;
}
