// vcall_ref_missing.tk -- a VALUE handed to a `ref` parameter of a virtual
// call, the mirror of vcall_ref_extra.tk and the dangerous half: the callee
// writes THROUGH the argument, so `b.bump(x)` compiled and stored a double at
// the address the eight bytes of `x` happened to spell (measured on
// `d0fbe9a4`: SIGSEGV). D57, Copilot's second pass.
//
// expect-refuse: teko: argument 2 needs `ref` at the call site
// expect-refuse-line: 20
#include "../../lib/rt.tk"

class Box {
    public i64 w;
    public Box(i64 v) { w = v; }
    public virtual i64 bump(ref f64 d) { d = 2.0; return 42; }
}

i64 main() {
    Box b = new Box(9);
    f64 x = 1.0;
    return b.bump(x);
}
