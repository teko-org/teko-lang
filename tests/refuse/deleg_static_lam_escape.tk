// deleg_static_lam_escape.tk -- the same rule on the STATIC field road
// (`tk_static_use`, teko_access.tk), which D66 opened to a contextual lambda.
// A static outlives every scope in the program, so a capture by reference is
// the one shape it may never hold.
//
// expect-refuse: teko: a lambda that captures by reference cannot leave its scope
// expect-refuse-line: 17

#include "../../lib/rt.tk"

delegate i64 Op(i64 a);

class St { public static Op cb; }

i64 main() {
    i64 acc = 0;
    St.cb = (i64 x) use (&acc) => x + acc;
    return St.cb != null ? 0 : 1;
}
