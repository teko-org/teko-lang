// index_prop_below.tk -- D96, the same over a PROPERTY declared below: the
// getter's own result was read as the array's handle. Exit 139, measured.
//
// expect-refuse: teko: `[` needs an array: src
// expect-refuse-line: 11
#include "../../lib/rt.tk"

i64 src[3];

class H {
    public i64 go() { return src[0]; }
    public i64 src { get { return 9; } }
    public H() { }
}

i64 main() {
    src[0] = 5;
    H h = new H();
    return h.go();
}
