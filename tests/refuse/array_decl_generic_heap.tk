// array_decl_generic_heap.tk -- a heap array of a GENERIC instantiation puts
// `[` right after the type word too. `tk_gen_declstmt` (teko_generic.tk)
// hands its tail to the same `tk_var_after_type` the namespaced case uses,
// so the same fix (the `[` checked ahead of `p_ident()`) refuses this
// spelling the same way, instead of the core's own "name expected".

class Circle { public i64 r; }
class Box<T, const N: i64> {
    T items[N];
    i64 count;
}

// expect-refuse: teko: an array of this type is not taught yet
// expect-refuse-line: 17

i64 main() {
    Box<Circle,2>[] bs = new Box<Circle,2>[2];
    return 0;
}
