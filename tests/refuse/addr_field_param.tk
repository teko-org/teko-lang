// addr_field_param.tk -- D104: `&h.n` where `h` is a PARAMETER. A parameter is
// in no parse-time scope table, so the access defers exactly as a local's
// does and reaches the same `tk_pend_field` over an `N_ADDR`: 233 against a
// field worth 42 at `f81e0217`. `ref h.n` / `out h.n` on a parameter is the
// road that works, taught by this same decision --
// `tests/ref_field_param.tk`.
//
// expect-refuse: teko: the address of a field is not taught yet; pass it as `ref` or `out`: n
// expect-refuse-line: 14
#include "../../lib/rt.tk"

class H { public i64 n; public H() { n = 42; } }

i64 peek(H h) { return ld64(&h.n); }

i64 main() {
    H h = new H();
    return peek(h);
}
