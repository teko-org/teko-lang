// i128_cast_decimal.tk -- N6a of docs/specs/small-ints.md (§ 8; D81): the
// `decimal` conversions are N6b's too. The refusal is `decimal`'s own, not
// `i128`'s: `tk_prim_cast_check` (teko_prim.tk) names the TARGET when the
// target is a primitive, and `decimal` has both clauses filled since C5. The
// reverse spelling, `(i128) d`, earns `teko: an i128 does not cast yet` for
// the same missing row.
//
// expect-refuse: teko: a decimal does not cast; `.ToString()` writes it and `decimal.Parse(s)` reads it
// expect-refuse-line: 16

#include "wide.tk"
#include "decimal.tk"

i64 main() {
    i128 a = 5i;
    decimal d = (decimal) a;
    if (d == 0m) return 1;
    return 0;
}
