// i128_literal_range.tk -- N6a of docs/specs/small-ints.md (§ 6; D81): an
// `i128` literal is the MAGNITUDE only, so the ceiling is 2^127-1 and
// 2^127 itself is out of range. A leading `-` is the unary operator applied
// to the value the literal answers, not part of it, which is why
// `i128.MinValue` is written `-170141183460469231731687303715884105727i - 1i`
// until N6b registers the constant. The check is at COMPILE time, on the
// literal's own four 32-bit limbs, and never a silent wrap.
//
// expect-refuse: teko: an i128 literal is out of range
// expect-refuse-line: 15

#include "wide.tk"

i64 main() {
    i128 a = 170141183460469231731687303715884105728i;
    if (a == 0i) return 1;
    return 0;
}
