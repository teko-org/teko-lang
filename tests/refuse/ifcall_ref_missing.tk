// ifcall_ref_missing.tk -- vcall_ref_missing.tk's twin on the ITAB road: a
// value where the interface member declares `ref f64`, which the callee writes
// through (measured on `d0fbe9a4`: SIGSEGV). D57, Copilot's second pass.
//
// expect-refuse: teko: argument 2 needs `ref` at the call site
// expect-refuse-line: 20
#include "../../lib/rt.tk"

interface Sink { i64 bump(ref f64 d); }

class Box : Sink {
    public i64 w;
    public Box(i64 v) { w = v; }
    public i64 bump(ref f64 d) { d = 2.0; return 42; }
}

i64 main() {
    Sink s = new Box(9);
    f64 x = 1.0;
    return s.bump(x);
}
