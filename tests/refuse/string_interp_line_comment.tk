// string_interp_line_comment.tk -- docs/specs/string.md § 9, N10: a `//`
// inside a hole. The handler pushes the whole `+` chain back through the
// lexer as ONE line, so a line comment would comment out the rest of it --
// refused by name rather than silently eating the chain. A BLOCK comment in
// the same position is fine and is proved by tests/surface_string_interp.tk.
//
// expect-refuse: teko: a line comment does not fit in an interpolation hole
// expect-refuse-line: 14
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    i64 x = 1;
    string s = $"{x // note
}";
    return s.Length;
}
