// i128_implicit_f64.tk -- N6b-2 of docs/specs/small-ints.md (§ 8; D84): the
// `f64` conversion of an `i128`/`u128` is EXPLICIT only, both directions, the
// same rule every other row of the conversion table already carries for a
// wide type. `tk_num_wide_widens` (teko_typeof.tk) asks `tk_is_int_ty` of the
// source, which answers 0 for a wide id (D38), so no implicit door opens even
// though the cast table now names the pair -- `tk_prim_cast_lower` is reached
// only from an explicit `N_CAST` node (`tk_prim_cast_check`), and a plain
// assignment never builds one.
//
// expect-refuse: teko: a value of type i128 does not convert to f64
// expect-refuse-line: 17

#include "wide.tk"

i64 main() {
    i128 a = 5i;
    f64 x = a;
    if (x == 5.0) return 1;
    return 0;
}
