// dto_no_include.tk -- § 9: the include is part of the surface. Every row
// names a symbol that lives in `lib/time.tk`, so a program that wrote the
// type word without it is told which file it forgot instead of reaching the
// core's own `call to unknown function` two phases later
// (`tk_prim_need_include`, teko_prim.tk). D76: the include column is bare and
// the message is quoted centrally now (`tk_prim_inc_q`), the same wording
// `TimeSpan`/`DateTime` already carry.
//
// expect-refuse: teko: DateTimeOffset needs #include "time.tk" before it is used
// expect-refuse-line: 15

#include "rt.tk"

i64 main() {
    DateTimeOffset o = DateTimeOffset.MinValue;
    return o.Year;
}
