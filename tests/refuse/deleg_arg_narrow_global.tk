// deleg_arg_narrow_global.tk -- the same judgement through a delegate GLOBAL,
// with a GLOBAL argument: the name is typed by the pass-time table, so the
// park (D57's own, reused by D59) is what answers for it at pass 14.
//
// expect-refuse: teko: a value of type f64 does not convert to i64
// expect-refuse-line: 19

#include "../../lib/rt.tk"

delegate i64 Op(i64 a);

i64 twice(i64 a) { return a + a; }

Op gop;
f64 gf = 12.0;

i64 main() {
    gop = twice;
    return gop(gf);
}
