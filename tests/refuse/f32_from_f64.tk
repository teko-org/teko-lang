// f32_from_f64.tk -- D78: an `f64` value narrows to `f32` in no direction
// without a cast (C# CS0664). A local initializer is the plainest of the
// nine D33 slots.
//
// expect-refuse: teko: a value of type f64 does not convert to f32
// expect-refuse-line: 9

i64 main() {
    f32 c = 2.5;
    return 42;
}
