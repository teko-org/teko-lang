// deleg_elem_arg_narrow.tk -- the ELEMENT road (`tk_ha_deleg_call`,
// teko_heaparr.tk), the third and last builder of a delegate `callp`. It
// exited 0 before, the double's bits truncated to a byte.
//
// expect-refuse: teko: a value of type f64 does not convert to i64
// expect-refuse-line: 18

#include "../../lib/rt.tk"

delegate i64 Op(i64 a);

i64 twice(i64 a) { return a + a; }

i64 main() {
    Op[] ops = new Op[1];
    ops[0] = new Op(twice);
    f64 lf = 8.5;
    return ops[0](lf);
}
