// addr_member_base.tk -- D97: `&n` on a field inherited from a BASE class,
// shadowed by a same-named global. `tk_field_find` walks the bases, so the bare
// READ of `n` answers the base's field (D70's own order); the address road
// answered the global -- measured 100 on `55cdf69e` against a field worth 5.
//
// expect-refuse: teko: the address of a member is not taught yet: n
// expect-refuse-line: 19
#include "../../lib/rt.tk"

i64 n = 100;

class B {
    public i64 n;
    public B() { n = 5; }
}

class D : B {
    public D() { }
    public i64 go() { uptr p = &n; return ld64(p); }
}

i64 main() {
    D d = new D();
    return d.go();
}
