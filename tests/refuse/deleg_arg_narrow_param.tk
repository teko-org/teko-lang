// deleg_arg_narrow_param.tk -- ...and through a delegate PARAMETER, the third
// slot the bare-name road reaches (`tk_deleg_pass`, pass 8).
//
// expect-refuse: teko: a value of type f64 does not convert to i64
// expect-refuse-line: 15

#include "../../lib/rt.tk"

delegate i64 Op(i64 a);

i64 twice(i64 a) { return a + a; }

i64 apply(Op f) {
    f64 lf = 8.5;
    return f(lf);
}

i64 main() {
    return apply(twice);
}
