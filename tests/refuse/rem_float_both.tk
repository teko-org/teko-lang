// rem_float_both.tk -- D95, the third mirror shape and the variable form:
// `f64 % f64` already failed at the mc level too (`mc: no float remainder`,
// no `file:line`); this covers both operands typed `f64` through LOCALS
// rather than literals, so the check reads the static type, not the node
// kind.
//
// expect-refuse: teko: `%` takes no float operand
// expect-refuse-line: 13

i64 main() {
    f64 a = 7.0;
    f64 b = 2.5;
    f64 r = a % b;
    return (i64) r;
}
