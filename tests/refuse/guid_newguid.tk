// guid_newguid.tk -- docs/specs/guid.md § 5: a version-4 `Guid` is sixteen
// bytes of CRYPTOGRAPHIC randomness, which is one `extern` per host and teko's
// own to write (N9). A `Guid` built from a counter, a clock or an address would
// compile and two processes would collide, so there is no fallback -- there is
// a refusal by name, from a `TK_PMSOON` row (teko_guid.tk, D75).
//
// expect-refuse: teko: Guid.NewGuid is not taught yet
// expect-refuse-line: 13

#include "guid.tk"

i64 main() {
    Guid g = Guid.NewGuid();
    return 0;
}
