// lambda_prop_name.tk -- D70: a bare NAME inside a lambda that is an
// INSTANCE property of the enclosing class, read with no arrow written
// around it -- the property's own twin of `lambda_field_name.tk`'s plain
// field. A property is a pair of methods (its own getter dispatches on
// `this`), and `this` is not implicitly captured by a lambda (D11), so it
// is refused by the same sentence a field with no colliding global already
// gives.
//
// expect-refuse: teko: Side is not captured; add it to use (...)
// expect-refuse-line: 21
#include "../../lib/rt.tk"

delegate i64 Op(i64 x);

i64 Side = 200;                          // a global sharing the property's own name

class Gauge2 {
    i64 store;
    public i64 Side { get => store; set => store = value; }
    public Op cb;
    public void arm() { this.cb = new Op((i64 x) => x + Side); }
}

i64 main() {
    Gauge2 g = new Gauge2;
    g.store = 3;
    g.arm();
    return g.cb(1);
}
