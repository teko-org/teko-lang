// string_to_numeric.tk -- N7a adds no code for this: a `string` is a class
// like any other, and D34's own "a reference does not convert to a numeric
// slot" already answers for it the moment the class exists
// (docs/specs/string.md § 5's row, N7a's own share of it).
//
// expect-refuse: teko: a value of type string does not convert to i64
// expect-refuse-line: 13
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    string s = new string("hi");
    i64 n = s;
    return n;
}
