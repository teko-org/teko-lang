// ifcall_global_arg.tk -- an INTERFACE call's argument takes the same
// judgement its vtable twin does (D57). The itab road built its `callp` at
// the same site, with the same parse-time oracle, and let a `Box` global
// cross onto a `Point` parameter.
//
// expect-refuse: teko: a value of type Box does not convert to Point
// expect-refuse-line: 24
#include "../../lib/rt.tk"

class Point { public i64 x; public Point(i64 v) { x = v; } }

interface IT { i64 take(Point p); }

class Box : IT {
    public i64 w;
    public Box(i64 v) { w = v; }
    public i64 take(Point p) { return p.x; }
}

Box gb;
i64 main() {
    gb = new Box(7);
    IT i = new Box(1);
    return i.take(gb);
}
