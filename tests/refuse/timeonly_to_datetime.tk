// timeonly_to_datetime.tk -- `TimeOnly` and `DateTime` do not convert into
// each other either: `DateOnly.ToDateTime(t)` is the one road that builds a
// `DateTime` out of a `TimeOnly`, and `.TimeOfDay`/`TimeOnly.FromDateTime(d)`
// the one back (docs/specs/datetime-extras.md § 4).
//
// expect-refuse: teko: a value of type TimeOnly does not convert to DateTime
// expect-refuse-line: 12

#include "../../lib/time.tk"
i64 main() {
    TimeOnly t = new TimeOnly(13, 45, 30);
    DateTime x = t;
    return 42;
}
