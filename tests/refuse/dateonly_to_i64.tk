// dateonly_to_i64.tk -- the other direction: a `DateOnly` becomes no integer
// without `.DayNumber` (docs/specs/datetime-extras.md § 2).
//
// expect-refuse: teko: a value of type DateOnly does not convert to i64
// expect-refuse-line: 10

#include "../../lib/time.tk"
i64 main() {
    DateOnly d = new DateOnly(2024, 2, 29);
    i64 n = d;
    return 42;
}
