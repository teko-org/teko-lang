// addr_member_lambda.tk -- D97: `&n` on a bare member name INSIDE A LAMBDA. A
// lambda's body is lifted to a top-level function, so teko_this.tk's own arm
// cannot see the enclosing class from there; `tk_lam_walk` (teko_deleg.tk) is
// where D70 judges a bare name in a lambda, and it had the same three arms and
// no `N_ADDR` either. Measured on `55cdf69e`: 100, the global, and no capture
// refusal at all -- `&n` never reached `tk_lam_check_name`, which is what
// refuses the bare READ of an instance member here.
//
// expect-refuse: teko: the address of a member is not taught yet: n
// expect-refuse-line: 20
#include "../../lib/rt.tk"

i64 n = 100;

delegate i64 Op(i64 x);

class H {
    public i64 n;
    public H() { n = 5; }
    public i64 go() { Op f = new Op((i64 x) => ld64(&n) + x); return f(0); }
}

i64 main() {
    H h = new H();
    return h.go();
}
