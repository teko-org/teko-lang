// deleg_new_overload_none.tk -- D67: `new Op(f)` no longer resolves `f` at
// PARSE time, so a genuinely OVERLOADED target is judged by every candidate's
// own signature (`tk_deleg_pick_target`, teko_deleg.tk) rather than whichever
// declaration `decl_find` happens to meet first. Neither arity of `pick`
// matches `Op`'s own two `i64` parameters, so the wrap is refused by name,
// naming the delegate's own signature.
//
// expect-refuse: teko: pick has no overload matching Op(i64, i64)
// expect-refuse-line: 17

delegate i64 Op(i64 a, i64 b);

i64 pick(i64 a) { return a; }
i64 pick(f64 a) { return (i64)a; }

i64 main() {
    Op f = new Op(pick);
    return 0;
}
