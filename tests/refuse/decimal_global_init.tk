// decimal_global_init.tk -- docs/specs/decimal.md § 9 and D77's fifth ruling:
// a `decimal` has no folded form, so a GLOBAL of that type is a slot and an
// assignment and never an initializer. `decimal g = 3.25m;` dies one phase
// earlier with mc's own `global initializer must be constant` -- the literal
// is the `N_IDENT` of its own blob global and `parse_global` (mc src/parse.mc)
// takes none but an `N_INT`.
//
// `decimal g = 5;` is the one spelling that gets PAST that rule, because `5`
// IS an `N_INT`, and the conversion it would need is a call to
// `tk_dec_from_i64` -- which a global initializer may not be either. It is
// refused by name here (teko_rc.tk's own `tk_rc_glb_widen`) instead of being
// rewritten as the `f64` bits the float slot beside it takes.
//
// expect-refuse: teko: a global decimal takes no initializer
// expect-refuse-line: 19

#include "decimal.tk"

decimal g = 5;

i64 main() {
    return 0;
}
