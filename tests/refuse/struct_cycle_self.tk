// struct_cycle_self.tk -- a struct cannot hold a field of its own type. It
// compiled before V1, `next` being the eight-byte pointer D5 gives every struct
// value, and a memberwise copy of it would recurse for ever. C# refuses the same
// shape as CS0523; a linked structure is a `class`
// (docs/specs/struct-value.md § 4.4).
//
// expect-refuse: teko: a struct cannot contain itself
// expect-refuse-line: 11
#include "../../lib/rt.tk"

struct Node {
    public i64 v;
    public Node next;
}

i64 main() {
    Node n = new Node;
    return 42;
}
