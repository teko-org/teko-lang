// string_user_class.tk -- verifier finding 3 of PR #749 (N7b, D88): a
// program that declares a `class string` OF ITS OWN, with no `#include
// "string.tk"` anywhere. `tk_str_class_si` (teko_string.tk) used to look the
// row up by NAME alone, so this class collected the literal conversion and
// `string s = "hi";` compiled against a fabricated global. The lookup now
// asks provenance and layout -- the declaration has to have been read from
// `lib/string.tk`, and the row has to measure the six words the interned
// literal is built out of -- so this is an ordinary user class again and the
// literal refuses on it exactly as it does on any other class.
//
// expect-refuse: teko: a value of type uptr does not convert to string
// expect-refuse-line: 19

#include "rt.tk"

class string { public i64 a; }

i64 main() {
    string s = "hi";
    return 42;
}
