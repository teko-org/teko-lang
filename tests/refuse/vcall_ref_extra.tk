// vcall_ref_extra.tk -- an address handed to a BY-VALUE parameter of a virtual
// call. The direct call has always refused it (`tk_ref_check_call`, teko_ref.tk,
// over the mangled `Owner_method`); a `callp` names no symbol, so that walk
// never reached one and the argument loop compared types alone -- `b.takei(ref x)`
// compiled and the callee read a stack ADDRESS as its `i64` (measured on
// `d0fbe9a4`: exit 209, the low byte of that address). D57, Copilot's second pass.
//
// expect-refuse: teko: argument 2 is not passed by reference
// expect-refuse-line: 21
#include "../../lib/rt.tk"

class Box {
    public i64 w;
    public Box(i64 v) { w = v; }
    public virtual i64 takei(i64 n) { return n + 1; }
}

i64 main() {
    Box b = new Box(9);
    i64 x = 7;
    return b.takei(ref x);
}
