// dto_cast.tk -- docs/specs/datetime-extras.md § 2: sixteen bytes are no
// number, and `DateTimeOffset` teaches both a reader and a builder, so the
// cast refusal names them (`tk_prim_cast_check`, teko_prim.tk, D75's own
// mechanism reused for the third wide type).
//
// expect-refuse: teko: a DateTimeOffset does not cast; `.UtcDateTime` reads it and `new DateTimeOffset(...)` builds it
// expect-refuse-line: 14

#include "rt.tk"
#include "time.tk"

i64 main() {
    DateTimeOffset o = DateTimeOffset.MinValue;
    i64 n = (i64) o;
    return n;
}
