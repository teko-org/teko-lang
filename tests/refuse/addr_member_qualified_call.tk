// addr_member_qualified_call.tk -- D104: `&h.go()` and `&h.Side`, where the
// member under the qualified address is NOT a field.
//
// `&` binds tighter than `.`, so this is `(&h).go()` -- the method is called
// with the local's own SLOT as its receiver. `f81e0217` compiles it and
// answers 243, a wrong exit rather than a fault, and the property spelling
// does the same (both measured). D104's judge refuses every `N_ADDR` receiver,
// so both are covered; the WORDING is the one D97 already wrote, because a
// method and a property have no `ref`/`out` road for the message to name --
// only a field does, and that one gets
// ``teko: the address of a field is not taught yet; pass it as `ref` or `out```
// (`tests/refuse/addr_field_local.tk`). Found by the Copilot review of #770.
//
// expect-refuse: teko: the address of a member is not taught yet: go
// expect-refuse-line: 26
#include "../../lib/rt.tk"

class H {
    public i64 n;
    public H() { n = 42; }
    public i64 go() { return n; }
}

i64 main() {
    H h = new H();
    return ld64(&h.go());
}
