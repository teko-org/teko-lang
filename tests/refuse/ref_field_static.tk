// ref_field_static.tk -- D104: `ref h.tally` on a STATIC field is refused; a
// static's storage is a symbol of its own (`fd_sym_at`), not a word inside the
// object, so `h + fd_off` is not its address at all.
//
// `f81e0217` compiles this program and takes SIGSEGV (exit 139), measured
// through the LOCAL receiver below; the PARAMETER receiver this decision adds
// would have inherited it. `tk_reject_static_member` is the same gate
// `tk_member_of` (teko_expr.tk) already put in front of an ordinary read, now
// asked where both receivers pass. Found by the Copilot review of #770.
//
// expect-refuse: teko: H.tally is static; reach it through its type
// expect-refuse-line: 26
#include "../../lib/rt.tk"

class H {
    public static i64 tally;
    public i64 n;
    public H() { n = 1; }
}

void bump(ref i64 v) { v = v + 1; }

i64 main() {
    H.tally = 41;
    H h = new H();
    bump(ref h.tally);
    return H.tally;
}
