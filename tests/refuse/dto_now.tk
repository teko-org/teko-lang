// dto_now.tk -- Ruling 7 (D76): `DateTimeOffset.Now` needs a wall clock, one
// symbol per host, and is blocked on the same ask `DateTime.Now` already
// makes to `mc`'s own `<sys>` (docs/specs/datetime.md § 8). A `TK_PMSOON` row
// is what makes the site say so by name instead of reading as an unknown
// static member.
//
// expect-refuse: teko: DateTimeOffset.Now is not taught yet
// expect-refuse-line: 14

#include "rt.tk"
#include "time.tk"

i64 main() {
    DateTimeOffset o = DateTimeOffset.Now;
    return 0;
}
