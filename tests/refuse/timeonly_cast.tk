// timeonly_cast.tk -- a cast is the one syntax that would convert what
// converts to nothing but itself, so the surface may not write it; the
// compiler writes its own and knows them apart by node
// (docs/specs/datetime.md § 3, docs/specs/datetime-extras.md § 4). The
// member the message names is the type's OWN reader: a `TimeOnly` has
// `.Ticks`, the same identity `TimeSpan` and `DateTime` read by.
//
// expect-refuse: teko: a TimeOnly does not cast; `.Ticks` reads it and `new TimeOnly(...)` builds it
// expect-refuse-line: 14

#include "../../lib/time.tk"
i64 main() {
    TimeOnly t = new TimeOnly(13, 45, 30);
    i64 n = (i64) t;
    return 42;
}
