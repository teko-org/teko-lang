// i128_cast_str.tk -- N6b-3 of docs/specs/small-ints.md (§ 8; D85): text is
// `.ToString()`/`i128.Parse(s)`, a MEMBER call each, never a cast -- the same
// two-door rule `decimal`'s own `(str) d` refusal already states
// (`tests/refuse/decimal_str_cast.tk`, D79). Filling `i128`'s own reader and
// builder clauses (`tk_i128_init`, `teko_i128.tk`) moves the WORDING of this
// refusal from N6a's shorter "does not cast yet" to the long two-clause form
// -- it does not open the cast: no row of `tk_prim_cast_op` names `str`, so
// `(str) x` still refuses, measured.
//
// expect-refuse: teko: an i128 does not cast; `.ToString()` writes it and `i128.Parse(s)` reads it
// expect-refuse-line: 17

#include "wide.tk"

i64 main() {
    i128 a = 5i;
    str s = (str) a;
    if (s == "5") return 1;
    return 0;
}
