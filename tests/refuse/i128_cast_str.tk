// i128_cast_str.tk -- N6b-2 of docs/specs/small-ints.md (§ 8; D84): `(str) x`
// is still N6b-3's. `f64` and `decimal` each registered a row this crumb
// (`tk_prim_cast_op(ty_f64, tk_ty_i128, ...)`, `tk_prim_cast_op(tk_ty_decimal,
// tk_ty_i128, ...)`), but text is `.ToString()`/`i128.Parse(s)`, and the type
// registers no reader and no builder clause yet (`tk_i128_init`,
// `teko_i128.tk`) -- so `tk_prim_cast_lower` finds no row for this pair and
// `tk_prim_cast_check` falls through to the short wording D74 wrote for a
// wide primitive with an empty member table.
//
// expect-refuse: teko: an i128 does not cast yet
// expect-refuse-line: 17

#include "wide.tk"

i64 main() {
    i128 a = 5i;
    str s = (str) a;
    if (s == "5") return 1;
    return 0;
}
