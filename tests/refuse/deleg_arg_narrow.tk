// deleg_arg_narrow.tk -- an argument passed BY VALUE through a delegate LOCAL
// is judged exactly as the direct call's is (D59): the delegate's own door
// read the `ref`/`out` kind and nothing else, so `f(lf)` handed a double's bit
// pattern to an `i64` parameter and exited 64, where `twice(lf)` on the same
// local is refused with the words below.
//
// expect-refuse: teko: a value of type f64 does not convert to i64
// expect-refuse-line: 19

#include "../../lib/rt.tk"

delegate i64 Op(i64 a);

i64 twice(i64 a) { return a + a; }

i64 main() {
    Op f = twice;
    f64 lf = 8.5;
    return f(lf);
}
