// ifcall_ref_pointee.tk -- the interface twin of the pointee rule: the same
// address, the same identity check, the same wording a direct call gives
// (D51, D57).
//
// expect-refuse: teko: a value of type i64 does not convert to f64
// expect-refuse-line: 21
#include "../../lib/rt.tk"

interface IT { i64 bump(ref f64 d); }

class Box : IT {
    public i64 w;
    public Box(i64 v) { w = v; }
    public i64 bump(ref f64 d) { d = 2.0; return 42; }
}

i64 gi;
i64 main() {
    gi = 3;
    IT i = new Box(9);
    return i.bump(ref gi);
}
