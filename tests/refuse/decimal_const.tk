// decimal_const.tk -- docs/specs/decimal.md § 9 and § 13: a `const` is folded
// at compile time and the folder has no 128-bit arithmetic, so a `decimal` has
// no folded form at all. The literal is an N_IDENT naming the global that holds
// its sixteen bytes, which is not a constant expression, and the refusal is the
// one teko_const.tk already gives (docs/reference/not-yet.md).
//
// expect-refuse: teko: const requires a constant expression
// expect-refuse-line: 12

#include "decimal.tk"

const decimal RATE = 0.07m;

i64 main() {
    return 0;
}
