// guid_add.tk -- docs/specs/guid.md § 3: `==`, `!=` and the four orderings are
// the whole of `Guid`'s operator table. Arithmetic over an identifier means
// nothing, and the pass CLAIMS every binary with a primitive operand, so the
// site is refused where it is written instead of reaching the core's own
// integer add on a sixteen-byte value (teko_prim.tk, teko_ops.tk).
//
// expect-refuse: teko: no operator `+` takes these operands
// expect-refuse-line: 14

#include "guid.tk"

i64 main() {
    Guid a = Guid.Empty;
    Guid b = a + a;
    return 0;
}
