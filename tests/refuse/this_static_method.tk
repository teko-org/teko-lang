// this_static_method.tk -- D87b: a static member takes no receiver at all,
// so `this` has nothing to name there -- measured, not assumed, once `this`
// used as a VALUE was taught to type as the enclosing class (D87). The
// refusal is `tk_this()`'s own (teko_this.tk), unchanged by this crumb: it
// fires while the body is PARSED, before the pass this crumb touches ever
// runs.

#include "../../lib/rt.tk"

class C {
    public i64 v;
    public static i64 Bad() { return this.v; }
}

i64 main() { return 0; }

// expect-refuse: teko: `this` is not there in a static member
