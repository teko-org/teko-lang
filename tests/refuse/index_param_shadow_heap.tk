// index_param_shadow_heap.tk -- D96, the same shadow over a global `T[]` of
// heap: `tk_hg_rewrite_index` (teko_array.tk) matches `src` by name in the
// very same nameless walk, so the run-time-checked load was built over the
// parameter's value as the array's handle. Exit 139, measured.
//
// expect-refuse: teko: `[` needs an array: src
// expect-refuse-line: 12
#include "../../lib/rt.tk"

i64[] src;

i64 f(i64 src) { return src[0]; }

i64 main() {
    src = new i64[3];
    src[0] = 5;
    return f(7);
}
