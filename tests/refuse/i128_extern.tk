// i128_extern.tk -- N6a of docs/specs/small-ints.md (§ 9; D81): the
// sixteen-byte convention is teko's own -- the value moves by ADDRESS and a
// return travels through a program global -- and it is not any C ABI. An
// `extern` naming a wide type in its return or in a parameter is refused by
// name, which is the guard `tk_ov_extern_wide` (teko_over.tk) already had for
// every wide type in the set.
//
// expect-refuse: teko: an `extern` takes no i128
// expect-refuse-line: 13

#include "wide.tk"

extern i128 foreign_add(i128 a, i128 b);

i64 main() {
    return 0;
}
