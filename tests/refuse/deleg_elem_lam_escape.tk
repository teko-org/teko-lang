// deleg_elem_lam_escape.tk -- the ELEMENT road (`tk_ha_index`,
// teko_heaparr.tk), which D66 opened to a contextual lambda. The array
// outlives nothing here, but the rule is syntactic and one wording: an
// element is a slot like a field, and a lambda that derefs a local's own slot
// does not go into one.
//
// expect-refuse: teko: a lambda that captures by reference cannot leave its scope
// expect-refuse-line: 17

#include "../../lib/rt.tk"

delegate i64 Op(i64 a);

i64 main() {
    i64 acc = 0;
    Op[] fs = new Op[1];
    fs[0] = (i64 x) use (&acc) => x + acc;
    return fs[0](1);
}
