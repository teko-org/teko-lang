// guid_cast.tk -- docs/specs/guid.md § 2: a `Guid` casts to nothing. Its
// sixteen bytes are no number, `MTASK_CAST` has no meaning on them, and a cast
// that reached the machine would move eight. Unlike `decimal`, `Guid` teaches
// both directions already, so the refusal names them (teko_prim.tk's two
// clause columns, D75).
//
// expect-refuse: teko: a Guid does not cast; `.ToString()` writes it and `Guid.Parse(s)` reads it
// expect-refuse-line: 14

#include "guid.tk"

i64 main() {
    Guid g = Guid.Empty;
    i64 n = (i64) g;
    return n;
}
