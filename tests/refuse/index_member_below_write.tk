// index_member_below_write.tk -- D96, the WRITE half over the other binding
// the parse cannot see: a FIELD declared BELOW the method that stores through
// its name. The deferred store took the global road and `tk_this_ident`
// (teko_this.tk) then made the base the field's own load, so the store landed
// at whatever the field held.
//
// expect-refuse: teko: `[` needs an array: src
// expect-refuse-line: 14
#include "../../lib/rt.tk"

i64 src[3];

class H {
    public i64 go() { src[0] = 1; return 0; }
    public i64 src;
    public H() { src = 9; }
}

i64 main() {
    H h = new H();
    return h.go();
}
