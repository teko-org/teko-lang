// ref_field_shadow.tk -- D104: a SCALAR local shadowing an object, under
// `ref h.n`. The innermost binding wins, and `tk_ref_addr` (teko_ref.tk) asks
// `tk_slv_find` -- the live-scoped table of EVERY local with its declared type
// -- rather than `tk_local_find` alone, which holds object locals only and so
// could not see the shadow at all.
//
// Two shapes, one question. Over a PARAMETER (`void f(H h) { { i64 h = 0;
// bump(ref h.n); } }`) it was the parameter road this decision opens that
// would have gone wrong, a SIGSEGV found by the review of #770. Over a LOCAL
// -- the shape below -- it is older than this decision: `f81e0217` compiles it
// and takes SIGSEGV (exit 139), adding the field offset to the inner `i64`
// slot and dereferencing that. Both now say the same thing, which is what the
// message already said for every name that is no object in scope.
//
// expect-refuse: teko: not an object of a known type: h
// expect-refuse-line: 27
#include "../../lib/rt.tk"

class H { public i64 n; public H() { n = 41; } }

void bump(ref i64 v) { v = v + 1; }

i64 main() {
    H h = new H();
    {
        i64 h = 0;
        bump(ref h.n);
    }
    return h.n;
}
