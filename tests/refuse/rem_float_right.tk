// rem_float_right.tk -- D95: `%` promotes neither operand (`tk_ops_promotes`,
// teko_ops.tk, leaves it out on purpose -- this backend has no float
// remainder instruction), so `7 % 2.5` used to compile clean and read the
// float's eight bytes as an integer's, exiting 7 where C# gives 2.0. Refused
// outright instead.
//
// expect-refuse: teko: `%` takes no float operand
// expect-refuse-line: 10

i64 main() { f64 r = 7 % 2.5; return (i64) r; }
