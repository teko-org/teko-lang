// guid_no_include.tk -- docs/specs/guid.md § 11: the include is part of the
// surface. Every row names a symbol that lives in `lib/guid.tk`, so a program
// that wrote the type word without it is told which file it forgot instead of
// reaching the core's own `call to unknown function` two phases later
// (teko_prim.tk's `tk_prim_need_include`).
//
// expect-refuse: teko: Guid needs #include guid.tk before it is used
// expect-refuse-line: 13

#include "rt.tk"

i64 main() {
    Guid g = Guid.Empty;
    return 0;
}
