// addr_member_prop.tk -- D97: `ref Side` on a PROPERTY shadowed by a same-named
// global. A property is a pair of accessors and never a slot, so there is no
// address to hand out; on `55cdf69e` the global took the write and the `return`
// read the property, answering 0 while the global became 101.
//
// expect-refuse: teko: the address of a member is not taught yet: Side
// expect-refuse-line: 16
#include "../../lib/rt.tk"

i64 Side = 100;

void bump(ref i64 v) { v = v + 1; }

class H {
    public i64 Side { get; set; }
    public i64 go() { bump(ref Side); return Side; }
}

i64 main() {
    H h = new H();
    return h.go();
}
