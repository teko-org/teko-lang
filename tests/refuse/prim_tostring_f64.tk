// prim_tostring_f64.tk -- D98: `.ToString()` teaches the INTEGER and `char`
// slice, the one interpolation already converts. There is no float formatter
// anywhere in this tree, so `$"{3.5}"` refuses too, and routing `f64` through
// `(decimal)` was measured and REJECTED: it panics on `1.0e30`, on `NaN` and
// on the infinities, and answers 15 digits where C# answers 16.
//
// expect-refuse: teko: f64 has no members: ToString
// expect-refuse-line: 14
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    f64 x = 3.5;
    string s = x.ToString();
    return 0;
}
