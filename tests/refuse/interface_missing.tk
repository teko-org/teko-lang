// interface_missing.tk -- a class declaring an interface it does not fully
// implement is refused.
//
// expect-refuse: teko: method of `IRun` not implemented: run
// expect-refuse-line: 9
#include "../../lib/rt.tk"

interface IRun { i64 run(); }
class Job : IRun { }
i64 main() { Job j = new Job(); return j.run(); }
