// static_field_narrow.tk -- a static field store narrows through the same
// gate an instance field or a local does (D50).
//
// expect-refuse: teko: a value of type f64 does not convert to i64
// expect-refuse-line: 9

class Cfg { public static i64 n; }
i64 main() {
    Cfg.n = 1.5;
    return 42;
}
