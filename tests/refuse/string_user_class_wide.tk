// string_user_class_wide.tk -- the same verifier finding 3 of PR #749, in
// the shape that CRASHED the compiler rather than merely accepting bad code:
// `tk_str_intern_build` sized its word buffer from `sr_size_at` with no
// bound, so a `class string` wide enough (sixteen `i64` fields is nine words
// past the buffer) made the compiler itself segfault. The provenance and
// layout gate keeps that buffer in bounds by construction: a row that is not
// `lib/string.tk`'s own six words is never built into an interned literal at
// all, and the refusal below is the same one the narrow user class gets.
//
// expect-refuse: teko: a value of type uptr does not convert to string
// expect-refuse-line: 23

#include "rt.tk"

class string {
    public i64 f0; public i64 f1; public i64 f2; public i64 f3;
    public i64 f4; public i64 f5; public i64 f6; public i64 f7;
    public i64 f8; public i64 f9; public i64 fa; public i64 fb;
    public i64 fc; public i64 fd; public i64 fe; public i64 ff;
}

i64 main() {
    string s = "hi";
    return 42;
}
