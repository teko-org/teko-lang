// prim_tostring_str.tk -- D98: `str`, `ptr` and `uptr` are ONE core type id
// (types.md § Limits), so no oracle in this language can tell a NUL-terminated
// string from a raw address, and `.ToString()` on one would read whatever the
// address holds. `new string(raw)` is the spelling that carries the guard.
//
// expect-refuse: teko: uptr has no members: ToString
// expect-refuse-line: 13
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    str raw = "ab";
    string s = raw.ToString();
    return 0;
}
