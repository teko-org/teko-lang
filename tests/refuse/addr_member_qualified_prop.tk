// addr_member_qualified_prop.tk -- D104: `&h.Side`, a qualified address over a
// PROPERTY. The sibling of `tests/refuse/addr_member_qualified_call.tk`, which
// covers the method; a refusal stops the compile, so one fixture cannot
// exercise both and the property road would have had no oracle of its own
// (Copilot on #770).
//
// `f81e0217` compiles this and answers 243: `(&h).Side` reads the property
// with the local's own SLOT as its receiver. A property has no `ref`/`out`
// road, so the wording is D97's rather than the field one.
//
// expect-refuse: teko: the address of a member is not taught yet: Side
// expect-refuse-line: 23
#include "../../lib/rt.tk"

class H {
    public i64 n;
    public H() { n = 42; }
    public i64 Side { get => n; }
}

i64 main() {
    H h = new H();
    return ld64(&h.Side);
}
