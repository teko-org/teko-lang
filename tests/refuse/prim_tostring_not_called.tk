// prim_tostring_not_called.tk -- D98: `.ToString` is a METHOD, so the bare
// read is refused the way teko_prim.tk refuses one on a primitive.
//
// expect-refuse: teko: the member is a method; call it with (): ToString
// expect-refuse-line: 11
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    i64 v = 1;
    string s = v.ToString;
    return 0;
}
