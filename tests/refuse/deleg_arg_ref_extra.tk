// deleg_arg_ref_extra.tk -- the mirror: an address handed to a by-value
// parameter, refused in the direct call's own words.
//
// expect-refuse: teko: argument 1 is not passed by reference
// expect-refuse-line: 16

#include "../../lib/rt.tk"

delegate i64 Op(i64 a);

i64 twice(i64 a) { return a + a; }

i64 main() {
    Op f = twice;
    i64 v = 1;
    return f(ref v);
}
