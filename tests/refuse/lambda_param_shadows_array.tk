// lambda_param_shadows_array.tk -- D104: a lambda's own parameter SHADOWS an
// enclosing `T[]` parameter of the same name, so `xs[i]` in the lambda body is
// refused rather than indexing the ENCLOSING array.
//
// The parameter table keeps every open list's rows alive across a nested one
// (`tk_hp_push`/`tk_hp_pop`, teko_struct.tk). `tk_hp_find` therefore has to
// stop at the newest row bearing the name and answer -1 when that row is no
// `T[]`: scanning past it let `(i64 xs)` here fall through to the enclosing
// `i64[] xs` and index it at the scalar's value, a SIGSEGV found by the
// Copilot review of #770. `f81e0217` refuses this program too -- there the
// reset had already wiped the enclosing row -- so the answer is the same one,
// for a reason that now survives the floor. The `(ref i64 xs)` spelling is the
// same question through `tk_hp_shadow`'s row.
//
// expect-refuse: teko: `[` needs an array: xs
// expect-refuse-line: 22
#include "../../lib/rt.tk"

delegate i64 Op(i64 xs);

i64 f(i64[] xs) {
    Op g = new Op((i64 xs) => xs[0] + 1);
    return g(3);
}

i64 main() {
    i64[] a = new i64[2];
    a[0] = 42;
    return f(a);
}
