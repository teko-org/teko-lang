// addr_member_iface.tk -- D97: `&Label` on an interface PROPERTY inside a
// DEFAULT body. `tk_this_iface_fix` (teko_this.tk) is the interface twin of
// `tk_this_fix` and carried the very same three arms; a default body reaches its
// members through the itab, so there is no slot for an address to name. Measured
// on `55cdf69e`: 100, the global, against an implementing `Label` worth 5.
//
// expect-refuse: teko: the address of a member is not taught yet: Label
// expect-refuse-line: 15
#include "../../lib/rt.tk"

i64 Label = 100;

interface Shape {
    i64 Label { get; set; }
    i64 peek() { uptr p = &Label; return ld64(p); }
}

class Sq : Shape {
    public i64 Label { get; set; }
}

i64 main() {
    Sq q = new Sq();
    q.Label = 5;
    Shape s = q;
    return s.peek();
}
