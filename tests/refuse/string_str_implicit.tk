// string_str_implicit.tk -- N7a builds a `string` ONLY through the explicit
// `new string(raw)` (rule 4); the implicit `str` -> `string` conversion of a
// LITERAL is N7b's own (§ 4), so a `str` variable -- literal or not -- still
// fails to fit a `string` slot until N7b lands, the same generic
// "does not convert" row every class/`uptr` mismatch already answers with.
//
// expect-refuse: teko: a value of type uptr does not convert to string
// expect-refuse-line: 14
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    str p = "raw";
    string v = p;
    return 0;
}
