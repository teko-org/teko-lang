// index_member_below.tk -- D96: a FIELD declared BELOW the method that reads
// it, shadowing a global array. The parser has not read the field when
// `tk_bracket` judges `src[0]`, so its member check (teko_params.tk, which
// refuses the very same program when the field is declared ABOVE) finds
// nothing and the global road claims the name; `tk_this_ident` (teko_this.tk)
// then rewrote the base into the FIELD's load, so the field's eight bytes were
// read as the array's handle. Exit 139, measured.
//
// expect-refuse: teko: `[` needs an array: src
// expect-refuse-line: 16
#include "../../lib/rt.tk"

i64 src[3];

class H {
    public i64 go() { return src[0]; }
    public i64 src;
    public H() { src = 9; }
}

i64 main() {
    src[0] = 5;
    H h = new H();
    return h.go();
}
