// ref_into_numeric.tk -- a non-null reference does not convert to a
// numeric slot either (D34).
//
// expect-refuse: teko: a value of type Cell does not convert to i64
// expect-refuse-line: 11
#include "../../lib/rt.tk"

class Cell { public i64 v; }
i64 main() {
    Cell c = new Cell();
    i64 n = c;
    return n;
}
