// deleg_arg_ref_pointee.tk -- the same pointee rule on the bare-name road,
// which D57 already judged INLINE at pass 8 and D59 moved onto the shared park
// at pass 14: the refusal and its line are exactly where they were.
//
// expect-refuse: teko: a value of type i64 does not convert to f64
// expect-refuse-line: 17

#include "../../lib/rt.tk"

delegate void Mut(ref f64 x);

void bumpf(ref f64 x) { x = x + 1.0; }

i64 main() {
    Mut m = bumpf;
    i64 g = 0;
    m(ref g);
    return g;
}
