// index_param_shadow_heap_write.tk -- D96, the WRITE half over a global `T[]`
// of heap, and in its COMPOUND form: `tk_hg_resolve_write` (teko_array.tk)
// takes the base by name through `tk_hg_find`, so `src[0] += 2` read and wrote
// through the parameter's value as the array's handle. Marked beside the rest.
//
// expect-refuse: teko: `[` needs an array: src
// expect-refuse-line: 12
#include "../../lib/rt.tk"

i64[] src;

i64 f(i64 src) { src[0] += 2; return 0; }

i64 main() {
    src = new i64[3];
    return f(7);
}
