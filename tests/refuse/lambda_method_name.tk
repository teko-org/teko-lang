// lambda_method_name.tk -- D70: a bare NAME inside a lambda that is a
// METHOD of the enclosing class, referenced with no call written around it
// -- the method's own IDENT twin of `lambda_method_call.tk`'s CALL. The
// call twin is refused with its own sentence, `a method is not reachable
// from a lambda`, because `use (...)` captures a VALUE and the shape there
// is a call, not a value; a bare method NAME is exactly the value shape
// `use (...)` refuses to have skipped, so `tk_lam_member`'s own generic
// wording answers instead -- the same sentence a plain field with no
// colliding global already gives.
//
// expect-refuse: teko: go is not captured; add it to use (...)
// expect-refuse-line: 20
#include "../../lib/rt.tk"

delegate i64 Op(i64 x);

class Holder4 {
    public Op cb;
    public i64 go(i64 x) { return x + 1; }
    public void arm() { this.cb = new Op((i64 x) => x + go); }
}

i64 main() {
    Holder4 h = new Holder4;
    h.arm();
    return h.cb(9);
}
