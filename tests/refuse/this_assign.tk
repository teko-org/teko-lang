// this_assign.tk -- the receiver is not a slot. `this = o;` compiled SILENTLY
// before D102, with no reference counting at all: the parameter reads `uptr`,
// which `tk_rc_assign` leaves alone, so the store overwrote the receiver and
// neither side's count moved. C# refuses `this = e;` on a class outright.
//
// expect-refuse: teko: `this` is read-only
// expect-refuse-line: 13
#include "../../lib/rt.tk"

class C {
    public i64 v;
    public C() { v = 0; }
    public void Reset(C o) { this = o; }
}
i64 main() {
    C c = new C();
    c.Reset(c);
    return 0;
}
