// string_interp_align.tk -- docs/specs/string.md § 9/§ 10, N10: C#'s
// alignment (`{x,10}`) is not taught -- a hole holds one expression, nothing
// else.
//
// expect-refuse: teko: an interpolation hole holds one expression, no alignment or format specifier
// expect-refuse-line: 12
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    i64 x = 1;
    string s = $"{x,10}";
    i64 len = s.Length;
    return len;
}
