// struct_foreach_readonly_nested.tk -- V6/D108, the NESTED reach of the same
// rule: `t.inner.n = 9` inside a `foreach (T t in a)` writes a struct field of
// the array's own row, one indirection further in. It compiled and mutated the
// array before this crumb (measured, exit 9 where C# answers 1), and it is the
// same C# CS1654. The receiver here is not the element's bare name but a
// `ld64` of it, which is the one call an address spine passes through
// (`tk_fero_root`, teko_struct.tk).
//
// expect-refuse: teko: a foreach variable of struct type is read-only
// expect-refuse-line: 22
#include "../../lib/rt.tk"

struct S { public i64 n; }
struct T { public S inner; }

i64 main() {
    T[] a = new T[1];
    a[0] = new T;
    a[0].inner = new S;
    a[0].inner.n = 1;
    foreach (T t in a) {
        t.inner.n = 9;
    }
    return a[0].inner.n;
}
