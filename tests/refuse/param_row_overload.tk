// param_row_overload.tk -- D104: a declaration's identity is its POINTER, not
// its spelling, so two same-named OVERLOADS never share parameter rows.
//
// `p_decl_name()` answers a fresh pointer per source occurrence -- which is
// exactly what lets `tk_default_param` (teko_default.tk) tell one declaration
// from the next with `owner != tk_dflt_owner`. Comparing the TEXT instead left
// `i64 f(H h)`'s row visible inside the `i64 f()` overload below, which has no
// parameter list to reset the table, and `ref h.n` there built an address for
// a name that declaration never had: with the global `i64 h` for mc to resolve
// it against, `<the global> + OFF` and SIGSEGV, found by the Copilot review of
// #770. `f81e0217` refuses it.
//
// expect-refuse: teko: not an object of a known type: h
// expect-refuse-line: 25
#include "../../lib/rt.tk"

class H { public i64 pad; public i64 n; public H() { pad = 0; n = 41; } }

i64 h = 100;

void bump(ref i64 v) { v = v + 1; }

i64 f(H h) { return h.n; }

i64 f() { bump(ref h.n); return h; }

i64 main() {
    H a = new H();
    return f(a) + f();
}
