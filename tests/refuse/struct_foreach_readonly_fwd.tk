// struct_foreach_readonly_fwd.tk -- V6/D108 through the DEFERRED door: with
// `S` declared BELOW the write, the receiver's type is a forward row the
// parser cannot resolve, so `s.n = 9` is not built as a store at all -- it is
// parked and rebuilt at pass time (`tk_defer_member`, teko_typeof.tk), where
// the `foreach` body's own scope is long gone. The form is therefore judged at
// the PARSE that decides it, which is the only moment both the write and the
// element name are in hand. It compiled and mutated the array before this
// crumb (measured, exit 99, the same answer the locally-declared struct gave).
//
// expect-refuse: teko: a foreach variable of struct type is read-only
// expect-refuse-line: 21
#include "../../lib/rt.tk"

i64 main() {
    S[] a = new S[2];
    a[0] = new S;
    a[0].n = 1;
    a[1] = new S;
    a[1].n = 2;
    foreach (S s in a) {
        s.n = 9;
    }
    return a[0].n * 10 + a[1].n;
}

struct S { public i64 n; }
