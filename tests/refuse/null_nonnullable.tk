// null_nonnullable.tk -- `null` only fits a slot declared `T?`; a plain
// reference slot refuses it (D43).
//
// expect-refuse: teko: null needs a slot declared Cell?
// expect-refuse-line: 10
#include "../../lib/rt.tk"

class Cell { public i64 v; }
i64 main() {
    Cell c = null;
    return 42;
}
