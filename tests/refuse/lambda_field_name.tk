// lambda_field_name.tk -- D70: a lambda's own bare name resolves to the
// enclosing class's MEMBER, never to a global that merely shares the name.
// `direct()` reads the field `n` (`tk_this_ident`); a lambda `arm()` builds
// used to read the GLOBAL `n` instead, silently -- the two answers for one
// name this fixture used to let stand (measured on the base tree: 1 and
// 100, neither refused). A lambda captures nothing implicitly (D11), so an
// INSTANCE member is refused exactly as a field with no colliding global
// already was.
//
// expect-refuse: teko: n is not captured; add it to use (...)
// expect-refuse-line: 22
#include "../../lib/rt.tk"

i64 n = 100;

delegate i64 Op(i64 x);

class Holder {
    public i64 n;
    public Op cb;
    public i64 direct() { return n; }
    public void arm() { this.cb = new Op((i64 x) => x + n); }
}

i64 main() {
    Holder h = new Holder;
    h.n = 1;
    h.arm();
    return h.direct() * 1000 + h.cb(0);
}
