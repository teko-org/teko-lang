// lambda_method_call.tk -- D70: a bare CALL inside a lambda whose name is a
// METHOD of the enclosing class, the CALL twin of lambda_field_name.tk's
// own field. `tk_lam_walk` used to look at `N_IDENT` alone, so `go(x)` fell
// to the core's own resolver, which knows no function literally named `go`
// (a method's real symbol is always mangled) and refused `call to unknown
// function` -- the core's wording, never teko's, and a FREE function of the
// same name would have silently answered instead. `this` is not implicitly
// captured (D11), so the instance method is refused by name.
//
// expect-refuse: teko: a method is not reachable from a lambda: go
// expect-refuse-line: 19
#include "../../lib/rt.tk"

delegate i64 Op(i64 x);

class Holder {
    public Op cb;
    public i64 go(i64 x) { return x + 1; }
    public void arm() { this.cb = new Op((i64 x) => go(x)); }
}

i64 main() {
    Holder h = new Holder;
    h.arm();
    return h.cb(9);
}
