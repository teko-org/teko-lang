// ifcall_ref_extra.tk -- vcall_ref_extra.tk's twin on the ITAB road: the
// interface member's own parameter list is what the argument's `ref`/`out` tag
// answers to (`tk_ifargs_check`, teko_iface.tk), and it was never asked --
// `s.takei(ref x)` reached the callee as an address (measured on `d0fbe9a4`:
// exit 209). D57, Copilot's second pass.
//
// expect-refuse: teko: argument 2 is not passed by reference
// expect-refuse-line: 22
#include "../../lib/rt.tk"

interface Sink { i64 takei(i64 n); }

class Box : Sink {
    public i64 w;
    public Box(i64 v) { w = v; }
    public i64 takei(i64 n) { return n + 1; }
}

i64 main() {
    Sink s = new Box(9);
    i64 x = 7;
    return s.takei(ref x);
}
