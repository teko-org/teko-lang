// decimal_shift.tk -- docs/specs/decimal.md § 4: `<<`, `>>`, `&`, `|`, `^` and
// `~` take no `decimal` in C# and take none here. The twelve rows C4 registers
// are the five arithmetic operators, unary `-` and the six comparisons
// (teko_decimal.tk's `tk_dec_ops`); an operator with no row is refused where
// it is written, with teko_ops.tk's own wording.
//
// The integer operand is CONVERTED first (`tk_ops_promote`, D77 ruling 1) and
// the refusal is unchanged by it: a `decimal` on both sides finds no `<<` row
// either way.
//
// expect-refuse: teko: no operator `<<` takes these operands
// expect-refuse-line: 18

#include "decimal.tk"

i64 main() {
    decimal d = 1.5m;
    decimal s = d << 1;
    return 0;
}
