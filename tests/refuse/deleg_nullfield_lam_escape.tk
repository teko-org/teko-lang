// deleg_nullfield_lam_escape.tk -- an `Op?` field is a `TK_KNULL` row of its
// own, and D66's reader takes the row with the `?` peeled off
// (`tk_deleg_row_under`), exactly as the element road's own escape check
// already did: the lambda is READ here, so the escape rule is what answers.
// Were the `?` not peeled, the value would fall to `parse_expr(0)` and die in
// mc's core parser, `expected ) in cast`, with nothing of teko's to say.
//
// expect-refuse: teko: a lambda that captures by reference cannot leave its scope
// expect-refuse-line: 20

#include "../../lib/rt.tk"

delegate i64 Op(i64 a);

class H { public Op? cb; }

i64 main() {
    H h = new H;
    i64 acc = 0;
    h.cb = (i64 x) use (&acc) => x + acc;
    return 0;
}
