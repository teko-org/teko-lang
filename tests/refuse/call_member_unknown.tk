// call_member_unknown.tk -- a CALL receiver whose type is a class is typed by
// the PICK, not by the first declaration of the name (D61, Copilot on #718):
// `cpick(1, 2)` is the two-argument `Box`, and `Box` declares no `pad`, so the
// member is refused BY THAT TYPE. Before the check moved ahead of
// `tk_struct_of_expr` (teko_struct.tk), whose own N_CALL arm is
// `decl_ret(decl_find(name))`, this line COMPILED: it read the Box object at
// `Cell.pad`'s offset, 0, and answered 7 -- Box's own `w` -- out of a program
// that names a member nothing on the receiver declares.
//
// expect-refuse: teko: unknown member of Box: pad
// expect-refuse-line: 22

#include "../../lib/rt.tk"

class Cell { public i64 pad; public i64 w; public Cell() { pad = 100; w = 1; } }
class Box  { public i64 w; public Box() { w = 7; } }

Cell cpick(i64 a)        { return new Cell(); }
Box  cpick(i64 a, i64 b) { return new Box(); }

i64 main() {
    return cpick(1, 2).pad;
}
