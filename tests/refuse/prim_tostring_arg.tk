// prim_tostring_arg.tk -- D98: `.ToString()` takes no argument. C#'s format
// string (`x.ToString("D4")`) is not taught, so it is refused rather than
// silently ignored.
//
// expect-refuse: teko: wrong number of arguments for ToString
// expect-refuse-line: 12
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    i64 v = 1;
    string s = v.ToString(4);
    return 0;
}
