// f32_from_f64_arg.tk -- D78: the same narrowing, through an ARGUMENT: an
// `f64` value cannot land in an `f32` parameter without a cast either, C#
// CS0664 asked at a call site rather than at a declaration.
//
// expect-refuse: teko: a value of type f64 does not convert to f32
// expect-refuse-line: 11

f32 half(f32 x) { return x; }

i64 main() {
    half(2.5);
    return 42;
}
