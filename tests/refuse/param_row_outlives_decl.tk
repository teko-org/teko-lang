// param_row_outlives_decl.tk -- D104: a parameter's row dies with its
// DECLARATION, even when the next declaration has no parameter list to reset
// the table.
//
// The reset is driven by the list (`tk_default_param` for a free function,
// `tk_params` for a member), and a free function spelled `()` has no list to
// drive it -- so its body read the PREVIOUS declaration's rows. With a
// same-named GLOBAL for mc to resolve the identifier against, the address
// built was `<the global> + OFF`: SIGSEGV at `f81e0217` on the `T[]` road
// (`i64 first(i64[] xs) {…} i64 second() { return xs[0]; }` beside a global
// `i64 xs`), and the parameter road would have inherited it -- found by the
// Copilot review of #770. `tk_hp_own` records the declaration the rows belong
// to, `p_decl_name()` is asked again where they are read, and a row of another
// declaration answers nothing.
//
// expect-refuse: teko: not an object of a known type: h
// expect-refuse-line: 28
#include "../../lib/rt.tk"

class H { public i64 pad; public i64 n; public H() { pad = 0; n = 41; } }

i64 h = 100;

void bump(ref i64 v) { v = v + 1; }

i64 first(H h) { return h.n; }

i64 second() { bump(ref h.n); return h; }

i64 main() {
    H a = new H();
    return first(a) + second();
}
