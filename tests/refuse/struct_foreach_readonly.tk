// struct_foreach_readonly.tk -- V6/D108: `foreach (S s in a)` binds `s` to the
// array's OWN row, because the element declaration is the compiler's and D106
// deliberately left it out of the copy pass (`tk_stmt_gen`, teko_loop.tk). So
// a write through `s` mutates the array -- it answered 99 here before this
// crumb -- which C# refuses outright as CS1654, "cannot modify members of `s`
// because it is a foreach iteration variable". The copy that would have made
// the write compile and reach nothing is exactly the bug the design exists to
// remove, so the write is refused instead. Reading `s` stays legal, and
// `S b = s;` inside the body is the road that replaces the write
// (docs/specs/struct-value.md § 4.5, proved in tests/struct_copy_local.tk).
//
// expect-refuse: teko: a foreach variable of struct type is read-only
// expect-refuse-line: 23
#include "../../lib/rt.tk"

struct S { public i64 n; }

i64 main() {
    S[] a = new S[2];
    a[0] = new S;  a[0].n = 1;
    a[1] = new S;  a[1].n = 2;
    foreach (S s in a) {
        s.n = 9;
    }
    return a[0].n * 10 + a[1].n;
}
