// dateonly_from_int.tk -- a `DateOnly` is a type of its own, not a day number
// wearing a name: no integer becomes one without being told to
// (docs/specs/datetime-extras.md § 2). `DateOnly.FromDayNumber(5)` is the road.
//
// expect-refuse: teko: a value of type i64 does not convert to DateOnly
// expect-refuse-line: 10

#include "../../lib/time.tk"
i64 main() {
    DateOnly d = 5;
    return 42;
}
