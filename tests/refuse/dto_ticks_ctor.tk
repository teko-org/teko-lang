// dto_ticks_ctor.tk -- Ruling 1 (D76): C#'s `new DateTimeOffset(i64 ticks,
// TimeSpan)` is NOT taught -- `new DateTimeOffset(new DateTime(t), ts)` is
// the written form (docs/reference/not-yet.md). `tk_prim_pick` picks a "new"
// row by ARGUMENT COUNT alone, and the one row this table has of arity 2
// declares its first position `DateTime`, so an `i64` written there is an
// ordinary argument-type mismatch and not a row of its own.
//
// expect-refuse: teko: a value of type i64 does not convert to DateTime
// expect-refuse-line: 15

#include "rt.tk"
#include "time.tk"

i64 main() {
    DateTimeOffset o = new DateTimeOffset(621355968000000000, TimeSpan.Zero);
    return o.Year;
}
