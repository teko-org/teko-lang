// struct_cycle_mutual.tk -- the mutual case: `A` holds a `B` and `B` holds an
// `A`. `A` closes first and is clean -- `B` carries no field yet at that point --
// so the cycle is only visible at `B`'s own declaration, which is where C#
// reports CS0523 too (docs/specs/struct-value.md § 9, R7).
//
// expect-refuse: teko: a struct cannot contain itself
// expect-refuse-line: 15
#include "../../lib/rt.tk"

struct A {
    public i64 v;
    public B b;
}

struct B {
    public i64 w;
    public A a;
}

i64 main() {
    A x = new A;
    return 42;
}
