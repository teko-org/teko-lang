// ifcall_global_arg_scalar.tk -- the scalar half of the interface road: an
// `f64` global narrows onto an `i64` parameter and is refused there too
// (D33, D57).
//
// expect-refuse: teko: a value of type f64 does not convert to i64
// expect-refuse-line: 21
#include "../../lib/rt.tk"

interface IT { i64 takei(i64 n); }

class Box : IT {
    public i64 w;
    public Box(i64 v) { w = v; }
    public i64 takei(i64 n) { return n; }
}

f64 gf;
i64 main() {
    gf = 1.5;
    IT i = new Box(9);
    return i.takei(gf);
}
