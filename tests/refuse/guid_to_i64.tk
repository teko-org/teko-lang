// guid_to_i64.tk -- the other direction of `guid_from_int.tk`: sixteen bytes
// are no number, and a numeric slot does not take them (docs/specs/guid.md
// § 2, teko_typeof.tk).
//
// expect-refuse: teko: a value of type Guid does not convert to i64
// expect-refuse-line: 12

#include "guid.tk"

i64 main() {
    Guid g = Guid.Empty;
    i64 n = g;
    return n;
}
