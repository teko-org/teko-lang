// lambda_deleg_field_call.tk -- D70: a bare CALL inside a lambda whose name
// is a delegate FIELD of the enclosing class -- the field's own CALL twin
// of `lambda_field_name.tk`'s plain read. D65 opened `cb(x)` for a
// METHOD's own body (`tk_this_deleg_call`); a lambda's generated body is no
// longer inside any method by the time it exists (`tk_lambda_finish`
// promotes it at parse time, well before any pass-time `this` walk ever
// reaches it), so the bare name fell straight through to a FREE function of
// the same name, silently -- the identical silent-shadow D65 closed for
// every OTHER road but this one. `this` is not implicitly captured (D11),
// so the instance field is refused by the same sentence a plain field with
// no colliding global already gives.
//
// expect-refuse: teko: cb is not captured; add it to use (...)
// expect-refuse-line: 24
#include "../../lib/rt.tk"

delegate i64 Op(i64 x);

i64 cb(i64 a) { return a + 100; }        // a FREE function ALSO named `cb`

class Holder3 {
    public Op cb;
    public Op out3;
    public void arm() { this.out3 = new Op((i64 x) => cb(x)); }
}

i64 main() {
    Holder3 h = new Holder3;
    h.cb = new Op(cb);
    h.arm();
    return h.out3(1);
}
