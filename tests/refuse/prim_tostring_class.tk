// prim_tostring_class.tk -- D98 teaches `.ToString()` on a core SCALAR only.
// A class that declares none still has none: no default `ToString` is given to
// a user type by this crumb.
//
// expect-refuse: teko: unknown member of Box: ToString
// expect-refuse-line: 14
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

class Box { public i64 n; public Box(i64 v) { n = v; } }

i64 main() {
    Box b = new Box(1);
    string s = b.ToString();
    return 0;
}
