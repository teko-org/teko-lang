// dto_from_int.tk -- a primitive converts to nothing but itself, in either
// direction (docs/specs/datetime-extras.md § 2): an `i64` into a
// `DateTimeOffset` slot is refused, the same wording `Guid`/`decimal` already
// earn.
//
// expect-refuse: teko: a value of type i64 does not convert to DateTimeOffset
// expect-refuse-line: 13

#include "rt.tk"
#include "time.tk"

i64 main() {
    DateTimeOffset o = 5;
    return 0;
}
