// timeonly_from_int.tk -- a `TimeOnly` is a type of its own, not a tick
// count wearing a name: no integer becomes one without being told to
// (docs/specs/datetime-extras.md § 4). `TimeOnly.FromTimeSpan(ts)` and the
// raw-ticks constructor are the roads.
//
// expect-refuse: teko: a value of type i64 does not convert to TimeOnly
// expect-refuse-line: 11

#include "../../lib/time.tk"
i64 main() {
    TimeOnly t = 5;
    return 42;
}
