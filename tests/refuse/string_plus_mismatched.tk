// string_plus_mismatched.tk -- `operator+(string, string)` is declared and
// nothing else is (§ 8): `string + i64` finds no candidate and falls to the
// generic operator-resolution refusal `teko_ops.tk` already answers with for
// any type that declares an operator over some OTHER pair -- no row of its
// own, no code of this crumb's.
//
// expect-refuse: teko: no operator `+` takes these operands
// expect-refuse-line: 14
#include "../../lib/rt.tk"
#include "../../lib/string.tk"

i64 main() {
    string s = new string("n=");
    string u = s + 5;
    return 0;
}
