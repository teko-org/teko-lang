// addr_field_this.tk -- D104: `&this.n`, the address of a QUALIFIED instance
// field. `&` in mc is a prefix over a bare NAME and binds tighter than `.`, so
// this reads as `(&this).n` and came out as `ld64(&this + 32)` -- a field LOAD
// 32 bytes past `this`'s own STACK SLOT, confirmed in `--dump-ast` as
// `CALL ld64 / BINARY + / ADDR name=this / INT val=32`. Measured at
// `f81e0217`: 176 against a field worth 42, and 233 for the same program with
// the two padding fields removed. The numbers are stack garbage and move with
// the frame, which is why no oracle here names one.
//
// expect-refuse: teko: the address of a field is not taught yet; pass it as `ref` or `out`: n
// expect-refuse-line: 19
#include "../../lib/rt.tk"

class H {
    public i64 a;
    public i64 b;
    public i64 n;
    public H() { a = 1; b = 2; n = 42; }
    public i64 go() { return ld64(&this.n); }
}

i64 main() {
    H h = new H();
    return h.go();
}
