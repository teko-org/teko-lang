// deleg_static_not_deleg.tk -- D65 taught `tk_static_member` (teko_access.tk)
// to take the delegate road for `Type.field(...)` when the static field's type
// names a delegate row. A static field of any other type is left exactly where
// it was: the door falls through to `tk_static_call`, whose pick finds no
// method of that name.
//
// expect-refuse: teko: unknown member: n
// expect-refuse-line: 18

#include "../../lib/rt.tk"

class H {
    public static i64 n;
}

i64 main() {
    H.n = 1;
    return H.n(1);
}
