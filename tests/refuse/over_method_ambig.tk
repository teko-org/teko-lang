// over_method_ambig.tk -- two methods of one name at the SAME arity are two
// declarations with two symbols, and the call between them is refused. A
// method is picked by arity alone, because the parameter types of a candidate
// are what would tell them apart and no module can ask the core for those
// mid-body (D89, `tk_method_pick`).
//
// The refusal lands on the CALL, not on either declaration: declaring the pair
// is legal, as `tests/surface_overload_method.tk` shows by declaring it and
// never calling it. This fixture is that file's missing half.
// expect-refuse: teko: ambiguous overload; two signatures take this many arguments: pick
// expect-refuse-line: 19
#include "../../lib/rt.tk"
class C {
    public i64 pick(i64 a) { return a; }
    public i64 pick(f64 a) { return 1; }
}
i64 main() {
    C c = new C();
    return c.pick(1);
}
