// deleg_this_lam_escape.tk -- the CONSTRUCTOR road, `this.cb = ...`, which
// reaches the same reader the explicit `h.cb = ...` does once `.` has its
// receiver. The field outlives the constructor's own frame, so the local the
// lambda points at is gone by the time anyone calls it.
//
// expect-refuse: teko: a lambda that captures by reference cannot leave its scope
// expect-refuse-line: 18

#include "../../lib/rt.tk"

delegate i64 Op(i64 a);

class H {
    public Op cb;

    public H(i64 k) {
        i64 acc = k;
        this.cb = (i64 x) use (&acc) => x + acc;
    }
}

i64 main() {
    H h = new H(1);
    return h.cb(1);
}
