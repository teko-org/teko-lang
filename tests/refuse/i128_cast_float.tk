// i128_cast_float.tk -- N6a of docs/specs/small-ints.md (§ 8; D81): the
// `f64` conversions are N6b's, in both directions, so the conversion table
// names no float row and the cast is refused by name. `i128` registers no
// reader and no builder clause either (`.ToString()` and `i128.Parse` are
// N6b as well), which is why the wording is the short one D74 wrote for a
// wide primitive with an empty member table.
//
// expect-refuse: teko: an i128 does not cast yet
// expect-refuse-line: 14

#include "wide.tk"

i64 main() {
    i128 a = (i128) 1.5;
    if (a == 0i) return 1;
    return 0;
}
