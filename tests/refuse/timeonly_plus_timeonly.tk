// timeonly_plus_timeonly.tk -- C# declares NO `operator +` between two
// `TimeOnly` values -- adding two times of day is not a time of day -- so the
// table registers only `-` (docs/specs/datetime-extras.md § 3). `.Add(ts)` is
// the form for advancing one by a `TimeSpan`.
//
// expect-refuse: teko: no operator `+` takes these operands
// expect-refuse-line: 13

#include "../../lib/time.tk"
i64 main() {
    TimeOnly a = new TimeOnly(13, 45, 30);
    TimeOnly b = new TimeOnly(1, 0, 0);
    TimeOnly c = a + b;
    return 42;
}
