// array_decl_ns_heap.tk -- a heap array of a NAMESPACED type puts `[` right
// after the type word, before any name is written. `tk_var_after_type`
// (teko_ns.tk) used to call `p_ident()` first and check `[` only after --
// the core's own `p_ident()` answered "name expected" first, with no
// `teko:` prefix and in no catalogue. The `[` is checked ahead of
// `p_ident()` now, so this spelling is refused the same way the FIXED
// spelling (`Geo.Circle cs[2]`) already was.

namespace Geo {
    class Circle { public i64 r; }
}

// expect-refuse: teko: an array of this type is not taught yet
// expect-refuse-line: 17

i64 main() {
    Geo.Circle[] cs = new Geo.Circle[2];
    return 0;
}
