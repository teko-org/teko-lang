// deleg_field_lam_escape.tk -- D66 opened the FIELD road (`tk_field_use`,
// teko_expr.tk) to a contextual lambda; the escape rule that road already
// enforced over `new Op((i64 x) use (&acc) => ...)` is the same one, over the
// same node, and it answers at the store's own line.
//
// expect-refuse: teko: a lambda that captures by reference cannot leave its scope
// expect-refuse-line: 18

#include "../../lib/rt.tk"

delegate i64 Op(i64 a);

class H { public Op cb; }

i64 main() {
    H h = new H;
    i64 acc = 0;
    h.cb = (i64 x) use (&acc) => x + acc;
    return h.cb(1);
}
