// over_ctor_ambig.tk -- the constructor half of the same rule. Two
// constructors at one arity are two symbols, and `new C(1)` cannot choose
// between them: a constructor is picked by arity alone (D89, `tk_ctor_pick`).
//
// The message is its own, not the method one, because the name in it is the
// type's rather than a method's.
// expect-refuse: teko: ambiguous constructor; two of them take this many arguments: C
// expect-refuse-line: 16
#include "../../lib/rt.tk"
class C {
    public i64 v;
    public C(i64 a) { v = a; }
    public C(f64 a) { v = 1; }
}
i64 main() {
    C c = new C(1);
    return c.v;
}
