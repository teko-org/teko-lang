// this_struct_value.tk -- `this` is a value in a class or an interface (D102),
// and in a `struct` it is refused with a sentence of its own (D103). A struct
// has no object header and no reference count, and the language does not copy
// one at assignment yet (`P b = a; b.x = 9;` changes `a.x`), so handing the
// receiver out would alias where C# copies.
//
// The reader used to get `teko: a value of type uptr does not convert to P`,
// raised at the construct that consumed the value and naming the RECEIVER
// PARAMETER's declared type -- a word the source never writes. The refusal is
// now at the `this` itself.
//
// `this.x`, a bare `x` and `this.x = v` inside a struct method are a FIELD
// road, not a value, and keep working (tests/types_struct.tk, and the
// `Set`/`Read` pair below is never reached because the file is refused first).
//
// expect-refuse: teko: `this` is not a value in a struct
// expect-refuse-line: 24
#include "../../lib/rt.tk"

struct P {
    public i64 x;
    public void Set(i64 v) { this.x = v; }               // a field: legal
    public i64 Read() { return this.x; }                 // a field: legal
    public P Self() { return this; }                     // the value: refused
}

i64 main() {
    P p = new P();
    p.Set(7);
    return p.Self().Read();
}
