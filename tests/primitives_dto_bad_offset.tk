// primitives_dto_bad_offset.tk -- docs/specs/datetime-extras.md § 2: an
// offset outside `-14:00 .. +14:00` does not exist, and `new
// DateTimeOffset(DateTime, TimeSpan)` panics where it is built -- the same
// road `new DateTime(2023, 2, 29)` takes for a day that does not exist
// (`tk_dto_check_offset`, lib/time.tk).
//
// expect-exit: 70

#include "rt.tk"
#include "time.tk"

i64 main() {
    DateTime dt = new DateTime(2024, 2, 29, 13, 45, 30);
    DateTimeOffset o = new DateTimeOffset(dt, TimeSpan.FromHours(15));   // past +14:00
    return o.Year;
}
