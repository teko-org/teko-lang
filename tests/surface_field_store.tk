// surface_field_store.tk -- one gate, every site (G-e, D50; D33/D34/D43/D44):
// every field store -- `p.f = e`, `this.f = e` (explicit), the implicit
// `f = e` inside a method or a constructor, and `T.f = e` (a static field,
// both the direct site and its forward-referenced twin) -- passes through the
// SAME `tk_field_store_val` (teko_typeof.tk). Before this crumb only `p.f = e`
// on a receiver the parser could type did: the others built the store CALL
// directly over the source's own value node, with no widening, no narrowing
// refusal and no row check at all -- an integer landing in an `f64` field kept
// its raw bits, silently, through every one of them.
//
// The wrinkle the first pass of this crumb only half closed: the value's own
// TYPE is the one thing a store site may not know. A PARAMETER is in no
// parse-time scope (`tk_slv`'s own rule, D33's "not known here"), an implicit
// `f = e` is rewritten from a pass with its right-hand side still a bare name,
// and a `T.f = e` on a type declared below is resolved one pass ahead of the
// scope that would answer. `-1` is not a licence to write the raw bits: the
// store is DEFERRED and judged once, in `tk_field_store_judge`, with the scope
// alive and the tree resolved -- the discipline D48 wrote for a primitive
// row's argument. Every helper below is a shape that answered -1 at its own
// site.
//
// What each helper proves, in order:
//
//   1. `ctorcheck`   -- `this.rate = k;` in a constructor, `k` an `i64`
//                       PARAMETER: the field reads back 5.0, not the
//                       parameter's raw bits;
//   2. `implcheck`   -- the same store, spelled without `this.` (implicit,
//                       rewritten by the pass rather than by the parser);
//   3. `methodcheck` -- `this.rate = this.rate + 1;` in an ordinary method:
//                       the binary widens its own integer operand (D33,
//                       unchanged by this crumb) and the store keeps the
//                       result;
//   4. `staticcheck` -- `H.total = 3;` then `H.total = H.total + 2;`, a
//                       `static f64` field written and read back through
//                       the same type;
//   5. `nlfieldcheck` -- a `Cell?` instance field written through `this.`
//                       with `null` and then with a live reference, boxing
//                       and unboxing through `.HasValue`/`.Value` (D44);
//   6. `enumcheck`    -- an `enum` instance field written through `this.`
//                       with one of its own members;
//   7. `binarycheck`  -- `this.rate = k + 1;`, an N_BINARY value: no
//                       parse-time oracle types a binary at all;
//   8. `fieldtofieldcheck` -- `rate = step;`, implicit on BOTH sides: the
//                       right-hand side is a bare name until `tk_this_ident`
//                       has rewritten it into the typed load;
//   9. `fwdstaticcheck` -- `H2.total = k;` written where `H2` is declared
//                       BELOW, from a member whose own parameter is the
//                       value: the store is resolved in `tk_fwd_pass`, one
//                       pass before the scope that types `k`;
//  10. `freefncheck`  -- a FREE function's own parameter into a static field
//                       and into an instance one through a local receiver:
//                       no member body is being parsed, so no parse-time
//                       scope ever held that name;
//  11. `boxcheck`     -- an `i64?` field written from a parameter: the Q1b
//                       box is built in the judge, and the raw eight bytes
//                       used to be stored as a handle (a segfault, measured);
//  12. `rccheck`      -- `rt_live()` back to its floor once every object
//                       this file allocated is released.
//
// A refusal has no exit code to assert (D33's own harness note): the
// narrowing refusal, the reference/number mismatch (D34) and `null` in a
// non-`T?` field are probed outside `tests/` and documented as `// no-run`
// in [types.md](../docs/reference/types.md) and
// [diagnostics.md](../docs/reference/diagnostics.md).
//
// Compound assignment on a field (`this.rate += 2;`, `H.total *= 2;`) is
// not taught: the `+=`/`*=` sugar (`<teko-loop-prelude>`) takes a bare NAME
// on its left and refuses anything else, `the rule expected a name on the
// left`, which is unrelated to field-store widening and out of this
// crumb's scope -- helper 3 above writes the same shape out by hand
// instead (`this.rate = this.rate + 1;`).
//
// expect-exit: 42
#include "../lib/rt.tk"

// the two GLOBALS whose names the code below SHADOWS: `k` is every `i64`
// parameter of this file and `step` is class I's own `i64` field. A global is
// in scope in every body, so the pass-time oracle answers `f64` for both
// names -- and that answer is not about the name the store actually writes
// (15, 16). The door asks the PARSE-TIME oracle alone for exactly this
// reason: what it cannot type is deferred, and the judge reads the name once
// it is the parameter's own slot or the field's own load.
f64 k = 1.5;
f64 step = 2.5;

enum Color { Red, Green, Blue }

class Cell {
    public i64 v;
}

// the operator is a `public static` member that names both operands (D8), and
// a store whose value is written with it is an N_BINARY until pass 11 (14).
class GrandBase {
    public i64 v;

    public static i64 operator+(GrandBase g, i64 k) {
        return g.v + k;
    }
}

// two overloaded names, the PICKED signature declared SECOND in each and the
// two orders mirrored, so a store converted by the first declaration is wrong
// in one direction (a float field taking the picked integer raw) and in the
// other (a cast written over a value that is already a float) -- 13.
f64 pick(i64 a) { return 2.5; }
i64 pick(i64 a, i64 b) { return 5; }

i64 qick(i64 a) { return 5; }
f64 qick(i64 a, i64 b) { return 2.5; }

// ...and a third pair whose picked signature returns a ROW: the first
// declaration answers `i64`, which is what the row check read for a value
// `tk_struct_of_expr` cannot see, so `Cell rc; this.rc = rick(1, 2);` was
// refused for a store that is a `Cell` (17).
i64 rick(i64 a) { return 5; }
Cell rick(i64 a, i64 b) {
    Cell c = new Cell();
    c.v = 7;
    return c;
}

class H {
    public f64 rate;
    public static f64 total;
    public Cell? c;
    public Color kind;
    public i64? count;
    public i64 sum;
    public Cell? rc;

    public H(i64 k) {
        this.rate = k;                // 1: explicit `this.f = e`, `e` a parameter
        this.c = null;                // 5a: `null` written through `this.`
        this.count = k;               // 11: the Q1b BOX, built from a parameter
    }

    public void bump() {
        this.rate = this.rate + 1;    // 3: the field read back into its own store
    }

    public void take(Cell cc) {
        this.c = cc;                  // 5b: a live reference boxed into `Cell?`
    }

    public void bumpby(i64 k) {
        this.rate = k + 1;            // 7: an N_BINARY value, typed by no parser
    }

    public void setpick() {
        this.rate = pick(1, 2);       // 13a: the pick returns i64, the field is f64
    }

    public void setqick() {
        this.rate = qick(1, 2);       // 13b: the pick returns f64, no conversion
    }

    public void addop(GrandBase g) {
        this.sum = g + 1;             // 14: `operator+(GrandBase, i64) -> i64`
    }

    public void setrow() {
        this.rc = rick(1, 2);         // 17: the pick returns a ROW, not `i64`
    }
}

class I {
    public f64 rate;
    public i64 step;
    public i64 cnt;

    public I(i64 k) {
        rate = k;                     // 2 and 15: `k` is also a global `f64`
    }

    public void copy() {
        rate = step;                  // 8 and 16: `step` is also a global `f64`
    }

    // the MIRROR of the two above: an `i64` field written from the same two
    // shadowed names, where reading the global's `f64` refuses a store that
    // is an integer instead of writing raw bits.
    public void setcnt() {
        cnt = step;                   // 16b: field to field, `i64` to `i64`
    }

    public void setfrom(i64 k) {
        cnt = k;                      // 15b: parameter to field, `i64` to `i64`
    }
}

// the FORWARD-referenced static twin, for real: `H2` is declared BELOW this
// class, so `H2.total = k` is resolved by `tk_fwd_resolve_static_one`
// (teko_access.tk) in `tk_fwd_pass` -- one pass ahead of the scope that types
// `k`, a member's own parameter (9).
class W {
    public void put(i64 k) { H2.total = k; }
}

class H2 {
    public static f64 total;
}

// a FREE function's own parameter: no member body is being parsed, so nothing
// ever pushed `k` onto a parse-time scope -- into a static field and into an
// instance one through a receiver the parser types (10).
void setstatic(i64 k) { H2.total = k; }

void setinstance(H h, i64 k) {
    H hh = h;                         // a LOCAL: the receiver the PARSER types
    hh.rate = k;                      // 10: `k` is a free function's parameter
}

// the receiver is a PARAMETER, so the parser cannot type it at all and the
// whole access waits for the pass (`tk_pend_field`, teko_typeof.tk) -- the
// sixth site that builds a field store, box included (12).
void setthrough(H h, i64 k) {
    h.rate = k;
    h.count = k;
}

i64 ctorcheck() {
    H h = new H(5);
    if (h.rate != 5.0) return 1;
    return 0;
}

i64 implcheck() {
    I i = new I(5);
    if (i.rate != 5.0) return 1;
    return 0;
}

i64 methodcheck() {
    H h = new H(5);
    h.bump();
    if (h.rate != 6.0) return 1;
    return 0;
}

i64 staticcheck() {
    H.total = 3;
    if (H.total != 3.0) return 1;
    H.total = H.total + 2;
    if (H.total != 5.0) return 2;
    return 0;
}

i64 nlfieldcheck() {
    H h = new H(0);
    if (h.c.HasValue) return 1;       // the constructor's own `this.c = null;`
    Cell cc = new Cell();
    cc.v = 9;
    h.take(cc);
    if (!h.c.HasValue) return 2;
    if (h.c.Value.v != 9) return 3;
    return 0;
}

i64 enumcheck() {
    H h = new H(0);
    h.kind = Color.Green;
    if (h.kind != Color.Green) return 1;
    return 0;
}

i64 boxcheck() {
    H h = new H(5);
    if (!h.count.HasValue) return 1;
    if (h.count.Value != 5) return 2;
    return 0;
}

i64 binarycheck() {
    H h = new H(0);
    h.bumpby(4);
    if (h.rate != 5.0) return 1;
    return 0;
}

i64 fieldtofieldcheck() {
    I i = new I(0);
    i.step = 5;
    i.copy();
    if (i.rate != 5.0) return 1;
    return 0;
}

i64 fwdstaticcheck() {
    W w = new W();
    w.put(5);
    if (H2.total != 5.0) return 1;
    return 0;
}

i64 freefncheck() {
    setstatic(7);
    if (H2.total != 7.0) return 1;
    H h = new H(0);
    setinstance(h, 5);
    if (h.rate != 5.0) return 2;
    return 0;
}

i64 pendcheck() {
    H h = new H(0);
    setthrough(h, 5);
    if (h.rate != 5.0) return 1;
    if (!h.count.HasValue) return 2;
    if (h.count.Value != 5) return 3;
    return 0;
}

i64 pickcheck() {
    H h = new H(0);
    h.setpick();
    if (h.rate != 5.0) return 1;
    h.setqick();
    if (h.rate != 2.5) return 2;
    return 0;
}

i64 opcheck() {
    GrandBase g = new GrandBase();
    g.v = 4;
    H h = new H(0);
    h.addop(g);
    if (h.sum != 5) return 1;
    return 0;
}

// 15/15b and 16/16b: the two SHADOWED roads, in both directions. The store
// the pass rewrites (`tk_this_assign`) reached the door with its value still
// a bare NAME, and the door's pass-time fallback answered about the GLOBAL of
// that name: `rate = step;` was typed `f64` by the global rather than `i64`
// by the field, converted nothing, was not deferred -- measured, the store
// did not land at all and the field kept what the constructor had left in it
// -- and the mirror stores into `cnt` were REFUSED for a narrowing nobody
// wrote. `k` is the same shadow one step over, on a PARAMETER: the pass scope
// answers that one, so it is the guard that the global must never win there.
i64 shadowcheck() {
    I i = new I(5);
    if (i.rate != 5.0) return 1;      // 15: parameter, shadowed by `f64 k`
    i.step = 7;
    i.copy();
    if (i.rate != 7.0) return 2;      // 16: field, shadowed by `f64 step`
    i.setcnt();
    if (i.cnt != 7) return 3;         // 16b: the same name into an `i64` field
    i.setfrom(9);
    if (i.cnt != 9) return 4;         // 15b: the parameter into an `i64` field
    if (k != 1.5) return 5;           // ...and the globals themselves untouched
    if (step != 2.5) return 6;
    return 0;
}

// 17: the picked signature returns a ROW. The row check read the FIRST
// declaration's `i64` for it and refused the store; the judge reads the pick.
i64 rowpickcheck() {
    H h = new H(0);
    h.setrow();
    if (!h.rc.HasValue) return 1;
    if (h.rc.Value.v != 7) return 2;
    return 0;
}

i64 rccheck() {
    if (rt_live() != 0) return 1;
    return 0;
}

i64 main() {
    i64 bad = ctorcheck();
    if (bad != 0) return 10 + bad;

    bad = implcheck();
    if (bad != 0) return 20 + bad;

    bad = methodcheck();
    if (bad != 0) return 30 + bad;

    bad = staticcheck();
    if (bad != 0) return 40 + bad;

    bad = nlfieldcheck();
    if (bad != 0) return 50 + bad;

    bad = enumcheck();
    if (bad != 0) return 60 + bad;

    bad = binarycheck();
    if (bad != 0) return 70 + bad;

    bad = fieldtofieldcheck();
    if (bad != 0) return 80 + bad;

    bad = fwdstaticcheck();
    if (bad != 0) return 90 + bad;

    bad = freefncheck();
    if (bad != 0) return 100 + bad;

    bad = boxcheck();
    if (bad != 0) return 110 + bad;

    bad = pendcheck();
    if (bad != 0) return 120 + bad;

    bad = pickcheck();
    if (bad != 0) return 130 + bad;

    bad = opcheck();
    if (bad != 0) return 140 + bad;

    bad = shadowcheck();
    if (bad != 0) return 150 + bad;

    bad = rowpickcheck();
    if (bad != 0) return 160 + bad;

    bad = rccheck();
    if (bad != 0) return 170 + bad;

    return 42;
}
