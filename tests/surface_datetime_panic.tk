// surface_datetime_panic.tk -- the other half of the calendar
// (docs/specs/datetime.md § 3): a date that does not exist is not a date, and
// C# raises `ArgumentOutOfRangeException` where a wrong calendar would happily
// answer 1 March. A teko program has no exceptions, so the answer is `panic` --
// `teko: a date does not exist`, exit 70, the road `lib/rt.tk`'s own
// `rt_panic` takes for an index past the end of an array.
//
// 2023 IS NOT A LEAP YEAR, so `2023-02-29` is the date the program dies on.
// Every check ABOVE it is one that must NOT fire: the same day one year later
// (2024 is a leap year), both ends of the range, and the two edges of the
// arithmetic that C# accepts. Reaching the panic through one of those would be
// a false positive rather than a proof, which is why the program returns a
// small number from each of them and only then builds the impossible date.
//
// expect-exit: 70

#include "../lib/time.tk"

i64 main() {
    // the leap day that DOES exist, one year on
    DateTime real = new DateTime(2024, 2, 29);
    if (real.Day != 29) return 1;
    if (real.Month != 2) return 2;

    // the two ends of the range, reachable and comparable
    DateTime min = DateTime.MinValue;
    DateTime max = DateTime.MaxValue;
    if (min.Ticks != 0) return 3;
    if (max.Ticks != 3155378975999999999) return 4;
    if (!(min < max)) return 5;
    if ((max - min).Days != 3652058) return 6;

    // ...and the edges of the arithmetic that do not overflow
    if (max.AddTicks(0).Ticks != max.Ticks) return 7;
    if (min.AddDays(0).Ticks != 0) return 8;
    if (new DateTime(9999, 12, 31).Year != 9999) return 9;
    if (new DateTime(1, 1, 1).Ticks != 0) return 10;
    if (DateTime.DaysInMonth(2023, 2) != 28) return 11;

    // ...and the date that does not exist: 2023 is not a leap year
    DateTime impossible = new DateTime(2023, 2, 29);
    return impossible.Day;                        // never reached: the build panicked
}
