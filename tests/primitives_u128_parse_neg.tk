// primitives_u128_parse_neg.tk -- docs/specs/small-ints.md § 7 (N6b-3, D85,
// ruling 1): a leading `-` on a `u128` is a FORMAT failure exactly when the
// magnitude is nonzero -- C#'s own documented `UInt128.Parse("-1")` throws
// `OverflowException`, and `u128.Parse("-0")` succeeds and answers 0
// (`tests/primitives_i128_text.tk`). `rt_panic` exits 70.
//
// expect-exit: 70

#include "rt.tk"
#include "wide.tk"

i64 main() {
    u128 v = u128.Parse("-1");
    if (v == 0u) return 1;
    return 42;
}
