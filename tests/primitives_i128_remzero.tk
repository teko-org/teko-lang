// primitives_i128_remzero.tk -- N6b of docs/specs/small-ints.md (§ 6; D83):
// `x % 0i` panics, the same guard `tk_w_udiv` already gives `/`
// (`tests/primitives_i128_divzero.tk`'s own shape). `%` reuses `tk_w_udiv`'s
// zero check unchanged -- `tk_w_umod`/`tk_w_smod` (`lib/wide.tk`) call it
// before touching either operand's sign.
//
// `teko: division by zero`, exit 70 -- the divisor is behind a function the
// folder cannot see through, so this is measured at RUN time, not refused at
// compile time.
//
// expect-exit: 70

#include "rt.tk"
#include "wide.tk"

i128 zero() { return 0i; }

i64 main() {
    i128 a = 7i;
    i128 r = a % zero();
    // unreachable: the panic above exits 70
    if (r == 0i) return 1;
    return 42;
}
