// surface_string_concat.tk -- N7a of docs/specs/string.md (§ 7-8):
// `operator+`, `string.Concat` beside it, chained concatenation, and the
// four comparison members -- `Equals`, `CompareTo` (ordinal), `==`, `!=` --
// over the prefix case (`"ab"` against `"abc"`, where the shorter loses to
// the longer once the shared bytes run out) and the empty string.
//
// Every operator here is D8's own mechanism: `operator+` and `operator==`
// are `public static` members resolved over both operands, exactly the
// route `tests/surface_operator.tk` already proves for `Vec`, and
// `teko_ops.tk` gains no row for this class at all (§ 12).
//
// expect-exit: 42

#include "rt.tk"
#include "string.tk"

i64 main() {
    string a = new string("foo");
    string b = new string("bar");

    string c = a + b;
    if (c.Length != 6) return 1;
    if ((c == new string("foobar")) != 1) return 2;

    string d = string.Concat(a, b);
    if ((d == c) != 1) return 3;

    string chained = a + b + a;                   // left-to-right, three operands
    if (chained.Length != 9) return 4;
    if ((chained == new string("foobarfoo")) != 1) return 5;

    if (a.Equals(a) != 1) return 6;
    if (a.Equals(b) != 0) return 7;
    if ((a == b) != 0) return 8;
    if ((a != b) != 1) return 9;
    if (a.CompareTo(a) != 0) return 10;

    string ab = new string("ab");
    string abc = new string("abc");
    if (ab.CompareTo(abc) >= 0) return 11;        // the prefix: shorter loses
    if (abc.CompareTo(ab) <= 0) return 12;
    if (ab.CompareTo(ab) != 0) return 13;

    string lo = new string("apple");
    string hi = new string("banana");
    if (lo.CompareTo(hi) >= 0) return 14;         // the first differing byte decides
    if (hi.CompareTo(lo) <= 0) return 15;

    string empty1 = string.Empty;
    string empty2 = new string("");
    if ((empty1 == empty2) != 1) return 16;
    if (empty1.CompareTo(empty2) != 0) return 17;
    if ((empty1 + a).Length != a.Length) return 18;
    if ((a + empty1).Length != a.Length) return 19;

    return 42;
}
