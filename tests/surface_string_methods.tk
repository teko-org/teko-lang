// surface_string_methods.tk -- N8 (docs/specs/string.md § 7, D89): every
// method with its edge cases -- an empty string, an empty needle, a needle
// longer than the haystack, a prefix/suffix at both ends, an all-space
// `Trim`, and `Join` of zero/one/many.
// expect-exit: 42
#include "rt.tk"
#include "string.tk"

i64 main() {
    string s = new string("hello, world");
    string e = new string("");

    // Substring
    if (s.Substring(7) != new string("world")) return 1;
    if (s.Substring(0, 5) != new string("hello")) return 2;
    if (e.Substring(0) != e) return 3;
    if (e.Substring(0, 0) != e) return 4;

    // IndexOf(string) / IndexOf(char)
    if (s.IndexOf(new string("world")) != 7) return 5;
    if (s.IndexOf(new string("zz")) != 0 - 1) return 6;
    if (s.IndexOf(new string("")) != 0) return 7;             // empty needle
    if (s.IndexOf(new string("this needle is far too long")) != 0 - 1) return 8;
    if (s.IndexOfChar('w') != 7) return 9;
    if (s.IndexOfChar('z') != 0 - 1) return 10;

    // LastIndexOf
    string ll = new string("abcabc");
    if (ll.LastIndexOf(new string("abc")) != 3) return 11;
    if (ll.LastIndexOf(new string("zz")) != 0 - 1) return 12;

    // Contains / StartsWith / EndsWith
    if (s.Contains(new string("wor")) != 1) return 13;
    if (s.Contains(new string("zz")) != 0) return 14;
    if (s.Contains(new string("")) != 1) return 15;
    if (s.StartsWith(new string("hello")) != 1) return 16;    // prefix at the start
    if (s.StartsWith(new string("world")) != 0) return 17;
    if (s.EndsWith(new string("world")) != 1) return 18;      // suffix at the end
    if (s.EndsWith(new string("hello")) != 0) return 19;
    if (s.StartsWith(new string("this is far too long")) != 0) return 20;
    if (s.EndsWith(new string("this is far too long")) != 0) return 21;

    // Trim / TrimStart / TrimEnd
    string padded = new string("  hi  ");
    if (padded.Trim() != new string("hi")) return 22;
    if (padded.TrimStart() != new string("hi  ")) return 23;
    if (padded.TrimEnd() != new string("  hi")) return 24;
    string allws = new string("   \t\n  ");
    if (allws.Trim() != e) return 25;                          // all-space

    // ToUpper / ToLower (ASCII only)
    if ((new string("MiXeD")).ToUpper() != new string("MIXED")) return 26;
    if ((new string("MiXeD")).ToLower() != new string("mixed")) return 27;

    // Replace
    if (s.Replace(new string("world"), new string("there")) != new string("hello, there")) return 28;
    if (s.Replace(new string("zz"), new string("--")) != s) return 29;    // no match
    if (s.Replace(new string(""), new string("X")) != s) return 30;       // empty search value

    // PadLeft / PadRight
    if ((new string("7")).PadLeft(3) != new string("  7")) return 31;
    if ((new string("7")).PadRight(3) != new string("7  ")) return 32;
    if (s.PadLeft(1) != s) return 33;                          // already long enough

    // Split
    string[] parts = (new string("a,bb,ccc")).Split(',');
    if (parts.Length != 3) return 34;
    if (parts[0] != new string("a")) return 35;
    if (parts[1] != new string("bb")) return 36;
    if (parts[2] != new string("ccc")) return 37;

    // Join, zero / one / many
    string[] none = new string[0];
    if (string.Join(new string(","), none) != e) return 38;
    string[] one = new string[1];
    one[0] = new string("solo");
    if (string.Join(new string(","), one) != new string("solo")) return 39;
    string[] many = new string[3];
    many[0] = new string("a");
    many[1] = new string("b");
    many[2] = new string("c");
    if (string.Join(new string("-"), many) != new string("a-b-c")) return 40;

    return 42;
}
