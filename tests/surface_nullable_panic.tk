// surface_nullable_panic.tk -- `.Value` on an EMPTY nullable (Q1a,
// docs/specs/nullable.md § 6): a panic, not a wrong pointer. `c.Value`
// rebaixes to `tk_nl_ck(c)`, generated once per unit that spells the member,
// which checks the handle against 0 before handing it back -- through the same
// surface `panic` (lib/rt.tk) every other guard in this port uses, and with
// the same exit 70 (docs/reference/memory.md § Panics).
//
// expect-exit: 70

#include "../lib/rt.tk"

class Cell {
    public i64 v;
    public Cell(i64 x) { v = x; }
}

i64 main() {
    Cell? c = null;
    if (c.HasValue) return 1;                     // the truth value: no guard, no panic
    Cell hard = c.Value;                          // ...and the checked read, which panics
    return hard.v;
}
