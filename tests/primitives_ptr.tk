// primitives_ptr.tk -- ptr/uptr (docs/design/port-teko-mc.md §3, DECISION_LOG
// D131): `ptr` collapses to the SAME opaque pointer the core already names
// `uptr` -- there is no signed/unsigned pointer distinction on this core to
// preserve, so the two words are interchangeable and both take byte
// arithmetic and `ld*`/`st*` the way any `uptr` does.
//
// expect-exit: 42

u8 tbl[8];

ptr at(uptr base, i64 i) {
    return base + i;
}

i64 main() {
    st64(tbl, 42);
    ptr p = at(tbl, 0);
    return ld64(p);
}
