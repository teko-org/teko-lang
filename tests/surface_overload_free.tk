// surface_overload_free.tk -- overload of a top-level function: one
// name, several signatures, no new word. The core gives a name one
// symbol, so the pass gives each signature its own -- `pick(i64)`
// becomes `pick__i64`, `pick(Vec)` `pick__Vec`, `pick(i64, i64)`
// `pick__i64__i64` and `tally()` `tally__void`, the suffix an overloaded
// method already carries (surface_overload_method.tk).
//
// The call site is what chooses: the argument types, from the
// static-type oracle. An integer literal has no type of its own and
// lands on `i64`; a FLOAT literal has one -- `1.5` is a double, as C#
// types it -- and only an `f64` parameter takes it, so `near(1.5)` is
// `near__f64` even with `near(i64)` declared above it, while `near(9)`
// is still `near__i64`. `v` is a `Vec` because its declaration says so, and
// `pick(pick(3, 4))` reads the inner overload's return type -- the inner
// call is resolved before the outer one asks. `steps` calls itself: the
// unit is complete inside a pass, so a recursive site is an ordinary
// site.
//
// A `params T[]` is one signature among the name's (C3), and C#'s own rule
// falls out of the round order: a candidate applicable in its NORMAL form
// wins, and only a call no candidate takes as written asks a list to swallow
// the tail. `span(9)` is `span(i64)`, `span(1, 2)` and `span()` are the list,
// and `span(ready)` -- an `i64[]` already built -- is the list's own normal
// form, without a copy. `mix` is two lists, told apart by their element type;
// `wide` proves a default-completed normal form still beats the expanded one;
// `more` is C#'s last tie-break, the candidate with more declared parameters
// winning between two expanded ones. `sum_cells` carries the same ownership
// rule the list has anywhere else: one reference for the whole chain, and the
// statement that built the array gives it and every element back.
//
// What is not touched is half the point. `plain` has one signature and
// keeps the symbol `_plain`; `chmod` is an `extern` and owns `_chmod`,
// the C ABI and not ours to move; and `steps` is declared by a
// prototype above its definition, so both ends of it get the same new
// symbol. `chmod` is the extern because this fixture can call it on all
// five CI legs: libSystem and glibc have it, and on Windows it is in
// the system layer the link already carries. It returns C `int`, so the
// declaration is `extern i32` (a call reads back what it declares,
// sign-extended). It is asked about a path that does not exist, so it
// changes nothing, and its result is deliberately dropped: the call is
// the whole assertion (the symbol resolved and it ran), while the value
// is not comparable across the five legs -- POSIX answers -1 and the
// Windows shim answers 0, because NTFS has no mode bits to set.
//
// expect-exit: 42

#include "../lib/rt.tk"

extern i32 chmod(uptr path, i64 mode);

struct Vec {
    public i64 x;
    public i64 y;
}

i64 steps(i64 n);

i64 pick(i64 n) {
    return n + 1;
}

i64 pick(Vec v) {
    return v.x + v.y;
}

i64 pick(i64 a, i64 b) {
    return a * b;
}

i64 tally() {
    return 2;
}

i64 tally(i64 k) {
    return k;
}

i64 steps(i64 n) {
    if (n <= 0) return 0;
    i64 m = n - 1;
    return 1 + steps(m);
}

i64 steps(Vec v) {
    return v.x - v.y + 4;
}

i64 plain(i64 n) {
    return n;
}

i64 span(i64 n) {
    return 1000 + n;
}

i64 span(params i64[] xs) {
    i64 s = 0;
    i64 i = 0;
    while (i < xs.Length) {
        s = s + xs[i];
        i = i + 1;
    }
    return 2000 + s;
}

i64 mix(params i64[] xs) {
    return 100 + xs.Length;
}

i64 mix(params f64[] ys) {
    return 200 + ys.Length;
}

i64 wide(i64 a, i64 b = 5) {
    return 300 + a + b;
}

i64 wide(params i64[] xs) {
    return 400 + xs.Length;
}

i64 more(params i64[] xs) {
    return 500 + xs.Length;
}

i64 more(i64 a, params i64[] rest) {
    return 600 + a + rest.Length;
}

// the exact round and a float: `1.5` is a double, C# converts an integer to
// one and nothing back, so the float literal takes the `f64` signature over
// the `i64` one declared before it -- and the integer literal, which carries
// no type of its own, still takes the `i64`
i64 near(i64 n) {
    return 700 + n;
}

i64 near(f64 x) {
    return 800;
}

// `null` needs a slot declared `T?` (Q1a): it lands on the `Cell?` signature
// even with `held(i64)` declared first, never on the integer one -- and never
// on a bare `Cell` one either, which is what makes the pick unambiguous
i64 held(i64 n) {
    return 900 + n;
}

i64 held(Cell? c) {
    if (c == null) return 1000;
    return 1000 + c.Value.get();
}

i64 gone = 0;

class Cell {
    i64 v;

    public Cell(i64 v) { this.v = v; }
    public i64 get() { return v; }
    ~Cell() { gone = gone + 1; }
}

i64 sum_cells(i64 n) {
    return n;
}

i64 sum_cells(params Cell[] cs) {
    i64 s = 0;
    i64 i = 0;
    while (i < cs.Length) {
        s = s + cs[i].get();
        i = i + 1;
    }
    return s;
}

// the fifth round, and the four above it: which form a site is in decides
// which signature it means
i64 listcheck() {
    if (span(9) != 1009) return 1;                // the normal form wins
    if (span(1, 2) != 2003) return 2;             // ...and only then the list
    if (span() != 2000) return 3;                 // an array of length 0

    i64[] ready = new i64[2];
    ready[0] = 4;
    ready[1] = 6;
    if (span(ready) != 2010) return 4;            // the list's own normal form
    if (ready.Length != 2) return 5;              // ...and it was not consumed

    if (mix(1) != 101) return 6;                  // the integer list
    if (mix(1.5) != 201) return 7;                // the float one
    if (mix(1, 2) != 102) return 8;

    if (wide(1) != 306) return 9;                 // a default completes the normal form
    if (wide(1, 2) != 303) return 10;
    if (wide(1, 2, 3) != 403) return 11;          // only the list takes three
    if (wide() != 400) return 12;

    if (more(1, 2) != 602) return 13;             // more declared parameters wins
    return 0;
}

// the float in the exact round: a literal, a local and an expression
i64 floatcheck() {
    if (near(9) != 709) return 1;                 // the integer literal, as before
    if (near(1.5) != 800) return 2;               // the float literal is the f64 one
    f64 x = 2.5;
    if (near(x) != 800) return 3;                 // a value of float type
    if (near(x * 2.0) != 800) return 4;           // ...and an expression of one
    if (held(null) != 1000) return 5;             // `null` is the Cell? one, never held__i64
    if (held(3) != 903) return 6;                 // ...and an integer is still the integer one
    return 0;
}

// the counted element, through the same expansion
i64 cellcheck() {
    if (sum_cells(7) != 7) return 1;              // the scalar signature
    i64 held = rt_live();                         // what the caller holds, `v` included
    if (sum_cells(new Cell(20), new Cell(22)) != 42) return 2;
    if (gone != 2) return 3;                      // the array released its elements
    if (rt_live() != held) return 4;              // ...and the statement released it
    return 0;
}

i64 main() {
    Vec v = new Vec;
    v.x = 4;
    v.y = 6;

    if (pick(9) != 10) return 1;                  // pick__i64
    if (pick(v) != 10) return 2;                  // pick__Vec
    if (pick(3, 4) != 12) return 3;               // pick__i64__i64
    if (pick(pick(3, 4)) != 13) return 4;         // the inner call types the outer

    if (tally() != 2) return 5;                   // tally__void
    if (tally(5) != 5) return 6;

    if (steps(3) != 3) return 7;                  // recursive, rewritten in place
    if (steps(v) != 2) return 8;                  // ...and its other signature

    if (plain(4) != 4) return 9;                  // one signature: symbol untouched
    chmod("no-such-file.teko", 0);                // an extern: never renamed

    i64 bad = listcheck();
    if (bad != 0) return 10 + bad;

    bad = cellcheck();
    if (bad != 0) return 30 + bad;

    bad = floatcheck();
    if (bad != 0) return 50 + bad;

    return pick(9) + pick(v) + pick(3, 4) + tally() + plain(8);   // 10+10+12+2+8
}
