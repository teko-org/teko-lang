// surface_string_index_oob.tk -- N8 (docs/specs/string.md § 6, D89): `s[Length]`
// panics `teko: string index out of range`, exit 70 -- the guard every `T[]`
// index already carries.
// expect-exit: 70
#include "rt.tk"
#include "string.tk"

i64 main() {
    string s = new string("hi");
    return s[s.Length];
}
