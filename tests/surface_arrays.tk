// surface_arrays.tk -- fixed-size arrays of a scalar element, local and
// global (entrega 5, crumb "arrays", teko_array.tk): `T a[N];`, `a[i]`,
// `a[i] = e`, `a[i] += e`, `a.Length`, three element widths (`u8`/`u16`/
// `i32`, the last one signed), a global with and without an initializer,
// and an array local to a method's own body.
//
// expect-exit: 42

#include "../lib/rt.tk"

i64 sum_local() {
    i64 a[4];
    for (i64 i = 0; i < a.Length; i++) {
        a[i] = i * 2;
    }
    a[0] += 100;
    a[0] -= 100;
    i64 total = 0;
    for (i64 i = 0; i < a.Length; i++) {
        total = total + a[i];
    }
    return total;
}

u8 g[8];
i64 t[] = { 1, 2, 3, 4, 5 };

i64 sum_global() {
    for (i64 i = 0; i < 8; i++) {
        g[i] = i;
    }
    i64 total = 0;
    for (i64 i = 0; i < 8; i++) {
        total = total + g[i];
    }
    for (i64 i = 0; i < 5; i++) {
        total = total + t[i];
    }
    return total;
}

i64 widths() {
    u8 b[3];
    u16 w[3];
    i32 s[3];
    b[0] = 200;
    b[1] = 55;
    w[0] = 40000;
    w[1] = 1000;
    s[0] = 0 - 5;
    s[1] = 10;
    if (s[0] >= 0) return 0 - 1;              // proves ld32 was sign-extended
    i64 sum = 0;
    sum = sum + (i64) (b[0]) + (i64) (b[1]);
    sum = sum + (i64) (w[0]) + (i64) (w[1]);
    sum = sum + s[0] + s[1];
    return sum;
}

class Grid {
    public i64 product3() {
        i64 xs[3];
        xs[0] = 2;
        xs[1] = 3;
        xs[2] = 7;
        i64 p = 1;
        for (i64 i = 0; i < xs.Length; i++) {
            p = p * xs[i];
        }
        return p;
    }
}

i64 main() {
    if (sum_local() != 12) return 1;          // 0 + 2 + 4 + 6
    if (sum_global() != 28 + 15) return 2;     // 0..7 summed, plus 1..5
    if (widths() != 255 + 41000 + 5) return 3;
    Grid gr = new Grid();
    if (gr.product3() != 42) return 4;
    return 42;
}
