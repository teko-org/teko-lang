// surface_nullable_value_panic.tk -- `.Value` on an EMPTY nullable of VALUE
// type (Q1b, docs/specs/nullable.md § 6): a panic, not a load through the
// null handle. `n.Value` rebaixes to `tk_ld(i64, tk_nl_ck(n) + 24)`, and the
// guard runs BEFORE the payload is addressed -- through the same surface
// `panic` (lib/rt.tk) every other guard in this port uses, and with the same
// exit 70 (docs/reference/memory.md § Panics).
//
// `HasValue` and `GetValueOrDefault()` are the two members that never panic,
// and both are asked first, so the exit 70 can only come from `.Value`.
//
// expect-exit: 70

#include "../lib/rt.tk"

i64 main() {
    i64? n = null;
    if (n.HasValue) return 1;                     // the truth value: no guard, no panic
    if (n.GetValueOrDefault() != 0) return 2;     // the default: no guard either
    return n.Value;                               // ...and the checked read, which panics
}
