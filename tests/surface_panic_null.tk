// surface_panic_null.tk -- calling a NULL delegate (K1, D221 §41): a panic,
// not a segfault. `h.cb(1, 2)` rebaixes to `callp(tk_deleg_code(h.cb), ...)`
// (teko_deleg.tk), and `tk_deleg_code` (lib/rt.tk) checks the object
// before ever reading its code pointer, through the same surface `panic`
// (lib/rt.tk) a program may call directly.
//
// The null arrives through a FIELD nobody assigned, which is the first of the
// three roads docs/specs/nullable.md § 9 leaves open on purpose: `rt_alloc`
// hands out zeroed bytes, so a counted field reads as 0 whatever the source
// declared it. That is why the run-time guard stays exactly where it is, and
// why `Op f = null;` -- which this fixture used to write -- is now refused by
// Q1a's own rule instead (`teko: null needs a slot declared Op?`).
//
// expect-exit: 70

#include "../lib/rt.tk"

delegate i64 Op(i64 a, i64 b);

class H {
    public Op cb;
}

i64 main() {
    H h = new H;
    return h.cb(1, 2);
}
