// surface_string_interop.tk -- N7a of docs/specs/string.md (§ 1-3, § 7): the
// one road this crumb builds a `string` with, `new string(raw)` from a
// `str`, measured with `tk_str_len` and copied -- mutating `raw` afterwards
// has no effect on the object, which is the proof rule 4's own "copies" is
// not a claim taken on faith.
//
// `.Length` counts CODE POINTS and `.Utf8Length` counts BYTES (§ 6): the two
// agree on ASCII and differ on a multi-byte string, where one UTF-8 code
// point (`é`, two bytes) sits among ASCII ones.
//
// `.ToString()` answers the identity C# gives it (§ 7): the same bytes,
// `==` against the source. `string.Empty` and `IsNullOrEmpty` are the two
// statics this crumb owes beside `Concat` (`surface_string_concat.tk`'s own
// fixture), the latter over a `string?` -- D43 widens the parameter, since a
// non-nullable `string` slot may not take `null` at all.
//
// expect-exit: 42

#include "rt.tk"
#include "string.tk"

i64 main() {
    u8 raw[3];
    raw[0] = 'h';
    raw[1] = 'i';
    raw[2] = 0;

    string a = new string(raw);
    if (a.Length != 2) return 1;
    if (a.Utf8Length != 2) return 2;

    raw[0] = 'X';                                 // mutate the source afterwards
    if (a.Length != 2) return 3;                  // the object copied, unaffected

    string echoed = a.ToString();
    if ((echoed == a) != 1) return 4;
    if (echoed.Length != 2) return 5;

    string mb = new string("héllo");              // 5 code points, 6 bytes ('é' is two)
    if (mb.Utf8Length != 6) return 6;
    if (mb.Length != 5) return 7;

    string ascii = new string("hello");            // ASCII: the two counts agree
    if (ascii.Length != ascii.Utf8Length) return 8;
    if (ascii.Length != 5) return 9;

    string e = string.Empty;
    if (e.Length != 0) return 10;
    if (e.Utf8Length != 0) return 11;

    if (string.IsNullOrEmpty(e) != 1) return 12;
    if (string.IsNullOrEmpty(ascii) != 0) return 13;
    string? n = null;
    if (string.IsNullOrEmpty(n) != 1) return 14;

    return 42;
}
