// primitives_decimal_places_bad.tk -- docs/specs/decimal.md § 7 (C5, D79): a
// `decimal` carries at most 28 decimal places, so a `places` argument outside
// 0..28 names a value this type has no room for. It is a RUN-TIME guard and
// not a refusal: the argument is an ordinary `i64` and nothing at compile time
// knows what a parameter will hold.
//
// `ToString(places)` shares the very same guard, because it rounds first:
// there is one cause here and therefore one message (D79, ruling 4).
//
// expect-exit: 70

#include "rt.tk"
#include "decimal.tk"

i64 places() { return 29; }

i64 main() {
    decimal d = decimal.Round(1.5m, places());
    if (d == 0m) return 1;
    return 42;
}
