// primitives_float.tk -- f32/f64 (docs/design/port-teko-mc.md §3, `<float>`
// M24) and the bit-reinterpret `wrap`/`unwrap` realizes for them (DECISION_LOG
// D131/D132, lib/rt.tk `tk_f64_bits`/`tk_f64_from_bits`): the same eight
// bytes read back as the other type, no value conversion.
//
// expect-exit: 42

#include "../lib/rt.tk"

i64 main() {
    f64 a = 40.0;
    f64 b = 2.0;
    f64 sum = a + b;
    u64 bits = tk_f64_bits(sum);
    f64 back = tk_f64_from_bits(bits);
    return (i64) back;
}
