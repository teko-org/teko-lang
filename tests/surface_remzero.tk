// surface_remzero.tk -- D82: `%` over a plain integer refuses a zero
// divisor at RUN time, through the same guard as `/` (`teko_ternary.tk`'s
// `tk_div_guard`, shared by both operators since the core hands both to the
// same `sdiv`/`idiv` instruction on every ISA this project targets).
//
// `teko: division by zero`, exit 70.
//
// expect-exit: 70

#include "../lib/rt.tk"

i64 modby(i64 a, i64 n) {
    return a % n;
}

i64 main() {
    i64 r = modby(7, 0);
    // unreachable: the panic above exits 70
    if (r == 7) return 1;
    return 42;
}
