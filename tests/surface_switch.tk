// surface_switch.tk -- `switch` in both of C#'s own spellings
// (teko_switch.tk): the statement lowered to a one-lap loop/if chain
// (multiple case labels, empty-label fall-through, `default` written not
// last, a `when` guard, a `const` as a label, `break 2` crossing a `for`
// and a `switch` inside a method's own body), and the expression as
// sugar over a ternary chain (an initializer, a `return`, one arm's own
// value another switch expression, `or` between labels, `when`, and
// object arms proving no extra allocation). `sum_skip_even_for`/
// `sum_skip_even_while`/`sum_skip_even_loop`, checked below, add
// `continue N`: a bare `continue` written directly in a `case` reaches
// past the switch's own loop into the real one the source meant, inside
// a `for`, a `while` and a bare `loop { }`. `sum_once_per_i` nests a
// bare `loop { }` inside a `for`, with the switch inside the `loop`,
// proving the `continue` still reaches only the innermost of the two.
//
// expect-exit: 42

#include "../lib/rt.tk"

const i64 THREE = 3;

i64 classify(i64 n) {
    i64 r = 0;
    switch (n) {
        case 1:
            r = 10;
            break;
        case 2:
        case THREE:
            r = 20;
            break;
        case 5:
        default:
            r = 99;
            break;
        case 10 when n > 5:
            r = 30;
            break;
        case 20: {
            r = 55;
            break;
        }
    }
    return r;
}

i64 first_hit(i64 target) {
    i64 result = 0 - 1;
    for (i64 i = 0; i < 10; i++) {
        switch (i) {
            case 1:
            case 2:
            case 3:
                if (i == target) {
                    result = i;
                    break 2;
                }
                break;
            default:
                break;
        }
    }
    return result;
}

class Bucket {
    public i64 tag;
    public Bucket(i64 t) { tag = t; }
    public i64 describe() {
        i64 r = 0;
        switch (tag) {
            case 1:
                r = 100;
                break;
            case 2:
                r = 200;
                break;
            default:
                r = 0;
                break;
        }
        return r;
    }
}

i64 calls_switchval = 0;
i64 switchval(i64 v) {
    calls_switchval = calls_switchval + 1;
    return v;
}

i64 pick_by_call(i64 v) {
    return switchval(v) switch { 1 => 100, 2 or 3 => 200, _ when v > 100 => 999, _ => 0 };
}

i64 nested(i64 a, i64 b) {
    return a switch {
        1 => b switch { 1 => 11, _ => 12 },
        _ => 0
    };
}

class Cell {
    public i64 v;
    public Cell(i64 x) { v = x; }
}

i64 pick_cell_v(i64 sel, Cell a, Cell b) {
    Cell picked = sel switch { 1 => a, _ => b };
    return picked.v;
}

// a `continue` in a `case`, inside a `for`: the switch's own loop reaches
// past itself into the `for`'s step, which still runs -- without it `i`
// would never pass an even value and the loop would never end.
i64 sum_skip_even_for(i64 n) {
    i64 s = 0;
    for (i64 i = 1; i <= n; i++) {
        switch (i % 2) {
            case 0:
                continue;
            default:
                break;
        }
        s = s + i;
    }
    return s;
}

// the same `continue` in a `case`, inside a `while`: there is no step to
// reach here, so it restarts the `while`'s own condition check directly.
i64 sum_skip_even_while(i64 n) {
    i64 s = 0;
    i64 i = 0;
    while (i < n) {
        i = i + 1;
        switch (i % 2) {
            case 0:
                continue;
            default:
                break;
        }
        s = s + i;
    }
    return s;
}

// the same `continue` in a `case`, inside a BARE `loop { }`: the mc core
// gives a module no parse-time signal for one, only for `while`/`do`/`for`
// (teko_switch.tk's own header), so this is what proves the tree-walking
// guard sees it as a real loop just the same.
i64 sum_skip_even_loop(i64 n) {
    i64 s = 0;
    i64 i = 0;
    loop {
        if (i >= n) break;
        i = i + 1;
        switch (i % 2) {
            case 0:
                continue;
            default:
                break;
        }
        s = s + i;
    }
    return s;
}

// a bare `loop { }` inside a `for`, with the switch inside the `loop`: the
// `continue` reaches only the INNERMOST loop -- the bare one, not the `for`
// -- so each outer `i` adds itself exactly once, on the inner loop's own odd
// pass.
i64 sum_once_per_i(i64 n) {
    i64 s = 0;
    for (i64 i = 1; i <= n; i++) {
        i64 j = 0;
        loop {
            if (j >= 2) break;
            j = j + 1;
            switch (j % 2) {
                case 0:
                    continue;
                default:
                    break;
            }
            s = s + i;
        }
    }
    return s;
}

i64 main() {
    if (classify(1) != 10) return 1;
    if (classify(2) != 20) return 2;
    if (classify(3) != 20) return 3;
    if (classify(5) != 99) return 4;
    if (classify(7) != 99) return 5;
    if (classify(10) != 30) return 6;
    if (classify(4) != 99) return 7;
    if (classify(20) != 55) return 26;

    if (first_hit(2) != 2) return 8;
    if (first_hit(9) != 0 - 1) return 9;

    Bucket b1 = new Bucket(1);
    Bucket b2 = new Bucket(2);
    Bucket b3 = new Bucket(9);
    if (b1.describe() != 100) return 10;
    if (b2.describe() != 200) return 11;
    if (b3.describe() != 0) return 12;

    calls_switchval = 0;
    if (pick_by_call(2) != 200) return 13;
    if (calls_switchval != 1) return 14;

    calls_switchval = 0;
    if (pick_by_call(1) != 100) return 15;
    if (calls_switchval != 1) return 16;

    calls_switchval = 0;
    if (pick_by_call(9) != 0) return 17;
    if (calls_switchval != 1) return 18;

    if (nested(1, 1) != 11) return 19;
    if (nested(1, 2) != 12) return 20;
    if (nested(2, 1) != 0) return 21;

    {
        Cell a = new Cell(11);
        Cell b = new Cell(22);
        if (pick_cell_v(1, a, b) != 11) return 22;
        if (pick_cell_v(0, a, b) != 22) return 23;
        if (rt_live() != 5) return 24;           // b1, b2, b3, a and b
    }
    if (rt_live() != 3) return 25;               // a and b are gone; b1..b3 remain

    if (sum_skip_even_for(6) != 9) return 27;    // 1 + 3 + 5
    if (sum_skip_even_while(6) != 9) return 28;  // 1 + 3 + 5
    if (sum_skip_even_loop(6) != 9) return 29;   // 1 + 3 + 5
    if (sum_once_per_i(6) != 21) return 30;      // 1 + 2 + 3 + 4 + 5 + 6

    return 42;
}
