// surface_datetime_kind_panic.tk -- the constructor's own range guard, reached
// the one way N2c left open. `DateTimeKind` is an enum now, so a literal in
// the kind slot is refused at compile time (docs/reference/diagnostics.md);
// an explicit cast, C#'s own unchecked road, is what still carries a value
// outside 0..2 into `new DateTime(t, k)`, and `lib/time.tk`'s guard answers
// `teko: a date kind is out of range`, exit 70 (docs/specs/datetime.md § 3).
// The three checks above the panic must NOT fire: every declared member goes
// through the same cast and the same constructor first.
//
// expect-exit: 70
#include "../lib/time.tk"

i64 main() {
    if (new DateTime(1, (DateTimeKind) 0).Kind != DateTimeKind.Unspecified) return 1;
    if (new DateTime(1, (DateTimeKind) 1).Kind != DateTimeKind.Utc) return 2;
    if (new DateTime(1, (DateTimeKind) 2).Kind != DateTimeKind.Local) return 3;
    DateTime bad = new DateTime(1, (DateTimeKind) 7);
    return 4;
}
