// primitives_decimal_out.tk -- `ref decimal` and `out decimal`: a sixteen-byte
// value reached through a POINTER a caller owns (D75, the hole C3 left).
//
// A `ref`/`out` parameter is an ADDRESS (teko_ref.tk), and every indirect
// access of a wide type is a call to the type's own copy helper rather than a
// raw `ld64`/`st64` that would move half the value (`tk_ldn`/`tk_stn`,
// teko_struct.tk, D74). The two meet here: `d = 7m` inside `bump` is
// `tk_dec_st(d, 7m)` and a bare `d` is `tk_dec_ld(d)`, both over the caller's
// own slot, and all sixteen bytes travel.
//
// expect-exit: 42

#include "rt.tk"
#include "decimal.tk"

i64 lo_of(decimal d) { ptr p = &d; return ld64(p); }
i64 hi_of(decimal d) { ptr p = &d; return ld64(p + 8); }
i64 scale_of(decimal d) { return (hi_of(d) >> 32) & 0xff; }

// `out`: the callee owes the write, and the caller's slot is what it writes
void set(out decimal d) { d = 5.5m; }

// `ref`: the callee READS the caller's slot and writes it back
void bump(ref decimal d) {
    decimal cur = d;
    if (lo_of(cur) == 55) d = 12.34m;
    else d = 0m;
}

// a `ref` repassed one level down, and a second parameter beside it
void pass(ref decimal d, i64 k) {
    if (k == 0) return;
    bump(ref d);
}

// the pointee written through a plain local of the caller
i64 main() {
    decimal a;
    set(out a);
    if (lo_of(a) != 55) return 1;
    if (scale_of(a) != 1) return 2;

    bump(ref a);
    if (lo_of(a) != 1234) return 3;
    if (scale_of(a) != 2) return 4;

    decimal b = 5.5m;
    pass(ref b, 1);
    if (lo_of(b) != 1234) return 5;

    decimal c = 9.99m;
    pass(ref c, 0);
    if (lo_of(c) != 999) return 6;               // untouched by a path that writes nothing

    // an element of a local array, and a field, both reached by address
    decimal arr[2];
    set(out arr[1]);
    if (lo_of(arr[1]) != 55) return 7;
    bump(ref arr[1]);
    if (lo_of(arr[1]) != 1234) return 8;

    return 42;
}
