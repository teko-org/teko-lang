// teko_struct.tk -- the type table teko's `struct` and `class` share, and the
// `struct` declaration itself: the first two constructs of the type
// delivery (primitives -> TYPES -> surface), taught from outside `mc`'s `src/` with
// the registrations the mc guide names for a declaration a `#rule` cannot reach
// (docs/guide/30-teaching.md § step 3). The layout machinery is
// `mc/examples/api/oop.mc`'s; `struct` is the case with no vtable, so its
// fields start at offset 0 (`class` is teko_class.tk, and starts at 8).
//
// Form (D213: C-like, the mc core's own spelling -- teko-classic's
// `type X = struct {}` is NOT inherited by this port):
//
//   struct Point {                    #define POINT_X 0
//       i64 x;                        #define POINT_FLAG 8
//       u8  flag;                     #define POINT_SIZE 16
//   }                                 Point point_new()  -> rt_alloc(POINT_SIZE)
//                                     type_new("Point", 8, 8, TK_INT)
//
// A value of struct or class type is a POINTER to the allocation, eight bytes
// wide, the same reference shape `oop.mc` gives a class -- `type_new` rather
// than `type_alias(TY_UPTR)` because the id has to stay DISTINCT: `p.x` needs
// the static type of `p`, and the only place that survives the core's own parse
// of `Point p = new Point;` is the type id on the N_VAR node, which `tk_on_stmt`
// reads back. Width 8, `TK_INT`: a pointer is an integer the core's own
// operators already fit, so no derived machine and no intrinsic is needed.
//
// The runtime belongs to the PROGRAM, not to this file: `Name_new` calls
// `rt_alloc(n)` from `lib/rt.tk`, which hands out `n` zeroed bytes, so a
// field nobody assigned reads as 0 and a reference field reads as null.
//
// A struct body is read by the very machine a class body is read by
// (`tk_member`, teko_class.tk), so a struct declares METHODS -- with the same
// implicit receiver, with default arguments and with overloads -- under one
// difference: no vtable,
// hence no `virtual`/`override` and no trait, both refused by name.

// 32 was the crumb's inherited figure, coupled in lockstep to TK_MAXFWD for
// any plain, non-generic program: every keyword the pre-scan finds becomes
// exactly one row here too (`tk_type_row_new`, called both by a real
// declaration and by a forward placeholder's adoption). D69 raised
// TK_MAXFWD to 256 without raising this one, so a 33rd class already read
// ahead of its use still refused right here, one parse-time step later, at
// the identical count (D69). Raised to 256 to match, so the two ceilings
// stay coupled and the fwd table's own room is not wasted on the earlier
// message alone.
#define TK_MAXSTRUCT 256              // structs, classes and interfaces declared in one source
#define TK_MAXFIELD  256              // fields, summed across all of them
#define TK_MAXLOCAL  256              // locals of struct/class type seen so far
// the type table is METADATA FOR THE WHOLE UNIT, not a per-body budget: every
// load of a `T[]`, of a fixed array and of a field, every box and every
// indirect return spends one row, and they are never released. 256 was the
// crumb's inherited figure and a real program of a few hundred typed reads
// walked into `teko: too many expressions whose type is known` (Copilot on
// #698, pass 6); 4096 rows cost 5 columns x 8 B = 160 KB of the unit's
// reservation, against a worst fixture measured at 239.
#define TK_MAXXT     4096             // expressions whose type this module knows
#define TK_MAXAX     128              // array-field addresses this module handed out
// 128 was inherited from the same era as TK_MAXXT's 256, and the same shape of
// program walks into it: a few classes and a loop body storing objects (D69).
// One row, one i64 column: 4096 rows cost 8 B x 4096 = 32 KB, matching
// TK_MAXXT/TK_MAXFS at the same ceiling for the same reason -- one row per
// counted store in a unit that never releases them.
#define TK_MAXOS     4096             // stores into a slot of counted type
#define TK_MAXSLV    8192             // every local seen via on_stmt, any type (K4's `use`)

// The two answers a registration gives, and they are DIFFERENT questions.
// `pure` is "re-evaluating this node costs nothing", asked by whoever would
// duplicate it; `own` is "the value carries a reference of its own", asked by
// the reclaim. A node may be borrowed and effectful at once -- a store that
// hands its array back is exactly that -- so saying "pure" to mean "borrowed"
// hands out a licence to duplicate a store.
#define TK_BORROWED  0                // the value belongs to whoever it was read from
#define TK_OWNED     1                // the value carries a reference of its own

// teko_generic.tk is included after this file, because a generic body is
// re-parsed by the very machine below; these two are what the declaration of a
// type has to ask it before there is a type at all
i64 tk_gen_find(uptr name);
void tk_gen_record(uptr name, i64 kind, i64 vis, i64 proj, i64 abst, i64 part);

// teko_ns.tk is included after this file: the fallback below is what gives a
// namespaced short type name its identity when the exact scan finds nothing,
// and `tk_ns_qualify` is what `struct`'s own declaration (below) calls on its
// name -- the identity function outside a namespace, so a plain `struct`
// declares exactly as it always has
i64 tk_ns_resolve(uptr curto);
uptr tk_ns_qualify(uptr nome);
uptr tk_ns_qualified_name(uptr nome);
i64 tk_ns_short_known(uptr curto);

// teko_ns.tk's own `using`/namespace-outward search, but landing on a name the
// forward scan (teko_fwd.tk, §50 O1) reserved rather than one a row already
// exists for -- the plain `tk_ns_resolve` above never takes this route, so a
// base class or a constructed value still needs the row WHOLE before it
// resolves (O2/O3)
i64 tk_ns_resolve_fwd(uptr curto);

// teko_fwd.tk is included after this file: the forward scan runs before ANY
// token is read (the whole entry source, §50 (a).4), pre-reserving every
// class/struct/interface/delegate word so a field, a parameter, a return type
// or a local of a type declared BELOW resolves at its first mention.
// `tk_fwd_pending` is what `tk_newname` below asks to accept such a word
// instead of refusing it; `tk_fwd_row`/`tk_fwd_row_by_ty` materialize the
// placeholder row an identity-only site needs, on demand; `tk_fwd_adopt` is
// what the real declaration calls, through `tk_type_add`, once the row is no
// longer a placeholder
i64 tk_fwd_pending(uptr qname);
i64 tk_fwd_row(uptr qname);
i64 tk_fwd_row_by_ty(i64 ty);
void tk_fwd_adopt(i64 si, i64 vis, i64 proj);

// teko_access.tk is included after this file too -- it reads the tables below --
// and these three are what a type declaration has to ask it: the modifier that
// came before the word, whether the file it is written in belongs to the
// project, and the registration of the name itself, which is a word of the
// language in three positions at once (a type, `Name.member`, and the statement
// that starts with either)
i64 tk_take_decl_vis();
i64 tk_take_decl_proj();
i64 tk_type_word(uptr name);

// teko_typeof.tk is included after this file: `p.items[i] = e` below is one of
// the two parse-time field stores, and this is the value it writes -- the two
// scalar verdicts (a float in an integer slot, `null` in a numeric one) and
// C# §10.2.3's own widening of an integer into a float slot, over the row
// check `tk_check_field_store` (this file) already gave it
i64 tk_field_store_val(i64 fty, i64 v, i64 line, uptr fl);

// `top_add` for a declaration GENERATED while one of the program's own is
// still being read -- a thunk built at `new Op(fn)`, the three functions
// `new T[n]` needs, `tk_ix` at an array-field index: every one of them fires
// from an expression INSIDE a body (or inside a parameter list), and
// `top_add` CLEARS `p_decl_name()` as a side effect (mc
// docs/reference/hooks.md § Asking about the parse). The declaration being
// read does not end there, so whoever asks afterwards -- `tk_taint_owner`
// (teko_deleg.tk), `tk_default_param` (teko_default.tk) -- must still get its
// name. Restoring it is what keeps a generator invisible to the parse it
// interrupted (DECISION_LOG.md D27).
//
// Every `top_add` a GENERATOR makes is one of three (K6's own audit), and all
// three go through the pair below (D48, tenth pass):
//
//   (a) top level only -- inside a `class`/`struct` body read by `parse_top`:
//       teko_class.tk's member bodies and constructors, teko_prop.tk's
//       accessors, teko_struct.tk's static field and struct constructor. No
//       declaration of the program's own is open, so there is none to lose:
//       those call `tk_top_emit_as(n, 0)`, which leaves the name cleared
//       exactly as a bare `top_add` did.
//   (b) after the parse, from a `pass()`: teko_di.tk's memoized getter and its
//       slot, teko_params.tk's `params` instance. `p_decl_name()` is 0 already
//       and nobody reads it any more.
//   (c) possibly MID-declaration, fired by an expression: teko_deleg.tk's
//       thunk and its lambda, teko_heaparr.tk's three, `tk_ix` below, and
//       everything `tk_class_close` (teko_class.tk) emits -- a partial class
//       closes at its first `new`, which may stand in any body. Those call
//       `tk_top_emit`, which puts the interrupted declaration's name back.
//       teko_generic.tk's replay is (c) as well and saves `p_decl_name()` with
//       the rest of its scratch instead, so it calls `tk_top_emit_as(n, 0)`:
//       `parse_top` writes the name itself once per declaration the instance
//       produces.
//
// What is NOT a generator, and so is not recorded: teko_ns.tk's two sites. A
// `namespace` body and a namespaced function at top level are declarations the
// PROGRAM wrote, which `tk_ns_rename_decl` mangles two passes later -- the node
// still carries the short name the source spelled when it is added, so
// recording it would reserve `area` for the program that wrote
// `namespace geo { i64 area() }` rather than the `geo__area` the mangling
// produces. That name has its own guard on the pass that writes it.
// ---- the declarations the COMPILER writes (D48, ninth and tenth passes) ----
// These two functions are the one door every GENERATED top-level declaration
// goes through, so they are also the one place that can tell such a declaration
// from one the source wrote. They record both: the NODE, which is the identity
// a later pass asks about, and the NAME, which is what a program may collide
// with. `tk_ov_collect` (teko_over.tk) reads the pair and refuses a
// declaration of the program's own that carries a generated name -- `tkarr_*`,
// `tk_nl_*`, a vtable, `Name__names`, a member's `point_area`, a property's
// `square_get_Side`, a struct's `point_new`, a static field's `point_made`, a
// service's `svc_di_get` -- because the two would otherwise reach the linker as
// one symbol and a call site would pick whichever the tables answered first.
//
// The name alone would not do: a generated declaration carries a generated
// name too, and telling them apart by spelling would reserve a prefix for
// every program, which the compiler's own sources (`tk_nl_box_fn`,
// `tk_nl_boxname`) would then trip over on the bootstrap.
#define TK_MAXEMIT 4096                 // top-level declarations one unit generates (D69; was 512)

uptr tk_emit_name[TK_MAXEMIT];           // the symbol the generator wrote
i64  tk_emit_node[TK_MAXEMIT];           // the node itself, the identity of the row

i64 tk_nemit = 0;

uptr tk_emit_name_at(i64 i) { return ld64(tk_emit_name + i * 8); }
i64  tk_emit_node_at(i64 i) { return ld64(tk_emit_node + i * 8); }

void set_tk_emit_name_at(i64 i, uptr v) { st64(tk_emit_name + i * 8, v); }
void set_tk_emit_node_at(i64 i, i64 v)  { st64(tk_emit_node + i * 8, v); }

// 1 when this very node is one the compiler emitted
i64 tk_emit_is(i64 n) {
    i64 i = 0;
    loop {
        if (i >= tk_nemit) break;
        if (tk_emit_node_at(i) == n) return 1;
        i = i + 1;
    }
    return 0;
}

// 1 when some declaration the compiler emitted carries `name`
i64 tk_emit_owns(uptr name) {
    if (name == 0) return 0;
    if (cstrlen(name) == 0) return 0;
    i64 i = 0;
    loop {
        if (i >= tk_nemit) break;
        if (str_eq(tk_emit_name_at(i), name)) return 1;
        i = i + 1;
    }
    return 0;
}

// the registration, then `top_add`, then the name `owner` the caller says the
// parse is to carry on with: the interrupted declaration's for (c), and 0 --
// what `top_add` leaves behind on its own -- for (a) and (b). A generator that
// produces nothing (`parse_top` answers 0 for a `class`, which adds its own
// members) records nothing; `top_add(0)` is the no-op it already was.
void tk_top_emit_as(i64 n, uptr owner) {
    if (n == 0) { top_add(n); p_set_decl_name(owner); return; }
    if (tk_nemit == TK_MAXEMIT)
        err_at(nd_file(n), nd_line(n), "teko: too many generated declarations in one unit");
    set_tk_emit_name_at(tk_nemit, nd_name(n));
    set_tk_emit_node_at(tk_nemit, n);
    tk_nemit = tk_nemit + 1;
    top_add(n);
    p_set_decl_name(owner);
}

void tk_top_emit(i64 n) { tk_top_emit_as(n, p_decl_name()); }

// what a row of the type table declares: struct/class/interface/delegate share
// the table because a value of any of them is one 8-byte reference, and `.`
// (or `callp`, for a delegate) has to tell them apart
#define TK_KSTRUCT 0
#define TK_KCLASS  1
#define TK_KIFACE  2
#define TK_KDELEG  3
#define TK_KARRAY  4
// docs/specs/enum.md N2a: an `enum` shares this same table -- its name
// reaches `Name.Member` over the identical `syntax_expr`/`syntax_stmt` road a
// class name does -- but it is neither a reference nor 8 bytes wide, so every
// kind check above (`tk_is_class`, `tk_is_counted`, `tk_op_row`'s own callers)
// answers "no" for it by construction: none of them match TK_KENUM.
#define TK_KENUM   5
// docs/specs/nullable.md § 2: `T?` is a SIXTH row kind, made lazily the first
// time a source spells the suffix -- the exact standing `T[]` already has. The
// row records what it encloses (`nl_of` below) and carries the same 8-byte
// handle a reference does, which is what lets `tk_is_counted` answer for a
// nullable row whatever it answers for the row inside it.
#define TK_KNULL   6

// how much of a class has been read: one declared in one place is whole where
// it stands, and a `partial` one stays OPEN until the first use of it closes.
// TK_PFWD (§50 O1) is a fourth state: the row a use materialized ahead of the
// real declaration, adopted in place once that declaration is read.
#define TK_PWHOLE 0
#define TK_POPEN  1
#define TK_PDONE  2
#define TK_PFWD   3

// where a member may be reached from, C#'s three words; a member with no
// modifier at all is `private`
#define TK_VPRIVATE   0
#define TK_VPROTECTED 1
#define TK_VPUBLIC    2

// ...and where a TOP-LEVEL type may be reached from: `internal` is the code of
// the project itself, and it is what a type with no modifier is
#define TK_TINTERNAL 0
#define TK_TPUBLIC   1

uptr sr_name[TK_MAXSTRUCT];
i64  sr_ty[TK_MAXSTRUCT];             // the id type_new returned for the name
i64  sr_size[TK_MAXSTRUCT];
i64  sr_base[TK_MAXSTRUCT];           // the base class, or -1
i64  sr_form[TK_MAXSTRUCT];           // TK_KSTRUCT, TK_KCLASS or TK_KIFACE
i64  sr_nv[TK_MAXSTRUCT];             // how many virtual slots it has, its own and the base's
i64  sr_m0[TK_MAXSTRUCT];             // an interface's slice [m0, m0+mn) of the signature table
i64  sr_mn[TK_MAXSTRUCT];
i64  sr_ni[TK_MAXSTRUCT];             // ...and how many interfaces it implements
i64  sr_vis[TK_MAXSTRUCT];            // TK_TPUBLIC or TK_TINTERNAL
i64  sr_proj[TK_MAXSTRUCT];           // 1 when the project itself declared it
i64  sr_abst[TK_MAXSTRUCT];           // 1 for an `abstract` class: no object, no constructor
i64  sr_part[TK_MAXSTRUCT];           // TK_PWHOLE, TK_POPEN or TK_PDONE
i64  sr_off[TK_MAXSTRUCT];            // where the next field goes: carried across the parts
i64  sr_hline[TK_MAXSTRUCT];          // where the FIRST part was written, which is where a
uptr sr_hfile[TK_MAXSTRUCT];          // ...refusal at closing time is reported
i64  ha_ety[TK_MAXSTRUCT];            // a TK_KARRAY row's own element type (K3, §41)
i64  nl_of[TK_MAXSTRUCT];             // a TK_KNULL row's own enclosed type (Q1a)
i64  tk_nstruct = 0;

uptr fd_name[TK_MAXFIELD];
i64  fd_cls[TK_MAXFIELD];             // the type that declares it: the row this field belongs to
i64  fd_off[TK_MAXFIELD];
i64  fd_ty[TK_MAXFIELD];
i64  fd_nel[TK_MAXFIELD];             // elements of an INLINE array field, 0 for a scalar
i64  fd_vis[TK_MAXFIELD];             // TK_VPRIVATE, TK_VPROTECTED or TK_VPUBLIC
uptr fd_sym[TK_MAXFIELD];             // a STATIC field's global; 0 when it lives in the object
i64  tk_nfield = 0;

i64  ax_node[TK_MAXAX];               // the address node of an array field, and its shape
i64  ax_ty[TK_MAXAX];
i64  ax_nel[TK_MAXAX];
uptr ax_name[TK_MAXAX];
i64  tk_nax = 0;

uptr lv_name[TK_MAXLOCAL];            // a local the CORE declared, seen via on_stmt
i64  lv_str[TK_MAXLOCAL];
i64  tk_nlocal = 0;

uptr slv_name[TK_MAXSLV];             // every local's NAME, whatever its type
i64  slv_ty[TK_MAXSLV];               // ...and the type it was declared with
i64  slv_node[TK_MAXSLV];             // ...and the N_VAR node the SOURCE wrote (V2)
i64  tk_nslv = 0;                     // append-only: the whole unit, for a PASS

i64  slv_live[TK_MAXSLV];             // indices into the two above, the ones IN SCOPE
i64  tk_nslv_live = 0;                // a stack, cut at every `}`, for the PARSER

i64  xt_node[TK_MAXXT];               // a node this module built, and its type
i64  xt_str[TK_MAXXT];                // the row of the type table, or -1 for a scalar
i64  xt_ty[TK_MAXXT];                 // the type id itself, scalar ones included
i64  xt_pure[TK_MAXXT];               // 1 when re-evaluating the node is free of effects
i64  xt_own[TK_MAXXT];                // TK_OWNED or TK_BORROWED: who holds the reference
i64  tk_nxt = 0;

i64  os_node[TK_MAXOS];               // a store into a slot of counted type
i64  tk_nos = 0;

// position used on generated nodes and on declaration-level errors
i64  tk_line = 0;
uptr tk_file = 0;

// ---- table accessors (no raw ld64/st64 outside this section) ----
uptr sr_name_at(i64 i)  { return ld64(sr_name + i * 8); }
i64  sr_ty_at(i64 i)    { return ld64(sr_ty + i * 8); }
i64  sr_size_at(i64 i)  { return ld64(sr_size + i * 8); }
i64  sr_base_at(i64 i)  { return ld64(sr_base + i * 8); }
i64  sr_kind_at(i64 i)  { return ld64(sr_form + i * 8); }
i64  sr_nv_at(i64 i)    { return ld64(sr_nv + i * 8); }
i64  sr_m0_at(i64 i)    { return ld64(sr_m0 + i * 8); }
i64  sr_mn_at(i64 i)    { return ld64(sr_mn + i * 8); }
i64  sr_ni_at(i64 i)    { return ld64(sr_ni + i * 8); }
i64  sr_vis_at(i64 i)   { return ld64(sr_vis + i * 8); }
i64  sr_proj_at(i64 i)  { return ld64(sr_proj + i * 8); }
i64  sr_abst_at(i64 i)  { return ld64(sr_abst + i * 8); }
i64  sr_part_at(i64 i)  { return ld64(sr_part + i * 8); }
i64  sr_off_at(i64 i)   { return ld64(sr_off + i * 8); }
i64  sr_hline_at(i64 i) { return ld64(sr_hline + i * 8); }
uptr sr_hfile_at(i64 i) { return ld64(sr_hfile + i * 8); }
i64  ha_ety_at(i64 i)   { return ld64(ha_ety + i * 8); }
void set_ha_ety_at(i64 i, i64 v) { st64(ha_ety + i * 8, v); }
i64  nl_of_at(i64 i)    { return ld64(nl_of + i * 8); }
void set_nl_of_at(i64 i, i64 v) { st64(nl_of + i * 8, v); }
uptr fd_name_at(i64 i)  { return ld64(fd_name + i * 8); }
i64  fd_cls_at(i64 i)   { return ld64(fd_cls + i * 8); }
i64  fd_off_at(i64 i)   { return ld64(fd_off + i * 8); }
i64  fd_ty_at(i64 i)    { return ld64(fd_ty + i * 8); }
i64  fd_nel_at(i64 i)   { return ld64(fd_nel + i * 8); }
i64  fd_vis_at(i64 i)   { return ld64(fd_vis + i * 8); }
uptr fd_sym_at(i64 i)   { return ld64(fd_sym + i * 8); }
i64  ax_node_at(i64 i)  { return ld64(ax_node + i * 8); }
i64  ax_ty_at(i64 i)    { return ld64(ax_ty + i * 8); }
i64  ax_nel_at(i64 i)   { return ld64(ax_nel + i * 8); }
uptr ax_name_at(i64 i)  { return ld64(ax_name + i * 8); }
uptr lv_name_at(i64 i)  { return ld64(lv_name + i * 8); }
i64  lv_str_at(i64 i)   { return ld64(lv_str + i * 8); }
uptr slv_name_at(i64 i) { return ld64(slv_name + i * 8); }
i64  slv_ty_at(i64 i)   { return ld64(slv_ty + i * 8); }
i64  slv_node_at(i64 i) { return ld64(slv_node + i * 8); }
i64  slv_live_at(i64 i) { return ld64(slv_live + i * 8); }
i64  xt_node_at(i64 i)  { return ld64(xt_node + i * 8); }
i64  xt_str_at(i64 i)   { return ld64(xt_str + i * 8); }
i64  xt_ty_at(i64 i)    { return ld64(xt_ty + i * 8); }
i64  xt_pure_at(i64 i)  { return ld64(xt_pure + i * 8); }
i64  xt_own_at(i64 i)   { return ld64(xt_own + i * 8); }
i64  os_node_at(i64 i)  { return ld64(os_node + i * 8); }

void set_sr_name_at(i64 i, uptr v)  { st64(sr_name + i * 8, v); }
void set_sr_ty_at(i64 i, i64 v)     { st64(sr_ty + i * 8, v); }
void set_sr_size_at(i64 i, i64 v)   { st64(sr_size + i * 8, v); }
void set_sr_base_at(i64 i, i64 v)   { st64(sr_base + i * 8, v); }
void set_sr_kind_at(i64 i, i64 v)   { st64(sr_form + i * 8, v); }
void set_sr_nv_at(i64 i, i64 v)     { st64(sr_nv + i * 8, v); }
void set_sr_m0_at(i64 i, i64 v)     { st64(sr_m0 + i * 8, v); }
void set_sr_mn_at(i64 i, i64 v)     { st64(sr_mn + i * 8, v); }
void set_sr_ni_at(i64 i, i64 v)     { st64(sr_ni + i * 8, v); }
void set_sr_vis_at(i64 i, i64 v)    { st64(sr_vis + i * 8, v); }
void set_sr_proj_at(i64 i, i64 v)   { st64(sr_proj + i * 8, v); }
void set_sr_abst_at(i64 i, i64 v)   { st64(sr_abst + i * 8, v); }
void set_sr_part_at(i64 i, i64 v)   { st64(sr_part + i * 8, v); }
void set_sr_off_at(i64 i, i64 v)    { st64(sr_off + i * 8, v); }
void set_sr_hline_at(i64 i, i64 v)  { st64(sr_hline + i * 8, v); }
void set_sr_hfile_at(i64 i, uptr v) { st64(sr_hfile + i * 8, v); }

// `&&` short-circuits, so the row test would answer 0 for -1 in either order;
// it is FIRST so that `sr_kind_at(-1)` is never reached at all, which would be
// an out-of-bounds load. `tk_this()`, the only caller, already refuses a
// negative `tk_body_class` three lines before it asks.
i64 tk_is_struct(i64 si) { return si >= 0 && sr_kind_at(si) == TK_KSTRUCT; }
i64 tk_is_class(i64 si) { return sr_kind_at(si) == TK_KCLASS; }
i64 tk_is_iface(i64 si) { return sr_kind_at(si) == TK_KIFACE; }
i64 tk_is_deleg(i64 si) { return sr_kind_at(si) == TK_KDELEG; }
i64 tk_is_ha(i64 si)    { return si >= 0 && sr_kind_at(si) == TK_KARRAY; }
i64 tk_is_enum(i64 si)  { return si >= 0 && sr_kind_at(si) == TK_KENUM; }
i64 tk_is_nl(i64 si)    { return si >= 0 && sr_kind_at(si) == TK_KNULL; }
void set_fd_name_at(i64 i, uptr v)  { st64(fd_name + i * 8, v); }
void set_fd_cls_at(i64 i, i64 v)    { st64(fd_cls + i * 8, v); }
void set_fd_off_at(i64 i, i64 v)    { st64(fd_off + i * 8, v); }
void set_fd_ty_at(i64 i, i64 v)     { st64(fd_ty + i * 8, v); }
void set_fd_nel_at(i64 i, i64 v)    { st64(fd_nel + i * 8, v); }
void set_fd_vis_at(i64 i, i64 v)    { st64(fd_vis + i * 8, v); }
void set_fd_sym_at(i64 i, uptr v)   { st64(fd_sym + i * 8, v); }
void set_ax_node_at(i64 i, i64 v)   { st64(ax_node + i * 8, v); }
void set_ax_ty_at(i64 i, i64 v)     { st64(ax_ty + i * 8, v); }
void set_ax_nel_at(i64 i, i64 v)    { st64(ax_nel + i * 8, v); }
void set_ax_name_at(i64 i, uptr v)  { st64(ax_name + i * 8, v); }
void set_lv_name_at(i64 i, uptr v)  { st64(lv_name + i * 8, v); }
void set_lv_str_at(i64 i, i64 v)    { st64(lv_str + i * 8, v); }
void set_slv_name_at(i64 i, uptr v) { st64(slv_name + i * 8, v); }
void set_slv_ty_at(i64 i, i64 v)    { st64(slv_ty + i * 8, v); }
void set_slv_node_at(i64 i, i64 v)  { st64(slv_node + i * 8, v); }
void set_slv_live_at(i64 i, i64 v)  { st64(slv_live + i * 8, v); }
void set_xt_node_at(i64 i, i64 v)   { st64(xt_node + i * 8, v); }
void set_xt_str_at(i64 i, i64 v)    { st64(xt_str + i * 8, v); }
void set_xt_ty_at(i64 i, i64 v)     { st64(xt_ty + i * 8, v); }
void set_xt_pure_at(i64 i, i64 v)   { st64(xt_pure + i * 8, v); }
void set_xt_own_at(i64 i, i64 v)    { st64(xt_own + i * 8, v); }
void set_os_node_at(i64 i, i64 v)   { st64(os_node + i * 8, v); }

// ---- derived names ----
i64 tk_lower_ch(i64 c) { if (c >= 'A' && c <= 'Z') return c + 32; return c; }
i64 tk_upper_ch(i64 c) { if (c >= 'a' && c <= 'z') return c - 32; return c; }

// copy of `s` with the letters' case forced: up = 1 uppercase, 0 lowercase
uptr tk_case(uptr s, i64 up) {
    i64 n = cstrlen(s);
    uptr d = xalloc(n + 1);
    i64 i = 0;
    loop {
        if (i >= n) break;
        i64 c = ld8(s + i);
        if (up) st8(d + i, tk_upper_ch(c));
        else    st8(d + i, tk_lower_ch(c));
        i = i + 1;
    }
    st8(d + n, 0);
    return d;
}

uptr tk_join(uptr a, uptr b) {
    i64 la = cstrlen(a);
    i64 lb = cstrlen(b);
    uptr d = xalloc(la + lb + 1);
    mem_copy(d, a, la);
    mem_copy(d + la, b, lb);
    st8(d + la + lb, 0);
    return d;
}

uptr tk_join3(uptr a, uptr b, uptr c) { return tk_join(tk_join(a, b), c); }

// an integer as the decimal text a name and a message are built from: the
// const argument of a generic travels as a LEXEME, so `Box__Circle__4` and the
// substitution that produced it come from one and the same spelling
uptr tk_num(i64 v) {
    u8 tmp[24];
    i64 neg = 0;
    if (v < 0) { neg = 1; v = 0 - v; }
    i64 i = 24;
    loop {
        i = i - 1;
        st8(tmp + i, '0' + v % 10);
        v = v / 10;
        if (v == 0) break;
    }
    if (neg) { i = i - 1; st8(tmp + i, '-'); }
    return xstrdup(tmp + i, 24 - i);
}

// Point         ->  point_new       (the generated allocator)
uptr tk_ctor_name(uptr name) { return tk_join(tk_case(name, 0), "_new"); }
// Point         ->  point_copy      (the generated memberwise copy, V2)
uptr tk_copy_name(uptr name) { return tk_join(tk_case(name, 0), "_copy"); }
// Point         ->  point_release   (word 0 of the vtable, what rc_dec calls)
uptr tk_release_name(uptr name) { return tk_join(tk_case(name, 0), "_release"); }
// Point + __i64 ->  point_ctor__i64 (the body of `public Point(i64 x) { ... }`)
uptr tk_ctor_sym(uptr name, uptr sig) { return tk_join3(tk_case(name, 0), "_ctor", sig); }
// ...and the allocator that calls it: point_new__i64
uptr tk_new_sym(uptr name, uptr sig) { return tk_join(tk_ctor_name(name), sig); }
// Point         ->  point_dtor      (the body of `~Point() { ... }`)
uptr tk_dtor_sym(uptr name) { return tk_join(tk_case(name, 0), "_dtor"); }

// the two names the method table files a constructor and a destructor under.
// Neither is an identifier, so no member the source writes can collide with
// them and no `.` can ever reach one -- C#'s own spelling for the same reason.
uptr tk_ctor_key() { return ".ctor"; }
uptr tk_dtor_key() { return ".dtor"; }
// Point + area  ->  point_area      (a method, with an implicit receiver)
uptr tk_fname(uptr name, uptr m) { return tk_join3(tk_case(name, 0), "_", m); }
// Point + x     ->  POINT_X         (the #define of the field's offset)
uptr tk_cname(uptr name, uptr m) { return tk_join3(tk_case(name, 1), "_", tk_case(m, 1)); }

// ---- node constructors: only node_new/set_nd_* from src/ast.mc ----
i64 tk_nd(i64 kind) { return node_new(kind, tk_line, tk_file); }

void tk_prim_own_cast_moved(i64 from, i64 to);

// ---- and the ONE door that puts a built node in a built node's place ----
// Every in-place rewrite this compiler makes goes through here (mc
// docs/reference/hooks.md § pass(): the parent keeps pointing at `n`, and `n`'s
// content becomes `r`'s). Two things must survive that copy, and a door
// spelling `node_assign` by hand forgets one of them sooner or later -- which
// is what happened to the seventh door, the read of a by-reference capture
// (`tk_lam_walk`, teko_deleg.tk), while six others were being taught the
// second (N4a, D54):
//   * `nd_next` -- `node_assign` copies the WHOLE node, sibling link included,
//     so an `n` in the middle of a call's argument list would take `r`'s tail
//     and lose its own;
//   * the record of a cast the COMPILER wrote -- kept by node index
//     (`tk_prim_own_cast`, teko_prim.tk), because `--dump-ast` prints every
//     field a node has and a mark on the node would move the dump. A primitive
//     NARROWER than the machine word makes every indirect load such a cast, so
//     a mark left behind on `r` reads back as a cast the source hand-wrote and
//     is refused.
// A caller with more to move -- a type row, an owned store, a deferred call --
// moves it after this returns, onto `n`.
void tk_node_replace(i64 n, i64 r) {
    i64 keep = nd_next(n);
    node_assign(n, r);
    set_nd_next(n, keep);
    tk_prim_own_cast_moved(r, n);
}

i64 tk_int(i64 v) {
    i64 n = tk_nd(N_INT);
    set_nd_val(n, v);
    set_nd_type(n, TY_I64);
    return n;
}

// the `null` VALUE with no token to read -- `tk_null` (teko_type.tk) is the
// same node behind the WORD. An ordinary `N_INT` of 0 typed `TY_UPTR`, the one
// shape `tk_is_null_lit` below recognizes.
i64 tk_nullnode() {
    i64 n = tk_nd(N_INT);
    set_nd_val(n, 0);
    set_nd_type(n, TY_UPTR);
    return n;
}

i64 tk_id(uptr name) {
    i64 n = tk_nd(N_IDENT);
    set_nd_name(n, name);
    set_nd_type(n, TY_I64);
    return n;
}

// &name of a function: M10's uptr
i64 tk_addr(uptr name) {
    i64 n = tk_nd(N_ADDR);
    set_nd_name(n, name);
    set_nd_type(n, TY_UPTR);
    return n;
}

i64 tk_bin(i64 op, i64 a, i64 b) {
    i64 n = tk_nd(N_BINARY);
    set_nd_op(n, op);
    set_nd_a(n, a);
    set_nd_b(n, b);
    return n;
}

i64 tk_call(uptr name, i64 args) {
    i64 n = tk_nd(N_CALL);
    set_nd_name(n, name);
    set_nd_a(n, args);
    set_nd_type(n, TY_I64);
    return n;
}

i64 tk_call2(uptr name, i64 a, i64 b) { return tk_call(name, list_append(a, b)); }

i64 tk_call3(uptr name, i64 a, i64 b, i64 c) { return tk_call(name, list_append(list_append(a, b), c)); }

i64 tk_ret(i64 e) {
    i64 n = tk_nd(N_RETURN);
    set_nd_a(n, e);
    return n;
}

i64 tk_stmt(i64 e) {
    i64 n = tk_nd(N_EXPRSTMT);
    set_nd_a(n, e);
    return n;
}

i64 tk_blk(i64 stmts) {
    i64 n = tk_nd(N_BLOCK);
    set_nd_a(n, stmts);
    return n;
}

i64 tk_var(i64 ty, uptr name, i64 init) {
    i64 n = tk_nd(N_VAR);
    set_nd_name(n, name);
    set_nd_type(n, ty);
    set_nd_a(n, init);
    return n;
}

i64 tk_func(i64 ty, uptr name, i64 prs, i64 body) {
    i64 f = tk_nd(N_FUNC);
    set_nd_name(f, name);
    set_nd_type(f, ty);
    set_nd_a(f, prs);
    set_nd_b(f, body);
    return f;
}

i64 tk_str(uptr s) {
    i64 n = tk_nd(N_STR);
    set_nd_name(n, s);
    set_nd_val(n, cstrlen(s));
    set_nd_type(n, TY_UPTR);
    return n;
}

i64 tk_if(i64 cond, i64 then) {
    i64 n = tk_nd(N_IF);
    set_nd_a(n, cond);
    set_nd_b(n, then);
    return n;
}

// a global with no initializer: it goes to __bss, already zeroed
i64 tk_glb(i64 ty, uptr name, i64 nel) {
    i64 n = tk_nd(N_GLOBAL);
    set_nd_name(n, name);
    set_nd_type(n, ty);
    set_nd_val(n, nel);
    return n;
}

// ---- copying an expression the parser handed over ----
// A virtual call reads the receiver twice (its vtable, and the object), and a node
// may sit in only ONE sibling list -- list_append would rewire the copy inside
// the vtable load. tk_clone is the way out, and tk_pure below is what keeps it
// honest: only a receiver whose re-evaluation costs nothing is ever cloned.
i64 tk_clone(i64 n);

i64 tk_clone_list(i64 n) {
    if (n == 0) return 0;
    i64 c = tk_clone(n);
    set_nd_next(c, tk_clone_list(nd_next(n)));
    return c;
}

i64 tk_clone(i64 n) {
    if (n == 0) return 0;
    i64 c = node_new(nd_kind(n), nd_line(n), nd_file(n));
    set_nd_op(c, nd_op(n));
    set_nd_type(c, nd_type(n));
    set_nd_val(c, nd_val(n));
    set_nd_name(c, nd_name(n));
    set_nd_a(c, tk_clone_list(nd_a(n)));
    set_nd_b(c, tk_clone_list(nd_b(n)));
    set_nd_c(c, tk_clone_list(nd_c(n)));
    set_nd_d(c, tk_clone_list(nd_d(n)));
    return c;
}

// memory-access intrinsic matching the field type's width AND its register
// file. Width alone is not the whole answer: `<float>` carries an f32/f64 in
// the machine's OTHER register file (v0..v7/x0..x7 under AAPCS64), so the
// integer `ld64`/`st64` pair moves the right eight bytes to the WRONG place --
// every indirect access to a float (a `ref`/`out` pointee, a class field, an
// array element, a closure capture) read or wrote a value the arithmetic never
// saw. `<float>`'s own `ldf32`/`ldf64`/`stf32`/`stf64` (M24, lib/float.mc) are
// what address that file, and they are picked here, by KIND, before width.
// teko_wide.tk is included after this file: a sixteen-byte type is reached
// through a library function of its own, because no raw `ldW`/`stW` moves
// sixteen bytes and the width table below would answer `ld64` and move half the
// value in silence (D74, docs/specs/decimal.md § 1's last row). 0 for every
// type that is not wide, which is every type this table knew before.
uptr tk_wide_ld(i64 t);
uptr tk_wide_st(i64 t);

uptr tk_ldn(i64 ty) {
    uptr wd = tk_wide_ld(ty);
    if (wd) return wd;
    i64 w = type_width(ty);
    if (type_kind(ty) == TK_FLOAT) {
        if (w == 4) return "ldf32";
        if (w == 8) return "ldf64";
    }
    if (w == 1) return "ld8";
    if (w == 2) return "ld16";
    if (w == 4) return "ld32";
    return "ld64";
}

uptr tk_stn(i64 ty) {
    uptr wd = tk_wide_st(ty);
    if (wd) return wd;
    i64 w = type_width(ty);
    if (type_kind(ty) == TK_FLOAT) {
        if (w == 4) return "stf32";
        if (w == 8) return "stf64";
    }
    if (w == 1) return "st8";
    if (w == 2) return "st16";
    if (w == 4) return "st32";
    return "st64";
}

// `tk_ldn`'s raw load is always ZERO-extending -- `ld8`/`ld16`/`ld32` are the
// core's own fixed intrinsics (mc's language.md § 2: "the signed read of raw
// memory ... spelled `(i32) ld32(p)`"), correct for every UNSIGNED narrow
// type this project already had (`u8`/`u16`/`u32`) and wrong for a SIGNED one
// narrower than the word -- `i8`/`i16`, and `i32` before them -- whose sign
// bit a raw load reads as an ordinary high bit instead of extending it.
// `tk_cast` (teko_array.tk) is the one surface form that DOES sign-extend by
// kind (`MTASK_CAST`, the machine contract, `docs/specs/small-ints.md` § 1's
// table), so wrapping the raw value in an explicit cast to its own type
// re-reads it through `sxtb`/`sxth` and gives an indirect load the same
// value a declared local of that type already gets for free from the core's
// own `walk_narrow`. `teko_array.tk`'s own `tk_arr_load` already carries
// this exact two-line shape, for `i32`, its only signed narrow element
// before this crumb; this is the same check, factored out once so every
// OTHER indirect load this module builds -- a field, a `ref`/`out` pointee,
// a delegate capture, a property getter, a pending field access -- shares it
// rather than repeating it at each site.
i64 tk_ld(i64 ty, i64 addr) {
    i64 r = tk_call(tk_ldn(ty), addr);
    if (type_kind(ty) == TK_SINT && type_width(ty) < 8) return tk_cast(ty, r);
    return r;
}

// ---- lookups, linear and in declaration order (mc docs/determinism.md rule 1) ----
// the scan alone, no namespace resolution: what a name ALREADY qualified (a
// declaration's own exact-match check, or a candidate teko_ns.tk constructed
// while resolving one) is tested against -- calling the fallback-carrying
// `tk_struct_find` below on a name IT itself built would recurse without ever
// converging (each failed candidate grows a new one to try)
i64 tk_struct_find_exact(uptr name) {
    i64 i = 0;
    loop {
        if (i >= tk_nstruct) break;
        if (str_eq(sr_name_at(i), name)) return i;
        i = i + 1;
    }
    return 0 - 1;
}

// the exact scan first, always; the fallback is namespace resolution -- the
// current namespace outward, then the file's own `using`s (teko_ns.tk's
// `tk_ns_resolve`) -- which answers -1 with zero further work when the
// program declares no namespace at all, so a plain type's lookup is unchanged
i64 tk_struct_find(uptr name) {
    i64 si = tk_struct_find_exact(name);
    if (si >= 0) return si;
    return tk_ns_resolve(name);
}

// the twin an IDENTITY-only site (§50 (b2): a field, a parameter, a return
// type, a local) takes instead: the same search, but landing on a
// forward-scanned name (teko_fwd.tk) materializes its placeholder row rather
// than answering -1. `tk_struct_find` above stays untouched for every site
// that needs the row WHOLE -- a base class, `new`, a delegate construction --
// where a placeholder would silently lay a derived class out wrong or
// allocate the wrong size.
i64 tk_struct_find_fwd(uptr name) {
    i64 si = tk_struct_find_exact(name);
    if (si >= 0) return si;
    si = tk_ns_resolve_fwd(name);
    if (si >= 0) return si;
    return tk_fwd_row(name);
}

i64 tk_struct_by_ty(i64 ty) {
    i64 i = 0;
    loop {
        if (i >= tk_nstruct) break;
        if (sr_ty_at(i) == ty) return i;
        i = i + 1;
    }
    return tk_fwd_row_by_ty(ty);
}

// 1 when `T?` over `ty` needs the counted BOX (Q1b, docs/specs/nullable.md
// § 2): `ty` is a VALUE -- a scalar the machine carries in a register (`i64`,
// `f64`, `bool`, `char`, `i8`...), an `enum`, or a primitive with members
// (`TimeSpan`, `DateTime`) -- rather than a REFERENCE, whose own pointer IS
// the handle and needs no box at all. The question is asked by row: everything
// that has one is a reference (a class, an interface, a delegate, a `T[]`, a
// `struct`) except an `enum`, which is a value whatever row it occupies (D39).
i64 tk_nl_boxes(i64 ty) {
    i64 si = tk_struct_by_ty(ty);
    if (si < 0) return 1;
    return tk_is_enum(si);
}

// 1 when a value of type `ty` is a COUNTED reference: a class, an interface, a
// delegate or a T[] of heap (K3), whose object carries the vtable and the
// count the reclaim works through. A struct is not one -- it has no vtable,
// hence no release to reach and no count to keep, which lib/rt.tk
// declares as the debt of this slice.
i64 tk_is_counted(i64 ty) {
    i64 si = tk_struct_by_ty(ty);
    if (si < 0) return 0;
    // docs/specs/nullable.md § 2/§ 7: `Cell?` IS the `Cell` pointer, and the
    // null handle is 0 -- which `rc_dec`/`rt_own` already treat as a no-op --
    // so a nullable row answers exactly what the row it encloses answers, and
    // the whole reclaim serves it with no line of its own.
    // Q1b: ...and for a VALUE it is the counted BOX itself (`tk_nl_boxes`
    // above), an object with the very shape a `T[]` of heap already has, so
    // the reclaim serves the box arm with no line of its own either.
    if (tk_is_nl(si)) {
        if (tk_nl_boxes(nl_of_at(si))) return 1;
        return tk_is_counted(nl_of_at(si));
    }
    if (tk_is_class(si)) return 1;
    if (tk_is_deleg(si)) return 1;
    if (tk_is_ha(si)) return 1;
    return tk_is_iface(si);
}

// the row of `T[]` for element type `ety`, one per distinct element, made the
// first time it is asked for (K3, §41): the type identity is the array's own
// bracket spelling (a lexeme the lexer can never form, `lib/user_typearr.mc`'s
// own precedent), which is what keeps it collision-free with a user name --
// the mangling of a GENERATED SYMBOL for it never uses this spelling, since a
// symbol name may not carry `[`/`]` (see `tk_ty_mangle_name`).
i64 tk_ha_row(i64 ety) {
    i64 i = 0;
    loop {
        if (i >= tk_nstruct) break;
        if (tk_is_ha(i) && ha_ety_at(i) == ety) return sr_ty_at(i);
        i = i + 1;
    }
    uptr name = tk_join(type_name(ety), "[]");
    i64 ty = type_new(name, 8, 8, TK_INT);
    i64 si = tk_type_add(name, ty, 0 - 1, TK_KARRAY, TK_TPUBLIC, 1);
    set_ha_ety_at(si, ety);
    return ty;
}

// the row of `T?` for the enclosed type `ty`, one per distinct `T`, made the
// first time the suffix is spelled (Q1a, docs/specs/nullable.md § 2) -- the
// exact shape `tk_ha_row` above has. The identity is the `?` spelling, a
// lexeme the lexer can never form, so it collides with no user name; a
// GENERATED SYMBOL never uses it (`tk_ty_mangle_name` maps the row to
// `opt_T`, the rule `T[]` already lives by).
i64 tk_nl_row(i64 ty) {
    i64 i = 0;
    loop {
        if (i >= tk_nstruct) break;
        if (tk_is_nl(i) && nl_of_at(i) == ty) return sr_ty_at(i);
        i = i + 1;
    }
    uptr name = tk_join(type_name(ty), "?");
    i64 nt = type_new(name, 8, 8, TK_INT);
    i64 si = tk_type_add(name, nt, 0 - 1, TK_KNULL, TK_TPUBLIC, 1);
    set_nl_of_at(si, ty);
    return nt;
}

// what `ty` encloses when it IS a nullable row, and -1 when it is not one
i64 tk_nl_of(i64 ty) {
    i64 si = tk_struct_by_ty(ty);
    if (!tk_is_nl(si)) return 0 - 1;
    return nl_of_at(si);
}

// 1 when the program spells at least one `T[]`
i64 tk_ha_any() {
    i64 i = 0;
    loop {
        if (i >= tk_nstruct) break;
        if (tk_is_ha(i)) return 1;
        i = i + 1;
    }
    return 0;
}

// the identifier a MANGLED SYMBOL embeds for type `ty`: the plain type name,
// except for `T[]` (K3), whose own registered spelling carries `[`/`]` --
// safe for `--dump-ast` and for the word table, unsafe for a linker symbol.
// `arr_i64`/`arr_Circle` is what an overload/constructor/method suffix uses
// instead (`teko_ref.tk`'s own `tk_ty_sfx`).
uptr tk_ty_mangle_name(i64 ty) {
    i64 si = tk_struct_by_ty(ty);
    if (tk_is_nl(si)) return tk_join("opt_", tk_ty_mangle_name(nl_of_at(si)));
    if (tk_is_ha(si)) return tk_join("arr_", tk_ty_mangle_name(ha_ety_at(si)));
    return type_name(ty);
}

// ---- a PARAMETER of the declaration currently being read (K3) ----
// The core never reports a parameter to a module mid-body any more than it
// reports a struct/class one (teko_expr.tk's own header) -- but a `T[]`
// parameter's TYPE is known the instant the parser reads it, at the SAME
// point a struct/class local's is (`tk_on_stmt`, above). This table is that
// same early knowledge for a PARAMETER: reset once at the start of the
// declaration's own parameter list (`tk_hp_reset`, called by
// `teko_default.tk`'s own per-declaration bookkeeping for a free function
// and by `teko_class.tk`'s own `tk_params` for a member) and filled as each
// parameter is read, so `xs[i]`/`xs.Length` on a `T[]` parameter resolve AT
// PARSE TIME too (`teko_params.tk`'s `tk_bracket`, `teko_expr.tk`'s
// `tk_dot`) -- with no oracle, and no placeholder left for a later pass.
//
// D104: EVERY parameter has a row -- a `T[]` one, a struct/class one, a
// scalar, and a `ref`/`out` one as a SHADOW (`tk_hp_shadow` below, the name
// with -1 for the type). A struct/class parameter's type is known at the very
// same instant a `T[]` one's is, and `tk_ref_addr` (teko_ref.tk) needs exactly
// that row to build `ref h.n` / `out h.n` on a parameter -- a legal program it
// refused `teko: not an object of a known type: h` because `tk_local_find` is
// a parse-time SCOPE table and a parameter is in no scope table at all. The
// `T[]` question simply moved from the write to the READ: `tk_hp_find` below
// answers a `T[]` parameter and nothing else, so its three callers (`tk_dot`,
// `tk_bracket`, teko_loop.tk's `foreach`) see the same rows they always saw,
// and `tk_hp_find_any` is the new door.
//
// The rows of every parameter list still OPEN share the table -- an enclosing
// declaration's under each lambda nested inside it, the floor below -- so the
// ceiling counts them all: `TK_MAXHP` is 128 against mc's own `MAXPARAMS` of
// 12, room for ten open lists, and `TK_MAXHPB` (16) bounds the nesting with
// its own message. It was 32 rows for `T[]` parameters alone before D104.
#define TK_MAXHP  128                 // every parameter of every list still open
#define TK_MAXHPB 16                  // how deep a lambda may nest inside a list

uptr tk_hp_owner = 0;                 // the declaration the rows belong to (below)

uptr hp_name[TK_MAXHP];
i64  hp_ty[TK_MAXHP];
i64  tk_nhp = 0;

uptr hp_name_at(i64 i) { return ld64(hp_name + i * 8); }
i64  hp_ty_at(i64 i)   { return ld64(hp_ty + i * 8); }
void set_hp_name_at(i64 i, uptr v) { st64(hp_name + i * 8, v); }
void set_hp_ty_at(i64 i, i64 v)    { st64(hp_ty + i * 8, v); }

// D104: the reset has a FLOOR, and the floor is a stack -- the same shape
// `tk_lc_base` (teko_deleg.tk's own lambda capture window) already has, and
// for the same reason. A LAMBDA's parameter list is a declaration of its own:
// `tk_lambda_build` sets `p_decl_name` to the gensym before `parse_params`,
// `tk_default_param` sees a new owner and resets. With the reset cutting to
// ZERO that took the ENCLOSING declaration's rows with it and left the
// lambda's standing, so everything after a lambda literal in the same body
// read the LAMBDA's parameters. `f81e0217` already had it for a `T[]`
// parameter -- `i64 f(i64[] xs) { Op g = new Op((i64 x) => x + 1); return
// xs[0]; }` is refused ``teko: `[` needs an array: xs`` there, measured --
// and the parameter road D104 opens would have inherited it as a WRONG
// ANSWER rather than a refusal: with `i64 f(G h)` and a lambda `(H h) => ...`
// between the list and the use, `ref h.n` added H's offset to G's object and
// wrote the field next door (measured, exit 41 where 42 is right). One floor
// fixes both, because both read this one table.
i64  hp_base_st[TK_MAXHPB];
uptr hp_own_st[TK_MAXHPB];
i64 tk_nhpb = 0;
i64 tk_hp_base = 0;

void tk_hp_reset() { tk_nhp = tk_hp_base; }

// D104: the DECLARATION the rows belong to -- the name `p_decl_name()` answers
// while that declaration's own body is being parsed. The reset is driven by
// the parameter LIST (`tk_default_param` for a free function, `tk_params` for
// a member), and a free function with an EMPTY list has no list to drive it:
// its body then read the PREVIOUS declaration's rows. Measured at `f81e0217`
// on the `T[]` road -- `i64 first(i64[] xs) {...} i64 second() { return
// xs[0]; }` beside a global `i64 xs` segfaults there -- and the parameter road
// would have inherited it (`ref h.n` in `second`, SIGSEGV; Copilot on #770).
// The owner is recorded where the body's name is known and compared where the
// rows are read: a row of another declaration answers nothing. A lambda is not
// another declaration for this purpose -- its floor is open (`tk_nhpb > 0`),
// and the enclosing rows are exactly what it must still see.
void tk_hp_own(uptr name) { tk_hp_owner = name; }

// 1 when the rows in the table belong to the declaration being parsed now
i64 tk_hp_in_owner() {
    if (tk_nhpb != 0) return 1;                   // inside a nested list: the floor answers
    if (tk_hp_owner == 0) return 1;               // nothing recorded: as before
    uptr cur = p_decl_name();
    if (cur == 0) return 1;                       // mc is not reporting one here
    // the POINTER, not the spelling: `p_decl_name()` is a declaration's
    // IDENTITY, a fresh one per source occurrence, which is what lets
    // `tk_default_param` tell two same-named OVERLOADS apart with the very
    // same comparison (`owner != tk_dflt_owner`, teko_default.tk). Comparing
    // the text instead left `i64 f(H h) {…}`'s row visible inside a later
    // `i64 f() {…}` -- an overload of arity zero, which has no parameter list
    // to reset the table -- and `ref h.n` there built an address for a name
    // that declaration never had: SIGSEGV, where `f81e0217` refuses (Copilot
    // on #770).
    return cur == tk_hp_owner;
}

// entering a nested parameter list: the rows already there become a floor
// `tk_hp_reset` cannot cut below
// The floor is VALIDATED as it is laid: the rows about to become one have to
// belong to the declaration being parsed right now, or they are cut first.
// Inside a nested list `tk_hp_in_owner` answers 1 unconditionally -- the
// enclosing rows are exactly what the lambda must still see -- so without this
// check a stale table became a lambda's floor and was trusted for the whole
// body: a lambda inside a parameterless `second()` after `i64 first(H h)` read
// `first`'s row and, beside a same-named global, built `<the global> + OFF`
// (SIGSEGV; `f81e0217` refuses it -- Copilot on #770). The caller pushes
// BEFORE it sets `p_decl_name` to the lambda's gensym, so the question asked
// here is about the ENCLOSING declaration, which is the one that owns them.
void tk_hp_push() {
    if (tk_nhpb == TK_MAXHPB) err_at(tk_file, tk_line, "teko: lambdas nested too deep");
    if (!tk_hp_in_owner()) tk_nhp = tk_hp_base;
    st64(hp_base_st + tk_nhpb * 8, tk_hp_base);
    st64(hp_own_st + tk_nhpb * 8, tk_hp_owner);   // the lambda's own list will overwrite it
    tk_nhpb = tk_nhpb + 1;
    tk_hp_base = tk_nhp;
}

// leaving it: the nested list's own rows die, the floor goes back
void tk_hp_pop() {
    if (tk_nhpb == 0) return;
    tk_nhp = tk_hp_base;
    tk_nhpb = tk_nhpb - 1;
    tk_hp_base = ld64(hp_base_st + tk_nhpb * 8);
    tk_hp_owner = ld64(hp_own_st + tk_nhpb * 8);  // ...and the enclosing one owns them again
}

// D104: the row is kept for EVERY parameter, not only a `T[]` one. A
// struct/class parameter's type is known at the very same instant, and
// `tk_ref_addr` (teko_ref.tk) needs exactly that row to build `ref h.n` /
// `out h.n` on a parameter -- a legal program it refused
// `teko: not an object of a known type: h` because `tk_local_find` is a
// parse-time SCOPE table and a parameter is in no scope table at all. The
// `T[]` question simply moved from the write to the READ: `tk_hp_find` still
// answers a `T[]` parameter and nothing else, so its three callers
// (`tk_dot`, `tk_bracket`, teko_loop.tk's `foreach`) see the same rows they
// always saw, and `tk_hp_find_any` is the new door.
void tk_hp_add(uptr name, i64 ty) {
    if (tk_nhp == TK_MAXHP) err_at(tk_file, tk_line, "teko: too many parameters in the open declarations");
    set_hp_name_at(tk_nhp, name);
    set_hp_ty_at(tk_nhp, ty);
    tk_nhp = tk_nhp + 1;
}

// a `ref`/`out` parameter's own row: the NAME, and -1 for the type. It is a
// SHADOW, not an answer -- the lookup below stops at the newest row bearing
// the name, so the enclosing declaration's `H h` stops answering for a
// lambda's `(ref i64 h)` the moment that list is open (Copilot on #770:
// without it, `ref h.n` in the lambda body added H's field offset to the
// inner ADDRESS slot and took SIGSEGV; `f81e0217` refuses that program, and
// so does this row). A `ref`/`out` slot carries an address rather than the
// object, so the honest type for it here is "no object at all".
void tk_hp_shadow(uptr name) { tk_hp_add(name, 0 - 1); }

// the declared type of the parameter named `name`, or -1: the newest one
// wins, the same rule `tk_local_find` gives a shadowed local. A `ref`/`out`
// parameter has a SHADOW row (-1 for the type, `tk_hp_shadow` above): the scan
// stops there and answers "no object", so its slot -- which holds an ADDRESS
// rather than the object -- is never mistaken for the object itself, and an
// older row of the same name never answers past it.
//
// The scan stops at `tk_hp_base`, the CURRENT list's own floor, and that is a
// scope rule rather than bookkeeping: a lambda captures EXPLICITLY in teko
// (`use (...)`, K4) and `tk_lambda_use` accepts a local alone, so an enclosing
// PARAMETER is not in scope inside a lambda body at all. Scanning past the
// floor reached it anyway: with `i64 f(H h)` and `bump(ref h.n)` inside a
// lambda, the capture judge lets the name through when a same-named GLOBAL
// exists (the name binds to the global) and the enclosing parameter's row then
// supplied the offset -- `<the global> + OFF`, SIGSEGV, where `f81e0217`
// refuses (Copilot on #770). The floor is still kept for RESTORATION, which is
// what makes the enclosing list answer again the moment `tk_hp_pop` runs
// (`tests/ref_field_param.tk` item 7). With no nested list open the floor is
// 0 and this is the whole table, as it always was.
i64 tk_hp_find_any(uptr name) {
    if (!tk_hp_in_owner()) return 0 - 1;
    i64 i = tk_nhp - 1;
    loop {
        if (i < tk_hp_base) break;
        if (str_eq(hp_name_at(i), name)) return hp_ty_at(i);
        i = i - 1;
    }
    return 0 - 1;
}

// the type of a `T[]` parameter named `name`, or -1 -- the question the table
// answered before D104 widened what it holds, asked through the SAME lookup.
// It stops at the newest row bearing the name and answers -1 when that row is
// no `T[]`, rather than scanning past it: with the floor keeping an enclosing
// list alive, skipping would let a lambda's `(i64 xs)` or `(ref i64 xs)` fall
// through to an enclosing `i64[] xs` and index the ENCLOSING array (measured,
// SIGSEGV; `f81e0217` refuses it, because the reset had already wiped the
// enclosing row -- Copilot on #770). The innermost binding decides, here as in
// `tk_hp_find_any`, and with a single list open the two rules are one rule --
// which is why this is exactly what the three callers saw before.
i64 tk_hp_find(uptr name) {
    i64 ty = tk_hp_find_any(name);
    if (ty < 0) return 0 - 1;
    if (!tk_is_ha(tk_struct_by_ty(ty))) return 0 - 1;
    return ty;
}

// a store this module emitted into a slot of counted type -- a field, an
// element of an inline array, an auto-property's backing. The node is recorded
// where it is BUILT, which is the only place the slot's declared type is at
// hand, and the reclaim pass (teko_rc.tk) turns it into the store that keeps
// both counts straight: it is the pass, not the parser, that can tell whether
// the value being stored is already owned.
void tk_os_add(i64 n) {
    if (tk_nos == TK_MAXOS) err_at(tk_file, tk_line, "teko: too many stores into a slot of class type");
    set_os_node_at(tk_nos, n);
    tk_nos = tk_nos + 1;
}

// records the store only when the slot really is a counted one
i64 tk_os_mark(i64 n, i64 ty) {
    if (tk_is_counted(ty)) tk_os_add(n);
    return n;
}

// the SAME store, re-pointed: `tk_hg_resolve_write` (teko_array.tk) copies the
// store it has just built into the placeholder node the tree already holds
// (`node_assign`) and drops the node it built, so the row `tk_os_mark` wrote
// there points at an orphan the reclaim pass will never reach. Re-pointing
// that row is what the site needs; ADDING a second one -- what it did before
// -- spent TWO rows of `TK_MAXOS` per global element store and so halved the
// ceiling for a global array alone: 65 stores into a global `Op[]` were
// refused `teko: too many stores into a slot of class type` where 128 into a
// local one compile (D51, eleventh pass). A store whose slot is not counted
// has no row at all, and this is a no-op for it, exactly as `tk_os_mark` is.
void tk_os_move(i64 from, i64 to) {
    i64 i = tk_nos - 1;
    loop {
        if (i < 0) break;
        if (os_node_at(i) == from) { set_os_node_at(i, to); return; }
        i = i - 1;
    }
}

i64 tk_os_has(i64 n) {
    i64 i = tk_nos - 1;
    loop {
        if (i < 0) break;
        if (os_node_at(i) == n) return 1;
        i = i - 1;
    }
    return 0;
}

// index into the field table of `name` in `si` or in one of its bases -- the
// base's fields keep their offsets in the derived object (base-first layout),
// so the entry found up the chain is valid as it stands. A row OWNS its fields
// rather than holding a slice of the table: the parts of a partial class are
// read with whatever else the source declares between them, so the fields of
// one type are not a contiguous run.
i64 tk_field_find(i64 si, uptr name) {
    loop {
        if (si < 0) break;
        i64 i = 0;
        loop {
            if (i >= tk_nfield) break;
            if (fd_cls_at(i) == si) {
                if (str_eq(fd_name_at(i), name)) return i;
            }
            i = i + 1;
        }
        si = sr_base_at(si);
    }
    return 0 - 1;
}

// the type that DECLARES the field at index `fi`, which is the type an access
// to it is checked against: a field found up the base chain belongs to the base,
// not to the receiver's own type
i64 tk_field_owner(i64 fi) { return fd_cls_at(fi); }

// the field called `name` when the left side's type is NOT known statically --
// a parameter, or a global, neither of which the core reports to a module. The
// answer is the field itself when exactly ONE type declares that name, which is
// the same "resolve the name in the module's own table" `mc`'s own teaching
// demo does for `p ~> len` (lib/user_syntax_demo.mc). -1 = no type declares it,
// -2 = more than one does and the left side has to be statically known.
i64 tk_field_by_name(uptr name) {
    i64 found = 0 - 1;
    i64 i = 0;
    loop {
        if (i >= tk_nfield) break;
        if (str_eq(fd_name_at(i), name)) {
            if (found >= 0) return 0 - 2;
            found = i;
        }
        i = i + 1;
    }
    return found;
}

// the table is a STACK, marked at every `{` and cut back at the matching `}`
// (teko_stmt.tk's tk_block), so what it holds is exactly the names in scope
// where the parser stands; the newest entry wins, which is what makes an inner
// declaration shadow an outer one for as long as its block is open
i64 tk_local_find(uptr name) {
    i64 i = tk_nlocal - 1;
    loop {
        if (i < 0) break;
        if (str_eq(lv_name_at(i), name)) return lv_str_at(i);
        i = i - 1;
    }
    return 0 - 1;
}

i64 tk_xt_at(i64 n) {
    i64 i = tk_nxt - 1;
    loop {
        if (i < 0) break;
        if (xt_node_at(i) == n) return i;
        i = i - 1;
    }
    return 0 - 1;
}

i64 tk_xt_find(i64 n) {
    i64 x = tk_xt_at(n);
    if (x < 0) return 0 - 1;
    return xt_str_at(x);
}

// the node's own type id, which a SCALAR one has as well: a field of `i64` is
// no row of the type table, and answering -1 for it is what left `this.side`
// untypable to whoever asks (teko_typeof.tk's tk_ty_of, and through it the
// overload resolution)
i64 tk_xt_ty(i64 n) {
    i64 x = tk_xt_at(n);
    if (x < 0) return 0 - 1;
    return xt_ty_at(x);
}

// 1 when the node may be evaluated twice with no observable difference: a name,
// or a field load this module built. A constructor and a method call answer 0,
// so `new C().m()` is refused instead of allocating twice. Ownership is NOT
// this question and is not read here: a borrowed node may still be a store.
i64 tk_pure(i64 n) {
    if (n == 0) return 0;
    if (nd_kind(n) == N_IDENT) return 1;
    i64 x = tk_xt_at(n);
    if (x < 0) return 0;
    return xt_pure_at(x);
}

// ---- table appends ----
void tk_local_add(uptr name, i64 si) {
    if (tk_nlocal == TK_MAXLOCAL) err_at(tk_file, tk_line, "teko: too many locals of struct type");
    set_lv_name_at(tk_nlocal, name);
    set_lv_str_at(tk_nlocal, si);
    tk_nlocal = tk_nlocal + 1;
}

// the node's type as this module knows it: the row of the type table when the
// type has one, and the type id in every case. `si` is -1 for a scalar, which
// is the answer `.` and the oracle both need to tell "not a struct" from
// "nothing known". `pure` and `own` are asked SEPARATELY because they are
// separate questions, and a registration has to answer both.
void tk_xt_put(i64 n, i64 si, i64 ty, i64 pure, i64 own) {
    if (tk_nxt == TK_MAXXT) err_at(tk_file, tk_line, "teko: too many expressions whose type is known");
    set_xt_node_at(tk_nxt, n);
    set_xt_str_at(tk_nxt, si);
    set_xt_ty_at(tk_nxt, ty);
    set_xt_pure_at(tk_nxt, pure);
    set_xt_own_at(tk_nxt, own);
    tk_nxt = tk_nxt + 1;
}

void tk_xt_add(i64 n, i64 si, i64 pure, i64 own) { tk_xt_put(n, si, sr_ty_at(si), pure, own); }

// a registration follows the VALUE, not the node id: when a rewrite moves what
// a node was into a FRESH node and makes the old one something else (teko_prim.tk's
// `tk_nd_moved`, the wrap that writes a cast in place), the type this table
// remembers belongs to the moved value and answering it for the wrapper is a
// lie -- `tk_ty_of` reads this table BEFORE the node's own kind, so a
// `(f64)` written over a member call still read `i64` off the row left behind
// and `tk_rc_call_args` (teko_rc.tk) wrote the cast a second time (Copilot on
// #697, fifth pass). Every row of the node is moved, not only the newest: a
// stale one would answer for the wrapper the moment the newest is gone.

void tk_xt_move(i64 from, i64 to) {
    i64 i = 0;
    loop {
        if (i >= tk_nxt) break;
        if (xt_node_at(i) == from) set_xt_node_at(i, to);
        i = i + 1;
    }
}

// appends the field under its owner, so a method parsed further down the same
// body already sees the fields declared above it. `sym` is the global a STATIC
// field lives in, and 0 for one that lives in the object.
void tk_field_add(i64 si, uptr name, i64 off, i64 ty, i64 nel, i64 vis, uptr sym) {
    if (tk_nfield == TK_MAXFIELD) err_at(tk_file, tk_line, "teko: too many fields");
    set_fd_cls_at(tk_nfield, si);
    set_fd_name_at(tk_nfield, name);
    set_fd_off_at(tk_nfield, off);
    set_fd_ty_at(tk_nfield, ty);
    set_fd_nel_at(tk_nfield, nel);
    set_fd_vis_at(tk_nfield, vis);
    set_fd_sym_at(tk_nfield, sym);
    tk_nfield = tk_nfield + 1;
}

// a fresh row, in state `part`, at whatever position and file/line the caller
// hands over -- the ONE place that lays out every field of the type table
// (`tk_type_add` below for a real declaration, `tk_fwd_row`/`tk_fwd_row_by_ty`
// in teko_fwd.tk for a placeholder one, §50 O1)
i64 tk_type_row_new(uptr name, i64 ty, i64 base, i64 kind, i64 vis, i64 proj, i64 part, i64 line, uptr fl) {
    if (tk_nstruct == TK_MAXSTRUCT) err_at(fl, line, "teko: too many type declarations");
    set_sr_name_at(tk_nstruct, name);
    set_sr_ty_at(tk_nstruct, ty);
    set_sr_size_at(tk_nstruct, 0);
    set_sr_base_at(tk_nstruct, base);
    set_sr_kind_at(tk_nstruct, kind);
    set_sr_nv_at(tk_nstruct, 0);
    set_sr_m0_at(tk_nstruct, 0);
    set_sr_mn_at(tk_nstruct, 0);
    set_sr_ni_at(tk_nstruct, 0);
    set_sr_vis_at(tk_nstruct, vis);
    set_sr_proj_at(tk_nstruct, proj);
    set_sr_abst_at(tk_nstruct, 0);
    set_sr_part_at(tk_nstruct, part);
    set_sr_off_at(tk_nstruct, 0);
    set_sr_hline_at(tk_nstruct, line);
    set_sr_hfile_at(tk_nstruct, fl);
    tk_nstruct = tk_nstruct + 1;
    return tk_nstruct - 1;
}

// the row is appended BEFORE the body is read, so a field or a method body may
// name the type being declared -- UNLESS a use already materialized it ahead
// of this declaration (§50 O1, TK_PFWD): then the placeholder is ADOPTED in
// place instead of appended again, so its row index -- already read back by
// every site that resolved through it -- never moves.
i64 tk_type_add(uptr name, i64 ty, i64 base, i64 kind, i64 vis, i64 proj) {
    i64 si = tk_struct_find_exact(name);
    if (si >= 0 && sr_part_at(si) == TK_PFWD) {
        set_sr_base_at(si, base);
        set_sr_kind_at(si, kind);
        set_sr_part_at(si, TK_PWHOLE);
        set_sr_hline_at(si, tk_line);
        set_sr_hfile_at(si, tk_file);
        tk_fwd_adopt(si, vis, proj);
        return si;
    }
    return tk_type_row_new(name, ty, base, kind, vis, proj, TK_PWHOLE, tk_line, tk_file);
}

// the placeholder a `Box`-typed field, parameter, return, local or global
// resolves to before `class Box` is ever read (teko_fwd.tk's own
// `tk_fwd_row`/`tk_fwd_row_by_ty`): no base, no layout, TK_PFWD -- everything
// `tk_type_add` above fills in once the real declaration adopts it.
i64 tk_type_add_pending(uptr name, i64 ty, i64 kind, i64 vis, i64 proj) {
    return tk_type_row_new(name, ty, 0 - 1, kind, vis, proj, TK_PFWD, p_line(), p_file());
}

// ---- the static type of an already parsed expression ----
// Three sources, in the order that keeps the precise answer ahead of the
// heuristic one: a node this module built (a field of struct type, so `a.b.c`
// chains), a local the core declared (its N_VAR carried the type's own id,
// which is what type_new buys over type_alias), and a call, whose declared
// return type the core publishes through decl_find/decl_ret -- `new Point`
// lowers to `point_new()`, declared to return `Point`.
i64 tk_struct_of_expr(i64 n) {
    if (n == 0) return 0 - 1;
    i64 x = tk_xt_find(n);
    if (x >= 0) return x;
    if (nd_kind(n) == N_IDENT) return tk_local_find(nd_name(n));
    if (nd_kind(n) == N_CALL) {
        i64 d = decl_find(nd_name(n));
        if (d < 0) return 0 - 1;
        return tk_struct_by_ty(decl_ret(d));
    }
    return 0 - 1;
}

// ---- assignment compatibility (C#'s own implicit reference conversion) ----
// `tk_impl_has` (teko_iface.tk) is included after this file, and this
// section is read by it as much as the other way around -- forward-declared
// the same way every other early cross-file need already is here (§50 O1).
i64 tk_impl_has(i64 ci, i64 fi);

// teko_null.tk is included after this file too: 1 when a `null` node is the
// COMPILER's own placeholder rather than one a source wrote (Q1a).
i64 tk_nl_own_null_is(i64 n);

// 1 when `n` is the `null` literal (teko_type.tk's tk_null): the one ordinary
// N_INT this project ever types TY_UPTR, so a class, an interface, a struct,
// a delegate or a T[] of heap all accept it without needing a zero of their
// own.
i64 tk_is_null_lit(i64 n) {
    return n != 0 && nd_kind(n) == N_INT && nd_type(n) == TY_UPTR && nd_val(n) == 0;
}

// 1 when a value declared `ei` (a row of this table, or -1 when it names no
// row at all) fits a slot declared `ti`: identical, `ei` a class deriving
// from `ti`, or `ei` implementing `ti` -- `tk_impl_has` already flattens
// interface-extends-interface and copies a base class's own interfaces onto
// the derived one, so the same call answers both. A `T[]` or a delegate
// fits only its own identity, checked by the caller before this runs.
i64 tk_row_fits(i64 ti, i64 ei) {
    if (ti == ei) return 1;
    if (ei < 0) return 0;
    // Q1a (docs/specs/nullable.md § 4): `T` fits `T?`, and so does everything
    // that already fits `T` -- `D` into `B?`, `C` into `I?` -- because the
    // nullable row asks the very same question about what it encloses. The
    // two directions it does NOT answer are stated here rather than left to
    // fall through: `T?` fits no `T` (write `.Value`), and one nullable row
    // fits no other (no covariance between them).
    // Q1b: a nullable over a VALUE encloses no row at all, so no row fits it
    // -- a class in an `i64?` slot is refused here, and the value that DOES
    // fit is judged by type rather than by row (`tk_nl_check_value`,
    // teko_null.tk, reached from the scalar half of the same check).
    if (tk_is_nl(ti)) {
        if (tk_is_nl(ei)) return 0;
        i64 pi = tk_struct_by_ty(nl_of_at(ti));
        if (pi < 0) return 0;
        return tk_row_fits(pi, ei);
    }
    if (tk_is_nl(ei)) return 0;
    if (tk_is_ha(ti) || tk_is_deleg(ti)) return 0;
    if (tk_is_class(ei)) {
        i64 b = sr_base_at(ei);
        loop {
            if (b < 0) break;
            if (b == ti) return 1;
            b = sr_base_at(b);
        }
    }
    return tk_impl_has(ei, ti);
}

// C#'s own wording for a failed implicit reference conversion, one name on
// each side
void tk_reject_compat(uptr ename, uptr tname, i64 line, uptr fl) {
    err_at(fl, line, tk_join(tk_join3("teko: a value of type ", ename, " does not convert to "), tname));
}

// teko_typeof.tk is included after this file: the two questions D34 left the
// field store still owing, once `ei` cannot answer them (a scalar value, not
// a row) -- `tk_pty_of` is this same file's own parse-time oracle, asked here
// only for the ONE thing `tk_struct_of_expr` cannot tell a numeric value from
// "not known", and `tk_is_int_ty` is the positive list that says a value is
// an integer by id rather than by kind (D33's own rule). The PASS-TIME oracle
// is NOT asked here: this check runs at the door, and what the door cannot
// type is deferred rather than judged (D50, `tk_field_store_val`).
i64 tk_pty_of(i64 n);
i64 tk_is_int_ty(i64 t);
// ...and the judge itself (teko_typeof.tk), the one every other slot is given
void tk_check_compat(i64 tty, i64 ety, i64 en, i64 line, uptr fl);

// `p.f = e` / `p.items[i] = e` once the receiver's type IS known, at parse
// time: the field's own row against whatever `tk_struct_of_expr` can already
// tell about `v` -- a local, a field load, a `new` -- and nothing else,
// because a call whose return only the pass will resolve is not this early
// check's to guess at.
void tk_check_field_store(i64 fty, i64 v, i64 line, uptr fl) {
    i64 ti = tk_struct_by_ty(fty);
    if (ti < 0) return;
    // `null` is silent on the ROW question -- a reference fits any row --
    // exactly as it is in `tk_check_compat` (teko_typeof.tk), whose shape
    // this check is the parse-time half of. Q1a's rule (a `null` lands only
    // in a slot declared `T?`, docs/specs/nullable.md rule 1) is NOT asked
    // again here: this function has one caller, `tk_field_store_val`, and its
    // scalar half (`tk_check_scalar_compat`) has already given that very
    // verdict over the same node -- for EVERY site, the element store of a
    // `T[]` and of a fixed array included, since the fourth pass made them
    // all enter by the one door. An earlier wording claimed the element
    // store reached no other check and kept a second copy of the clause here
    // (Copilot on #698, pass 8).
    if (tk_is_null_lit(v)) return;
    i64 ei = tk_struct_of_expr(v);
    if (ei < 0) {
        // D34's own leftover gap, closed here: a value reaching a field of
        // ROW type converts nothing, in C# as much as the other direction
        // already refuses. `tk_struct_of_expr` answers about an OBJECT
        // expression only, so the value's type is asked through `tk_pty_of`
        // instead -- the same single oracle the door itself asks, and a value
        // it cannot type (`vty < 0`) is left alone here, exactly as every
        // other "not known here" is, because the store carrying it has
        // already been deferred (D50, `tk_field_store_val`).
        //
        // The verdict is `tk_check_compat`'s, the very judge an assignment, an
        // initializer, an argument and a `return` are given: a number was only
        // half of what a field of reference type does not take, and an `enum`,
        // a primitive with members, a raw `uptr` and an unrelated class each
        // crossed under the narrower clause that named the other two (Copilot
        // on #698, pass 1). Q1b's own exemption is inside that judge, so a
        // `T?` field BOXING a value (`i64? count; ... this.count = 5;`) is
        // still not caught by the row question its own slot never asks.
        tk_check_compat(fty, tk_pty_of(v), v, line, fl);
        return;
    }
    if (tk_row_fits(ti, ei)) return;
    tk_reject_compat(sr_name_at(ei), sr_name_at(ti), line, fl);
}

// every local's (name, declared type), whatever the type -- K4's `use (a,
// &b)` needs a capture's type at the exact point it reads the clause, and
// only a struct/class local is tracked by `tk_local_add` below.
//
// TWO QUESTIONS, and they were one answer for too long. The PARSER asks "what
// is this name, HERE?" and the answer has to respect the scope: `tk_slv_live`
// is a stack of indices, pushed with the entry and cut back at the same `}`
// `tk_local` is (teko_stmt.tk's `tk_block`, teko_loop.tk's own `foreach`
// header). A PASS asks "what did this unit ever declare under that name?",
// long after every scope closed, and reads the append-only rows instead --
// teko_params.tk's `tk_pm_arg_ty`, the one caller that runs there, and the
// reason the rows cannot simply be popped.
//
// One table answering both let a name declared in ONE function answer for a
// name spelled the same in the NEXT: an `f64 s` in one body typed the `i64 s`
// PARAMETER of another, and a virtual call passing it was refused for a
// conversion nobody wrote. A parameter is in no scope table at parse time, so
// the honest answer for it is -1, "not known here", which every caller of
// `tk_pty_of` already treats as "refuse nothing".
// `node` is the N_VAR the SOURCE wrote, or 0 when the compiler wrote it. Almost
// every temporary the passes generate (a ternary's hoisted arm, a nullable's
// unwrap, a lambda's captured copy) is built straight from `tk_var` and never
// reaches `tk_on_stmt` at all; the one that DOES is the `foreach` element, and
// `tk_stmt_gen` above is what marks it. `tk_copy_pass` (teko_copy.tk) reads the
// column to find the L1 landings, which is what keeps it from copying a
// declaration the compiler itself put there (V2).
void tk_slv_add(uptr name, i64 ty, i64 node) {
    if (tk_nslv == TK_MAXSLV) err_at(tk_file, tk_line, "teko: too many locals in one unit");
    set_slv_name_at(tk_nslv, name);
    set_slv_ty_at(tk_nslv, ty);
    set_slv_node_at(tk_nslv, node);
    set_slv_live_at(tk_nslv_live, tk_nslv);
    tk_nslv_live = tk_nslv_live + 1;
    tk_nslv = tk_nslv + 1;
}

// the parser's own lookup: the innermost declaration still in scope
i64 tk_slv_find(uptr name) {
    i64 i = tk_nslv_live - 1;
    loop {
        if (i < 0) break;
        i64 j = slv_live_at(i);
        if (str_eq(slv_name_at(j), name)) return slv_ty_at(j);
        i = i - 1;
    }
    return 0 - 1;
}

// higiene 2, item 1: a node's type as far as PARSING it alone can tell -- an
// already-tagged node's own tag (`tk_xt_ty`, e.g. a fresh `new C()`), a bare
// local's declared type (`tk_slv_find`, the same fallback K4's own `use (...)`
// already trusts), or, since V0 item 3, the declared RETURN TYPE of a call
// whose callee the unit has already declared (`decl_find`/`decl_ret`, the very
// pair the pass-time oracle `tk_ty_of` reads for the same node -- so an
// argument position now answers what an initializer position already did).
// Anything else (a field load not yet tagged, a callee declared further down,
// an indirect `callp` no declaration names) answers -1, silently skipped by
// `tk_check_compat` rather than guessed at -- a vtable/itab call's own
// arguments are checked at the PARSE-TIME call site (teko_expr.tk's
// `tk_vcall_args_check`, teko_iface.tk's `tk_ifargs_check`), before the
// pass-time scope table (`tk_ty_scope_find`) exists.
//
// A LITERAL and a CAST carry their own type in the node, and both are answered
// here -- the two arms `tk_pm_arg_ty` (teko_params.tk) had already stacked on
// top of this call for the elements of a `params` list, now given to every
// caller. `1.5` is an N_INT typed `f64` (`<float>`'s `fl_lit`) and `null` an
// N_INT typed `uptr` (teko_type.tk), so it is these two arms that let a
// virtual and an interface call be told, at the site that writes them, what an
// ordinary call already was.
i64 tk_pty_of(i64 n) {
    i64 t = tk_xt_ty(n);
    if (t >= 0) return t;
    i64 k = nd_kind(n);
    if (k == N_IDENT) return tk_slv_find(nd_name(n));
    if (k == N_CALL)  return decl_ret(decl_find(nd_name(n)));
    if (k == N_INT)   return nd_type(n);
    if (k == N_CAST)  return nd_type(n);
    return 0 - 1;
}

// 1 while a PASS-owned declaration is being announced through `tk_on_stmt`.
// `teko_loop.tk` builds the `foreach` element with `tk_var` and hands it to the
// hook so the element NAME is in scope for the body, but the node is the
// COMPILER's: `slv_node` stays 0 for it, and no landing of `teko_copy.tk`'s may
// touch it. Binding a struct `foreach` variable to a copy would make
// `foreach (S s in a) { s.n = 9; }` compile and write into a detached block --
// measured at 3 where the array reads 18 -- which is the class of bug D105
// exists to remove, and which V6 refuses outright instead (C# CS1654).
i64 tk_stmt_gen = 0;

// M21.5's statement hook: a local the CORE declared (`Point p = new Point;`)
// is observable here as the N_VAR node, and its type id is the struct or class.
// Nothing is rewritten -- the node that arrives is the node that leaves.
// `nd_val` is the array length, so `Point tbl[4];` (four pointers, not one
// object) is skipped.
i64 tk_on_stmt(i64 n) {
    if (n == 0) return n;
    if (nd_kind(n) != N_VAR) return n;
    if (nd_val(n) != 0) return n;
    i64 site = n;
    if (tk_stmt_gen) site = 0;                   // the compiler's own, not the source's
    tk_slv_add(nd_name(n), nd_type(n), site);
    i64 si = tk_struct_by_ty(nd_type(n));
    if (si >= 0) {
        tk_line = nd_line(n);
        tk_file = nd_file(n);
        // docs/specs/nullable.md § 3: `Cell? c;` IS `Cell? c = null;`. The `?`
        // is the licence to hold nothing, so the slot is written rather than
        // left reading whatever the frame held. Every other declaration keeps
        // the initializer the source gave it, or none.
        if (tk_is_nl(si) && nd_a(n) == 0) set_nd_a(n, tk_nullnode());
        tk_local_add(nd_name(n), si);
    }
    return n;
}

// ---- the constructor ----
// Name Name_new() { uptr p = rt_alloc(NAME_SIZE); <install> return p; }
// The declared return type is the type's own id, which is what makes
// `Point p = new Point;` and a call in `.` position resolve to it. `install` is
// empty for a struct and the vtable store for a class (teko_class.tk).
i64 tk_ctor(uptr name, i64 ty, i64 size, i64 install) {
    i64 stmts = tk_var(TY_UPTR, "p", tk_call("rt_alloc", tk_int(size)));
    if (install) stmts = list_append(stmts, install);
    i64 r = tk_id("p");
    tk_xt_add(r, tk_struct_by_ty(ty), 1, TK_OWNED);  // a NAME, so pure; D226 compat crumb:
                                                     // `p` is `uptr`, and the fresh object it
                                                     // names is the type itself
    stmts = list_append(stmts, tk_ret(r));
    return tk_func(ty, tk_ctor_name(name), 0, tk_blk(stmts));
}

// ---- the memberwise copy (V2, docs/specs/struct-value.md § 3.3) ----
// The fix-ups the whole-block `rt_copy` cannot carry, one line per field that
// needs one. Everything else -- padding, a `u8`/`u32` field's exact width, an
// inline array of scalars -- the bulk copy already moved.
//
// A COUNTED field (a class, an interface, a delegate, a `T[]`, a `T?` over any
// of them) is a new OWNER: `rt_copy` moved the pointer bits without touching
// the count, and without this line two struct blocks would name one object with
// a count of 1, the first release freeing it under the second (§ 8). `rc_inc(0)`
// is already a no-op, so a null field needs no guard.
//
// A STRUCT field is a value of its own and recurses through that struct's copy;
// V1 has already refused the shape that would recurse for ever.
//
// A STATIC field (`fd_sym_at != 0`) lives in a global and is no part of the
// object. An inline array field takes the same two roads element by element --
// its stride is 8, every element of a counted or struct type being a pointer;
// the struct arm is UNROLLED, which is `nel` statements for a field spelled
// `S a[nel]` and the same shape `tk_release_fields` (teko_class.tk) avoids by
// having a runtime helper it can pass a count to, which a per-type recursion
// has not.
i64 tk_copy_fields(i64 k) {
    i64 st = 0;
    i64 i = 0;
    loop {
        if (i >= tk_nfield) break;
        if (fd_cls_at(i) == k && fd_sym_at(i) == 0) {
            i64 fty = fd_ty_at(i);
            i64 off = fd_off_at(i);
            i64 nel = fd_nel_at(i);
            if (tk_is_counted(fty)) {
                if (nel > 0)
                    st = list_append(st, tk_stmt(tk_call2("rt_retain_array",
                            tk_bin(K_ADD, tk_id("d"), tk_int(off)), tk_int(nel))));
                else
                    st = list_append(st, tk_stmt(tk_call("rc_inc",
                            tk_call("ld64", tk_bin(K_ADD, tk_id("s"), tk_int(off))))));
            } else if (tk_is_struct(tk_struct_by_ty(fty))) {
                uptr cp = tk_copy_name(sr_name_at(tk_struct_by_ty(fty)));
                i64 n = nel;
                if (n == 0) n = 1;
                i64 j = 0;
                loop {
                    if (j >= n) break;
                    i64 o = off + j * 8;
                    st = list_append(st, tk_stmt(tk_call2("st64",
                            tk_bin(K_ADD, tk_id("d"), tk_int(o)),
                            tk_call(cp, tk_call("ld64", tk_bin(K_ADD, tk_id("s"), tk_int(o)))))));
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    return st;
}

// Name Name_copy(uptr s) { if (s == 0) return 0;
//                          uptr d = rt_alloc(NAME_SIZE);
//                          rt_copy(d, s, NAME_SIZE); <fix-ups> return d; }
// The declared RETURN type is the struct's own id, which is what makes
// `S b = s_copy(a);` type exactly as `S b = new S;` does -- the call is typed by
// `decl_ret` (teko_typeof.tk). The PARAMETER is `uptr`, the same spelling a
// method's implicit receiver takes (teko_this.tk), so the field arithmetic in
// the body is plain pointer arithmetic and a struct value lands on it the way it
// lands on `this`.
//
// `s == 0` is not C#'s shape -- there a struct field is never null -- but it is
// this representation's: a struct field is a pointer that `rt_alloc` zeroed, so
// a struct whose struct-typed field was never built reaches here with 0, and
// `rt_copy` would read address 0. The null is copied AS null, which is what the
// alias answered before.
i64 tk_copy_fn(uptr name, i64 ty, i64 si, i64 size) {
    i64 z = tk_int(0);                           // the null handle, typed as the struct: the
    tk_xt_add(z, si, 1, TK_BORROWED);            // slot it returns into is `Name`, not `i64`
    i64 stmts = tk_if(tk_bin(K_EQ, tk_id("s"), tk_int(0)), tk_ret(z));
    stmts = list_append(stmts, tk_var(TY_UPTR, "d", tk_call("rt_alloc", tk_int(size))));
    stmts = list_append(stmts, tk_stmt(tk_call3("rt_copy", tk_id("d"), tk_id("s"), tk_int(size))));
    stmts = list_append(stmts, tk_copy_fields(si));
    i64 r = tk_id("d");
    tk_xt_add(r, si, 1, TK_OWNED);               // `d` is `uptr`, and the fresh block it
                                                 // names is the type itself (tk_ctor's own note)
    stmts = list_append(stmts, tk_ret(r));
    return tk_func(ty, tk_copy_name(name), param_new(TY_UPTR, "s"), tk_blk(stmts));
}

// a name being declared: an identifier that is still free. `type_new` reserves
// the word, so a second `struct Point` (or `struct str`) arrives here as a
// keyword rather than as T_IDENT -- without this guard the error would come out
// as an unexplained "name expected".
//
// A namespaced short type word (§31 N1) is ALSO reserved this way from its
// second declaration onward -- `geo.Circle` claims the word "Circle" for
// EVERY namespace, so `mesh { class Circle { ... } }` would otherwise fail
// this same way. It is accepted here, but only when the CURRENT namespace has
// not already declared it: the qualified exact-match answers a genuine
// `mesh.Circle` beside `geo.Circle` (two different rows) from a true
// duplicate `geo.Circle` declared twice with no `partial` (`tk_class`'s own
// reopen check already took the `partial` case before this is ever reached).
// §58 DI1: `teko_di.tk` is included after every type declaration in this
// file, but a service marker's name is reserved from the very first
// declaration this function ever reads
i64 tk_di_marker(uptr nm);

// the seven `type_alias` words teko itself declares (teko_type.tk's own
// `tk_types_init`): an alias leaves no row in mc's type table to count, so
// a `class`/`struct`/`interface`/`delegate` reusing one of these words is
// caught against this list instead of the counting check below. Teko owns
// these words; the list is kept beside their declaration.
i64 tk_type_alias_word(uptr name) {
    if (str_eq(name, "bool"))  return 1;
    if (str_eq(name, "char"))  return 1;
    if (str_eq(name, "byte"))  return 1;
    if (str_eq(name, "isize")) return 1;
    if (str_eq(name, "usize")) return 1;
    if (str_eq(name, "ptr"))   return 1;
    if (str_eq(name, "str"))   return 1;
    return 0;
}

// 1 when `name` is a type WORD registered more than once in mc's type
// table: `tk_fwd_reg_type` (teko_fwd.tk) calls `type_new` blind, guarded
// only by its own forward-scan table (`tk_fwd_find`), so a
// `class`/`struct`/`interface`/`delegate` that reuses an already-taught
// primitive's word -- `TimeSpan`, `f64`, `i32`... -- lands a SECOND row
// under the same word instead of being refused. Counting is the only
// signal left behind: a name taught once is an ordinary forward
// reference, taught twice is this shadow.
i64 tk_type_word_shadowed(uptr name) {
    if (tk_type_alias_word(name)) return 1;
    i64 n = 0;
    i64 t = 0;
    i64 tc = type_count();
    loop {
        if (t >= tc) break;
        if (str_eq(type_name(t), name)) n = n + 1;
        if (n > 1) return 1;
        t = t + 1;
    }
    return 0;
}

uptr tk_newname(uptr what) {
    if (tk_gen_find(p_name()) >= 0)
        err_at2(p_file(), p_line(), "teko: the name is already a generic", p_name());
    if (tk_di_marker(p_name()) >= 0)
        err_at(p_file(), p_line(), tk_join3("teko: ", p_name(), " is the service marker"));
    if (p_id() == T_IDENT) return p_ident();
    uptr qname_fwd = tk_ns_qualified_name(p_name());
    if (tk_fwd_pending(qname_fwd)) {
        uptr nm = p_name();
        if (tk_type_word_shadowed(qname_fwd))
            err_at2(p_file(), p_line(), "teko: the name is already a type", nm);
        p_next();
        return nm;
    }
    if (tk_ns_short_known(p_name())) {
        uptr nm = p_name();
        if (tk_struct_find_exact(tk_ns_qualified_name(nm)) >= 0)
            err_at2(p_file(), p_line(), "teko: the name is already a type", nm);
        p_next();
        return nm;
    }
    if (alias_find(p_id()) >= 0)
        err_at2(p_file(), p_line(), "teko: the name is already a type", p_name());
    err_at2(p_file(), p_line(), tk_join3("teko: name of ", what, " expected"), p_name());
    return 0;
}

// D68: a member name -- read at a `.` (`p.year`, `Type.year`, `this.year`,
// `base.year`, `p?.year`) or DECLARED as one (a field, a method, a property,
// an enum member, a const) -- may be a word teko itself has TAUGHT, exactly
// as C# lets a member share a name with a contextual keyword. `word_is_taught`
// (mc core, src/hooks.mc) answers 1 for a word a `syntax`/`syntax_stmt`/
// `syntax_expr`/`type_alias`/`type_new` registration reserved PROGRAM-WIDE --
// every teko keyword and every type word, including one a `class`/`struct`/
// `enum`/`interface`/`trait`/`delegate` declaration taught. `p_name()` reads
// the token's own lexeme whichever id it carries; every OTHER seat -- a TYPE
// name (`tk_newname`), a LOCAL, a PARAMETER, a FUNCTION -- keeps `p_ident()`
// and its refusal (D60): there is no such shadow risk after a `.` or in a
// member's own declaration, so widening stops exactly here.
// ...and only a WORD: `word_is_taught` also answers 1 for punctuation with a
// registered infix handler (`+`, the `.`/`[`/`?` of member access -- mc
// hooks.md, `syntax_expr_find` is one of its checks), which is no name for
// a member; the lexeme's first byte tells the two apart (Copilot on #724).
i64 tk_member_word_ok() {
    if (p_id() == T_IDENT) return 1;
    if (!word_is_taught(p_id())) return 0;
    i64 c = ld8(p_name());
    return is_alpha(c) || c == '_';
}

uptr tk_member_name() {
    if (p_id() != T_IDENT && tk_member_word_ok()) {
        uptr m = p_name();
        p_next();
        return m;
    }
    return p_ident();
}

// `[4]` after a field name: an INLINE array of that many elements, whose size
// the instantiation of a generic fixes (`T items[N]`, N substituted by
// p_subst_int). 0 when the field is a scalar.
i64 tk_field_dim() {
    if (!p_accept(K_LBRACK)) return 0;
    if (p_id() != T_INT)
        err_at(p_file(), p_line(), "teko: an array field size is an integer literal");
    i64 n = p_val();
    if (n < 1) err_at(p_file(), p_line(), "teko: an array field size is positive");
    p_next();
    p_expect(K_RBRACK, "expected ] after the array field size");
    return n;
}

// what both shapes of a field declaration refuse before they place anything
void tk_field_gate(i64 si, uptr m, i64 fty) {
    if (fty == TY_VOID) err_at2(tk_file, tk_line, "teko: field of type void", m);
    if (tk_field_find(si, m) >= 0) err_at2(tk_file, tk_line, "teko: duplicate field", m);
}

// places `m`, of type `fty`, at or after `off` and returns the next offset:
// the natural alignment of the field's own width, the `#define` of the offset,
// and the row in the field table. `nel` elements when the field is an array,
// laid out inline, so the object grows with the constant the generic was
// instantiated with.
i64 tk_field_place(i64 si, uptr tname, uptr m, i64 fty, i64 nel, i64 off, i64 vis) {
    tk_field_gate(si, m, fty);
    i64 w = type_width(fty);
    off = (off + w - 1) & ~(w - 1);
    def_add(tk_cname(tname, m), off, tk_line, tk_file);
    tk_field_add(si, m, off, fty, nel, vis, 0);
    if (nel > 0) return off + w * nel;
    return off + w;
}

// a STATIC field is one global of the field's own width, named `Type_field`, and
// no part of the object at all -- so the layout, and every `#define` of an
// offset after it, is what it would be if the field were not written
void tk_static_field(i64 si, uptr tname, uptr m, i64 fty, i64 nel, i64 vis) {
    tk_field_gate(si, m, fty);
    uptr sym = tk_fname(tname, m);
    i64 n = nel;
    if (n == 0) n = 1;
    tk_top_emit_as(tk_glb(TY_U8, sym, type_width(fty) * n), 0);   // `point_made` is the compiler's (D48)
    tk_field_add(si, m, 0, fty, nel, vis, sym);
}

// ---- an array field, and the `[` that is the only way to reach one ----
void tk_ax_add(i64 n, i64 ty, i64 nel, uptr name) {
    if (tk_nax == TK_MAXAX) err_at(tk_file, tk_line, "teko: too many array-field accesses");
    set_ax_node_at(tk_nax, n);
    set_ax_ty_at(tk_nax, ty);
    set_ax_nel_at(tk_nax, nel);
    set_ax_name_at(tk_nax, name);
    tk_nax = tk_nax + 1;
}

i64 tk_ax_find(i64 n) {
    i64 i = tk_nax - 1;
    loop {
        if (i < 0) break;
        if (ax_node_at(i) == n) return i;
        i = i - 1;
    }
    return 0 - 1;
}

// `p.items` is the ADDRESS of the array, tagged with the element type and the
// length so that `[` can bound-check it. The array itself is not a value: there
// is nothing for `p.items` alone, or for `p.items = e`, to be.
i64 tk_array_of(i64 addr, i64 fi, i64 line, uptr fl) {
    if (p_id() == K_ASSIGN)
        err_at2(fl, line, "teko: an array field is assigned one element at a time", fd_name_at(fi));
    if (p_id() != K_LBRACK)
        err_at2(fl, line, "teko: an array field is read one element at a time", fd_name_at(fi));
    tk_ax_add(addr, fd_ty_at(fi), fd_nel_at(fi), fd_name_at(fi));
    return addr;
}

uptr tk_ax_msg(i64 k, uptr what, uptr name, i64 nel) {
    return tk_join3(tk_join3("teko: index ", tk_num(k), what),
                    name, tk_join3("[", tk_num(nel), "]"));
}

// i64 tk_ix(i64 i, i64 n) { if (i < 0) rt_panic(...); if (i >= n) rt_panic(...);
// return i; } -- emitted ONCE, into the program, and only when a program really
// indexes an array field with something other than a literal. A program that
// does not is left with exactly the tree it had, which is what the no-op proof
// of a taught construct means.
i64 tk_ix_emitted = 0;

void tk_ix_emit() {
    if (tk_ix_emitted) return;
    tk_ix_emitted = 1;
    i64 low = tk_if(tk_bin(K_LT, tk_id("i"), tk_int(0)),
                    tk_stmt(tk_call("rt_panic", tk_str("index below zero into an array field"))));
    i64 high = tk_if(tk_bin(K_GE, tk_id("i"), tk_id("n")),
                     tk_stmt(tk_call("rt_panic", tk_str("index past the end of an array field"))));
    i64 body = tk_blk(list_append(list_append(low, high), tk_ret(tk_id("i"))));
    i64 prs = list_append(param_new(TY_I64, "i"), param_new(TY_I64, "n"));
    tk_top_emit(tk_func(TY_I64, "tk_ix", prs, body));
}

// A LITERAL index is decided here, against the constant the instantiation
// fixed -- which is the whole point of a generic taking a `const N`. Anything
// else is checked at run time by tk_ix, so no index ever reads past the object
// in silence.
i64 tk_ax_index(i64 idx, i64 nel, uptr name, i64 line, uptr fl) {
    if (nd_kind(idx) != N_INT) {
        tk_ix_emit();
        return tk_call2("tk_ix", idx, tk_int(nel));
    }
    i64 k = nd_val(idx);
    if (k < 0) err_at(fl, line, tk_ax_msg(k, " is before the start of ", name, nel));
    if (k >= nel) err_at(fl, line, tk_ax_msg(k, " is past the end of ", name, nel));
    return idx;
}

// `p.items[i]` and `p.items[i] = e`: the load or the store of the element's own
// width. `=` is read here for the same reason tk_field_use reads it -- it is not
// in the core's infix table, so the Pratt loop has already stopped. A receiver
// sunk through a `- ! ~` chain (teko_prefix.tk, `tk_bracket_no_write`) is never
// the write target the source named: `!p.items[0] = e` refuses of its own accord
// instead of building a store the wrapping `!` would then choke on.
i64 tk_array_index(i64 addr, i64 x) {
    i64 line = p_line();
    uptr fl = p_file();
    i64 ety = ax_ty_at(x);
    i64 idx = parse_expr(0);
    p_expect(K_RBRACK, "expected ] after the index");
    tk_line = line;
    tk_file = fl;
    i64 k = tk_ax_index(idx, ax_nel_at(x), ax_name_at(x), line, fl);
    i64 at = tk_bin(K_ADD, addr, tk_bin(K_MUL, k, tk_int(type_width(ety))));
    if (tk_bracket_no_write && p_id() == K_ASSIGN)
        err_at(fl, line, "teko: the left side of = is not a place");
    if (p_accept(K_ASSIGN)) {
        i64 v = parse_expr(0);
        v = tk_field_store_val(ety, v, line, fl);
        tk_line = line;
        tk_file = fl;
        return tk_os_mark(tk_call2(tk_stn(ety), at, v), ety);
    }
    i64 r = tk_ld(ety, at);
    // the ELEMENT type, whatever it is -- the row when it has one and the type
    // id in every case, the same tag every other load carries (`tk_ha_load`,
    // `tk_field_use`). A SCALAR element answered -1 to every oracle, so
    // `f64 rate; this.rate = this.items[0];` on an `i64 items[2]` reached the
    // field-store judge with no type at all and was refused, `teko: the type of
    // this value is not known here` (Copilot on #698, pass 6).
    tk_xt_put(r, tk_struct_by_ty(ety), ety, 1, TK_BORROWED);
    return r;
}

// the whole object is aligned to 8, and exists even with no field at all
i64 tk_size_of(i64 off) {
    off = (off + 7) & ~7;
    if (off == 0) return 8;
    return off;
}

// ---- a struct cannot contain itself (V1, docs/specs/struct-value.md § 4.4) ----
// 1 when `si` is reachable from `k` by following the struct-typed fields that
// live IN the object. A static field (`fd_sym_at != 0`) is a global of its own
// and is no part of any object, so it closes no cycle; an inline array field
// (`fd_nel_at > 0`) is read exactly like a scalar one, its element type being
// the thing that recurses.
//
// The walk needs no visited set and cannot loop: every cycle is refused at the
// closing `}` of the struct that COMPLETES it, so the field graph this reads is
// acyclic by induction. A forward-declared struct carries no field yet, which
// is why the mutual case is only visible at the second declaration's own close.
i64 tk_struct_contains(i64 k, i64 si) {
    i64 i = 0;
    loop {
        if (i >= tk_nfield) break;
        if (fd_cls_at(i) == k && fd_sym_at(i) == 0) {
            i64 fi = tk_struct_by_ty(fd_ty_at(i));
            if (tk_is_struct(fi)) {
                if (fi == si) return 1;
                if (tk_struct_contains(fi, si)) return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

// `struct Node { Node next; }` and `struct A { B b; } struct B { A a; }` both
// compiled before this check, giving `next`/`a` an eight-byte pointer; C#
// refuses the same shape as CS0523. The copy of V2 is memberwise and recurses
// through every struct-typed field, so either shape would recurse for ever --
// at compile time in `tk_copy_fn`, and at run time in the body it emits.
// A linked structure is a `class`, whose value is a reference this design does
// not touch.
void tk_struct_cycle_check(i64 si) {
    if (!tk_struct_contains(si, si)) return;
    err_at(tk_file, tk_line, "teko: a struct cannot contain itself");
}

// ---- struct Name { type field; ... } ----
void tk_struct() {
    tk_line = p_line();
    tk_file = p_file();
    i64 head_line = tk_line;                     // position of the `struct` word
    uptr head_file = tk_file;
    p_next();                                    // the `struct` word
    i64 vis = tk_take_decl_vis();                // the `public`/`internal` before the word
    i64 proj = tk_take_decl_proj();
    uptr name = tk_newname("struct");
    if (p_id() == K_LT) {                        // struct Name<T, const N: i64>
        tk_gen_record(name, TK_KSTRUCT, vis, proj, 0, 0);   // recorded, not declared
        return;
    }
    name = tk_ns_qualify(name);                  // the current namespace, if any (§31 N1)
    i64 ty = tk_type_word(name);                 // a field of its own type parses
    i64 si = tk_type_add(name, ty, 0 - 1, TK_KSTRUCT, vis, proj);   // no base, no vtable: offset 0
    tk_use_reset();
    p_expect(K_LBRACE, "expected { in the struct body");
    i64 off = 0;
    loop {
        if (p_id() == K_RBRACE) break;
        if (p_id() == T_EOF) err_at(head_file, head_line, "unterminated struct");
        tk_line = p_line();                      // errors and nodes for this member
        tk_file = p_file();
        off = tk_member(si, name, off, 0 - 1);   // fields and methods, the class's own machine
    }
    p_next();                                    // }
    p_accept(K_SEMI);                            // a C programmer's trailing ;
    tk_line = head_line;                         // back to the struct's own level
    tk_file = head_file;
    tk_struct_cycle_check(si);                   // V1, before anything walks the fields
    i64 size = tk_size_of(off);
    set_sr_size_at(si, size);
    def_add(tk_join(tk_case(name, 1), "_SIZE"), size, tk_line, tk_file);
    tk_top_emit_as(tk_ctor(name, ty, size, 0), 0);   // `point_new` is the compiler's (D48)
    tk_top_emit_as(tk_copy_fn(name, ty, si, size), 0);   // ...and so is `point_copy` (V2)
}
