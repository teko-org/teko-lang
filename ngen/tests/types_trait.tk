// types_trait.tk -- `trait` (entrega 3, D214) in PHP's model: the members are
// COPIED into the class at compile time, so the trait's field lands in the
// class's own layout (WIDGET_N below) and its methods are the class's own.
// The three precedences PHP fixes are what the returns check: the class's own
// member wins over the trait's (`label`), the trait's wins over the one
// inherited from the base (`kind`, which takes Base's virtual slot), and a
// trait may use a trait (`Tagged` uses `Counted`).
//
// A trait method names the field without a receiver, and it resolves against
// the class the member was copied INTO -- `n = n + k` is a store into
// `WIDGET_N`, decided once Widget exists.
//
// expect-exit: 42

#include "../lib/rt.tk"

trait Counted {
    protected i64 n;

    public i64 bump(i64 k) {
        n = n + k;
        return n;
    }

    public i64 kind() {
        return 7;
    }

    public i64 label() {
        return 8;
    }
}

trait Tagged {
    use Counted;

    public i64 tag() {
        return 10;
    }
}

class Base {
    public virtual i64 kind() {
        return 99;
    }

    public virtual i64 label() {
        return 98;
    }
}

class Widget : Base {
    use Tagged;

    public i64 w;

    public override i64 label() {
        return 5;
    }
}

i64 main() {
    if (WIDGET_W != 16) return 1;                // the class's own field, after the header
    if (WIDGET_N != 24) return 2;                // the trait's, placed by the same machine
    if (WIDGET_SIZE != 32) return 3;

    Widget g = new Widget;
    g.w = 2;
    if (g.bump(3) != 3) return 4;                // the trait's method over the trait's field
    if (g.bump(4) != 7) return 5;
    if (g.tag() != 10) return 6;                 // the outer trait's own method
    if (g.kind() != 7) return 7;                 // the trait wins over the base
    if (g.label() != 5) return 8;                // the class wins over the trait

    Base b = g;
    if (b.kind() != 7) return 9;                 // ...both through the base's vtable slot
    if (b.label() != 5) return 10;

    Base p = new Base;
    if (p.kind() != 99) return 11;               // the base still answers on its own

    return g.bump(0) + g.tag() + g.kind() + g.label() + 13;
}
