// surface_default_free.tk -- a default parameter value in a free (top-level)
// function (entrega 4, crumb C6, unblocked by mc 0.10.3's `syntax_param`):
// `add(i64 a, i64 b = 10)` completes a short call from a pass(), the same
// call-site fill teko_class.tk already gives a method's own default
// (surface_default_method.tk). `scale3` carries TWO, filled from the
// trailing end. `pref` is declared both with and without a default at the
// SAME arity: C#'s own rule (§12.6.4.5, "a candidate that needs no default
// wins") is what this fixture asserts -- `pref(1)` picks the signature that
// never asks the default table anything. A call written inside a CLASS
// METHOD's own body is read by the same pass, over the node array,
// regardless of which function's tree it hangs off.
//
// expect-exit: 42

#include "../lib/rt.tk"

i64 add(i64 a, i64 b = 10) {
    return a + b;
}

i64 scale3(i64 a, i64 b = 2, i64 c = 3) {
    return a * b * c;
}

i64 pref(i64 n) {
    return n + 100;
}

i64 pref(i64 n, i64 k = 5) {
    return n + k;
}

class Box {
    public i64 v;
    public i64 use_default() {
        return add(v);
    }
}

i64 main() {
    if (add(1) != 11) return 1;                   // one default filled
    if (add(1, 2) != 3) return 2;                 // both given: nothing filled

    if (scale3(2) != 12) return 3;                // both defaults filled
    if (scale3(2, 4) != 24) return 4;             // one default filled
    if (scale3(2, 4, 5) != 40) return 5;          // all three given

    if (pref(1) != 101) return 6;                 // the signature with no default wins
    if (pref(1, 2) != 3) return 7;                // only the defaulted one takes two

    Box b = new Box;
    b.v = 1;
    if (b.use_default() != 11) return 8;          // a call inside a method's own body

    return add(1) + scale3(2, 4) + pref(1, 2) + 4;   // 11 + 24 + 3 + 4
}
