// surface_panic_index.tk -- `T[]` of heap (K3, D221 §41): `xs[i]` is a
// run-time-checked address (`tk_arr_at`, lib/rt.tk); an index past the end
// of the array panics instead of reading past the allocation.
//
// expect-exit: 70

#include "../lib/rt.tk"

i64 main() {
    i64[] xs = new i64[3];
    xs[0] = 1;
    xs[1] = 2;
    xs[2] = 3;
    return xs[5];
}
