// ngen/tests/parts/geo.tk -- the file `import parts.geo;` brings in
// (surface_import.tk, entrega 5, crumb N3); excluded from the fixture glob,
// same as `parts/ns_file.tk`'s own `namespace parts;` (it declares no
// `main`).
//
// `namespace parts.geo;`, file-scoped (C# 10), same form `parts/ns_file.tk`
// already exercises. `Circle` carries no modifier -- `internal` by default
// (D220) -- and is still reachable from `surface_import.tk`: both files sit
// inside the SAME project directory `mc.macos.toml`'s own `[project]` names,
// so `tk_origin_of_file` answers "the project" for either one.

namespace parts.geo;

class Circle {
    public i64 r;

    public i64 area() {
        return r * r;
    }
}

i64 twice(i64 x) {
    return x * 2;
}
