// teko_ternary.tk -- the ternary operator `c ? a : b` (D228, delivery 5): C#'s
// own spelling, associative to the right, one precedence step below `||`.
//
// The core has no control flow in expression position -- `parse_expr` builds
// only the fifteen binary rows of mc docs/reference/language.md's own table,
// never an `if` -- so `tk_tern_infix` (`syntax_infix("?", TK_TERN_PREC, ...)`)
// can only build a PLACEHOLDER: a call to `tk_ternary`, a name nothing
// declares, the very trick teko_typeof.tk's own `tk_defer_member` already
// plays for a `.` the parser cannot resolve yet. If the pass below were never
// registered the core's own resolver would refuse the call outright ("call to
// unknown function"), never silently miscompile -- the same safety net
// `tk_defer_member`'s header explains.
//
// `TK_TERN_PREC` is 1, tied with `||` and not below it: `syntax_infix`
// refuses a precedence outside 1..100 (mc docs/reference/hooks.md §
// syntax_infix), and 1 is already the table's lowest row. Tying the two
// still parses `a || b ? c : d` as `(a || b) ? c : d` -- the Pratt loop
// finishes combining every `||` at the outer call's own precedence floor
// before it ever offers `?` a `left` -- and reading `b` with
// `parse_expr(TK_TERN_PREC)` (the SAME floor, not one above it) is what makes
// the operator right-associative: a `?` appearing while `b` is being read is
// offered to THIS floor too, so `c1 ? a : c2 ? b : d` reads as `c1 ? a : (c2
// ? b : d)`.
//
// WHY THIS PASS RUNS RIGHT AFTER teko_typeof.tk, not right after teko_ns.tk
// as the crumb's own first guess. `tk_ty_of`, the oracle `tk_tern_lower`
// leans on to type an arm, answers a `.` on a receiver the parser could not
// type (a parameter, a field of unknown static type) only once
// teko_typeof.tk's own pass has rewritten the deferred placeholder into the
// field load / call it stands for -- ahead of that the placeholder is a call
// to a name nothing declares, and `tk_ty_of` reports -1 for it, same as it
// would for a ternary read too early. teko_rc.tk runs LAST for the identical
// reason ("after teko_typeof.tk has resolved every deferred access and every
// node has its type", that file's own header). So this file runs BEHIND the
// oracle and AHEAD of every pass that only has to see ordinary `if`s and
// ordinary locals -- teko_ops.tk, teko_default.tk, teko_over.tk, teko_rc.tk
// -- none of the four has to learn what a ternary was.
//
// LAZY ARMS. `c ? a : b` runs exactly one of `a`/`b`, so `tk_tern_lower`
// hoists each into the BRANCH that reads it, never into the statement's own
// preamble. A ternary nested inside an arm -- `c1 ? a : c2 ? b : d`, which
// the right-associative read above turns into `tk_ternary(c1, a,
// tk_ternary(c2, b, d))`, the same shape a literally nested arm
// `c ? (x ? y : z) : w` already has -- is lowered from the inside out
// (`tk_tern_scan`'s own recursion visits `a`/`b` before it visits `n`
// itself), but the INNER `if` always lands inside the OUTER's own branch:
// laziness survives nesting. Only the CONDITION is hoisted unconditionally,
// into the SAME list the ternary itself joins -- it runs whichever branch is
// taken, so hoisting it there costs nothing.
//
// A ternary in the condition of a `while`/`for` (teko_loop.tk's own
// `if (!(c)) break;`, inside the loop's body block) is hoisted into that
// SAME body block, ahead of the guard -- which is what makes it run again
// every iteration, the same way any other read of a loop-carried local would.
// A ternary in a `return`/`if` written without braces is hoisted by wrapping
// the lone statement into a block of its own (`tk_tern_branch`), exactly the
// fencing teko_rc.tk's own `tk_rc_branch` already does for a parked
// temporary.
//
// A program that never writes `?` leaves before a single node is read
// (`tk_ntern == 0`, incremented only by the parser reading one) -- the same
// no-op proof every other pass here carries.

#define TK_TERN_PREC 1

i64 tk_ntern = 0;

// `c ? a : b`, `left` already parsed and consumed by the Pratt loop: this
// handler owns everything from `a` onward, `:` included -- the placeholder it
// returns is unpacked by `tk_ternary_pass`, never by the core.
i64 tk_tern_infix(i64 c) {
    i64 line = p_line();
    uptr fl = p_file();
    i64 a = parse_expr(0);
    p_expect(K_COLON, "expected ':' in a ternary");
    i64 b = parse_expr(TK_TERN_PREC);
    tk_line = line;
    tk_file = fl;
    i64 n = tk_call("tk_ternary", list_append(list_append(c, a), b));
    tk_ntern = tk_ntern + 1;
    return n;
}

i64 tk_tern_assign(uptr name, i64 val) {
    i64 n = tk_nd(N_ASSIGN);
    set_nd_name(n, name);
    set_nd_a(n, val);
    return n;
}

// a shallow copy of `n`, the same one teko_rc.tk's `tk_rc_detach` takes: what
// `n` held keeps its own children and its place in the tree while `n`'s own
// slot is overwritten in place
i64 tk_tern_detach(i64 n) {
    i64 c = node_new(nd_kind(n), nd_line(n), nd_file(n));
    set_nd_op(c, nd_op(n));
    set_nd_type(c, nd_type(n));
    set_nd_val(c, nd_val(n));
    set_nd_name(c, nd_name(n));
    set_nd_a(c, nd_a(n));
    set_nd_b(c, nd_b(n));
    set_nd_c(c, nd_c(n));
    set_nd_d(c, nd_d(n));
    return c;
}

void tk_tern_at(i64 n) {
    tk_line = nd_line(n);
    tk_file = nd_file(n);
}

// what a hoisted temporary is DECLARED with, before either branch overwrites
// it. D226 compat crumb: the placeholder never survives to be read (both
// branches assign to it before anything else touches it), but a teko-typed one
// is `null` rather than a plain `0` -- the one shape the assignment-
// compatibility check already knows fits any such slot. Q1a: it is the
// COMPILER's own null, registered as such (teko_null.tk), since rule 1 refuses
// a null a SOURCE writes outside a `T?` slot and this temporary is not the
// source's. A PRIMITIVE slot (docs/specs/datetime.md § 5) takes neither: it
// converts from nothing but itself, the plain `0` included, so the placeholder
// is that same zero under the slot's own type -- the identity cast
// teko_prim.tk writes everywhere else for the same reason.
//
// docs/specs/enum.md § 5: an ENUM row is a row of the same table and is NOT a
// reference -- it converts from nothing but itself, `null` included -- so the
// placeholder is the zero of its own type, the very node `Color.Red` is
// (`tk_static_member`, teko_access.tk: an `N_INT` retagged to the enum). Before
// this clause `Color j = c ? Color.Red : Color.Blue;` was refused with
// "a value of type uptr does not convert to Color", for a `null` the source
// never wrote.
//
// Q2 shares it: `??` and `?.` declare their own result temporary the same way
// (teko_null.tk).
i64 tk_tern_zero(i64 ty) {
    if (tk_prim_is(ty)) return tk_cast(ty, tk_int(0));
    if (tk_is_enum(tk_struct_by_ty(ty))) {
        i64 z = tk_int(0);
        set_nd_type(z, ty);
        return z;
    }
    if (tk_struct_by_ty(ty) >= 0) return tk_nl_own_null();
    return tk_int(0);
}

void tk_tern_scan(i64 n, uptr dst);

// docs/specs/datetime.md § 2: teko_prim.tk is included after this file (it
// reads the tables of every module the parse builds), so the one question this
// file asks it -- is this slot a primitive with members -- is declared here
i64 tk_prim_is(i64 ty);

// ---- D82: `/` and `%` over a plain integer refuse zero, and (signed) the
// one quotient the machine cannot hold ----
//
// The core owns a plain int/int `/` and `%` untouched (teko_ops.tk's own
// `tk_ops_binary`, `if (sa < 0 && sb < 0) return;`) and hands it straight to
// `sdiv`/`idiv` -- which answer three DIFFERENT things for the same source
// depending on which CI leg runs it (aarch64's `sdiv` answers 0 for `/0` and
// the dividend for `%0`; x86_64's `idiv` traps, SIGFPE, exit 136; and
// `MinValue / -1` overflows the quotient register on x86_64 while aarch64
// answers `MinValue` back in silence). D3: C# throws `DivideByZeroException`
// and, on both its own ISAs, `OverflowException` for the second -- so this is
// the delta the core's own grammar does not carry, taught here rather than
// worked around per-backend (D2).
//
// THE DOOR is this pass's own walk: it already visits every function
// (`tk_ternary_pass`, no longer skipped when nothing writes `?`/`??`/`?.` --
// see that function's own header) and every expression in it
// (`tk_tern_scan`), so a division reached while scanning is guarded right
// there, ahead of the statement that holds it, the same `*dst` accumulator a
// hoisted ternary condition already joins.
//
// WHY THE OPERANDS ARE SCANNED FIRST. `tk_tern_scan`'s own generic branch
// recurses into every child before this file ever asks what kind of node it
// is looking at (`teko_ternary.tk`'s own dispatch, below) -- so a division
// nested in a ternary arm, or a ternary nested in a division's own operand,
// is already lowered into a plain reference by the time `tk_div_guard` reads
// its type. Asking `tk_ty_of` any earlier would answer -1 for an
// unresolved `tk_ternary(...)` placeholder and silently skip the guard.
//
// A LITERAL nonzero divisor needs no guard at all -- `x / 2` is left exactly
// as the core wrote it, and it is what keeps `--dump-ast` unmoved for the
// common case and for most of the compiler's own divisions (D82's own gate
// entry: every one of them divides by a `#define`d constant). A LITERAL
// divisor never reaches the run-time guard at all (`tk_div_guard`'s first
// exit): a nonzero literal is left exactly as the core wrote it, and a
// literal ZERO is refused where it is written -- `teko: division by zero`
// when the dividend is not constant (`a / 0`, `tests/refuse/divzero_literal.tk`),
// and mc's own compile-time folder (`fold_binary`, `src/parse.mc`, no
// `teko:` prefix, D2) when BOTH sides are constant, since `fold()` runs
// after every pass and answers `12 / 0` before codegen.
//
// THE DIVISOR AND (for the overflow check) THE DIVIDEND are each read AT
// MOST twice -- once by the guard, once by the division itself -- so an
// expression with a side effect (`a / next()`) is hoisted into a fresh local
// ahead of the guard, the initializer consumed exactly once; a bare name is
// safe to read twice as it stands and is never hoisted.
//
// `panic` IS PROGRAM CODE (`lib/rt.tk`), not something every unit carries, and
// the guard checks WHOSE it is, not merely that the name exists: SOME
// declaration of the name has to have been read from `lib/rt.tk` itself
// (`tk_div_rt_panic`: `nd_file` of the declaration node, `tk_div_ends`, over
// the whole unit -- not `decl_find`'s first hit alone). A program that
// declares its own `i64 panic(str)` and never includes the runtime is refused
// here rather than compiled into a guard that calls a no-op and lets the
// division run (`tests/refuse/divzero_own_panic.tk`); a program that declares
// one AND includes the runtime is mc's own `function declared twice`, ahead
// of this pass (measured). --
// measured: none of the compiler's OWN 84 divisions (`teko_*.tk`,
// `core_teko.mc`, `user.mc`, the very files `scripts/bootstrap.sh` compiles
// with itself for the fixed point) has a non-literal divisor, so this guard
// never actually fires while teko compiles its own source and `panic` never
// needs to be declared there. A PROGRAM that divides by something the folder
// cannot see through and never wrote `#include "rt.tk"` (directly or through
// `decimal.tk`/`time.tk`/...) is refused here instead, by name, rather than
// left to fail later with "call to unknown function: panic".
i64 tk_div_min(i64 ty) {
    i64 w = type_width(ty);
    return tk_int(0 - (1 << (w * 8 - 1)));
}

// a reference to `e` safe to read a SECOND time: a bare name is read again as
// it stands (the ORIGINAL node stays exactly where it was, in `n`'s own
// operand slot); anything else is hoisted into a temporary declared ahead of
// the statement, `e` itself becoming its initializer -- so it runs exactly
// once -- and `n`'s own operand slot (`isA`: `nd_a`, else `nd_b`) is
// rewritten to a fresh reference to the same temp, since the node just
// consumed can no longer sit in two places in the tree.
uptr tk_div_hoist(i64 e, i64 ty, uptr dst) {
    uptr t = gensym_new();
    tk_ty_scope_add(t, ty);
    st64(dst, list_append(ld64(dst), tk_var(ty, t, e)));
    return t;
}

// `panic("<msg>")`, fenced in its own block the way `tk_if`'s `then` already
// wants it
i64 tk_div_panic(uptr msg) {
    return tk_blk(list_append(0, tk_stmt(tk_call("panic", tk_str(msg)))));
}

// D2 draws the line at mc's own bundled core, and getting there right took
// TWO measured failures of the fixed point (`scripts/bootstrap.sh` compiles
// `mc_teko.tk`, which reaches `<mc/core_min>`), not one:
//
//   1. `src/arena.mc`'s own `buf_pad` divides by a PARAMETER (`buf_len(b) %
//      align`), reached through the compiler's OWN blob, and announced by
//      `lex_file()` under a bare canonical name (`mc/arena`, no directory,
//      no extension -- hooks.md's own "a normalised path... the canonical
//      bundled name... for a bundled one"). `tk_origin_of_file`
//      (teko_access.tk, the oracle `internal` reads) answers WRONG for
//      exactly this shape: with a bare (no-directory) entry and config, the
//      pair `scripts/bootstrap.sh` derives when it runs from the repository
//      root, its own fallback ("the project is the whole [current]
//      directory") calls `mc/arena` project code too, since it does not
//      start with `.`. The narrower question this file actually needs
//      already has an exact answer: `tk_fwd_is_source_name` (teko_fwd.tk) is
//      the SAME `.tk`-suffix filter `source_claim` uses to tell a real file
//      from a bundled canonical name -- none of the latter ends in `.tk` or
//      `.mc` -- `.mc` joins it here for `core_teko.mc`/`user.mc`, this
//      project's own two non-`.tk` files.
//
//   2. mc's own LIBRARY TREE, resolved onto disk rather than carried in the
//      blob (`lib/machine_arm64_float.mc`, reached the same way), announces
//      a REAL path, extension included -- `.mc`, same as this project's own
//      -- so the suffix filter alone answers 1 for it too. `tk_origin_of_file`
//      was tried here (its first line answers 0 for an absolute path), and
//      is WRONG on this leg too: a Windows CI runner's own resolved path
//      starts with a drive letter (`D:/a/teko-lang/...`), not `/`, so that
//      check never fires and this shape needs an oracle of its own. The
//      layout mc's own docs fix (`docs/reference/bundle.md`, "its standard
//      library in a tree... `lib/mc/v<version>/`") is stable across every OS
//      this project targets, so the substring `lib/mc/v` is checked
//      directly, portably, rather than trying a THIRD way to spell "absolute
//      path" (this project has no `[deps]` yet -- a locked package resolved
//      to some OTHER root would need its own line here, not needed today).
i64 tk_div_has(uptr hay, uptr needle) {
    i64 nl = cstrlen(needle);
    i64 i = 0;
    loop {
        i64 c = ld8(hay + i);
        if (c == 0) return 0;
        i64 j = 0;
        i64 hit = 1;
        loop {
            if (j >= nl) break;
            i64 h = ld8(hay + i + j);
            if (h == 0 || h != ld8(needle + j)) { hit = 0; break; }
            j = j + 1;
        }
        if (hit) return 1;
        i = i + 1;
    }
}

// does `f` END in `suf`? The one question below asks of a file name: is the
// `panic` this guard is about to call the RUNTIME's own (`lib/rt.tk`), the
// path `lex_file` normalises every include of it to -- measured: a fixture
// writing `#include "../lib/rt.tk"`, and `lib/decimal.tk` writing
// `#include "rt.tk"`, both announce the declaration under `lib/rt.tk`
// exactly. A suffix, not a substring, so a name only CONTAINING it does not
// pass, and not an equality, so a program reached from another root
// (`../teko/lib/rt.tk`) still names the same runtime.
i64 tk_div_ends(uptr f, uptr suf) {
    if (f == 0) return 0;
    i64 n = cstrlen(f);
    i64 m = cstrlen(suf);
    if (n < m) return 0;
    i64 i = 0;
    loop {
        if (i >= m) return 1;
        if (ld8(f + n - m + i) != ld8(suf + i)) return 0;
        i = i + 1;
    }
}

// is SOME declaration of `panic` the runtime's own? The whole unit is
// walked (`tk_div_root`, set by `tk_ternary_pass`) rather than asked through
// `decl_find`, which answers about the FIRST declaration of a name alone: a
// program that declares an unrelated overload such as `panic(i64)` ahead of
// its `#include "rt.tk"` still carries the runtime's `panic(str)`, and the
// generated call resolves to it like any other overload (teko_over.tk) --
// `tests/surface_divpanic_overload.tk`. The check is the FILE the
// declaration was read from (suffix `lib/rt.tk`), which is a ceiling and not
// a proof: an include root of the project's own holding a `vendor/lib/rt.tk`
// with a no-op `panic` passes it (D82 ruling 10).
i64 tk_div_root = 0;
i64 tk_div_rt_panic() {
    i64 n = tk_div_root;
    loop {
        if (n == 0) return 0;
        if (decl_valid(n) && str_eq(nd_name(n), "panic") && tk_div_ends(nd_file(n), "lib/rt.tk"))
            return 1;
        n = nd_next(n);
    }
}

i64 tk_div_project_file(uptr f) {
    if (f == 0) return 0;
    // `/mc/v` and not `lib/mc/v`: mc resolves its own tree from BESIDE the
    // compiler (`build/lib/mc/v<ver>/lib/...`) or from the package cache
    // (`$HOME/.mc/libs/mc/v<ver>/lib/...`, `libs` plural), and the narrower
    // substring missed the second -- measured: a populated cache made the
    // bootstrap refuse `machine_arm64_float.mc:616` (D82 ruling 10, amended).
    if (tk_div_has(f, "/mc/v")) return 0;
    if (tk_fwd_is_source_name(f)) return 1;
    i64 n = cstrlen(f);
    return n >= 3 && ld8(f + n - 3) == '.' && ld8(f + n - 2) == 'm' && ld8(f + n - 1) == 'c';
}

// both operands are one of teko's own plain integer ids (`tk_is_int_ty`'s
// positive list) -- never a nullable, an enum, a primitive or a struct
// operator row, every one of which claims the node in `tk_ops_binary`
// (teko_ops.tk) well ahead of the core's own `sdiv`/`idiv`, so guarding
// those here would guard a call that is never emitted.
i64 tk_div_applies(i64 n) {
    return tk_div_project_file(nd_file(n))
        && tk_is_int_ty(tk_ty_of(nd_a(n))) && tk_is_int_ty(tk_ty_of(nd_b(n)));
}

// the guard for ONE `N_BINARY` node already known to be `/` or `%` over two
// plain integers, its own operands already fully lowered by the caller.
void tk_div_guard(i64 n, uptr dst) {
    i64 a = nd_a(n);
    i64 b = nd_b(n);
    // A LITERAL divisor is never guarded, zero or nonzero (F3, measured):
    // `x / 2` is left exactly as the core wrote it, and a literal ZERO is
    // answered where it is WRITTEN rather than at run time -- C# refuses the
    // same line outright (CS0020, "Division by constant zero"), whatever the
    // dividend is. Guarding it instead was what hid mc's own compile-time
    // refusal behind a run-time panic.
    //
    // The one shape left to mc is the one mc already answers: BOTH sides
    // constant is `fold_binary`/`const_bin`'s own `division by zero` (no
    // `teko:` prefix, `mc/src/parse.mc`), measured unchanged on `8d95c1ff`
    // -- `fold()` runs after every `pass()`, so returning here hands it back.
    // Measured too: mc folds nothing when the DIVIDEND is not constant, so
    // `a / 0` was silence on aarch64 (exit 0) and SIGFPE on x86_64 -- the
    // very split D82 exists to close, and the reason this line refuses.
    if (nd_kind(b) == N_INT) {
        if (nd_val(b) == 0 && nd_kind(a) != N_INT)
            err_at(nd_file(n), nd_line(n), "teko: division by zero");
        return;
    }
    i64 ta = tk_ty_of(a);
    i64 tb = tk_ty_of(b);
    tk_line = nd_line(n);
    tk_file = nd_file(n);
    if (!tk_div_rt_panic())
        err_at(tk_file, tk_line, "teko: an integer division needs #include rt.tk");
    i64 sgn = type_signed(ta);
    // BOTH operands are hoisted, the dividend first, whatever the width's
    // sign: the divisor's initializer lands ahead of the division, so a
    // dividend with a side effect of its own (`left() / right()`) has to be
    // hoisted too or it would run AFTER the divisor, against left-to-right
    // evaluation. `an` is then read only by the signed overflow check.
    uptr an;
    if (nd_kind(a) == N_IDENT) an = nd_name(a);
    else { an = tk_div_hoist(a, ta, dst); set_nd_a(n, tk_id(an)); }
    uptr bn;
    if (nd_kind(b) == N_IDENT) bn = nd_name(b);
    else { bn = tk_div_hoist(b, tb, dst); set_nd_b(n, tk_id(bn)); }

    i64 zc = tk_bin(K_EQ, tk_id(bn), tk_int(0));
    st64(dst, list_append(ld64(dst), tk_if(zc, tk_div_panic("division by zero"))));
    if (sgn) {
        i64 c1 = tk_bin(K_EQ, tk_id(bn), tk_int(0 - 1));
        i64 c2 = tk_bin(K_EQ, tk_id(an), tk_div_min(ta));
        i64 cond = tk_bin(K_ANDAND, c1, c2);
        st64(dst, list_append(ld64(dst), tk_if(cond, tk_div_panic("an integer division overflowed"))));
    }
}

// ---- D82 amended: an `&&`/`||` whose LAZY operand divides ----
//
// `tk_div_guard` appends its check to the list the ENCLOSING STATEMENT is
// preceded by -- exactly right for a division that always runs, and exactly
// wrong for one the source wrote behind `&&`/`||`: `if (n != 0 && a / n > 1)`
// would check `n == 0` and panic ahead of the short-circuit the line was
// written to rely on. `?:`, `??` and `?.` never had that defect, for one
// reason: each is lowered into a REAL BRANCH before this walk ever reaches
// what is inside its arms, and every hoist an arm needs lands in that
// branch's own list (`tk_tern_lower`, `tk_nl_co_lower`).
//
// So `&&`/`||` is given the same treatment, with nothing new: an `&&`/`||`
// whose RIGHT operand carries a division that needs a guard is rewritten,
// ahead of the guard walk, into the branch form this file already builds --
//
//     x && y  ->  i64 t = 0; if (x) { <y's own hoists>; t = y != 0; } else { t = 0; }
//     x || y  ->  i64 t = 0; if (x) { t = 1; } else { <y's own hoists>; t = y != 0; }
//
// -- with `t` read in its place. The LEFT operand always runs, so its own
// guard keeps landing where it landed before, ahead of the whole statement.
//
// `tk_tern_lower` is NOT reused as it stands: it types the two arms and
// refuses a pair that disagrees, while the `true`/`false` this rewrite needs
// is the plain `TY_I64` truth value every comparison, `!`, `&&` and `||`
// already carries (teko_type.tk's own `tk_bool_lit`) -- so the temporary is
// `TY_I64` outright and no arm is typed at all.
//
// ONLY an `&&`/`||` that actually carries such a division is rewritten: every
// other program's `--dump-ast` is byte for byte what it was.

// a type that may still turn out to be one of teko's plain integers. An
// operand still holding a `?:`/`??`/`?.` placeholder has no type yet
// (`tk_ty_of` answers -1 for a call to a name nothing declares) and the
// question below is asked one step BEFORE this walk lowers it, so -1 counts
// in: at worst an `&&` whose right operand divides two DECIMALS reached
// through a ternary takes the branch form too, which moves that program's own
// dump and nothing about what it does.
i64 tk_div_lazy_ty(i64 t) { return t < 0 || tk_is_int_ty(t); }

// does `e` -- a whole lazy operand, at any depth -- carry a division
// `tk_div_guard` would build a check around? The same predicate the guard
// itself applies (`tk_div_applies`, plus its own literal-divisor exit), read
// one step early.
i64 tk_div_lazy_needs(i64 e) {
    loop {
        if (e == 0) return 0;
        if (nd_kind(e) == N_BINARY && (nd_op(e) == K_DIV || nd_op(e) == K_MOD)
            && nd_kind(nd_b(e)) != N_INT && tk_div_project_file(nd_file(e))
            && tk_div_lazy_ty(tk_ty_of(nd_a(e))) && tk_div_lazy_ty(tk_ty_of(nd_b(e))))
            return 1;
        if (tk_div_lazy_needs(nd_a(e))) return 1;
        if (tk_div_lazy_needs(nd_b(e))) return 1;
        if (tk_div_lazy_needs(nd_c(e))) return 1;
        if (tk_div_lazy_needs(nd_d(e))) return 1;
        e = nd_next(e);
    }
}

// `x && y` / `x || y` into the branch above, `n` itself becoming a reference
// to the temporary that branch writes.
void tk_div_lazy_lower(i64 n, uptr dst) {
    i64 andand = nd_op(n) == K_ANDAND;
    i64 x = nd_a(n);
    i64 y = nd_b(n);
    tk_tern_scan(x, dst);                  // the left runs either way
    i64 lazyOut = 0;
    tk_tern_scan(y, &lazyOut);             // the right, only where it is reached
    tk_tern_at(n);
    uptr t = gensym_new();
    tk_ty_scope_add(t, TY_I64);
    i64 shortv = 1;                        // what the left alone already decides
    if (andand) shortv = 0;
    // `&&`/`||` answer a NORMALIZED truth value, never the right operand
    // itself: `n != 0 && a / n` is 1, not the quotient (measured: the raw
    // assignment returned 3 for `7 / 2`).
    i64 taken = list_append(lazyOut, tk_tern_assign(t, tk_bin(K_NE, y, tk_int(0))));
    i64 other = list_append(0, tk_tern_assign(t, tk_int(shortv)));
    i64 thenOut = other;
    i64 elseOut = taken;
    if (andand) { thenOut = taken; elseOut = other; }
    i64 ifn = tk_if(x, tk_blk(thenOut));
    set_nd_c(ifn, tk_blk(elseOut));
    st64(dst, list_append(ld64(dst), tk_var(TY_I64, t, tk_int(0))));
    st64(dst, list_append(ld64(dst), ifn));
    tk_node_replace(n, tk_id(t));
}

void tk_tern_hoist_var(i64 n, uptr dst);
void tk_tern_stmt(i64 n, uptr pre);
i64  tk_tern_stmts(i64 head);
void tk_tern_branch(i64 n);

// lowers ONE `tk_ternary(c, a, b)` placeholder: `c` joins `*out` (the same
// list the ternary's own `if` joins -- it runs unconditionally, alongside the
// `if` it drives), and `a`/`b` are each reduced first, into their OWN branch,
// so a ternary nested in either stays lazy. The oracle then types the
// (already-reduced) arms -- a nested one has, by now, become a plain
// reference to ITS own temporary, already in scope (`tk_ty_scope_add`, right
// below) for exactly this reason.
void tk_tern_lower(i64 n, uptr dst) {
    i64 c = nd_a(n);
    i64 a = nd_next(c);
    i64 b = nd_next(a);
    set_nd_next(c, 0);
    set_nd_next(a, 0);
    set_nd_next(b, 0);
    tk_tern_scan(c, dst);

    i64 thenOut = 0;
    tk_tern_scan(a, &thenOut);
    i64 elseOut = 0;
    tk_tern_scan(b, &elseOut);

    i64 ty = tk_ty_of(a);
    tk_tern_at(n);
    if (ty < 0 || ty != tk_ty_of(b))
        err_at(tk_file, tk_line, "teko: the two arms of ?: have different types");

    uptr t = gensym_new();
    tk_ty_scope_add(t, ty);
    thenOut = list_append(thenOut, tk_tern_assign(t, a));
    elseOut = list_append(elseOut, tk_tern_assign(t, b));

    i64 ifn = tk_if(c, tk_blk(thenOut));
    set_nd_c(ifn, tk_blk(elseOut));

    st64(dst, list_append(ld64(dst), tk_var(ty, t, tk_tern_zero(ty))));
    st64(dst, list_append(ld64(dst), ifn));

    tk_node_replace(n, tk_id(t));
}

// walks one expression -- and its own sibling list, which is what an
// N_CALL's argument list already is -- for a `tk_ternary` placeholder
// anywhere inside it, lowering each one found into `*out`. Never asked to
// walk a statement list: a block never sits inside an expression's own
// children in this grammar, so no statement-position node is skipped by not
// special-casing one here.
void tk_tern_scan(i64 n, uptr dst) {
    loop {
        if (n == 0) break;
        if (nd_kind(n) == N_CALL && str_eq(nd_name(n), "tk_ternary")) {
            tk_tern_lower(n, dst);
        // Q2 (docs/specs/nullable.md § 5): `??` and `?.` are rewritten HERE,
        // at the moment this walk reaches the placeholder the parser left --
        // ahead of any lowering of the ternary itself and with the same `dst`
        // in hand, which is what hands both operators the hoisting, the
        // laziness and the fencing this file already has, for no pass of
        // their own (teko_null.tk owns the two rewrites).
        } else if (nd_kind(n) == N_CALL && str_eq(nd_name(n), "tk_coalesce")) {
            tk_nl_co_lower(n, dst);
        } else if (nd_kind(n) == N_CALL && str_eq(nd_name(n), "tk_qdot")) {
            tk_nl_qd_lower(n, dst);
        } else if (nd_kind(n) == N_VAR) {
            tk_tern_hoist_var(n, dst);
        // D82 amended: an `&&`/`||` whose RIGHT operand divides is lowered
        // into the branch form FIRST, so the guard the walk below builds
        // lands inside the branch instead of ahead of the whole statement
        // (`tk_div_lazy_lower`, right above `tk_tern_hoist_var`).
        } else if (nd_kind(n) == N_BINARY && (nd_op(n) == K_ANDAND || nd_op(n) == K_OROR)
                   && tk_div_lazy_needs(nd_b(n))) {
            tk_div_lazy_lower(n, dst);
        } else {
            tk_tern_scan(nd_a(n), dst);
            // D82 (the PR's fourth review): a guarded division's DIVIDEND is
            // hoisted right after its own lowering and BEFORE the divisor is
            // walked, so the divisor's own preludes -- a nested guarded
            // division's zero check, a ternary's branch -- land after it:
            // `left() / (x / y)` runs `left()` first, as C# does. The guard
            // below then finds a bare name on the left and reads it as it is.
            // A literal divisor never gets a guard (`tk_div_guard`'s first
            // exit), so nothing is hoisted ahead of one and those dumps stay.
            // The divisor is asked about BEFORE its own lowering, so a `?:`/
            // `??`/`?.` placeholder there still has no type (`tk_ty_of` is
            // -1) and counts as possibly-integer, the same reading
            // `tk_div_lazy_ty` gives an `&&`'s right side; the dividend, its
            // own walk just done, is typed for real. `tk_div_applies` below
            // still decides the guard itself once the divisor is lowered.
            if (nd_kind(n) == N_BINARY && (nd_op(n) == K_DIV || nd_op(n) == K_MOD)
                && nd_kind(nd_b(n)) != N_INT && nd_kind(nd_a(n)) != N_IDENT
                && tk_div_project_file(nd_file(n))
                && tk_is_int_ty(tk_ty_of(nd_a(n))) && tk_div_lazy_ty(tk_ty_of(nd_b(n)))) {
                i64 ta = tk_ty_of(nd_a(n));
                tk_line = nd_line(n);
                tk_file = nd_file(n);
                set_nd_a(n, tk_id(tk_div_hoist(nd_a(n), ta, dst)));
            }
            tk_tern_scan(nd_b(n), dst);
            tk_tern_scan(nd_c(n), dst);
            tk_tern_scan(nd_d(n), dst);
            // D82: a division's own operands are recursed into ABOVE, same as
            // any other composite node -- the guard itself is read only once
            // the children are already lowered (this file's own header, right
            // above `tk_div_min`, says why the order matters).
            if (nd_kind(n) == N_BINARY && (nd_op(n) == K_DIV || nd_op(n) == K_MOD) && tk_div_applies(n))
                tk_div_guard(n, dst);
        }
        n = nd_next(n);
    }
}

// a real `N_VAR` node another module (teko_switch.tk's own operand hoist,
// D222) embeds mid-expression as a placeholder: an `N_VAR` never legitimately
// sits inside an expression on its own, so finding one here always means a
// value has to be read exactly once before the ternary chain around it
// starts testing conditions. Hoisted into `*out` -- unconditionally, same as
// a ternary's own `c` -- and the node itself is overwritten in place by a
// bare read of the name it declares, `tk_tern_lower`'s own "build fresh,
// rewrite the original in place" shape.
void tk_tern_hoist_var(i64 n, uptr dst) {
    uptr nm = nd_name(n);
    i64 ty = nd_type(n);
    i64 init = nd_a(n);
    tk_tern_scan(init, dst);
    tk_ty_scope_add(nm, ty);
    tk_tern_at(n);
    st64(dst, list_append(ld64(dst), tk_var(ty, nm, init)));
    tk_node_replace(n, tk_id(nm));
}

// the single statement an `if`/`loop` may carry instead of a block: fenced
// into a block of its own, and only when it really held a ternary --
// teko_rc.tk's `tk_rc_branch` fences a parked temporary the same way
void tk_tern_branch(i64 n) {
    if (n == 0) return;
    if (nd_kind(n) == N_BLOCK) {
        tk_tern_stmt(n, 0);
        return;
    }
    i64 pre = 0;
    tk_tern_stmt(n, &pre);
    if (pre == 0) return;
    i64 body = tk_tern_detach(n);
    tk_tern_at(n);
    tk_node_replace(n, tk_blk(list_append(pre, body)));
}

// one statement: `pre` is the enclosing block's own accumulator, and every
// arm of every control-flow node below feeds either `pre` (a condition, which
// always runs) or a branch of its own (teko_rc.tk's `tk_rc_stmt` is the same
// shape, one arm per node kind it rewrites)
void tk_tern_stmt(i64 n, uptr pre) {
    if (n == 0) return;
    i64 k = nd_kind(n);
    if (k == N_BLOCK) {
        i64 mark = tk_nscope;
        set_nd_a(n, tk_tern_stmts(nd_a(n)));
        tk_nscope = mark;
        return;
    }
    if (k == N_LOOP) { tk_tern_branch(nd_a(n)); return; }
    if (k == N_IF) {
        tk_tern_scan(nd_a(n), pre);
        tk_tern_branch(nd_b(n));
        tk_tern_branch(nd_c(n));
        return;
    }
    if (k == N_RETURN)   { tk_tern_scan(nd_a(n), pre); return; }
    if (k == N_VAR)      { tk_tern_scan(nd_a(n), pre); tk_ty_scope_var(n); return; }
    if (k == N_ASSIGN)   { tk_tern_scan(nd_a(n), pre); return; }
    if (k == N_EXPRSTMT) { tk_tern_scan(nd_a(n), pre); return; }
    if (k == N_BREAK)    return;
    if (k == N_CONTINUE) return;
    tk_tern_scan(n, pre);
}

// the statements of one block, rebuilt in order: a statement whose own
// expression held a ternary comes back preceded by the local it hoisted
i64 tk_tern_stmts(i64 head) {
    i64 dst = 0;
    i64 n = head;
    loop {
        if (n == 0) break;
        i64 nx = nd_next(n);
        set_nd_next(n, 0);
        i64 pre = 0;
        tk_tern_stmt(n, &pre);
        if (pre != 0) dst = list_append(dst, pre);
        dst = list_append(dst, n);
        n = nx;
    }
    return dst;
}

void tk_tern_fn(i64 f) {
    tk_nscope = 0;
    tk_ty_scope_params(nd_a(f));
    tk_tern_stmt(nd_b(f), 0);
    tk_nscope = 0;
}

// D82's own reason this walk is no longer conditional on `tk_ntern`/
// `tk_nl_nops`: `/` and `%` are core grammar, parsed with no hook of their
// own (unlike `?`/`??`/`?.`, each a `syntax_infix` placeholder this file's
// own parser hands counts), so there is no cheap counter to ask instead of
// looking -- and a unit that skips the walk skips the guard along with it.
// A unit that writes none of `?`, `??`, `?.` and no division that needs a
// guard still costs one pass over its own functions, the same a program
// with no `if` still pays teko_rc.tk (whose own walk never had a fast exit
// to begin with) -- division is common enough (the compiler's own source
// included) that the old fast exit bought little a plain program would
// notice.
i64 tk_ternary_pass(i64 root) {
    tk_div_root = root;
    i64 f = root;
    loop {
        if (f == 0) break;
        if (nd_kind(f) == N_FUNC) tk_tern_fn(f);
        f = nd_next(f);
    }
    return root;
}
