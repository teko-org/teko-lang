// time.tk -- the surface code every `TimeSpan` member and operator lowers to
// (docs/specs/datetime.md, crumb C1). Program code, not compiler code:
// `#include "time.tk"` from the `.tk` source, exactly like `rt.tk`, which this
// file includes for `panic`.
//
// EVERY FUNCTION HERE IS WRITTEN OVER THE RAW TICKS, an ordinary `i64`. The
// compiler writes `(i64) t` on the way in and `(TimeSpan) r` on the way out
// (teko_prim.tk § "the two casts"), so no FUNCTION in this file names
// `TimeSpan` or `DateTime`, none needs an operator of its own, and there is no
// recursion between a lowered `a - b` and the function it lowers to. The one
// thing this file does declare by name is `DateTimeKind` (N2c, the `public
// enum` below): it is an ordinary library type, not a compiler registration,
// and the functions that carry a kind still take and answer the raw `i64` --
// `tk_dt_from_ticks_kind(i64, i64)`, `tk_dt_kind(i64)` -- with the enum's two
// casts written by the compiler at the site, exactly like the ticks.
//
// A tick is 100 nanoseconds and a `TimeSpan` is a signed 64-bit count of them,
// C#'s own representation: the whole range is about ±10675199 days.
//
// OVERFLOW PANICS. C# raises `OverflowException` on every one of these, and a
// teko program has no exceptions, so the answer is `panic` -- the arena's own
// `rt_panic`, exit 70, the same road an index past the end of an array takes
// (docs/reference/memory.md). Wrapping silently is the one thing that is not on
// the table: the core's raw `+` over two tick counts is exactly what the
// operator table exists to keep off the machine.
#include "rt.tk"

const i64 TICKS_PER_MILLISECOND = 10000;
const i64 TICKS_PER_SECOND      = 10000000;
const i64 TICKS_PER_MINUTE      = 600000000;
const i64 TICKS_PER_HOUR        = 36000000000;
const i64 TICKS_PER_DAY         = 864000000000;

// the two ends of the range, spelled the way an i64 can hold them
const i64 TIMESPAN_MAX_TICKS = 9223372036854775807;
const i64 TIMESPAN_MIN_TICKS = 0 - 9223372036854775807 - 1;

// ---- the constants the table reads as static members ----
i64 tk_ts_zero() { return 0; }
i64 tk_ts_min()  { return TIMESPAN_MIN_TICKS; }
i64 tk_ts_max()  { return TIMESPAN_MAX_TICKS; }

i64 tk_ts_per_day()    { return TICKS_PER_DAY; }
i64 tk_ts_per_hour()   { return TICKS_PER_HOUR; }
i64 tk_ts_per_minute() { return TICKS_PER_MINUTE; }
i64 tk_ts_per_second() { return TICKS_PER_SECOND; }
i64 tk_ts_per_ms()     { return TICKS_PER_MILLISECOND; }

// ---- the builders ----
// C#'s `TimeSpan.From*(double)`: the value is scaled to ticks in double and
// truncated toward zero, which is what `(i64)` lowers to (`fcvtzs`/`cvttsd2si`).
// .NET 7 dropped the older rounding to the nearest millisecond, and this is the
// modern behaviour, so `FromSeconds(0.0000001)` is one tick and not zero.
//
// The range test is also the NaN test, and deliberately so: `>=` and `<=` are
// both FALSE for a NaN operand on either backend (an unordered compare clears
// the flags both conditions read), so the negation below is what a NaN reaches.
// Writing `t != t` instead would answer differently on the two machines.
i64 tk_ts_scaled(f64 value, f64 scale) {
    f64 t = value * scale;
    if (!(t >= 0.0 - 9223372036854775808.0 && t <= 9223372036854774784.0))
        panic("a time span is out of range");
    return (i64) t;
}

i64 tk_ts_from_days(f64 v)    { return tk_ts_scaled(v, 864000000000.0); }
i64 tk_ts_from_hours(f64 v)   { return tk_ts_scaled(v, 36000000000.0); }
i64 tk_ts_from_minutes(f64 v) { return tk_ts_scaled(v, 600000000.0); }
i64 tk_ts_from_seconds(f64 v) { return tk_ts_scaled(v, 10000000.0); }
i64 tk_ts_from_ms(f64 v)      { return tk_ts_scaled(v, 10000.0); }
i64 tk_ts_from_ticks(i64 t)   { return t; }

// ---- the components, C#'s own ----
// `.Hours` is the hour OF the span, 0..23, and `.TotalHours` below is the whole
// span as an f64. A negative span answers negative components, as C# does: the
// core's `/` and `%` on an `i64` truncate toward zero.
i64 tk_ts_days(i64 t)    { return t / TICKS_PER_DAY; }
i64 tk_ts_hours(i64 t)   { return (t / TICKS_PER_HOUR) % 24; }
i64 tk_ts_minutes(i64 t) { return (t / TICKS_PER_MINUTE) % 60; }
i64 tk_ts_seconds(i64 t) { return (t / TICKS_PER_SECOND) % 60; }
i64 tk_ts_ms(i64 t)      { return (t / TICKS_PER_MILLISECOND) % 1000; }

f64 tk_ts_total_days(i64 t)    { f64 x = t; return x / 864000000000.0; }
f64 tk_ts_total_hours(i64 t)   { f64 x = t; return x / 36000000000.0; }
f64 tk_ts_total_minutes(i64 t) { f64 x = t; return x / 600000000.0; }
f64 tk_ts_total_seconds(i64 t) { f64 x = t; return x / 10000000.0; }
f64 tk_ts_total_ms(i64 t)      { f64 x = t; return x / 10000.0; }

// ---- the arithmetic ----
// The overflow test is the sign one C has always used: an addition overflowed
// when both operands share a sign the result does not.
i64 tk_ts_add(i64 a, i64 b) {
    i64 r = a + b;
    if (((a ^ r) & (b ^ r)) < 0) panic("a time span overflowed");
    return r;
}

i64 tk_ts_sub(i64 a, i64 b) {
    i64 r = a - b;
    if (((a ^ b) & (a ^ r)) < 0) panic("a time span overflowed");
    return r;
}

i64 tk_ts_neg(i64 a) {
    if (a == TIMESPAN_MIN_TICKS) panic("a time span overflowed");
    return 0 - a;
}

i64 tk_ts_duration(i64 a) {
    if (a == TIMESPAN_MIN_TICKS) panic("a time span overflowed");
    if (a < 0) return 0 - a;
    return a;
}

// `-1` is taken out of the way BEFORE the division that checks the product:
// `MIN / -1` is the one signed division that overflows, and on x86_64 it traps
// in hardware rather than answering.
i64 tk_ts_mul(i64 a, i64 n) {
    if (a == 0 || n == 0) return 0;
    if (n == 0 - 1) return tk_ts_neg(a);
    i64 r = a * n;
    if (r / n != a) panic("a time span overflowed");
    return r;
}

i64 tk_ts_div(i64 a, i64 n) {
    if (n == 0) panic("a time span divided by zero");
    if (n == 0 - 1) return tk_ts_neg(a);
    return a / n;
}

// ---- the comparisons ----
// Each answers 0 or 1, the shape every teko condition already has. They are
// calls and not the core's own `cmp` because the table is one mechanism: the
// same rows carry `DateTime`, whose `Kind` bits sit above its ticks and whose
// comparison therefore cannot be a bare compare (docs/specs/datetime.md § 4).
i64 tk_ts_eq(i64 a, i64 b) { return a == b; }
i64 tk_ts_ne(i64 a, i64 b) { return a != b; }
i64 tk_ts_lt(i64 a, i64 b) { return a < b; }
i64 tk_ts_le(i64 a, i64 b) { return a <= b; }
i64 tk_ts_gt(i64 a, i64 b) { return a > b; }
i64 tk_ts_ge(i64 a, i64 b) { return a >= b; }

// C#'s own `CompareTo`: -1, 0 or 1.
i64 tk_ts_cmp(i64 a, i64 b) {
    if (a < b) return 0 - 1;
    if (a > b) return 1;
    return 0;
}

// ============================================================================
// `DateTime` (docs/specs/datetime.md, crumb C2)
// ============================================================================
//
// The eight bytes are C#'s own `dateData`: the ticks since `0001-01-01
// 00:00:00` in bits 0..61, and the `Kind` in bits 62 and 63. The maximum tick
// value, `9999-12-31 23:59:59.9999999`, is 3155378975999999999 and needs 62
// bits, which is what leaves the two above it free.
//
// THE RAW VALUE IS NOT THE TICK COUNT, and every function below starts by
// masking: a `Local` date has bit 63 set and is a NEGATIVE `i64`, so raw
// arithmetic and a raw comparison over it are both wrong. That is the whole
// reason `.Ticks` is a call here where `TimeSpan.Ticks` is the identity, and
// the reason a hand-written `(i64) dt` is refused (teko_prim.tk).
//
// The calendar is the proleptic Gregorian one C# uses, computed the way C#
// computes it: a days-to-year walk over the 400/100/4 cycles and a cumulative
// month table. Every date this file builds is checked -- a year outside
// 1..9999, a month outside 1..12, a day past the end of ITS month, a tick
// count outside the range -- and a date that does not exist panics where it is
// built, exit 70, the same road `lib/rt.tk`'s own `rt_panic` takes for an
// index past the end of an array.

const i64 DATETIME_MAX_TICKS = 3155378975999999999;
const i64 UNIX_EPOCH_TICKS   = 621355968000000000;

// bits 0..61: the ticks. Bits 62..63 are the `Kind`.
const i64 DATETIME_TICK_MASK = 4611686018427387903;

const i64 DAYS_PER_YEAR      = 365;          // a non-leap year
const i64 DAYS_PER_4_YEARS   = 1461;         // 365 * 4 + 1
const i64 DAYS_PER_100_YEARS = 36524;        // 1461 * 25 - 1
const i64 DAYS_PER_400_YEARS = 146097;       // 36524 * 4 + 1

// which component `tk_dt_part` is asked for
const i64 DT_YEAR  = 0;
const i64 DT_MONTH = 1;
const i64 DT_DAY   = 2;
const i64 DT_DOY   = 3;

// ---- the two halves of the eight bytes ----
i64 tk_dt_ticks(i64 d) { return d & DATETIME_TICK_MASK; }

// the `Kind` as a number, for this file's own use; the member `.Kind` answers
// the same value under `DateTimeKind`, whose underlying type is `i32`
i64 tk_dt_kind_of(i64 d) { return (d >> 62) & 3; }

i32 tk_dt_kind(i64 d) { return (i32) tk_dt_kind_of(d); }

// C#'s own three, and C#'s own values -- the two bits `tk_dt_pack` writes
// above the ticks. This is an ORDINARY declaration in an ordinary library
// file: the compiler registers nothing for the name (teko_time.tk's own
// § "`DateTimeKind` is not registered here at all"), the `enum` word does it
// when this file is included, and every row that names the type reads its id
// at the site. So `d.Kind` is a `DateTimeKind` and nothing else converts into
// one: `new DateTime(t, 7)` is refused where an `i32` alias took any integer,
// and `(DateTimeKind) 7` -- an explicit cast, which C# allows over any enum --
// still reaches `tk_dt_from_ticks_kind`'s own range check below.
public enum DateTimeKind : i32 { Unspecified = 0, Utc = 1, Local = 2 }

// ...and the way back: a tick count and a `Kind` in one value. The range is
// checked here, so no path in this file can build a date the surface could not
// have written.
i64 tk_dt_pack(i64 ticks, i64 kind) {
    if (ticks < 0 || ticks > DATETIME_MAX_TICKS) panic("a date is out of range");
    return ticks | (kind << 62);
}

// ---- the calendar ----
// The days of the year BEFORE month `m` (1..13), which is C#'s own cumulative
// table read as a function: the twelve lengths are 31, 28/29, 31, 30, 31, 30,
// 31, 31, 30, 31, 30, 31, and `m` 13 answers the length of the whole year.
i64 tk_dt_days_before(i64 m, i64 leap) {
    i64 b = 0;
    if (m == 2)  b = 31;
    if (m == 3)  b = 59;
    if (m == 4)  b = 90;
    if (m == 5)  b = 120;
    if (m == 6)  b = 151;
    if (m == 7)  b = 181;
    if (m == 8)  b = 212;
    if (m == 9)  b = 243;
    if (m == 10) b = 273;
    if (m == 11) b = 304;
    if (m == 12) b = 334;
    if (m == 13) b = 365;
    if (leap && m >= 3) b = b + 1;
    return b;
}

// C#'s `DateTime.IsLeapYear`, refusal included: a year outside 1..9999 is not
// a year this calendar has.
i64 tk_dt_is_leap(i64 y) {
    if (y < 1 || y > 9999) panic("a year is out of range");
    if (y % 4 != 0) return 0;
    if (y % 100 != 0) return 1;
    return y % 400 == 0;
}

i64 tk_dt_days_in_month(i64 y, i64 m) {
    i64 leap = tk_dt_is_leap(y);                 // ...which checks the year
    if (m < 1 || m > 12) panic("a month is out of range");
    return tk_dt_days_before(m + 1, leap) - tk_dt_days_before(m, leap);
}

// the days since 0001-01-01 of a civil date, C#'s own `DateToTicks` without
// the multiply. Every field is checked: this is where `new DateTime(2023, 2,
// 29)` panics.
i64 tk_dt_days_from_ymd(i64 y, i64 m, i64 d) {
    i64 leap = tk_dt_is_leap(y);                 // ...which checks the year
    if (m < 1 || m > 12) panic("a month is out of range");
    if (d < 1 || d > tk_dt_days_before(m + 1, leap) - tk_dt_days_before(m, leap))
        panic("a date does not exist");
    i64 py = y - 1;
    return py * DAYS_PER_YEAR + py / 4 - py / 100 + py / 400
         + tk_dt_days_before(m, leap) + d - 1;
}

// the ticks of a time of day, C#'s own `TimeToTicks`
i64 tk_dt_time_ticks(i64 h, i64 mi, i64 s, i64 ms) {
    if (h < 0 || h > 23) panic("an hour is out of range");
    if (mi < 0 || mi > 59) panic("a minute is out of range");
    if (s < 0 || s > 59) panic("a second is out of range");
    if (ms < 0 || ms > 999) panic("a millisecond is out of range");
    return ((h * 3600 + mi * 60 + s) * 1000 + ms) * TICKS_PER_MILLISECOND;
}

// ---- the components ----
// One walk answers all four, exactly as C#'s own `GetDatePart` does: the 400,
// 100 and 4-year cycles are subtracted in turn, the two `== 4` corrections are
// the last day of a leap cycle (31 December of year 400, 800, ...), and what
// is left is the day OF the year.
i64 tk_dt_part(i64 dd, i64 part) {
    i64 n = tk_dt_ticks(dd) / TICKS_PER_DAY;
    i64 y400 = n / DAYS_PER_400_YEARS;
    n = n - y400 * DAYS_PER_400_YEARS;
    i64 y100 = n / DAYS_PER_100_YEARS;
    if (y100 == 4) y100 = 3;                     // the last day of a 400-year cycle
    n = n - y100 * DAYS_PER_100_YEARS;
    i64 y4 = n / DAYS_PER_4_YEARS;
    n = n - y4 * DAYS_PER_4_YEARS;
    i64 y1 = n / DAYS_PER_YEAR;
    if (y1 == 4) y1 = 3;                         // ...and of a 4-year one
    if (part == DT_YEAR) return y400 * 400 + y100 * 100 + y4 * 4 + y1 + 1;
    n = n - y1 * DAYS_PER_YEAR;
    if (part == DT_DOY) return n + 1;
    i64 leap = 0;
    if (y1 == 3 && (y4 != 24 || y100 == 3)) leap = 1;
    i64 m = 1;
    while (m < 12 && n >= tk_dt_days_before(m + 1, leap)) m = m + 1;
    if (part == DT_MONTH) return m;
    return n - tk_dt_days_before(m, leap) + 1;
}

i64 tk_dt_year(i64 d)  { return tk_dt_part(d, DT_YEAR); }
i64 tk_dt_month(i64 d) { return tk_dt_part(d, DT_MONTH); }
i64 tk_dt_day(i64 d)   { return tk_dt_part(d, DT_DAY); }
i64 tk_dt_doy(i64 d)   { return tk_dt_part(d, DT_DOY); }

i64 tk_dt_hour(i64 d)   { return (tk_dt_ticks(d) / TICKS_PER_HOUR) % 24; }
i64 tk_dt_minute(i64 d) { return (tk_dt_ticks(d) / TICKS_PER_MINUTE) % 60; }
i64 tk_dt_second(i64 d) { return (tk_dt_ticks(d) / TICKS_PER_SECOND) % 60; }
i64 tk_dt_ms(i64 d)     { return (tk_dt_ticks(d) / TICKS_PER_MILLISECOND) % 1000; }

// C#'s `DayOfWeek`: 0 is Sunday, and 0001-01-01 was a Monday.
i64 tk_dt_dow(i64 d) { return (tk_dt_ticks(d) / TICKS_PER_DAY + 1) % 7; }

// the date at midnight, `Kind` kept -- and the time since it, a `TimeSpan`
i64 tk_dt_date(i64 d) {
    i64 t = tk_dt_ticks(d);
    return tk_dt_pack(t - t % TICKS_PER_DAY, tk_dt_kind_of(d));
}

i64 tk_dt_tod(i64 d) { return tk_dt_ticks(d) % TICKS_PER_DAY; }

// ---- the statics ----
i64 tk_dt_min() { return 0; }
i64 tk_dt_max() { return DATETIME_MAX_TICKS; }

// C# declares it `new DateTime(621355968000000000, DateTimeKind.Utc)`, so the
// two top bits carry `Utc` -- and `.Ticks` still answers the constant, because
// it masks them off.
i64 tk_dt_epoch() { return tk_dt_pack(UNIX_EPOCH_TICKS, 1); }

// ---- `Now`, `UtcNow`, `Today` (crumb C6, D90) ----
// `<teko/clock.tk>` answers `tk_dt_raw_utc_ticks()`, the one function that
// differs by host (`teko_time.tk`'s own "the wall clock" section); everything
// below it is ordinary, host-blind arithmetic over the tick count it reads.
// THE `.tk` SUFFIX IS LOAD-BEARING: `tk_source_claim` (`teko_fwd.tk`) scopes
// every teko-taught word -- `const` among them -- to sources whose NAME ends
// `.tk`; a bundle name with no such suffix is read with the CORE's own
// vocabulary, where `const` is an ordinary identifier and not a keyword,
// which is exactly what the file this crumb's bundle text used to answer
// without the suffix could not compile (`teko: type expected at top level`,
// measured, not assumed -- `const i64 FILETIME_EPOCH_DIFF_TICKS = ...` is
// the one line in `tk_clock_windows_src()` that needs it claimed).
#include <teko/clock.tk>

i64 tk_dt_now_utc() { return tk_dt_pack(tk_dt_raw_utc_ticks(), 1); }

// D90: `Now` carries `DateTimeKind.Local`, C#'s own spelling, but its VALUE
// is the same clock read `UtcNow` answers -- teko has no time-zone database
// (§ 8), so there is no host offset to apply, and faking one would be a wrong
// answer dressed as a right one. The divergence from C# is stated here and in
// docs/reference/not-yet.md, not hidden behind an honest-looking `Kind`.
i64 tk_dt_now_local() { return tk_dt_pack(tk_dt_raw_utc_ticks(), 2); }

// `Today`: `Now` truncated to midnight, the same `Kind` -- `tk_dt_date`
// already does exactly that mask-and-keep.
i64 tk_dt_today() { return tk_dt_date(tk_dt_now_local()); }

// ---- the constructors ----
i64 tk_dt_from_ticks(i64 t) { return tk_dt_pack(t, 0); }

i64 tk_dt_from_ticks_kind(i64 t, i64 k) {
    if (k < 0 || k > 2) panic("a date kind is out of range");
    return tk_dt_pack(t, k);
}

i64 tk_dt_ymd(i64 y, i64 m, i64 d) {
    return tk_dt_pack(tk_dt_days_from_ymd(y, m, d) * TICKS_PER_DAY, 0);
}

i64 tk_dt_ymdhms(i64 y, i64 m, i64 d, i64 h, i64 mi, i64 s) {
    return tk_dt_pack(tk_dt_days_from_ymd(y, m, d) * TICKS_PER_DAY
                      + tk_dt_time_ticks(h, mi, s, 0), 0);
}

i64 tk_dt_ymdhmsms(i64 y, i64 m, i64 d, i64 h, i64 mi, i64 s, i64 ms) {
    return tk_dt_pack(tk_dt_days_from_ymd(y, m, d) * TICKS_PER_DAY
                      + tk_dt_time_ticks(h, mi, s, ms), 0);
}

// ---- the arithmetic ----
// Every one of these keeps the `Kind` of the date it started from, which is
// C#'s rule, and panics where C# raises: the sum is checked as an `i64` first
// (the sign test `tk_ts_add` uses) and then against the range of a date.
i64 tk_dt_add_ticks(i64 d, i64 t) {
    i64 a = tk_dt_ticks(d);
    i64 r = a + t;
    if (((a ^ r) & (t ^ r)) < 0) panic("a date is out of range");
    return tk_dt_pack(r, tk_dt_kind_of(d));
}

// C#'s own `DateTime.Add(double value, int scale)`: the value is scaled to
// MILLISECONDS, rounded to the nearest one (away from zero) and only then
// turned into ticks. That rounding is C#'s and is why
// `d.AddSeconds(0.0000001)` is `d` -- unlike `TimeSpan.FromSeconds`, which
// .NET 7 changed to full precision (D40).
//
// The range test is also the NaN test: `>` and `<` are both false for an
// unordered compare on both backends, so a NaN reaches the panic. The bound
// is C#'s own `MaxMillis`, the whole range of a date in milliseconds.
i64 tk_dt_scaled(i64 d, f64 value, f64 scale) {
    f64 millis = value * scale;
    if (value >= 0.0) millis = millis + 0.5;
    else              millis = millis - 0.5;
    if (!(millis > 0.0 - 315537897600000.0 && millis < 315537897600000.0))
        panic("a date is out of range");
    return tk_dt_add_ticks(d, ((i64) millis) * TICKS_PER_MILLISECOND);
}

i64 tk_dt_add_days(i64 d, f64 v)    { return tk_dt_scaled(d, v, 86400000.0); }
i64 tk_dt_add_hours(i64 d, f64 v)   { return tk_dt_scaled(d, v, 3600000.0); }
i64 tk_dt_add_minutes(i64 d, f64 v) { return tk_dt_scaled(d, v, 60000.0); }
i64 tk_dt_add_seconds(i64 d, f64 v) { return tk_dt_scaled(d, v, 1000.0); }
i64 tk_dt_add_ms(i64 d, f64 v)      { return tk_dt_scaled(d, v, 1.0); }

// C#'s `AddMonths`, clamping included: the day is cut to the length of the
// TARGET month, so `2024-01-31` plus one month is `2024-02-29` and not a date
// that does not exist. The bounds are C#'s own, plus or minus 120000 months.
i64 tk_dt_add_months(i64 d, i64 months) {
    if (months < 0 - 120000 || months > 120000) panic("a month count is out of range");
    i64 y = tk_dt_year(d);
    i64 m = tk_dt_month(d);
    i64 day = tk_dt_day(d);
    i64 i = m - 1 + months;
    if (i >= 0) {
        m = i % 12 + 1;
        y = y + i / 12;
    } else {
        m = 12 + (i + 1) % 12;
        y = y + (i - 11) / 12;
    }
    if (y < 1 || y > 9999) panic("a date is out of range");
    i64 last = tk_dt_days_in_month(y, m);
    if (day > last) day = last;
    return tk_dt_pack(tk_dt_days_from_ymd(y, m, day) * TICKS_PER_DAY
                      + tk_dt_ticks(d) % TICKS_PER_DAY, tk_dt_kind_of(d));
}

// C#'s `AddYears` IS `AddMonths(years * 12)`, which is what makes
// `2000-02-29` plus one year `2001-02-28`.
i64 tk_dt_add_years(i64 d, i64 years) {
    if (years < 0 - 10000 || years > 10000) panic("a year count is out of range");
    return tk_dt_add_months(d, years * 12);
}

// ---- the operators ----
// `d + t` and `t + d` are one function (the row's swap flag), `d - t` its
// mirror, and `d - d` the one that answers a `TimeSpan` -- raw ticks out, as
// every `lib/time.tk` function answers.
i64 tk_dt_add(i64 d, i64 t)    { return tk_dt_add_ticks(d, t); }
i64 tk_dt_sub_ts(i64 d, i64 t) { return tk_dt_add_ticks(d, tk_ts_neg(t)); }

i64 tk_dt_sub(i64 a, i64 b) { return tk_ts_sub(tk_dt_ticks(a), tk_dt_ticks(b)); }

// ---- the comparisons ----
// C#'s own `Compare`: the TICKS, with the `Kind` masked off. Two dates of
// different `Kind` compare by their ticks and do not convert, which C# says is
// the program's business and not the type's.
i64 tk_dt_eq(i64 a, i64 b) { return tk_dt_ticks(a) == tk_dt_ticks(b); }
i64 tk_dt_ne(i64 a, i64 b) { return tk_dt_ticks(a) != tk_dt_ticks(b); }
i64 tk_dt_lt(i64 a, i64 b) { return tk_dt_ticks(a) <  tk_dt_ticks(b); }
i64 tk_dt_le(i64 a, i64 b) { return tk_dt_ticks(a) <= tk_dt_ticks(b); }
i64 tk_dt_gt(i64 a, i64 b) { return tk_dt_ticks(a) >  tk_dt_ticks(b); }
i64 tk_dt_ge(i64 a, i64 b) { return tk_dt_ticks(a) >= tk_dt_ticks(b); }

i64 tk_dt_cmp(i64 a, i64 b) { return tk_ts_cmp(tk_dt_ticks(a), tk_dt_ticks(b)); }

// ============================================================================
// `DateOnly` (docs/specs/datetime-extras.md, crumb N4a)
// ============================================================================
//
// FOUR bytes, and the value IS the day number: the count of days since
// `0001-01-01`, C#'s own `int` representation. Nothing is packed above it --
// there is no `Kind` on a `DateOnly` -- so the raw four bytes ARE `.DayNumber`
// and that member is the identity row, the way `TimeSpan.Ticks` is.
//
// Every function below still takes and answers an ordinary `i64`, like the
// rest of this file: the compiler writes `(i64) d` on the way in, which is a
// sign extension of the four bytes, and `(DateOnly) r` on the way out, which
// is a narrowing store (teko_prim.tk § "the two casts"). A day number is
// non-negative and needs 22 bits, so neither cast can lose one.
//
// THE CALENDAR IS NOT REWRITTEN HERE. Every component, every clamp and every
// range check is the `DateTime` half above, reached by multiplying the day
// number back into ticks -- which is exactly what a date at midnight is.

// `DateOnly.MaxValue`, `9999-12-31`: DATETIME_MAX_TICKS / TICKS_PER_DAY
const i64 DATEONLY_MAX_DAYNUM = 3652058;

i64 tk_do_min() { return 0; }
i64 tk_do_max() { return DATEONLY_MAX_DAYNUM; }

// the three ways to build one. `tk_dt_days_from_ymd` is where
// `new DateOnly(2024, 2, 30)` panics, and it is the same check
// `new DateTime(2024, 2, 30)` takes.
i64 tk_do_ymd(i64 y, i64 m, i64 d) { return tk_dt_days_from_ymd(y, m, d); }

i64 tk_do_from_daynum(i64 n) {
    if (n < 0 || n > DATEONLY_MAX_DAYNUM) panic("a date is out of range");
    return n;
}

// C#'s `DateOnly.FromDateTime`: the date half of the value, the time of day
// dropped and the `Kind` with it.
i64 tk_do_from_datetime(i64 d) { return tk_dt_ticks(d) / TICKS_PER_DAY; }

// ---- the components ----
// The day number back into the ticks of that midnight, which is the shape
// `tk_dt_part` reads. No `Kind` is packed, so no mask is needed on the way in.
i64 tk_do_year(i64 n)  { return tk_dt_part(n * TICKS_PER_DAY, DT_YEAR); }
i64 tk_do_month(i64 n) { return tk_dt_part(n * TICKS_PER_DAY, DT_MONTH); }
i64 tk_do_day(i64 n)   { return tk_dt_part(n * TICKS_PER_DAY, DT_DAY); }
i64 tk_do_doy(i64 n)   { return tk_dt_part(n * TICKS_PER_DAY, DT_DOY); }

// `tk_dt_dow` without the multiply and the mask: 0 is Sunday, and
// `0001-01-01` was a Monday.
i64 tk_do_dow(i64 n) { return (n + 1) % 7; }

// ---- the arithmetic ----
// C# raises `ArgumentOutOfRangeException` where the answer is not a date, so
// each of these panics; the sign test is `tk_ts_add`'s, because `n + days` on
// an `i64` wraps before the range check could see it.
i64 tk_do_add_days(i64 n, i64 days) {
    i64 r = n + days;
    if (((n ^ r) & (days ^ r)) < 0) panic("a date is out of range");
    return tk_do_from_daynum(r);
}

// ...and the two that need the calendar: `tk_dt_add_months` carries C#'s own
// clamp to the length of the target month, so `2024-01-31` plus one month is
// `2024-02-29` here for the same reason it is there.
i64 tk_do_add_months(i64 n, i64 months) {
    return tk_dt_ticks(tk_dt_add_months(n * TICKS_PER_DAY, months)) / TICKS_PER_DAY;
}

i64 tk_do_add_years(i64 n, i64 years) {
    return tk_dt_ticks(tk_dt_add_years(n * TICKS_PER_DAY, years)) / TICKS_PER_DAY;
}

// ---- the comparisons ----
// There are none of its own: a day number is an ordinary non-negative `i64`,
// so `d < e` IS `tk_ts_lt` over the two numbers and `.CompareTo` IS
// `tk_ts_cmp`. The rows in teko_time.tk name those six functions directly
// rather than six wrappers that would forward and nothing else (the spec's
// § 3 named them `tk_do_eq` … `tk_do_ge`; this is that amendment).

// ============================================================================
// `TimeOnly` (docs/specs/datetime-extras.md, crumb N4b)
// ============================================================================
//
// EIGHT bytes, and the value IS the ticks since midnight: an ordinary,
// non-negative `i64` in `0 .. TICKS_PER_DAY - 1`, C#'s own representation.
// There is no `Kind` and no date above it, so `.Ticks` is the identity row
// `TimeSpan.Ticks` is, and the six comparisons and `.CompareTo`/`.Equals` are
// `TimeSpan`'s own functions -- a tick count of a time of day is an ordinary
// non-negative `i64`, exactly the case `DateOnly` already made (D54).
//
// THE CALENDAR IS NOT REWRITTEN HERE EITHER: `.Hour`, `.Minute`, `.Second`
// and `.Millisecond` are `DateTime`'s own component functions, called
// directly and unmasked -- `DATETIME_TICK_MASK` clears only the top two
// bits, and every `TimeOnly` value already fits well under them, so masking
// it is a no-op and writing four more functions that would do the same
// division and modulo is code not written.

// `TimeOnly.MaxValue`, `23:59:59.9999999`: TICKS_PER_DAY - 1
const i64 TIMEONLY_MAX_TICKS = 863999999999;

i64 tk_to_min() { return 0; }
i64 tk_to_max() { return TIMEONLY_MAX_TICKS; }

// the one range check both `new TimeOnly(ticks)` and `FromTimeSpan` take: a
// raw `i64` tick count has to fall inside a single day. C# raises
// `ArgumentOutOfRangeException` for the first and `ArgumentException` for the
// second; a teko program has no exceptions, so both answer the one `panic`
// this crumb adds -- no existing wording fits an interval that starts at
// zero, unlike every `DateTime`/`TimeSpan` range this file already panics on.
i64 tk_to_from_ticks(i64 t) {
    if (t < 0 || t > TIMEONLY_MAX_TICKS) panic("a time of day is out of range");
    return t;
}

// the three calendar-free constructors: C#'s own `TimeToTicks`, the same
// check `new DateTime(y, m, d, h, mi, s)` already takes for its own time of
// day, so `new TimeOnly(24, 0, 0)` panics on the very function that panics
// under a `DateTime` too.
i64 tk_to_hm(i64 h, i64 mi)                   { return tk_dt_time_ticks(h, mi, 0, 0); }
i64 tk_to_hms(i64 h, i64 mi, i64 s)           { return tk_dt_time_ticks(h, mi, s, 0); }
i64 tk_to_hmsms(i64 h, i64 mi, i64 s, i64 ms) { return tk_dt_time_ticks(h, mi, s, ms); }

// ---- the arithmetic: wrapping, C#'s own ----
// `Add` wraps at both ends of the day and never panics, unlike every
// `TimeSpan`/`DateTime` arithmetic function above. `ts % TICKS_PER_DAY` is
// reduced FIRST so the sum that follows cannot overflow the `i64` itself: a
// `TimeSpan` may carry ticks far outside a single day (its own range is
// about ±10675199 days), and adding one in raw would wrap the machine word
// before the day-wrap below ever saw it. The double `+ TICKS_PER_DAY` before
// the final `%` is what keeps the answer non-negative regardless of the sign
// `%` truncating toward zero would otherwise leave it with.
i64 tk_to_add(i64 t, i64 ts) {
    i64 d = ts % TICKS_PER_DAY;
    return ((t + d) + TICKS_PER_DAY) % TICKS_PER_DAY;
}

// C#'s own form: `.AddHours(v)` IS `.Add(TimeSpan.FromHours(v))`, and
// `.AddMinutes` its sibling -- both wrap through `tk_to_add` above, so
// neither can panic where `TimeSpan.FromHours` itself does not.
i64 tk_to_add_hours(i64 t, f64 v)   { return tk_to_add(t, tk_ts_from_hours(v)); }
i64 tk_to_add_minutes(i64 t, f64 v) { return tk_to_add(t, tk_ts_from_minutes(v)); }

// C#'s own `IsBetween`: `start` inclusive, `end` exclusive, and it WRAPS when
// `start` is after `end` -- `22:00` to `02:00` covers midnight and is not the
// empty interval a naive `t >= start && t < end` would answer.
i64 tk_to_is_between(i64 t, i64 s, i64 e) {
    if (s <= e) return t >= s && t < e;
    return t >= s || t < e;
}

// ---- the operator: a difference, never negative ----
// C#'s own rule for `t1 - t2`: the ELAPSED time from `t2` to `t1`, wrapping
// FORWARD across midnight when `t1` is earlier than `t2` -- never the
// negative `TimeSpan` a raw subtraction would answer. Both operands are
// already inside `0 .. TICKS_PER_DAY - 1`, so `a - b` cannot overflow and the
// `+ TICKS_PER_DAY` before the final `%` is the same non-negative trick
// `tk_to_add` uses above.
i64 tk_to_sub(i64 a, i64 b) { return ((a - b) + TICKS_PER_DAY) % TICKS_PER_DAY; }

// ---- `DateOnly.ToDateTime(TimeOnly)`, the member N4a left out ----
// The argument's type did not exist when `DateOnly` landed (D54); it does
// now, and the packing is exactly `tk_dt_ymd`'s own: the day number back into
// ticks, plus a time of day already in ticks, `Kind` Unspecified.
i64 tk_do_to_datetime(i64 n, i64 t) { return tk_dt_pack(n * TICKS_PER_DAY + t, 0); }

// ============================================================================
// `DateTimeOffset` (docs/specs/datetime-extras.md, crumb N5, D76)
// ============================================================================
//
// SIXTEEN bytes, the third `TK_WIDE` type after `decimal` and `Guid`
// (`teko_wide.tk`, D74/D75): `+0` is a `DateTime` whose `Kind` is ALWAYS
// `Utc` (the instant), `+8` is the offset in SIGNED MINUTES. Unlike
// `TimeSpan`/`DateTime`, which cross the primitive-member table as raw
// `i64`, every function here takes and answers the `DateTimeOffset` STRUCT
// itself (D75's rule for a wide value, `teko_prim.tk`'s `tk_prim_conv`) and
// reads or writes its two halves through `tk_dto_instant`/`tk_dto_offmin`
// rather than through a cast no sixteen-byte type can wear.
//
// THE CALENDAR IS NOT REWRITTEN HERE EITHER: every component is `DateTime`'s
// own `tk_dt_*` function, called on the LOCAL reading -- the instant plus the
// offset, an ordinary Unspecified-`Kind` tick count that needs no mask of its
// own beyond what those functions already do.

const i64 DTO_MAX_OFFSET_MIN = 840;                  // +-14:00, in minutes

const i64 DTO_UNIX_EPOCH_SEC = 62135596800;          // UNIX_EPOCH_TICKS / TICKS_PER_SECOND
const i64 DTO_UNIX_EPOCH_MS  = 62135596800000;       // UNIX_EPOCH_TICKS / TICKS_PER_MILLISECOND
const i64 DTO_MAX_UNIX_SEC   = 253402300799;         // C#'s own bound
const i64 DTO_MIN_UNIX_SEC   = 0 - 62135596800;
const i64 DTO_MAX_UNIX_MS    = 253402300799999;
const i64 DTO_MIN_UNIX_MS    = 0 - 62135596800000;

// the return buffer (D75's fourth wide column) and the two copy helpers every
// wide type owes (`tk_ldn`/`tk_stn`, teko_struct.tk) -- `tk_guid_ld`/`_st`'s
// own shape (lib/guid.tk), two `ld64`/`st64` pairs over the address.
DateTimeOffset tk_dto_retbuf;

DateTimeOffset tk_dto_ld(ptr p) {
    DateTimeOffset o;
    ptr q = &o;
    st64(q, ld64(p));
    st64(q + 8, ld64(p + 8));
    return o;
}

void tk_dto_st(ptr p, DateTimeOffset o) {
    ptr q = &o;
    st64(p, ld64(q));
    st64(p + 8, ld64(q + 8));
}

// ---- the two halves ----
// The one door every value passes: the LOCAL clock (instant + offset) has to
// be a `DateTime` too, or a later `.DateTime`/`.Year`/`ToString` would panic
// on a value that was let in -- `MaxValue.ToOffset(+14:00)` for one
// (Copilot on #729; C# refuses the same at construction).
DateTimeOffset tk_dto_make(i64 instant, i64 offmin) {
    i64 local = tk_dt_ticks(instant) + offmin * TICKS_PER_MINUTE;
    if (local < 0 || local > DATETIME_MAX_TICKS) panic("the local time of that DateTimeOffset is out of range");
    DateTimeOffset o;
    ptr q = &o;
    st64(q, instant);
    st64(q + 8, offmin);
    return o;
}

// the `+0` half AS IT IS: a `DateTime`, `Kind` `Utc`, already packed by
// whichever function built this value
i64 tk_dto_instant(DateTimeOffset o) { ptr q = &o; return ld64(q); }

i64 tk_dto_offmin(DateTimeOffset o) { ptr q = &o; return ld64(q + 8); }

// the LOCAL reading: the instant plus the offset, an ordinary Unspecified
// tick count -- `.Year` … `.Millisecond` and the text both read this
i64 tk_dto_local_ticks(DateTimeOffset o) {
    return tk_dt_ticks(tk_dto_instant(o)) + tk_dto_offmin(o) * TICKS_PER_MINUTE;
}

// ---- the offset validator (§ 2's own panic) ----
// A whole minute, `-14:00 .. +14:00` -- C#'s own bound -- panics where a bad
// one is handed in, whether that is the constructor's second argument or
// `.ToOffset`'s.
i64 tk_dto_check_offset(i64 ts) {
    if (ts % TICKS_PER_MINUTE != 0) panic("that UTC offset does not exist");
    i64 m = ts / TICKS_PER_MINUTE;
    if (m < 0 - DTO_MAX_OFFSET_MIN || m > DTO_MAX_OFFSET_MIN)
        panic("that UTC offset does not exist");
    return m;
}

// ---- the statics ----
DateTimeOffset tk_dto_min() { return tk_dto_make(tk_dt_pack(tk_dt_min(), 1), 0); }
DateTimeOffset tk_dto_max() { return tk_dto_make(tk_dt_pack(tk_dt_max(), 1), 0); }
DateTimeOffset tk_dto_unixepoch() { return tk_dto_make(tk_dt_epoch(), 0); }

// ---- `Now`, `UtcNow` (crumb C6, D90) ----
// The same clock `DateTime.Now`/`UtcNow` read, offset `+0` for both: teko has
// no time-zone database (Ruling 7, § 8), so there is no local offset to carry
// and `Now` is `UtcNow` under another name here too, exactly as `DateTime`'s
// own pair now is, and for the same documented reason.
DateTimeOffset tk_dto_now_utc() { return tk_dto_make(tk_dt_now_utc(), 0); }
DateTimeOffset tk_dto_now() { return tk_dto_make(tk_dt_now_utc(), 0); }

// ---- the constructor: `new DateTimeOffset(DateTime, TimeSpan)` ----
// The `DateTime` is read as a LOCAL (wall-clock) reading at `ts`'s offset --
// C#'s own rule -- so the instant is that reading minus the offset, packed
// `Utc` and range-checked by `tk_dt_pack` exactly as every other `DateTime`
// build is (`teko: a date is out of range`, exit 70,
// `tests/primitives_dto_bad_offset.tk`'s sibling case).
DateTimeOffset tk_dto_new(i64 dt, i64 ts) {
    i64 offmin = tk_dto_check_offset(ts);
    i64 utc = tk_dt_ticks(dt) - offmin * TICKS_PER_MINUTE;
    return tk_dto_make(tk_dt_pack(utc, 1), offmin);
}

// ---- the Unix conversions ----
// The bounds are C#'s own: the whole range of a `DateTimeOffset` in Unix
// seconds/milliseconds, checked BEFORE the multiply that would otherwise wrap
// the `i64` in silence (the same order `tk_ts_scaled` takes).
DateTimeOffset tk_dto_from_unix_seconds(i64 s) {
    if (s < DTO_MIN_UNIX_SEC || s > DTO_MAX_UNIX_SEC) panic("a date is out of range");
    i64 utc = (s + DTO_UNIX_EPOCH_SEC) * TICKS_PER_SECOND;
    return tk_dto_make(tk_dt_pack(utc, 1), 0);
}

DateTimeOffset tk_dto_from_unix_ms(i64 ms) {
    if (ms < DTO_MIN_UNIX_MS || ms > DTO_MAX_UNIX_MS) panic("a date is out of range");
    i64 utc = (ms + DTO_UNIX_EPOCH_MS) * TICKS_PER_MILLISECOND;
    return tk_dto_make(tk_dt_pack(utc, 1), 0);
}

i64 tk_dto_to_unix_seconds(DateTimeOffset o) {
    return tk_dt_ticks(tk_dto_instant(o)) / TICKS_PER_SECOND - DTO_UNIX_EPOCH_SEC;
}

i64 tk_dto_to_unix_ms(DateTimeOffset o) {
    return tk_dt_ticks(tk_dto_instant(o)) / TICKS_PER_MILLISECOND - DTO_UNIX_EPOCH_MS;
}

// ---- the readers ----
i64 tk_dto_offset(DateTimeOffset o) { return tk_dto_offmin(o) * TICKS_PER_MINUTE; }

i64 tk_dto_utcdatetime(DateTimeOffset o) { return tk_dto_instant(o); }

// `.DateTime`/`.LocalDateTime`: the offset re-applied, `Kind` UNSPECIFIED --
// teko has no time-zone database, so "local" means "the offset this value
// carries" and nothing more (datetime-extras.md § 4).
i64 tk_dto_localdatetime(DateTimeOffset o) { return tk_dt_pack(tk_dto_local_ticks(o), 0); }

// the components, C#'s own: the LOCAL reading, reused straight through
// `DateTime`'s own functions -- an Unspecified tick count is exactly what
// they already mask for.
i64 tk_dto_year(DateTimeOffset o)  { return tk_dt_year(tk_dto_local_ticks(o)); }
i64 tk_dto_month(DateTimeOffset o) { return tk_dt_month(tk_dto_local_ticks(o)); }
i64 tk_dto_day(DateTimeOffset o)   { return tk_dt_day(tk_dto_local_ticks(o)); }
i64 tk_dto_hour(DateTimeOffset o)   { return tk_dt_hour(tk_dto_local_ticks(o)); }
i64 tk_dto_minute(DateTimeOffset o) { return tk_dt_minute(tk_dto_local_ticks(o)); }
i64 tk_dto_second(DateTimeOffset o) { return tk_dt_second(tk_dto_local_ticks(o)); }
i64 tk_dto_ms(DateTimeOffset o)     { return tk_dt_ms(tk_dto_local_ticks(o)); }

// ---- `.ToOffset` ----
DateTimeOffset tk_dto_to_offset(DateTimeOffset o, i64 ts) {
    return tk_dto_make(tk_dto_instant(o), tk_dto_check_offset(ts));
}

// ---- the arithmetic: the INSTANT moves, the offset is kept ----
DateTimeOffset tk_dto_add(DateTimeOffset o, i64 t) {
    return tk_dto_make(tk_dt_add(tk_dto_instant(o), t), tk_dto_offmin(o));
}

DateTimeOffset tk_dto_sub_ts(DateTimeOffset o, i64 t) {
    return tk_dto_make(tk_dt_sub_ts(tk_dto_instant(o), t), tk_dto_offmin(o));
}

i64 tk_dto_sub(DateTimeOffset a, DateTimeOffset b) {
    return tk_dt_sub(tk_dto_instant(a), tk_dto_instant(b));
}

// ---- the comparisons: the INSTANT only, offset ignored (C#'s own rule) ----
i64 tk_dto_cmp(DateTimeOffset a, DateTimeOffset b) { return tk_dt_cmp(tk_dto_instant(a), tk_dto_instant(b)); }
i64 tk_dto_eq(DateTimeOffset a, DateTimeOffset b)  { return tk_dt_eq(tk_dto_instant(a), tk_dto_instant(b)); }
i64 tk_dto_ne(DateTimeOffset a, DateTimeOffset b)  { return tk_dt_ne(tk_dto_instant(a), tk_dto_instant(b)); }
i64 tk_dto_lt(DateTimeOffset a, DateTimeOffset b)  { return tk_dt_lt(tk_dto_instant(a), tk_dto_instant(b)); }
i64 tk_dto_le(DateTimeOffset a, DateTimeOffset b)  { return tk_dt_le(tk_dto_instant(a), tk_dto_instant(b)); }
i64 tk_dto_gt(DateTimeOffset a, DateTimeOffset b)  { return tk_dt_gt(tk_dto_instant(a), tk_dto_instant(b)); }
i64 tk_dto_ge(DateTimeOffset a, DateTimeOffset b)  { return tk_dt_ge(tk_dto_instant(a), tk_dto_instant(b)); }

// ---- the text (§ 5) ----
// zero-padded decimal digits, `w` wide, written at `buf`; returns `w`, the
// same shape `tk_guid_fmt` (lib/guid.tk) gives its own caller.
i64 tk_dto_put_num(ptr buf, i64 v, i64 w) {
    i64 i = w - 1;
    loop {
        if (i < 0) break;
        st8(buf + i, '0' + (v % 10));
        v = v / 10;
        i = i - 1;
    }
    return w;
}

// `"o"`: `yyyy-MM-ddTHH:mm:ss.fffffff+HH:MM`, 33 characters, the LOCAL
// reading plus its own offset suffix -- C#'s own round-trip format, and the
// default `ToString()` (§ 5's own table).
str tk_dto_tostring_o(DateTimeOffset o) {
    i64 lt = tk_dto_local_ticks(o);
    i64 offmin = tk_dto_offmin(o);
    i64 sign = '+';
    i64 am = offmin;
    if (am < 0) { sign = '-'; am = 0 - am; }
    uptr buf = rt_alloc(34);
    i64 k = 0;
    k = k + tk_dto_put_num(buf + k, tk_dt_year(lt), 4);
    st8(buf + k, '-'); k = k + 1;
    k = k + tk_dto_put_num(buf + k, tk_dt_month(lt), 2);
    st8(buf + k, '-'); k = k + 1;
    k = k + tk_dto_put_num(buf + k, tk_dt_day(lt), 2);
    st8(buf + k, 'T'); k = k + 1;
    k = k + tk_dto_put_num(buf + k, tk_dt_hour(lt), 2);
    st8(buf + k, ':'); k = k + 1;
    k = k + tk_dto_put_num(buf + k, tk_dt_minute(lt), 2);
    st8(buf + k, ':'); k = k + 1;
    k = k + tk_dto_put_num(buf + k, tk_dt_second(lt), 2);
    st8(buf + k, '.'); k = k + 1;
    k = k + tk_dto_put_num(buf + k, lt % TICKS_PER_SECOND, 7);
    st8(buf + k, sign); k = k + 1;
    k = k + tk_dto_put_num(buf + k, am / 60, 2);
    st8(buf + k, ':'); k = k + 1;
    k = k + tk_dto_put_num(buf + k, am % 60, 2);
    st8(buf + k, 0);
    return buf;
}

// `"s"`: `yyyy-MM-ddTHH:mm:ss`, 19 characters, the LOCAL reading with no
// fraction and no offset -- C#'s own sortable format.
str tk_dto_tostring_s(DateTimeOffset o) {
    i64 lt = tk_dto_local_ticks(o);
    uptr buf = rt_alloc(20);
    i64 k = 0;
    k = k + tk_dto_put_num(buf + k, tk_dt_year(lt), 4);
    st8(buf + k, '-'); k = k + 1;
    k = k + tk_dto_put_num(buf + k, tk_dt_month(lt), 2);
    st8(buf + k, '-'); k = k + 1;
    k = k + tk_dto_put_num(buf + k, tk_dt_day(lt), 2);
    st8(buf + k, 'T'); k = k + 1;
    k = k + tk_dto_put_num(buf + k, tk_dt_hour(lt), 2);
    st8(buf + k, ':'); k = k + 1;
    k = k + tk_dto_put_num(buf + k, tk_dt_minute(lt), 2);
    st8(buf + k, ':'); k = k + 1;
    k = k + tk_dto_put_num(buf + k, tk_dt_second(lt), 2);
    st8(buf + k, 0);
    return buf;
}

str tk_dto_tostring(DateTimeOffset o) { return tk_dto_tostring_o(o); }

// `"o"`/`"s"`, either case is NOT accepted -- C#'s own format specifiers are
// case-sensitive for these two -- and anything else panics where it is
// written, the same rule `Guid.ToString(fmt)` follows.
str tk_dto_tostring_fmt(DateTimeOffset o, str f) {
    i64 c = ld8(f);
    if (ld8(f + 1) != 0) panic("the DateTimeOffset format is not taught");
    if (c == 'o') return tk_dto_tostring_o(o);
    if (c == 's') return tk_dto_tostring_s(o);
    panic("the DateTimeOffset format is not taught");
    return 0;
}

// a single decimal field, `w` digits wide, at `s + off`; -1 on anything that
// is not a digit -- the inverse of `tk_dto_put_num`
i64 tk_dto_scan_num(str s, i64 off, i64 w) {
    i64 v = 0;
    i64 i = 0;
    loop {
        if (i >= w) break;
        i64 c = ld8(s + off + i);
        if (c < '0' || c > '9') return 0 - 1;
        v = v * 10 + (c - '0');
        i = i + 1;
    }
    return v;
}

// the inverse of `tk_dto_tostring_o`/`_s`: 0 on anything that is neither of
// the two, writing the instant and the offset through `utcp`/`offp`
// otherwise. `"s"` (19 characters) reads as UTC, offset zero -- teko has no
// time-zone database to read a bare wall-clock string against
// (docs/specs/datetime-extras.md § 8), and zero is the one offset every
// reader agrees on.
i64 tk_dto_try_scan(str s, ptr utcp, ptr offp) {
    i64 n = tk_str_len(s);
    if (n != 19 && n != 33) return 0;
    i64 y = tk_dto_scan_num(s, 0, 4);
    if (y < 0) return 0;
    if (ld8(s + 4) != '-') return 0;
    i64 mo = tk_dto_scan_num(s, 5, 2);
    if (mo < 0) return 0;
    if (ld8(s + 7) != '-') return 0;
    i64 d = tk_dto_scan_num(s, 8, 2);
    if (d < 0) return 0;
    if (ld8(s + 10) != 'T') return 0;
    i64 h = tk_dto_scan_num(s, 11, 2);
    if (h < 0) return 0;
    if (ld8(s + 13) != ':') return 0;
    i64 mi = tk_dto_scan_num(s, 14, 2);
    if (mi < 0) return 0;
    if (ld8(s + 16) != ':') return 0;
    i64 se = tk_dto_scan_num(s, 17, 2);
    if (se < 0) return 0;
    i64 frac = 0;
    i64 offmin = 0;
    if (n == 33) {
        if (ld8(s + 19) != '.') return 0;
        frac = tk_dto_scan_num(s, 20, 7);
        if (frac < 0) return 0;
        i64 sign = ld8(s + 27);
        if (sign != '+' && sign != '-') return 0;
        i64 oh = tk_dto_scan_num(s, 28, 2);
        if (oh < 0) return 0;
        if (ld8(s + 30) != ':') return 0;
        i64 om = tk_dto_scan_num(s, 31, 2);
        if (om < 0 || om > 59) return 0;         // `+00:60` is no `HH:MM` (Copilot on #729)
        offmin = oh * 60 + om;
        if (sign == '-') offmin = 0 - offmin;
        if (offmin < 0 - DTO_MAX_OFFSET_MIN || offmin > DTO_MAX_OFFSET_MIN) return 0;
    }
    if (y < 1 || y > 9999) return 0;
    if (mo < 1 || mo > 12) return 0;
    if (d < 1 || d > tk_dt_days_in_month(y, mo)) return 0;
    if (h < 0 || h > 23) return 0;
    if (mi < 0 || mi > 59) return 0;
    if (se < 0 || se > 59) return 0;
    i64 local = tk_dt_days_from_ymd(y, mo, d) * TICKS_PER_DAY
              + (h * 3600 + mi * 60 + se) * TICKS_PER_SECOND + frac;
    i64 utc = local - offmin * TICKS_PER_MINUTE;
    if (utc < 0 || utc > DATETIME_MAX_TICKS) return 0;
    st64(utcp, tk_dt_pack(utc, 1));
    st64(offp, offmin);
    return 1;
}

// `DateTimeOffset.Parse(s)`: the value, or a panic (exit 70) -- C#'s own
// `Parse`, whose failure is an exception and not a sentinel value
DateTimeOffset tk_dto_parse(str s) {
    i64 utc = 0;
    i64 offmin = 0;
    ptr up = &utc;
    ptr op = &offmin;
    if (!tk_dto_try_scan(s, up, op)) panic("the string is not a DateTimeOffset");
    return tk_dto_make(utc, offmin);
}

// `DateTimeOffset.TryParse(s, out o)`: 1 and the value, or 0 and
// `DateTimeOffset.MinValue` -- C#'s pair. `o` is an `out DateTimeOffset`, the
// same road any teko function takes for one: the call site is judged by
// `teko_ref.tk`'s own pass, which is what the hand-written `TryParse` parser
// (teko_time.tk) hands it -- a tagged `out` argument, never a raw address.
i64 tk_dto_tryparse(str s, out DateTimeOffset o) {
    i64 utc = 0;
    i64 offmin = 0;
    ptr up = &utc;
    ptr op = &offmin;
    if (!tk_dto_try_scan(s, up, op)) {
        o = tk_dto_min();
        return 0;
    }
    o = tk_dto_make(utc, offmin);
    return 1;
}
