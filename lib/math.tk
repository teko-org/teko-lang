// math.tk -- `Math`, C#'s other spelling of five `decimal` statics
// (docs/specs/decimal.md § 7, C5, D79). Program code, not compiler code:
// `#include "math.tk"` from the `.tk` source itself, exactly as `rt.tk`,
// `decimal.tk` and `guid.tk` are included (docs/reference/runtime.md).
//
// It needs NO MECHANISM AT ALL, and that is the whole point of the file: a
// static method on a declared class is a construct this compiler already runs,
// so `Math.Round(d, 2)` is an ordinary call to an ordinary method that
// forwards to the primitive's own member row. Nothing here is registered, no
// type is taught, and `mc limits` does not move for it.
//
// What is NOT here is C#'s other forty overloads -- `Math.Round(double)`,
// `Math.Max`, `Math.Sqrt` and the rest. This file is the `decimal` half named
// by the crumb that lands it, and a float half is a library crumb of its own
// (docs/reference/not-yet.md).
#include "decimal.tk"

class Math {
    // `MidpointRounding.ToEven`, C#'s default and the rule `decimal.Round`
    // carries (§ 5): 2.5m rounds to 2m and 3.5m to 4m.
    public static decimal Round(decimal d) { return decimal.Round(d); }
    public static decimal Round(decimal d, i64 places) { return decimal.Round(d, places); }
    // toward zero, toward minus infinity and toward plus infinity, all three
    // at scale zero
    public static decimal Truncate(decimal d) { return decimal.Truncate(d); }
    public static decimal Floor(decimal d) { return decimal.Floor(d); }
    public static decimal Ceiling(decimal d) { return decimal.Ceiling(d); }
    public static decimal Abs(decimal d) { return decimal.Abs(d); }
}
