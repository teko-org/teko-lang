// decimal.tk -- the two copy helpers a sixteen-byte value needs, and the one
// buffer a sixteen-byte RETURN travels through. Program code, not compiler
// code: `#include "decimal.tk"` from the `.tk` source itself, exactly as
// `rt.tk` and `time.tk` are included (docs/reference/runtime.md).
//
// C3 of docs/specs/decimal.md (§ 1, § 8, § 12) and D74. There is no arithmetic
// here yet: C4 is the limb arithmetic, C5 round and text. What C3 owes is the
// movement, and the movement is `teko_wide.tk`'s three derived machines plus
// exactly these three declarations.

// The return buffer (docs/specs/decimal.md § 1, "a return"). A function that
// returns a `decimal` copies its sixteen bytes here and returns the ADDRESS of
// this global; the call site copies them out into the call depth's own slot
// immediately after the branch, before any other instruction is emitted, which
// is what makes ONE buffer safe under recursion and under nesting
// (`tw_call`/`tw_ret`, teko_wide.tk).
//
// It is declared here, in the PROGRAM, and not inside the compiler: a machine
// emits code for the program being compiled, and the frame slot that would
// otherwise hold it is gone the moment the epilogue runs. A program that
// returns a `decimal` without this include is refused by name
// (`teko: include "decimal.tk" before returning a sixteen-byte value`).
//
// It is per TYPE and not per program (D75, the wide set's fourth column):
// `lib/guid.tk` declares a `tk_guid_retbuf` of its own, so a source that
// returns a `Guid` and never mentions `decimal` includes `guid.tk` alone and
// is named that file in the refusal.
decimal tk_dec_retbuf;

// The field road and the array-element road (§ 1's last row): two `ld64`/`st64`
// pairs, written in ordinary teko over the address of the sixteen bytes.
// `&d` on a local or on a parameter of `decimal` type is the address of its own
// frame slot -- the core's own `MTASK_LOCAL_ADDR`, untouched by the wide
// machine -- so no new accessor and no new intrinsic is needed to reach the
// halves. It is the same technique `tk_f64_bits`/`tk_f64_from_bits` already use
// for an `f64`.
decimal tk_dec_ld(ptr p) {
    decimal d;
    ptr q = &d;
    st64(q, ld64(p));
    st64(q + 8, ld64(p + 8));
    return d;
}

void tk_dec_st(ptr p, decimal d) {
    ptr q = &d;
    st64(p, ld64(q));
    st64(p + 8, ld64(q + 8));
}

// ============================================================================
// C4 -- THE ARITHMETIC (docs/specs/decimal.md § 4-§ 9, § 12; D77)
// ============================================================================
//
// Everything below is ordinary teko over 32-bit limbs held in `u64` locals --
// the technique `mc`'s own `<i128>` uses to convert a literal (`iw_muladd`,
// already copied into `teko_decimal.tk` as `tk_dl_muladd`) -- and it is the
// reason this crumb needs no 128-bit instruction on any of the five legs and
// registers no intrinsic at all (D21, `mc limits`' `intrin` row unmoved).
//
// `rt.tk` is included for `panic`: every failure here is `rt_panic`, which
// writes `teko: <cause>` on stderr and exits 70 -- the same road an array
// guard already takes (docs/reference/memory.md).
#include "rt.tk"

// ---- the scratch vector (lib/limbs.tk) ----
// The eight 32-bit limbs and the sixteen operations over them are D77's own
// block, lifted into `lib/limbs.tk` unchanged so that `wide.tk` computes an
// `i128` with the same long division instead of a second copy of it (D81).
// Everything below this line is what a `decimal` IS; everything in that file
// is what a wide integer does.
#include "limbs.tk"

// ---- the sixteen bytes, read and written (docs/specs/decimal.md § 1) ----
// `&d` on a parameter of `decimal` type is the address of its own frame slot,
// so the two halves are one `ld64` each and no accessor, no intrinsic and no
// member of the type is needed to reach them.
#define TK_DEC_MAXSCALE 28

u64 tk_dec_lo(decimal d)    { ptr p = &d; return ld64(p); }
u64 tk_dec_hi(decimal d)    { ptr p = &d; return ld64(p + 8); }
i64 tk_dec_scale(decimal d) { return (tk_dec_hi(d) >> 32) & 0xff; }
i64 tk_dec_sign(decimal d)  { return (tk_dec_hi(d) >> 63) & 1; }

// bit 63 of the high word, as a `u64` the shift can be written with: a bare
// `1 << 63` is an `i64` literal and this file never leaves the sign of a
// mantissa to one
u64 tk_dec_signbit() {
    u64 one = 1;
    return one << 63;
}

// 0m, 0.00m and -0m are three bit patterns and one value, which is C#'s rule
// and the reason every comparison below asks this before it asks anything else
i64 tk_dec_is_zero(decimal d) {
    if (tk_dec_lo(d)) return 0;
    return (tk_dec_hi(d) & 0xffffffff) == 0;
}

// the mantissa into a scratch vector, and back out of one
void tk_dec_load(decimal d, uptr v) {
    u64 lo = tk_dec_lo(d);
    tk_dv_zero(v);
    tk_dv_put(v, 0, lo & 0xffffffff);
    tk_dv_put(v, 1, (lo >> 32) & 0xffffffff);
    tk_dv_put(v, 2, tk_dec_hi(d) & 0xffffffff);
}

decimal tk_dec_build(uptr v, i64 scale, i64 sign) {
    decimal d;
    ptr p = &d;
    u64 hi = tk_dv_at(v, 2) | (((u64) scale) << 32);
    if (sign) hi = hi | tk_dec_signbit();
    st64(p, tk_dv_at(v, 0) | (tk_dv_at(v, 1) << 32));
    st64(p + 8, hi);
    return d;
}

// v *= 10^n -- how a smaller-scaled operand is brought up to the scale of the
// larger one. It is done in the SCRATCH and not in the mantissa, so an
// alignment that would leave 96 bits is not an overflow at all: the sum is
// formed wide and `tk_dec_pack` below takes the scale back down, which is what
// `.NET`'s own `DecCalc` does before it gives up (D77, ruling 3).
void tk_dec_raise(uptr v, i64 n) {
    loop {
        if (n <= 0) break;
        if (tk_dv_muls(v, 10)) panic("decimal overflow");
        n = n - 1;
    }
}

// ---- the one place a result becomes a `decimal` ----
// A scratch value and the scale it is at, reduced until BOTH fit: at most 28
// decimal places, at most 96 bits of mantissa. Reducing is a division by ten,
// and what the division leaves behind is the digit the result rounds on --
// HALF AWAY FROM ZERO, which is the rule the OPERATORS carry
// (docs/specs/decimal.md § 5; `decimal.Round` is half to even and is C5).
//
// Only the LAST remainder is read, and that is exact for this rule: a digit
// above five rounds up and one below it rounds down whatever came before, and
// a five rounds up as well -- there is no tie to break, which is the whole
// difference from half to even.
//
// The carry of the rounding can itself leave 96 bits (999...9 + 1), so the
// reduction is a loop and not a step; a value that cannot be reduced because
// it is already at scale zero is the overflow this type is loud about.
decimal tk_dec_pack(uptr r, i64 scale, i64 sign) {
    loop {
        u64 rem = 0;
        loop {
            if (scale <= TK_DEC_MAXSCALE && !tk_dv_over96(r)) break;
            if (scale == 0) panic("decimal overflow");
            rem = tk_dv_divs(r, 10);
            scale = scale - 1;
        }
        if (rem < 5) break;
        tk_dv_inc(r);
        if (!tk_dv_over96(r)) break;
    }
    return tk_dec_build(r, scale, sign);
}

// ---- + and - (docs/specs/decimal.md § 5) ----
// Both operands are aligned to the LARGER scale and the magnitudes are added
// or subtracted with an explicit carry. `flip` is what makes one function of
// the two: `a - b` is `a + (-b)`, and the sign of `b` is the only difference.
decimal tk_dec_addsub(decimal a, decimal b, i64 flip) {
    u64 va[TK_DEC_NL];
    u64 vb[TK_DEC_NL];
    tk_dec_load(a, va);
    tk_dec_load(b, vb);
    i64 sa = tk_dec_scale(a);
    i64 sb = tk_dec_scale(b);
    i64 s = sa;
    if (sb > s) s = sb;
    tk_dec_raise(va, s - sa);
    tk_dec_raise(vb, s - sb);
    i64 ga = tk_dec_sign(a);
    i64 gb = tk_dec_sign(b) ^ flip;
    i64 sign = ga;
    if (ga == gb) {
        tk_dv_add(va, vb);
    } else {
        i64 c = tk_dv_cmp(va, vb);
        if (c > 0) {
            tk_dv_sub(va, vb);
        } else {
            tk_dv_sub(vb, va);
            tk_dv_copy(va, vb);
            sign = gb;
        }
        if (c == 0) sign = 0;                 // `a - a` is +0, C#'s own answer
    }
    return tk_dec_pack(va, s, sign);
}

decimal tk_dec_add(decimal a, decimal b) { return tk_dec_addsub(a, b, 0); }
decimal tk_dec_sub(decimal a, decimal b) { return tk_dec_addsub(a, b, 1); }

// ---- * ----
// The scales SUM and the mantissas multiply; `tk_dec_pack` is what brings a
// product of more than 28 places, or of more than 96 bits, back into range.
decimal tk_dec_mul(decimal a, decimal b) {
    u64 va[TK_DEC_NL];
    u64 vb[TK_DEC_NL];
    u64 vr[TK_DEC_NL];
    tk_dec_load(a, va);
    tk_dec_load(b, vb);
    tk_dv_mul(vr, va, vb);
    return tk_dec_pack(vr, tk_dec_scale(a) + tk_dec_scale(b),
                       tk_dec_sign(a) ^ tk_dec_sign(b));
}

// ---- / ----
// C# § 12.9.3, which is the one rule of the five operators that decides a
// scale of its own (D77, ruling 9): **the quotient carries the smallest scale
// that preserves the result**, at most 28 places. Nothing else strips a
// trailing zero -- `1.0m == 1.00m` is true and `+`, `-` and `*` keep the
// scales the operands imply -- so this is written here and nowhere else.
//
// It is long division, one decimal place per round: the quotient starts at the
// natural scale `sa - sb` and each round multiplies the REMAINDER by ten and
// divides again, which is exactly one more digit. Two things stop it -- a
// remainder of zero, because the result is then exact and every further place
// would be a trailing zero, and the 28th place. A quotient that no longer fits
// 96 bits stops it too: that is the same ceiling the shifted divisor used to
// express, read here off the quotient itself.
//
// The trailing zeros the NATURAL scale carries are then stripped for the same
// rule: `4.0m / 2m` is `2m` and not `2.0m`, because the smallest scale that
// preserves two is zero.
//
// `5m / 2m` is therefore `2.5m` at scale 1 and not at scale 28, `1m / 8m` is
// `0.125m` at scale 3, and `1m / 3m` -- whose remainder never reaches zero --
// spends all 28 places, answers 0.3333333333333333333333333333 and makes
// `1m / 3m * 3m` 0.9999999999999999999999999999 rather than `1m`. All four are
// C#'s answers and the fixture asserts every one of them, SCALE included
// (docs/specs/decimal.md § 5).
decimal tk_dec_div(decimal a, decimal b) {
    if (tk_dec_is_zero(b)) panic("decimal division by zero");
    u64 va[TK_DEC_NL];
    u64 vb[TK_DEC_NL];
    u64 vq[TK_DEC_NL];
    u64 vt[TK_DEC_NL];
    u64 vr[TK_DEC_NL];
    u64 vd[TK_DEC_NL];
    tk_dec_load(a, va);
    tk_dec_load(b, vb);
    i64 s = tk_dec_scale(a) - tk_dec_scale(b);
    // a NEGATIVE scale is no representation at all: the dividend absorbs it,
    // ten at a time, exactly as the literal does (teko_decimal.tk)
    loop {
        if (s >= 0) break;
        if (tk_dv_muls(va, 10)) panic("decimal overflow");
        s = s + 1;
    }
    tk_dv_divmod(vq, va, vb);                 // `va` becomes the remainder
    // one decimal place per round, and only while the remainder says the
    // result is not exact yet. The new quotient is formed WHOLE before it is
    // committed, so the 96-bit ceiling is read off the digit that would land
    // and not off an estimate of it.
    loop {
        if (tk_dv_is_zero(va)) break;         // exact: the scale stops here
        if (s >= TK_DEC_MAXSCALE) break;
        tk_dv_copy(vt, vq);
        if (tk_dv_muls(vt, 10)) break;
        tk_dv_copy(vr, va);
        tk_dv_muls(vr, 10);                   // the remainder buys the place
        tk_dv_divmod(vd, vr, vb);             // one digit, and what is left
        tk_dv_add(vt, vd);
        if (tk_dv_over96(vt)) break;          // a mantissa is 96 bits
        tk_dv_copy(vq, vt);
        tk_dv_copy(va, vr);
        s = s + 1;
    }
    tk_dv_shl1(va);                           // twice the remainder, against the
    if (tk_dv_cmp(va, vb) >= 0) tk_dv_inc(vq);  // divisor: half away from zero
    // ...and the smallest scale that still preserves it
    loop {
        if (s <= 0) break;
        tk_dv_copy(vt, vq);
        if (tk_dv_divs(vt, 10)) break;
        tk_dv_copy(vq, vt);
        s = s - 1;
    }
    return tk_dec_pack(vq, s, tk_dec_sign(a) ^ tk_dec_sign(b));
}

// ---- % ----
// C#'s own rule (D77, ruling 2): the sign is the DIVIDEND's and the scale is
// `max(sa, sb)`, so `-7.5m % 2m` is `-1.5m`. The remainder is exact -- there
// is nothing to round -- and `tk_dec_pack` only ever has work to do when the
// alignment left the operands wider than a mantissa.
decimal tk_dec_rem(decimal a, decimal b) {
    if (tk_dec_is_zero(b)) panic("decimal division by zero");
    u64 va[TK_DEC_NL];
    u64 vb[TK_DEC_NL];
    u64 vq[TK_DEC_NL];
    tk_dec_load(a, va);
    tk_dec_load(b, vb);
    i64 sa = tk_dec_scale(a);
    i64 sb = tk_dec_scale(b);
    i64 s = sa;
    if (sb > s) s = sb;
    tk_dec_raise(va, s - sa);
    tk_dec_raise(vb, s - sb);
    tk_dv_divmod(vq, va, vb);
    return tk_dec_pack(va, s, tk_dec_sign(a));
}

// ---- unary - ----
// One bit, flipped. `-0m` is a live bit pattern and compares equal to `0m`,
// which is C#'s rule and the reason equality is a call and never a `cmp`.
decimal tk_dec_neg(decimal a) {
    decimal d;
    ptr p = &d;
    st64(p, tk_dec_lo(a));
    st64(p + 8, tk_dec_hi(a) ^ tk_dec_signbit());
    return d;
}

// ---- the six comparisons ----
// Zero first (three patterns, one value), then the sign, then the magnitudes
// at a common scale -- which is what makes `1.0m == 1.00m` true with two
// different mantissas.
i64 tk_dec_cmp(decimal a, decimal b) {
    i64 za = tk_dec_is_zero(a);
    i64 zb = tk_dec_is_zero(b);
    i64 ga = tk_dec_sign(a);
    i64 gb = tk_dec_sign(b);
    if (za && zb) return 0;
    if (za) { if (gb) return 1; return 0 - 1; }
    if (zb) { if (ga) return 0 - 1; return 1; }
    if (ga != gb) { if (ga) return 0 - 1; return 1; }
    u64 va[TK_DEC_NL];
    u64 vb[TK_DEC_NL];
    tk_dec_load(a, va);
    tk_dec_load(b, vb);
    i64 sa = tk_dec_scale(a);
    i64 sb = tk_dec_scale(b);
    i64 s = sa;
    if (sb > s) s = sb;
    tk_dec_raise(va, s - sa);
    tk_dec_raise(vb, s - sb);
    i64 c = tk_dv_cmp(va, vb);
    if (ga) return 0 - c;
    return c;
}

i64 tk_dec_eq(decimal a, decimal b) { return tk_dec_cmp(a, b) == 0; }
i64 tk_dec_ne(decimal a, decimal b) { return tk_dec_cmp(a, b) != 0; }
i64 tk_dec_lt(decimal a, decimal b) { return tk_dec_cmp(a, b) < 0; }
i64 tk_dec_le(decimal a, decimal b) { return tk_dec_cmp(a, b) <= 0; }
i64 tk_dec_gt(decimal a, decimal b) { return tk_dec_cmp(a, b) > 0; }
i64 tk_dec_ge(decimal a, decimal b) { return tk_dec_cmp(a, b) >= 0; }

// ---- the conversions (docs/specs/decimal.md § 6) ----
// An integer converts IMPLICITLY, in every one of the nine slots D33
// enumerated, and the compiler writes the call (`tk_num_widen`,
// teko_typeof.tk); the other three directions are explicit and the compiler
// writes the call under the cast the source spelled (`tk_prim_cast_check`,
// teko_prim.tk). None of the five is a machine cast: `MTASK_CAST` on a
// sixteen-byte value has no meaning (`tw_cast`, teko_wide.tk).
//
// The integer direction is TWO functions and not one, keyed on the SOURCE
// type's own signedness (D77, ruling 8): `u8`, `u16` and `u32` all fit an
// `i64` as a positive number and take the signed road, and `u64` above 2^63
// does not -- `n < 0` below would read `18446744073709551615` as `-1`, which
// is the silently wrong answer this project refuses to ship. A `u64` source
// therefore has a conversion row of its own (`tk_prim_cast_op`,
// teko_decimal.tk), and this function never asks a sign question at all.
decimal tk_dec_from_u64(u64 n) {
    u64 va[TK_DEC_NL];
    tk_dv_zero(va);
    tk_dv_put(va, 0, n & 0xffffffff);
    tk_dv_put(va, 1, (n >> 32) & 0xffffffff);
    return tk_dec_build(va, 0, 0);
}

decimal tk_dec_from_i64(i64 n) {
    u64 va[TK_DEC_NL];
    tk_dv_zero(va);
    u64 m = n;
    i64 sign = 0;
    if (n < 0) {
        sign = 1;
        m = 0 - m;                            // in `u64`, so `i64`'s own floor works
    }
    tk_dv_put(va, 0, m & 0xffffffff);
    tk_dv_put(va, 1, (m >> 32) & 0xffffffff);
    return tk_dec_build(va, 0, sign);
}

// C# § 10.3: truncates TOWARD ZERO, and a value outside `i64` is an overflow
// rather than a wrap
i64 tk_dec_to_i64(decimal a) {
    u64 va[TK_DEC_NL];
    tk_dec_load(a, va);
    i64 s = tk_dec_scale(a);
    loop {
        if (s <= 0) break;
        tk_dv_divs(va, 10);
        s = s - 1;
    }
    if (tk_dv_at(va, 2)) panic("decimal overflow");
    u64 m = tk_dv_at(va, 0) | (tk_dv_at(va, 1) << 32);
    // The range is read off BIT 63 and never with `m > lim`: `mc` compares
    // every integer signed (`gen_binary`, src/gen_walk.mc -- `MTASK_CMP`
    // carries a condition and no signedness), so a `u64` above 2^63 compares
    // as a negative number. A shift is unsigned where a comparison is not,
    // which is what this reads instead.
    i64 top = (m >> 63) & 1;
    if (tk_dec_sign(a)) {
        // -2^63 is the one magnitude that sets that bit and still fits
        if (top && (m << 1)) panic("decimal overflow");
        return (i64) (0 - m);
    }
    if (top) panic("decimal overflow");
    return (i64) m;
}

// C# § 10.3: may lose precision. The mantissa is assembled limb by limb and
// divided ONCE by the scale's own power of ten, so the result carries one
// rounding and not twenty-eight.
f64 tk_dec_to_f64(decimal a) {
    u64 va[TK_DEC_NL];
    tk_dec_load(a, va);
    f64 two32 = 4294967296.0;
    f64 r = (f64) tk_dv_at(va, 2);
    r = r * two32 + (f64) tk_dv_at(va, 1);
    r = r * two32 + (f64) tk_dv_at(va, 0);
    f64 p = 1.0;
    i64 s = tk_dec_scale(a);
    loop {
        if (s <= 0) break;
        p = p * 10.0;
        s = s - 1;
    }
    r = r / p;
    if (tk_dec_sign(a)) r = 0.0 - r;
    return r;
}

// how far below one a `double` may sit before it is nothing but zero at
// twenty-eight places: fifteen digits of significand under a scale of 28
#define TK_DEC_F64FLOOR 45

// C# § 10.3: the double's OWN value, rounded to fifteen significant digits --
// which is why `(decimal) 0.1` is `0.1m` and not the
// 0.1000000000000000055511151231 the sixteenth digit onwards would give.
//
// The value is brought into [10^14, 10^15) by multiplying or dividing by ten,
// the fifteen digits are read off with one rounding, and the trailing zeros
// are dropped so that the scale is the one C# reports.
decimal tk_dec_from_f64(f64 x) {
    u64 va[TK_DEC_NL];
    tk_dv_zero(va);
    u64 bits = tk_f64_bits(x);
    if (((bits >> 52) & 0x7ff) == 0x7ff) panic("decimal overflow");   // NaN, infinity
    i64 sign = 0;
    if (x < 0.0) {
        sign = 1;
        x = 0.0 - x;
    }
    if (x == 0.0) return tk_dec_build(va, 0, sign);
    f64 lo15 = 1.0;
    i64 k = 0;
    loop {
        if (k >= 14) break;
        lo15 = lo15 * 10.0;
        k = k + 1;
    }
    f64 hi15 = lo15 * 10.0;
    i64 s = 0;
    loop {
        if (x >= lo15) break;
        if (s >= TK_DEC_F64FLOOR) return tk_dec_build(va, TK_DEC_MAXSCALE, sign);
        x = x * 10.0;
        s = s + 1;
    }
    loop {
        if (x < hi15) break;
        x = x / 10.0;
        s = s - 1;
    }
    i64 m = (i64) (x + 0.5);                  // below 10^15, so the half is exact
    loop {
        if (s <= 0) break;
        if (m % 10) break;
        m = m / 10;
        s = s - 1;
    }
    u64 um = m;
    tk_dv_put(va, 0, um & 0xffffffff);
    tk_dv_put(va, 1, (um >> 32) & 0xffffffff);
    if (s < 0) {
        tk_dec_raise(va, 0 - s);
        s = 0;
    }
    return tk_dec_pack(va, s, sign);
}

// ============================================================================
// C5 -- ROUND AND TEXT (docs/specs/decimal.md § 7, § 8, § 11, § 12; D79)
// ============================================================================
//
// The API of § 7, all of it over the same limb vector the arithmetic above
// works in and none of it an intrinsic: the five statics that ARE values, the
// five that reshape one, the two that read it, and the text in both
// directions. `teko_decimal.tk` is where each one becomes a member row.

// ---- the five constant statics ----
// Each is a CALL and not a folded constant: sixteen bytes have no
// `MTASK_CONST` (`tw_const`, teko_wide.tk), so `decimal.One` writes its value
// into the return buffer like any other `decimal`-valued function -- the shape
// `Guid.Empty` already has (lib/guid.tk).
decimal tk_dec_zero() {
    u64 v[TK_DEC_NL];
    tk_dv_zero(v);
    return tk_dec_build(v, 0, 0);
}

decimal tk_dec_one() {
    u64 v[TK_DEC_NL];
    tk_dv_zero(v);
    tk_dv_put(v, 0, 1);
    return tk_dec_build(v, 0, 0);
}

decimal tk_dec_minusone() {
    u64 v[TK_DEC_NL];
    tk_dv_zero(v);
    tk_dv_put(v, 0, 1);
    return tk_dec_build(v, 0, 1);
}

// 79228162514264337593543950335 = 2^96 - 1 at scale zero: every one of the
// three mantissa limbs full, which is what C# calls `decimal.MaxValue`.
void tk_dec_full(uptr v) {
    tk_dv_zero(v);
    tk_dv_put(v, 0, 0xffffffff);
    tk_dv_put(v, 1, 0xffffffff);
    tk_dv_put(v, 2, 0xffffffff);
}

decimal tk_dec_max() {
    u64 v[TK_DEC_NL];
    tk_dec_full(v);
    return tk_dec_build(v, 0, 0);
}

decimal tk_dec_min() {
    u64 v[TK_DEC_NL];
    tk_dec_full(v);
    return tk_dec_build(v, 0, 1);
}

// ---- Round, HALF TO EVEN (docs/specs/decimal.md § 5, § 7) ----
// The other rounding rule this type carries: the OPERATORS round half away
// from zero (`tk_dec_pack` above), and `decimal.Round` rounds half to EVEN --
// C#'s `MidpointRounding.ToEven` default, and the one the owner named. Both
// are fixtures with values that only pass under the right rule.
//
// The scale never GROWS (C#): `Round(1.5m, 3)` is `1.5m` at scale 1 and not
// `1.500m`, so a value already at or below `places` is handed straight back.
//
// Three facts decide a digit: the first DISCARDED digit, whether anything
// below it was non-zero, and the parity of what is kept. The parity is read
// off limb zero, because a binary value and its last decimal digit have the
// same one -- ten is even -- and that is one test instead of a division.
decimal tk_dec_round_at(decimal d, i64 places) {
    if (places < 0 || places > TK_DEC_MAXSCALE)
        panic("the decimal places are out of range");
    i64 s = tk_dec_scale(d);
    if (s <= places) return d;
    u64 v[TK_DEC_NL];
    tk_dec_load(d, v);
    u64 dig = 0;                              // the digit the decision is made on
    i64 rest = 0;                             // anything non-zero BELOW it
    loop {
        if (s <= places) break;
        if (dig) rest = 1;
        dig = tk_dv_divs(v, 10);
        s = s - 1;
    }
    i64 up = 0;
    if (dig > 5) up = 1;
    if (dig == 5 && rest) up = 1;
    if (dig == 5 && !rest && (tk_dv_at(v, 0) & 1)) up = 1;     // the tie: to even
    // at least one division happened, so the value is below 2^96/10 and the
    // carry of this increment cannot leave the mantissa
    if (up) tk_dv_inc(v);
    return tk_dec_build(v, places, tk_dec_sign(d));
}

decimal tk_dec_round(decimal d) { return tk_dec_round_at(d, 0); }

// ---- Truncate, Floor and Ceiling ----
// One function and C#'s three answers, told apart by the SIGN a discarded
// fraction grows the magnitude for: a negative value goes away from zero under
// `Floor` (`Floor(-1.5m)` is `-2m`), a positive one under `Ceiling`
// (`Ceiling(1.5m)` is `2m`), and `Truncate` -- which passes a sign no value
// has -- always goes toward zero. All three answer at SCALE ZERO, as C# does:
// `Floor(1.50m)` is `1m` and not `1.0m`.
decimal tk_dec_intpart(decimal d, i64 way) {
    u64 v[TK_DEC_NL];
    tk_dec_load(d, v);
    i64 s = tk_dec_scale(d);
    i64 frac = 0;
    loop {
        if (s <= 0) break;
        if (tk_dv_divs(v, 10)) frac = 1;
        s = s - 1;
    }
    i64 g = tk_dec_sign(d);
    if (frac && g == way) tk_dv_inc(v);
    return tk_dec_build(v, 0, g);
}

decimal tk_dec_trunc(decimal d) { return tk_dec_intpart(d, 0 - 1); }
decimal tk_dec_floor(decimal d) { return tk_dec_intpart(d, 1); }
decimal tk_dec_ceil(decimal d)  { return tk_dec_intpart(d, 0); }

// ---- Abs and Sign ----
// The sign is ONE bit and `Abs` clears it: `tk_dec_signbit() - 1` is the other
// sixty-three, written that way because a `~` over a `u64` literal is a
// spelling this file does not need.
decimal tk_dec_abs(decimal d) {
    decimal r;
    ptr p = &r;
    st64(p, tk_dec_lo(d));
    st64(p + 8, tk_dec_hi(d) & (tk_dec_signbit() - 1));
    return r;
}

// `.Sign` is C#'s `-1`/`0`/`1` over the VALUE and not the sign BIT: `-0m` is
// zero and answers 0, which is the same rule every comparison here reads
// (`tk_dec_cmp`). `tk_dec_sign` above is the raw bit and stays the private
// half.
i64 tk_dec_signum(decimal d) {
    if (tk_dec_is_zero(d)) return 0;
    if (tk_dec_sign(d)) return 0 - 1;
    return 1;
}

// ---- the text (docs/specs/decimal.md § 7) ----
// The SHORTEST EXACT form: the mantissa with the point placed by the scale, a
// leading `-` when the value is below zero, and TRAILING ZEROS KEPT -- `1.50m`
// writes "1.50", because `1.50m` and `1.5m` are two values with two scales and
// text that dropped the zero would read back as the other one. `0m`, `-0m` and
// `0.00m` write "0", "0" and "0.00": the sign is the VALUE's, so a zero never
// carries one (D79, ruling 4).
//
// The longest form is 31 characters -- a sign, 29 mantissa digits, a point --
// and 30 for the other shape a scale of 28 gives ("0." and 28 places), so 32
// bytes hold every `decimal` this type has with its terminator.
#define TK_DEC_STRMAX 32

i64 tk_dec_isdig(i64 c) { return c >= '0' && c <= '9'; }

// `d` into `buf`, NUL-terminated, returning the length. This is the
// allocation-free half, the split `<float_rt>` makes between `putf64` and
// `fmt_f64` (§ 7); `buf` needs TK_DEC_STRMAX bytes.
i64 tk_dec_fmt(ptr buf, decimal d) {
    u64 v[TK_DEC_NL];
    tk_dec_load(d, v);
    u8 dig[TK_DEC_STRMAX];
    i64 nd = 0;
    // least significant first, and always one digit: a zero mantissa writes
    // "0" rather than nothing at all
    loop {
        u64 r = tk_dv_divs(v, 10);
        st8(dig + nd, '0' + r);
        nd = nd + 1;
        if (tk_dv_is_zero(v)) break;
    }
    i64 scale = tk_dec_scale(d);
    i64 k = 0;
    if (tk_dec_sign(d) && !tk_dec_is_zero(d)) {
        st8(buf + k, '-');
        k = k + 1;
    }
    i64 ip = nd - scale;                      // integer digits the mantissa has
    if (ip <= 0) {
        st8(buf + k, '0');                    // "0.05", never ".05"
        k = k + 1;
    } else {
        i64 i = 0;
        loop {
            if (i >= ip) break;
            st8(buf + k, ld8(dig + nd - 1 - i));
            k = k + 1;
            i = i + 1;
        }
    }
    if (scale > 0) {
        st8(buf + k, '.');
        k = k + 1;
        i64 z = 0 - ip;                       // the zeros between point and mantissa
        loop {
            if (z <= 0) break;
            st8(buf + k, '0');
            k = k + 1;
            z = z - 1;
        }
        i64 nf = scale;                       // fraction digits the mantissa carries
        if (nf > nd) nf = nd;
        i64 j = 0;
        loop {
            if (j >= nf) break;
            st8(buf + k, ld8(dig + nf - 1 - j));
            k = k + 1;
            j = j + 1;
        }
    }
    st8(buf + k, 0);
    return k;
}

// `.ToString()`. The buffer is heap-owned and the caller keeps it past this
// call's own return, exactly as `tk_guid_tostring` (lib/guid.tk) hands one
// back: `str` is a `uptr` with a NUL terminator and no `string` object exists.
str tk_dec_tostring(decimal d) {
    uptr buf = rt_alloc(TK_DEC_STRMAX);
    tk_dec_fmt(buf, d);
    return buf;
}

// `.ToString(places)`: C#'s `"F<n>"` -- the value rounded to `places` (half to
// even, the rule above) and then written with EXACTLY that many decimals, the
// missing ones padded with zeros. The padding is done in the TEXT and never in
// the mantissa: `decimal.MaxValue.ToString(28)` is 29 digits and 28 zeros, a
// number no 96-bit mantissa could hold.
//
// `places` outside 0..28 is the same cause as `Round`'s and answers in the
// same words, which is why this function asks no question of its own: the
// rounding above is reached first and panics there (D79, ruling 4).
str tk_dec_tostring_n(decimal d, i64 places) {
    decimal r = tk_dec_round_at(d, places);
    uptr buf = rt_alloc(TK_DEC_STRMAX + TK_DEC_MAXSCALE + 1);
    i64 k = tk_dec_fmt(buf, r);
    i64 have = tk_dec_scale(r);
    if (places > 0 && have == 0) {
        st8(buf + k, '.');
        k = k + 1;
    }
    loop {
        if (have >= places) break;
        st8(buf + k, '0');
        k = k + 1;
        have = have + 1;
    }
    st8(buf + k, 0);
    return buf;
}

// ---- Parse and TryParse ----
// The grammar is what `ToString` writes plus an optional exponent, and nothing
// else (docs/specs/decimal.md § 9: culture, grouping and currency are a
// formatting library and not a primitive):
//
//     [+|-] digits [ . digits ] [ (e|E) [+|-] digits ]
//
// with at least one digit somewhere around the point, NO surrounding space and
// NO separator of any kind. `.5` and `5.` are accepted, as C# accepts them.
//
// The answer is three-valued, because two failures are two causes: 0 for text
// that is no decimal at all, -1 for a number that IS one and does not fit (a
// mantissa past 96 bits, or a scale past 28 places after the exponent moved
// it). `Parse` panics with the cause and `TryParse` reads both as false, which
// is what makes it a function that never panics.
i64 tk_dec_scan(ptr p, str s) {
    i64 i = 0;
    i64 sign = 0;
    i64 c = ld8(s);
    if (c == '+' || c == '-') {
        if (c == '-') sign = 1;
        i = 1;
    }
    u64 v[TK_DEC_NL];
    tk_dv_zero(v);
    i64 nd = 0;                               // digits read, on both sides
    i64 scale = 0;
    i64 over = 0;                             // past the 256 bits of the scratch
    loop {
        c = ld8(s + i);
        if (!tk_dec_isdig(c)) break;
        if (tk_dv_muladds(v, 10, c - '0')) over = 1;
        nd = nd + 1;
        i = i + 1;
    }
    if (ld8(s + i) == '.') {
        i = i + 1;
        loop {
            c = ld8(s + i);
            if (!tk_dec_isdig(c)) break;
            if (tk_dv_muladds(v, 10, c - '0')) over = 1;
            nd = nd + 1;
            scale = scale + 1;
            i = i + 1;
        }
    }
    if (nd == 0) return 0;                    // "", "-", ".", "e3"
    i64 exp = 0;
    c = ld8(s + i);
    if (c == 'e' || c == 'E') {
        i = i + 1;
        i64 eneg = 0;
        c = ld8(s + i);
        if (c == '+' || c == '-') {
            if (c == '-') eneg = 1;
            i = i + 1;
        }
        i64 ne = 0;
        loop {
            c = ld8(s + i);
            if (!tk_dec_isdig(c)) break;
            // the exponent is read WHOLE, so `0.<10000 zeros>1e10001` lands at
            // scale 0 as written; past a billion it saturates, which is only
            // ever an overflow or a zero below (Copilot on #733)
            if (exp < 1000000000) exp = exp * 10 + (c - '0');
            ne = ne + 1;
            i = i + 1;
        }
        if (ne == 0) return 0;                // "1e", "1e+"
        if (eneg) exp = 0 - exp;
    }
    if (ld8(s + i) != 0) return 0;            // trailing text of any kind
    scale = scale - exp;
    i64 zero = tk_dv_is_zero(v);
    // a NEGATIVE scale is no representation at all: the mantissa absorbs it,
    // ten at a time, exactly as the literal does (teko_decimal.tk) -- and a
    // non-zero mantissa needing more than 29 tens is an overflow before the
    // first multiply, while a zero is a zero at any scale
    if (scale < 0 && zero) scale = 0;
    if (scale < 0 - 29) return 0 - 1;
    loop {
        if (scale >= 0) break;
        if (tk_dv_muladds(v, 10, 0)) over = 1;
        scale = scale + 1;
    }
    if (zero && scale > TK_DEC_MAXSCALE) scale = TK_DEC_MAXSCALE;
    if (over || tk_dv_over96(v)) return 0 - 1;
    // EXACT or refused (D79, ruling 5): a scale past 28 places is a value this
    // type cannot hold, and rounding it here would answer a number the writer
    // never wrote. `ToString` never produces one, so the round trip is closed.
    if (scale > TK_DEC_MAXSCALE) return 0 - 1;
    tk_dec_st(p, tk_dec_build(v, scale, sign));
    return 1;
}

// `decimal.Parse(s)`: the value, or a panic (exit 70) -- C#'s own `Parse`,
// whose failure is an exception and not a sentinel no caller could tell from a
// parsed value.
decimal tk_dec_parse(str s) {
    decimal d;
    ptr q = &d;
    st64(q, 0);
    st64(q + 8, 0);
    i64 r = tk_dec_scan(q, s);
    if (r == 0) panic("the string is not a decimal");
    if (r < 0) panic("decimal overflow");
    return d;
}

// `decimal.TryParse(s, out d)`: 1 and the value, or 0 and `decimal.Zero` --
// C#'s pair, and the one road into this type that never panics. `o` is an
// `out decimal`, judged at the call site by teko_ref.tk's own pass, which is
// what the hand-written parser (teko_decimal.tk) hands it.
i64 tk_dec_tryparse(str s, out decimal o) {
    decimal d;
    ptr q = &d;
    st64(q, 0);
    st64(q + 8, 0);
    if (tk_dec_scan(q, s) != 1) {
        st64(q, 0);                           // the scan writes nothing on failure
        st64(q + 8, 0);
        o = d;
        return 0;
    }
    o = d;
    return 1;
}
