// string.tk -- `string`, N7a of docs/specs/string.md (§ 1-3, § 7-8): an
// ORDINARY counted teko class, not a `type_new` primitive (§ 1's own
// argument: a primitive has no row in `teko_struct.tk`'s type table, so
// `tk_is_counted` answers 0 for it and the reclaim never fires). Program
// code, not compiler code: `#include "string.tk"` from the `.tk` source
// itself, exactly as `rt.tk`, `time.tk`, `decimal.tk` and `guid.tk` are
// included (docs/reference/runtime.md). Needs `rt.tk` for `rt_alloc`,
// `rt_free` and `tk_str_eq`; `#include "rt.tk"` ahead of this file.
//
// N7a's own half of N7 (the dispatcher's split on the D81->D83/D84/D85
// precedent): the class, its constructor and destructor, its members and its
// operators, constructed ONLY through `new string(raw)` from a `str` (rule
// 4). N7b owes the rest of § 2-4: literal interning, the two implicit
// conversions in the nine slots D33 enumerates, and the
// `#include "string.tk"` named refusal -- none of those three is here, and a
// program that writes `string s = "hi";` (a literal, with no explicit `new`)
// is refused the ordinary way a `str` fails to fit a class slot, until N7b
// lands the conversion.
//
//     +0   vtable pointer       (word 0, every class)
//     +8   reference count      (word 1, every class)
//     +16  nbytes  (i64)        the UTF-8 length, no NUL
//     +24  nchars  (i64)        the code-point count
//     +32  data    (uptr)       nbytes bytes, then a NUL
//     +40  owned   (i64)        1 when the destructor frees `data`
//                                                             STRING_SIZE = 48
//
// The bytes live in a SECOND allocation rather than a tail of the object (a
// teko class has a fixed size; a variable tail needs an allocator `new` does
// not have), `nchars` is stored rather than walked (`.Length` in a loop
// condition must not be quadratic), and `data` stays NUL-terminated so a
// `string` reaches `puts`/`write`/every `extern` with a field load, not a
// copy (§ 1).
//
// The methods are NOT virtual (C#'s own sealed `string`, and § 4's own
// reason: an interned literal's word 0 is never read) -- this file writes
// none of them `virtual`, which is teko's default.
//
// `==`/`!=` are BY VALUE (a byte compare of the two `data` fields), never by
// identity: two independently built strings holding the same bytes compare
// equal. `a == null` and `null == a` do not reach either operator at all --
// `tk_nl_binary_check`/the plain non-nullable path (teko_ops.tk) leave a
// comparison against the `null` literal to the CORE's own raw-pointer
// compare against zero, on any reference-shaped operand, nullable slot or
// not (D43 rule 2's comparison exemption). That supersedes this page's own
// § 8 sentence ("the same operator; null lands on a row parameter, D32"),
// written before D43 landed on 2026-09-08: D43 is newer and this entry says
// so rather than silently disagreeing with the page it implements.
//
// NONE OF THIS FILE NAMES A PARAMETER `p`. `teko_class.tk`'s own `tk_new_fn`
// -- the allocator every `new ClassName(...)` lowers through -- declares a
// LOCAL literally named `p` (the fresh block `rt_alloc` just answered) in
// the very scope that clones the constructor's own parameter list to build
// the call; a constructor parameter also spelled `p` is silently shadowed by
// that local, so the argument the caller wrote is lost and the constructor
// reads the allocation's own address instead. Measured (`Cell(i64 p){v=p;}`
// against `Cell(i64 x){v=x;}`, the second the only one landing `7`), general
// to every class and not to this one, and not this crumb's compiler code to
// fix -- reported as an adjacent finding and routed around here by naming.

// ---- N8 (docs/specs/string.md § 6-7, D89): `s[i]`'s own lowering and the
// instance/static method surface. `s[i]` needs a PLAIN top-level function --
// `tk_bracket` (teko_params.tk) builds a call to `tk_string_at` by NAME, the
// same shape every other index lowering already takes (`tk_ha_load`,
// `tk_arr_load`) -- rather than a method call through `tk_emit_call`'s
// machinery, so it reads the class's fields through the fixed offsets § 1's
// own layout diagram already publishes, never through `this`. That is why it
// stands OUTSIDE `public class string { ... }` below, the one function here
// that does: everything else is an ordinary member, resolved by the class
// dispatch that already runs for any type and taught nothing new to reach.
//
//     TK_STRAT_NBYTES = 16   TK_STRAT_NCHARS = 24   TK_STRAT_DATA = 32
//
// matching the layout comment atop the class, word for word -- a `string`
// value AT RUNTIME is nothing but the object's own address (every class is),
// so `(uptr) s` (an ordinary CAST, not one of D33's nine CONVERSION slots:
// `tk_str_borrow` only fires at those, never at a cast) hands back that
// address with no help from `teko_string.tk` at all.
#define TK_STRAT_NBYTES 16
#define TK_STRAT_NCHARS 24
#define TK_STRAT_DATA   32

// the byte width of the UTF-8 code point whose LEAD byte is `b0` -- the
// four-way table every UTF-8 decoder opens with
i64 tk_string_utf8_width(i64 b0) {
    if ((b0 & 128) == 0) return 1;
    if ((b0 & 224) == 192) return 2;
    if ((b0 & 240) == 224) return 3;
    return 4;
}

// the code point `width` bytes starting at `data + boff` decode to, reading
// nothing past `nbytes`: `new string(raw)` copies whatever bytes it is given
// and counts LEAD bytes, so a truncated sequence at the tail -- a `raw` that
// is not valid UTF-8 -- would otherwise be decoded past the allocation. A
// sequence that runs off the end answers U+FFFD, the replacement character
// every decoder gives a truncated one (D89, the review's own finding).
i64 tk_string_cp_decode(uptr data, i64 boff, i64 width, i64 nbytes) {
    if (boff + width > nbytes) return 65533;
    i64 b0 = ld8(data + boff);
    if (width == 1) return b0;
    if (width == 2) return ((b0 & 31) << 6) | (ld8(data + boff + 1) & 63);
    if (width == 3)
        return ((b0 & 15) << 12) | ((ld8(data + boff + 1) & 63) << 6) | (ld8(data + boff + 2) & 63);
    return ((b0 & 7) << 18) | ((ld8(data + boff + 1) & 63) << 12)
         | ((ld8(data + boff + 2) & 63) << 6) | (ld8(data + boff + 3) & 63);
}

// `s[i]`, § 6: the `i`-th CODE POINT, as a `char`. `O(1)` when the string is
// ASCII (`nbytes == nchars`, one `ld8`); otherwise a walk from byte 0, the
// same `O(i)` § 6 states rather than hides. Out of range -- negative or past
// the end -- panics, exit 70, the guard every `T[]` index already carries
// (docs/reference/arrays.md).
i64 tk_string_at(string s, i64 i) {
    uptr obj = (uptr) s;
    i64 nbytes = ld64(obj + TK_STRAT_NBYTES);
    i64 nchars = ld64(obj + TK_STRAT_NCHARS);
    uptr data  = ld64(obj + TK_STRAT_DATA);
    if (i < 0 || i >= nchars) panic("string index out of range");
    if (nbytes == nchars) return ld8(data + i);
    i64 boff = 0;
    i64 ci = 0;
    loop {
        i64 w = tk_string_utf8_width(ld8(data + boff));
        if (ci == i) return tk_string_cp_decode(data, boff, w, nbytes);
        boff = boff + w;
        ci = ci + 1;
    }
}

// ---- two byte-level helpers, kept here rather than in `lib/rt.tk` (the
// scout's own finding: a line added to `rt.tk` moves the `--dump-ast`
// include chain of every fixture in the tree, and this crumb's gate is that
// chain staying byte-identical) ----

// `n` bytes copied from `src` to `dst`, no overlap assumed -- the two ever
// built here are freshly allocated, so this is never asked to shift a
// buffer over itself
void tk_string_copy(uptr dst, uptr src, i64 n) {
    i64 i = 0;
    loop {
        if (i >= n) break;
        st8(dst + i, ld8(src + i));
        i = i + 1;
    }
}

// the number of UTF-8 lead bytes in `nbytes` bytes at `buf` -- a byte whose
// top two bits are not `10` starts a code point, so counting them is a
// one-pass substitute for a full decode (§ 6's own O(1)-at-construction
// argument)
i64 tk_string_utf8count(uptr buf, i64 nbytes) {
    i64 n = 0;
    i64 i = 0;
    loop {
        if (i >= nbytes) break;
        if ((ld8(buf + i) & 192) != 128) n = n + 1;
        i = i + 1;
    }
    return n;
}

// N8, § 7: ASCII whitespace -- space, tab, LF, CR, VT, FF -- the byte set
// `.Trim*` strips (§ 10's own "ASCII only" divergence from C#'s Unicode
// `char.IsWhiteSpace`)
i64 tk_string_is_ws(i64 b) {
    if (b == 32) return 1;
    if (b == 9) return 1;
    if (b == 10) return 1;
    if (b == 13) return 1;
    if (b == 11) return 1;
    if (b == 12) return 1;
    return 0;
}

public class string {
    private i64  nbytes;
    private i64  nchars;
    private uptr data;
    private i64  owned;

    // rule 4: the one constructor N7a teaches, `new string(raw)` -- measures
    // `raw` with `tk_str_len` and COPIES it, so the source `str` may be
    // mutated or released afterwards with no effect on this object
    // the no-argument form: `new string()` is the EMPTY string, never a
    // zeroed object. teko's allocator hands out a zeroed object for any
    // class that declares no parameterless constructor (`tk_allocators`,
    // teko_class.tk), and every member here dereferences `data` -- so the
    // class declares one and makes it `Empty`. C# has no `new string()`
    // at all; teko cannot refuse the form per class today (D86), so the
    // safe value is the answer, not a null pointer.
    public string() {
        nbytes = 0;
        data = rt_alloc(1);
        st8(data, 0);
        nchars = 0;
        owned = 1;
    }

    public string(str raw) {
        nbytes = tk_str_len(raw);
        data = rt_alloc(nbytes + 1);
        tk_string_copy(data, raw, nbytes);
        st8(data + nbytes, 0);
        nchars = tk_string_utf8count(data, nbytes);
        owned = 1;
    }

    ~string() {
        if (owned) rt_free(data, nbytes + 1);
    }

    // § 6: the number of CODE POINTS, O(1), stored -- teko's `char` is a
    // scalar code point and not a UTF-16 unit, so this is C#'s `Length`
    // MEANING kept and its UNITS stated (both numbers exposed, both O(1))
    public i64 Length { get => nchars; }

    // not a C# member: the byte count every `extern` wants, which would
    // otherwise be a walk (§ 6)
    public i64 Utf8Length { get => nbytes; }

    // § 7: identity in C#'s sense -- the same bytes, no work done to answer
    // it. `return this;` is not written here: a bare `this` used as a VALUE
    // (as opposed to the receiver of `this.field`) types as `uptr`, not as
    // the enclosing class (`teko_class.tk`'s `this` parameter is declared
    // `param_new(TY_UPTR, ...)`, and no bare-`this` expression node is ever
    // re-typed against it -- measured, not this crumb's to fix, and reported
    // as an adjacent finding). A fresh copy of the same bytes answers the
    // same observable contract with no compiler change.
    public string ToString() { return new string(data); }

    // by value: the same bytes, NUL for NUL, `tk_str_eq` (`lib/rt.tk`)
    // unchanged and reused
    public i64 Equals(string other) {
        return tk_str_eq(data, other.data);
    }

    // ordinal over UTF-8 BYTES (unsigned): the first byte that differs
    // decides, and a common prefix loses to the shorter string. That is
    // code-point order, which is C#'s `String.CompareOrdinal` order except
    // where a non-BMP code point meets one in U+E000..U+FFFF (UTF-16 sorts
    // the surrogate first) -- docs/specs/string.md § 6, D86.
    public i64 CompareTo(string other) {
        i64 n = nbytes;
        if (other.nbytes < n) n = other.nbytes;
        i64 i = 0;
        loop {
            if (i >= n) break;
            i64 ca = ld8(data + i);
            i64 cb = ld8(other.data + i);
            if (ca != cb) return ca - cb;
            i = i + 1;
        }
        return nbytes - other.nbytes;
    }

    // djb2 over the bytes -- no C# guarantee to match, only the one this
    // class itself promises: equal values hash equal
    public i64 GetHashCode() {
        i64 h = 5381;
        i64 i = 0;
        loop {
            if (i >= nbytes) break;
            h = h * 33 + ld8(data + i);
            i = i + 1;
        }
        return h;
    }

    // concatenation, § 8: a scratch buffer built and freed around the one
    // constructor this class has, so the result is an ordinary owned
    // `string` and no second construction road is opened
    public static string operator+(string a, string b) {
        i64 total = a.nbytes + b.nbytes;
        uptr buf = rt_alloc(total + 1);
        tk_string_copy(buf, a.data, a.nbytes);
        tk_string_copy(buf + a.nbytes, b.data, b.nbytes);
        st8(buf + total, 0);
        string r = new string(buf);
        rt_free(buf, total + 1);
        return r;
    }

    // by value, § 8; `a == null` and `null == a` never reach this row (see
    // the header note on D43)
    public static i64 operator==(string a, string b) {
        return tk_str_eq(a.data, b.data);
    }

    public static i64 operator!=(string a, string b) {
        return !(a == b);
    }

    // C#'s three statics this crumb owes (§ 7); `Join` and the method half
    // of the surface are N8's
    public static string Empty { get { return new string(""); } }

    public static string Concat(string a, string b) {
        return a + b;
    }

    // D43 widens the parameter to `string?`: C#'s own `IsNullOrEmpty` takes
    // a possibly-null string, and a non-nullable `string` parameter here
    // would refuse the call `null` itself needs to reach
    public static i64 IsNullOrEmpty(string? s) {
        if (s == null) return 1;
        if (s.Value.Utf8Length == 0) return 1;
        return 0;
    }

    // ---- N8 (docs/specs/string.md § 7, D89): the method surface. Every one
    // is an ORDINARY member -- teko_class.tk/teko_prop.tk taught nothing new
    // to reach any of them (§ 12), and private-field access across two
    // instances of the SAME class (`other.data`, already N7a's own `Equals`)
    // is the mechanism `Join`, `Replace` and the two-operand searches below
    // all reuse. Ordinal everywhere -- no culture, C#'s own `String.Compare`
    // with `StringComparison.Ordinal` -- and every one returns a NEW string
    // or an existing one; nothing mutates (§ 7's own sentence).

    // the byte offset of the `n`-th BYTE range this class owns, at RUN time,
    // used by every method below that returns a byte-contiguous slice
    private string SliceBytes(i64 b0, i64 blen) {
        uptr buf = rt_alloc(blen + 1);
        tk_string_copy(buf, data + b0, blen);
        st8(buf + blen, 0);
        string r = new string(buf);
        rt_free(buf, blen + 1);
        return r;
    }

    // the byte offset of the `ci`-th CODE POINT -- `O(1)` on an ASCII
    // string (the same fast path `tk_string_at` takes above), `O(ci)`
    // otherwise. `ci == nchars` is legal and answers `nbytes`, the "one past
    // the end" address every `Substring` call needs for its own last slice.
    private i64 ByteOf(i64 ci) {
        if (nbytes == nchars) return ci;
        i64 boff = 0;
        i64 c = 0;
        loop {
            if (c >= ci) break;
            boff = boff + tk_string_utf8_width(ld8(data + boff));
            c = c + 1;
        }
        return boff;
    }

    // the byte offset of the first occurrence of `needle`'s own bytes at or
    // after byte `from`, or `-1`. UTF-8 SELF-SYNCHRONIZES: a continuation
    // byte (`10xxxxxx`) can never open a lead byte's own bit pattern, so a
    // byte-for-byte match of two valid UTF-8 strings can never land off a
    // code-point boundary -- a byte search answers the code-point question
    // with no decode at all. An empty needle matches AT `from` (C#'s own
    // `IndexOf("")` rule), never past `nbytes`.
    private i64 ByteFind(uptr needle, i64 nlen, i64 from) {
        if (nlen == 0) {
            if (from > nbytes) return 0 - 1;
            return from;
        }
        i64 i = from;
        loop {
            if (i + nlen > nbytes) return 0 - 1;
            i64 j = 0;
            i64 ok = 1;
            loop {
                if (j >= nlen) break;
                if (ld8(data + i + j) != ld8(needle + j)) { ok = 0; break; }
                j = j + 1;
            }
            if (ok) return i;
            i = i + 1;
        }
    }

    // the CODE-POINT index the byte offset `boff` falls at -- the inverse of
    // `ByteOf`, walked the same one-pass way
    private i64 CpIndexOfByte(i64 boff) {
        if (nbytes == nchars) return boff;
        i64 c = 0;
        i64 b = 0;
        loop {
            if (b >= boff) break;
            b = b + tk_string_utf8_width(ld8(data + b));
            c = c + 1;
        }
        return c;
    }

    // `.Substring(i64)`, `.Substring(i64, i64)` -- indices are CODE POINTS
    // (D89 ruling 3, matching `.Length`); out of range panics the same
    // wording `s[i]` does, § 6's own guard extended to a range
    public string Substring(i64 start) {
        return Substring(start, nchars - start);
    }

    public string Substring(i64 start, i64 len) {
        if (start < 0 || start > nchars) panic("string index out of range");
        if (len < 0 || start + len > nchars) panic("string index out of range");
        i64 b0 = ByteOf(start);
        i64 b1 = ByteOf(start + len);
        return SliceBytes(b0, b1 - b0);
    }

    // `.IndexOf(string)` -- `-1` when not found, a CODE-POINT index otherwise
    public i64 IndexOf(string needle) {
        i64 b = ByteFind(needle.data, needle.nbytes, 0);
        if (b < 0) return 0 - 1;
        return CpIndexOfByte(b);
    }

    // `IndexOfChar` -- § 7's own `.IndexOf(char)` row, one code point
    // rather than a `string`, decoded as the walk passes it so no needle is
    // allocated for a scalar search. NOT spelled `IndexOf(char c)`: a class
    // METHOD is resolved by name-and-ARITY alone (`tk_method_pick`,
    // teko_class.tk, its own header -- "-3: two do, and only the argument
    // TYPES could tell them apart, which is what a module cannot ask the
    // core about mid-body"), unlike a free function's `teko_over.tk`, which
    // runs its own later pass over the whole unit's closed declarations
    // exactly to answer that question. `IndexOf(string)` already claims
    // arity 1, so a second signature at the same arity is genuinely
    // ambiguous today (measured: `teko: ambiguous overload; two signatures
    // take this many arguments: IndexOf`) -- extending method dispatch to
    // read argument types is real machinery this crumb's own module table
    // does not list (`teko_class.tk` stays untouched, docs/specs/string.md
    // § 12), so the two searches keep their own names instead of teaching
    // the core a new capability to reach one more overload.
    public i64 IndexOfChar(char c) {
        i64 i = 0;
        i64 boff = 0;
        loop {
            if (i >= nchars) return 0 - 1;
            i64 w = tk_string_utf8_width(ld8(data + boff));
            if (tk_string_cp_decode(data, boff, w, nbytes) == c) return i;
            boff = boff + w;
            i = i + 1;
        }
    }

    // `.LastIndexOf(string)` -- the LAST occurrence, found by repeating
    // `ByteFind` past every hit; there is no C standard-library backward
    // search over UTF-8 to fall back to, so this is the same forward
    // primitive walked to exhaustion rather than a second one
    public i64 LastIndexOf(string needle) {
        i64 best = 0 - 1;
        i64 from = 0;
        loop {
            i64 b = ByteFind(needle.data, needle.nbytes, from);
            if (b < 0) break;
            best = b;
            from = b + 1;
        }
        if (best < 0) return 0 - 1;
        return CpIndexOfByte(best);
    }

    public i64 Contains(string needle) {
        return ByteFind(needle.data, needle.nbytes, 0) >= 0;
    }

    public i64 StartsWith(string prefix) {
        if (prefix.nbytes > nbytes) return 0;
        i64 j = 0;
        loop {
            if (j >= prefix.nbytes) break;
            if (ld8(data + j) != ld8(prefix.data + j)) return 0;
            j = j + 1;
        }
        return 1;
    }

    public i64 EndsWith(string suffix) {
        if (suffix.nbytes > nbytes) return 0;
        i64 off = nbytes - suffix.nbytes;
        i64 j = 0;
        loop {
            if (j >= suffix.nbytes) break;
            if (ld8(data + off + j) != ld8(suffix.data + j)) return 0;
            j = j + 1;
        }
        return 1;
    }

    // `.Trim*` -- ASCII whitespace only (space, tab, LF, CR, VT, FF): a
    // divergence from C#'s Unicode-aware `char.IsWhiteSpace`, stated rather
    // than hidden (§ 10, the same "ASCII only" C# itself never had to say for
    // `Trim` but does here alongside `ToUpper`/`ToLower`)
    public string TrimStart() {
        i64 i = 0;
        loop {
            if (i >= nbytes) break;
            if (!tk_string_is_ws(ld8(data + i))) break;
            i = i + 1;
        }
        return SliceBytes(i, nbytes - i);
    }

    public string TrimEnd() {
        i64 j = nbytes;
        loop {
            if (j <= 0) break;
            if (!tk_string_is_ws(ld8(data + j - 1))) break;
            j = j - 1;
        }
        return SliceBytes(0, j);
    }

    public string Trim() {
        return TrimStart().TrimEnd();
    }

    // `.ToUpper()`, `.ToLower()` -- ASCII only (§ 10): a byte outside
    // `'A'..'Z'`/`'a'..'z'` passes through unchanged, which is correct for
    // every ASCII byte and honest about every one that is not
    public string ToUpper() {
        uptr buf = rt_alloc(nbytes + 1);
        i64 i = 0;
        loop {
            if (i >= nbytes) break;
            i64 b = ld8(data + i);
            if (b >= 'a' && b <= 'z') b = b - 32;
            st8(buf + i, b);
            i = i + 1;
        }
        st8(buf + nbytes, 0);
        string r = new string(buf);
        rt_free(buf, nbytes + 1);
        return r;
    }

    public string ToLower() {
        uptr buf = rt_alloc(nbytes + 1);
        i64 i = 0;
        loop {
            if (i >= nbytes) break;
            i64 b = ld8(data + i);
            if (b >= 'A' && b <= 'Z') b = b + 32;
            st8(buf + i, b);
            i = i + 1;
        }
        st8(buf + nbytes, 0);
        string r = new string(buf);
        rt_free(buf, nbytes + 1);
        return r;
    }

    // `.Replace(string, string)` -- two passes over the SAME `ByteFind`: the
    // first sizes the result exactly (this project's allocator has no
    // resizable tail, § 1), the second builds it. An empty search value
    // replaces nothing and answers a copy unchanged -- C# throws on it, teko
    // has no exceptions to throw, and "nothing to replace" is the honest
    // reading of the same input (stated here rather than silently matching
    // C#'s `ArgumentException`).
    public string Replace(string oldS, string newS) {
        if (oldS.nbytes == 0) return new string(data);
        i64 count = 0;
        i64 pos = 0;
        loop {
            i64 b = ByteFind(oldS.data, oldS.nbytes, pos);
            if (b < 0) break;
            count = count + 1;
            pos = b + oldS.nbytes;
        }
        if (count == 0) return new string(data);
        i64 outlen = nbytes + count * (newS.nbytes - oldS.nbytes);
        uptr buf = rt_alloc(outlen + 1);
        i64 w = 0;
        pos = 0;
        loop {
            i64 b = ByteFind(oldS.data, oldS.nbytes, pos);
            if (b < 0) break;
            tk_string_copy(buf + w, data + pos, b - pos);
            w = w + (b - pos);
            tk_string_copy(buf + w, newS.data, newS.nbytes);
            w = w + newS.nbytes;
            pos = b + oldS.nbytes;
        }
        tk_string_copy(buf + w, data + pos, nbytes - pos);
        w = w + (nbytes - pos);
        st8(buf + w, 0);
        string r = new string(buf);
        rt_free(buf, outlen + 1);
        return r;
    }

    // `.Split(char)` -- a `string[]` of counted elements (`T[]` of heap
    // already releases them, docs/reference/arrays.md); the separator is
    // decoded per code point, exactly as `IndexOf(char)` above, so a
    // multi-byte separator splits at the right BYTE boundary too
    public string[] Split(char sep) {
        i64 n = 1;
        i64 boff = 0;
        loop {
            if (boff >= nbytes) break;
            i64 w = tk_string_utf8_width(ld8(data + boff));
            if (tk_string_cp_decode(data, boff, w, nbytes) == sep) n = n + 1;
            boff = boff + w;
        }
        string[] parts = new string[n];
        i64 start = 0;
        i64 k = 0;
        boff = 0;
        loop {
            if (boff >= nbytes) break;
            i64 w = tk_string_utf8_width(ld8(data + boff));
            if (tk_string_cp_decode(data, boff, w, nbytes) == sep) {
                parts[k] = SliceBytes(start, boff - start);
                k = k + 1;
                start = boff + w;
            }
            boff = boff + w;
        }
        parts[k] = SliceBytes(start, nbytes - start);
        return parts;
    }

    // `.PadLeft(i64)`, `.PadRight(i64)` -- padded with ASCII spaces to
    // `width` CODE POINTS (matching `.Length`); a string already that long
    // or longer comes back unchanged
    public string PadLeft(i64 width) {
        if (nchars >= width) return new string(data);
        i64 pad = width - nchars;
        uptr buf = rt_alloc(nbytes + pad + 1);
        i64 i = 0;
        loop {
            if (i >= pad) break;
            st8(buf + i, 32);
            i = i + 1;
        }
        tk_string_copy(buf + pad, data, nbytes);
        st8(buf + pad + nbytes, 0);
        string r = new string(buf);
        rt_free(buf, nbytes + pad + 1);
        return r;
    }

    public string PadRight(i64 width) {
        if (nchars >= width) return new string(data);
        i64 pad = width - nchars;
        uptr buf = rt_alloc(nbytes + pad + 1);
        tk_string_copy(buf, data, nbytes);
        i64 i = 0;
        loop {
            if (i >= pad) break;
            st8(buf + nbytes + i, 32);
            i = i + 1;
        }
        st8(buf + nbytes + pad, 0);
        string r = new string(buf);
        rt_free(buf, nbytes + pad + 1);
        return r;
    }

    // `string.Join(sep, parts)` -- the static half of § 7's N8 row, over a
    // `string[]` (`.Length` and `[i]` both the ordinary `T[]` of heap
    // mechanism, no special case for the element being `string` itself)
    public static string Join(string sep, string[] parts) {
        i64 n = parts.Length;
        if (n == 0) return new string("");
        i64 total = 0;
        i64 i = 0;
        loop {
            if (i >= n) break;
            total = total + parts[i].nbytes;
            if (i > 0) total = total + sep.nbytes;
            i = i + 1;
        }
        uptr buf = rt_alloc(total + 1);
        i64 w = 0;
        i = 0;
        loop {
            if (i >= n) break;
            if (i > 0) {
                tk_string_copy(buf + w, sep.data, sep.nbytes);
                w = w + sep.nbytes;
            }
            tk_string_copy(buf + w, parts[i].data, parts[i].nbytes);
            w = w + parts[i].nbytes;
            i = i + 1;
        }
        st8(buf + total, 0);
        string r = new string(buf);
        rt_free(buf, total + 1);
        return r;
    }
}

// ---- N10 (docs/specs/string.md § 9): the two formatters `$"..."` reaches
// for a hole `teko_interp.tk` cannot build directly from the class's own
// `str` constructor (an integer's decimal text, a `char`'s UTF-8 bytes) ----

// the UTF-8 bytes of ONE code point, into `buf` (needs 4 bytes); returns the
// width written. The inverse of `tk_string_cp_decode` above, and kept beside
// it for the same reason that one is kept here rather than in `lib/rt.tk`:
// a line added to `rt.tk` moves the `--dump-ast` include chain of every
// fixture in the tree.
i64 tk_string_cp_encode(uptr buf, i64 cp) {
    if (cp < 128) { st8(buf, cp); return 1; }
    if (cp < 2048) {
        st8(buf, 192 | (cp >> 6));
        st8(buf + 1, 128 | (cp & 63));
        return 2;
    }
    if (cp < 65536) {
        st8(buf, 224 | (cp >> 12));
        st8(buf + 1, 128 | ((cp >> 6) & 63));
        st8(buf + 2, 128 | (cp & 63));
        return 3;
    }
    st8(buf, 240 | (cp >> 18));
    st8(buf + 1, 128 | ((cp >> 12) & 63));
    st8(buf + 2, 128 | ((cp >> 6) & 63));
    st8(buf + 3, 128 | (cp & 63));
    return 4;
}

// an `i64` hole (and, through the call-argument widening every other
// integer already gets, `u8`/`i8`/`u16`/`i16`/`u32`/`u64` too): the decimal
// text `tk_i64_to_dec` (`lib/rt.tk`) already writes, on the STACK -- no
// `rt_alloc`, so no free for this one to forget (§ 9's decision 4).
string tk_str_from_i64(i64 v) {
    u8 buf[24];
    tk_i64_to_dec(v, buf);
    return new string(buf);
}

// a `char` hole: its UTF-8 bytes, on the stack, NUL-terminated for the
// class's own `str` constructor to measure.
string tk_str_from_char(char c) {
    u8 buf[5];
    i64 n = tk_string_cp_encode(buf, c);
    st8(buf + n, 0);
    return new string(buf);
}

// a `u64` hole. `tk_i64_to_dec` (`lib/rt.tk`) peels its digits with SIGNED
// `/` and `%`, so every value at or above 2^63 comes out as its negative
// twin -- `$"{(u64) 9223372036854775808}"` answered `-9223372036854775808`
// where C# answers `9223372036854775808`. mc's own `/` and `%` are unsigned
// when BOTH operands are (measured on the pin: `18446744073709551615 / 10`
// is `1844674407370955161`), so the fix is one peel loop of its own on a
// `u64` parameter -- no cast back down to `i64` anywhere in it, and no
// change to `tk_i64_to_dec`, which every signed caller still wants as it is.
// `u8`/`u16` are unsigned too but widen into `i64` with room to spare, so
// they keep the signed formatter; `u32` is `char`'s own id (D92's type
// erasure) and goes to `tk_str_from_char` instead. On the stack, so no
// `rt_alloc` and no free to forget (§ 9's decision 4).
string tk_str_from_u64(u64 v) {
    u8 tmp[24];
    u8 buf[24];
    i64 i = 24;
    loop {
        i = i - 1;
        st8(tmp + i, '0' + v % 10);
        v = v / 10;
        if (v == 0) break;
    }
    i64 n = 0;
    while (i < 24) {
        st8(buf + n, ld8(tmp + i));
        n = n + 1;
        i = i + 1;
    }
    st8(buf + n, 0);
    return new string(buf);
}
