// guid.tk -- `Guid`'s own sixteen bytes: the two copy helpers every wide type
// owes, the buffer its RETURN travels through, and the parser, the formatter
// and the byte comparison the surface reaches through `teko_guid.tk`'s rows.
// Program code, not compiler code: `#include "guid.tk"` from the `.tk` source
// itself, exactly as `rt.tk`, `time.tk` and `decimal.tk` are included
// (docs/reference/runtime.md).
//
// N3 of docs/specs/guid.md (§ 1, § 3, § 4) and D75. It needs `rt.tk` for
// `rt_alloc` and for `rt_panic`; `#include "rt.tk"` ahead of this file.
//
// THE SIXTEEN BYTES ARE IN TEXT ORDER (§ 1), big-endian, byte 0 first:
//
//   +0 .. +3    time_low               the first group, 8 hex digits
//   +4 .. +5    time_mid               the second, 4
//   +6 .. +7    time_hi_and_version    the third, 4
//   +8 .. +9    clock_seq              the fourth, 4
//   +10 .. +15  node                   the fifth, 12
//
// which is RFC 4122's own order, so `ToString` is a straight walk from byte 0
// to byte 15 and `Parse` its inverse. It is NOT C#'s in-memory order, and the
// one place the difference is visible is the ORDERING: teko compares the
// sixteen bytes unsigned, left to right -- the order the text sorts in --
// where C# compares its first three fields as signed integers (§ 1, § 6, a
// recorded divergence).

// The return buffer (docs/specs/decimal.md § 1, "a return"; D75's fourth wide
// column). A function that returns a `Guid` copies its sixteen bytes here and
// returns the ADDRESS of this global; the call site copies them out into the
// call depth's own slot immediately after the branch, which is what makes ONE
// buffer safe under recursion and under nesting (`tw_call`/`tw_ret`,
// teko_wide.tk). It is per TYPE and not per program: a source that returns a
// `Guid` without this include is refused by name
// (`teko: include "guid.tk" before returning a sixteen-byte value`).
Guid tk_guid_retbuf;

// The field road and the array-element road, and since D75 the `ref`/`out`
// pointee's as well: two `ld64`/`st64` pairs over the address of the sixteen
// bytes, which is what `tk_ldn`/`tk_stn` (teko_struct.tk) lower every indirect
// access of this type to. `&g` on a local or on a parameter of `Guid` type is
// the address of its own frame slot -- the core's own `MTASK_LOCAL_ADDR`,
// untouched by the wide machine -- so no accessor and no intrinsic is needed.
Guid tk_guid_ld(ptr p) {
    Guid g;
    ptr q = &g;
    st64(q, ld64(p));
    st64(q + 8, ld64(p + 8));
    return g;
}

void tk_guid_st(ptr p, Guid g) {
    ptr q = &g;
    st64(p, ld64(q));
    st64(p + 8, ld64(q + 8));
}

// ---- the all-zero value (§ 4) ----
// A frame slot is not zeroed, so `Guid.Empty` writes both halves rather than
// declaring a local and hoping.
Guid tk_guid_empty() {
    Guid g;
    ptr q = &g;
    st64(q, 0);
    st64(q + 8, 0);
    return g;
}

i64 tk_guid_isempty(Guid g) {
    ptr q = &g;
    if (ld64(q) != 0) return 0;
    if (ld64(q + 8) != 0) return 0;
    return 1;
}

// ---- text (§ 4) ----
// the value of one hex digit, either case, or -1
i64 tk_guid_hexval(i64 c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return 0 - 1;
}

// ...and the digit a nibble prints as, LOWERCASE, which is C#'s own casing for
// every format it writes
i64 tk_guid_hexdig(i64 v) {
    if (v < 10) return '0' + v;
    return 'a' + v - 10;
}

// the four positions a hyphen sits at in the "D" form, `8-4-4-4-12`: after
// bytes 4, 6, 8 and 10 of the sixteen
i64 tk_guid_dashes(i64 i) {
    if (i == 4) return 1;
    if (i == 6) return 1;
    if (i == 8) return 1;
    if (i == 10) return 1;
    return 0;
}

// `g` into `buf`, NUL-terminated, returning the length: 36 characters with
// `dash`, 32 without. `buf` needs one more byte than that for the terminator
// (37 and 33). This is the allocation-free half, the split `<float>` makes
// between `putf64` and `fmt_f64` (§ 4).
i64 tk_guid_fmt(ptr buf, Guid g, i64 dash) {
    ptr q = &g;
    i64 i = 0;
    i64 k = 0;
    loop {
        if (i >= 16) break;
        if (dash && tk_guid_dashes(i)) {
            st8(buf + k, '-');
            k = k + 1;
        }
        i64 b = ld8(q + i);
        st8(buf + k, tk_guid_hexdig((b >> 4) & 15));
        st8(buf + k + 1, tk_guid_hexdig(b & 15));
        k = k + 2;
        i = i + 1;
    }
    st8(buf + k, 0);
    return k;
}

// `.ToString()`, the "D" form. The buffer is heap-owned and the caller keeps
// it past this call's own return, exactly as `tk_enum_digits` (lib/rt.tk)
// hands one back: `str` is a `uptr` with a NUL terminator and no `string`
// object exists yet.
str tk_guid_tostring(Guid g) {
    uptr buf = rt_alloc(37);
    tk_guid_fmt(buf, g, 1);
    return buf;
}

// `.ToString(fmt)`: `"D"` and `"N"`, either case, and nothing else. `"B"`,
// `"P"` and `"X"` are three more spellings of the same sixteen bytes and are
// not taught (§ 6), so a format outside the pair is a panic where it is
// written rather than a silent "D".
str tk_guid_tostring_fmt(Guid g, str f) {
    i64 c = ld8(f);
    if (ld8(f + 1) != 0) rt_panic("the Guid format is not taught");
    if (c == 'D' || c == 'd') {
        uptr buf = rt_alloc(37);
        tk_guid_fmt(buf, g, 1);
        return buf;
    }
    if (c == 'N' || c == 'n') {
        uptr buf = rt_alloc(33);
        tk_guid_fmt(buf, g, 0);
        return buf;
    }
    rt_panic("the Guid format is not taught");
    return 0;
}

// the sixteen bytes of `s` into `p`, or 0 -- the inverse of `tk_guid_fmt`.
// Both forms `Parse` accepts (§ 4): the 36-character "D" with its four
// hyphens, and the 32-character "N" without them, either case. A hyphen in
// the wrong place, a character that is no hex digit and any other length are
// all the same answer, which is what makes `TryParse` a single question.
i64 tk_guid_scan(ptr p, str s) {
    i64 n = tk_str_len(s);
    i64 dash = 0;
    if (n == 36) dash = 1;
    else if (n != 32) return 0;
    i64 i = 0;
    i64 k = 0;
    loop {
        if (i >= 16) break;
        if (dash && tk_guid_dashes(i)) {
            if (ld8(s + k) != '-') return 0;
            k = k + 1;
        }
        i64 hi = tk_guid_hexval(ld8(s + k));
        i64 lo = tk_guid_hexval(ld8(s + k + 1));
        if (hi < 0) return 0;
        if (lo < 0) return 0;
        st8(p + i, hi * 16 + lo);
        k = k + 2;
        i = i + 1;
    }
    return 1;
}

// `Guid.Parse(s)`: the value, or a panic (exit 70) -- C#'s own `Parse`, whose
// failure is an exception and not a sentinel `Guid` no caller could tell from
// a parsed one
Guid tk_guid_parse(str s) {
    Guid g;
    ptr q = &g;
    st64(q, 0);
    st64(q + 8, 0);
    if (!tk_guid_scan(q, s)) rt_panic("the string is not a Guid");
    return g;
}

// `Guid.TryParse(s, out g)`: 1 and the value, or 0 and `Guid.Empty` -- C#'s
// pair. `o` is the caller's own slot, reached as a plain address the way
// `tk_enum_tryparse64` (lib/rt.tk) already reaches one, so the sixteen bytes
// are written here by hand rather than through a `Guid` return.
i64 tk_guid_tryparse(str s, uptr o) {
    Guid g;
    ptr q = &g;
    st64(q, 0);
    st64(q + 8, 0);
    if (!tk_guid_scan(q, s)) {
        st64(o, 0);
        st64(o + 8, 0);
        return 0;
    }
    st64(o, ld64(q));
    st64(o + 8, ld64(q + 8));
    return 1;
}

// ---- the ordering (§ 1, § 3) ----
// The sixteen bytes, UNSIGNED, left to right, stopping at the first
// difference: the order the text sorts in. `ld8` is a zero-extending read of
// one byte (mc language.md § 2), so no sign ever enters the comparison.
i64 tk_guid_cmp(Guid a, Guid b) {
    ptr p = &a;
    ptr q = &b;
    i64 i = 0;
    loop {
        if (i >= 16) break;
        i64 x = ld8(p + i);
        i64 y = ld8(q + i);
        if (x < y) return 0 - 1;
        if (x > y) return 1;
        i = i + 1;
    }
    return 0;
}

i64 tk_guid_eq(Guid a, Guid b) { return tk_guid_cmp(a, b) == 0; }
i64 tk_guid_ne(Guid a, Guid b) { return tk_guid_cmp(a, b) != 0; }
i64 tk_guid_lt(Guid a, Guid b) { return tk_guid_cmp(a, b) < 0; }
i64 tk_guid_le(Guid a, Guid b) { return tk_guid_cmp(a, b) <= 0; }
i64 tk_guid_gt(Guid a, Guid b) { return tk_guid_cmp(a, b) > 0; }
i64 tk_guid_ge(Guid a, Guid b) { return tk_guid_cmp(a, b) >= 0; }
