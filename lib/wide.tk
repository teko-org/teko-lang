// wide.tk -- `i128` and `u128`: the two copy helpers a sixteen-byte value
// needs, the buffer a sixteen-byte RETURN travels through, and the arithmetic
// every operator of the two types lowers to. Program code, not compiler code:
// `#include "wide.tk"` from the `.tk` source itself, exactly as `rt.tk`,
// `decimal.tk` and `guid.tk` are included (docs/reference/runtime.md).
//
// N6a of docs/specs/small-ints.md (§ 6, § 8, § 11) and D81. Everything here is
// ordinary teko over `lib/limbs.tk`'s eight 32-bit limbs -- the same vector
// `decimal` computes over, lifted for exactly this file -- so no leg needs a
// 128-bit instruction, `mc`'s bundled `<i128>` is not included (D81: it cannot
// coexist with `<float>`), and `mc limits`' `intrin` row does not move (D21).
//
// The representation is docs/specs/small-ints.md § 6's: sixteen bytes,
// sixteen-byte aligned, little-endian, the low half at `+0` and the high half
// at `+8`. `i128` and `u128` are THE SAME BITS and differ in exactly four
// places here -- `/` and the four ordering comparisons (D81), `%` (the
// remainder's sign) and `>>` (arithmetic against logical, D83) -- which is why
// the core below is written once over a vector and each type gets a four-line
// wrapper.
//
// N6b's `%`, `<<`, `>>`, `&`, `|`, `^`, `~` are here too (D83). What is still
// NOT here is the rest of N6b: `ToString`, `Parse`, `TryParse`, the members
// and the `decimal`/`f64` conversions (docs/reference/not-yet.md).
#include "limbs.tk"

// ---- the three declarations a wide type owes the PROGRAM ----
// The return buffer, one per TYPE (D75): a function returning an `i128` copies
// its sixteen bytes here and returns the ADDRESS of this global, and the call
// site copies them out into the call depth's own slot immediately after the
// branch, which is what makes ONE buffer safe under recursion and nesting
// (`tw_call`/`tw_ret`, teko_wide.tk).
i128 tk_i128_retbuf;
u128 tk_u128_retbuf;

// The field road and the array-element road: two `ld64`/`st64` pairs over the
// address of the sixteen bytes, which `tk_ldn`/`tk_stn` (teko_struct.tk) lower
// every indirect access of a wide type to -- no raw `ldW` moves sixteen bytes
// and the width table would answer `ld64` and move half the value in silence.
i128 tk_i128_ld(ptr p) {
    i128 v;
    ptr q = &v;
    st64(q, ld64(p));
    st64(q + 8, ld64(p + 8));
    return v;
}

void tk_i128_st(ptr p, i128 v) {
    ptr q = &v;
    st64(p, ld64(q));
    st64(p + 8, ld64(q + 8));
}

u128 tk_u128_ld(ptr p) {
    u128 v;
    ptr q = &v;
    st64(q, ld64(p));
    st64(q + 8, ld64(p + 8));
    return v;
}

void tk_u128_st(ptr p, u128 v) {
    ptr q = &v;
    st64(p, ld64(q));
    st64(p + 8, ld64(q + 8));
}

// ---- the two halves, and a value built out of them ----
// `&v` on a parameter of wide type is the address of its own frame slot, so
// each half is one `ld64` and no accessor, no member and no intrinsic is
// needed to reach it. The four below are what `tests/primitives_i128.tk`
// checks the layout with, and what every wrapper in this file is written over.
u64 tk_i128_lo(i128 v) { ptr p = &v; return ld64(p); }
u64 tk_i128_hi(i128 v) { ptr p = &v; return ld64(p + 8); }
u64 tk_u128_lo(u128 v) { ptr p = &v; return ld64(p); }
u64 tk_u128_hi(u128 v) { ptr p = &v; return ld64(p + 8); }

i128 tk_i128_of(u64 lo, u64 hi) {
    i128 v;
    ptr p = &v;
    st64(p, lo);
    st64(p + 8, hi);
    return v;
}

u128 tk_u128_of(u64 lo, u64 hi) {
    u128 v;
    ptr p = &v;
    st64(p, lo);
    st64(p + 8, hi);
    return v;
}

// ---- the core, over four of `lib/limbs.tk`'s eight limbs ----
// A 128-bit value is limbs 0..3; limbs 4..7 are the headroom a product and a
// long division need. Every operation that can overflow ends in `tk_w_mask`,
// which is the WRAP docs/specs/small-ints.md § 6 fixes: C#'s unchecked default,
// and the only behaviour there is, since teko has no `checked` word.
#define TK_W_NL 4

void tk_w_vec(u64 lo, u64 hi, uptr v) {
    tk_dv_zero(v);
    tk_dv_put(v, 0, lo & 0xffffffff);
    tk_dv_put(v, 1, (lo >> 32) & 0xffffffff);
    tk_dv_put(v, 2, hi & 0xffffffff);
    tk_dv_put(v, 3, (hi >> 32) & 0xffffffff);
}

u64 tk_w_lo(uptr v) { return tk_dv_at(v, 0) | (tk_dv_at(v, 1) << 32); }
u64 tk_w_hi(uptr v) { return tk_dv_at(v, 2) | (tk_dv_at(v, 3) << 32); }

// modulo 2^128: everything above limb 3 is dropped
void tk_w_mask(uptr v) {
    i64 i = TK_W_NL;
    loop {
        if (i >= TK_DEC_NL) break;
        tk_dv_put(v, i, 0);
        i = i + 1;
    }
}

// bit 127, the sign of an `i128`. It is read off limb 3 and never off a `u64`
// half, so no comparison in this file ever meets `mc`'s signed-`u64` defect.
i64 tk_w_isneg(uptr v) { return (tk_dv_at(v, 3) >> 31) & 1; }

// v = -v, modulo 2^128. `tk_dv_sub` drops the borrow out of the top limb,
// which is exactly two's complement: `-MinValue == MinValue` falls out of it
// and is asserted by `tests/primitives_i128_math.tk`.
void tk_w_neg(uptr v) {
    u64 z[TK_DEC_NL];
    tk_dv_zero(z);
    tk_dv_sub(z, v);
    tk_dv_copy(v, z);
    tk_w_mask(v);
}

// a += b, a -= b, a *= b -- all three modulo 2^128. The carry `tk_dv_add`
// guards is a value past 256 bits, which two 128-bit operands cannot form.
void tk_w_add(uptr a, uptr b) { tk_dv_add(a, b); tk_w_mask(a); }
void tk_w_sub(uptr a, uptr b) { tk_dv_sub(a, b); tk_w_mask(a); }

void tk_w_mul(uptr r, uptr a, uptr b) {
    tk_dv_mul(r, a, b);
    tk_w_mask(r);
}

// q = a / b, unsigned, truncating. The divisor is asked about FIRST, because
// `tk_dv_divmod` over a zero divisor would answer every bit set rather than
// fail: `teko: division by zero`, exit 70, the road every runtime guard in
// this project already takes (docs/reference/memory.md).
void tk_w_udiv(uptr q, uptr a, uptr b) {
    if (tk_dv_is_zero(b)) panic("division by zero");
    tk_dv_divmod(q, a, b);
    tk_w_mask(q);
}

// D82's own amendment to D81's ruling 3: `MinValue / -1` no longer wraps.
// Checked on the ORIGINAL operands, ahead of the magnitude split below (which
// disturbs neither): `MinValue` is bit 127 set and nothing else, `-1` is
// every bit set, both by the same limb layout `tk_w_isneg` already reads --
// the one 128-bit value whose OWN negation is a no-op (`tk_w_neg`'s header)
// divided by the one divisor whose magnitude is 1, exactly the pair every
// other integer width in this project already guards (`teko_ternary.tk`'s
// own `tk_div_guard`, D82).
i64 tk_w_sdiv_ovf(uptr a, uptr b) {
    return tk_dv_at(a, 0) == 0 && tk_dv_at(a, 1) == 0 && tk_dv_at(a, 2) == 0
        && tk_dv_at(a, 3) == 0x80000000
        && tk_dv_at(b, 0) == 0xffffffff && tk_dv_at(b, 1) == 0xffffffff
        && tk_dv_at(b, 2) == 0xffffffff && tk_dv_at(b, 3) == 0xffffffff;
}

// ...and the signed one: magnitudes, then the sign of the quotient. The
// operands are the caller's own scratch and are consumed.
void tk_w_sdiv(uptr q, uptr a, uptr b) {
    if (tk_w_sdiv_ovf(a, b)) panic("an integer division overflowed");
    i64 sa = tk_w_isneg(a);
    i64 sb = tk_w_isneg(b);
    if (sa) tk_w_neg(a);
    if (sb) tk_w_neg(b);
    tk_w_udiv(q, a, b);
    if (sa != sb) tk_w_neg(q);
}

// -1, 0 or 1, signed. The sign bits decide first and the limbs after them,
// which is what makes `-1i < 1i` true where a raw limb compare says otherwise.
i64 tk_w_scmp(uptr a, uptr b) {
    i64 sa = tk_w_isneg(a);
    i64 sb = tk_w_isneg(b);
    if (sa != sb) {
        if (sa) return 0 - 1;
        return 1;
    }
    return tk_dv_cmp(a, b);
}

// a %= b, unsigned: `tk_dv_divmod` already leaves the remainder in `a`
// (`lib/limbs.tk`), so `tk_w_udiv`'s own zero guard is all a plain remainder
// needs -- the quotient it also computes has nowhere else to live and is
// simply not read back.
void tk_w_umod(uptr a, uptr b) {
    u64 q[TK_DEC_NL];
    tk_w_udiv(q, a, b);
}

// a %= b, signed: the sign follows the DIVIDEND alone (C#'s own rule for
// `%`, unlike `/`'s `sa != sb` on the quotient) -- truncating division keeps
// `a == (a/b)*b + a%b`, which only the dividend's own sign on the remainder
// satisfies. `tk_w_sdiv_ovf` is read unchanged: the one quotient `i128.MinValue
// % -1i` would need is the one value the width cannot hold, exactly D82's
// ruling 7, which named `%` as a row this crumb still owed.
void tk_w_smod(uptr a, uptr b) {
    if (tk_w_sdiv_ovf(a, b)) panic("an integer division overflowed");
    i64 sa = tk_w_isneg(a);
    i64 sb = tk_w_isneg(b);
    if (sa) tk_w_neg(a);
    if (sb) tk_w_neg(b);
    u64 q[TK_DEC_NL];
    tk_w_udiv(q, a, b);
    if (sa) tk_w_neg(a);
}

// ---- bitwise: `& | ^ ~`, the SAME bits for `i128` and `u128` (D81's own
// header: the two types differ in `/` and the four orderings and in nothing
// else, and bitwise joins neither list). Limbs 4..7 are already zero
// (`tk_w_vec`'s own zeroing), so `& | ^` never touch them; `~` alone needs
// the mask afterward to keep them that way.
void tk_w_and(uptr a, uptr b) {
    i64 i = 0;
    loop {
        if (i >= TK_W_NL) break;
        tk_dv_put(a, i, tk_dv_at(a, i) & tk_dv_at(b, i));
        i = i + 1;
    }
}

void tk_w_or(uptr a, uptr b) {
    i64 i = 0;
    loop {
        if (i >= TK_W_NL) break;
        tk_dv_put(a, i, tk_dv_at(a, i) | tk_dv_at(b, i));
        i = i + 1;
    }
}

void tk_w_xor(uptr a, uptr b) {
    i64 i = 0;
    loop {
        if (i >= TK_W_NL) break;
        tk_dv_put(a, i, tk_dv_at(a, i) ^ tk_dv_at(b, i));
        i = i + 1;
    }
}

void tk_w_not(uptr v) {
    i64 i = 0;
    loop {
        if (i >= TK_W_NL) break;
        tk_dv_put(v, i, (~tk_dv_at(v, i)) & 0xffffffff);
        i = i + 1;
    }
}

// ---- shifts: `<<` and the two `>>`s (D83) ----
// `n` is already masked to its low 7 bits by the WRAPPER below, never here:
// a shift count reaches the operator table as the SAME wide type as the
// value (`tk_ops_promote`'s wide arm runs first, teko_ops.tk, so a `(t,
// TY_I64)` row would never fire), and .NET's own `Int128`/`UInt128` shift
// operators mask their amount to 7 bits the same way -- a negative count
// falls out under the mask exactly as a count past 127 does.
//
// Both cores below shift the WHOLE eight-limb scratch, not just the four
// live limbs: a left shift's overflow lands in limbs 4..7, where
// `tk_w_mask` already drops it, the same wrap every other operator ends in.
// `n` is never negative and never above 127, so every limb index below
// stays in range unchecked.
void tk_w_shl(uptr v, u64 n) {
    u64 r[TK_DEC_NL];
    u64 limbs = n / 32;
    u64 bits = n % 32;
    i64 i = TK_DEC_NL - 1;
    loop {
        if (i < 0) break;
        i64 src = i - limbs;
        u64 hi = 0;
        if (src >= 0) hi = tk_dv_at(v, src);
        u64 lo = 0;
        if (bits != 0 && src > 0) lo = tk_dv_at(v, src - 1);
        u64 x = hi;
        if (bits != 0) x = (hi << bits) | (lo >> (32 - bits));
        tk_dv_put(r, i, x & 0xffffffff);
        i = i - 1;
    }
    tk_dv_copy(v, r);
    tk_w_mask(v);
}

// LOGICAL right shift: fills from the top with zero, which is what a
// right-shifted limb 4..7 already holds -- `u128`'s own shift, and the
// second half of `i128`'s arithmetic one below.
void tk_w_shr(uptr v, u64 n) {
    u64 r[TK_DEC_NL];
    u64 limbs = n / 32;
    u64 bits = n % 32;
    i64 i = 0;
    loop {
        if (i >= TK_DEC_NL) break;
        i64 src = i + limbs;
        u64 lo = 0;
        if (src < TK_DEC_NL) lo = tk_dv_at(v, src);
        u64 hi = 0;
        if (bits != 0 && src + 1 < TK_DEC_NL) hi = tk_dv_at(v, src + 1);
        u64 x = lo;
        if (bits != 0) x = (lo >> bits) | (hi << (32 - bits));
        tk_dv_put(r, i, x & 0xffffffff);
        i = i + 1;
    }
    tk_dv_copy(v, r);
    tk_w_mask(v);
}

// ARITHMETIC right shift, `i128`'s own: limbs 4..7 are filled with the sign
// BEFORE the logical shift above runs, so the same bit-by-bit move that
// pulls zero in for `u128` pulls one bits in here instead -- one core, one
// fill, read off `tk_w_isneg` exactly as `tk_w_neg` does.
void tk_w_sar(uptr v, u64 n) {
    if (tk_w_isneg(v)) {
        i64 i = TK_W_NL;
        loop {
            if (i >= TK_DEC_NL) break;
            tk_dv_put(v, i, 0xffffffff);
            i = i + 1;
        }
    }
    tk_w_shr(v, n);
}

// ---- i128: the wrappers ----
void tk_iv(i128 v, uptr o) { tk_w_vec(tk_i128_lo(v), tk_i128_hi(v), o); }
i128 tk_iw(uptr v) { return tk_i128_of(tk_w_lo(v), tk_w_hi(v)); }

i128 tk_i128_add(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_add(x, y);
    return tk_iw(x);
}

i128 tk_i128_sub(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_sub(x, y);
    return tk_iw(x);
}

i128 tk_i128_mul(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    u64 r[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_mul(r, x, y);
    return tk_iw(r);
}

i128 tk_i128_div(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    u64 q[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_sdiv(q, x, y);
    return tk_iw(q);
}

i128 tk_i128_neg(i128 a) {
    u64 x[TK_DEC_NL];
    tk_iv(a, x);
    tk_w_neg(x);
    return tk_iw(x);
}

i128 tk_i128_mod(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_smod(x, y);
    return tk_iw(x);
}

// the count is the SECOND operand's own low 64 bits, masked to 7 (D83)
i128 tk_i128_shl(i128 a, i128 cnt) {
    u64 x[TK_DEC_NL];
    tk_iv(a, x);
    tk_w_shl(x, tk_i128_lo(cnt) & 127);
    return tk_iw(x);
}

i128 tk_i128_shr(i128 a, i128 cnt) {
    u64 x[TK_DEC_NL];
    tk_iv(a, x);
    tk_w_sar(x, tk_i128_lo(cnt) & 127);
    return tk_iw(x);
}

i128 tk_i128_and(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_and(x, y);
    return tk_iw(x);
}

i128 tk_i128_or(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_or(x, y);
    return tk_iw(x);
}

i128 tk_i128_xor(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_xor(x, y);
    return tk_iw(x);
}

i128 tk_i128_not(i128 a) {
    u64 x[TK_DEC_NL];
    tk_iv(a, x);
    tk_w_not(x);
    return tk_iw(x);
}

i64 tk_i128_cmp(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    return tk_w_scmp(x, y);
}

i64 tk_i128_eq(i128 a, i128 b) { return tk_i128_cmp(a, b) == 0; }
i64 tk_i128_ne(i128 a, i128 b) { return tk_i128_cmp(a, b) != 0; }
i64 tk_i128_lt(i128 a, i128 b) { return tk_i128_cmp(a, b) < 0; }
i64 tk_i128_le(i128 a, i128 b) { return tk_i128_cmp(a, b) <= 0; }
i64 tk_i128_gt(i128 a, i128 b) { return tk_i128_cmp(a, b) > 0; }
i64 tk_i128_ge(i128 a, i128 b) { return tk_i128_cmp(a, b) >= 0; }

// ---- u128: the same wrappers over the unsigned core ----
void tk_uv(u128 v, uptr o) { tk_w_vec(tk_u128_lo(v), tk_u128_hi(v), o); }
u128 tk_uw(uptr v) { return tk_u128_of(tk_w_lo(v), tk_w_hi(v)); }

u128 tk_u128_add(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_add(x, y);
    return tk_uw(x);
}

u128 tk_u128_sub(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_sub(x, y);
    return tk_uw(x);
}

u128 tk_u128_mul(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    u64 r[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_mul(r, x, y);
    return tk_uw(r);
}

u128 tk_u128_div(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    u64 q[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_udiv(q, x, y);
    return tk_uw(q);
}

// C#'s `UInt128` declares `operator -(UInt128)` too, and it wraps outside a
// `checked` block exactly as the signed one does.
u128 tk_u128_neg(u128 a) {
    u64 x[TK_DEC_NL];
    tk_uv(a, x);
    tk_w_neg(x);
    return tk_uw(x);
}

u128 tk_u128_mod(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_umod(x, y);
    return tk_uw(x);
}

u128 tk_u128_shl(u128 a, u128 cnt) {
    u64 x[TK_DEC_NL];
    tk_uv(a, x);
    tk_w_shl(x, tk_u128_lo(cnt) & 127);
    return tk_uw(x);
}

// LOGICAL, unlike `i128`'s own: `u128` has no sign to fill from
u128 tk_u128_shr(u128 a, u128 cnt) {
    u64 x[TK_DEC_NL];
    tk_uv(a, x);
    tk_w_shr(x, tk_u128_lo(cnt) & 127);
    return tk_uw(x);
}

u128 tk_u128_and(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_and(x, y);
    return tk_uw(x);
}

u128 tk_u128_or(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_or(x, y);
    return tk_uw(x);
}

u128 tk_u128_xor(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_xor(x, y);
    return tk_uw(x);
}

u128 tk_u128_not(u128 a) {
    u64 x[TK_DEC_NL];
    tk_uv(a, x);
    tk_w_not(x);
    return tk_uw(x);
}

i64 tk_u128_cmp(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    return tk_dv_cmp(x, y);
}

i64 tk_u128_eq(u128 a, u128 b) { return tk_u128_cmp(a, b) == 0; }
i64 tk_u128_ne(u128 a, u128 b) { return tk_u128_cmp(a, b) != 0; }
i64 tk_u128_lt(u128 a, u128 b) { return tk_u128_cmp(a, b) < 0; }
i64 tk_u128_le(u128 a, u128 b) { return tk_u128_cmp(a, b) <= 0; }
i64 tk_u128_gt(u128 a, u128 b) { return tk_u128_cmp(a, b) > 0; }
i64 tk_u128_ge(u128 a, u128 b) { return tk_u128_cmp(a, b) >= 0; }

// ---- the conversions (docs/specs/small-ints.md § 8) ----
// Each is a row of teko_prim.tk's conversion table (teko_i128.tk), so a cast
// the source wrote and an integer the compiler converts on its own both reach
// the same four functions -- `tk_prim_cast_lower` and `tk_num_widen`.
//
// The SIGNED source sign-extends and the UNSIGNED one does not, which is the
// whole of the difference and the reason there are four and not two: a `u64`
// at or above 2^63 through a signed door is a negative 128-bit value, the
// silent wrong answer D77's ruling 8 caught on `decimal`.
u64 tk_w_ones() {
    u64 z = 0;
    return z - 1;
}

i128 tk_i128_from_i64(i64 n) {
    u64 hi = 0;
    if (n < 0) hi = tk_w_ones();
    return tk_i128_of(n, hi);
}

i128 tk_i128_from_u64(u64 n) { return tk_i128_of(n, 0); }

// C#'s own `(UInt128)(-1L)`: the value sign-extends to 128 bits and the bits
// are then read unsigned, which is 2^128-1. It is an EXPLICIT conversion in
// C# and an implicit one here, for the same reason `u64 x = -1;` is already
// accepted by teko -- there is no `checked` word to tell the two apart.
u128 tk_u128_from_i64(i64 n) {
    u64 hi = 0;
    if (n < 0) hi = tk_w_ones();
    return tk_u128_of(n, hi);
}

u128 tk_u128_from_u64(u64 n) { return tk_u128_of(n, 0); }

// ...and back, truncating to the low 64 bits, which is C#'s own unchecked
// narrowing. `(u64) v` rides this row too: the call answers an `i64` and the
// cast the source wrote is the ordinary 64-bit reinterpretation over it.
i64 tk_i128_to_i64(i128 v) { return tk_i128_lo(v); }
i64 tk_u128_to_i64(u128 v) { return tk_u128_lo(v); }

// the two that move no bit at all
i128 tk_i128_from_u128(u128 v) { return tk_i128_of(tk_u128_lo(v), tk_u128_hi(v)); }
u128 tk_u128_from_i128(i128 v) { return tk_u128_of(tk_i128_lo(v), tk_i128_hi(v)); }
