// wide.tk -- `i128` and `u128`: the two copy helpers a sixteen-byte value
// needs, the buffer a sixteen-byte RETURN travels through, and the arithmetic
// every operator of the two types lowers to. Program code, not compiler code:
// `#include "wide.tk"` from the `.tk` source itself, exactly as `rt.tk`,
// `decimal.tk` and `guid.tk` are included (docs/reference/runtime.md).
//
// N6a of docs/specs/small-ints.md (§ 6, § 8, § 11) and D81. Everything here is
// ordinary teko over `lib/limbs.tk`'s eight 32-bit limbs -- the same vector
// `decimal` computes over, lifted for exactly this file -- so no leg needs a
// 128-bit instruction, `mc`'s bundled `<i128>` is not included (D81: it cannot
// coexist with `<float>`), and `mc limits`' `intrin` row does not move (D21).
//
// The representation is docs/specs/small-ints.md § 6's: sixteen bytes,
// sixteen-byte aligned, little-endian, the low half at `+0` and the high half
// at `+8`. `i128` and `u128` are THE SAME BITS and differ in exactly four
// places here -- `/` and the four ordering comparisons (D81), `%` (the
// remainder's sign) and `>>` (arithmetic against logical, D83) -- which is why
// the core below is written once over a vector and each type gets a four-line
// wrapper.
//
// N6b's `%`, `<<`, `>>`, `&`, `|`, `^`, `~` are here too (D83), and so are its
// `f64` and `decimal` conversions, both directions, both types (D84), and its
// text and its members -- `ToString`, `Parse`, `TryParse`, `CompareTo`,
// `Equals`, `MinValue`, `MaxValue`, `Zero`, `One` (N6b-3, D85). After this
// crumb N6b owes nothing more.
#include "limbs.tk"

// ---- the three declarations a wide type owes the PROGRAM ----
// The return buffer, one per TYPE (D75): a function returning an `i128` copies
// its sixteen bytes here and returns the ADDRESS of this global, and the call
// site copies them out into the call depth's own slot immediately after the
// branch, which is what makes ONE buffer safe under recursion and nesting
// (`tw_call`/`tw_ret`, teko_wide.tk).
i128 tk_i128_retbuf;
u128 tk_u128_retbuf;

// The field road and the array-element road: two `ld64`/`st64` pairs over the
// address of the sixteen bytes, which `tk_ldn`/`tk_stn` (teko_struct.tk) lower
// every indirect access of a wide type to -- no raw `ldW` moves sixteen bytes
// and the width table would answer `ld64` and move half the value in silence.
i128 tk_i128_ld(ptr p) {
    i128 v;
    ptr q = &v;
    st64(q, ld64(p));
    st64(q + 8, ld64(p + 8));
    return v;
}

void tk_i128_st(ptr p, i128 v) {
    ptr q = &v;
    st64(p, ld64(q));
    st64(p + 8, ld64(q + 8));
}

u128 tk_u128_ld(ptr p) {
    u128 v;
    ptr q = &v;
    st64(q, ld64(p));
    st64(q + 8, ld64(p + 8));
    return v;
}

void tk_u128_st(ptr p, u128 v) {
    ptr q = &v;
    st64(p, ld64(q));
    st64(p + 8, ld64(q + 8));
}

// ---- the two halves, and a value built out of them ----
// `&v` on a parameter of wide type is the address of its own frame slot, so
// each half is one `ld64` and no accessor, no member and no intrinsic is
// needed to reach it. The four below are what `tests/primitives_i128.tk`
// checks the layout with, and what every wrapper in this file is written over.
u64 tk_i128_lo(i128 v) { ptr p = &v; return ld64(p); }
u64 tk_i128_hi(i128 v) { ptr p = &v; return ld64(p + 8); }
u64 tk_u128_lo(u128 v) { ptr p = &v; return ld64(p); }
u64 tk_u128_hi(u128 v) { ptr p = &v; return ld64(p + 8); }

i128 tk_i128_of(u64 lo, u64 hi) {
    i128 v;
    ptr p = &v;
    st64(p, lo);
    st64(p + 8, hi);
    return v;
}

u128 tk_u128_of(u64 lo, u64 hi) {
    u128 v;
    ptr p = &v;
    st64(p, lo);
    st64(p + 8, hi);
    return v;
}

// ---- the core, over four of `lib/limbs.tk`'s eight limbs ----
// A 128-bit value is limbs 0..3; limbs 4..7 are the headroom a product and a
// long division need. Every operation that can overflow ends in `tk_w_mask`,
// which is the WRAP docs/specs/small-ints.md § 6 fixes: C#'s unchecked default,
// and the only behaviour there is, since teko has no `checked` word.
#define TK_W_NL 4

void tk_w_vec(u64 lo, u64 hi, uptr v) {
    tk_dv_zero(v);
    tk_dv_put(v, 0, lo & 0xffffffff);
    tk_dv_put(v, 1, (lo >> 32) & 0xffffffff);
    tk_dv_put(v, 2, hi & 0xffffffff);
    tk_dv_put(v, 3, (hi >> 32) & 0xffffffff);
}

u64 tk_w_lo(uptr v) { return tk_dv_at(v, 0) | (tk_dv_at(v, 1) << 32); }
u64 tk_w_hi(uptr v) { return tk_dv_at(v, 2) | (tk_dv_at(v, 3) << 32); }

// modulo 2^128: everything above limb 3 is dropped
void tk_w_mask(uptr v) {
    i64 i = TK_W_NL;
    loop {
        if (i >= TK_DEC_NL) break;
        tk_dv_put(v, i, 0);
        i = i + 1;
    }
}

// bit 127, the sign of an `i128`. It is read off limb 3 and never off a `u64`
// half, so no comparison in this file ever meets `mc`'s signed-`u64` defect.
i64 tk_w_isneg(uptr v) { return (tk_dv_at(v, 3) >> 31) & 1; }

// v = -v, modulo 2^128. `tk_dv_sub` drops the borrow out of the top limb,
// which is exactly two's complement: `-MinValue == MinValue` falls out of it
// and is asserted by `tests/primitives_i128_math.tk`.
void tk_w_neg(uptr v) {
    u64 z[TK_DEC_NL];
    tk_dv_zero(z);
    tk_dv_sub(z, v);
    tk_dv_copy(v, z);
    tk_w_mask(v);
}

// a += b, a -= b, a *= b -- all three modulo 2^128. The carry `tk_dv_add`
// guards is a value past 256 bits, which two 128-bit operands cannot form.
void tk_w_add(uptr a, uptr b) { tk_dv_add(a, b); tk_w_mask(a); }
void tk_w_sub(uptr a, uptr b) { tk_dv_sub(a, b); tk_w_mask(a); }

void tk_w_mul(uptr r, uptr a, uptr b) {
    tk_dv_mul(r, a, b);
    tk_w_mask(r);
}

// q = a / b, unsigned, truncating. The divisor is asked about FIRST, because
// `tk_dv_divmod` over a zero divisor would answer every bit set rather than
// fail: `teko: division by zero`, exit 70, the road every runtime guard in
// this project already takes (docs/reference/memory.md).
void tk_w_udiv(uptr q, uptr a, uptr b) {
    if (tk_dv_is_zero(b)) panic("division by zero");
    tk_dv_divmod(q, a, b);
    tk_w_mask(q);
}

// D82's own amendment to D81's ruling 3: `MinValue / -1` no longer wraps.
// Checked on the ORIGINAL operands, ahead of the magnitude split below (which
// disturbs neither): `MinValue` is bit 127 set and nothing else, `-1` is
// every bit set, both by the same limb layout `tk_w_isneg` already reads --
// the one 128-bit value whose OWN negation is a no-op (`tk_w_neg`'s header)
// divided by the one divisor whose magnitude is 1, exactly the pair every
// other integer width in this project already guards (`teko_ternary.tk`'s
// own `tk_div_guard`, D82).
i64 tk_w_sdiv_ovf(uptr a, uptr b) {
    return tk_dv_at(a, 0) == 0 && tk_dv_at(a, 1) == 0 && tk_dv_at(a, 2) == 0
        && tk_dv_at(a, 3) == 0x80000000
        && tk_dv_at(b, 0) == 0xffffffff && tk_dv_at(b, 1) == 0xffffffff
        && tk_dv_at(b, 2) == 0xffffffff && tk_dv_at(b, 3) == 0xffffffff;
}

// ...and the signed one: magnitudes, then the sign of the quotient. The
// operands are the caller's own scratch and are consumed.
void tk_w_sdiv(uptr q, uptr a, uptr b) {
    if (tk_w_sdiv_ovf(a, b)) panic("an integer division overflowed");
    i64 sa = tk_w_isneg(a);
    i64 sb = tk_w_isneg(b);
    if (sa) tk_w_neg(a);
    if (sb) tk_w_neg(b);
    tk_w_udiv(q, a, b);
    if (sa != sb) tk_w_neg(q);
}

// -1, 0 or 1, signed. The sign bits decide first and the limbs after them,
// which is what makes `-1i < 1i` true where a raw limb compare says otherwise.
i64 tk_w_scmp(uptr a, uptr b) {
    i64 sa = tk_w_isneg(a);
    i64 sb = tk_w_isneg(b);
    if (sa != sb) {
        if (sa) return 0 - 1;
        return 1;
    }
    return tk_dv_cmp(a, b);
}

// a %= b, unsigned: `tk_dv_divmod` already leaves the remainder in `a`
// (`lib/limbs.tk`), so `tk_w_udiv`'s own zero guard is all a plain remainder
// needs -- the quotient it also computes has nowhere else to live and is
// simply not read back.
void tk_w_umod(uptr a, uptr b) {
    u64 q[TK_DEC_NL];
    tk_w_udiv(q, a, b);
}

// a %= b, signed: the sign follows the DIVIDEND alone (C#'s own rule for
// `%`, unlike `/`'s `sa != sb` on the quotient) -- truncating division keeps
// `a == (a/b)*b + a%b`, which only the dividend's own sign on the remainder
// satisfies. `tk_w_sdiv_ovf` is read unchanged: the one quotient `i128.MinValue
// % -1i` would need is the one value the width cannot hold, exactly D82's
// ruling 7, which named `%` as a row this crumb still owed.
void tk_w_smod(uptr a, uptr b) {
    if (tk_w_sdiv_ovf(a, b)) panic("an integer division overflowed");
    i64 sa = tk_w_isneg(a);
    i64 sb = tk_w_isneg(b);
    if (sa) tk_w_neg(a);
    if (sb) tk_w_neg(b);
    u64 q[TK_DEC_NL];
    tk_w_udiv(q, a, b);
    if (sa) tk_w_neg(a);
}

// ---- bitwise: `& | ^ ~`, the SAME bits for `i128` and `u128`. The two
// types differ in four places -- `/` and the four orderings (D81), `%` and
// `>>` (D83, above) -- and bitwise joins none of them. Limbs 4..7 are already zero
// (`tk_w_vec`'s own zeroing), so `& | ^` never touch them; `~` alone needs
// the mask afterward to keep them that way.
void tk_w_and(uptr a, uptr b) {
    i64 i = 0;
    loop {
        if (i >= TK_W_NL) break;
        tk_dv_put(a, i, tk_dv_at(a, i) & tk_dv_at(b, i));
        i = i + 1;
    }
}

void tk_w_or(uptr a, uptr b) {
    i64 i = 0;
    loop {
        if (i >= TK_W_NL) break;
        tk_dv_put(a, i, tk_dv_at(a, i) | tk_dv_at(b, i));
        i = i + 1;
    }
}

void tk_w_xor(uptr a, uptr b) {
    i64 i = 0;
    loop {
        if (i >= TK_W_NL) break;
        tk_dv_put(a, i, tk_dv_at(a, i) ^ tk_dv_at(b, i));
        i = i + 1;
    }
}

void tk_w_not(uptr v) {
    i64 i = 0;
    loop {
        if (i >= TK_W_NL) break;
        tk_dv_put(v, i, (~tk_dv_at(v, i)) & 0xffffffff);
        i = i + 1;
    }
}

// ---- shifts: `<<` and the two `>>`s (D83) ----
// `n` is already masked to its low 7 bits by the WRAPPER below, never here:
// a shift count reaches the operator table as the SAME wide type as the
// value (`tk_ops_promote`'s wide arm runs first, teko_ops.tk, so a `(t,
// TY_I64)` row would never fire), and .NET's own `Int128`/`UInt128` shift
// operators mask their amount to 7 bits the same way -- a negative count
// falls out under the mask exactly as a count past 127 does.
//
// Both cores below shift the WHOLE eight-limb scratch, not just the four
// live limbs: a left shift's overflow lands in limbs 4..7, where
// `tk_w_mask` already drops it, the same wrap every other operator ends in.
// `n` is never negative and never above 127, so every limb index below
// stays in range unchecked.
void tk_w_shl(uptr v, u64 n) {
    u64 r[TK_DEC_NL];
    u64 limbs = n / 32;
    u64 bits = n % 32;
    i64 i = TK_DEC_NL - 1;
    loop {
        if (i < 0) break;
        i64 src = i - limbs;
        u64 hi = 0;
        if (src >= 0) hi = tk_dv_at(v, src);
        u64 lo = 0;
        if (bits != 0 && src > 0) lo = tk_dv_at(v, src - 1);
        u64 x = hi;
        if (bits != 0) x = (hi << bits) | (lo >> (32 - bits));
        tk_dv_put(r, i, x & 0xffffffff);
        i = i - 1;
    }
    tk_dv_copy(v, r);
    tk_w_mask(v);
}

// LOGICAL right shift: fills from the top with zero, which is what a
// right-shifted limb 4..7 already holds -- `u128`'s own shift, and the
// second half of `i128`'s arithmetic one below.
void tk_w_shr(uptr v, u64 n) {
    u64 r[TK_DEC_NL];
    u64 limbs = n / 32;
    u64 bits = n % 32;
    i64 i = 0;
    loop {
        if (i >= TK_DEC_NL) break;
        i64 src = i + limbs;
        u64 lo = 0;
        if (src < TK_DEC_NL) lo = tk_dv_at(v, src);
        u64 hi = 0;
        if (bits != 0 && src + 1 < TK_DEC_NL) hi = tk_dv_at(v, src + 1);
        u64 x = lo;
        if (bits != 0) x = (lo >> bits) | (hi << (32 - bits));
        tk_dv_put(r, i, x & 0xffffffff);
        i = i + 1;
    }
    tk_dv_copy(v, r);
    tk_w_mask(v);
}

// ARITHMETIC right shift, `i128`'s own: limbs 4..7 are filled with the sign
// BEFORE the logical shift above runs, so the same bit-by-bit move that
// pulls zero in for `u128` pulls one bits in here instead -- one core, one
// fill, read off `tk_w_isneg` exactly as `tk_w_neg` does.
void tk_w_sar(uptr v, u64 n) {
    if (tk_w_isneg(v)) {
        i64 i = TK_W_NL;
        loop {
            if (i >= TK_DEC_NL) break;
            tk_dv_put(v, i, 0xffffffff);
            i = i + 1;
        }
    }
    tk_w_shr(v, n);
}

// ---- i128: the wrappers ----
void tk_iv(i128 v, uptr o) { tk_w_vec(tk_i128_lo(v), tk_i128_hi(v), o); }
i128 tk_iw(uptr v) { return tk_i128_of(tk_w_lo(v), tk_w_hi(v)); }

i128 tk_i128_add(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_add(x, y);
    return tk_iw(x);
}

i128 tk_i128_sub(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_sub(x, y);
    return tk_iw(x);
}

i128 tk_i128_mul(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    u64 r[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_mul(r, x, y);
    return tk_iw(r);
}

i128 tk_i128_div(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    u64 q[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_sdiv(q, x, y);
    return tk_iw(q);
}

i128 tk_i128_neg(i128 a) {
    u64 x[TK_DEC_NL];
    tk_iv(a, x);
    tk_w_neg(x);
    return tk_iw(x);
}

i128 tk_i128_mod(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_smod(x, y);
    return tk_iw(x);
}

// the count is the SECOND operand's own low 64 bits, masked to 7 (D83)
i128 tk_i128_shl(i128 a, i128 cnt) {
    u64 x[TK_DEC_NL];
    tk_iv(a, x);
    tk_w_shl(x, tk_i128_lo(cnt) & 127);
    return tk_iw(x);
}

i128 tk_i128_shr(i128 a, i128 cnt) {
    u64 x[TK_DEC_NL];
    tk_iv(a, x);
    tk_w_sar(x, tk_i128_lo(cnt) & 127);
    return tk_iw(x);
}

i128 tk_i128_and(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_and(x, y);
    return tk_iw(x);
}

i128 tk_i128_or(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_or(x, y);
    return tk_iw(x);
}

i128 tk_i128_xor(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    tk_w_xor(x, y);
    return tk_iw(x);
}

i128 tk_i128_not(i128 a) {
    u64 x[TK_DEC_NL];
    tk_iv(a, x);
    tk_w_not(x);
    return tk_iw(x);
}

i64 tk_i128_cmp(i128 a, i128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_iv(a, x);
    tk_iv(b, y);
    return tk_w_scmp(x, y);
}

i64 tk_i128_eq(i128 a, i128 b) { return tk_i128_cmp(a, b) == 0; }
i64 tk_i128_ne(i128 a, i128 b) { return tk_i128_cmp(a, b) != 0; }
i64 tk_i128_lt(i128 a, i128 b) { return tk_i128_cmp(a, b) < 0; }
i64 tk_i128_le(i128 a, i128 b) { return tk_i128_cmp(a, b) <= 0; }
i64 tk_i128_gt(i128 a, i128 b) { return tk_i128_cmp(a, b) > 0; }
i64 tk_i128_ge(i128 a, i128 b) { return tk_i128_cmp(a, b) >= 0; }

// ---- u128: the same wrappers over the unsigned core ----
void tk_uv(u128 v, uptr o) { tk_w_vec(tk_u128_lo(v), tk_u128_hi(v), o); }
u128 tk_uw(uptr v) { return tk_u128_of(tk_w_lo(v), tk_w_hi(v)); }

u128 tk_u128_add(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_add(x, y);
    return tk_uw(x);
}

u128 tk_u128_sub(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_sub(x, y);
    return tk_uw(x);
}

u128 tk_u128_mul(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    u64 r[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_mul(r, x, y);
    return tk_uw(r);
}

u128 tk_u128_div(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    u64 q[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_udiv(q, x, y);
    return tk_uw(q);
}

// C#'s `UInt128` declares `operator -(UInt128)` too, and it wraps outside a
// `checked` block exactly as the signed one does.
u128 tk_u128_neg(u128 a) {
    u64 x[TK_DEC_NL];
    tk_uv(a, x);
    tk_w_neg(x);
    return tk_uw(x);
}

u128 tk_u128_mod(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_umod(x, y);
    return tk_uw(x);
}

u128 tk_u128_shl(u128 a, u128 cnt) {
    u64 x[TK_DEC_NL];
    tk_uv(a, x);
    tk_w_shl(x, tk_u128_lo(cnt) & 127);
    return tk_uw(x);
}

// LOGICAL, unlike `i128`'s own: `u128` has no sign to fill from
u128 tk_u128_shr(u128 a, u128 cnt) {
    u64 x[TK_DEC_NL];
    tk_uv(a, x);
    tk_w_shr(x, tk_u128_lo(cnt) & 127);
    return tk_uw(x);
}

u128 tk_u128_and(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_and(x, y);
    return tk_uw(x);
}

u128 tk_u128_or(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_or(x, y);
    return tk_uw(x);
}

u128 tk_u128_xor(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    tk_w_xor(x, y);
    return tk_uw(x);
}

u128 tk_u128_not(u128 a) {
    u64 x[TK_DEC_NL];
    tk_uv(a, x);
    tk_w_not(x);
    return tk_uw(x);
}

i64 tk_u128_cmp(u128 a, u128 b) {
    u64 x[TK_DEC_NL];
    u64 y[TK_DEC_NL];
    tk_uv(a, x);
    tk_uv(b, y);
    return tk_dv_cmp(x, y);
}

i64 tk_u128_eq(u128 a, u128 b) { return tk_u128_cmp(a, b) == 0; }
i64 tk_u128_ne(u128 a, u128 b) { return tk_u128_cmp(a, b) != 0; }
i64 tk_u128_lt(u128 a, u128 b) { return tk_u128_cmp(a, b) < 0; }
i64 tk_u128_le(u128 a, u128 b) { return tk_u128_cmp(a, b) <= 0; }
i64 tk_u128_gt(u128 a, u128 b) { return tk_u128_cmp(a, b) > 0; }
i64 tk_u128_ge(u128 a, u128 b) { return tk_u128_cmp(a, b) >= 0; }

// ---- the conversions (docs/specs/small-ints.md § 8) ----
// Each is a row of teko_prim.tk's conversion table (teko_i128.tk), so a cast
// the source wrote and an integer the compiler converts on its own both reach
// the same four functions -- `tk_prim_cast_lower` and `tk_num_widen`.
//
// The SIGNED source sign-extends and the UNSIGNED one does not, which is the
// whole of the difference and the reason there are four and not two: a `u64`
// at or above 2^63 through a signed door is a negative 128-bit value, the
// silent wrong answer D77's ruling 8 caught on `decimal`.
u64 tk_w_ones() {
    u64 z = 0;
    return z - 1;
}

i128 tk_i128_from_i64(i64 n) {
    u64 hi = 0;
    if (n < 0) hi = tk_w_ones();
    return tk_i128_of(n, hi);
}

i128 tk_i128_from_u64(u64 n) { return tk_i128_of(n, 0); }

// C#'s own `(UInt128)(-1L)`: the value sign-extends to 128 bits and the bits
// are then read unsigned, which is 2^128-1. It is an EXPLICIT conversion in
// C# and an implicit one here, for the same reason `u64 x = -1;` is already
// accepted by teko -- there is no `checked` word to tell the two apart.
u128 tk_u128_from_i64(i64 n) {
    u64 hi = 0;
    if (n < 0) hi = tk_w_ones();
    return tk_u128_of(n, hi);
}

u128 tk_u128_from_u64(u64 n) { return tk_u128_of(n, 0); }

// ...and back, truncating to the low 64 bits, which is C#'s own unchecked
// narrowing. `(u64) v` rides this row too: the call answers an `i64` and the
// cast the source wrote is the ordinary 64-bit reinterpretation over it.
i64 tk_i128_to_i64(i128 v) { return tk_i128_lo(v); }
i64 tk_u128_to_i64(u128 v) { return tk_u128_lo(v); }

// the two that move no bit at all
i128 tk_i128_from_u128(u128 v) { return tk_i128_of(tk_u128_lo(v), tk_u128_hi(v)); }
u128 tk_u128_from_i128(i128 v) { return tk_u128_of(tk_i128_lo(v), tk_i128_hi(v)); }

// ---- N6b-2: the `f64` and `decimal` conversions (docs/specs/small-ints.md
// § 8; D84) ----
//
// `(f64) x` rounds ONCE, to nearest even, over the WHOLE 128-bit magnitude --
// never per 32-bit limb the way `tk_dec_to_f64` accumulates (three limbs are
// 96 bits, already past a `double`'s 53-bit significand, so that loop can
// round between limbs; four limbs would round at every step). `(f64) x` -> `i128`/
// `u128` truncates toward zero and SATURATES rather than wraps -- .NET's own
// `Int128`/`UInt128` explicit conversion from `double` does exactly this,
// and teko has no `checked` word to tell a saturating cast from a wrapping
// one the way C# tells an unchecked block from a checked one, so this is
// teko's OWN rule and not the primitive widths' unchecked default (D84).
//
// Every routine below reads and writes the two 64-bit halves directly and
// never compares one as an ORDERING against another `u64` that might have
// bit 63 set (D81's own header: `mc` compares every integer SIGNED, `u64`
// included) -- a shift, a mask and an equality against zero are the only
// operations run on a value that could be that large, exactly `lib/limbs.tk`'s
// own rule, applied here to a `u64` pair instead of a 32-bit limb.

// number of bits `x` needs, 0 for `x == 0` -- a loop and not a formula,
// since `x` may have bit 63 set and a formula would need to compare it
u64 tk_w_bit63() { u64 o = 1; return o << 63; }
u64 tk_w_bit52() { u64 o = 1; return o << 52; }

i64 tk_w_bitlen64(u64 x) {
    i64 n = 0;
    loop {
        if (x == 0) break;
        x = x >> 1;
        n = n + 1;
    }
    return n;
}

i64 tk_w_bitlen128(u64 lo, u64 hi) {
    if (hi != 0) return 64 + tk_w_bitlen64(hi);
    return tk_w_bitlen64(lo);
}

// bit `k` of the pair, 0 <= k <= 127
i64 tk_w_bit_at(u64 lo, u64 hi, i64 k) {
    if (k >= 64) return (hi >> (k - 64)) & 1;
    return (lo >> k) & 1;
}

// 1 when the pair has a set bit strictly below position `k` (0 for k <= 0)
i64 tk_w_sticky_below(u64 lo, u64 hi, i64 k) {
    i64 i = 0;
    loop {
        if (i >= k) break;
        if (tk_w_bit_at(lo, hi, i)) return 1;
        i = i + 1;
    }
    return 0;
}

// 2^n, exact for every `n` this file calls it with (n <= 128): each step
// doubles, which only ever moves a `double`'s exponent, never its mantissa
f64 tk_w_two_pow(i64 n) {
    f64 r = 1.0;
    i64 i = 0;
    loop {
        if (i >= n) break;
        r = r * 2.0;
        i = i + 1;
    }
    return r;
}

// the double closest to the UNSIGNED magnitude `(lo, hi)`, `sign` applied
// last. `e` is the highest set bit (0 for the value 1, so the value itself is
// `2^e` at the low end); the top 53 bits from `e` down are the candidate
// mantissa (its own top bit is the implicit one every normal double has),
// the next bit down is the round bit, and everything below that is folded
// into one sticky bit -- round to nearest, ties to even, the one rounding a
// double's own arithmetic already uses and the only one a "prove it
// equivalent" ruling can be measured against.
f64 tk_w_mag_to_f64(u64 lo, u64 hi, i64 sign) {
    if (lo == 0 && hi == 0) return 0.0;
    i64 bl = tk_w_bitlen128(lo, hi);
    i64 e = bl - 1;
    u64 mant = 0;
    i64 i = 0;
    loop {
        if (i >= 53) break;
        i64 bitpos = e - i;
        i64 b = 0;
        if (bitpos >= 0) b = tk_w_bit_at(lo, hi, bitpos);
        mant = (mant << 1) | ((u64) b);
        i = i + 1;
    }
    i64 rb = 0;
    if (e - 53 >= 0) rb = tk_w_bit_at(lo, hi, e - 53);
    i64 sticky = tk_w_sticky_below(lo, hi, e - 53);
    if (rb && (sticky || (mant & 1))) {
        mant = mant + 1;
        if ((mant >> 53) & 1) {            // the round carried past 53 bits
            mant = mant >> 1;
            e = e + 1;
        }
    }
    u64 mbits = mant & 0xfffffffffffff;    // the implicit top bit, dropped
    u64 exp = (u64) (e + 1023);
    u64 sbit = (u64) sign;
    return tk_f64_from_bits((sbit << 63) | (exp << 52) | mbits);
}

// v = -(hi:lo), two's complement, over the raw pair -- the three lines
// `tk_w_neg` runs over the eight-limb scratch, cheaper here since a
// magnitude extraction already has the two halves in hand
void tk_w_neg2(uptr lo, uptr hi) {
    u64 l = ld64(lo);
    u64 h = ld64(hi);
    u64 nl = 0 - l;
    u64 borrow = 0;
    if (l != 0) borrow = 1;
    st64(lo, nl);
    st64(hi, (0 - h) - borrow);
}

f64 tk_i128_to_f64(i128 v) {
    u64 lo = tk_i128_lo(v);
    u64 hi = tk_i128_hi(v);
    i64 sign = (hi >> 63) & 1;
    if (sign) tk_w_neg2(&lo, &hi);
    return tk_w_mag_to_f64(lo, hi, sign);
}

f64 tk_u128_to_f64(u128 v) {
    return tk_w_mag_to_f64(tk_u128_lo(v), tk_u128_hi(v), 0);
}

// the magnitude of TRUNC(x) for a finite x >= 1.0 that is known to be below
// the caller's own bound -- read straight off the IEEE754 bits (D131/D132's
// own `tk_f64_bits`), since any double with an unbiased exponent at or past
// 52 is already an integer and one with less has its fraction dropped by the
// same right shift that reads it. Never a `(u64) x` cast: this file's own
// header is the reason -- a narrowing int-from-float instruction is the
// core's, not this crumb's, to trust at the one bit a wrap and a magnitude
// disagree on.
void tk_w_trunc_mag(f64 x, uptr lo_out, uptr hi_out) {
    if (x < 1.0) { st64(lo_out, 0); st64(hi_out, 0); return; }
    u64 bits = tk_f64_bits(x);
    i64 texp = (i64) ((bits >> 52) & 0x7ff) - 1023;
    u64 sig = (bits & 0xfffffffffffff) | tk_w_bit52();
    u64 lo = 0;
    u64 hi = 0;
    if (texp >= 52) {
        i64 sh = texp - 52;
        if (sh >= 64) {
            hi = sig << (sh - 64);
        } else {
            lo = sig << sh;
            if (sh != 0) hi = sig >> (64 - sh);
        }
    } else {
        i64 sh = 52 - texp;
        lo = sig >> sh;
    }
    st64(lo_out, lo);
    st64(hi_out, hi);
}

// (f64) -> i128, truncating toward zero, SATURATING (D84 ruling 1): NaN and
// every magnitude at or past `2^127` collapse to the nearer bound, .NET's
// own `(Int128) someDouble` rule and not a wrap -- there is no `checked`
// word here to have chosen the other one with.
i128 tk_i128_from_f64(f64 x) {
    if (x != x) return tk_i128_of(0, 0);                   // NaN
    f64 p127 = tk_w_two_pow(127);
    if (x >= p127) return tk_i128_of(tk_w_ones(), tk_w_bit63() - 1);      // MaxValue
    if (x <= 0.0 - p127) return tk_i128_of(0, tk_w_bit63());              // MinValue
    i64 sign = 0;
    f64 m = x;
    if (m < 0.0) { sign = 1; m = 0.0 - m; }
    u64 lo;
    u64 hi;
    tk_w_trunc_mag(m, &lo, &hi);
    if (sign) tk_w_neg2(&lo, &hi);
    return tk_i128_of(lo, hi);
}

// (f64) -> u128: a negative `x` saturates to 0 rather than reading its two's
// complement, which is .NET's own `(UInt128) someDouble` rule
u128 tk_u128_from_f64(f64 x) {
    if (x != x) return tk_u128_of(0, 0);                   // NaN
    if (x < 0.0) return tk_u128_of(0, 0);
    f64 p128 = tk_w_two_pow(128);
    if (x >= p128) return tk_u128_of(tk_w_ones(), tk_w_ones());           // MaxValue
    u64 lo;
    u64 hi;
    tk_w_trunc_mag(x, &lo, &hi);
    return tk_u128_of(lo, hi);
}

// ---- `decimal` -> `i128`/`u128`, truncating toward zero (D84 ruling 4) ----
// Neither can ever overflow the width it converts INTO: `decimal.MaxValue`
// is `2^96 - 1`, and `i128`/`u128` hold up to `2^127 - 1`/`2^128 - 1`, so the
// only failure this direction has is `u128` reading a negative `decimal`
// whose truncated MAGNITUDE is still nonzero (`-0.5m` truncates to 0 and is
// fine; `-1m` does not) -- C# throws `OverflowException` for every decimal
// read into an unsigned integer type out of range, and `-1m` is one.
//
// `decimal.tk` is NOT included here (D81's own ruling: neither wide file
// includes the other), so the sixteen bytes are read raw -- `ld64(&d)` for
// the mantissa's low 64 bits, `ld64(&d + 8)` for the high 32 (the scale and
// the sign share that word, `docs/specs/decimal.md` § 1's own layout) --
// exactly the technique `tk_dec_lo`/`tk_dec_hi` use from the other side.
i128 tk_i128_from_dec(decimal d) {
    ptr p = &d;
    u64 lo = ld64(p);
    u64 hi = ld64(p + 8);
    i64 scale = (i64) ((hi >> 32) & 0xff);
    i64 sign = (hi >> 63) & 1;
    u64 v[TK_DEC_NL];
    tk_dv_zero(v);
    tk_dv_put(v, 0, lo & 0xffffffff);
    tk_dv_put(v, 1, (lo >> 32) & 0xffffffff);
    tk_dv_put(v, 2, hi & 0xffffffff);
    loop {
        if (scale <= 0) break;
        tk_dv_divs(v, 10);                  // floor of the nonnegative magnitude: truncation
        scale = scale - 1;
    }
    u64 rlo = tk_dv_at(v, 0) | (tk_dv_at(v, 1) << 32);
    u64 rhi = tk_dv_at(v, 2);
    if (sign) tk_w_neg2(&rlo, &rhi);
    return tk_i128_of(rlo, rhi);
}

u128 tk_u128_from_dec(decimal d) {
    ptr p = &d;
    u64 lo = ld64(p);
    u64 hi = ld64(p + 8);
    i64 scale = (i64) ((hi >> 32) & 0xff);
    i64 sign = (hi >> 63) & 1;
    u64 v[TK_DEC_NL];
    tk_dv_zero(v);
    tk_dv_put(v, 0, lo & 0xffffffff);
    tk_dv_put(v, 1, (lo >> 32) & 0xffffffff);
    tk_dv_put(v, 2, hi & 0xffffffff);
    loop {
        if (scale <= 0) break;
        tk_dv_divs(v, 10);
        scale = scale - 1;
    }
    u64 rlo = tk_dv_at(v, 0) | (tk_dv_at(v, 1) << 32);
    u64 rhi = tk_dv_at(v, 2);
    if (sign) {
        if (rlo != 0 || rhi != 0) panic("decimal overflow");
        return tk_u128_of(0, 0);
    }
    return tk_u128_of(rlo, rhi);
}

// ---- N6b-3: the text, and the four statics (docs/specs/small-ints.md § 7;
// D85) ----
//
// `ToString`, `Parse`, `TryParse` are `tk_dec_fmt`/`tk_dec_scan`'s own SHAPE
// (`lib/decimal.tk`), copied and not shared: a digit loop over `tk_dv_divs`
// least-significant-first for the text, a digit loop over `tk_dv_muladds` for
// the read, both over the same eight-limb scratch this file already keeps for
// the arithmetic. Neither wide file includes the other (D81's own ruling), so
// the two copies never converge into one function with a branch.
//
// The GRAMMAR is narrower than `decimal`'s own and narrower than C#'s
// `NumberStyles.Integer`: `[+|-] digits`, no surrounding white space, no
// separator, no exponent, no suffix -- D79's ruling 5 (`decimal.Parse`) is the
// newest in-repo ruling on a primitive's parse grammar and it wins over what
// C# would additionally accept, because one repository keeps one rule for the
// shape "the text `ToString` writes, and nothing else it does not" (D85,
// ruling 1).
//
// The FAILURE is one message, `"the string is not an i128"` /
// `"...u128"`, for both causes a scan can find -- text that is no number at
// all, and a number that does not fit -- exactly `decimal`'s own shape one
// level up: `TryParse` cannot tell the two apart either (it reads both as
// `false`), so `Parse` does not pretend to (D85, ruling 2). The scan below
// still ANSWERS three values, the same split `tk_dec_scan` makes, because the
// split costs nothing extra to keep and a future caller might want it; today
// nothing reads -1 differently from 0.
//
// The longest text is `i128.MinValue`, 40 characters plus the terminator
// (`-170141183460469231731687303715884105728`); 48 bytes leaves headroom
// without pretending to a tighter bound `u128.MaxValue`'s 39 digits would
// already make wrong reasoning to trim further.
#define TK_W_STRMAX 48

i64 tk_w_isdig(i64 c) { return c >= '0' && c <= '9'; }

// 1 when the vector holds a value at or past 2^128 -- the four headroom limbs
// `tk_w_mask` already drops, read here BEFORE the drop so a literal past the
// width is refused rather than silently wrapped.
i64 tk_w_over128(uptr v) {
    i64 i = TK_W_NL;
    loop {
        if (i >= TK_DEC_NL) break;
        if (tk_dv_at(v, i)) return 1;
        i = i + 1;
    }
    return 0;
}

// the magnitude in `v` (already non-negative, `TK_DEC_NL` limbs, mutated by
// this call) into `buf`, NUL-terminated, `sign` written first when it is set
// -- `tk_dec_fmt`'s own split (`lib/decimal.tk`), without a scale to place a
// point at.
i64 tk_w_fmt_mag(ptr buf, uptr v, i64 sign) {
    u8 dig[TK_W_STRMAX];
    i64 nd = 0;
    loop {
        u64 r = tk_dv_divs(v, 10);
        st8(dig + nd, '0' + r);
        nd = nd + 1;
        if (tk_dv_is_zero(v)) break;
    }
    i64 k = 0;
    if (sign) { st8(buf + k, '-'); k = k + 1; }
    i64 i = 0;
    loop {
        if (i >= nd) break;
        st8(buf + k, ld8(dig + nd - 1 - i));
        k = k + 1;
        i = i + 1;
    }
    st8(buf + k, 0);
    return k;
}

// `v` into `buf`, NUL-terminated, returning the length -- the allocation-free
// half, `tk_dec_fmt`'s own split. `MinValue`'s magnitude is `2^127`, which
// `tk_w_neg` (over the 256-bit scratch, masked back to 128) answers exactly,
// the same identity `tests/primitives_i128_math.tk` already asserts for the
// unary `-` operator.
i64 tk_i128_fmt(ptr buf, i128 v) {
    u64 x[TK_DEC_NL];
    tk_iv(v, x);
    i64 sign = tk_w_isneg(x);
    if (sign) tk_w_neg(x);
    return tk_w_fmt_mag(buf, x, sign);
}

i64 tk_u128_fmt(ptr buf, u128 v) {
    u64 x[TK_DEC_NL];
    tk_uv(v, x);
    return tk_w_fmt_mag(buf, x, 0);
}

// `.ToString()`. The buffer is heap-owned and the caller keeps it past this
// call's own return, `tk_dec_tostring`'s own shape (`lib/decimal.tk`).
str tk_i128_tostring(i128 v) {
    uptr buf = rt_alloc(TK_W_STRMAX);
    tk_i128_fmt(buf, v);
    return buf;
}

str tk_u128_tostring(u128 v) {
    uptr buf = rt_alloc(TK_W_STRMAX);
    tk_u128_fmt(buf, v);
    return buf;
}

// ---- Parse and TryParse ----
// Three-valued, `tk_dec_scan`'s own split: 0 for text that is no number at
// all, -1 for one that IS a number and does not fit, 1 for parsed -- read
// identically by `Parse`/`TryParse` below (D85, ruling 2).
//
// `i128`'s own range is `[-2^127, 2^127-1]`, asymmetric around zero the way
// `u128`'s `[0, 2^128-1]` is not: once the magnitude is known to fit in 128
// bits (`tk_w_over128` above), a positive one has to leave bit 127 clear, and
// a negative one may set it only for the single value `-2^127` -- the same
// bit `tk_w_isneg` already reads elsewhere in this file, checked here on the
// raw digit vector before any sign is applied.
i64 tk_i128_scan(ptr p, str s) {
    i64 i = 0;
    i64 sign = 0;
    i64 c = ld8(s);
    if (c == '+' || c == '-') {
        if (c == '-') sign = 1;
        i = 1;
    }
    u64 v[TK_DEC_NL];
    tk_dv_zero(v);
    i64 nd = 0;
    i64 over = 0;
    loop {
        c = ld8(s + i);
        if (!tk_w_isdig(c)) break;
        if (tk_dv_muladds(v, 10, c - '0')) over = 1;
        nd = nd + 1;
        i = i + 1;
    }
    if (nd == 0) return 0;                     // "", "+", "-", "x"
    if (ld8(s + i) != 0) return 0;              // trailing text of any kind
    if (over || tk_w_over128(v)) return 0 - 1;
    i64 top = (tk_dv_at(v, 3) >> 31) & 1;
    if (sign) {
        if (top && (tk_dv_at(v, 3) != 0x80000000 || tk_dv_at(v, 2) != 0
                    || tk_dv_at(v, 1) != 0 || tk_dv_at(v, 0) != 0))
            return 0 - 1;                       // more negative than MinValue
    } else if (top) {
        return 0 - 1;                           // MaxValue + 1 or past it
    }
    if (sign) tk_w_neg(v);
    tk_i128_st(p, tk_i128_of(tk_w_lo(v), tk_w_hi(v)));
    return 1;
}

// `u128`'s own range check: a leading `-` is a format failure only when the
// MAGNITUDE is nonzero (D85, ruling 1 -- C#'s own documented `UInt128.Parse`:
// `"-0"` succeeds and answers 0, `"-1"` overflows). No signed magnitude check
// is needed once the width fits: every non-negative value below `2^128` is a
// `u128`.
i64 tk_u128_scan(ptr p, str s) {
    i64 i = 0;
    i64 neg = 0;
    i64 c = ld8(s);
    if (c == '+' || c == '-') {
        if (c == '-') neg = 1;
        i = 1;
    }
    u64 v[TK_DEC_NL];
    tk_dv_zero(v);
    i64 nd = 0;
    i64 over = 0;
    loop {
        c = ld8(s + i);
        if (!tk_w_isdig(c)) break;
        if (tk_dv_muladds(v, 10, c - '0')) over = 1;
        nd = nd + 1;
        i = i + 1;
    }
    if (nd == 0) return 0;
    if (ld8(s + i) != 0) return 0;
    if (over || tk_w_over128(v)) return 0 - 1;
    if (neg && !tk_dv_is_zero(v)) return 0 - 1;
    tk_u128_st(p, tk_u128_of(tk_dv_at(v, 0) | (tk_dv_at(v, 1) << 32),
                              tk_dv_at(v, 2) | (tk_dv_at(v, 3) << 32)));
    return 1;
}

// `i128.Parse(s)` / `u128.Parse(s)`: the value, or a panic (exit 70). One
// message for both causes the scan can find (D85, ruling 2) -- `decimal`'s
// own `Parse` tells them apart because ITS two causes have two different
// remedies (a scale to trim, a magnitude that never fits); a wide integer's
// two causes have the same one remedy, "write a number in range", so a second
// sentence would say nothing a reader could act on differently.
i128 tk_i128_parse(str s) {
    i128 v;
    ptr q = &v;
    st64(q, 0);
    st64(q + 8, 0);
    if (tk_i128_scan(q, s) != 1) panic("the string is not an i128");
    return v;
}

u128 tk_u128_parse(str s) {
    u128 v;
    ptr q = &v;
    st64(q, 0);
    st64(q + 8, 0);
    if (tk_u128_scan(q, s) != 1) panic("the string is not a u128");
    return v;
}

// `i128.TryParse(s, out v)` / `u128.TryParse(s, out v)`: 1 and the value, or 0
// and `Zero` -- the one road into either type that never panics, `o` an
// `out i128`/`out u128` judged at the call site by teko_ref.tk's own pass
// (`tk_dec_tryparse`'s own shape, `lib/decimal.tk`).
i64 tk_i128_tryparse(str s, out i128 o) {
    i128 v;
    ptr q = &v;
    st64(q, 0);
    st64(q + 8, 0);
    if (tk_i128_scan(q, s) != 1) {
        st64(q, 0);
        st64(q + 8, 0);
        o = v;
        return 0;
    }
    o = v;
    return 1;
}

i64 tk_u128_tryparse(str s, out u128 o) {
    u128 v;
    ptr q = &v;
    st64(q, 0);
    st64(q + 8, 0);
    if (tk_u128_scan(q, s) != 1) {
        st64(q, 0);
        st64(q + 8, 0);
        o = v;
        return 0;
    }
    o = v;
    return 1;
}

// ---- the four statics ----
// Each a CALL, never a constant fold: `const i128 K = i128.One;` stays
// refused exactly as it was before this crumb (`tests/refuse/i128_const.tk`),
// because these are ordinary function calls and the `const` pass never folds
// one (D85, ruling 5). `MinValue`/`MaxValue` read the same two limb pairs
// `tk_i128_from_f64`'s own saturating bounds already use, above.
i128 tk_i128_min()  { return tk_i128_of(0, tk_w_bit63()); }
i128 tk_i128_max()  { return tk_i128_of(tk_w_ones(), tk_w_bit63() - 1); }
i128 tk_i128_zero() { return tk_i128_of(0, 0); }
i128 tk_i128_one()  { return tk_i128_of(1, 0); }

u128 tk_u128_min()  { return tk_u128_of(0, 0); }
u128 tk_u128_max()  { return tk_u128_of(tk_w_ones(), tk_w_ones()); }
u128 tk_u128_zero() { return tk_u128_of(0, 0); }
u128 tk_u128_one()  { return tk_u128_of(1, 0); }
