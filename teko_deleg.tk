// teko_deleg.tk -- K1 (D221/§41): a NAMED delegate (C# 1.0), not a generic
// `Func<>`/`Action<>` -- one `type_new` per declaration, the signature kept in
// a small table of its own beside teko_struct.tk's type row.
//
//   public delegate i64 Op(i64 a, i64 b);
//   i64 add(i64 a, i64 b) { return a + b; }
//   Op f = add;                 // contextual: a local of delegate type
//   Op g = new Op(add);         // explicit, valid anywhere `new` is
//   f(3, 4)                     // rebaixed in a pass() to a typed `callp`
//
// A delegate value IS an object, with the same layout a class carries: word 0
// the vtable (release only, `TK_VT_FIXED` words, no itab), word 1 the count,
// word 2 the CODE pointer. `tk_is_counted` (teko_struct.tk) already answers
// for a `TK_KDELEG` row, so the reclaim (teko_rc.tk) needs zero new line: a
// local, a field, a parameter of delegate type is scoped and released exactly
// as a class reference is.
//
// ABI: every function reached through a delegate takes the OBJECT as an
// invisible first parameter (an `__env`, unused by a plain function -- K4's
// captures read it), so `callp(code, obj, args...)` is the ONE calling
// convention every delegate value shares, captures or none. A free function
// with no capture gets a THUNK that forwards to it, memoized per (delegate,
// function) pair: `Op__thunk_add(uptr __env, i64 a, i64 b) { return add(a,
// b); }`. Its own vtable, release and allocator are generated alongside it
// (`Op__vt_add`, `Op__release_add`, `Op__new_add`) -- the layout is per
// LAMBDA, not per delegate TYPE, so K4's captures cost no rewrite here.
//
// `f(3, 4)` on a local/parameter of delegate type is core grammar (an
// identifier followed by `(`), parsed with no hook at all -- `tk_deleg_pass`
// rewrites every such `N_CALL` into the typed `callp` above, reusing
// teko_typeof.tk's own scope walk (`tk_ty_pass_walk`); what it does not
// rewrite dies at `call to unknown function`, never in silence. A field of
// delegate type (`h.cb(2, 3)`) is resolved where it is written instead,
// teko_expr.tk's `tk_field_use`.

#define TK_DGMAX (MAXPARAMS - 2)      // callp: code + obj + params, <= MAXPARAMS
#define TK_DGOBJSIZE 24                // vtable + count + code, no capture (K1)
#define TK_MAXDGI 64                   // (delegate, function) pairs one unit wraps

#define TK_MAXLAMCAP 32                // `use (...)` names, summed across every lambda still in
                                       // flight (higiene 2, item 6: a nested lambda's own captures
                                       // share this table with every enclosing one's, unreleased
                                       // until each returns) -- 8 per lambda nested four deep
#define TK_MAXLAMREF 64                // lambdas that capture at least one name by reference
#define TK_MAXLAMGLOB 64               // D226 compat crumb: lambda-body names a global read
                                       // might be, resolved once teko_array.tk's own `N_GLOBAL`
                                       // rows exist -- there is no hook over a top-level
                                       // declaration (teko_array.tk's own header), so a name
                                       // this early check cannot place waits for `tk_deleg_pass`

// K4 (D221/§41): lambda, local named function, `use (a, &b)` -- the same
// object K1 wraps a plain function into, built inline where `new Op(...)`
// finds a `(` instead of a bare name. Defined at the end of this file, after
// the capture table and the reclaim helpers it shares with `teko_ref.tk`'s
// own `tk_arr_load`/`tk_arr_store`; forward-declared here for `tk_new_deleg`
// and `tk_deleg_return`, which run ahead of it in the file.
i64 tk_lambda_build(i64 si, i64 line, uptr fl);
i64 tk_lam_escapes(i64 e);

i64 dg_ret[TK_MAXSTRUCT];             // the declared return type
i64 dg_np[TK_MAXSTRUCT];              // how many parameters
i64 dg_pty[TK_MAXSTRUCT * TK_DGMAX];  // the parameter types, flattened
i64 dg_pk[TK_MAXSTRUCT * TK_DGMAX];   // ...and the `ref`/`out` kind of each (K2w)

i64  dg_ret_at(i64 i)         { return ld64(dg_ret + i * 8); }
i64  dg_np_at(i64 i)          { return ld64(dg_np + i * 8); }
i64  dg_pty_at(i64 si, i64 j) { return ld64(dg_pty + (si * TK_DGMAX + j) * 8); }
i64  dg_pk_at(i64 si, i64 j)  { return ld64(dg_pk + (si * TK_DGMAX + j) * 8); }

void set_dg_ret_at(i64 i, i64 v)         { st64(dg_ret + i * 8, v); }
void set_dg_np_at(i64 i, i64 v)          { st64(dg_np + i * 8, v); }
void set_dg_pty_at(i64 si, i64 j, i64 v) { st64(dg_pty + (si * TK_DGMAX + j) * 8, v); }
void set_dg_pk_at(i64 si, i64 j, i64 v)  { st64(dg_pk + (si * TK_DGMAX + j) * 8, v); }

// the slot a delegate parameter is declared at: an ADDRESS for a `ref`/`out`
// one (K2w), the pointee's own width otherwise
i64 dg_pslot_at(i64 si, i64 j) {
    if (dg_pk_at(si, j) != TK_RP_NONE) return TY_UPTR;
    return dg_pty_at(si, j);
}

uptr dgi_row[TK_MAXDGI];              // the delegate row a wrap targets
uptr dgi_fn[TK_MAXDGI];               // the function it wraps
uptr dgi_alloc[TK_MAXDGI];            // the allocator symbol already built for it
uptr dgi_thunk[TK_MAXDGI];            // the forwarder's own N_FUNC node (D63)
i64  tk_ndgi = 0;

i64  dgi_row_at(i64 i)   { return ld64(dgi_row + i * 8); }
uptr dgi_fn_at(i64 i)    { return ld64(dgi_fn + i * 8); }
uptr dgi_alloc_at(i64 i) { return ld64(dgi_alloc + i * 8); }
i64  dgi_thunk_at(i64 i) { return ld64(dgi_thunk + i * 8); }

void set_dgi_row_at(i64 i, i64 v)   { st64(dgi_row + i * 8, v); }
void set_dgi_fn_at(i64 i, uptr v)   { st64(dgi_fn + i * 8, v); }
void set_dgi_alloc_at(i64 i, uptr v) { st64(dgi_alloc + i * 8, v); }
void set_dgi_thunk_at(i64 i, i64 v) { st64(dgi_thunk + i * 8, v); }

// 1 when `f` is one of the forwarders `tk_deleg_thunk` below generates. This
// table IS the registry: one row per (delegate row, function) pair, and the
// forwarder's node is the row's fourth column -- so telling a thunk apart
// costs no state of its own and no name pattern. `Op__thunk_add` is a
// SPELLING, which teko_over.tk already reserves against a collision; the node
// is an identity, which is what a pass has to ask about.
//
// `tk_ref_pass` (teko_ref.tk) is what asks. A thunk is the one function in
// the tree whose body the COMPILER wrote argument by argument, out of
// `dg_pk_at`/`dg_pty_at`, over a target `tk_deleg_check_sig` has already
// proved identical to the delegate parameter by parameter: the forwarding is
// correct BY CONSTRUCTION and that pass has nothing there either to judge or
// to rewrite (D63, second pass). A LAMBDA's body is generated too and is NOT
// a thunk -- it holds the code the program wrote, and keeps every check the
// same code written inline would get.
i64 tk_deleg_is_thunk(i64 f) {
    i64 i = 0;
    loop {
        if (i >= tk_ndgi) break;
        if (dgi_thunk_at(i) == f) return 1;
        i = i + 1;
    }
    return 0;
}

// `Op(i64, i64)`, for a mismatch message
uptr tk_deleg_sig_str(i64 si) {
    uptr s = tk_join(sr_name_at(si), "(");
    i64 np = dg_np_at(si);
    i64 i = 0;
    loop {
        if (i >= np) break;
        if (i > 0) s = tk_join(s, ", ");
        i64 k = dg_pk_at(si, i);
        if (k != TK_RP_NONE) s = tk_join3(s, tk_ref_kindname(k), " ");
        s = tk_join(s, type_name(dg_pty_at(si, i)));
        i = i + 1;
    }
    return tk_join(s, ")");
}

// the row of a delegate row-index `ty` names, or -1 for anything else --
// teko_struct.tk's own type table, filtered to `TK_KDELEG`
i64 tk_deleg_row(i64 ty) {
    i64 si = tk_struct_by_ty(ty);
    if (si < 0) return 0 - 1;
    if (!tk_is_deleg(si)) return 0 - 1;
    return si;
}

// the same row with a `?` peeled off first: `Op?` is a row of its OWN
// (`TK_KNULL`, teko_struct.tk), which `tk_deleg_row` answers -1 for, and that
// -1 was reading as "this slot holds no delegate at all" at the two sites
// that guard D221 decision 21's first ESCAPE by the slot's type -- the plain
// global (`tk_deleg_assign`) and the element of a `T[]` (`tk_ha_index`,
// teko_heaparr.tk). So `Op? g; g = new Op((i64 x) use (&acc) => acc + x);`
// and `Op?[] xs; xs[0] = ...` parked the ADDRESS of a dead local in a slot
// that outlives it, where the very same write into an `Op`/`Op[]` is refused
// (D51, twelfth pass). A `?` says the slot may hold nothing; it says nothing
// about how long the slot LIVES, which is the only question the escape rule
// asks. Everything else about a `T?` -- `null`, the box, the coercion -- is
// the nullable row's own and keeps reading `tk_deleg_row`, which is what
// leaves `xs[0] = null` on an `Op?[]` accepted and on an `Op[]` refused.
i64 tk_deleg_row_under(i64 ty) {
    i64 si = tk_deleg_row(ty);
    if (si >= 0) return si;
    return tk_deleg_row(tk_nl_of(ty));
}

// the delegate row named `name`, or -1 for a plain type/no type at all: the
// early branch `tk_new()` takes before its own struct/class lookup. §50 O2
// ressalva 3: a row a use materialized ahead of its real declaration
// (`TK_PFWD`) is not a delegate YET -- `dg_ret`/`dg_np` are still unset --
// so it is left for `tk_new()`'s own struct/class path to report honestly,
// rather than answered here as a zero-parameter delegate.
i64 tk_deleg_find(uptr name) {
    i64 si = tk_struct_find(name);
    if (si < 0) return 0 - 1;
    if (sr_part_at(si) == TK_PFWD) return 0 - 1;
    if (!tk_is_deleg(si)) return 0 - 1;
    return si;
}

// `d`'s signature has to match `si`'s exactly: same arity, same return, same
// parameter types in order -- `add does not match the delegate Op(i64, i64)`
void tk_deleg_check_sig(i64 si, uptr fn, i64 d) {
    i64 np = dg_np_at(si);
    i64 ok = decl_nparams(d) == np && decl_ret(d) == dg_ret_at(si);
    i64 i = 0;
    loop {
        if (!ok) break;
        if (i >= np) break;
        if (tk_decl_param_ty(d, i) != dg_pty_at(si, i)) ok = 0;
        if (tk_rp_kind(tk_decl_param_node(d, i)) != dg_pk_at(si, i)) ok = 0;
        i = i + 1;
    }
    if (ok) return;
    err_at(tk_file, tk_line,
           tk_join(tk_join(tk_join("teko: ", fn), " does not match the delegate "),
                   tk_deleg_sig_str(si)));
}

// `i64 Op__thunk_add(uptr env, i64 a, i64 b) { return add(a, b); }` -- the
// ABI every delegate value shares, so a plain function needs a forwarder.
//
// A `ref`/`out` parameter is forwarded as the bare name too: the slot holds
// an ADDRESS already (`dg_pslot_at` declares it `uptr`, K2w), so the name IS
// what the callee wants -- never `&a0`, which would be the THUNK's own slot.
// Nothing says `ref` at this call site and nothing has to: the body is the
// COMPILER's, written out of `dg_pk_at`/`dg_pty_at` over a target
// `tk_deleg_check_sig` has already proved identical parameter by parameter,
// and `tk_ref_pass` (teko_ref.tk) does not judge it (D63, `tk_deleg_is_thunk`
// above).
i64 tk_deleg_thunk_fn(i64 si, uptr thunkname, uptr fn) {
    i64 prs = param_new(TY_UPTR, "env");
    i64 args = 0;
    i64 np = dg_np_at(si);
    i64 i = 0;
    loop {
        if (i >= np) break;
        uptr pn = tk_join("a", tk_num(i));
        prs = list_append(prs, param_new(dg_pslot_at(si, i), pn));
        args = list_append(args, tk_id(pn));
        i = i + 1;
    }
    i64 ret = dg_ret_at(si);
    i64 call = tk_call(fn, args);
    i64 body;
    if (ret == TY_VOID) body = tk_blk(tk_stmt(call));
    else                body = tk_blk(tk_ret(call));
    return tk_func(ret, thunkname, prs, body);
}

// `void Op__release_add(uptr this) { rt_free(this, 24); }` -- no capture in
// K1, so nothing but the block itself to hand back
i64 tk_deleg_release_fn(uptr relname) {
    i64 st = tk_stmt(tk_call2("rt_free", tk_id(tk_this_name()), tk_int(TK_DGOBJSIZE)));
    return tk_func(TY_VOID, relname, param_new(TY_UPTR, tk_this_name()), tk_blk(st));
}

// `Op Op__new_add() { ... }` -- the vtable's word 0 is filled on every call,
// idempotently, the same shape `tk_new_install` (teko_class.tk) fills a
// class's; the count starts at 1, the reference `new`/the coercion hands out
i64 tk_deleg_alloc_fn(i64 si, uptr allocname, uptr vtname, uptr relname, uptr thunkname) {
    i64 st = tk_var(TY_UPTR, "p", tk_call("rt_alloc", tk_int(TK_DGOBJSIZE)));
    st = list_append(st, tk_stmt(tk_call2("st64", tk_id(vtname), tk_addr(relname))));
    st = list_append(st, tk_stmt(tk_call2("st64", tk_id("p"), tk_id(vtname))));
    i64 cnt = tk_bin(K_ADD, tk_id("p"), tk_int(8));
    st = list_append(st, tk_stmt(tk_call2("st64", cnt, tk_int(1))));
    i64 code = tk_bin(K_ADD, tk_id("p"), tk_int(16));
    st = list_append(st, tk_stmt(tk_call2("st64", code, tk_addr(thunkname))));
    i64 r = tk_id("p");
    tk_xt_add(r, si, 1, TK_OWNED);                // a NAME, so pure; owned already, from the
                                                  // count above -- not an rc_inc
    st = list_append(st, tk_ret(r));
    return tk_func(sr_ty_at(si), allocname, 0, tk_blk(st));
}

// the allocator that wraps `fn` as a value of delegate row `si`, generated and
// memoized the first time the pair is asked for -- `Op__new_add`.
//
// K6: `new Op(fn)` is an EXPRESSION, so the four declarations below are added
// in the middle of the declaration that writes it -- through `tk_top_emit`
// (teko_struct.tk), never a bare `top_add`, which would clear
// `p_decl_name()` for the whole rest of that body and leave `tk_taint_owner`
// below with no owner to key K4b's own escapes by.
uptr tk_deleg_thunk(i64 si, uptr fn) {
    i64 i = 0;
    loop {
        if (i >= tk_ndgi) break;
        if (dgi_row_at(i) == si && str_eq(dgi_fn_at(i), fn)) return dgi_alloc_at(i);
        i = i + 1;
    }
    i64 d = decl_find(fn);
    if (d < 0 || !decl_valid(d)) err_at2(tk_file, tk_line, "teko: unknown function", fn);
    tk_deleg_check_sig(si, fn, d);
    uptr base = sr_name_at(si);
    uptr allocname = tk_join(tk_join(base, "__new_"), fn);
    uptr thunkname = tk_join(tk_join(base, "__thunk_"), fn);
    uptr vtname = tk_join(tk_join(base, "__vt_"), fn);
    uptr relname = tk_join(tk_join(base, "__release_"), fn);
    i64 thunk = tk_deleg_thunk_fn(si, thunkname, fn);
    tk_top_emit(thunk);
    tk_top_emit(tk_glb(TY_U8, vtname, TK_VT_FIXED * 8));
    tk_top_emit(tk_deleg_release_fn(relname));
    tk_top_emit(tk_deleg_alloc_fn(si, allocname, vtname, relname, thunkname));
    if (tk_ndgi == TK_MAXDGI) err_at(tk_file, tk_line, "teko: too many delegate targets");
    set_dgi_row_at(tk_ndgi, si);
    set_dgi_fn_at(tk_ndgi, fn);
    set_dgi_alloc_at(tk_ndgi, allocname);
    set_dgi_thunk_at(tk_ndgi, thunk);       // the node `tk_ref_pass` asks about (D63)
    tk_ndgi = tk_ndgi + 1;
    return allocname;
}

// `delegate i64 Op(i64 a, i64 b);` -- the parameter list's own types, read by
// the core's `parse_params()` (the exact grammar a delegate's own list needs)
// and kept; the names themselves are not
void tk_deleg_set_sig(i64 si, i64 ret, i64 prs, i64 line, uptr fl) {
    set_dg_ret_at(si, ret);
    i64 n = 0;
    i64 p = prs;
    loop {
        if (p == 0) break;
        if (n == TK_DGMAX)
            err_at(fl, line, "teko: method with too many parameters (the receiver counts, and so does the vtable pointer of a virtual call)");
        set_dg_pty_at(si, n, tk_param_ty(p));
        set_dg_pk_at(si, n, tk_rp_kind(p));
        n = n + 1;
        p = nd_next(p);
    }
    set_dg_np_at(si, n);
}

// `[public|internal] delegate T Name(params);` -- a top-level declaration,
// C#'s own default visibility (teko_access.tk's `tk_take_decl_vis`)
void tk_delegate() {
    i64 line = p_line();
    uptr fl = p_file();
    p_next();                                     // the `delegate` word
    i64 vis = tk_take_decl_vis();
    i64 proj = tk_take_decl_proj();
    i64 ret = p_type();
    uptr name = tk_newname("delegate");
    name = tk_ns_qualify(name);
    i64 ty = tk_type_word(name);
    i64 si = tk_type_add(name, ty, 0 - 1, TK_KDELEG, vis, proj);
    p_set_decl_name(name);
    i64 prs = parse_params();
    p_expect(K_SEMI, "expected ; after the delegate declaration");
    tk_deleg_set_sig(si, ret, prs, line, fl);
}

// `new Op(add)` / `Op f = add;`: the object `tk_deleg_thunk` allocates,
// re-typed to the delegate row `si`
i64 tk_deleg_wrap(i64 si, uptr fname, i64 line, uptr fl) {
    tk_line = line;
    tk_file = fl;
    i64 n = tk_call(tk_deleg_thunk(si, fname), 0);
    tk_xt_put(n, si, sr_ty_at(si), 0, TK_OWNED);
    return n;
}

// `new Op(add)`: valid anywhere `new` is, including a function-livre argument
// (D221 decision 19's explicit form). A `(` right after the outer one opens a
// lambda's own parameter list (K4, §41): `new Op((i64 a, i64 b) => a + b)`,
// never a plain function name, which is a bare identifier here.
i64 tk_new_deleg(i64 si, i64 line, uptr fl) {
    tk_check_type_use(si, line, fl);
    p_expect(K_LPAR, "expected ( after the delegate name");
    i64 r;
    if (p_id() == K_LPAR) r = tk_lambda_build(si, line, fl);
    else {
        i64 e = parse_expr(0);
        if (nd_kind(e) != N_IDENT)
            err_at(fl, line, "teko: `new Op(...)` takes the name of a function or a lambda");
        r = tk_deleg_wrap(si, nd_name(e), line, fl);
    }
    p_expect(K_RPAR, "expected ) after the delegate target");
    return r;
}

// a delegate call's own arguments, against the signature the delegate row
// carries -- the KIND of each parameter, and the TYPE behind it. The `callp`
// this function guards is built AFTER `tk_ref_pass` and names no callee, so
// neither that pass's own call check nor `tk_rc_call_args` (teko_rc.tk) ever
// sees it: this is the ONE door every argument of every delegate call passes,
// on all three roads (the bare name rewritten in `tk_deleg_pass`, a delegate
// FIELD through `tk_field_use`/teko_expr.tk, an `Op[]` ELEMENT through
// `tk_ha_deleg_call`/teko_heaparr.tk -- `tk_deleg_build` below is their only
// builder).
//
//   - the KIND: a `ref`/`out` slot is an ADDRESS (K2w), so an argument that
//     carries a value would be written through as if it were one. One rule,
//     one wording, the direct call's own (`tk_ref_check_kind`, teko_ref.tk).
//   - the POINTEE of a `ref`/`out` slot: `delegate void Mut(ref f64 x);
//     Mut m = bumpf; i64 g; m(ref g);` handed an `i64`'s address to a callee
//     that writes a double through it, where `bumpf(ref g)` written DIRECTLY
//     is refused `teko: a value of type i64 does not convert to f64` (D51,
//     twelfth pass).
//   - and, D59, the argument passed BY VALUE, which this door judged not at
//     all: `delegate i64 Op(i64); Op f = twice; f64 lf = 8.5; f(lf);` compiled
//     and handed the double's bit pattern to an integer parameter, on every
//     one of the three roads, where `twice(lf)` is refused. The CONVERSION
//     went missing with the check, and that half is silently wrong in a
//     program with nothing exotic in it: `delegate f64 F(f64); F f = half;
//     f(5);` passed the raw integer 5 where `half(5)` widens it (measured on
//     `f660795d`, exits 64 and 1 against the direct call's refusal and 25).
//
// Both judgements go through D57's own park (`tk_vca_park`, teko_typeof.tk):
// the parse-time oracle (`tk_pty_of`, teko_struct.tk) answers for a literal, a
// cast and an xt-tagged node on every road, and for a bare NAME only while the
// parser's own stack is live -- which the pass-8 road is not, so there every
// identifier parks. Everything else it cannot type parks too, a composite
// expression included: `f(1 + 2)` handed the integer 3 to an `f64` parameter
// unconverted until the park stopped reading the node's KIND (D59, second
// pass). A `ref`/`out` argument parks always: its pointee is read
// by the lexical scope and the globals (`tk_ref_arg_pointee`), tables the two
// parse-time roads stand before. What is parked is judged at the end of
// `tk_over_pass` (pass 14, `tk_vcall_arg_judge`), where the scope is live and
// every overload pick is committed; -1 back is "not known here" and the two
// readers below already understand it.
//
// The conversion is written IN PLACE (`tk_fs_convert`, teko_typeof.tk): this
// walk is over `nd_next` and holds no handle to relink with, so the node keeps
// its identity and BECOMES the cast -- the same shape the park's own judge
// writes, not `tk_vcall_args_check`'s splice.
void tk_deleg_check_arg_kinds(i64 si, i64 args, i64 line, uptr fl) {
    i64 a = args;
    i64 i = 0;
    loop {
        if (a == 0) break;
        i64 pk = dg_pk_at(si, i);
        i64 pt = dg_pty_at(si, i);
        tk_ref_check_kind(pk, a, i, line, fl);
        // a `ref`/`out` argument is an address, and no oracle at this door
        // types what it points at: it is parked unconditionally, and the park
        // judges it by the POINTEE rule rather than the by-value one.
        i64 at = 0 - 1;
        if (pk == TK_RP_NONE) at = tk_pty_of(a);
        at = tk_vca_park(pt, a, at, line, fl);
        if (at >= 0) {
            tk_check_compat(pt, at, a, line, fl);
            tk_fs_convert(pt, at, a);
        }
        i = i + 1;
        a = nd_next(a);
    }
}

// `code`/`obj`/`args` -> the typed `callp` expression, shared by the bare-call
// rewrite (`tk_deleg_call`) and a field call (teko_expr.tk's `tk_field_use`).
// `obj` is read TWICE -- once for the code pointer, once as the call's own
// object argument -- so it has to be pure; a name and a field load both are.
// The return type is NOT registered here: the node this builds may still be
// copied into another node's position by the caller (`node_assign`), and the
// xt table is keyed by node POSITION (teko_struct.tk), so the entry has to
// land on whatever identity actually ends up in the tree -- the caller's job,
// same split `tk_pend_do` (teko_typeof.tk) keeps between building and typing.
i64 tk_deleg_build(i64 si, i64 obj, i64 args, i64 na, i64 line, uptr fl) {
    tk_line = line;
    tk_file = fl;
    if (na != dg_np_at(si))
        err_at(fl, line, tk_join("teko: wrong number of arguments for ", sr_name_at(si)));
    tk_deleg_check_arg_kinds(si, args, line, fl);
    i64 code = tk_call("tk_deleg_code", tk_clone(obj));
    i64 call = tk_call("callp", list_append(list_append(code, obj), args));
    return tk_callp_ret(dg_ret_at(si), call);
}

// how many arguments an already-parsed sibling list holds
i64 tk_deleg_argc(i64 args) {
    i64 n = 0;
    i64 a = args;
    loop {
        if (a == 0) break;
        n = n + 1;
        a = nd_next(a);
    }
    return n;
}

// `f(3, 4)` where `f` is a local/parameter of delegate row `di`: rewritten IN
// PLACE into the typed `callp` above (hooks.md § pass())
i64 tk_deleg_call(i64 n, i64 di) {
    i64 line = nd_line(n);
    uptr fl = nd_file(n);
    i64 args = nd_a(n);
    i64 obj = tk_id(nd_name(n));
    i64 r = tk_deleg_build(di, obj, args, tk_deleg_argc(args), line, fl);
    tk_node_replace(n, r);
    // the node that ends up in the TREE is `n`, not `r` -- the count the
    // reclaim pass (teko_rc.tk) reads is by node POSITION, so the entry has
    // to be under `n`'s identity or a counted return (`Cell c = f(7);`)
    // reads as "borrowed" and picks up an rc_inc it never sheds
    i64 ret = dg_ret_at(di);
    tk_xt_put(n, tk_struct_by_ty(ret), ret, 0, TK_OWNED);
    return n;
}

i64 tk_deleg_cur_ns = 0;              // the namespace of the function this pass walks
i64 tk_deleg_cur_ret = 0 - 1;          // the declared return type of the function this pass walks
i64 tk_deleg_root = 0;                 // the unit, for the same decl-count guard C6 already uses

i64 tk_default_decl_count(i64 root, uptr name);   // teko_default.tk, included after this file

// `gadd`, named bare inside `namespace geo { ... }`, is not this pass's own
// call/const rewrite (teko_ns.tk's `tk_ns_pass` ran first and only touches an
// `N_CALL`/`N_ADDR`/a const `N_IDENT`) -- a plain function reference is left
// exactly as the source wrote it, so the wrap has to run the same
// namespace/`using` search a call already gets, in the SAME order.
//
// That order is `tk_ns_rewrite_call`'s (teko_ns.tk, N3b/N3c, D31.6): the
// site's own namespace and its prefixes outward FIRST, then a plain top-level
// declaration of the exact bare name, and only then the `using`s of the file.
// This function asked `decl_find` first and had the first two steps the wrong
// way round, so inside `namespace geo` a bare `col` wrapped the flat `col`
// while `col(2, 3)` one line over called `geo__col` -- the same name, two
// different functions, silently, with no diagnostic anywhere (D62, the
// namespace pass; measured on `441be45a` too, where every road that reaches
// this resolver -- a local initializer, an assignment, `new Op(f)`, a call
// argument, a `return`, an element of an `Op[]` -- already carried it, so the
// field road only inherited it). The steps ahead of the namespace one in
// `tk_ns_rewrite_call` are already answered before this function is reached:
// a LOCAL, a PARAMETER or a GLOBAL of the name is exactly what
// `tk_deleg_coerce`'s own guard (`tk_ty_scope_or_global`) refuses to wrap.
uptr tk_deleg_resolve_fn(uptr fname, i64 line, uptr fl) {
    i64 d = tk_ns_call_try_prefixes(fname, tk_deleg_cur_ns);
    if (d < 0 && decl_find(fname) >= 0) return fname;
    if (d < 0) d = tk_ns_call_try_usings(fname, fl, line);
    if (d < 0) return fname;
    return nd_name(d);
}

// `teko: Op takes a function, another Op, or null`
uptr tk_deleg_mismatch_msg(i64 si) {
    uptr nm = sr_name_at(si);
    return tk_join(tk_join3("teko: ", nm, " takes a function, another "), tk_join(nm, ", or null"));
}

// the one validator every slot of delegate type `si` shares -- a var
// initializer, an assignment, a call argument, a `return`. Only four shapes
// read a delegate object correctly: `null`, a call already typed `si` (a
// local/param/field, or a plain function's return), a compatible function
// name (wrapped here, the same thunk a var declaration gets), or a value a
// nested delegate call already answers with row `si`. Anything else -- a
// literal, arithmetic, a mismatched type -- is a silent wrong-width copy
// that segfaults the first time the slot is called
i64 tk_deleg_coerce(i64 si, i64 e, i64 line, uptr fl) {
    if (e == 0) return e;
    // `null` -- and only `null` (D51, eighth pass): `tk_is_null_lit`
    // (teko_struct.tk) asks the TY_UPTR type `tk_null` alone carries, so a
    // plain `i64` literal `0` (same N_INT kind, same zero value) falls
    // through to the mismatch check below instead of passing as null.
    //
    // ...and `null` lands ONLY in a slot declared `T?` (Q1a,
    // docs/specs/nullable.md rule 1) -- the same words, from the same rule,
    // `tk_check_field_store` (teko_struct.tk) and `tk_check_scalar_compat`
    // (teko_typeof.tk) give every other slot. `si` is a DELEGATE row, and a
    // `T?` is a row of its own (`TK_KNULL`, which `tk_deleg_row` answers -1
    // for), so a `null` reaching this validator is always one written into a
    // slot that was not declared to hold it. Returning it unjudged was
    // harmless only while some later check saw the same store: a store into an
    // element of an `Op[]` is coerced HERE and nowhere else once it waits for
    // the walk (`tk_deleg_late_do` below calls this validator alone, and
    // `tk_check_field_store` is skipped for a late value), so
    // `ops[0] = flag ? null : null` -- both branches recursed into just below
    // -- wrote a null into a non-nullable element and panicked at the first
    // call through it, `teko: call through a null delegate` (D51, tenth pass).
    if (tk_is_null_lit(e)) {
        if (!tk_nl_own_null_is(e))
            err_at(fl, line, tk_join3("teko: null needs a slot declared ", sr_name_at(si), "?"));
        return e;
    }
    if (nd_kind(e) == N_CALL && str_eq(nd_name(e), "tk_ternary")) {
        i64 c = nd_a(e);                          // K4c item 3: `c ? a : b`, still the
        i64 a = nd_next(c);                       // raw placeholder here (this pass runs
        i64 b = nd_next(a);                       // ahead of teko_ternary.tk's own lowering)
        set_nd_next(c, tk_deleg_coerce(si, a, line, fl));
        set_nd_next(nd_next(c), tk_deleg_coerce(si, b, line, fl));
        return e;
    }
    // a bare name NO SLOT declares is a function to wrap. A global is a slot
    // like any local (D51), so this guard has to read the same fallback the
    // dispatch points around it read: `tk_ty_scope_find` alone made a
    // delegate-typed GLOBAL on the right (`h = g_op;`, `f(g_op)`,
    // `return g_op;`) a wrap of a function nothing declares --
    // `teko: unknown function: g_op` on a program with no error in it. A free
    // function's own name is in no slot table at all, global or local, so it
    // still answers -1 here and is still wrapped.
    if (nd_kind(e) == N_IDENT && tk_ty_scope_or_global(nd_name(e)) < 0)
        return tk_deleg_wrap(si, tk_deleg_resolve_fn(nd_name(e), line, fl), line, fl);
    if (tk_ty_of(e) == sr_ty_at(si)) return e;
    err_at(fl, line, tk_deleg_mismatch_msg(si));
    return e;
}

// ---- the one caller of the validator that runs where NO oracle answers ----
// `ops[i] = e` on an `Op[]` is coerced by `tk_ha_store` (teko_heaparr.tk), and
// that store is built at PARSE time for a local array and inside
// `tk_array_pass` for a global one -- both of them ahead of the scope walk and
// of `tk_hg_collect`'s own global rows. So the guard above read -1 for every
// NAME written there, whatever declared it, and wrapped it as a function:
// `ops[0] = g_op;` (a global), `ops[0] = lo;` (a local), `ops[0] = p;` (a
// parameter) and `ops[0] = laterFn;` (a function declared further down the
// file) all died `teko: unknown function: ...` on a program with no error in
// it, and `ops[0] = g_n;` on an `i64` global died with the same misleading
// words instead of the delegate's own mismatch. A global `Op[]` was worse
// still: `tk_array_resolve_write` (teko_array.tk) builds its store with no
// coercion at all, so `g_ops[0] = addOne;` stored a raw function pointer and
// the core refused the bare name, `unknown name` -- never a `teko: ...`
// refusal (D20).
//
// The value is JUDGED WHERE NAMES HAVE TYPES, the same answer D48's own
// `tk_prim_arg_defer` gives for the argument a parse-time column cannot type:
// the store is recorded here and coerced during `tk_deleg_walk`, which is the
// one walk that carries both halves of the question at once -- the LEXICAL
// scope at the site (`tk_ty_scope_var`, a mark per block) and every global row
// (`tk_array_pass` runs before `tk_deleg_pass`, teko.tk). What waits is what
// the site's own oracles cannot settle, and the seventh pass below moved the
// line: a bare NAME the pass-time scope or a global row answers is settled
// here, and every CALL waits -- a `new Op(...)`, a lambda and a ternary
// included, each of them an `N_CALL` of its own (`tk_deleg_store_late`, whose
// header states the rule in full). No accepted program's tree moves either
// way (the 62 dumps of `da33ebd4`), because a WRAP is the only thing this
// validator ever rewrites and only a bare name is ever wrapped.
// A ceiling of its OWN, and measured rather than derived (D51, seventh pass).
// The fifth pass raised it from 64 to 512 by reading `TK_MAXGDEF` (512,
// teko_array.tk), the writes into a possibly-global array that wait for
// `tk_array_pass` -- but a LOCAL store never passes through that table at all,
// so the derivation named the wrong feeder. What every row here really costs
// first is a row of `TK_MAXOS` (teko_struct.tk): a delegate is a counted
// type, so `tk_os_mark` records EVERY element store of one, local or global,
// in a table that is never reset within a unit. While `TK_MAXOS` was 128 a
// program with 513 ordinary local stores was refused at the 129th, `teko: too
// many stores into a slot of class type`, and never reached this table. D69
// raised `TK_MAXOS` to 4096, so this table's own ceiling is the one such a
// program meets now: the 513th store refuses `teko: too many element stores
// of unknown type`. Left at 512 -- no fixture comes near it.
#define TK_MAXDGLATE 512              // element stores waiting for the pass

i64  dl_node[TK_MAXDGLATE];           // the store call, `stW(tk_arr_at(...), v)`
i64  dl_si[TK_MAXDGLATE];             // the delegate row the ELEMENT type is
i64  dl_line[TK_MAXDGLATE];
uptr dl_file[TK_MAXDGLATE];
i64  dl_done[TK_MAXDGLATE];
i64  dl_esc[TK_MAXDGLATE];            // ...and whose ESCAPE is unjudged as well
i64  dl_val[TK_MAXDGLATE];            // 1 = `dl_node` IS the value (a FIELD store's, D62)
i64  tk_ndglate = 0;

// D51 (eighth pass), the walk's own cost: `tk_deleg_late_pend` runs at EVERY
// node the walk visits while a store still waits, `tk_deleg_walk`'s own
// `tk_deleg_visit` call at the top of the loop -- a program the size of this
// compiler's own source visits on the order of 150K nodes there, and a linear
// scan of the table at each one (the loop this replaces) is a table lookup
// PER NODE, not a lookup per store: 512 comparisons apiece, most of them a
// store some earlier or later FUNCTION owns and this node can never be. A
// bucket keyed by the node id itself turns "does any waiting store name this
// node" into the one or two comparisons its own chain holds, node ids being a
// dense, always-positive sequence (`node_new`, mc's ast.mc) that spreads
// evenly over a fixed table of buckets no matter how the source is shaped.
#define TK_DGBUCKETS 1024

i64  dl_bucket[TK_DGBUCKETS];         // 0 = empty; else 1 + the newest entry here
i64  dl_chain[TK_MAXDGLATE];          // 0 = chain ends; else 1 + the next entry sharing it

// `dl_chain` is ONE link per entry, not one per (entry, bucket) pair, so an
// entry belongs to exactly one bucket at a time and `tk_deleg_late_move` has
// to take it out of the old one before putting it in the new. Inserting
// without unlinking -- what the eighth pass wrote, calling the stale slot a
// harmless dead link -- overwrites `dl_chain[i]` with the NEW bucket's head
// and so cuts the old chain at `i`: everything behind `i` there stops being
// reachable, and when the two buckets coincide the entry points at itself and
// `tk_deleg_late_pend` never leaves the loop (D51, ninth pass). Both were
// measured, see the entry in DECISION_LOG.md.
void tk_dg_bucket_remove(i64 i, i64 n) {
    i64 b = n % TK_DGBUCKETS;
    i64 h = ld64(dl_bucket + b * 8);
    if (h == i + 1) {
        st64(dl_bucket + b * 8, ld64(dl_chain + i * 8));
        return;
    }
    loop {
        if (h == 0) break;
        i64 j = h - 1;
        i64 nx = ld64(dl_chain + j * 8);
        if (nx == i + 1) {
            st64(dl_chain + j * 8, ld64(dl_chain + i * 8));
            break;
        }
        h = nx;
    }
}

void tk_dg_bucket_insert(i64 i, i64 n) {
    i64 b = n % TK_DGBUCKETS;
    st64(dl_chain + i * 8, ld64(dl_bucket + b * 8));
    st64(dl_bucket + b * 8, i + 1);
}

i64  dl_node_at(i64 i) { return ld64(dl_node + i * 8); }
i64  dl_si_at(i64 i)   { return ld64(dl_si + i * 8); }
i64  dl_line_at(i64 i) { return ld64(dl_line + i * 8); }
uptr dl_file_at(i64 i) { return ld64(dl_file + i * 8); }
i64  dl_done_at(i64 i) { return ld64(dl_done + i * 8); }
i64  dl_esc_at(i64 i)  { return ld64(dl_esc + i * 8); }
i64  dl_val_at(i64 i)  { return ld64(dl_val + i * 8); }

// ---- a store built where NOTHING can be judged (D51, fourth pass) ----
// A GLOBAL `T[]`'s own element store is assembled inside `tk_array_pass`
// (`tk_hg_resolve_write`, teko_array.tk) -- a pass, with no lexical scope
// around it at all: no local, no parameter and no shadow of a global is
// visible there, and the parser's own tables were cut back long ago. The
// third pass gave that store the SAME validator the parse-time one has, which
// judged it against the only rows in reach, the globals: a local `i64 g`
// shadowing a delegate global `Op g` typed as the GLOBAL and stored the
// local's bits; a local `Op f` beside a free function `f` was read as the
// FUNCTION and wrapped; a call through a local delegate (`g_ops[0] =
// chooser(0)`) could not be typed at all and was refused outright. And the
// escape rule `tk_ha_index` runs at its own parse site never ran there, so
// `g_ops[0] = new Op((i64 y) use (&x) => x + y)` parked a capture by the
// ADDRESS of a local in a global that outlives it.
//
// One flag, one rule: a store built in the pass judges NOTHING where it is
// built -- not the coercion, not the type of the value, not the escape -- and
// the whole of it waits for `tk_deleg_walk`, which stands at the site with the
// lexical scope live, the globals collected and the function that owns the
// store known (`tk_cur_fn_name`, the escape rule's own owner). One judgement
// point for a local store (the parse site) and one for a global store (the
// walk), and the same decision function at both.
i64 tk_deleg_defer_all = 0;

void tk_deleg_defer_all_set(i64 on) { tk_deleg_defer_all = on; }

// "the store's own oracles cannot settle this value". ONE rule, whatever
// shape the value has: what the site's own oracles TYPE is judged where it is
// written, and what they do not type waits for the walk -- the same rule the
// store built in a pass takes for every value it holds. `null` means the same
// thing at every site, so it never takes a row of the table.
//
// A bare NAME is settled here only when the site's own two slot oracles name
// it -- the pass-time scope or a global row, both empty at parse time and both
// live once `tk_array_pass` has run -- and waits otherwise. There is no third
// table to ask: `decl_find` answers "a function of that name has been read so
// far", which is not the question, because a PARAMETER of the enclosing
// function shadows that function and nothing the parser keeps records one.
// `storeParam(Op p) { ops[0] = p; }` written under a free `i64 p(i64)` stored
// a wrap of the FUNCTION and called it -- a silent wrong answer, on the base
// exactly as here (D51, sixth pass). `tk_pty_of` (teko_struct.tk) is the same
// dead end: it records a declaration and never a parameter, so it cannot tell
// the two apart either. The WALK can, and that is where the name goes: a
// parameter stands in `tk_ty_scope_var` exactly as a local does, and a name
// nothing there names is the function to wrap.
//
// A CALL is the same dead end, for the same reason (D51, seventh pass). The
// site asked `tk_ty_of`, whose own delegate arm (D61) reads the pass-time
// scope for a call THROUGH a delegate slot -- empty here -- and then falls to
// `decl_find` for the FIRST declaration of that name, with no scope and no
// overload table in front of it. Both of its answers were wrong and in
// opposite directions: a LOCAL delegate `chooser` shadowing a function
// `chooser` was typed by the FUNCTION's return, so `ops[0] = chooser(1)` was
// refused over a type nothing in the program stores; and an overload whose
// first declaration answers `Op` while the one the call actually picks
// answers something else typed as `Op`, was settled here, and the value the
// pick returns was written into an `Op[]` unchecked -- a call through it
// segfaults. Neither shape can be told apart from the other WITHOUT the scope
// and the prepared overloads, which is the walk. So every call waits, the
// same rule D50's own `tk_fs_vty` takes ("a call whose return only the pass
// resolves is not this early check's to guess at") and the same one D48 takes
// for an argument.
//
// A ternary is an `N_CALL` of `tk_ternary`, so it waits with them -- one line
// less than the branch-by-branch recursion the sixth pass needed here, and the
// same verdict, because a bare NAME in a branch is already late at this site
// (the two slot oracles above are empty until `tk_array_pass` has run). The
// validator still takes it APART where it is judged; it is the walk that
// judges it now.
//
// Every OTHER shape asks `tk_ty_of`, which is the oracle the
// validator itself would ask one line later: an element read, a literal,
// arithmetic -- what the node itself types, with no table in between. A
// `new Op(...)` and a lambda are calls to their own allocator, so they wait
// with the rest and the walk gives them the same answer this site had (the
// allocator is a declaration of the unit, and the node carries a `tk_xt_put`
// row of its own besides). Nothing that waits can be WRAPPED -- only a bare
// name is -- and a wrap is what moves a tree, four declarations through
// `tk_top_emit`: which is why no accepted program's dump moves when a call
// waits (the dumps of `da33ebd4`).
i64 tk_deleg_store_late(i64 si, i64 v) {
    if (si < 0 || v == 0) return 0;
    // `null`, the same answer anywhere -- and ONLY `null`: `nd_kind(v) ==
    // N_INT && nd_val(v) == 0` also matches an ordinary `i64` literal `0`
    // (TY_I64), so `tk_is_null_lit` (teko_struct.tk), which checks the
    // TY_UPTR type `tk_null` alone carries, is what this site has to ask
    // (D51, eighth pass) -- `ops[0] = 0;` waited here unjudged and stored a
    // bare zero where a wrong-width copy segfaults the first call.
    if (tk_is_null_lit(v)) return 0;
    if (tk_deleg_defer_all) return 1;             // built in a pass: judge nothing here
    if (nd_kind(v) == N_IDENT) return tk_ty_scope_or_global(nd_name(v)) < 0;
    if (nd_kind(v) == N_CALL) return 1;           // a CALL is the pass's own answer, never this site's
    return tk_ty_of(v) != sr_ty_at(si);
}

void tk_deleg_store_defer(i64 st, i64 si, i64 line, uptr fl) {
    if (tk_ndglate == TK_MAXDGLATE)
        err_at(fl, line, "teko: too many element stores of unknown type");
    st64(dl_node + tk_ndglate * 8, st);
    st64(dl_si + tk_ndglate * 8, si);
    st64(dl_line + tk_ndglate * 8, line);
    st64(dl_file + tk_ndglate * 8, fl);
    st64(dl_done + tk_ndglate * 8, 0);
    st64(dl_esc + tk_ndglate * 8, tk_deleg_defer_all);
    st64(dl_val + tk_ndglate * 8, 0);
    tk_dg_bucket_insert(tk_ndglate, st);
    tk_ndglate = tk_ndglate + 1;
}

// ---- D62: a bare NAME stored into a FIELD of delegate type ----
// The one door every field store is built by (`tk_field_store_val`,
// teko_typeof.tk) hands the value here BEFORE it parks it as "type not known":
// every caller of that door had the element road's validator missing, so
// `h.cb = twice;` on an `Op cb` field died `teko: the type of this value is
// not known here` while `Op cb = twice;` one slot over wraps the function
// (D51). One detection, one judge, and the door's callers are ALL of them --
// `p.f = e` and `this.f = e` (`tk_field_use`, teko_expr.tk), the implicit
// `f = e` of a method or constructor (`tk_this_assign`, teko_this.tk), the
// two static ones (`tk_static_use` and `tk_fwd_resolve_static_one`,
// teko_access.tk), an element of an array FIELD (`tk_array_index`,
// teko_struct.tk) and a store through a receiver typed at pass time
// (`tk_pend_field`, teko_typeof.tk). Two more callers exist and carry no
// delegate: a FIXED array's element (`tk_arr_elem_store`, teko_array.tk),
// whose declaration is refused for a delegate element type, and a `T[]`'s
// (`tk_ha_store`, teko_heaparr.tk), where a bare name is parked by the
// element road's own validator and never reaches the door.
//
// A bare N_IDENT is the whole of what waits here, and it is exactly what the
// door cannot type: a free function's name is in no slot table, so
// `tk_pty_of` answers -1 for it, and so does it for a PARAMETER of delegate
// type (`tk_pty_of` records declarations, never parameters -- D51's sixth
// pass measured the same dead end for an element). Everything the door DOES
// type keeps the verdict it has today, unmoved: a local of delegate type, a
// `new Op(...)`, a call, a literal. The value is not judged here for the same
// reason the element road does not judge one either -- `tk_deleg_coerce`
// reads `tk_ty_scope_or_global`, and at a parse-time door no scope answers
// for any name at all, not even to be asked (the hazard teko_typeof.tk's own
// `tk_fs_vty` header spells out in full).
//
// What is parked is the VALUE node, never a store call: the door returns the
// value and its callers build the store around it afterwards, so there is
// no store node to key on yet. The value node is in the tree all the same --
// the walk reaches it as the second argument of the store it ends up in --
// and `tk_deleg_val_do` below rewrites it IN PLACE, the same `tk_node_replace`
// answer `tk_fs_convert` (teko_typeof.tk) gives a field store's own widening
// for the same reason: the slot that holds the value keeps no handle anyone
// here could re-point.
i64 tk_deleg_field_late(i64 fty, i64 v, i64 line, uptr fl) {
    if (v == 0) return 0;
    if (nd_kind(v) != N_IDENT) return 0;
    i64 si = tk_deleg_row(fty);
    if (si < 0) return 0;                         // an `Op?` field is a row of its own
    tk_deleg_store_defer(v, si, line, fl);
    st64(dl_val + (tk_ndglate - 1) * 8, 1);       // the row it just took
    return 1;
}

// D62's own half: the node parked IS the value, and the coercion is written
// over its identity. Only a WRAP ever comes back different here (a bare name
// is the only shape parked, and a ternary/`null` never reaches this table
// from the field door), so the node that ends up in the tree is `v` carrying
// the wrap's content and the wrap's own registrations -- `tk_xt_put` in
// `tk_deleg_wrap` tags the row by node id, which is what `tk_xt_move` carries
// over. The store around it was marked by its own site (`tk_os_mark`), so
// nothing of the reclaim pass's own bookkeeping is this function's to move.
void tk_deleg_val_do(i64 i) {
    i64 v = dl_node_at(i);
    i64 nv = tk_deleg_coerce(dl_si_at(i), v, dl_line_at(i), dl_file_at(i));
    if (nv == v) return;
    tk_node_replace(v, nv);
    tk_xt_move(nv, v);
}

// the value is the SECOND argument of the store (`tk_call2`, teko_struct.tk),
// read from the list rather than remembered, so a pass that rewrote the node
// in between is judged as it stands now. A wrap hands back a new node, and the
// list link is what takes it -- the same splice `tk_deleg_check_call_args`
// makes over an argument list, and no node ever has to change identity.
//
// The escape comes first, and only for a store that was built where the rule
// could not run (`dl_esc`, the global `T[]` write above): it is the same
// verdict over the same value `tk_ha_index` takes at a local store's own parse
// site, in the same words, from the one walk that knows which function owns
// the store (`tk_cur_fn_name`, read by `tk_taint_owner`). A local store's
// escape was already judged where it was written, and judging it again here
// would read a taint the site itself could not see yet.
//
// `dl_si` is -1 for the one entry that waits for the ESCAPE alone: a global
// `Op?[]`'s element, whose `null` and whose type the door already judged
// where the store was built (`tk_ha_store`, teko_heaparr.tk), and whose row
// is a nullable one no delegate validator may be handed -- `tk_deleg_coerce`
// would refuse the very `null` that element is declared to hold.
void tk_deleg_late_do(i64 i) {
    if (dl_done_at(i)) return;
    st64(dl_done + i * 8, 1);
    if (dl_val_at(i)) { tk_deleg_val_do(i); return; }
    i64 a = nd_a(dl_node_at(i));
    if (a == 0) return;
    i64 v = nd_next(a);
    if (v == 0) return;
    if (dl_esc_at(i) && tk_lam_escapes(v))
        err_at(dl_file_at(i), dl_line_at(i),
               "teko: a lambda that captures by reference cannot leave its scope");
    if (dl_si_at(i) < 0) return;
    i64 nv = tk_deleg_coerce(dl_si_at(i), v, dl_line_at(i), dl_file_at(i));
    if (nv == v) return;
    set_nd_next(nv, nd_next(v));
    set_nd_next(a, nv);
}

// `tk_hg_resolve_write` (teko_array.tk) COPIES the store it just built into
// the placeholder node the tree already holds (`node_assign`) and drops the
// one it built, so a deferral recorded against that one points at an orphan no
// walk will ever reach. It re-points here -- the same re-mark `tk_os_add`
// makes one line below it, for the same reason.
void tk_deleg_late_move(i64 from, i64 to) {
    i64 i = tk_ndglate - 1;
    loop {
        if (i < 0) break;
        if (dl_node_at(i) == from) {
            tk_dg_bucket_remove(i, from); // out of the old chain BEFORE the new
            st64(dl_node + i * 8, to);    // one takes `dl_chain[i]` -- see above
            tk_dg_bucket_insert(i, to);
        }
        i = i - 1;
    }
}

// the hot path of the whole walk (D51, eighth pass): the chain this node's
// own bucket holds, never the full table -- see the bucket's own header for
// the cost this replaces.
void tk_deleg_late_pend(i64 n) {
    i64 h = ld64(dl_bucket + (n % TK_DGBUCKETS) * 8);
    loop {
        if (h == 0) break;
        i64 i = h - 1;
        if (dl_node_at(i) == n) tk_deleg_late_do(i);
        h = ld64(dl_chain + i * 8);
    }
}

// ...and a store the walk never reached is judged all the same, with the
// scope closed: a value no body's scope can name is a global or a function,
// and the two tables that answer those are live for the whole pass. Silence
// is the one answer this table may not give -- it exists because the guard
// above was skipping a check, not because the check is optional.
void tk_deleg_late_rest() {
    i64 i = 0;
    loop {
        if (i >= tk_ndglate) break;
        tk_deleg_late_do(i);
        i = i + 1;
    }
}

// `Op f = add;` / `Op f = new Op(mul);` / `Op maybe = null;` -- a local or
// field initializer of delegate type `si`
void tk_deleg_var(i64 n) {
    if (nd_val(n) != 0) return;                   // `Op tbl[4]`: references
    i64 si = tk_deleg_row(nd_type(n));
    if (si < 0) return;
    set_nd_a(n, tk_deleg_coerce(si, nd_a(n), nd_line(n), nd_file(n)));
}

// `f = add;` on a local/parameter of delegate type -- the assignment form of
// the initializer above. A qualified target (`h.cb = e;`) is a different
// node shape entirely (teko_expr.tk's field store), untouched here.
//
// A GLOBAL target is the one that OUTLIVES the scope it is written in, so it
// takes D221 decision 21's first escape exactly as `return` above does:
// `g_op = local;` with `local` holding a lambda that captured by reference,
// or `g_op = new Op(... use (&acc) ...)` written straight into the global,
// parked the ADDRESS of a dead local in a slot that survives the call. The
// field, the static field and the element of a `T[]` already carry the same
// verdict; the plain global slot was the one write of a delegate that had
// none. A LOCAL target keeps the taint PROPAGATION it always had
// (`tk_lam_taint_stmt` above) and no refusal: `Op local2 = local;` and
// `local2 = local;` stay inside the scope that owns the capture.
//
// The escape asks `tk_deleg_row_under`, not `tk_deleg_row`: an `Op?` global
// is a `TK_KNULL` row of its own, so the guard that used to leave before
// reaching the rule left every `Op? g; g = new Op(... use (&acc) ...)`
// accepted while the `Op` beside it was refused -- a dangling capture in a
// slot the caller outlives (D51, twelfth pass). The COERCION stays on
// `tk_deleg_row`, which is what keeps `Op? g = null;` the nullable row's own
// business.
void tk_deleg_assign(i64 n) {
    i64 tty = tk_ty_scope_or_global(nd_name(n));
    i64 esi = tk_deleg_row_under(tty);
    if (esi < 0) return;
    if (tk_ty_scope_find(nd_name(n)) < 0 && tk_lam_escapes(nd_a(n)))
        err_at(nd_file(n), nd_line(n), "teko: a lambda that captures by reference cannot leave its scope");
    i64 si = tk_deleg_row(tty);
    if (si < 0) return;
    set_nd_a(n, tk_deleg_coerce(si, nd_a(n), nd_line(n), nd_file(n)));
}

// `return add;` / `return f(x);` from a function declared to answer a
// delegate type. D221 decision 21's first escape: a lambda that captures a
// name by reference dies with the scope that owns it, so handing the
// closure back to the caller is refused here, where it is rebaixed.
void tk_deleg_return(i64 n) {
    if (tk_lam_escapes(nd_a(n)))
        err_at(nd_file(n), nd_line(n), "teko: a lambda that captures by reference cannot leave its scope");
    if (tk_deleg_cur_ret < 0) return;
    i64 si = tk_deleg_row(tk_deleg_cur_ret);
    if (si < 0) return;
    set_nd_a(n, tk_deleg_coerce(si, nd_a(n), nd_line(n), nd_file(n)));
}

// every argument of a call to a function declared ONCE in the unit (an
// overloaded name is `teko_over.tk`'s call to make, later, and is left
// alone here -- the same guard `tk_default_pass`'s own arg-filling uses):
// each parameter of delegate type gets the one validator above, the argument
// list spliced in place when a bare function name needs its wrap
void tk_deleg_check_call_args(i64 n) {
    uptr name = nd_name(n);
    if (tk_default_decl_count(tk_deleg_root, name) != 1) return;
    i64 d = decl_find(name);
    if (d < 0) return;
    i64 np = decl_nparams(d);
    i64 i = 0;
    i64 prev = 0;
    i64 a = nd_a(n);
    loop {
        if (i >= np || a == 0) break;
        i64 nxt = nd_next(a);
        i64 psi = tk_deleg_row(tk_decl_param_ty(d, i));
        if (psi >= 0) {
            i64 fixed = tk_deleg_coerce(psi, a, nd_line(a), nd_file(a));
            if (fixed != a) {
                set_nd_next(fixed, nxt);
                if (prev == 0) set_nd_a(n, fixed);
                else set_nd_next(prev, fixed);
                a = fixed;
            }
        }
        prev = a;
        a = nxt;
        i = i + 1;
    }
}

void tk_deleg_visit(i64 n) {
    i64 k = nd_kind(n);
    if (tk_ndglate > 0) tk_deleg_late_pend(n);    // an element store, judged in scope
    if (k == N_VAR)    { tk_deleg_var(n);    return; }
    if (k == N_ASSIGN) { tk_deleg_assign(n); return; }
    if (k == N_RETURN) { tk_deleg_return(n); return; }
    if (k != N_CALL) return;
    i64 di = tk_deleg_row(tk_ty_scope_or_global(nd_name(n)));
    if (di >= 0) { tk_deleg_call(n, di); return; }
    tk_deleg_check_call_args(n);
}

// the same shape teko_typeof.tk's own `tk_ty_walk_list` walks a function's
// body in -- a block scoped, marked and cut back, a local joining scope only
// after its own initializer is walked -- but a walk OF ITS OWN rather than a
// reuse of that one: `tk_deleg_var`'s namespace lookup needs to know which
// function it is inside (`tk_deleg_cur_ns`), which is set per top-level
// N_FUNC below, and the shared walk has nowhere to carry that
void tk_deleg_walk(i64 n) {
    loop {
        if (n == 0) break;
        tk_deleg_visit(n);
        if (nd_kind(n) == N_BLOCK) {
            i64 mark = tk_nscope;
            tk_deleg_walk(nd_a(n));
            tk_nscope = mark;
        } else {
            tk_deleg_walk(nd_a(n));
            tk_deleg_walk(nd_b(n));
            tk_deleg_walk(nd_c(n));
            tk_deleg_walk(nd_d(n));
            tk_ty_scope_var(n);
        }
        n = nd_next(n);
    }
}

// ---- K4: lambda, local named function, `use (a, &b)` (D221/§41) ----

uptr lamref_name[TK_MAXLAMREF];       // allocator names whose lambda owns >= 1 by-reference capture
i64  tk_nlamref = 0;
i64  tk_nlam = 0;                     // gensym counter, unique over the whole unit
i64  tk_lam_body_depth = 0;           // > 0 while the token stream is reading a lambda's own body

// teko_di.tk (included before this file) reads this to refuse an `inject`
// lexically inside a lambda's own body that is itself lexically inside an
// open `scope { }` (DI4).
i64 tk_lam_in_body() { return tk_lam_body_depth > 0; }

void tk_lamref_add(uptr name) {
    if (tk_nlamref == TK_MAXLAMREF) err_at(tk_file, tk_line, "teko: too many capturing lambdas");
    st64(lamref_name + tk_nlamref * 8, name);
    tk_nlamref = tk_nlamref + 1;
}

i64 tk_lamref_has(uptr name) {
    i64 i = 0;
    loop {
        if (i >= tk_nlamref) break;
        if (str_eq(ld64(lamref_name + i * 8), name)) return 1;
        i = i + 1;
    }
    return 0;
}

// K4b (D221/§41, item 2 of the verifier's own ressalva): a NAME that holds
// the value of an escaping lambda, not the allocator CALL itself -- `Op f =
// new Op(...) use (&acc) => ...; return f;` is the same escape as `return
// new Op(...) use (&acc) => ...;`, one indirection later. Flow-insensitive
// WITHIN one function by design: once a name is tainted it stays tainted for
// the rest of the function, a strict superset of the UB the two forms above
// already refuse, never a false negative. K4c (D221/§41): keyed by (owner,
// name), owner the enclosing function/method -- a clean lambda named `f` in
// one function no longer inherits the taint of an unrelated `f` elsewhere.
uptr taint_owner[TK_MAXLAMREF];
uptr taint_name[TK_MAXLAMREF];
i64  tk_ntaint = 0;

i64 tk_taint_find(uptr owner, uptr name) {
    i64 i = 0;
    loop {
        if (i >= tk_ntaint) break;
        if (str_eq(ld64(taint_owner + i * 8), owner) && str_eq(ld64(taint_name + i * 8), name))
            return 1;
        i = i + 1;
    }
    return 0;
}

void tk_taint_add(uptr owner, uptr name) {
    if (tk_taint_find(owner, name)) return;
    if (tk_ntaint == TK_MAXLAMREF) err_at(tk_file, tk_line, "teko: too many tainted lambda locals");
    st64(taint_owner + tk_ntaint * 8, owner);
    st64(taint_name + tk_ntaint * 8, name);
    tk_ntaint = tk_ntaint + 1;
}

// K4c: the enclosing declaration's own name -- `p_decl_name()` while parsing
// is reading it (the on_stmt hook below, and the three call sites that check
// an assignment right where `parse_expr` reads it), `tk_cur_fn_name`
// (teko_typeof.tk) once parsing is over and a pass() walk stands on the
// N_FUNC instead (this file's own loop, and `tk_this_assign`'s).
uptr tk_taint_owner() {
    uptr d = p_decl_name();
    if (d != 0) return d;
    return tk_cur_fn_name;
}

// `e` escapes its scope: a call to an allocator whose lambda captures at
// least one name by reference, or a NAME already tainted with one (the
// propagation above). The one shape D221 decision 21's escapes share,
// checked where a slot of delegate type is WRITTEN (`tk_deleg_return`
// above, `teko_expr.tk`'s `tk_field_use`/`tk_call_method_args`,
// `teko_access.tk`'s `tk_static_use`, `teko_heaparr.tk`'s `tk_ha_index`) --
// everywhere BUT an argument of `new Op(...)`, which a callee only ever
// reads, C-like, never stores.
//
// A ternary is read BRANCH BY BRANCH, because that is how the validator reads
// it (`tk_deleg_coerce` above, one coercion per branch) and how the code
// generator writes it: `g_op = flag ? held : other` stores whichever branch
// runs, so `held` carrying a by-reference capture is the same dangling slot
// `g_op = held` is. Reading the top of the node alone answered `tk_lamref_has`
// over the placeholder's own name, `tk_ternary`, which no allocator has: every
// escaping site of the language -- the global slot, the field, the static
// field, the element of a `T[]` and the `return` -- accepted that shape (D51,
// sixth pass). Every other value the validator accepts is a leaf here.
i64 tk_lam_escapes(i64 e) {
    if (e == 0) return 0;
    i64 k = nd_kind(e);
    if (k == N_CALL && str_eq(nd_name(e), "tk_ternary")) {
        i64 a = nd_next(nd_a(e));                 // `c ? a : b`, the raw placeholder
        return tk_lam_escapes(a) || tk_lam_escapes(nd_next(a));
    }
    if (k == N_CALL) return tk_lamref_has(nd_name(e));
    if (k == N_IDENT) return tk_taint_find(tk_taint_owner(), nd_name(e));
    return 0;
}

// M21.5's statement hook, K4b: `Op g = f;` and `g = f;` propagate the taint
// of the right side onto the name written -- the one point every write of a
// local runs through no matter how early its own module resolves the write
// (field/array stores read the escape at PARSE time), since it fires the
// instant the core finishes reading the statement.
i64 tk_lam_taint_stmt(i64 n) {
    if (n == 0) return n;
    i64 k = nd_kind(n);
    if (k != N_VAR && k != N_ASSIGN) return n;
    if (tk_lam_escapes(nd_a(n))) tk_taint_add(tk_taint_owner(), nd_name(n));
    return n;
}

// ---- `use (a, &b)`: the captures of the lambda being read right now ----
// higiene 2, item 6: ONE table over the whole unit, not reset per lambda --
// a lambda literal built INSIDE another one's own body (`new Op(...) use (k)
// => new Op(...) use (k) => ...`) is fully finished (its own `use`, body walk
// AND cleanup) before the ENCLOSING lambda's body-parse that contains it
// even returns, so a hard reset to 0 at either end wiped out whatever the
// outer lambda had already recorded. `tk_lc_base` is the CURRENT lambda's own
// window into the table (`[tk_lc_base, tk_nlc)`), saved/restored around the
// body exactly like `p_decl_name` a few lines below -- the table itself only
// ever grows and shrinks like a stack, never truly clears until the
// outermost lambda's own `tk_lambda_finish` returns.
uptr lc_name[TK_MAXLAMCAP];
i64  lc_byref[TK_MAXLAMCAP];
i64  lc_ty[TK_MAXLAMCAP];
i64  tk_nlc = 0;
i64  tk_lc_base = 0;

uptr lc_name_at(i64 i)  { return ld64(lc_name + i * 8); }
i64  lc_byref_at(i64 i) { return ld64(lc_byref + i * 8); }
i64  lc_ty_at(i64 i)    { return ld64(lc_ty + i * 8); }

i64 tk_lc_dup(uptr name) {
    i64 i = tk_lc_base;
    loop {
        if (i >= tk_nlc) break;
        if (str_eq(lc_name_at(i), name)) return 1;
        i = i + 1;
    }
    return 0;
}

i64 tk_lc_find(uptr name) {
    i64 i = tk_lc_base;
    loop {
        if (i >= tk_nlc) break;
        if (str_eq(lc_name_at(i), name)) return i;
        i = i + 1;
    }
    return 0 - 1;
}

// each captured name has to already be a local the enclosing function
// declared (teko_struct.tk's `tk_slv_find`, `tk_on_stmt` extended to track
// every local for this): a function/type name is refused here, before the
// lambda's own body is even read
void tk_lambda_use(i64 line, uptr fl) {
    p_next();                                     // the `use` word
    p_expect(K_LPAR, "expected ( after use");
    loop {
        i64 byref = p_accept(K_AND);
        if (p_id() != T_IDENT) err_at(p_file(), p_line(), "teko: expected a captured name");
        uptr name = p_ident();
        if (tk_lc_dup(name)) err_at2(fl, line, "teko: use (...) already captures", name);
        i64 ty = tk_slv_find(name);
        if (ty < 0) err_at2(fl, line, "teko: `use` captures a local; this name is not one", name);
        if (byref && tk_is_counted(ty))
            err_at2(fl, line, "teko: a capture by reference of a counted type is not taught yet", name);
        if (tk_nlc == TK_MAXLAMCAP) err_at(fl, line, "teko: too many captures in one lambda");
        st64(lc_name + tk_nlc * 8, name);
        st64(lc_byref + tk_nlc * 8, byref);
        st64(lc_ty + tk_nlc * 8, ty);
        tk_nlc = tk_nlc + 1;
        if (!p_accept(K_COMMA)) break;
    }
    p_expect(K_RPAR, "expected ) after the captures");
}

// the lambda's own parameter list against the delegate's: D221 decision 19
// asks for explicit types AND a known target, so every parameter has to name
// the pointee the delegate itself declares, in order
void tk_lambda_check_params(i64 si, i64 prs, i64 line, uptr fl) {
    i64 np = dg_np_at(si);
    i64 i = 0;
    i64 p = prs;
    loop {
        if (i >= np || p == 0) break;
        if (tk_param_ty(p) != dg_pty_at(si, i) || tk_rp_kind(p) != dg_pk_at(si, i))
            err_at2(fl, line, "teko: the lambda does not match the delegate", tk_deleg_sig_str(si));
        i = i + 1;
        p = nd_next(p);
    }
    if (i != np || p != 0)
        err_at2(fl, line, "teko: the lambda does not match the delegate", tk_deleg_sig_str(si));
}

// the local a by-reference capture derefs through: never the captured name
// itself (K2's own restriction on `ref` as a local declaration would refuse
// that), a plain `uptr` holding the address the prologue loaded
uptr tk_lam_refaddr(i64 ci) { return tk_join("__lamref", tk_num(ci)); }

// D226 compat crumb: a name a global might still turn out to be -- teko_array.tk's
// own header explains why the answer waits for a pass (no hook exists over a
// top-level declaration): `n` is recorded here and `tk_deleg_pass`, once the
// whole unit's `N_GLOBAL` rows exist, is what actually accepts or refuses it.
i64  lg_node[TK_MAXLAMGLOB];
i64  tk_nlg = 0;

void tk_lg_add(i64 n) {
    if (tk_nlg == TK_MAXLAMGLOB) err_at(nd_file(n), nd_line(n), "teko: too many unresolved names in one lambda");
    st64(lg_node + tk_nlg * 8, n);
    tk_nlg = tk_nlg + 1;
}

// D70: the wording a name that is a param, a local, a capture, a function,
// a type NOR a global already answers with -- factored out so a class
// MEMBER below reads exactly the same sentence, by construction, rather
// than by a second copy of the string.
void tk_lam_not_captured(i64 n) {
    err_at(nd_file(n), nd_line(n), tk_join3("teko: ", nd_name(n), " is not captured; add it to use (...)"));
}

// D70: a name the ENCLOSING CLASS declares -- a field, a member const, a
// property, a method -- judged before `decl_find`/`tk_struct_find` below
// ever get a look, and never deferred to `tk_lam_resolve_globals`: a global
// of the very same name used to win there, silently, because a class
// member was never checked at all. Measured on the base tree: `h.direct()`
// (the method itself, `tk_this_ident`) read the FIELD; `h.cb(0)` (the SAME
// name, inside a lambda `arm()` builds) read a same-named GLOBAL instead --
// two different answers for one name, neither refused.
//
// A STATIC member takes no receiver, exactly as it takes none for the
// method itself (`tk_this_field_addr`, `tk_mconst_use`, `tk_prop_static_use`),
// so it resolves here the same way. An INSTANCE one needs `this`, which a
// lambda never captures implicitly (D11 stands; giving it one opens a
// reference cycle the reclaim does not break, an open fork of its own,
// `docs/reference/not-yet.md`) -- so it reads the one wording a plain field
// with no colliding global already gets, above, rather than a global that
// only happens to share its name. 1 when `n` is a member at all: the
// caller's cue to stop, resolved or refused, never falling through to a
// name of some OTHER thing entirely.
i64 tk_lam_member(i64 n, uptr name) {
    if (tk_body_class < 0) return 0;
    i64 fi = tk_field_find(tk_body_class, name);
    if (fi >= 0) {
        if (fd_sym_at(fi)) {
            // the same gate an unqualified member passes in the method itself
            // (`tk_this_check`): a base's private static is not the derived
            // class's to read, and an inline static ARRAY is no scalar load
            tk_line = nd_line(n);
            tk_file = nd_file(n);
            tk_this_check(fi);
            i64 fty = fd_ty_at(fi);
            tk_node_replace(n, tk_ld(fty, tk_id(fd_sym_at(fi))));
            // the write door found while closing D70's own write twin
            // (`tk_lam_member_store`, below): a store built over a READ
            // this branch resolves -- `sn += y;` lowers to `sn = sn + y;`
            // (`<teko-loop-prelude>`), whose RHS reads `sn` through here --
            // needs the type `tk_field_store_val` asks for, exactly as
            // `tk_this_ident`'s own identical load already tags it. Untagged,
            // `tk_fs_vty` deferred the store to a later pass that can never
            // settle it (the raw `ld64`/`st64` this call names is no
            // declaration `decl_find` or `tk_ty_of`'s own N_CALL arms ever
            // answer for), and the store died `teko: the type of this value
            // is not known here` on a program that types clearly at the
            // point this door already reads it. A plain read with no store
            // built over it (every other caller before this crumb) never
            // asked `tk_fs_vty` at all, which is why the gap went unmeasured
            // until the write door needed the answer.
            tk_xt_put(n, tk_struct_by_ty(fty), fty, 1, TK_BORROWED);
            return 1;
        }
        tk_lam_not_captured(n);
        return 1;
    }
    i64 mci = tk_mconst_find(tk_body_class, name);
    if (mci >= 0) {
        tk_node_replace(n, tk_mconst_use(mci, nd_line(n), nd_file(n)));
        return 1;
    }
    i64 pi = tk_prop_find(tk_body_class, name);
    if (pi >= 0) {
        i64 mi = tk_prop_accessor_of(tk_body_class, name, 0, nd_line(n), nd_file(n));
        if (!mt_static_at(mi)) {
            tk_lam_not_captured(n);
            return 1;
        }
        tk_check_member(mt_cls_at(mi), mt_vis_at(mi), name, nd_line(n), nd_file(n));
        tk_node_replace(n, tk_call(mt_fn_at(mi), 0));
        // the same tag, for the same reason -- a static GETTER read through
        // here, inside `sn = SomeProp + 1;`, would defer identically
        tk_xt_put(n, tk_struct_by_ty(mt_ret_at(mi)), mt_ret_at(mi), 0, TK_OWNED);
        return 1;
    }
    if (tk_method_named_find(tk_body_class, name) >= 0) {
        tk_lam_not_captured(n);
        return 1;
    }
    return 0;
}

// D70: the WRITE twin of `tk_lam_member` above -- a bare NAME on the LEFT of
// `=` inside a lambda, judged through the identical four tables before ever
// falling through as an ordinary local/global assignment. Measured: `n = x;`
// inside a lambda `arm()` builds, `n` a field the class declares shadowed by
// a same-named global, wrote the GLOBAL silently -- the read half of the
// identical name already answered the FIELD (`tk_lam_member`, above), so one
// lambda read two different `n`s for the one spelling, one on each side of
// `=`. This is the exact door D70 opened to close, left open on its own
// first pass.
//
// A STATIC field stores through its own global, the same `tk_field_store_val`
// gate a plain static store already takes (`tk_static_use`,
// `tk_fwd_resolve_static_one`, teko_access.tk) -- D33's widening, its
// narrowing refusal, D43's `null`-only-in-`T?`, D34's reference/number
// mismatch and Q1b's box wrap all ride along, exactly as they do for
// `this.f = e` (`tk_this_assign`, teko_this.tk, the PASS-time sibling this
// mirrors: a lambda's own body is parsed and walked at PARSE time, past
// `tk_this_fix`'s own reach, the identical timing gap `tk_lam_member` above
// already crosses for the read side). A member CONST takes no store at all,
// the one wording a qualified `Type.C = e` already answers with
// (`tk_const_assign_refuse`, teko_access.tk) -- one string, asked from both
// doors. A property with a `set`, STATIC, calls it with no receiver, the
// exact call `tk_prop_static_use` builds for the same shape; one with no
// `set` is refused there too, by its own existing wording. Every INSTANCE
// road -- field, property, method -- reads `tk_lam_not_captured`: `this` is
// never implicitly captured (D11), so there is nothing a lambda can WRITE
// through an instance member at all.
//
// `n += x;`/`n++;` reach here exactly as `n = x;` does: `<teko-loop-prelude>`
// (teko_loop.tk) lowers both to `n = n + x;` at PARSE time, before this walk
// ever runs, so the RHS `n + x` is an ordinary expression this function's own
// caller (`tk_lam_walk`) already walks first -- the READ of `n` inside it
// resolves through `tk_lam_member` like any other, and only the ASSIGNMENT
// TARGET is this function's business.
//
// 1 when `n` is a member the enclosing class declares at all: the caller's
// cue that `n`'s own node already decided the outcome, resolved or refused,
// and the assignment must never fall through to a local or a global once it
// has.
i64 tk_lam_member_store(i64 n, uptr name) {
    if (tk_body_class < 0) return 0;
    i64 fi = tk_field_find(tk_body_class, name);
    if (fi >= 0) {
        if (fd_sym_at(fi)) {
            i64 line = nd_line(n);
            uptr fl = nd_file(n);
            tk_line = line;                  // `tk_this_check` reads the globals
            tk_file = fl;
            tk_this_check(fi);
            if (tk_lam_escapes(nd_a(n)))
                err_at(fl, line, "teko: a lambda that captures by reference cannot leave its scope");
            i64 fty = fd_ty_at(fi);
            i64 v = tk_field_store_val(fty, nd_a(n), line, fl);
            i64 st = tk_os_mark(tk_call2(tk_stn(fty), tk_id(fd_sym_at(fi)), v), fty);
            tk_node_replace(n, tk_stmt(st));
            return 1;
        }
        tk_lam_not_captured(n);
        return 1;
    }
    if (tk_mconst_find(tk_body_class, name) >= 0) {
        tk_const_assign_refuse(nd_line(n), nd_file(n), name);
        return 1;
    }
    i64 pi = tk_prop_find(tk_body_class, name);
    if (pi >= 0) {
        i64 mi = tk_prop_accessor_of(tk_body_class, name, 1, nd_line(n), nd_file(n));
        if (!mt_static_at(mi)) {
            tk_lam_not_captured(n);
            return 1;
        }
        tk_check_member(mt_cls_at(mi), mt_vis_at(mi), name, nd_line(n), nd_file(n));
        tk_node_replace(n, tk_stmt(tk_call(mt_fn_at(mi), nd_a(n))));
        return 1;
    }
    if (tk_method_named_find(tk_body_class, name) >= 0) {
        tk_lam_not_captured(n);
        return 1;
    }
    return 0;
}

// a name that is neither a param, a local the body itself declares, a
// capture, a MEMBER of the enclosing class, a function nor a type -- C#'s
// own rule keeps every one of the program's STATICS (a top-level global, a
// `const`, a free function) visible with no `use (...)` at all; only a name
// none of those turns out to be is truly `D221`'s own wording for it, and
// that answer waits on `tk_deleg_pass` below (`tk_lg_add`), the one point a
// global's own row is knowable.
void tk_lam_check_name(i64 n) {
    uptr name = nd_name(n);
    if (tk_ty_scope_find(name) >= 0) return;
    if (tk_lc_find(name) >= 0) return;
    if (tk_lam_member(n, name)) return;
    if (decl_find(name) >= 0) return;
    if (tk_struct_find(name) >= 0) return;
    tk_lg_add(n);
}

// D70: the CALL twin of `tk_lam_member` above -- a name that is a METHOD of
// the enclosing class, called bare inside a lambda. `tk_lam_walk` below
// never looked past `N_IDENT` before this, so `go(x)` fell straight to the
// core's own resolver (`gen_resolve.mc`), which knows no function literally
// named `go` (a method's real symbol is always mangled, `tk_this_call`'s own
// `Owner_method`) and refused `call to unknown function`, the core's own
// wording, never teko's -- and a FREE function of the same name would have
// silently answered instead, the identical door the field fix above closes
// for a plain name. A STATIC method needs no receiver and resolves the same
// way `tk_this_emit`'s own static branch does; an INSTANCE one needs `this`,
// not implicitly captured (D11) -- refused by name, its own wording: `use
// (...)` captures a VALUE, never a method, so the field's own sentence would
// read false here.
//
// A name that is no method may still be a delegate FIELD, called bare
// (`cb(0)` where `cb` is `public Op cb;`) -- D65's own `tk_this_deleg_call`
// opens exactly this road for a method's OWN body, over `tk_field_deleg_call`
// (teko_expr.tk), which is PARSE-time and reads its arguments off the token
// stream (`tk_args`); a lambda's `N_CALL` already carries its own parsed
// `nd_a(n)`, so the road here is `tk_deleg_build` directly, the same builder
// every delegate-call door eventually funnels through (D59's argument judge
// rides along unasked, exactly as it does for every other one). Measured on
// the base tree: a free function and a delegate field sharing one name, the
// field's own target answered through `direct()` (`this.cb(x)`, D65) and the
// FREE function answered through a lambda's bare `cb(x)` instead -- two
// answers for one name, the identical silent-shadow D65 closed for every
// OTHER road but this one. A STATIC field needs no receiver, exactly as
// `tk_static_deleg_call` (teko_access.tk) resolves it for the type's own
// name; an INSTANCE one needs `this`, not implicitly captured (D11) -- the
// one wording a plain field with no colliding global already answers with.
i64 tk_lam_deleg_call(i64 n, uptr name) {
    i64 fi = tk_field_find(tk_body_class, name);
    if (fi < 0) return 0;
    if (fd_nel_at(fi) > 0) return 0;               // an array field: the loop below is not this road
    i64 fty = fd_ty_at(fi);
    i64 di = tk_deleg_row(fty);
    if (di < 0) return 0;                          // not a delegate field: leave it to whatever else resolves it
    if (!fd_sym_at(fi)) {
        tk_lam_not_captured(n);
        return 1;
    }
    tk_check_member(tk_field_owner(fi), fd_vis_at(fi), name, nd_line(n), nd_file(n));
    i64 obj = tk_ld(fty, tk_id(fd_sym_at(fi)));
    i64 args = nd_a(n);
    i64 r = tk_deleg_build(di, obj, args, tk_arg_count(args), nd_line(n), nd_file(n));
    tk_node_replace(n, r);
    i64 ret = dg_ret_at(di);
    tk_xt_put(n, tk_struct_by_ty(ret), ret, 0, TK_OWNED);
    return 1;
}

void tk_lam_check_call(i64 n) {
    if (tk_body_class < 0) return;
    uptr name = nd_name(n);
    if (tk_ty_scope_find(name) >= 0) return;        // a local or a parameter answers first (C#'s rule)
    if (tk_lc_find(name) >= 0) return;               // ...and so does a capture, by-value or by-reference
    i64 mi = tk_method_named_find(tk_body_class, name);
    if (mi < 0) {
        // a property is reached by its name and never called (`tk_reject_prop_call`
        // says it on the method's own road); judged before the delegate field so
        // the call never falls through to a free function of the same name
        if (tk_prop_find(tk_body_class, name) >= 0)
            err_at2(nd_file(n), nd_line(n), "teko: the member is a property; it is not called", name);
        tk_lam_deleg_call(n, name);
        return;
    }
    i64 na = tk_arg_count(nd_a(n));
    i64 pick = tk_method_pick(tk_body_class, name, na);
    if (pick < 0) tk_pick_refuse(pick, name, nd_line(n), nd_file(n));
    if (!mt_static_at(pick))
        err_at2(nd_file(n), nd_line(n), "teko: a method is not reachable from a lambda", name);
    tk_check_member(mt_cls_at(pick), mt_vis_at(pick), name, nd_line(n), nd_file(n));
    set_nd_a(n, tk_fill_defaults(nd_a(n), na, mt_np_at(pick), mt_nreq_at(pick), mt_d0_at(pick)));
    set_nd_name(n, mt_fn_at(pick));
}

// the freshly built body of ONE lambda: a by-reference capture's every read
// and write is rewritten through the address its prologue loaded
// (teko_ref.tk's own `tk_arr_load`/`tk_arr_store`, the exact helpers a
// `ref`/`out` parameter already derefs with); a by-value capture is already
// an ordinary local by the time this runs (its own prologue `T name = ...;`
// is walked like any other declaration), so it needs no rewrite at all --
// only the check that every OTHER name is a param, a local, or a global. D70:
// an assignment TARGET that is none of those three either asks
// `tk_lam_member_store` the same question the target's read half already
// asks `tk_lam_member` -- a local or a capture answers first (`tk_ty_scope_
// find`, the identical order `tk_lam_check_name` reads a plain name in), and
// only a name neither of those own is a member's to judge.
void tk_lam_walk(i64 n) {
    loop {
        if (n == 0) break;
        i64 k = nd_kind(n);
        if (k == N_IDENT) {
            i64 ci = tk_lc_find(nd_name(n));
            if (ci >= 0 && lc_byref_at(ci)) {
                tk_node_replace(n, tk_arr_load(lc_ty_at(ci), tk_id(tk_lam_refaddr(ci))));
                n = nd_next(n);
                continue;
            }
            tk_lam_check_name(n);
        } else if (k == N_ASSIGN) {
            i64 ci = tk_lc_find(nd_name(n));
            if (ci >= 0 && lc_byref_at(ci)) {
                tk_lam_walk(nd_a(n));
                i64 store = tk_arr_store(lc_ty_at(ci), tk_id(tk_lam_refaddr(ci)), nd_a(n));
                set_nd_kind(n, N_EXPRSTMT);
                set_nd_name(n, 0);
                set_nd_a(n, store);
                n = nd_next(n);
                continue;
            }
            if (tk_ty_scope_find(nd_name(n)) < 0) {
                tk_lam_walk(nd_a(n));
                tk_lam_member_store(n, nd_name(n));
                n = nd_next(n);
                continue;
            }
        } else if (k == N_CALL) {
            tk_lam_check_call(n);
        }
        if (k == N_BLOCK) {
            i64 mark = tk_nscope;
            tk_lam_walk(nd_a(n));
            tk_nscope = mark;
        } else {
            tk_lam_walk(nd_a(n));
            tk_lam_walk(nd_b(n));
            tk_lam_walk(nd_c(n));
            tk_lam_walk(nd_d(n));
            tk_ty_scope_var(n);
        }
        n = nd_next(n);
    }
}

// `Op__lam3(uptr __env, T1 a, T2 b) { ... }`'s own prologue: one local per
// by-value capture, read out of the closure at every call (`rt_own`/`rc_dec`
// fall out of the ordinary scope machinery, teko_rc.tk, because this is a
// real N_VAR the walk above sees like any other local); one local per
// by-reference capture, holding the address `tk_lam_walk` derefs through.
//
// K4b: a by-value capture of DELEGATE type builds `Op inner = ld64(addr);`,
// an `N_CALL` the later `tk_deleg_pass` walk (this same file) also visits as
// an ordinary local initializer -- `tk_deleg_coerce` would refuse it outright
// (a call to `ld64` matches none of the four shapes a delegate slot accepts).
// The call node built here IS the final one (nothing copies over it before
// that walk reads it, unlike `tk_deleg_call`'s own node -- K1b's own
// lesson), so tagging it with the delegate's row right away, the same
// `tk_field_use` (teko_expr.tk) tags a field LOAD of delegate type with,
// makes the oracle answer the row's own type and the coercion a no-op.
i64 tk_lambda_prologue(uptr envname) {
    i64 pre = 0;
    i64 i = tk_lc_base;
    loop {
        if (i >= tk_nlc) break;
        i64 addr = tk_bin(K_ADD, tk_id(envname), tk_int(24 + 8 * (i - tk_lc_base)));
        if (lc_byref_at(i)) {
            pre = list_append(pre, tk_var(TY_UPTR, tk_lam_refaddr(i), tk_call("ld64", addr)));
        } else {
            i64 ld = tk_ld(lc_ty_at(i), addr);
            i64 dsi = tk_deleg_row(lc_ty_at(i));
            if (dsi >= 0) tk_xt_put(ld, dsi, sr_ty_at(dsi), 1, TK_BORROWED);
            pre = list_append(pre, tk_var(lc_ty_at(i), lc_name_at(i), ld));
        }
        i = i + 1;
    }
    return pre;
}

// `rc_dec` of every by-value COUNTED capture: a by-reference one is an
// address, never owned, and the code pointer/vtable carry no reference
i64 tk_lambda_release_fn(uptr relname, i64 objsize) {
    i64 st = 0;
    i64 i = tk_lc_base;
    loop {
        if (i >= tk_nlc) break;
        if (!lc_byref_at(i) && tk_is_counted(lc_ty_at(i))) {
            i64 addr = tk_bin(K_ADD, tk_id(tk_this_name()), tk_int(24 + 8 * (i - tk_lc_base)));
            st = list_append(st, tk_stmt(tk_call("rc_dec", tk_call("ld64", addr))));
        }
        i = i + 1;
    }
    st = list_append(st, tk_stmt(tk_call2("rt_free", tk_id(tk_this_name()), tk_int(objsize))));
    return tk_func(TY_VOID, relname, param_new(TY_UPTR, tk_this_name()), tk_blk(st));
}

// the allocator's own body: K1's own three-word head written into the object
// the CALLER hands over, already carrying every capture (`tk_lambda_capture_
// chain` below). higiene 3, item B: the captures used to arrive as one
// PARAMETER each, which put the mc ABI's own `MAXPARAMS` (12) in front of
// `TK_MAXLAMCAP` -- a `use (...)` of thirteen names died on the CORE's own
// `at most 12 parameters`, in a file it named wrong, instead of this
// module's own ceiling. The object is one parameter no matter how many
// names a lambda closes over.
i64 tk_lambda_alloc_stmts(uptr vtname, uptr relname, uptr lamname) {
    i64 st = tk_stmt(tk_call2("st64", tk_id(vtname), tk_addr(relname)));
    st = list_append(st, tk_stmt(tk_call2("st64", tk_id("p"), tk_id(vtname))));
    st = list_append(st, tk_stmt(tk_call2("st64", tk_bin(K_ADD, tk_id("p"), tk_int(8)), tk_int(1))));
    st = list_append(st, tk_stmt(tk_call2("st64", tk_bin(K_ADD, tk_id("p"), tk_int(16)), tk_addr(lamname))));
    return st;
}

i64 tk_lambda_alloc_fn(i64 si, uptr allocname, uptr vtname, uptr relname, uptr lamname) {
    i64 st = tk_lambda_alloc_stmts(vtname, relname, lamname);
    i64 r = tk_id("p");
    tk_xt_add(r, si, 1, TK_OWNED);                // a NAME, so pure; owned from the count
                                                  // the statements above installed
    st = list_append(st, tk_ret(r));
    return tk_func(sr_ty_at(si), allocname, param_new(TY_UPTR, "p"), tk_blk(st));
}

// the link that writes ONE by-value capture: the value crosses into the
// closure as an argument, so its own register file decides which of the three
// writers of lib/rt.tk carries it -- a float in an `i64` parameter is never
// received at all (higiene 4), and a counted one owes a reference.
uptr tk_cap_writer(i64 ty) {
    if (type_kind(ty) == TK_FLOAT) {
        if (type_width(ty) == 4) return "tk_cap_putf32";
        if (type_width(ty) == 8) return "tk_cap_putf";
    }
    if (tk_is_counted(ty)) return "tk_cap_own";
    return "tk_cap_put";
}

// `tk_prim_is`/`tk_prim_raw` (teko_prim.tk, included after this file) --
// forward-declared the same way `tk_lambda_build` above is, for the capture
// value below.
i64 tk_prim_is(i64 ty);
i64 tk_prim_raw(i64 e);

// Q3 (D46): the N_IDENT a BY-VALUE capture reads the local through. Definite
// assignment (teko_typeof.tk) counts a `use (...)` as an ASSIGNMENT rather
// than as a read -- `docs/specs/nullable.md` § 8's own table -- because the
// name crossing into a closure is the lambda's business and not that walk's,
// and the node it crosses in is the only thing that tells it apart from an
// ordinary read of the same name written on the same line. `use (&a)` needs no
// row: it is already an `N_ADDR`, which that walk reads as an assignment.
//
// One row per by-value capture EMITTED, over the whole unit, and it is read
// only by a walk that runs after the last one is written. The table is empty
// for a unit with no lambda, which is every unit this compiler is itself made
// of, so the lookup costs one compare there.
#define TK_MAXCAPRD 256               // by-value captures emitted, over the whole unit

i64 capread_node[TK_MAXCAPRD];
i64 tk_ncapread = 0;

void tk_capread_add(i64 n) {
    if (tk_ncapread == TK_MAXCAPRD)
        err_at(tk_file, tk_line, "teko: too many captures by value in one unit");
    st64(capread_node + tk_ncapread * 8, n);
    tk_ncapread = tk_ncapread + 1;
}

i64 tk_capread_is(i64 n) {
    i64 i = 0;
    loop {
        if (i >= tk_ncapread) break;
        if (ld64(capread_node + i * 8) == n) return 1;
        i = i + 1;
    }
    return 0;
}

// the value a BY-VALUE capture hands to `tk_cap_writer`'s own `i64` slot:
// `tk_cap_put`'s `v` parameter (`lib/rt.tk`) is declared `i64`, the register
// file plain data crosses in, and `tk_check_scalar_compat` (teko_typeof.tk,
// D34/D40) refuses ANY primitive-with-members or `enum` value reaching a
// numeric slot other than its own -- correct for a value the SOURCE wrote,
// wrong here, because the eight bytes crossing into the closure are exactly
// what a `TimeSpan`/`DateTime`/`enum` local already carries in its own slot
// (D38's `tk_ld` reads the very same bytes back out on the other end,
// `tk_lambda_prologue` below). This is the compiler's own raw view of the
// value, the same category `tk_prim_raw` already names for a row's argument
// (teko_prim.tk): a primitive-with-members goes through it so the cast is
// remembered as the compiler's, and an `enum` (no hand-written-cast refusal
// exists for one, docs/specs/enum.md § 5) takes the plain machine cast.
// An enum is known by its ROW (`tk_is_enum`), not by its kind: `enum Color`
// is `TK_SINT` and `enum Level : u8` is `TK_INT`, and both are enums to the
// slot check that refuses them -- so both take the machine cast here.
i64 tk_cap_val(i64 ty, uptr name) {
    i64 v = tk_id(name);
    tk_capread_add(v);
    if (tk_prim_is(ty)) return tk_prim_raw(v);
    if (tk_is_enum(tk_struct_by_ty(ty))) return tk_cast(TY_I64, v);
    return v;
}

// the object the allocator is handed: a fresh block with one `tk_cap_put`
// link per capture (lib/rt.tk), each writing the value or the ADDRESS taken
// AT THAT INSTANT -- the "frozen copy" D221 decision 20 asks a by-value
// capture for, now written at the creation site instead of passed inward.
// A capture of counted type goes through `tk_cap_own`, which takes the
// closure's own reference the way the allocator's `rc_inc` used to.
i64 tk_lambda_capture_chain(i64 objsize) {
    i64 blk = tk_call("rt_alloc", tk_int(objsize));
    i64 i = tk_lc_base;
    loop {
        if (i >= tk_nlc) break;
        i64 off = tk_int(24 + 8 * (i - tk_lc_base));
        if (lc_byref_at(i)) {
            blk = tk_call3("tk_cap_put", blk, off, tk_addr(lc_name_at(i)));
        } else {
            i64 v = tk_cap_val(lc_ty_at(i), lc_name_at(i));
            blk = tk_call3(tk_cap_writer(lc_ty_at(i)), blk, off, v);
        }
        i = i + 1;
    }
    return blk;
}

// 1 when at least one capture is taken by reference -- the escape D221
// decision 21 tracks through `tk_lamref_add`
i64 tk_lambda_has_byref() {
    i64 i = tk_lc_base;
    loop {
        if (i >= tk_nlc) break;
        if (lc_byref_at(i)) return 1;
        i = i + 1;
    }
    return 0;
}

// a name unique over the whole unit, namespace-qualified exactly as a named
// `delegate` is (`tk_delegate` above): two lambdas of the same delegate type
// never collide, in or out of a `namespace`
uptr tk_lambda_gensym(uptr base) {
    uptr nm = tk_ns_qualify(tk_join3(base, "__lam", tk_num(tk_nlam)));
    tk_nlam = tk_nlam + 1;
    return nm;
}

// the tail every lambda grafia shares once its own parameter list is known:
// `[use (...)] => body`, the generated function, its vtable, its release,
// its allocator, and the CALL to that allocator handed back in the
// initializer's own place. `name`/`saved` are `tk_lambda_gensym`'s own
// result and the enclosing declaration's name, opened by the CALLER (K4b:
// a caller that reads its own parameter list, the short grafia below, opens
// them BEFORE reading it too, exactly as `tk_lambda_build` always has,
// since `p_decl_name` has to be the lambda's own for `parse_params` itself).
// K4c: `saved` is restored only at the very END, after every declaration this
// function emits -- `top_add` clears `p_decl_name()` as a side effect (mc
// docs/reference/hooks.md § Asking about the parse), so restoring it BEFORE
// the lambda's own function (and the vtable/release/allocator right behind it)
// left the ENCLOSING statement's own on_stmt hooks reading 0 for the rest of
// that declaration's body -- `tk_taint_owner()`'s own bug. K6: the four go
// through `tk_top_emit` (teko_struct.tk) like every other generator, which
// hands the LAMBDA's own name back between them; `saved` puts the enclosing
// declaration's back once the lambda is whole.
i64 tk_lambda_finish(i64 si, uptr name, uptr saved, i64 prs, i64 line, uptr fl) {
    tk_lambda_check_params(si, prs, line, fl);
    i64 saved_lc_base = tk_lc_base;               // higiene 2, item 6: a stack, not a reset
    tk_lc_base = tk_nlc;
    if (tk_word("use")) tk_lambda_use(line, fl);
    p_expect(K_ARROW, "expected => after the lambda parameters");
    i64 ret = dg_ret_at(si);
    uptr envname = "__env";
    i64 allparams = list_append(param_new(TY_UPTR, envname), prs);
    tk_lam_body_depth = tk_lam_body_depth + 1;
    i64 f;
    if (p_id() == K_LBRACE) {
        f = parse_function(ret, name, allparams);
    } else {
        i64 e = parse_expr(0);
        i64 body;
        if (ret == TY_VOID) body = tk_blk(tk_stmt(e));
        else                body = tk_blk(tk_ret(e));
        f = tk_func(ret, name, allparams, body);
    }
    tk_lam_body_depth = tk_lam_body_depth - 1;
    set_nd_a(nd_b(f), list_append(tk_lambda_prologue(envname), nd_a(nd_b(f))));
    tk_nscope = 0;
    tk_ty_scope_params(allparams);
    tk_lam_walk(nd_b(f));
    tk_nscope = 0;
    tk_top_emit(f);
    i64 objsize = 24 + 8 * (tk_nlc - tk_lc_base);
    uptr vtname = tk_join(name, "__vt");
    uptr relname = tk_join(name, "__release");
    uptr allocname = tk_join(name, "__new");
    tk_top_emit(tk_glb(TY_U8, vtname, TK_VT_FIXED * 8));
    tk_top_emit(tk_lambda_release_fn(relname, objsize));
    tk_top_emit(tk_lambda_alloc_fn(si, allocname, vtname, relname, name));
    if (tk_lambda_has_byref()) tk_lamref_add(allocname);
    i64 call = tk_call(allocname, tk_lambda_capture_chain(objsize));
    tk_xt_add(call, si, 0, TK_OWNED);
    tk_nlc = tk_lc_base;                          // higiene 2, item 6: pop THIS lambda's own window
    tk_lc_base = saved_lc_base;
    p_set_decl_name(saved);
    return call;
}

// `(i64 a, i64 b) [use (...)] => body`, already past `new Op(` -- the whole
// closure, its own parameter list read from the LIVE token stream (K4b's own
// two grafias below feed `tk_lambda_finish` a parameter list read some other
// way instead)
i64 tk_lambda_build(i64 si, i64 line, uptr fl) {
    uptr name = tk_lambda_gensym(sr_name_at(si));
    uptr saved = p_decl_name();
    p_set_decl_name(name);
    i64 prs = parse_params();
    return tk_lambda_finish(si, name, saved, prs, line, fl);
}

// 1 when the token right after the current one spells `=>` -- K4b's own
// short lambda grafia (`x => body`), the same `p_cp()` scan `tk_dot_follows`
// (teko_access.tk) already reads a `.` with, extended to a two-byte pair
i64 tk_arrow_follows() {
    uptr p = p_cp();
    uptr e = p_src_end();
    loop {
        if (p >= e) return 0;
        i64 c = ld8(p);
        if (c != ' ' && c != 9 && c != 10 && c != 13) break;
        p = p + 1;
    }
    if (p + 1 >= e) return 0;
    return ld8(p) == '=' && ld8(p + 1) == '>';
}

// `x => body` -- the delegate's own declared parameter fills the ONE
// implicit one (D221 decision 19: only when the target gives the type), so
// `tk_lambda_check_params` still catches a delegate that does not take
// exactly one, exactly as an explicit mismatch does
i64 tk_deleg_short_lambda(i64 si, i64 line, uptr fl) {
    uptr pname = p_ident();
    uptr name = tk_lambda_gensym(sr_name_at(si));
    uptr saved = p_decl_name();
    p_set_decl_name(name);
    i64 prs = param_new(dg_pty_at(si, 0), pname);
    return tk_lambda_finish(si, name, saved, prs, line, fl);
}

// non-consuming: does the balanced `(...)` the CURRENT `(` opens end in
// `use` or `=>`? A parameter list holds no string literal that could
// unbalance a raw scan, so counting bytes from `p_cp()` is exact -- and,
// unlike `p_skip_balanced`, it touches no token at all: `p_push_source`
// right after a peek DISCARDS that peek's own pending lookahead (mc
// `docs/reference/hooks.md` § Record and replay, "the push does not touch
// the pending lookahead token"), which is exactly the `=>` this decision
// needs to still be there once it is made.
i64 tk_paren_lambda_follows() {
    uptr p = p_cp();
    uptr e = p_src_end();
    i64 depth = 1;
    loop {
        if (p >= e) return 0;
        i64 c = ld8(p);
        p = p + 1;
        if (c == '(') depth = depth + 1;
        else if (c == ')') { depth = depth - 1; if (depth == 0) break; }
    }
    loop {
        if (p >= e) return 0;
        i64 c = ld8(p);
        if (c != ' ' && c != 9 && c != 10 && c != 13) break;
        p = p + 1;
    }
    if (p + 1 < e && ld8(p) == '=' && ld8(p + 1) == '>') return 1;
    if (p + 3 <= e && ld8(p) == 'u' && ld8(p + 1) == 's' && ld8(p + 2) == 'e') {
        i64 nx = ld8(p + 3);
        return nx == ' ' || nx == '(' || nx == 9;
    }
    return 0;
}

// `(params) [use (...)] => body`, no `new` -- decided by the non-consuming
// scan above, so BOTH branches read the LIVE stream directly: a lambda
// calls `tk_lambda_build`, sitting on the same unconsumed `(` `new
// Op((params) => ...)` already hands it; anything else is `parse_expr(0)`,
// the ordinary grouped/cast expression the parens always could have been.
i64 tk_deleg_paren_init(i64 si, i64 line, uptr fl) {
    if (tk_paren_lambda_follows()) return tk_lambda_build(si, line, fl);
    return parse_expr(0);
}

// the initializer of a delegate-typed declaration (K4b): the two lambda
// grafias above, or `parse_expr(0)` unchanged -- a bare function name,
// `new Op(...)`, `null`, or another delegate expression, everything
// `tk_deleg_coerce`'s later pass already knows how to read
i64 tk_deleg_init_expr(i64 si, i64 line, uptr fl) {
    if (p_id() == K_LPAR) return tk_deleg_paren_init(si, line, fl);
    if (p_id() == T_IDENT && tk_arrow_follows()) return tk_deleg_short_lambda(si, line, fl);
    return parse_expr(0);
}

// the value written into a slot of type `ty` (D66): where the slot is a
// delegate -- a field, a static field, an element, a declaration -- both
// lambda grafias get their look before the core's own `(`, a cast/group
// disambiguation with no fallback that refuses `(i64 x) => ...` outright.
// Every other type is `parse_expr(0)`, byte for byte what each site read
// before. The row is taken with the `?` peeled off (`tk_deleg_row_under`),
// so an `Op?` slot takes a lambda exactly as an `Op` one does -- the same
// reading `tk_deleg_var_stmt` gives `Op? f = (i64 x) => ...;` below, where
// the COERCION goes through the delegate row and the declaration keeps the
// nullable one.
i64 tk_deleg_rhs(i64 ty, i64 line, uptr fl) {
    i64 si = tk_deleg_row_under(ty);
    if (si < 0) return parse_expr(0);
    return tk_deleg_init_expr(si, line, fl);
}

// `Op f = <init>;` -- K4b: the module reads the declaration itself once the
// type word is known to name a delegate, instead of handing it to the
// core's own `parse_var`, so the two grafias above get a look at the
// initializer before the core's `(` -- a cast/group disambiguation with no
// fallback -- would refuse `(i64 x) => ...` outright (§46's own finding).
// An array of delegate elements is refused exactly as `tk_var_after_type`
// (teko_ns.tk) refuses one of a namespaced type: `teko_array.tk` already
// refuses ANY row of the type table as an array element, delegates
// included, so this is unreachable rather than a new restriction. Anything
// else is `parse_expr(0)`, so the `N_VAR` this builds is byte-identical to
// what `parse_var` always produced.
i64 tk_deleg_var_stmt(i64 si, i64 line, uptr fl) {
    p_next();                                     // the type word
    // Q1a: `Op? f = null;` / `Op? f = add;`. The `?` is read HERE rather than
    // by teko_null.tk's `syntax_type` handler, because this reader is entered
    // with the type word already claimed -- and it is the reader that gives a
    // lambda and the contextual wrap of a plain function their look. The row
    // the declaration carries is the nullable one; the COERCION still goes
    // through the delegate row, which is what `si` stays.
    i64 ty = sr_ty_at(si);
    if (p_id() == tk_nl_quest) {
        p_next();
        if (p_id() == tk_nl_quest) err_at(fl, line, "teko: a nullable of a nullable is not taught");
        ty = tk_nl_row(ty);
    }
    uptr vn = p_ident();
    if (p_id() == K_LBRACK)
        err_at2(fl, line, "teko: an array of this type is not taught yet", vn);
    i64 init = 0;
    if (p_accept(K_ASSIGN)) init = tk_deleg_init_expr(si, line, fl);
    p_expect(K_SEMI, "expected ; after declaration");
    tk_line = line;
    tk_file = fl;
    return tk_var(ty, vn, init);
}

// 1 when the program declares at least one delegate: a program that declares
// none is untouched, byte for byte
i64 tk_any_deleg() {
    i64 i = 0;
    loop {
        if (i >= tk_nstruct) break;
        if (tk_is_deleg(i)) return 1;
        i = i + 1;
    }
    return 0;
}

// D226 compat crumb: 1 when `name` names an `N_GLOBAL` of the unit -- the
// same kind of root scan `teko_array.tk`'s own `tk_array_pass` runs for a
// heap array's row, here over every global regardless of its type
i64 tk_global_find(i64 root, uptr name) {
    i64 f = root;
    loop {
        if (f == 0) break;
        if (nd_kind(f) == N_GLOBAL && str_eq(nd_name(f), name)) return 1;
        f = nd_next(f);
    }
    return 0;
}

// the names `tk_lam_check_name` could not place while a lambda's own body was
// still being read: with the whole unit here, a global answers for itself,
// and a name that still answers for nothing is genuinely `is not captured`
void tk_lam_resolve_globals(i64 root) {
    i64 i = 0;
    loop {
        if (i >= tk_nlg) break;
        i64 n = ld64(lg_node + i * 8);
        if (!tk_global_find(root, nd_name(n)))
            err_at(nd_file(n), nd_line(n),
                   tk_join3("teko: ", nd_name(n), " is not captured; add it to use (...)"));
        i = i + 1;
    }
    tk_nlg = 0;
}

i64 tk_deleg_pass(i64 root) {
    if (!tk_any_deleg()) return root;
    tk_deleg_root = root;
    i64 f = root;
    loop {
        if (f == 0) break;
        if (nd_kind(f) == N_FUNC) {
            tk_nscope = 0;
            tk_cur_fn_name = nd_name(f);          // K4c: this function's own taint bucket
            tk_deleg_cur_ns = tk_ns_of_name(nd_name(f));
            tk_deleg_cur_ret = nd_type(f);
            tk_ty_scope_params(nd_a(f));
            tk_deleg_walk(nd_b(f));
            tk_nscope = 0;
        }
        f = nd_next(f);
    }
    tk_deleg_cur_ns = 0;
    tk_deleg_cur_ret = 0 - 1;
    tk_cur_fn_name = 0;
    tk_deleg_late_rest();
    tk_lam_resolve_globals(root);
    return root;
}
