var build_clock = teko::build::build_clock_start()
var args = teko::env::args()
if args.len >= 2 {
    var a1 = args[1]
    if a1 == "--version" || a1 == "-v" {
        teko::io::println(teko::str::concat("teko ", teko::env::version()))
        teko::exit(0)
    }
}
if teko::build::wants_help(args) {
    teko::build::print_help(teko::build::help_cmd_of(args))
    teko::exit(0)
}

if args.len < 2 {
    teko::io::eprintln("teko compiles projects: pass a project directory or .tkp")
    teko::exit(2)
}

var cmd = args[1]

if cmd == "fmt" {
    teko::exit(teko::fmt::run_cli(args))
}

if cmd == "lsp" {
    teko::exit(teko::lsp::run_lsp())
}

if cmd == "init" {
    teko::exit(teko::build::init_run(args))
}

if cmd == "build" || cmd == "run" || cmd == "test" {
    if teko::build::has_backend_flag(args, 2) {
        teko::io::eprintln("teko: --backend was removed; select the backend with the TEKO_BACKEND environment variable instead (e.g. TEKO_BACKEND=native)")
        teko::exit(2)
    }
    if teko::build::has_bare_g_flag(args, 2) {
        teko::io::eprintln(teko::build::bare_g_rejected_message())
        teko::exit(2)
    }
    var out_dir = teko::build::out_dir_of(args, 2)
    var arg = teko::build::project_arg_of(args, 2)
    if arg.ends_with(".tks") {
        teko::io::eprintln("teko: teko compiles projects: pass a project directory or .tkp (a lone .tks is not a unit)")
        teko::exit(2)
    }
    if arg == "" {
        arg = "."
    }
    var dir = teko::build::project_dir_of(arg)
    var cov = teko::build::coverage_of(args)
    var cov_val = teko::build::cov_validation_of(args)
    var bk = teko::build::backend_of()
    if cmd == "build" {
        var no_verify = teko::build::no_verify_of(args)
        var opt = teko::build::opt_level_of(args)
        var no_tty = teko::build::no_tty_of(args)
        match teko::build::debug_info_of(args) {
            teko::build::DebugInfo as debug => {
                var code = teko::build::compile_project_g(dir, out_dir, cov, no_verify, opt, no_tty, bk, cov_val, debug, teko::build::explicit_of(args))
                teko::build::build_clock_report(build_clock)
                teko::exit(code)
            }
            error as e => {
                teko::io::eprintln(e.message)
                teko::exit(2)
            }
        }
    }
    if cmd == "run" {
        teko::exit(teko::build::run_project(dir, bk))
    }
    teko::exit(teko::build::test_project(dir, cov, cov_val, teko::build::per_test_cov_of(args), teko::build::per_commit_base_of(args), teko::build::analyzer_of(args), teko::build::arith_cast_gate_of(args)))
}

if teko::build::has_backend_flag(args, 1) {
    teko::io::eprintln("teko: --backend was removed; select the backend with the TEKO_BACKEND environment variable instead (e.g. TEKO_BACKEND=native)")
    teko::exit(2)
}
if teko::build::has_bare_g_flag(args, 1) {
    teko::io::eprintln(teko::build::bare_g_rejected_message())
    teko::exit(2)
}
if cmd.ends_with(".tks") {
    teko::io::eprintln("teko: teko compiles projects: pass a project directory or .tkp (a lone .tks is not a unit)")
    teko::exit(2)
}
var bare_out = teko::build::out_dir_of(args, 1)
var bare_proj = teko::build::project_arg_of(args, 1)
if bare_proj == "" {
    teko::io::eprintln("teko compiles projects: pass a project directory or .tkp")
    teko::exit(2)
}
match teko::build::debug_info_of(args) {
    teko::build::DebugInfo as bare_debug => {
        var bare_code = teko::build::compile_project_g(teko::build::project_dir_of(bare_proj), bare_out, teko::build::coverage_of(args), teko::build::no_verify_of(args), teko::build::opt_level_of(args), teko::build::no_tty_of(args), teko::build::backend_of(), teko::build::cov_validation_of(args), bare_debug, teko::build::explicit_of(args))
        teko::build::build_clock_report(build_clock)
        teko::exit(bare_code)
    }
    error as e => {
        teko::io::eprintln(e.message)
        teko::exit(2)
    }
}
