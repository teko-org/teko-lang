// teko_heaparr.tk -- K3 (D221/§41): `T[]` of heap, C#'s array type -- an
// object with the SAME shape a delegate's is (vtable, count, then its own
// data), one row of teko_struct.tk's type table per distinct ELEMENT type,
// made lazily the first time it is spelled or allocated:
//
//   i64[] xs = new i64[n];
//   xs[i]  xs[i] = e  xs[i] += k  xs.Length
//   Circle[] cs = new Circle[n];   // an element release runs per slot
//
// TYPE POSITION. `T[]` is the sibling `syntax_type(&tk_ha_type)` gives
// `syntax_param` (mc 0.14.2, the §41(e) request this port made): consulted
// right after the core -- or `tk_gen_ty`'s own fallback to `p_type()`, or
// this module's own two edits to `tk_default_param`/`tk_ref_param` -- reads a
// type word and advances past it, at every position a type may be written in
// (`p_type()`, a local, a global, a cast, an `extern`, a parameter of a free
// function or of a member). `tk_ha_row` (teko_struct.tk, the row identity
// `tk_is_counted` already shares) is memoized per element, so `i64[]` spelled
// twice is one row; a SECOND `[]` is the row of that row (D100), read by the
// same loop, so `T[][]` and `T[][][]` need no lowering of their own -- what a
// jagged array still lacks is its ALLOCATOR, `new T[n][]`.
//
// LAYOUT (the object `new T[n]` allocates):
//
//   +0  vtable pointer   ->  {+0 &tkarr_release_T, +8 0}   (TK_HAVTSIZE, the
//                                                            same 2-word shape
//                                                            a delegate's own
//                                                            vtable carries)
//   +8  reference count
//   +16 length (the `n` `new` was given)
//   +24 elements, width = type_width(T)
//
// so `rc_dec` (lib/rt.tk) frees an array it knows nothing about exactly
// as it frees a class: through word 0 of the vtable. The array object is
// COUNTED regardless of what T is (`tk_is_counted`, teko_struct.tk); an
// ELEMENT is released too, but ONLY when T itself is counted
// (`tkarr_release_T` skips the per-slot pass otherwise) -- `rt_release_array`
// (already in lib/rt.tk, today serving an inline array FIELD) is reused
// as-is.
//
// INDEXING AND `Length`. `xs[i]` is a run-time-checked address, `tk_arr_at`
// (lib/rt.tk, new): `0 <= i < xs.Length` or `panic`; `Length` itself is
// read-only, `ld64(xs + 16)`. Both resolve AT PARSE TIME, in `tk_bracket`
// (teko_params.tk) and `tk_dot` (teko_expr.tk)'s own `tk_member_of`, the same
// early branch the array-FIELD and local-fixed-array cases already are --
// for a receiver the parser already types (a local, teko_struct.tk's own
// `on_stmt`; a field, teko_expr.tk's `tk_field_use`; a call's own return)
// AND for a PARAMETER of `T[]` type, which the core never reports mid-body
// any more than a struct/class one is, but whose OWN type this module
// already knows: `teko_struct.tk`'s `tk_hp_*` table records it the instant
// `teko_default.tk`/`teko_class.tk` read the parameter, before the body
// that indexes it is even parsed -- no oracle, no placeholder, no deferred
// pass, the same reason `ref`/`out`'s own pointee (K2) needs none once the
// parameter itself is in hand.
//
// `panic` (K1, D221 §41 decision 18) is the guard `tk_arr_at` calls on an
// out-of-range index -- the same `rt_panic`, `exit(70)`, every other guard in
// this port uses.

#define TK_HAOBJSIZE 24                // vtable + count + length, before elements
#define TK_HAVTSIZE  16                // release + an unused itab word (delegate's own shape)

i64  ha_gen[TK_MAXSTRUCT];             // 1 once a row's vtable/release/alloc are top_add-ed
i64  ha_gen_at(i64 i)        { return ld64(ha_gen + i * 8); }
void set_ha_gen_at(i64 i, i64 v) { st64(ha_gen + i * 8, v); }

i64  ha_put[TK_MAXSTRUCT];             // 1 once a row's element store is top_add-ed too
i64  ha_put_at(i64 i)        { return ld64(ha_put + i * 8); }
void set_ha_put_at(i64 i, i64 v) { st64(ha_put + i * 8, v); }

// teko_expr.tk is included after this file: `xs[i](args)`, an array whose
// ELEMENT is a delegate (`Op[]`), reads the argument list the same way a
// delegate FIELD's own call does (`tk_field_deleg_call`).
i64 tk_args(uptr pn);

// A generated SYMBOL is mangled, never spelled: `tk_ty_mangle_name`
// (teko_struct.tk) is the identity every one of the four uses, because an
// element type may itself be a row whose registered NAME carries `?` (`Cell?`,
// Q1a) or `[`/`]` -- neither of which a linker symbol may hold. For every
// element type that is a plain word it is `type_name` itself, so the symbols
// this module already emitted do not move.
uptr tk_ha_relname(i64 ety)   { return tk_join("tkarr_release_", tk_ty_mangle_name(ety)); }
uptr tk_ha_vtname(i64 ety)    { return tk_join("tkarr_vt_", tk_ty_mangle_name(ety)); }
uptr tk_ha_allocname(i64 ety) { return tk_join("tkarr_new_", tk_ty_mangle_name(ety)); }
uptr tk_ha_putname(i64 ety)   { return tk_join("tkarr_put_", tk_ty_mangle_name(ety)); }

// `ld64(t + 16)`, freshly built every time: a node lives in only one sibling
// list, so a caller that needs it twice (the release fn's own size, and,
// when T is counted, the element count it passes to `rt_release_array` too)
// builds it twice rather than clone it.
i64 tk_ha_len(uptr t) { return tk_call("ld64", tk_bin(K_ADD, tk_id(t), tk_int(16))); }

// `void tkarr_release_T(uptr p) { [rt_release_array(p+24, len);] rt_free(p, 24+len*W); }`
// -- the per-slot pass runs only when an ELEMENT is itself counted; the array
// object is freed regardless of T.
i64 tk_ha_release_fn(i64 ety, uptr relname) {
    uptr t = "p";
    i64 size = tk_bin(K_ADD, tk_int(TK_HAOBJSIZE), tk_bin(K_MUL, tk_ha_len(t), tk_int(type_width(ety))));
    i64 st = 0;
    if (tk_is_counted(ety)) {
        i64 base = tk_bin(K_ADD, tk_id(t), tk_int(TK_HAOBJSIZE));
        st = tk_stmt(tk_call2("rt_release_array", base, tk_ha_len(t)));
    }
    st = list_append(st, tk_stmt(tk_call2("rt_free", tk_id(t), size)));
    return tk_func(TY_VOID, relname, param_new(TY_UPTR, t), tk_blk(st));
}

// `T[] tkarr_new_T(i64 n) { if (n<0) panic; uptr p=rt_alloc(24+n*W); vtable/
// count/length installed; return p; }` -- the vtable is filled on every
// call, idempotently, the same shape a delegate's own allocator fills.
i64 tk_ha_alloc_fn(i64 si, i64 ety, uptr allocname, uptr vtname, uptr relname) {
    i64 w = type_width(ety);
    i64 guard = tk_if(tk_bin(K_LT, tk_id("n"), tk_int(0)),
                      tk_stmt(tk_call("panic", tk_str("a negative array length"))));
    i64 size = tk_bin(K_ADD, tk_int(TK_HAOBJSIZE), tk_bin(K_MUL, tk_id("n"), tk_int(w)));
    i64 st = list_append(guard, tk_var(TY_UPTR, "p", tk_call("rt_alloc", size)));
    st = list_append(st, tk_stmt(tk_call2("st64", tk_id(vtname), tk_addr(relname))));
    st = list_append(st, tk_stmt(tk_call2("st64", tk_id("p"), tk_id(vtname))));
    i64 cnt = tk_bin(K_ADD, tk_id("p"), tk_int(8));
    st = list_append(st, tk_stmt(tk_call2("st64", cnt, tk_int(1))));
    i64 lenslot = tk_bin(K_ADD, tk_id("p"), tk_int(16));
    st = list_append(st, tk_stmt(tk_call2("st64", lenslot, tk_id("n"))));
    i64 r = tk_id("p");
    tk_xt_add(r, si, 1, TK_OWNED);                // a NAME, so pure; owned from the count
                                                  // above, not an rt_own
    st = list_append(st, tk_ret(r));
    return tk_func(sr_ty_at(si), allocname, param_new(TY_I64, "n"), tk_blk(st));
}

// `T[] tkarr_put_T(uptr a, i64 off, T v) { stW(a + off, v); return a; }` --
// ONE element of an array under construction, written at the site that builds
// it. A store is a statement and a construction has to be one EXPRESSION, so
// each link hands the array back to the next and a whole array is a chain of
// them over the allocator: `tkarr_put_i64(tkarr_put_i64(tkarr_new_i64(2), 24,
// a), 32, b)`. It is the shape `tk_cap_put` (lib/rt.tk) already builds a
// closure with, generated per ELEMENT TYPE instead of written once, which is
// what lets `v` be DECLARED at that type: a float travels in the other
// register file and an `i64` parameter never receives it, so `f64` is declared
// `f64` and stored with `stf64` -- `tk_stn` (teko_struct.tk) is the one table
// that picks between `st8`/`st16`/`st32`/`st64`/`stf32`/`stf64`, and no new
// runtime helper is needed for any of them.
//
// The offset is the caller's constant (`TK_HAOBJSIZE + k * width`), not an
// index: an element wider or narrower than a word costs the site an addition
// the generated code does not repeat.
//
// OWNERSHIP. The array carries exactly ONE reference for the whole chain --
// the count `tkarr_new_T` was born with -- and no link may add or drop one.
// Registering the returned name as owned is what says so: `tk_rc_return`
// (teko_rc.tk) increments a BORROWED value on its way out of a function whose
// declared return type is counted, and an increment per link is a reference
// the statement's own sweep never gives back. The mirror of the same rule
// belongs to the CALL SITE, where the OUTER node of the chain is registered
// borrowed so the park happens once, at the allocator inside it.
//
// A COUNTED element earns its own reference, `rt_own` (lib/rt.tk), exactly as
// `tk_cap_own` takes one for a capture of class type: the array is what holds
// it from there on, and `tkarr_release_T`'s own per-slot pass is what gives it
// back.
i64 tk_ha_put_fn(i64 si, i64 ety, uptr putname) {
    uptr a = "a";
    i64 v = tk_id("v");
    if (tk_is_counted(ety)) v = tk_call("rt_own", v);
    i64 slot = tk_bin(K_ADD, tk_id(a), tk_id("off"));
    i64 st = tk_stmt(tk_call2(tk_stn(ety), slot, v));
    i64 r = tk_id(a);
    tk_xt_add(r, si, 1, TK_OWNED);                // a NAME, so pure; OWNED is what keeps the
                                                  // chain's one reference off rc_inc
    st = list_append(st, tk_ret(r));
    i64 prs = param_new(TY_UPTR, a);
    prs = list_append(prs, param_new(TY_I64, "off"));
    prs = list_append(prs, param_new(ety, "v"));
    return tk_func(sr_ty_at(si), putname, prs, tk_blk(st));
}

// generates the three top-level declarations a row needs, once, the first
// time the row is actually ALLOCATED (`new T[n]`) -- not the first time it is
// merely SPELLED. `new T[n]` is an expression, so this always runs inside a
// declaration of the program's own (a body, or a parameter list still being
// read): the three go through `tk_top_emit` (teko_struct.tk), which keeps the
// `p_decl_name()` a bare `top_add` would clear (K6, DECISION_LOG.md D27).
void tk_ha_ensure_gen(i64 si) {
    if (ha_gen_at(si)) return;
    set_ha_gen_at(si, 1);
    i64 ety = ha_ety_at(si);
    uptr relname = tk_ha_relname(ety);
    uptr vtname = tk_ha_vtname(ety);
    tk_top_emit(tk_glb(TY_U8, vtname, TK_HAVTSIZE));
    tk_top_emit(tk_ha_release_fn(ety, relname));
    tk_top_emit(tk_ha_alloc_fn(si, ety, tk_ha_allocname(ety), vtname, relname));
}

// the element store, behind a flag of its OWN: a row that is merely allocated
// (`new T[n]`) does not pay for it, so a program that never builds an array
// out of a list of expressions keeps the tree it had. The allocator group is
// ensured first because a chain has nothing to write into without it.
void tk_ha_ensure_put(i64 si) {
    tk_ha_ensure_gen(si);
    if (ha_put_at(si)) return;
    set_ha_put_at(si, 1);
    i64 ety = ha_ety_at(si);
    tk_top_emit(tk_ha_put_fn(si, ety, tk_ha_putname(ety)));
}

// `tk_arr_at(base, idx, width)` -- the run-time-checked address (lib/rt.tk's
// new `tk_arr_at`), shared by every load/store/compound below.
i64 tk_ha_addr(i64 base, i64 idx, i64 ety) {
    return tk_call("tk_arr_at", list_append(list_append(base, idx), tk_int(type_width(ety))));
}

// the borrowed load: `tk_arr_load` (teko_array.tk) already sign-extends a
// narrow signed element, and a counted one is tagged pure (re-reading the
// slot is free) exactly as the struct-field precedent tags its own.
i64 tk_ha_load(i64 base, i64 ety, i64 idx) {
    i64 r = tk_arr_load(ety, tk_ha_addr(base, idx, ety));
    // the ELEMENT type, whatever it is -- the row when it has one and the type
    // id in every case, the same registration a field load carries
    // (`tk_field_use`, teko_expr.tk). A scalar element answered -1 to every
    // oracle, and the load is what `xs[0] += 100;` stores back through the
    // gate: no one could type the sum (Copilot on #698, pass 4).
    tk_xt_put(r, tk_struct_by_ty(ety), ety, 1, TK_BORROWED);
    return r;
}

// the store: the SAME `stW(addr, v)` call teko_struct.tk's own array-field
// store builds, marked for teko_rc.tk's own pass to pick between `rt_store`/
// `rt_store_own` when the element is counted -- zero new machinery there.
// An element is a slot like any other (D50): the value goes through the ONE
// door every field store is built by -- the deferral first, then the two
// scalar verdicts, the row one and Q1b's box, all of them `tk_field_store_val`
// (teko_typeof.tk). It used to call the row check ALONE, which judged before
// the overload pick and skipped the scalar half entirely: `Cell[] xs; xs[0] =
// rick(1, 2);` was refused by the FIRST declaration of an overloaded name,
// `i64[] a; a[0] = 1.5;` compiled and wrote the double's raw bits, and
// `f64[] f; f[0] = 1;` wrote the integer's (Copilot on #698, pass 4).
i64 tk_ha_store(i64 base, i64 ety, i64 idx, i64 v) {
    // `ops[i] = e` on an `Op[]`: the one validator every slot of delegate type
    // shares (`tk_deleg_coerce`, teko_deleg.tk), asked HERE rather than in
    // `tk_ha_index` below, because this is the point BOTH element stores pass
    // through -- a local array's, built by the parser, and a global array's,
    // built by `tk_array_resolve_write` (teko_array.tk), which coerced nothing
    // at all. A value nothing in reach of the store can name waits for
    // `tk_deleg_pass` instead of being guessed to be a function (D51, third
    // pass) -- and a store the GLOBAL write builds waits whole, because that
    // one is assembled inside a pass where no scope answers for any name at
    // all, not even to be asked (D51, fourth pass).
    // ...and a store that waits is judged by that validator ALONE (D51,
    // seventh pass). The door below (`tk_field_store_val`, teko_typeof.tk)
    // would judge the waiting value all the same, and its row check types a
    // name and a call from the same parse-time tables the guard above just
    // refused to trust: `Op[]` taking a `new Other()` or an `Other` local
    // died `teko: a value of type Other does not convert to Op` -- the
    // generic conversion words, ahead of the delegate's own
    // `teko: Op takes a function, another Op, or null` -- and a call through
    // a LOCAL delegate shadowing a function was refused over the FUNCTION's
    // return type, a legal program. One judgement per store: `null` and the
    // shapes the door types keep the door (the null rule for an element is
    // its road to Q1a), and what waits is `tk_deleg_late_do`'s, whole.
    //
    // An `Op?[]` element is a `TK_KNULL` row of its own, so `tk_deleg_row`
    // answers -1 for it and the whole delegate half above is skipped: the
    // COERCION rightly (a `null` belongs in that element, and the door below
    // is what judges it), the ESCAPE wrongly -- and a GLOBAL array's store is
    // built inside `tk_array_pass`, where the rule cannot run at all, so a
    // by-reference capture reached both kinds of nullable element unrefused
    // (D51, twelfth pass). The row UNDER the `?` is what the escape reads
    // (`tk_deleg_row_under`), here and at the parse site below, and the
    // global's own store waits for the walk with `dl_si` = -1: the escape
    // alone, no coercion, the door having already judged `null` and the type.
    i64 dsi = tk_deleg_row(ety);
    i64 late = tk_deleg_store_late(dsi, v);
    i64 lateesc = tk_deleg_defer_all && !late && tk_deleg_row_under(ety) >= 0;
    if (dsi >= 0 && !late) v = tk_deleg_coerce(dsi, v, tk_line, tk_file);
    i64 line = tk_line;
    uptr fl = tk_file;
    if (!late) v = tk_field_store_val(ety, v, line, fl);
    tk_line = line;                               // the gate builds nodes of its own
    tk_file = fl;
    i64 st = tk_os_mark(tk_call2(tk_stn(ety), tk_ha_addr(base, idx, ety), v), ety);
    if (late) tk_deleg_store_defer(st, dsi, line, fl);
    if (lateesc) tk_deleg_store_defer(st, 0 - 1, line, fl);
    return st;
}

// `xs[i] OP= e` / `xs[i]++` / `xs[i]--`: the address is built twice (once to
// read, once to write), the same trade `tk_arr_compound`'s own header
// accepts for a local fixed array -- no fixture indexes with a call.
i64 tk_ha_compound(i64 base, i64 ety, i64 idx, i64 op, i64 v) {
    i64 idx2 = tk_clone(idx);
    i64 base2 = tk_clone(base);
    i64 cur = tk_ha_load(base, ety, idx);
    return tk_ha_store(base2, ety, idx2, tk_bin(op, cur, v));
}

// `xs[i](args)` -- an array whose ELEMENT is a delegate (`Op[]`): the same
// call `teko_expr.tk`'s own `tk_field_deleg_call` builds for a delegate
// FIELD, over the array's own guarded address instead of a field's fixed
// offset.
i64 tk_ha_deleg_call(i64 addr, i64 ety, i64 di, i64 line, uptr fl) {
    i64 obj = tk_ld(ety, addr);
    i64 na = 0;
    i64 args = tk_args(&na);
    i64 r = tk_deleg_build(di, obj, args, na, line, fl);
    i64 ret = dg_ret_at(di);
    tk_xt_put(r, tk_struct_by_ty(ret), ret, 0, TK_OWNED);
    return r;
}

// `xs[i]`, `xs[i] = e`, `xs[i] += e` / `-=` / `++` / `--`: `left` already
// types as a `T[]` row -- a local, a field, or a call's own return -- so the
// element type and the guarded address are known here, at parse time, the
// same early branch the array-FIELD and local-fixed-array cases already are
// (teko_params.tk's own `tk_bracket`).
i64 tk_ha_index(i64 left, i64 si) {
    i64 ety = ha_ety_at(si);
    // `new T[n][]` (D100): the `[]` right after a FRESH allocation is not an
    // index at all -- it is the second rank of the type, and the jagged
    // allocator that would fill those rows is not taught yet. Recognized by
    // the callee's own name, so an empty `[]` after anything else keeps the
    // reading it has today.
    if (p_id() == K_RBRACK)
        if (nd_kind(left) == N_CALL)
            if (str_eq(nd_name(left), tk_ha_allocname(ety)))
                err_at(p_file(), p_line(), "teko: `new T[n][]` is not taught yet");
    i64 line = p_line();
    uptr fl = p_file();
    i64 idx = parse_expr(0);
    p_expect(K_RBRACK, "expected ] after the index");
    tk_line = line;
    tk_file = fl;
    if (tk_bracket_no_write && tk_arr_write_follows())
        err_at(fl, line, "teko: the left side of = is not a place");
    if (p_accept(K_ASSIGN)) {
        i64 v = tk_deleg_rhs(ety, line, fl);     // D66: `fs[0] = (i64 x) => ...`
        tk_line = line;
        tk_file = fl;
        // D221/§41 K4b -- a syntactic verdict over the lambda as it was
        // written, so it stays at the site that reads it; the coercion itself
        // belongs to `tk_ha_store` above, which every element store shares.
        // A GLOBAL array's store never passes here at all (its own write is
        // built in `tk_array_pass`), so the same verdict is taken over the
        // same value by `tk_deleg_late_do` (teko_deleg.tk), at the walk that
        // stands where this parse site would (D51, fourth pass). The row is
        // read with the `?` peeled off (`tk_deleg_row_under`): an `Op?[]`
        // element outlives the capture exactly as an `Op[]` one does, and the
        // `TK_KNULL` row of its own was answering -1 here (D51, twelfth pass).
        if (tk_deleg_row_under(ety) >= 0 && tk_lam_escapes(v))
            err_at(fl, line, "teko: a lambda that captures by reference cannot leave its scope");
        return tk_ha_store(left, ety, idx, v);
    }
    if (p_id() == tk_pluseq_tok || p_id() == tk_minuseq_tok) {
        i64 op = K_ADD;
        if (p_id() == tk_minuseq_tok) op = K_SUB;
        p_next();
        i64 e = parse_expr(0);
        tk_line = line;
        tk_file = fl;
        return tk_ha_compound(left, ety, idx, op, e);
    }
    if (p_id() == tk_incr_tok || p_id() == tk_decr_tok) {
        i64 op = K_ADD;
        if (p_id() == tk_decr_tok) op = K_SUB;
        p_next();
        tk_line = line;
        tk_file = fl;
        return tk_ha_compound(left, ety, idx, op, tk_int(1));
    }
    i64 di = tk_deleg_row(ety);
    if (di >= 0 && p_id() == K_LPAR) return tk_ha_deleg_call(tk_ha_addr(left, idx, ety), ety, di, line, fl);
    return tk_ha_load(left, ety, idx);
}

// `xs.Length` -- the one member a `T[]` answers, checked here because
// `tk_member_of` already knows `left` types as a KARRAY row.
i64 tk_ha_member_of(i64 left, i64 si, uptr m, i64 line, uptr fl) {
    if (!str_eq(m, "Length")) err_at2(fl, line, "teko: an array has no member", m);
    if (p_id() == K_ASSIGN) err_at2(fl, line, "teko: is read-only", m);
    tk_line = line;
    tk_file = fl;
    return tk_call("ld64", tk_bin(K_ADD, left, tk_int(16)));
}

// `new T[n]` -- the type word `T` was already read (`type_of_token`, before
// `tk_new` consumed it) and the `[` is what tells this apart from `new
// Op(fn)`/`new Point`/`new Box<...>`. `ety` can never itself be a `T[]` row
// here: its own reserved word (`i64[]`) is a lexeme the lexer cannot form, so
// no source text can name it as the word right after `new`. `T[][]` is a type
// this module READS (D100, `tk_ha_type` below), but the jagged ALLOCATOR is
// not taught: the trailing `[]` of `new T[n][]` reaches the index door, where
// `tk_ha_index` refuses it, and a jagged array's rows come from a store.
i64 tk_new_array(i64 ety, i64 line, uptr fl) {
    if (ety == TY_VOID) err_at(fl, line, "teko: an array of type void");
    p_next();                                     // the '['
    if (p_id() == K_RBRACK) err_at(fl, line, "teko: `new T[]` needs a length; write `new T[n]`");
    i64 n = parse_expr(0);
    p_expect(K_RBRACK, "expected ] after the array length");
    tk_line = line;
    tk_file = fl;
    i64 ty = tk_ha_row(ety);
    i64 si = tk_struct_by_ty(ty);
    tk_ha_ensure_gen(si);
    i64 call = tk_call(tk_ha_allocname(ety), n);
    tk_xt_add(call, si, 0, TK_OWNED);
    return call;
}

// `syntax_type`: consulted right after the core has read a type word and
// advanced past it, at every position that reads one -- a suffix this
// module owns, `[]`, answers with `tk_ha_row`'s own memoized id; anything
// else stands. `take_type` (mc's own) dispatches this ONCE per type
// position, so a SECOND `[]` right after the first (`T[][]`) is not another
// call here -- the suffix chain is read by the LOOP below, which is the whole
// of jagged support (D100): the row of a row is a row like any other, and
// every road an element type already had (the mangled allocator/release pair,
// `tk_ha_release_fn`'s per-slot pass over a counted element, `tk_arr_at`'s
// guarded address) carries it unchanged. The `?` of Q1a is a suffix of the
// same position, so it is read inside the loop too: `T[]?[]` is an array of
// nullable rows, `T[][]?` a nullable array of rows.
i64 tk_ha_type(i64 ty) {
    if (ty == TY_VOID) return 0;
    if (p_id() != K_LBRACK) return 0;
    i64 row = ty;
    loop {
        if (p_id() != K_LBRACK) break;
        p_next();
        p_expect(K_RBRACK, "expected ] after the element type");
        row = tk_ha_row(row);
        // Q1a: `Cell[]?`, a NULLABLE array. `take_type` dispatches the chain
        // once per type position, so the `?` that follows `[]` has to be read
        // here -- this is the array half of the two-line cooperation
        // teko_null.tk's own `tk_nl_type` makes from the other side
        // (`Cell?[]`).
        if (p_id() == tk_nl_quest) {
            i64 line = p_line();
            uptr fl = p_file();
            p_next();
            if (p_id() == tk_nl_quest) err_at(fl, line, "teko: a nullable of a nullable is not taught");
            row = tk_nl_row(row);
        }
    }
    return row;
}

void tk_ha_init() {
    syntax_type(&tk_ha_type);
}
