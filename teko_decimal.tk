// teko_decimal.tk -- `decimal` itself: the registration, and the literal.
// C3 of docs/specs/decimal.md (§ 1, § 3, § 12), D74.
//
// It is one of `teko_wide.tk`'s clients and carries none of its machine: the
// sixteen bytes MOVE because `tk_wide_add` put this id in the wide set, and the
// three derived tables never name `decimal` at all. `Guid`, `DateTimeOffset`
// and `i128` land the same way when their crumbs come, each with one line here
// and none there.
//
// **No arithmetic, no comparison, no conversion and no member.** C3 moves the
// value and reads its bytes; C4 is the arithmetic, C5 round and text
// (docs/reference/not-yet.md). Every one of those is refused by name today,
// and all but one of the refusals is a wording this compiler already had:
//
//   d + d, d < d          teko_ops.tk        no operator `+` takes these operands
//   i64 n = d;            teko_typeof.tk     a value of type decimal does not convert to i64
//   decimal d = 5;        teko_typeof.tk     a value of type i64 does not convert to decimal
//   (i64) d               teko_prim.tk       a decimal does not cast yet   <- the new one
//   d.Foo, decimal.Foo    teko_expr.tk       unknown member of decimal
//   const decimal R = 1m; teko_const.tk      const requires a constant expression
//   case 1m:              teko_switch.tk     a case label must be a constant expression
//
// The first five come free from ONE registration -- `tk_prim_type`, the
// primitive-member mechanism `TimeSpan` and `DateTime` already ride
// (docs/specs/datetime.md § 2) -- which is why this file registers `decimal`
// there with no member row at all: a primitive with an empty table converts to
// nothing but itself, claims no operator, and answers every member by name.

// ---- the representation (docs/specs/decimal.md § 1) ----
// Sixteen bytes, sixteen-byte aligned, little-endian in memory:
//
//   +0  bits  0..63   the low 64 bits of the 96-bit mantissa
//   +8  bits  0..31   the high 32 bits of the mantissa
//   +8  bits 32..39   the scale, 0..28
//   +8  bits 40..62   zero
//   +8  bit  63       the sign, 1 negative
//
// The value is `(-1)^sign * mantissa / 10^scale`. It is C#'s information in
// teko's own order: C# packs `flags`, `hi`, `lo`, `mid` as four `int`s, and two
// `i64` halves are what surface code reads with one `ld64` each (`tk_dec_ld`,
// lib/decimal.tk). `0m`, `0.00m` and `-0m` are three distinct bit patterns and
// all three are equal, which is C#'s rule and the reason equality will be a
// call and never a `cmp`.
#define TK_DEC_MAXSCALE 28

i64 tk_ty_decimal = 0;

// ---- the literal: <digits>[.<digits>][e[+|-]<digits>](m|M) ----
// A 128-bit value does not fit `MTASK_CONST`'s single `i64` and an `N_INT`'s
// `val` is one `i64`, so the literal becomes a module-private GLOBAL with an
// `N_BLOB` initializer and the node returned is an `N_IDENT` naming it -- the
// shape `mc`'s own `<i128>` uses, with two differences of teko's own: the name
// is gensym'd with a `$` the lexer never forms into an identifier, so it cannot
// collide with anything a program wrote, and the declaration goes through
// `tk_top_emit` (docs/internals/nodes-and-xt.md) rather than a bare `top_add`,
// because a literal fires in the MIDDLE of the declaration being parsed and the
// core clears `p_decl_name()` on every `top_add`.
//
// **The registration order is load-bearing** (§ 3, § 13): `<float>`'s own
// `fl_lit` reads `1.5` and stops before the `m`, leaving an identifier the
// parser would choke on and, worse, leaving `1.5m` typed `f64` at any site
// where `m` happened to parse. Handlers run in registration order and the first
// non-zero node wins, so `tk_dec_init()` runs BEFORE `tk_float_init()` in
// `teko_init()` and this handler declines -- `return 0` -- everything that does
// not end in `m` or `M`. `tests/primitives_decimal_order.tk` is the oracle.
u64 tk_dl0 = 0;                       // the mantissa in four 32-bit limbs
u64 tk_dl1 = 0;
u64 tk_dl2 = 0;
u64 tk_dl3 = 0;                       // bits 96..127: non-zero is out of range
i64 tk_dl_ovf = 0;
i64 tk_ndeclit = 0;                   // the literal globals, numbered

void tk_dl_reset() { tk_dl0 = 0; tk_dl1 = 0; tk_dl2 = 0; tk_dl3 = 0; tk_dl_ovf = 0; }

i64 tk_dl_isdig(i64 c) { return c >= '0' && c <= '9'; }

// value = value * m + add, over 128 bits -- `iw_muladd`'s own shape. A carry
// out of the top limb is remembered rather than dropped, so `1e40m` is refused
// instead of wrapping.
void tk_dl_muladd(u64 m, u64 add) {
    u64 c = add;
    u64 p = tk_dl0 * m + c;  tk_dl0 = p & 0xffffffff;  c = p >> 32;
    p = tk_dl1 * m + c;      tk_dl1 = p & 0xffffffff;  c = p >> 32;
    p = tk_dl2 * m + c;      tk_dl2 = p & 0xffffffff;  c = p >> 32;
    p = tk_dl3 * m + c;      tk_dl3 = p & 0xffffffff;  c = p >> 32;
    if (c) tk_dl_ovf = 1;
}

// how many digits sit at `q`, and where they end
uptr tk_dl_skip(uptr q, uptr e) {
    loop {
        if (q >= e || !tk_dl_isdig(ld8(q))) break;
        q = q + 1;
    }
    return q;
}

// one decimal digit into the accumulator
uptr tk_dl_eat(uptr q, uptr e) {
    loop {
        if (q >= e || !tk_dl_isdig(ld8(q))) break;
        tk_dl_muladd(10, ld8(q) - '0');
        q = q + 1;
    }
    return q;
}

// the gensym: `$tk_dec_<n>`, in the arena
uptr tk_dl_name() {
    u8 nb[24];
    i64 nn = 0;
    i64 v = tk_ndeclit;
    tk_ndeclit = tk_ndeclit + 1;
    loop {
        st8(nb + nn, '0' + v % 10);
        v = v / 10;
        nn = nn + 1;
        if (v == 0) break;
    }
    uptr name = xalloc(10 + nn);
    mem_copy(name, "$tk_dec_", 8);
    i64 k = 0;
    loop {
        if (k >= nn) break;
        st8(name + 8 + k, ld8(nb + nn - 1 - k));
        k = k + 1;
    }
    st8(name + 8 + nn, 0);                    // the terminator, written, never assumed of the arena
    return name;
}

// the sixteen bytes, little-endian, byte by byte
uptr tk_dl_blob(u64 lo, u64 hi) {
    uptr b = xalloc(16);
    i64 i = 0;
    loop {
        if (i >= 8) break;
        st8(b + i, (lo >> (i * 8)) & 0xff);
        st8(b + 8 + i, (hi >> (i * 8)) & 0xff);
        i = i + 1;
    }
    return b;
}

i64 tk_dec_lit() {
    uptr s = p_start();
    uptr e = p_src_end();
    if (s >= e || !tk_dl_isdig(ld8(s))) return 0;

    // ---- first pass: find the suffix, and decline everything that is not one
    // Nothing is accumulated and nothing is consumed until the `m` is in hand,
    // so `0.5`, `1`, `1.5e3` and `0x10` all leave this handler exactly as they
    // reached it and go on to the next one.
    uptr q = tk_dl_skip(s, e);
    i64 nfrac = 0;
    if (q < e && ld8(q) == '.' && q + 1 < e && tk_dl_isdig(ld8(q + 1))) {
        uptr f = q + 1;
        q = tk_dl_skip(f, e);
        nfrac = q - f;
    }
    uptr epos = 0;
    i64 eneg = 0;
    if (q < e && (ld8(q) == 'e' || ld8(q) == 'E')) {
        uptr x = q + 1;
        i64 sgn = 0;
        if (x < e && (ld8(x) == '+' || ld8(x) == '-')) { sgn = ld8(x); x = x + 1; }
        if (x < e && tk_dl_isdig(ld8(x))) {
            epos = x;
            if (sgn == '-') eneg = 1;
            q = tk_dl_skip(x, e);
        }
    }
    if (q >= e) return 0;
    i64 suf = ld8(q);
    if (suf != 'm' && suf != 'M') return 0;
    if (q + 1 < e && is_alnum(ld8(q + 1))) return 0;

    // ---- second pass: the digits, most significant first
    i64 line = p_line();
    uptr fl = p_file();
    tk_dl_reset();
    uptr r = tk_dl_eat(s, e);
    if (nfrac) tk_dl_eat(r + 1, e);

    i64 exp = 0;
    if (epos) {
        uptr x = epos;
        loop {
            if (x >= e || !tk_dl_isdig(ld8(x))) break;
            if (exp < 1000) exp = exp * 10 + (ld8(x) - '0');
            x = x + 1;
        }
        if (eneg) exp = 0 - exp;
    }

    // the scale is the count of fraction digits, and the exponent shifts it. A
    // NEGATIVE scale is no representation at all: the mantissa absorbs it, ten
    // at a time, and overflows loudly if it cannot.
    i64 scale = nfrac - exp;
    loop {
        if (scale >= 0) break;
        tk_dl_muladd(10, 0);
        scale = scale + 1;
    }
    if (scale > TK_DEC_MAXSCALE)
        err_at(fl, line, "teko: a decimal carries at most 28 decimal places");
    if (tk_dl_ovf || tk_dl3)
        err_at(fl, line, "teko: decimal literal out of range");

    q = q + 1;
    p_take_lit(q);

    // every refusal above is `err_at`, which exits the compiler (mc arena.mc):
    // nothing below runs on a refused literal, so `scale` is in range here
    u64 lo = tk_dl0 | (tk_dl1 << 32);
    u64 hi = tk_dl2 | (scale << 32);          // the sign bit is the unary `-`'s, never a literal's
    uptr name = tk_dl_name();
    i64 blob = node_new(N_BLOB, line, fl);
    set_nd_name(blob, tk_dl_blob(lo, hi));
    set_nd_val(blob, 16);
    i64 g = node_new(N_GLOBAL, line, fl);
    set_nd_type(g, tk_ty_decimal);
    set_nd_name(g, name);
    set_nd_val(g, 0);
    set_nd_a(g, blob);
    tk_top_emit(g);
    i64 id = node_new(N_IDENT, line, fl);     // the expression IS the global
    set_nd_name(id, name);
    set_nd_type(id, tk_ty_decimal);
    p_next();
    return id;
}

// ---- the API (docs/specs/decimal.md § 7; D79) ----
// Every row names an ordinary function of `lib/decimal.tk` with surface code,
// and the mechanism is teko_prim.tk's member table -- the one `TimeSpan`
// brought and `Guid` reads with a WIDE receiver (D75). `decimal` is the first
// type whose rows take a wide ARGUMENT as well (`decimal.Round(d, 2)`), which
// is the one line of teko_prim.tk this crumb owed (`tk_prim_arg_widen`, D79).
//
// `ToDouble` and `FromDouble` are NOT registered (D79, ruling 1): `(f64) d`
// and `(decimal) x` are C4's own conversion rows and are the same two
// functions under C#'s own spelling of them (§ 6), so a member would be a
// second door to one road.
void tk_dec_statics() {
    i64 d = tk_ty_decimal;
    tk_prim_member(d, "Zero",     TK_PMSVAL, 0 - 1, "tk_dec_zero",     d);
    tk_prim_member(d, "One",      TK_PMSVAL, 0 - 1, "tk_dec_one",      d);
    tk_prim_member(d, "MinusOne", TK_PMSVAL, 0 - 1, "tk_dec_minusone", d);
    tk_prim_member(d, "MaxValue", TK_PMSVAL, 0 - 1, "tk_dec_max",      d);
    tk_prim_member(d, "MinValue", TK_PMSVAL, 0 - 1, "tk_dec_min",      d);
    // the two `Round` rows are one overload set told apart by the number of
    // arguments written (`tk_prim_pick`), the way `.ToString()` and
    // `.ToString(n)` are below
    tk_prim_member(d,  "Round", TK_PMSFUN, d, "tk_dec_round", d);
    tk_prim_member2(d, "Round", TK_PMSFUN, d, TY_I64, "tk_dec_round_at", d);
    tk_prim_member(d, "Truncate", TK_PMSFUN, d, "tk_dec_trunc", d);
    tk_prim_member(d, "Floor",    TK_PMSFUN, d, "tk_dec_floor", d);
    tk_prim_member(d, "Ceiling",  TK_PMSFUN, d, "tk_dec_ceil",  d);
    tk_prim_member(d, "Abs",      TK_PMSFUN, d, "tk_dec_abs",   d);
    tk_prim_member(d, "Parse",    TK_PMSFUN, TY_UPTR, "tk_dec_parse", d);
    // The row `tk_dec_tryparse_expr` below never emits: `decimal.TryParse(s,
    // out d)` is hand-parsed, because `out <name>` is no column this table has
    // (teko_prim.tk's `pmr_*` rows carry a type per position and no KIND). It
    // is registered all the same, so `d.TryParse(...)` on an instance answers
    // ``teko: decimal.TryParse is static; reach it through its type`` instead
    // of reading as a member nobody ever heard of -- `Guid`'s own shape (D75).
    tk_prim_membern(d, "TryParse", TK_PMSFUN, 2, TY_UPTR, "tk_dec_tryparse", TY_I64);
}

void tk_dec_members() {
    i64 d = tk_ty_decimal;
    tk_prim_member(d, "ToString", TK_PMFUN, 0 - 1,  "tk_dec_tostring",   TY_UPTR);
    tk_prim_member(d, "ToString", TK_PMFUN, TY_I64, "tk_dec_tostring_n", TY_UPTR);
    tk_prim_member(d, "CompareTo", TK_PMFUN, d, "tk_dec_cmp", TY_I64);
    tk_prim_member(d, "Equals",    TK_PMFUN, d, "tk_dec_eq",  TY_I64);
    // `.Scale` is the raw byte of the layout (§ 1) and `.Sign` is C#'s
    // `-1`/`0`/`1` over the VALUE -- `tk_dec_signum` and not `tk_dec_sign`,
    // which is the sign BIT and answers 1 for `-0m`.
    tk_prim_member(d, "Scale", TK_PMPROP, 0 - 1, "tk_dec_scale",   TY_I64);
    tk_prim_member(d, "Sign",  TK_PMPROP, 0 - 1, "tk_dec_signum", TY_I64);
}

// ---- `decimal.TryParse(s, out d)`, parsed by hand ----
// `tk_guid_tryparse_expr`'s own shape (teko_guid.tk) and for the same reason:
// `out d` is read through `tk_ref_addr` (teko_ref.tk) rather than through
// `parse_expr`'s registered `out` handler, and the argument is TAGGED after
// the fact so teko_ref.tk's pass judges what parse time could not -- a
// global's declared type, and a `ref`/`out` parameter repassed as the caller's
// own slot rather than `&name`, the callee's slot that dies on return.
i64 tk_dec_tryparse_expr(i64 line, uptr fl) {
    tk_prim_need_include(tk_ty_decimal, "tk_dec_tryparse", line, fl);
    p_expect(K_LPAR, "expected ( after TryParse");
    i64 se = parse_expr(0);
    p_expect(K_COMMA, "expected , after the string");
    if (type_of_token(p_id()) != tk_ty_out)
        err_at(fl, line, "teko: TryParse's second argument is `out <name>`");
    p_next();
    i64 pty = 0 - 1;
    i64 oe = tk_ref_addr(line, fl, &pty);
    p_expect(K_RPAR, "expected ) after TryParse");
    if (pty >= 0 && pty != tk_ty_decimal)
        tk_reject_compat(tk_pointee_name(pty), "decimal", line, fl);
    tk_rfarg_tag(oe, TK_RP_OUT, pty);
    tk_line = line;
    tk_file = fl;
    return tk_call2("tk_dec_tryparse", se, oe);
}

// the type word in EXPRESSION position: this file's own handler rather than
// teko_prim.tk's `tk_prim_expr`, for the one static above. Every other member
// goes straight to the table, with the member name already read
// (`tk_prim_static_m`), so nothing is duplicated here.
i64 tk_dec_expr() {
    i64 line = p_line();
    uptr fl = p_file();
    p_next();                                    // the type word
    if (!p_accept(tk_dot_tok))
        err_at2(fl, line, "teko: a type name reaches its static members", "decimal");
    uptr m = tk_member_name();                   // D68
    if (str_eq(m, "TryParse")) return tk_dec_tryparse_expr(line, fl);
    return tk_prim_static_m(tk_ty_decimal, m, line, fl);
}

// ---- registration ----
// Called from `teko_init()` BEFORE `tk_float_init()`, for the literal's sake
// (§ 3); the MACHINE is registered separately and after it (`tk_wide_init`,
// teko_wide.tk), because a derived table has to copy the table `<float>` left
// in place and not the one underneath it.
//
// `type_new("decimal", 16, 16, TK_WIDE)` is the whole of the representation:
// the sixteen-byte frame slot, the sixteen-byte global and the sixteen-byte
// array element all come from `type_width`, and `TK_WIDE` is what tells the
// core "wider than a register, lives in a slot". It is a PRIMITIVE and not a
// `struct` because a teko `struct` value is a pointer to an allocation
// (docs/reference/types.md): a `decimal` field would be a reference to sixteen
// bytes on the arena, copied by aliasing rather than by value, and every
// `decimal` in a loop would be a block to reclaim. C# gives it value semantics
// and no heap, and `type_new` is the mechanism that gives exactly that.
//
// `syntax_expr("decimal")` and `syntax_stmt("decimal")` are what let the type
// word open an expression and a statement (`decimal.Zero`, `decimal.Round(d)`);
// the core's own type parser already reads `decimal d = ...;` from the
// registry. They are the two rows D74 left unspent for C5, and they count as
// ONE row of `mc limits`' `syntax`, which is keyed by NAME.
void tk_dec_init() {
    tk_ty_decimal = type_new("decimal", 16, 16, TK_WIDE);
    tk_wide_add(tk_ty_decimal, "tk_dec_ld", "tk_dec_st", "tk_dec_retbuf");
    // D79: the reader and the builder columns are filled, so `(str) d` --
    // the one cast the conversion table does not name -- says what writes the
    // text and what reads it back instead of C3's shorter "does not cast yet".
    tk_prim_type(tk_ty_decimal, "decimal", "decimal.tk",
                 "`.ToString()` writes it", "`decimal.Parse(s)` reads it", "0m");
    syntax_lit(&tk_dec_lit);
    syntax_expr("decimal", &tk_dec_expr);
    syntax_stmt("decimal", &tk_prim_stmt);
    tk_dec_statics();
    tk_dec_members();
}

// ---- the operators and the conversions (§ 5, § 6; D77) ----
// Called from `teko_init()` AFTER `tk_float_init()`, because the two float
// rows name `ty_f64` -- the id `<float>`'s own registration returns -- and
// `tk_dec_init()` above has to run BEFORE it for the literal's sake. One
// registration cannot be both, so it is two.
//
// TWELVE operator rows and no more. There is no `decimal`/`i64` row of any
// kind: an integer operand is CONVERTED before the operator pass ever looks
// for a row (`tk_ops_promote`, teko_ops.tk), which is C# §12.4.5's binary
// numeric promotion and the same door the float side already goes through --
// so `d + 1`, `1 + d`, `d += 1`, `d++` and every one of the eleven operators
// are covered by the rows below without a mixed row anywhere.
//
// Unary `+` has no row either (D77, ruling 4): `tk_prim_unary_plus`
// (teko_prim.tk) reads the `decimal + decimal` row to know this is a number
// and hands the operand straight back.
void tk_dec_ops() {
    i64 d = tk_ty_decimal;
    tk_prim_op(K_ADD, 2, d, d, "tk_dec_add", d, 0);
    tk_prim_op(K_SUB, 2, d, d, "tk_dec_sub", d, 0);
    tk_prim_op(K_MUL, 2, d, d, "tk_dec_mul", d, 0);
    tk_prim_op(K_DIV, 2, d, d, "tk_dec_div", d, 0);
    tk_prim_op(K_MOD, 2, d, d, "tk_dec_rem", d, 0);
    tk_prim_op(K_SUB, 1, d, 0 - 1, "tk_dec_neg", d, 0);
    tk_prim_op(K_EQ, 2, d, d, "tk_dec_eq", TY_I64, 0);
    tk_prim_op(K_NE, 2, d, d, "tk_dec_ne", TY_I64, 0);
    tk_prim_op(K_LT, 2, d, d, "tk_dec_lt", TY_I64, 0);
    tk_prim_op(K_LE, 2, d, d, "tk_dec_le", TY_I64, 0);
    tk_prim_op(K_GT, 2, d, d, "tk_dec_gt", TY_I64, 0);
    tk_prim_op(K_GE, 2, d, d, "tk_dec_ge", TY_I64, 0);

    // § 6's conversions. The INTEGER row of each direction comes first: a
    // float slot takes an integer (`tk_prim_slot_fits`), so the row asked
    // about first is the one that decides an `i64` source or target.
    //
    // ...and the `u64` SOURCE comes before the `i64` one (D77, ruling 8). A
    // column naming `TY_I64` takes every integer teko has (`tk_prim_slot_fits`
    // again), `u64` included, and `tk_dec_from_i64` reads `n < 0`: a `u64` at
    // or above 2^63 would convert to a NEGATIVE decimal, in silence. A column
    // naming `TY_U64` takes nothing but `u64` -- no slot rule widens into it --
    // so this one row is asked first, answers for the one type whose magnitude
    // an `i64` cannot hold, and leaves `u8`/`u16`/`u32`/`i8`/`i16`/`i32`/`i64`
    // on the signed road they already took. Both roads read this same table:
    // the explicit cast (`tk_prim_cast_lower`, teko_prim.tk) and the implicit
    // conversion (`tk_num_widen`, teko_typeof.tk, which `tk_ops_promote` calls
    // for a mixed operand).
    tk_prim_cast_op(d, TY_U64, "tk_dec_from_u64");
    tk_prim_cast_op(d, TY_I64, "tk_dec_from_i64");
    tk_prim_cast_op(d, ty_f64, "tk_dec_from_f64");
    tk_prim_cast_op(TY_I64, d, "tk_dec_to_i64");
    tk_prim_cast_op(ty_f64, d, "tk_dec_to_f64");
}
