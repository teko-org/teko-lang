// teko_i128.tk -- `i128` and `u128`: the two registrations, the literal, and
// the rows every operator and every cast reads. N6a of
// docs/specs/small-ints.md (§ 6, § 8, § 11), D81.
//
// It is `teko_wide.tk`'s fourth and fifth client and carries none of its
// machine: the sixteen bytes MOVE because `tk_wide_add` put these two ids in
// the wide set, and the three derived tables never name either type. What is
// here is the same three things `teko_decimal.tk` carries for `decimal` --
// the `type_new`, the literal, and the `tk_prim_op`/`tk_prim_cast_op` rows --
// with the arithmetic itself in `lib/wide.tk` as ordinary teko (D21: zero new
// intrinsics, `mc limits`' `intrin` row unmoved at 8).
//
// **`mc`'s bundled `<i128>` is NOT included, and never will be** (D81, which
// closes D74's "N6 re-decides"). Measured on mc 0.17.2: `<float>` and `<i128>`
// cannot coexist in one compiler. Their opcode ranges collide on both
// instruction sets -- on arm64 `<float>`'s `FI_BASE` is 100 and unbounded
// while `<i128>`'s `WI_BASE` is 200, and on x86_64 `FX_BASE` and `XW_BASE` are
// both 100 -- so a program mixing the two either executes an illegal
// instruction or dies in `--dump-asm` with `no dump for a wide opcode`. It
// adds four intrinsics on top of that, which D21 forbids outright, and its
// `iw_*` machine handlers break 34 of this repository's fixtures. teko
// registers the two types ITSELF, exactly as it registered `decimal`.
//
// `% << >> & | ^ ~` landed too (D83, `tk_i128_rows_bits` below), and so did
// the `f64` and `decimal` conversions, both directions, both types (D84,
// `lib/wide.tk`'s `tk_i128_from_f64`/`tk_i128_to_f64`/`tk_i128_from_dec` and
// `lib/decimal.tk`'s `tk_dec_from_i128`, and their `u128` twins). N6b-3
// (D85) closes the rest: `ToString`, `Parse`, `TryParse`, `CompareTo`,
// `Equals`, `MinValue`, `MaxValue`, `Zero`, `One`, below, and the `read`/
// `build` clauses of `tk_prim_type` (`tk_i128_init`), which flips `(str) x`
// from "does not cast yet" to the long two-clause wording `decimal`'s own
// cast refusal already carries. After this crumb N6b owes nothing more.
// What stays refused, unmoved by this crumb:
//
//   (str) x                     teko_prim.tk   an i128 does not cast; `.ToString()` writes it and `i128.Parse(s)` reads it
//   const i128 K = 1i;          teko_const.tk  const requires a constant expression
//   case 1i:                    teko_switch.tk a case label must be a constant expression
//   i128 g = 5;                 teko_rc.tk     a global i128 takes no initializer
//   extern i128 f();            teko_over.tk   an `extern` takes no i128

// ---- the representation (docs/specs/small-ints.md § 6) ----
// Sixteen bytes, sixteen-byte aligned, little-endian:
//
//   +0  bits   0..63    the low half
//   +8  bits  64..127   the high half, whose bit 63 is an `i128`'s sign
//
// The two types are THE SAME BITS. They differ in `/` and in the four ordering
// comparisons (D81), in `%` (the remainder's sign) and in `>>` (arithmetic
// against logical, D83), and in nothing else -- `lib/wide.tk` writes the core
// once and gives each type a wrapper.
i64 tk_ty_i128 = 0;
i64 tk_ty_u128 = 0;

// ---- the literal: <digits>(i|I|u|U) ----
// `mc`'s own `<i128>` suffix, `i` for the signed and `u` for the unsigned,
// both case-insensitive. C# has no `Int128` literal at all -- it writes
// `Int128.Parse("...")` -- so there is no C# form to follow and the market's
// nearest neighbour is the compiler this one is taught to
// (docs/specs/small-ints.md § 6).
//
// DECIMAL DIGITS ONLY: `0x...` is declined here and reaches whatever reads it
// today, unchanged. A value above 64 bits does not fit `MTASK_CONST`'s single
// `i64` and an `N_INT`'s `val` is one `i64`, so the literal becomes a
// module-private GLOBAL with an `N_BLOB` initializer and the node returned is
// an `N_IDENT` naming it -- `tk_dec_lit`'s own shape (teko_decimal.tk, D74).
//
// **The registration order is load-bearing**, for the same reason `decimal`'s
// is: handlers run in registration order and the first non-zero node wins, so
// this one is registered BEFORE `tk_float_init()` and declines -- `return 0` --
// everything that does not end in `i` or `u`.
u64 tk_wl0 = 0;                       // the value in four 32-bit limbs
u64 tk_wl1 = 0;
u64 tk_wl2 = 0;
u64 tk_wl3 = 0;
i64 tk_wl_ovf = 0;                    // a carry past bit 127
i64 tk_nwidelit = 0;                  // the literal globals, numbered

void tk_wl_reset() { tk_wl0 = 0; tk_wl1 = 0; tk_wl2 = 0; tk_wl3 = 0; tk_wl_ovf = 0; }

i64 tk_wl_isdig(i64 c) { return c >= '0' && c <= '9'; }

// value = value * m + add, over 128 bits. A carry out of the top limb is
// remembered rather than dropped, so a literal past 2^128 is refused instead
// of wrapping.
void tk_wl_muladd(u64 m, u64 add) {
    u64 c = add;
    u64 p = tk_wl0 * m + c;  tk_wl0 = p & 0xffffffff;  c = p >> 32;
    p = tk_wl1 * m + c;      tk_wl1 = p & 0xffffffff;  c = p >> 32;
    p = tk_wl2 * m + c;      tk_wl2 = p & 0xffffffff;  c = p >> 32;
    p = tk_wl3 * m + c;      tk_wl3 = p & 0xffffffff;  c = p >> 32;
    if (c) tk_wl_ovf = 1;
}

uptr tk_wl_skip(uptr q, uptr e) {
    loop {
        if (q >= e || !tk_wl_isdig(ld8(q))) break;
        q = q + 1;
    }
    return q;
}

// the gensym: `$tk_w128_<n>`, in the arena. The `$` is a byte the lexer never
// forms into an identifier, so the name cannot collide with anything a program
// wrote (`tk_dl_name`'s own rule, teko_decimal.tk).
uptr tk_wl_name() {
    u8 nb[24];
    i64 nn = 0;
    i64 v = tk_nwidelit;
    tk_nwidelit = tk_nwidelit + 1;
    loop {
        st8(nb + nn, '0' + v % 10);
        v = v / 10;
        nn = nn + 1;
        if (v == 0) break;
    }
    uptr name = xalloc(11 + nn);
    mem_copy(name, "$tk_w128_", 9);
    i64 k = 0;
    loop {
        if (k >= nn) break;
        st8(name + 9 + k, ld8(nb + nn - 1 - k));
        k = k + 1;
    }
    st8(name + 9 + nn, 0);                    // the terminator, written, never assumed
    return name;
}

// the sixteen bytes, little-endian, byte by byte
uptr tk_wl_blob(u64 lo, u64 hi) {
    uptr b = xalloc(16);
    i64 i = 0;
    loop {
        if (i >= 8) break;
        st8(b + i, (lo >> (i * 8)) & 0xff);
        st8(b + 8 + i, (hi >> (i * 8)) & 0xff);
        i = i + 1;
    }
    return b;
}

i64 tk_w128_lit() {
    uptr s = p_start();
    uptr e = p_src_end();
    if (s >= e || !tk_wl_isdig(ld8(s))) return 0;

    // ---- first pass: find the suffix, and decline everything that is not one
    // Nothing is accumulated and nothing is consumed until the suffix is in
    // hand, so `1`, `0.5`, `1.5m`, `1.5e3` and `0x10` all leave this handler
    // exactly as they reached it and go on to the next one.
    uptr q = tk_wl_skip(s, e);
    if (q >= e) return 0;
    i64 suf = ld8(q);
    if (suf != 'i' && suf != 'I' && suf != 'u' && suf != 'U') return 0;
    if (q + 1 < e && is_alnum(ld8(q + 1))) return 0;
    i64 signed_ = suf == 'i' || suf == 'I';

    // ---- second pass: the digits, most significant first
    i64 line = p_line();
    uptr fl = p_file();
    tk_wl_reset();
    uptr r = s;
    loop {
        if (r >= q) break;
        tk_wl_muladd(10, ld8(r) - '0');
        r = r + 1;
    }

    // An `i128` literal is the MAGNITUDE only -- a leading `-` is the unary
    // operator and is applied to the value this node answers -- so the ceiling
    // is 2^127-1 and `i128.MinValue` is written `-170...727i - 1i` (C# has the
    // same hole and writes `Int128.MinValue`, which is N6b).
    if (signed_) {
        if (tk_wl_ovf || ((tk_wl3 >> 31) & 1))
            err_at(fl, line, "teko: an i128 literal is out of range");
    } else {
        if (tk_wl_ovf) err_at(fl, line, "teko: a u128 literal is out of range");
    }

    q = q + 1;
    p_take_lit(q);

    i64 ty = tk_ty_u128;
    if (signed_) ty = tk_ty_i128;
    uptr name = tk_wl_name();
    i64 blob = node_new(N_BLOB, line, fl);
    set_nd_name(blob, tk_wl_blob(tk_wl0 | (tk_wl1 << 32), tk_wl2 | (tk_wl3 << 32)));
    set_nd_val(blob, 16);
    i64 g = node_new(N_GLOBAL, line, fl);
    set_nd_type(g, ty);
    set_nd_name(g, name);
    set_nd_val(g, 0);
    set_nd_a(g, blob);
    tk_top_emit(g);
    i64 id = node_new(N_IDENT, line, fl);     // the expression IS the global
    set_nd_name(id, name);
    set_nd_type(id, ty);
    p_next();
    return id;
}

// ---- the members and statics (docs/specs/small-ints.md § 7; D85, N6b-3) ----
// The same mechanism `decimal`'s own `tk_dec_statics`/`tk_dec_members`
// registers over (`teko_decimal.tk`), reused without a line changed in
// `teko_prim.tk`: every row names an ordinary function of `lib/wide.tk`.
//
// `CompareTo` and `Equals` name `tk_i128_cmp`/`tk_i128_eq`, already in file
// since N6a -- the two comparisons the eleven-row operator table (below)
// already lowers `==`/`<`/... to, reached here a second way and needing no
// second function (D85, ruling 6: `Equals` takes an `i128`, never an
// `object` -- teko has no boxed root type for a member table to reach one
// through).
void tk_i128_statics() {
    i64 t = tk_ty_i128;
    tk_prim_member(t, "MinValue", TK_PMSVAL, 0 - 1, "tk_i128_min",  t);
    tk_prim_member(t, "MaxValue", TK_PMSVAL, 0 - 1, "tk_i128_max",  t);
    tk_prim_member(t, "Zero",     TK_PMSVAL, 0 - 1, "tk_i128_zero", t);
    tk_prim_member(t, "One",      TK_PMSVAL, 0 - 1, "tk_i128_one",  t);
    tk_prim_member(t, "Parse",    TK_PMSFUN, TY_UPTR, "tk_i128_parse", t);
    // The row below never emits (`out <name>` is no column this table has,
    // exactly `decimal`'s own note): it is registered so `x.TryParse(...)` on
    // an INSTANCE answers `` teko: i128.TryParse is static; reach it through
    // its type `` instead of reading as a member nobody ever heard of.
    tk_prim_membern(t, "TryParse", TK_PMSFUN, 2, TY_UPTR, "tk_i128_tryparse", TY_I64);
}

void tk_i128_members() {
    i64 t = tk_ty_i128;
    tk_prim_member(t, "ToString",  TK_PMFUN, 0 - 1, "tk_i128_tostring", TY_UPTR);
    tk_prim_member(t, "CompareTo", TK_PMFUN, t, "tk_i128_cmp", TY_I64);
    tk_prim_member(t, "Equals",    TK_PMFUN, t, "tk_i128_eq",  TY_I64);
}

void tk_u128_statics() {
    i64 t = tk_ty_u128;
    tk_prim_member(t, "MinValue", TK_PMSVAL, 0 - 1, "tk_u128_min",  t);
    tk_prim_member(t, "MaxValue", TK_PMSVAL, 0 - 1, "tk_u128_max",  t);
    tk_prim_member(t, "Zero",     TK_PMSVAL, 0 - 1, "tk_u128_zero", t);
    tk_prim_member(t, "One",      TK_PMSVAL, 0 - 1, "tk_u128_one",  t);
    tk_prim_member(t, "Parse",    TK_PMSFUN, TY_UPTR, "tk_u128_parse", t);
    tk_prim_membern(t, "TryParse", TK_PMSFUN, 2, TY_UPTR, "tk_u128_tryparse", TY_I64);
}

void tk_u128_members() {
    i64 t = tk_ty_u128;
    tk_prim_member(t, "ToString",  TK_PMFUN, 0 - 1, "tk_u128_tostring", TY_UPTR);
    tk_prim_member(t, "CompareTo", TK_PMFUN, t, "tk_u128_cmp", TY_I64);
    tk_prim_member(t, "Equals",    TK_PMFUN, t, "tk_u128_eq",  TY_I64);
}

// ---- `i128.TryParse(s, out v)` / `u128.TryParse(s, out v)`, parsed by hand
// ---- `tk_dec_tryparse_expr`'s own shape (`teko_decimal.tk`), for the same
// reason: `out v` is read through `tk_ref_addr` (teko_ref.tk) rather than
// through `parse_expr`'s registered `out` handler, and the argument is
// TAGGED after the fact so teko_ref.tk's own pass judges what parse time
// could not.
i64 tk_i128_tryparse_expr(i64 line, uptr fl) {
    tk_prim_need_include(tk_ty_i128, "tk_i128_tryparse", line, fl);
    p_expect(K_LPAR, "expected ( after TryParse");
    i64 se = parse_expr(0);
    p_expect(K_COMMA, "expected , after the string");
    if (type_of_token(p_id()) != tk_ty_out)
        err_at(fl, line, "teko: TryParse's second argument is `out <name>`");
    p_next();
    i64 pty = 0 - 1;
    i64 oe = tk_ref_addr(line, fl, &pty);
    p_expect(K_RPAR, "expected ) after TryParse");
    if (pty >= 0 && pty != tk_ty_i128)
        tk_reject_compat(tk_pointee_name(pty), "i128", line, fl);
    tk_rfarg_tag(oe, TK_RP_OUT, pty);
    tk_line = line;
    tk_file = fl;
    return tk_call2("tk_i128_tryparse", se, oe);
}

i64 tk_u128_tryparse_expr(i64 line, uptr fl) {
    tk_prim_need_include(tk_ty_u128, "tk_u128_tryparse", line, fl);
    p_expect(K_LPAR, "expected ( after TryParse");
    i64 se = parse_expr(0);
    p_expect(K_COMMA, "expected , after the string");
    if (type_of_token(p_id()) != tk_ty_out)
        err_at(fl, line, "teko: TryParse's second argument is `out <name>`");
    p_next();
    i64 pty = 0 - 1;
    i64 oe = tk_ref_addr(line, fl, &pty);
    p_expect(K_RPAR, "expected ) after TryParse");
    if (pty >= 0 && pty != tk_ty_u128)
        tk_reject_compat(tk_pointee_name(pty), "u128", line, fl);
    tk_rfarg_tag(oe, TK_RP_OUT, pty);
    tk_line = line;
    tk_file = fl;
    return tk_call2("tk_u128_tryparse", se, oe);
}

// the type word in EXPRESSION position: this file's own handler rather than
// teko_prim.tk's `tk_prim_expr`, for the one static each intercepts --
// `tk_dec_expr`'s own shape (`teko_decimal.tk`). Every other member goes
// straight to the table, with the member name already read
// (`tk_prim_static_m`), so nothing is duplicated here.
i64 tk_i128_expr() {
    i64 line = p_line();
    uptr fl = p_file();
    p_next();                                    // the type word
    if (!p_accept(tk_dot_tok))
        err_at2(fl, line, "teko: a type name reaches its static members", "i128");
    uptr m = tk_member_name();                    // D68
    if (str_eq(m, "TryParse")) return tk_i128_tryparse_expr(line, fl);
    return tk_prim_static_m(tk_ty_i128, m, line, fl);
}

i64 tk_u128_expr() {
    i64 line = p_line();
    uptr fl = p_file();
    p_next();                                    // the type word
    if (!p_accept(tk_dot_tok))
        err_at2(fl, line, "teko: a type name reaches its static members", "u128");
    uptr m = tk_member_name();                    // D68
    if (str_eq(m, "TryParse")) return tk_u128_tryparse_expr(line, fl);
    return tk_prim_static_m(tk_ty_u128, m, line, fl);
}

// ---- registration ----
// Called from `teko_init()` BEFORE `tk_float_init()`, for the literal's sake,
// beside `tk_dec_init()`; the MACHINE is registered separately and after both
// (`tk_wide_init`, teko_wide.tk).
//
// `type_new(name, 16, 16, TK_WIDE)` is the whole of the representation: the
// sixteen-byte frame slot, the sixteen-byte global and the sixteen-byte array
// element all come from `type_width`. Each type gets its OWN return buffer
// (D75's fourth column of the wide set), so a program that returns a `u128`
// and never mentions `i128` still has exactly the buffer it needs -- both live
// in `lib/wide.tk`, which is one include for the pair.
//
// The reader and builder clauses are FILLED now (D85, `decimal`'s own filled
// form, `teko_decimal.tk`): `(str) x` therefore reads the long two-clause
// wording, `` teko: an i128 does not cast; `.ToString()` writes it and
// `i128.Parse(s)` reads it `` -- `(str) x` still does not COMPILE (no cast
// row names `str`, § 9's own two-door rule: a member for the text, a cast for
// nothing), only the refusal's own wording moves, exactly as `decimal`'s did
// between C3 and C5.
void tk_i128_init() {
    tk_ty_i128 = type_new("i128", 16, 16, TK_WIDE);
    tk_ty_u128 = type_new("u128", 16, 16, TK_WIDE);
    tk_wide_add(tk_ty_i128, "tk_i128_ld", "tk_i128_st", "tk_i128_retbuf");
    tk_wide_add(tk_ty_u128, "tk_u128_ld", "tk_u128_st", "tk_u128_retbuf");
    tk_prim_type(tk_ty_i128, "i128", "wide.tk",
                 "`.ToString()` writes it", "`i128.Parse(s)` reads it", "0i");
    tk_prim_type(tk_ty_u128, "u128", "wide.tk",
                 "`.ToString()` writes it", "`u128.Parse(s)` reads it", "0u");
    syntax_lit(&tk_w128_lit);
    // the type word in EXPRESSION and STATEMENT position -- this file's own
    // `tk_i128_expr`/`tk_u128_expr` now, for the `TryParse` interception
    // above; every other static goes through the table.
    syntax_expr("i128", &tk_i128_expr);
    syntax_stmt("i128", &tk_prim_stmt);
    syntax_expr("u128", &tk_u128_expr);
    syntax_stmt("u128", &tk_prim_stmt);
    tk_i128_statics();
    tk_i128_members();
    tk_u128_statics();
    tk_u128_members();
}

// ---- the operators and the conversions (§ 6, § 8) ----
// Eleven rows per type and no mixed row of any kind. An integer beside an
// `i128` is CONVERTED before the operator pass looks for a row
// (`tk_ops_promote`, teko_ops.tk), which is C# §12.4.5's binary numeric
// promotion and the reason `x + 1`, `1 + x`, `x += 1` and `x++` are all
// covered by the rows below.
//
// `i128 op u128` gets NO row either, and is refused by name: C# refuses the
// same expression without a cast, `tk_is_int_ty` answers 0 for a wide id, so
// the promotion never opens a door between them, and the site earns
// `teko: no operator `+` takes these operands`.
//
// Unary `+` has no row: `tk_prim_unary_plus` (teko_prim.tk) reads the
// `T + T` row to know this is a number and hands the operand straight back.
void tk_i128_rows(i64 t, uptr add, uptr sub, uptr mul, uptr div, uptr neg,
                  uptr eq, uptr ne, uptr lt, uptr le, uptr gt, uptr ge) {
    tk_prim_op(K_ADD, 2, t, t, add, t, 0);
    tk_prim_op(K_SUB, 2, t, t, sub, t, 0);
    tk_prim_op(K_MUL, 2, t, t, mul, t, 0);
    tk_prim_op(K_DIV, 2, t, t, div, t, 0);
    tk_prim_op(K_SUB, 1, t, 0 - 1, neg, t, 0);
    tk_prim_op(K_EQ, 2, t, t, eq, TY_I64, 0);
    tk_prim_op(K_NE, 2, t, t, ne, TY_I64, 0);
    tk_prim_op(K_LT, 2, t, t, lt, TY_I64, 0);
    tk_prim_op(K_LE, 2, t, t, le, TY_I64, 0);
    tk_prim_op(K_GT, 2, t, t, gt, TY_I64, 0);
    tk_prim_op(K_GE, 2, t, t, ge, TY_I64, 0);
}

// N6b's seven rows (D83), a second function because `mc` caps a call at
// twelve parameters and eighteen names plus `t` does not fit one. `x << 2` is
// covered the same way `x + 1` is: `tk_ops_promote`'s wide arm widens `2` to
// the wide type FIRST, so the SHIFT COUNT lands on this table as the same
// wide type as `x`, never `i64` -- and the wrapper (`lib/wide.tk`) reads that
// 128-bit count's own low 7 bits, the mask D83 gives every shift.
void tk_i128_rows_bits(i64 t, uptr mod, uptr shl, uptr shr, uptr band,
                       uptr bor, uptr bxor, uptr bnot) {
    tk_prim_op(K_MOD, 2, t, t, mod, t, 0);
    tk_prim_op(K_SHL, 2, t, t, shl, t, 0);
    tk_prim_op(K_SHR, 2, t, t, shr, t, 0);
    tk_prim_op(K_AND, 2, t, t, band, t, 0);
    tk_prim_op(K_OR,  2, t, t, bor, t, 0);
    tk_prim_op(K_XOR, 2, t, t, bxor, t, 0);
    tk_prim_op(K_TILDE, 1, t, 0 - 1, bnot, t, 0);
}

void tk_i128_ops() {
    tk_i128_rows(tk_ty_i128, "tk_i128_add", "tk_i128_sub", "tk_i128_mul",
                 "tk_i128_div", "tk_i128_neg", "tk_i128_eq", "tk_i128_ne",
                 "tk_i128_lt", "tk_i128_le", "tk_i128_gt", "tk_i128_ge");
    tk_i128_rows(tk_ty_u128, "tk_u128_add", "tk_u128_sub", "tk_u128_mul",
                 "tk_u128_div", "tk_u128_neg", "tk_u128_eq", "tk_u128_ne",
                 "tk_u128_lt", "tk_u128_le", "tk_u128_gt", "tk_u128_ge");
    tk_i128_rows_bits(tk_ty_i128, "tk_i128_mod", "tk_i128_shl", "tk_i128_shr",
                      "tk_i128_and", "tk_i128_or", "tk_i128_xor", "tk_i128_not");
    tk_i128_rows_bits(tk_ty_u128, "tk_u128_mod", "tk_u128_shl", "tk_u128_shr",
                      "tk_u128_and", "tk_u128_or", "tk_u128_xor", "tk_u128_not");

    // § 8's conversions. The `u64` SOURCE row comes FIRST on each target, for
    // D77's ruling 8: a column naming `TY_I64` takes every integer teko has
    // (`tk_prim_slot_fits`), `u64` included, and a `u64` at or above 2^63
    // through a SIGN-EXTENDING door is a negative 128-bit value -- in silence.
    // A column naming `TY_U64` takes nothing but `u64`, so this one row is
    // asked first and leaves the other seven integer types where they were.
    tk_prim_cast_op(tk_ty_i128, TY_U64, "tk_i128_from_u64");
    tk_prim_cast_op(tk_ty_i128, TY_I64, "tk_i128_from_i64");
    tk_prim_cast_op(tk_ty_u128, TY_U64, "tk_u128_from_u64");
    tk_prim_cast_op(tk_ty_u128, TY_I64, "tk_u128_from_i64");
    // ...and the two wide-to-wide rows, which move no bit at all. Neither
    // opens an IMPLICIT door: `tk_num_wide_widens` (teko_typeof.tk) asks
    // `tk_is_int_ty` of the source, which answers 0 for every `type_new` id
    // this project did not list by name (D38), so `i128 x = u;` is refused
    // and `(i128) u` is the one spelling that converts -- C#'s own rule.
    tk_prim_cast_op(tk_ty_i128, tk_ty_u128, "tk_i128_from_u128");
    tk_prim_cast_op(tk_ty_u128, tk_ty_i128, "tk_u128_from_i128");
    // ...and back to 64 bits, truncating. `(u64) x`, `(i32) x` and every
    // narrower target ride these two as well: the call answers an `i64` and
    // the cast the source wrote is the ordinary narrowing over it
    // (`tk_prim_cast_lower`'s second branch).
    tk_prim_cast_op(TY_I64, tk_ty_i128, "tk_i128_to_i64");
    tk_prim_cast_op(TY_I64, tk_ty_u128, "tk_u128_to_i64");

    // N6b-2's eight rows (D84): the `f64` and `decimal` directions, both ways,
    // both types. Every column here names an EXACT primitive -- `ty_f64` and
    // `tk_ty_decimal` are as `tk_prim_is` as `i128`/`u128` are -- so
    // `tk_prim_slot_fits`'s `pt == t` line matches or nothing does and the
    // registration order carries no meaning the way the `u64`-before-`i64`
    // rows above did; it is kept in one shape anyway, source first and target
    // after, the same rhythm the eight rows above already read in.
    //
    // `tk_prim_need_include` reads the CAST's target (`pty = tty`,
    // `tk_prim_cast_lower`): `(f64) x` and `(i128) 1.5` name neither
    // `tk_prim_is` on the `f64` side, so the include asked for is the WIDE
    // side's own -- `tk_i128_to_f64`/`tk_i128_from_f64` therefore live in
    // `lib/wide.tk`, beside `tk_u128_to_f64`/`tk_u128_from_f64`. `(decimal) x`
    // and `(i128) d` both name a `tk_prim_is` type on the target, so each
    // symbol lives in the file ITS OWN target owns: `tk_dec_from_i128`/
    // `tk_dec_from_u128` in `lib/decimal.tk`, `tk_i128_from_dec`/
    // `tk_u128_from_dec` in `lib/wide.tk` -- neither file includes the other
    // (D81's own ruling), and each reads the other type's sixteen bytes raw.
    tk_prim_cast_op(tk_ty_i128, ty_f64, "tk_i128_from_f64");
    tk_prim_cast_op(tk_ty_u128, ty_f64, "tk_u128_from_f64");
    tk_prim_cast_op(ty_f64, tk_ty_i128, "tk_i128_to_f64");
    tk_prim_cast_op(ty_f64, tk_ty_u128, "tk_u128_to_f64");
    tk_prim_cast_op(tk_ty_i128, tk_ty_decimal, "tk_i128_from_dec");
    tk_prim_cast_op(tk_ty_u128, tk_ty_decimal, "tk_u128_from_dec");
    tk_prim_cast_op(tk_ty_decimal, tk_ty_i128, "tk_dec_from_i128");
    tk_prim_cast_op(tk_ty_decimal, tk_ty_u128, "tk_dec_from_u128");
}
