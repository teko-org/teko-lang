pub extern fn read_file(path: str): str | error = "tk_rt_read_file" from "teko_rt"

pub extern fn write_file(path: str, content: str): error | null = "tk_rt_write_file" from "teko_rt"

pub extern fn args(): []str = "tk_rt_args" from "teko_rt"

pub extern fn println(s: str) = "tk_println" from "teko_rt"

pub extern fn eprintln(s: str) = "tk_eprintln" from "teko_rt"
