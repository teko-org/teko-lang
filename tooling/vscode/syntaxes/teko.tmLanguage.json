{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Teko",
  "scopeName": "source.tks",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#literals" },
    { "include": "#keywords" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "include": "#doc-comment" },
        { "include": "#block-comment" },
        { "name": "comment.line.double-slash.teko", "match": "\\/\\/.*$" }
      ]
    },
    "doc-comment": {
      "name": "comment.block.documentation.teko",
      "begin": "\\/\\*\\*",
      "end": "\\*\\/",
      "patterns": [
        {
          "name": "storage.type.class.jsdoc",
          "match": "@(param|return|returns|throws|type|typedef|property|prop|field|since|deprecated|see|author|version|example|note|remarks|summary|value|default|readonly|override|abstract|virtual|intern|extern|pub|exp)\\b"
        },
        {
          "name": "variable.other.jsdoc",
          "match": "(?<=@param\\s{1,4})\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "comment.block.documentation.teko",
          "match": "^\\s*\\*(?!/)"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.teko",
      "begin": "\\/\\*",
      "end": "\\*\\/"
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.triple.teko", "match": "\"\"\"[\\s\\S]*?\"\"\"" },
        { "name": "string.interpolated.teko", "match": "\\$\"(\\\\.|[^\\\\\"])*\"" },
        { "name": "string.quoted.verbatim.teko", "match": "@\"([^\"]|\"\")*\"" },
        { "name": "string.quoted.double.teko", "match": "\"(\\\\.|[^\\\\\"])*\"" }
      ]
    },
    "literals": {
      "patterns": [
        { "name": "constant.character.teko", "match": "\\b(b|c)'(\\\\.|[^\\\\'])*'" },
        { "name": "constant.numeric.teko", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.teko", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.teko", "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9][0-9_]*)?\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.teko", "match": "\\b(ptr|uptr|size|usize|i8|u8|i16|u16|i32|u32|i64|u64|f32|f64|bool|str|char|byte|interface|abstract|continue|override|variant|virtual|extern|intern|return|struct|break|class|static|self|base|spawn|await|func|action|const|defer|false|flags|match|else|enum|loop|null|true|type|when|exp|var|pub|use|as|fn|if|in|to)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.teko", "match": "<<=|>>=|\\.\\.=|==|=>|!=|<=|>=|<<|>>|::|&&|\\|\\||\\+\\+|--|\\+=|-=|\\*=|\\/=|%=|&=|\\|=|\\^=|\\?\\?|\\?\\.|\\.\\.|\\+|-|\\*|\\/|%|&|\\||\\^|~|!|<|>|=|:|;|,|\\.|\\(|\\)|\\{|\\}|\\[|\\]|\\?|#" }
      ]
    }
  }
}
