{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gherkin",
  "scopeName": "source.gherkin",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.gherkin",
          "match": "\\s*#.*$"
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "name": "entity.name.tag.gherkin",
          "match": "(^|\\s)@[A-Za-z0-9_-]+"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gherkin",
          "match": "^\\s*(Feature|Background|Scenario|Scenario Outline|Examples|Rule|Given|When|Then|And|But)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gherkin",
          "match": "\"(\\\\.|[^\\\\\"])*\""
        },
        {
          "name": "string.quoted.single.gherkin",
          "match": "'(\\\\.|[^\\\\'])*'"
        }
      ]
    }
  }
}
