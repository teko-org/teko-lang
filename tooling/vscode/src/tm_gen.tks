fn regex_escape(s: str): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= s.len { break }
        var c = s[i]
        var needs_escape = c == b'.' || c == b'*' || c == b'+' || c == b'?' || c == b'(' || c == b')' || c == b'[' || c == b']' || c == b'{' || c == b'}' || c == b'^' || c == b'$' || c == b'|' || c == b'\\' || c == b'/'
        if needs_escape { out = out ~ "\\" }
        out = out ~ one_char(c)
        i++
    }
    out
}

fn keyword_alternation(keywords: []SpecKeyword): str {
    var sorted = sort_by_length_desc_kw(keywords)
    var out = ""
    var i: u64 = 0
    loop {
        if i >= sorted.len { break }
        if i > 0 { out = out ~ "|" }
        out = out ~ regex_escape(sorted[i].text)
        i++
    }
    out
}

fn sort_by_length_desc_kw(items: []SpecKeyword): []SpecKeyword {
    var out: []SpecKeyword = []
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        out = insert_by_length_desc_kw(out, items[i])
        i++
    }
    out
}

fn insert_by_length_desc_kw(sorted: []SpecKeyword, item: SpecKeyword): []SpecKeyword {
    var out: []SpecKeyword = []
    var inserted = false
    var i: u64 = 0
    loop {
        if i >= sorted.len { break }
        if !inserted && item.text.len > sorted[i].text.len {
            out = [..out, item]
            inserted = true
        }
        out = [..out, sorted[i]]
        i++
    }
    if !inserted { out = [..out, item] }
    out
}

fn operator_alternation(operators: []SpecOperator): str {
    var sorted = sort_by_length_desc_op(operators)
    var out = ""
    var i: u64 = 0
    loop {
        if i >= sorted.len { break }
        if i > 0 { out = out ~ "|" }
        out = out ~ regex_escape(sorted[i].text)
        i++
    }
    out
}

fn sort_by_length_desc_op(items: []SpecOperator): []SpecOperator {
    var out: []SpecOperator = []
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        out = insert_by_length_desc_op(out, items[i])
        i++
    }
    out
}

fn insert_by_length_desc_op(sorted: []SpecOperator, item: SpecOperator): []SpecOperator {
    var out: []SpecOperator = []
    var inserted = false
    var i: u64 = 0
    loop {
        if i >= sorted.len { break }
        if !inserted && item.text.len > sorted[i].text.len {
            out = [..out, item]
            inserted = true
        }
        out = [..out, sorted[i]]
        i++
    }
    if !inserted { out = [..out, item] }
    out
}

fn json_string(s: str): str {
    var out = "\""
    var i: u64 = 0
    loop {
        if i >= s.len { break }
        var b = s[i]
        if b == b'"' { out = out ~ "\\\""; i++; continue }
        if b == b'\\' { out = out ~ "\\\\"; i++; continue }
        out = out ~ one_char(b)
        i++
    }
    out ~ "\""
}

pub fn render_tm_grammar(spec: Spec): str {
    var kw_pattern = "\\b(" ~ keyword_alternation(spec.keywords) ~ ")\\b"
    var op_pattern = operator_alternation(spec.operators)
    var line_comment_pattern = regex_escape(spec.line_comment) ~ ".*$"
    var doc_comment_pattern = regex_escape(spec.doc_comment_open) ~ "[\\s\\S]*?\\*/"
    var block_comment_pattern = regex_escape(spec.block_comment_open) ~ "[\\s\\S]*?\\*/"
    var multiline_string_pattern = regex_escape(spec.string_multiline_delimiter) ~ "[\\s\\S]*?" ~ regex_escape(spec.string_multiline_delimiter)
    var interp_string_pattern = regex_escape(spec.string_interp_prefix) ~ regex_escape(spec.string_delimiter) ~ "(\\\\.|[^\\\\\"])*" ~ regex_escape(spec.string_delimiter)
    var verbatim_string_pattern = regex_escape(spec.string_verbatim_prefix) ~ regex_escape(spec.string_delimiter) ~ "([^\"]|\"\")*" ~ regex_escape(spec.string_delimiter)
    var string_pattern = regex_escape(spec.string_delimiter) ~ "(\\\\.|[^\\\\\"])*" ~ regex_escape(spec.string_delimiter)
    var byte_char_pattern = "\\b(" ~ regex_escape(spec.byte_literal_prefix) ~ "|" ~ regex_escape(spec.char_literal_prefix) ~ ")" ~ regex_escape(spec.byte_literal_delimiter) ~ "(\\\\.|[^\\\\'])*" ~ regex_escape(spec.byte_literal_delimiter)

    var out = "{\n"
    out = out ~ "  \"$schema\": \"https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json\",\n"
    out = out ~ "  \"name\": \"Teko\",\n"
    out = out ~ "  \"scopeName\": \"source.tks\",\n"
    out = out ~ "  \"patterns\": [\n"
    out = out ~ "    { \"include\": \"#comments\" },\n"
    out = out ~ "    { \"include\": \"#strings\" },\n"
    out = out ~ "    { \"include\": \"#literals\" },\n"
    out = out ~ "    { \"include\": \"#keywords\" },\n"
    out = out ~ "    { \"include\": \"#operators\" }\n"
    out = out ~ "  ],\n"
    out = out ~ "  \"repository\": {\n"
    out = out ~ "    \"comments\": {\n"
    out = out ~ "      \"patterns\": [\n"
    out = out ~ "        { \"include\": \"#doc-comment\" },\n"
    out = out ~ "        { \"include\": \"#block-comment\" },\n"
    out = out ~ "        { \"name\": \"comment.line.double-slash.teko\", \"match\": " ~ json_string(line_comment_pattern) ~ " }\n"
    out = out ~ "      ]\n"
    out = out ~ "    },\n"
    out = out ~ "    \"doc-comment\": {\n"
    out = out ~ "      \"name\": \"comment.block.documentation.teko\",\n"
    out = out ~ "      \"begin\": " ~ json_string(regex_escape(spec.doc_comment_open)) ~ ",\n"
    out = out ~ "      \"end\": " ~ json_string(regex_escape(spec.block_comment_close)) ~ ",\n"
    out = out ~ "      \"patterns\": [\n"
    out = out ~ "        { \"name\": \"storage.type.class.jsdoc\", \"match\": \"@(param|return|returns|throws|type|typedef|property|prop|field|since|deprecated|see|author|version|example|note|remarks|summary|value|default|readonly|override|abstract|virtual|intern|extern|pub|exp)\\\\b\" },\n"
    out = out ~ "        { \"name\": \"comment.block.documentation.teko\", \"match\": \"^\\\\s*\\\\*(?!/)\" }\n"
    out = out ~ "      ]\n"
    out = out ~ "    },\n"
    out = out ~ "    \"block-comment\": {\n"
    out = out ~ "      \"name\": \"comment.block.teko\",\n"
    out = out ~ "      \"begin\": " ~ json_string(regex_escape(spec.block_comment_open)) ~ ",\n"
    out = out ~ "      \"end\": " ~ json_string(regex_escape(spec.block_comment_close)) ~ "\n"
    out = out ~ "    },\n"
    out = out ~ "    \"strings\": {\n"
    out = out ~ "      \"patterns\": [\n"
    out = out ~ "        { \"name\": \"string.quoted.triple.teko\", \"match\": " ~ json_string(multiline_string_pattern) ~ " },\n"
    out = out ~ "        { \"name\": \"string.interpolated.teko\", \"match\": " ~ json_string(interp_string_pattern) ~ " },\n"
    out = out ~ "        { \"name\": \"string.quoted.verbatim.teko\", \"match\": " ~ json_string(verbatim_string_pattern) ~ " },\n"
    out = out ~ "        { \"name\": \"string.quoted.double.teko\", \"match\": " ~ json_string(string_pattern) ~ " }\n"
    out = out ~ "      ]\n"
    out = out ~ "    },\n"
    out = out ~ "    \"literals\": {\n"
    out = out ~ "      \"patterns\": [\n"
    out = out ~ "        { \"name\": \"constant.character.teko\", \"match\": " ~ json_string(byte_char_pattern) ~ " },\n"
    out = out ~ "        { \"name\": \"constant.numeric.teko\", \"match\": " ~ json_string(spec.number_binary_pattern) ~ " },\n"
    out = out ~ "        { \"name\": \"constant.numeric.teko\", \"match\": " ~ json_string(spec.number_hex_pattern) ~ " },\n"
    out = out ~ "        { \"name\": \"constant.numeric.teko\", \"match\": " ~ json_string(spec.number_decimal_pattern) ~ " }\n"
    out = out ~ "      ]\n"
    out = out ~ "    },\n"
    out = out ~ "    \"keywords\": {\n"
    out = out ~ "      \"patterns\": [\n"
    out = out ~ "        { \"name\": \"keyword.control.teko\", \"match\": " ~ json_string(kw_pattern) ~ " }\n"
    out = out ~ "      ]\n"
    out = out ~ "    },\n"
    out = out ~ "    \"operators\": {\n"
    out = out ~ "      \"patterns\": [\n"
    out = out ~ "        { \"name\": \"keyword.operator.teko\", \"match\": " ~ json_string(op_pattern) ~ " }\n"
    out = out ~ "      ]\n"
    out = out ~ "    }\n"
    out = out ~ "  }\n"
    out ~ "}\n"
}
