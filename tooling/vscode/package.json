{
  "name": "teko",
  "displayName": "Teko",
  "description": "Syntax highlighting and file associations for Teko tooling files.",
  "version": "0.3.3",
  "publisher": "schivei",
  "repository": {
    "type": "git",
    "url": "https://github.com/teko-org/teko-lang.git"
  },
  "bugs": {
    "url": "https://github.com/teko-org/teko-lang/issues"
  },
  "homepage": "https://github.com/teko-org/teko-lang",
  "license": "MIT",
  "files": [
    "package.json",
    "language-configuration.json",
    "language-configuration.gherkin.json",
    "syntaxes/**",
    "images/**",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "teko",
    "tks",
    "tkt",
    "tkp",
    "tkr"
  ],
  "contributes": {
    "languages": [
      {
        "id": "teko",
        "aliases": [
          "Teko",
          "teko"
        ],
        "extensions": [
          ".tks",
          ".tkt"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/mascot.svg",
          "dark": "./images/mascot.svg"
        }
      },
      {
        "id": "toml",
        "extensions": [
          ".tkp"
        ],
        "icon": {
          "light": "./images/mascot.svg",
          "dark": "./images/mascot.svg"
        }
      },
      {
        "id": "gherkin",
        "aliases": [
          "Gherkin",
          "gherkin"
        ],
        "extensions": [
          ".tkr"
        ],
        "configuration": "./language-configuration.gherkin.json",
        "icon": {
          "light": "./images/mascot.svg",
          "dark": "./images/mascot.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "teko",
        "scopeName": "source.tks",
        "path": "./syntaxes/teko.tmLanguage.json"
      },
      {
        "language": "gherkin",
        "scopeName": "source.gherkin",
        "path": "./syntaxes/gherkin.tmLanguage.json"
      }
    ]
  }
}
