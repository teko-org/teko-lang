global fn os(x: i32): i32 { x * 2 }

global fn exit(): i32 { 99 }

pub fn run(): i32 {
    teko::print("")
    print("")
    var ok = (os() == teko::os()) && (arch() == teko::arch())
    var t = exit() + os(20)
    if !ok { t = t - 1000 }
    if t < 0 { teko::panic("unreachable") }
    if t < 0 { panic("unreachable") }
    t
}
