# examples/regressions/teko_escape_hatch — the D180 escape-hatch: `teko::X` and bare `X` are BOTH
# valid ways to reach a teko `exp global` fn, and `teko::X` FORCES the teko fn past a user shadow.
#
# The witness is the sum only the correct resolution produces:
#   * exit() bare — ns b's own `global fn exit()`, the user shadow, NOT teko's diverging exit .. 99
#   * os(20) bare — ns b's own `global fn os(i32)`, arity-selected over teko's `os()` .......... 40
# Sum = 139, printed, then the program ends via `teko::exit(0)` (the escape-hatch reaching teko's
# real `exit`). `os()`/`teko::os()`/`arch()`/`teko::arch()` (bare + escape-hatch) and both panic
# forms are exercised for resolution; a relapse in any path fails to compile or moves the total.
name = "teko_escape_hatch"
source = "src"

[artifact]
kind = "binary"
