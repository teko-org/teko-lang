# examples/regressions/global_access — the §15 `global` ACCEPT host: a namespace-level fn/type/const
# reachable WITHOUT its qualifier, the qualified path still valid (additive), a cross-namespace global
# overload set, and the `exp global comptime` composition (§14 sugar).
#
# The witness is the sum only the correct resolution produces:
#   * ping() bare (ns a's `global fn`, called from ns b) .......... 7
#   * a::ping() qualified (still valid, additive) ................. 7
#   * (Tag { n = 5 }).n — ns a's `global type` built bare in ns b .. 5
#   * f(10) — the arity-1 global `f` from ns a, selected bare ..... 10
#   * f(1, 2) — the arity-2 global `f` from ns b (distinct sig) .... 3
#   * g() — an `exp global fn`, the exp+global composition ......... 3
#   * a::cz_probe() — an `exp global comptime` folded to 4 ......... 4
# Sum = 7 + 7 + 5 + 10 + 3 + 3 + 4 = 39. A relapse in any path moves the total off 39.
name = "global_access"
source = "src"

[artifact]
kind = "binary"
