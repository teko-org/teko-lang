# manifest.tkp — the MANIFEST-STAGE compile-fail fixture (NEGATIVE FIXTURE — the PROJECT build is
# asserted to FAIL, and the defect it pins is IN THIS FILE, not under src/). The positive
# `seed_literal_arm` member rides as a `Given source` case (`cases/seed_literal_arm.tks`), which
# synthesizes its OWN manifest and is IMMUNE to this broken `.tkp` — so a manifest that must fail and a
# program that must build coexist in one channel.
#
# `kind = "binari"` is a typo. It used to be accepted: the manifest reader's `[artifact] kind` chain
# ended in an `else { artifact = Artifact::Binary }`, so ANY unrecognized spelling silently became an
# executable — this project built green, and so would `kind = "tool"`, a kind nobody implemented. That
# is a hidden error that never fires, which the trunk bar forbids; it is now a hard manifest error
# naming the offending spelling and enumerating the accepted set.
#
# WHY IT IS A CHANNEL OF ITS OWN and not a namespace of `diagnostics`/`parse_diagnostics`: the failure
# happens while READING THE `.tkp`, before a single `.tks` byte is lexed. A checker-stage or
# parse-stage fold host reaches its stage only because its own manifest parsed; a manifest that does
# not parse cannot host any of their diagnostics, and they cannot host this one.
name = "manifest"
source = "src"

[artifact]
kind = "binari"
