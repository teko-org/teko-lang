# examples/regressions/s17_arch — the §17 `#arch("…")` single-item attribute-guard host. Two
# `pub fn pick` definitions, each guarded by a different `#arch`, are pruned by the build-time target
# arch so exactly one survives (no duplicate). On an x86_64 target the `#arch("x86_64")` definition
# survives and `pick` returns 64.
name = "s17_arch"
source = "src"

[artifact]
kind = "binary"
