type Adder = trait {
    fn k(x: i32): i64 { (x to i64) + 10 }
}

type Host = struct Adder {
    tag: i64
    fn k(x: str): i64 { (x.len to i64) + 20 }
}

type AddLeft = trait {
    operator __add(left: self, right: i32): self { left }
}

type AddRight = trait {
    operator __add(left: self, right: self): self { right }
}

type Box = struct AddLeft & AddRight {
    v: i64
}

pub fn method_overload_compose(): i64 {
    var h = Host { tag = 0 }
    var a = Host::k(h, 5 to i32)
    var b = Host::k(h, "ab")
    a + b
}

pub fn operator_overload_compose_probe(): i64 {
    var box5 = Box { v = 5 }
    var box9 = Box { v = 9 }
    var left = (box5 + 3).v
    var right = (box5 + box9).v
    left + right
}
