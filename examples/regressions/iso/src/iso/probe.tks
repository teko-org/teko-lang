const MARK_ID: u64 = 7

fn test_writer() {
    task_reset()
    cov_mark(MARK_ID)
}

fn test_reader(): u64 {
    task_reset()
    cov_distinct()
}

fn reader_after_writer(): u64 {
    test_writer()
    test_reader()
}

fn reader_before_writer(): u64 {
    var count = test_reader()
    test_writer()
    count
}

/** Runs the writer/reader pair in both orders; returns a stable token when both counts are 0, else a FAIL token naming the leaking order. */
exp fn probe(): str {
    var ab = reader_after_writer()
    var ba = reader_before_writer()
    if ab != 0 { return "iso-cov-no-leak FAIL-ab" }
    if ba != 0 { return "iso-cov-no-leak FAIL-ba" }
    "iso-cov-no-leak 0 0"
}
