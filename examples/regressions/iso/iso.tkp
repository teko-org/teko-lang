# examples/regressions/iso — the per-task ISOLATION channel (0.3.1 paralelizacao-eixo1-isolamento-
# por-task §5): a `task_reset()` at each simulated `#test` boundary clears a per-task Category C sink,
# so a reader test sees no residue whatever the order. The NATIVE-route member is the function-coverage
# sink (`iso_cov_no_leak`, this project's `src/iso/probe.tks`, addressed by name through `scenario_true`);
# the string-intern sink runs down the C route as a `Given source` case (`cases/iso_intern_no_leak.tks`,
# env C — the intern builtins are staged off natively). Both exercise the SAME per-task-ification and
# reset in the shared runtime; the split is only the route each builtin lowers on.
name = "iso"
source = "src"

[artifact]
kind = "binary"
