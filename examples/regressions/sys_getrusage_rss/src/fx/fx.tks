/** fx::run — touch 8 MB of freshly allocated pages, then read peak_rss() (SYS_getrusage in Teko);
 * 0 when the reported peak is greater than zero. */
pub fn run(): i64 {
    var n: u64 = 8388608
    var addr = teko::sys::ptr_word(teko::mem::buf_ptr(n))
    var i: u64 = 0
    loop {
        if i >= n { break }
        teko::mem::store_u8((addr + (i to i64)) to u64, 65)
        i = i + 4096
    }
    if teko::mem::peak_rss() > 0 { return 0 }
    1
}
