fn roundtrips(raw: u64): bool {
    var x = teko::f64_from_bits(raw)
    var s = teko::runtime::f64_g17(x)
    var y = teko::float::parse(s)
    if x != x { return y != y }
    teko::f64_bits(y) == raw
}

fn all_round_trip(): bool {
    var bits: [16]u64 = []
    bits[0] = 0x0000000000000000
    bits[1] = 0x8000000000000000
    bits[2] = 0x3FF0000000000000
    bits[3] = 0xBFF0000000000000
    bits[4] = 0x3FB999999999999A
    bits[5] = 0x3FE0000000000000
    bits[6] = 0x400921FB54442D18
    bits[7] = 0x7FEFFFFFFFFFFFFF
    bits[8] = 0x0000000000000001
    bits[9] = 0x000FFFFFFFFFFFFF
    bits[10] = 0x0010000000000000
    bits[11] = 0x7FF0000000000000
    bits[12] = 0xFFF0000000000000
    bits[13] = 0x7FF8000000000000
    bits[14] = 0x4340000000000000
    bits[15] = 0xC08F400000000000
    var i: u64 = 0
    loop {
        if i >= 16 { break }
        if !roundtrips(bits[i]) { return false }
        i = i + 1
    }
    true
}

/** rt::result — round-trip every double in the battery through f64_g17 and parse; report the outcome. */
pub fn result(): str {
    if all_round_trip() { return "roundtrip ok" }
    "roundtrip FAIL"
}
