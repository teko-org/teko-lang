type Civil = struct {
    year: i64
    month: i64
    day: i64
}

fn civil_from_days(days: i64): Civil {
    var jdn = days + 2440588
    var f = jdn + 1401 + (((4 * jdn + 274277) / 146097) * 3 / 4) - 38
    var e = 4 * f + 3
    var g = (e % 1461) / 4
    var h = 5 * g + 2
    var day = (h % 153) / 5 + 1
    var month = (h / 153 + 2) % 12 + 1
    var year = e / 1461 - 4716 + (14 - month) / 12
    Civil { year = year; month = month; day = day }
}

fn is(c: Civil, y: i64, m: i64, d: i64): bool {
    c.year == y && c.month == m && c.day == d
}

/** fx::run — check the civil-calendar conversion against two fixed oracles: day 0 = 1970-01-01 and
 * day 18321 = 2020-02-29 (a leap day); 0 when both hold. */
pub fn run(): i64 {
    if !is(civil_from_days(0), 1970, 1, 1) { return 10 }
    if !is(civil_from_days(18321), 2020, 2, 29) { return 11 }
    0
}
