const CHUNK: u64 = 256

type SegChunk<T> = class {
    intern data: []T
    intern used: u32
    intern next: SegChunk<T>|null

    pub static fn make(): SegChunk<T> {
        var d: [cg::CHUNK]T = []
        .{ data = d; used = 0; next = null }
    }

    pub fn count_used(): u32 { self.used }

    pub fn succ(): SegChunk<T>|null { self.next }

    pub fn write(x: T) {
        self.data[self.used] = x
        self.used = self.used + 1
    }

    pub fn read(p: u32): T { self.data[p] }

    pub fn link(nx: SegChunk<T>) { self.next = nx }

    pub fn last_val(): T { self.data[self.used - 1] }

    pub fn walk(i: u64): T {
        if i < cg::CHUNK { return self.data[i] }
        match self.next {
            cg::SegChunk<T> as n => n.walk(i - cg::CHUNK)
            null => panic("cg::chunked: index out of range")
        }
    }
}

type Chunked<T> = class {
    intern head: SegChunk<T>|null
    intern tail: SegChunk<T>|null
    intern count: u64

    pub static fn make(): Chunked<T> { .{ head = null; tail = null; count = 0 } }

    pub fn len(): u64 { self.count }

    pub fn is_empty(): bool { self.count == 0 }

    pub fn push(x: T) {
        match self.tail {
            cg::SegChunk<T> as t => {
                if t.count_used() to u64 < cg::CHUNK {
                    t.write(x)
                    self.count = self.count + 1
                    return
                }
                var nx = SegChunk<T>::make()
                nx.write(x)
                t.link(nx)
                self.tail = nx
                self.count = self.count + 1
            }
            null => {
                var first = SegChunk<T>::make()
                first.write(x)
                self.head = first
                self.tail = first
                self.count = 1
            }
        }
    }

    pub fn first(): T {
        match self.head {
            cg::SegChunk<T> as h => h.read(0)
            null => panic("cg::chunked: first of empty sequence")
        }
    }

    pub fn last(): T {
        match self.tail {
            cg::SegChunk<T> as t => t.last_val()
            null => panic("cg::chunked: last of empty sequence")
        }
    }

    pub fn get(i: u64): T {
        match self.head {
            cg::SegChunk<T> as h => h.walk(i)
            null => panic("cg::chunked: index out of range")
        }
    }

    pub fn iter(): ChunkedIter<T> { ChunkedIter<T>::over(self.head) }
}

type ChunkedIter<T> = class {
    intern node: SegChunk<T>|null
    intern pos: u32

    pub static fn over(head: SegChunk<T>|null): ChunkedIter<T> { .{ node = head; pos = 0 } }

    pub fn next(): T|null {
        match self.node {
            cg::SegChunk<T> as n => {
                if self.pos >= n.count_used() {
                    self.node = n.succ()
                    self.pos = 0
                    return self.next()
                }
                var v = n.read(self.pos)
                self.pos = self.pos + 1
                v
            }
            null => null
        }
    }
}

pub fn check(): i64 {
    var c = Chunked<i64>::make()
    if !c.is_empty() { return 1 }
    var i: i64 = 0
    loop {
        if i >= 600 { break }
        c.push(i * 3)
        i = i + 1
    }
    if c.len() != 600 { return 2 }
    if c.is_empty() { return 3 }
    if c.first() != 0 { return 4 }
    if c.last() != 599 * 3 { return 5 }
    if c.get(0) != 0 { return 6 }
    if c.get(255) != 255 * 3 { return 7 }
    if c.get(256) != 256 * 3 { return 8 }
    if c.get(300) != 300 * 3 { return 9 }
    if c.get(599) != 599 * 3 { return 10 }
    var it = c.iter()
    var expect: i64 = 0
    var seen: i64 = 0
    loop {
        match it.next() {
            i64 as x => {
                if x != expect * 3 { return 11 }
                expect = expect + 1
                seen = seen + 1
            }
            null => break
        }
    }
    if seen != 600 { return 12 }
    0
}
