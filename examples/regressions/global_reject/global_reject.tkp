# examples/regressions/global_reject — the §15 `global` REJECT host. Each illegal form lives one per
# namespace under src/, and the single failing build reports every diagnostic it finds, one per
# scenario. `global` is a namespace-level fn/type/const modifier only: never a variable, never a type
# member, and two globals of the same exported signature (or same type name+arity) collide.
name = "global_reject"
source = "src"

[artifact]
kind = "binary"
