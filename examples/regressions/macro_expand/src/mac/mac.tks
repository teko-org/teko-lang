macro twice(x) {
    lowering { (${x}) + (${x}) }
}

macro sum3(a, b, c) {
    lowering { (${a}) + (${b}) + (${c}) }
}

macro quad(x) {
    lowering { @twice(${x}) + @twice(${x}) }
}

pub fn twice_probe(): i64 { @twice(5) }

pub fn sum3_probe(): i64 { @sum3(1, 2, 3) }

pub fn quad_probe(): i64 { @quad(5) }
