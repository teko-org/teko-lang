# embed_reject.tkr — the `#embed` REJECT host. Seven illegal directives live one per namespace under
# src/, and the single failing build reports every diagnostic it finds, one per scenario below. Two are
# PARSE-stage rejections (unknown codec, missing level) collected by the assembler; five are embed-pass
# rejections (path escape, drive-absolute, out-of-range level, missing file, duplicate-key conflict)
# collected by the compile-time embed pass. None has a successful build to sanitize/run.

Feature: #embed reject — the compiler rejects the illegal `#embed` directives

  Scenario: escape — a pattern that rises above the project root
    When compilation fails
    Then diagnostic = "#embed path escapes the project root"

  Scenario: drive — a Windows drive-absolute pattern
    When compilation fails
    Then diagnostic = "#embed path must not be drive-absolute"

  Scenario: level — a compression level out of the codec's range
    When compilation fails
    Then diagnostic = "out of range for Deflate (0..9)"

  Scenario: missing — a pattern naming a file absent from the project
    When compilation fails
    Then diagnostic = "#embed: no such file in the project"

  Scenario: conflict — two directives resolving to the same key
    When compilation fails
    Then diagnostic = "embedded by two directives"

  Scenario: badtype — an unknown compression type atom
    When compilation fails
    Then diagnostic = "#embed compression type must be one of None, Deflate, Gzip"

  Scenario: nolevel — a compression type with no level
    When compilation fails
    Then diagnostic = "expected ',' then a compression level"
