# examples/regressions/s17_if_region — the §17 `#if`/`#elseif`/`#else`/`#endif` REGION prune host.
# One `#if` region defines `pick` four times, once per arm; the build-time prune keeps EXACTLY the
# arm whose predicate the target satisfies (first-true-wins), so there is no duplicate definition.
# The leading `#if(os == "windows")` arm returns a call to a NONEXISTENT symbol: on a non-windows
# target it is pruned BEFORE type-check, so it must NOT error — proving the prune precedes the
# checker. On linux the `#elseif(os == "linux")` arm survives and `pick` returns 42.
name = "s17_if_region"
source = "src"

[artifact]
kind = "binary"
