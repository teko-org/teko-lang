pub fn div(a: i32, b: i32): (i32, i32) {
    return (a / b, a % b)
}

pub fn parallel(): i64 {
    var a, b = 3, 7
    a * 10 + b
}

pub fn parallel_reads_before_bind(): i64 {
    var x, y = 1, 2
    var y2, x2 = x, y
    x2 * 10 + y2
}

pub fn shared_annotation(): i64 {
    var a, b: u8 = 200, 55
    (a to i64) + (b to i64)
}

pub fn decomp_skip(): i64 {
    var xs: []i64 = [10, 20, 30]
    var [a, _, c] = xs
    a + c
}

pub fn decomp_rest(): i64 {
    var xs: []i64 = [1, 2, 3, 4, 5]
    var [h, .., p, q] = xs
    h * 100 + p * 10 + q
}

pub fn decomp_rest_zero_middle(): i64 {
    var xs: []i64 = [1, 2]
    var [h, .., t] = xs
    h * 10 + t
}

