# examples/regressions/syntax — the project-regressor for the IDENTITY axis of the
# binding modes (owner ruling 2026-07-30: "by definition a `ref` can only be mutable"). `let`/`mut`
# is the mutability axis; `ref` is the identity axis and is born mutable, so `ref mut` does not
# exist and EVERY `ref` grants write-through — in BOTH binder positions.
#
# It pins the two positions that violated the law, each with a BEFORE and an AFTER reading so a
# guard that cannot fail is impossible:
#
#   * `fn shut(ref ch: Ch)` — a write through a `ref` PARAMETER used to be refused at compile time
#     ("cannot assign to a field of an immutable binding — declare it `mut` (B.21)"), because the
#     binding's writability was decided from the binder's declared `mut`-ness alone and a parameter
#     always declares false.
#   * `ref r = d` — an UN-ANNOTATED reference local used to compile into a silent COPY, with zero
#     diagnostics, while `ref r: Ch = d` over the SAME source aliased correctly.
#
# The program builds and runs; its exit code is a bit-score, so a regression names WHICH half of
# WHICH direction broke rather than merely going non-zero.
name = "syntax"
source = "src"

[artifact]
kind = "binary"
