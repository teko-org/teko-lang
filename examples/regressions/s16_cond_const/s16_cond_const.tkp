# examples/regressions/s16_cond_const — the §16 TARGET-CONDITIONAL const host. A `(pick, TAG)` const
# family carries two pairwise-disjoint `#arch` arms (x86_64=64, arm64=65). Under the C-monolith
# backend both arms survive the prune and codegen emits ONE C `#if` ladder of `#define`s, lowering the
# `pick::TAG` reference to the laddered symbol instead of a hard-baked single-arch literal — the
# root-cause fix for the arm64 first-alloc SIGSEGV. On an x86_64 target the ladder selects 64.
name = "s16_cond_const"
source = "src"

[artifact]
kind = "binary"
