type Chunked<T> = class {
    pub static fn make(): Chunked<T> { .{ } }

    pub fn len(): u64 { 999 }
}

pub fn run(): i64 {
    var q = teko::collections::Chunked<i64>::make()
    if q.len() != 0 { return 1 }
    q.push(7)
    if q.len() != 1 { return 2 }
    if q.get(0) != 7 { return 3 }
    0
}
