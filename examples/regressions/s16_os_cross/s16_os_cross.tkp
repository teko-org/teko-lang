# examples/regressions/s16_os_cross — the §16 `#os` CROSS-EMIT host. An `#os`-split const family
# (linux=42, macos=43, windows=44) and an `#os`-split FUNCTION family (`os_tag`, three bodies) both
# defer the OS axis to the emitted C `#if` instead of pruning to the host: codegen wraps each const
# arm in a `#if <os>` `#define` ladder and each function body in its own `#if <os>` block, so the one
# `teko.c` cross-compiles across Linux/macOS/Windows. On a Linux host the ladder selects 42.
name = "s16_os_cross"
source = "src"

[artifact]
kind = "binary"
