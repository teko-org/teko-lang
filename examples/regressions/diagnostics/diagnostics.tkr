Feature: §9 value-type operator + method DEFINITION rejections, folded as standalone Given source cases

  # parse_cases/vt_field_in_body.tks — ruling 10: the value IS the primitive, so a body carries no fields
  Scenario: value_type_field_rejected
    Given source = "parse_cases/vt_field_in_body.tks"
    When compilation fails
    Then diagnostic = "a value-type body may not declare fields"

  # parse_cases/vt_static_in_body.tks — ruling 10: no static methods in a value-type body
  Scenario: value_type_static_rejected
    Given source = "parse_cases/vt_static_in_body.tks"
    When compilation fails
    Then diagnostic = "a value-type body may not declare a `static` method"

  # cases/vt_no_self_operand.tks — ruling 1: at least one operand must be `self`
  Scenario: operator_no_self_operand_rejected
    Given source = "cases/vt_no_self_operand.tks"
    When compilation fails
    Then diagnostic = "at least one operand of `operator __add` must be `self`"

  # cases/vt_comparison_wrong_return.tks — ruling 3: a comparison operator must return `bool`
  Scenario: operator_wrong_return_rejected
    Given source = "cases/vt_comparison_wrong_return.tks"
    When compilation fails
    Then diagnostic = "a comparison `operator __eq` must return `bool`"

  # cases/vt_index_on_scalar.tks — ruling 4: `__index` only on an indexed carrier, never a scalar newtype
