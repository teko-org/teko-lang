type Inner = class {
    pub v: bool
    pub fn of(): Inner {
        Inner { v = true }
    }
}

type Outer = class {
    pub inner: Inner
    pub fn of(): Outer {
        Outer { inner = Inner::of() }
    }
}

pub fn probe(): i64 {
    var o = Outer::of()
    o.inner.v = false
    if o.inner.v { 1 } else { 0 }
}

pub fn entry() {
    (probe()) to i32
}
