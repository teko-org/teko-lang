# examples/regressions/s17_composite — the §17 COMPOSITE predicate host. A single
# `#if(os == "linux" && arch == "x86_64")` region selects a definition only on that OS+arch pair,
# with an `#else` fallback. On a linux/x86_64 target the conjunction is satisfied and `pick`
# returns 99; on any other target the fallback returns 1.
name = "s17_composite"
source = "src"

[artifact]
kind = "binary"
