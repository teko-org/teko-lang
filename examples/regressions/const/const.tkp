# examples/regressions/const — the project-regressor CHANNEL for compile-time constant
# materialization. Two members share this ONE native build (0.3.1 channel ruling — a variation in
# SOURCE is a member of one project, not a project of its own): a STRUCT const whose initializer is
# an allowlisted COMPTIME CONSTRUCTOR CALL (`reg`, Tier 5 of the const grammar — the shape the
# compiler's own backends use for their physical-register consts, `const RAX: Reg = preg(3 + 4, 3)`)
# and an AGGREGATE const whose element is FAT (`tbl`, a `const TABLE: []str = [...]` whose rodata
# image and comptime-fold termination the second member pins). Each member's driver row asserts its
# own value through `scenario`, so a value that drifted through canonicalization or the rodata
# serializer names the member that broke.
#
# `name` is `const_regr` and NOT `const`: `const` is a reserved word, so the field a manifest reader
# lexes must not be the keyword. The dir is `const` (the filesystem accepts it) and the regression
# list references the `.tkr` by PATH, never by this name.
name = "const_regr"
source = "src"

[artifact]
kind = "binary"
