type Reg = struct {
    id: i64
    klass: i64
    is_phys: bool
}

pub fn preg(id: i64, klass: i64): Reg {
    Reg { id = id; klass = klass; is_phys = true }
}

const RAX: Reg = preg(3 + 4, 3)

fn flag_score(b: bool): i64 {
    if b { 1 } else { 0 }
}

fn reg_score(r: Reg): i64 {
    r.id * 6 + r.klass + flag_score(r.is_phys)
}

pub fn rax_score(): i64 {
    reg_score(RAX)
}
