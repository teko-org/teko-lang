/** am::run — exercise every teko::assert family on its passing path; each compare is pure Teko
 * over the migrated panic bottom, so a green run proves the C assert seed is off the path. */
pub fn run() {
    teko::assert::is_true(true)
    teko::assert::is_false(false)
    teko::assert::eq_i64(21 + 21, 42)
    teko::assert::ne_i64(41, 42)
    teko::assert::lt_i64(41, 42)
    teko::assert::le_i64(42, 42)
    teko::assert::gt_i64(43, 42)
    teko::assert::ge_i64(42, 42)
    teko::assert::eq_u64(42 to u64, 42 to u64)
    teko::assert::eq_f64(0.1 + 0.2, 0.3, 0.0001)
    teko::assert::eq_str("teko", "teko")
    teko::assert::ne_str("teko", "lang")
    teko::assert::str_contains("teko-lang", "lang")
    teko::assert::len_eq(b"abc".len, 3 to u64)
    teko::assert::bytes_eq(b"abc", b"abc")
    teko::assert::is_present("value", true)
    teko::assert::is_absent("value", false)
    teko::assert::is_ok("outcome", true)
    teko::assert::is_error("outcome", false)
    teko::io::println("assert-battery: ok")
}
