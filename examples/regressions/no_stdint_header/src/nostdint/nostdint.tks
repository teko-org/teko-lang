pub fn check(): i64 {
    var buf: [16]byte = []
    var i: u64 = 0
    loop {
        if i >= 16 { break }
        if buf[i] != (0 to byte) { return 1 }
        i = i + 1
    }
    buf[4] = b'A'
    if buf[4] != b'A' { return 2 }
    var sum: u64 = 0
    var j: u64 = 0
    loop {
        if j >= 16 { break }
        sum = sum + (buf[j] to u64)
        j = j + 1
    }
    if sum != (b'A' to u64) { return 3 }
    0
}
