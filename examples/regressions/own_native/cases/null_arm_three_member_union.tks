fn three(n: i64): i64 | null | error {
    if n == 0 { return null }
    if n < 0 { return error { message = "d30 negative" } }
    n * 2
}

fn three_str(n: i64): str | null | error {
    if n == 0 { return null }
    if n < 0 { return error { message = "d30 negative" } }
    "abc"
}

fn arm_tag(n: i64): i64 {
    match three(n) {
        i64 => 1
        null => 2
        error => 3
    }
}

fn arm_tag_nullfirst(n: i64): i64 {
    match three(n) {
        null => 2
        i64 => 1
        error => 3
    }
}

fn payload(n: i64): i64 {
    match three(n) {
        i64 as v => v
        null => 7
        error => 9
    }
}

fn str_payload(n: i64): i64 {
    match three_str(n) {
        str as s => s.len to i64
        null => 7
        error => 9
    }
}

fn checks(): i64 {
    if arm_tag(2) != 1 { return 1 }
    if arm_tag(0) != 2 { return 2 }
    if arm_tag(-2) != 3 { return 3 }
    if arm_tag_nullfirst(2) != 1 { return 4 }
    if arm_tag_nullfirst(0) != 2 { return 5 }
    if arm_tag_nullfirst(-2) != 3 { return 6 }
    if payload(3) != 6 { return 7 }
    if payload(0) != 7 { return 8 }
    if payload(-1) != 9 { return 9 }
    if str_payload(3) != 3 { return 10 }
    if str_payload(0) != 7 { return 11 }
    if str_payload(-1) != 9 { return 12 }
    0
}

var failed = checks()
var code = if failed == 0 { 42 } else { failed }
teko::io::println($"{code}")
