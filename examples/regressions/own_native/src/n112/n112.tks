pub type Func = struct {
    fname: str
    body: []str
}

pub type TypeDecl = struct {
    tname: str
    tbody: []str
}

pub type Kind = variant Func | TypeDecl | i64

pub type Item = struct {
    content: Kind
    namespace: str
    file: str
}

pub fn make_func(): Item {
    var f = Func { fname = "fn"; body = ["a", "b"] }
    Item { content = f; namespace = "ns"; file = "f.tks" }
}

pub fn make_type(): Item {
    var t = TypeDecl { tname = "T"; tbody = ["x"] }
    Item { content = t; namespace = "ns"; file = "t.tks" }
}

pub fn readback(one: []Item): i64 {
    var merged: [one.len]Item = []
    var k: u64 = 0
    loop {
        if k >= one.len { break }
        merged[k] = Item { content = one[k].content; namespace = "n"; file = "p.tks" }
        k = k + 1
    }
    if merged.len != 12 { return -1 }
    var acc: i64 = 0
    var j: u64 = 0
    loop {
        if j >= merged.len { break }
        var it = merged[j]
        acc = acc + (it.file.len to i64) + (it.namespace.len to i64)
        match it.content {
            Func as f => { acc = acc + (f.fname.len to i64) + (f.body.len to i64) }
            TypeDecl as t => { acc = acc + (t.tname.len to i64) + (t.tbody.len to i64) }
            i64 as n => { acc = acc + n }
        }
        j = j + 1
    }
    acc
}
