type Inner_qopt = struct {
    v: i64 | null
}

type Outer_qopt = struct {
    inner: Inner_qopt | null
}

fn read_outer(o: Outer_qopt, fallback: i64): i64 {
    match o.inner {
        Inner_qopt as inn => match inn.v { i64 as v => v; null => fallback }
        null => fallback
    }
}

pub fn probe(): u64 {
    var present = Outer_qopt { inner = Inner_qopt { v = 30 } }
    var inner_null = Outer_qopt { inner = Inner_qopt { v = null } }
    var outer_null = Outer_qopt { inner = null }
    (read_outer(present, 0) + read_outer(inner_null, 5) + read_outer(outer_null, 7)) to u64
}
