type Pt = struct {
    a: i64

    b: i64
}

type Nest = struct {
    p: Pt

    n: i64
}

type Ctr = class {
    pub seen: i64

    pub fn make(v: i64): Ctr { Ctr { seen = v } }

    pub fn twin(): Ctr { Ctr { seen = self.seen * 2 } }

    pub fn bump() { self.seen = self.seen + 1 }
}

fn clob(s: i64): i64 {
    var v0: i64 = s + 111
    var v1: i64 = s + 222
    var v2: i64 = s + 333
    var v3: i64 = s + 444
    var v4: i64 = s + 555
    var v5: i64 = s + 666
    var v6: i64 = s + 777
    var v7: i64 = s + 888
    var v8: i64 = s + 999
    var v9: i64 = s + 1010
    v0 = v0 + v1
    v2 = v2 + v3
    v4 = v4 + v5
    v6 = v6 + v7
    v8 = v8 + v9
    v0 + v2 + v4 + v6 + v8
}

fn mk_pt(x: i64): Pt { Pt { a = x; b = x * 10 } }

fn mk_pt_tail(x: i64): Pt {
    var q = Pt { a = x; b = x * 10 }
    q
}

fn mk_pt_if(x: i64): Pt { if x > 0 { Pt { a = x; b = x * 10 } } else { Pt { a = 0; b = 0 } } }

fn mk_pt_match(x: i64): Pt {
    match x {
        1 => Pt { a = 1; b = 11 }
        _ => Pt { a = 2; b = 22 }
    }
}

fn mk_nest(x: i64): Nest { Nest { p = Pt { a = x; b = x * 10 }; n = x + 1 } }

fn mk_union(x: i64): Pt | error {
    if x < 0 { return error { message = "negative" } }
    Pt { a = x; b = x * 10 }
}

fn mk_optional(x: i64): Pt | null {
    if x < 0 { return null }
    Pt { a = x; b = x * 10 }
}

fn mk_pt_lambda(x: i64): Pt {
    var f: func<i64, Pt> = (v: i64) => { Pt { a = v; b = v * 10 } }
    f(x)
}

fn tick_fn(start: i64): func<i64, i64> {
    (n: i64) => { start + n }
}

fn empty_i64s(): []i64 { [] }

fn takes_pt(q: Pt): i64 {
    var r = q
    r.a = 77
    q.a
}

pub fn agg_return_struct_survives_a_call(): bool {
    var p = mk_pt(5)
    if clob(1) == 0 { return false }
    p.a == 5 && p.b == 50
}

pub fn agg_return_tail_local_survives_a_call(): bool {
    var p = mk_pt_tail(6)
    if clob(2) == 0 { return false }
    p.a == 6 && p.b == 60
}

pub fn agg_return_class_factory_survives_a_call(): bool {
    var c = Ctr::make(7)
    if clob(3) == 0 { return false }
    c.seen == 7
}

pub fn agg_return_method_result_survives_a_call(): bool {
    var c = Ctr::make(21)
    var d = c.twin()
    if clob(4) == 0 { return false }
    d.seen == 42
}

pub fn agg_return_nested_survives_a_call(): bool {
    var n = mk_nest(9)
    if clob(5) == 0 { return false }
    n.p.a == 9 && n.p.b == 90 && n.n == 10
}

pub fn agg_return_if_value_survives_a_call(): bool {
    var p = mk_pt_if(4)
    if clob(6) == 0 { return false }
    p.a == 4 && p.b == 40
}

pub fn agg_return_match_value_survives_a_call(): bool {
    var p = mk_pt_match(1)
    if clob(7) == 0 { return false }
    p.a == 1 && p.b == 11
}

pub fn agg_return_from_lambda_survives_a_call(): bool {
    var p = mk_pt_lambda(11)
    if clob(8) == 0 { return false }
    p.a == 11 && p.b == 110
}

pub fn agg_return_error_union_survives_two_calls(): bool {
    var r = mk_union(8)
    if clob(9) == 0 { return false }
    if clob(10) == 0 { return false }
    match r {
        Pt as p => p.a == 8 && p.b == 80
        error => false
    }
}

pub fn agg_return_optional_survives_a_call(): bool {
    var r = mk_optional(12)
    if clob(11) == 0 { return false }
    match r {
        Pt as p => p.a == 12 && p.b == 120
        null => false
    }
}

pub fn agg_return_pushed_in_loop_keeps_each_iteration(): bool {
    var ps: [3]Pt = []
    var i: i64 = 0
    loop {
        if i >= 3 { break }
        ps[i] = mk_pt_if(i + 1)
        i++
    }
    if ps.len != 3 { return false }
    ps[0].a == 1 && ps[1].a == 2 && ps[2].a == 3
}

pub fn agg_return_class_pushed_in_loop_keeps_each_iteration(): bool {
    var cs: [3]Ctr = []
    var i: i64 = 0
    loop {
        if i >= 3 { break }
        cs[i] = Ctr::make(i * 7)
        i++
    }
    if cs.len != 3 { return false }
    cs[0].seen == 0 && cs[1].seen == 7 && cs[2].seen == 14
}

pub fn agg_return_in_loop_accumulates(): bool {
    var acc: i64 = 0
    var i: i64 = 0
    loop {
        if i >= 2 { break }
        var p = mk_pt(i + 1)
        if clob(i) == 0 { return false }
        acc = acc + p.a
        i++
    }
    acc == 3
}

pub fn closure_returned_still_reads_its_captures(): bool {
    var add = tick_fn(100)
    if clob(12) == 0 { return false }
    add(5) == 105
}

pub fn empty_array_literal_returned_is_usable(): bool {
    var xs = empty_i64s()
    if clob(13) == 0 { return false }
    xs.len == 0
}

pub fn struct_field_from_a_named_local_copies(): bool {
    var t = Pt { a = 1; b = 2 }
    var h = Nest { p = t; n = 44 }
    t.a = 99
    h.p.a == 1 && h.n == 44
}

pub fn let_binding_of_an_aggregate_copies(): bool {
    var t = Pt { a = 1; b = 2 }
    var u = t
    t.a = 99
    u.a == 1 && u.b == 2
}

pub fn assignment_of_an_aggregate_copies(): bool {
    var t = Pt { a = 1; b = 2 }
    var u = Pt { a = 3; b = 4 }
    u = t
    t.a = 99
    u.a == 1 && u.b == 2
}

pub fn argument_rebound_into_a_mut_local_copies(): bool {
    takes_pt(Pt { a = 1; b = 2 }) == 1
}

pub fn nested_field_read_copies(): bool {
    var n = Nest { p = Pt { a = 1; b = 2 }; n = 3 }
    var inner = n.p
    n.p.a = 99
    inner.a == 1 && inner.b == 2
}

pub fn slice_element_read_copies(): bool {
    var ps: [1]Pt = []
    ps[0] = Pt { a = 1; b = 2 }
    var e = ps[0]
    ps[0] = Pt { a = 99; b = 98 }
    e.a == 1 && ps[0].a == 99
}

pub fn field_assignment_from_a_place_copies(): bool {
    var t = Pt { a = 1; b = 2 }
    var h = Nest { p = Pt { a = 7; b = 8 }; n = 5 }
    h.p = t
    t.a = 99
    h.p.a == 1 && h.n == 5
}

pub fn receiver_mutation_still_reaches_the_caller(): bool {
    var c = Ctr::make(0)
    c.bump()
    c.bump()
    c.seen == 2
}
