const D27_TENTH_F32: f32 = 0.1

const D27_HALVES_F32: f32 = 2.5

fn d27_ftoa_of(tag: i64): str {
    var zero: f64 = 0.0
    var minus_one: f64 = -1.0
    var one: f64 = 1.0
    var two_and_a_half: f64 = 2.5
    var three: f64 = 3.0
    if tag == 0 { return teko::ftoa(zero) }
    if tag == 1 { return teko::ftoa(minus_one * zero) }
    if tag == 2 { return teko::ftoa(one) }
    if tag == 3 { return teko::ftoa(minus_one * two_and_a_half) }
    teko::ftoa(one / three)
}

fn d27_infinity(): f64 {
    var huge: f64 = 1.0e308
    var ten: f64 = 10.0
    huge * ten
}

fn d27_not_a_number(): f64 {
    d27_infinity() - d27_infinity()
}

fn f_ftoa_runtime_text(): i64 {
    if d27_ftoa_of(0) != "0" { return 1 }
    if d27_ftoa_of(1) != "-0" { return 2 }
    if d27_ftoa_of(2) != "1" { return 3 }
    if d27_ftoa_of(3) != "-2.5" { return 4 }
    if d27_ftoa_of(4) != "0.33333333333333331" { return 5 }
    0
}

