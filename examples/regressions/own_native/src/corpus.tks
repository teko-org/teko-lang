type RdPoint = struct { x: i64; y: i64 }

fn rd_bump_scalar(ref n: u64) {
    n.value = n.value + 1
}

fn rd_bump_point(ref p: RdPoint) {
    p.value = RdPoint { x = p.x + 1; y = p.y * 2 }
}

fn rd_set_msg(ref s: str, v: str) {
    s.value = v
}

fn rd_tick_fn(ref last: u64, ref total: u64): action<u64, u64> {
    (n: u64, m: u64) => {
        last.value = n
        total.value = m
    }
}

fn rd_loop_sum(ref acc: u64, n: u64) {
    var i: u64 = 0
    loop {
        if i >= n { break }
        acc.value = acc.value + i
        i = i + 1
    }
}

