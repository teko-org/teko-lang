fn f64_bits_of(tag: i64): u64 {
    if tag == 0 { return 4613937818241073152 }
    if tag == 1 { return 4611686018427387904 }
    13835058055282163712
}

fn f_f64_bits_roundtrip(): i64 {
    var a = teko::f64_from_bits(f64_bits_of(0))
    var b = teko::f64_from_bits(f64_bits_of(1))
    var c = teko::f64_from_bits(f64_bits_of(2))
    var ba = teko::f64_bits(a)
    var bb = teko::f64_bits(b)
    var bc = teko::f64_bits(c)
    if ba != f64_bits_of(0) { return 1 }
    if bb != f64_bits_of(1) { return 2 }
    if bc != f64_bits_of(2) { return 3 }
    if (bc & 0x8000000000000000) == 0 { return 4 }
    if (ba & 0x8000000000000000) != 0 { return 5 }
    0
}

fn f_f64_bitcast_arith(): i64 {
    var x = teko::f64_from_bits(f64_bits_of(0))
    var y = teko::f64_from_bits(f64_bits_of(1))
    var sum = teko::f64_bits(x + y)
    var diff = teko::f64_bits(x - y)
    var prod = teko::f64_bits(x * y)
    var quot = teko::f64_bits(x / y)
    if sum != 4617315517961601024 { return 1 }
    if diff != 4607182418800017408 { return 2 }
    if prod != 4618441417868443648 { return 3 }
    if quot != 4609434218613702656 { return 4 }
    0
}

type HolderD25 = struct {
    n: i64 | null
    s: str | null
}

type ShapeD25 = variant CircD25 | SqD25

type CircD25 = struct {
    r: i64
}

type SqD25 = struct {
    side: i64
}

type CarrierD25 = struct {
    sh: ShapeD25 | null
}

type BoxD25 = class {
    pub k: i64 | null

    pub fn make(v: i64 | null): BoxD25 { BoxD25 { k = v } }
}

fn d25_scalar_of(h: HolderD25): i64 { match h.n { null => 0 - 1; i64 as v => v } }

fn d25_text_len_of(h: HolderD25): i64 { match h.s { null => 0 - 1; str as t => t.len to i64 } }

fn d25_text_head_of(h: HolderD25): i64 { match h.s { null => 0 - 1; str as t => t[0] to i64 } }

fn d25_arg_or(x: i64 | null, fallback: i64): i64 { match x { null => fallback; i64 as v => v } }

fn d25_box_or(b: BoxD25, fallback: i64): i64 { match b.k { null => fallback; i64 as v => v } }

fn d25_shape_side_of(c: CarrierD25): i64 {
    match c.sh {
        null => 0 - 1
        ShapeD25 as s => match s {
            CircD25 as cc => cc.r
            SqD25 as sq => sq.side
            _ => 0 - 2
        }
    }
}

fn f_union_placement_field_and_argument(): i64 {
    var absent = HolderD25 { n = null; s = null }
    var present = HolderD25 { n = 41; s = "abcde" }
    if d25_scalar_of(absent) != 0 - 1 { return 1 }
    if d25_text_len_of(absent) != 0 - 1 { return 2 }
    if d25_scalar_of(present) != 41 { return 3 }
    if d25_text_len_of(present) != 5 { return 4 }
    if d25_text_head_of(present) != 97 { return 5 }
    if d25_arg_or(null, 7) != 7 { return 6 }
    if d25_arg_or(13, 7) != 13 { return 7 }
    if d25_box_or(BoxD25::make(null), 3) != 3 { return 8 }
    if d25_box_or(BoxD25::make(19), 3) != 19 { return 9 }
    0
}

fn f_union_placement_nested_variant(): i64 {
    if d25_shape_side_of(CarrierD25 { sh = null }) != 0 - 1 { return 1 }
    if d25_shape_side_of(CarrierD25 { sh = SqD25 { side = 23 } }) != 23 { return 2 }
    if d25_shape_side_of(CarrierD25 { sh = CircD25 { r = 29 } }) != 29 { return 3 }
    var bound: ShapeD25 | null = SqD25 { side = 31 }
    match bound {
        null => return 4
        ShapeD25 as s => match s { CircD25 => return 5; SqD25 as sq => if sq.side != 31 { return 6 }; _ => return 7 }
    }
    0
}

