fn f_f32_text_is_its_own_value(): i64 {
    var tenth = D27_TENTH_F32
    var halves = D27_HALVES_F32
    if teko::ftoa(tenth) != "0.10000000149011612" { return 1 }
    if $"{tenth}" != "0.10000000149011612" { return 3 }
    if teko::ftoa(halves) != "2.5" { return 4 }
    if $"{halves}" != "2.5" { return 5 }
    if $"{halves:F2}" != "2.50" { return 6 }
    if $"{tenth:F4}" != "0.1000" { return 7 }
    if $"{halves:G}" != "2.5" { return 8 }
    if $"{halves:E3}" != "2.500e+00" { return 9 }
    if $"{halves:N2}" != "2.50" { return 10 }
    if $"{halves:P1}" != "250.0%" { return 11 }
    if $"{halves:[d27_dynamic_spec()]}" != "2.500" { return 12 }
    if $"{tenth:[d27_dynamic_spec()]}" != "0.100" { return 13 }
    0
}

