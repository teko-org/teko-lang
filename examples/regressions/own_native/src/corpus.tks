    if p.y != 4 { return 4 }
    rd_bump_point(p)
    if p.x != 3 { return 5 }
    if p.y != 8 { return 6 }
    var s: str = "a"
    rd_set_msg(s, "hello")
    if s.len != 5 { return 7 }
    if s != "hello" { return 8 }
    rd_set_msg(s, "hi")
    if s.len != 2 { return 9 }
    if s != "hi" { return 10 }
    var last: u64 = 0
    var total: u64 = 0
    var tick = rd_tick_fn(last, total)
    tick(3, 10)
    if last != 3 { return 11 }
    if total != 10 { return 12 }
    tick(7, 20)
    if last != 7 { return 13 }
    if total != 20 { return 14 }
    var acc: u64 = 0
    rd_loop_sum(acc, 5)
    if acc != 10 { return 15 }
    0
}

