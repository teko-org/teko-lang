fn d27_f64_case(tag: i64): f64 {
    var zero: f64 = 0.0
    var minus_one: f64 = -1.0
    var one: f64 = 1.0
    var two_and_a_half: f64 = 2.5
    var three: f64 = 3.0
    if tag == 0 { return zero }
    if tag == 1 { return minus_one * zero }
    if tag == 2 { return one }
    if tag == 3 { return minus_one * two_and_a_half }
    one / three
}

fn f_float_hole_natural_form(): i64 {
    var i: i64 = 0
    loop {
        if i > 4 { break }
        var x = d27_f64_case(i)
        if $"{x}" != teko::ftoa(x) { return 1 }
        i++
    }
    var negative_zero = d27_f64_case(1)
    if $"[{negative_zero}]" != "[-0]" { return 2 }
    var a_third = d27_f64_case(4)
    if $"{a_third}" != "0.33333333333333331" { return 3 }
    0
}

