type D30Sq = struct {
    side: i64
}

type D30Holder = struct {
    inner: i64 | null
}

type D30Nest = struct {
    deep: D30Sq | null
}

fn d30_three_i64(n: i64): i64 | null | error {
    if n == 0 { return null }
    if n < 0 { return error { message = "d30 negative" } }
    n * 2
}

fn d30_three_str(n: i64): str | null | error {
    if n == 0 { return null }
    if n < 0 { return error { message = "d30 negative" } }
    "abc"
}

fn d30_three_slice(n: i64): []i64 | null | error {
    if n == 0 { return null }
    if n < 0 { return error { message = "d30 negative" } }
    [n, n + 1]
}

fn d30_three_named(n: i64): D30Sq | null | error {
    if n == 0 { return null }
    if n < 0 { return error { message = "d30 negative" } }
    D30Sq { side = n }
}

fn d30_two_i64(n: i64): i64 | null {
    if n == 0 { return null }
