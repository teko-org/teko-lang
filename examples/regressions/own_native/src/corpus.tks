}

fn f_fat_slice_literal_index(): i64 {
    var xs: []str = ["one", "two", "three"]
    if xs.len != 3 { return 1 }
    if xs[0].len != 3 { return 2 }
    if xs[0] != "one" { return 3 }
    if xs[1] != "two" { return 4 }
    if xs[2] != "three" { return 5 }
    0
}

fn f_fat_slice_push_in_loop(): i64 {
    var names: []str = ["alpha", "beta", "gamma", "delta"]
    var out: [names.len]str = []
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        out[i] = names[i]
        i++
    }
    if out.len != 4 { return 1 }
    if out[0].len != 5 { return 2 }
    if out[0] != "alpha" { return 3 }
    if out[3] != "delta" { return 4 }
    0
}

fn f_str_contains_and_ends_with(): i64 {
    if !"hello world".contains("lo wo") { return 1 }
    if "hello world".contains("xyz") { return 2 }
    if !"hello".contains("") { return 3 }
    if !"hello world".ends_with("world") { return 4 }
    if "hello world".ends_with("worldx") { return 5 }
    if !"hello".ends_with("") { return 6 }
    0
}

fn f_str_slice_family(): i64 {
    var s = "hello world"
    var mid = s.slice(6, 11)
    if mid.len != 5 { return 1 }
    if mid != "world" { return 2 }
    var head = s.slice_to(5)
    if head.len != 5 { return 3 }
    if head != "hello" { return 4 }
    var tail = s.slice_from(6)
    if tail.len != 5 { return 5 }
    if tail != "world" { return 6 }
    0
}

type AliasCorpusS = str

type AliasCorpusHolder = struct { s: AliasCorpusS; n: i64 }

fn f_alias_fat_field(): i64 {
    var h = AliasCorpusHolder { s = "abcde"; n = 41 }
    if h.n != 41 { return 1 }
    if h.s.len != 5 { return 2 }
    if h.s != "abcde" { return 3 }
