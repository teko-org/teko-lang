fn opaque_zero(): i64 {
    var n: i64 = 1
    n = n - 1
    n
}

fn bm_a(o: i64): i64 { 3 + o }

fn bm_b(o: i64): i64 { 4 + o }

pub fn bmem_two_fns(): bool {
    var o = opaque_zero()
    bm_a(o) + bm_b(o) == 7
}

fn bm_g(x: i64): i64 { x + 1 }

fn bm_f(x: i64): i64 { bm_g(x) + 10 }

pub fn bmem_call_chain(): bool {
    bm_f(opaque_zero()) == 11
}

