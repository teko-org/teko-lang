pub fn bmem_many_small(): bool {
    var o = opaque_zero()
    bm_s00(o) + bm_s01(o) + bm_s02(o) + bm_s03(o) + bm_s04(o) + bm_s05(o) + bm_s06(o) + bm_s07(o) + bm_s08(o) + bm_s09(o) + bm_s10(o) + bm_s11(o) + bm_s12(o) + bm_s13(o) + bm_s14(o) + bm_s15(o) + bm_s16(o) + bm_s17(o) + bm_s18(o) + bm_s19(o) + bm_s20(o) + bm_s21(o) + bm_s22(o) + bm_s23(o) + bm_s24(o) + bm_s25(o) + bm_s26(o) + bm_s27(o) + bm_s28(o) + bm_s29(o) + bm_s30(o) + bm_s31(o) + bm_s32(o) + bm_s33(o) + bm_s34(o) + bm_s35(o) + bm_s36(o) + bm_s37(o) + bm_s38(o) + bm_s39(o) + bm_s40(o) + bm_s41(o) + bm_s42(o) + bm_s43(o) + bm_s44(o) + bm_s45(o) + bm_s46(o) + bm_s47(o) + bm_s48(o) + bm_s49(o) + bm_s50(o) + bm_s51(o) + bm_s52(o) + bm_s53(o) + bm_s54(o) + bm_s55(o) + bm_s56(o) + bm_s57(o) + bm_s58(o) + bm_s59(o) + bm_s60(o) + bm_s61(o) + bm_s62(o) + bm_s63(o) == 2016
}

fn bm_lit_a(): str { "bmem_shared_rodata_literal" }

fn bm_lit_b(): str { "bmem_shared_rodata_literal" }

pub fn bmem_rodata_shared(): bool {
    var a = bm_lit_a()
    var b = bm_lit_b()
    a == b && a.len == (26 to u64)
}

pub fn bmem_loop_fn(): bool {
    var o = opaque_zero()
    var acc: i64 = 0
    var i: i64 = 0
    loop {
        if i >= 10 { break }
        acc = acc + i + o
        i = i + 1
    }
    acc == 45
}

fn bm_close_a(start: i64): func<i64, i64> {
    (n: i64) => { start + n }
}

pub fn bmem_lambda(): bool {
    var f = bm_close_a(3)
    f(4) == 7
}

fn bm_close_b(start: i64): func<i64, i64> {
    (n: i64) => { start + n }
}

fn bm_close_c(start: i64): func<i64, i64> {
    (n: i64) => { start + n * 2 }
}

fn bm_close_d(start: i64): func<i64, i64> {
    (n: i64) => { start + n * 3 }
}

fn bm_close_e(start: i64): func<i64, i64> {
    (n: i64) => { start + n * 4 }
}

fn bm_close_f(start: i64): func<i64, i64> {
    (n: i64) => { start + n * 5 }
}

fn bm_close_g(start: i64): func<i64, i64> {
    (n: i64) => { start + n * 6 }
}

fn bm_close_h(start: i64): func<i64, i64> {
    (n: i64) => { start + n * 7 }
}

pub fn bmem_lambdas_many(): bool {
    var o = opaque_zero()
    var a = bm_close_b(1 + o)
    var b = bm_close_c(2 + o)
    var c = bm_close_d(3 + o)
    var d = bm_close_e(4 + o)
    var e = bm_close_f(5 + o)
    var f = bm_close_g(6 + o)
    var g = bm_close_h(7 + o)
    a(10) + b(10) + c(10) + d(10) + e(10) + f(10) + g(10) == 308
}
