# examples/regressions/group_bind_reject — the §9.D capability (c) group-bind REJECT host. Two illegal
# forms live one per namespace under src/, and the single failing build reports every diagnostic it
# finds, one per scenario in the .tkr — a group-bind match that leaves a DIRECT member uncovered, and a
# BARE alternation `B | C as v` that tries to bind. It has no successful build to sanitize/run (it
# mirrors block_expr_reject / match_universal_reject).
name = "group_bind_reject"
source = "src"

[artifact]
kind = "binary"
