type cls = class {
    pub name: str

    pub static fn new(name: str): self {
        cls { name = name }
    }
}

fn func0(a: i32, b: u64): cls {
    cls::new($"{a}-{b}")
}

fn func1(ref c: cls) {
    c.name = c.name ~ "."
}

fn build_name(): str {
    var a: i32 = 100
    var b: u64 = 0
    var cc: cls = cls::new("start")

    loop var i in 0..10 {
        if i % 2 == 0 {
            var c = func0(a, b * 1)
            b++
            cc = c
        } else {
            cc.name = cc.name ~ $"{i}"
        }
    }

    func1(cc)
    cc.name
}

println(build_name())
