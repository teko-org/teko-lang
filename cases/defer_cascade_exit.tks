fn cascade_exit(): i64 {
    var acc: i64 = 1
    defer { acc = acc + 1 }
    loop {
        defer { acc = acc * 2 }
        match 1 {
            1 => {
                defer { acc = acc + 100 }
                if true {
                    defer { acc = acc + 10000 }
                    exit((acc) to i32)
                }
            }
            _ => { }
        }
    }
    return acc
}

cascade_exit()
eprintln("unreachable: cascade_exit always exits")
