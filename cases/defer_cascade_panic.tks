fn cascade_panic() {
    defer { eprintln("L1") }
    loop {
        defer { eprintln("L2") }
        match 1 {
            1 => {
                defer { eprintln("L3") }
                if true {
                    defer { eprintln("L4") }
                    panic("defer_cascade_panic")
                }
            }
            _ => { }
        }
    }
}

cascade_panic()
