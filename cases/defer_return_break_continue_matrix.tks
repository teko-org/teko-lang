fn cascade_return(): i64 {
    var acc: i64 = 1
    defer { acc = acc + 1 }
    loop {
        defer { acc = acc * 2 }
        match 1 {
            1 => {
                defer { acc = acc + 100 }
                if true {
                    defer { acc = acc + 10000 }
                    return acc
                }
            }
            _ => { }
        }
    }
    return acc
}

fn cascade_break(): i64 {
    var acc: i64 = 1
    defer { acc = acc + 1 }
    loop {
        defer { acc = acc * 2 }
        match 1 {
            1 => {
                defer { acc = acc + 100 }
                if true {
                    defer { acc = acc + 10000 }
                    break
                }
            }
            _ => { }
        }
    }
    return acc
}

fn cascade_continue(): i64 {
    var acc: i64 = 1
    var n = 0
    defer { acc = acc + 1 }
    loop {
        defer { acc = acc * 2 }
        n = n + 1
        match n {
            1 => {
                defer { acc = acc + 100 }
                if true {
                    defer { acc = acc + 10000 }
                    continue
                }
            }
            _ => {
                defer { acc = acc + 100 }
                if true {
                    defer { acc = acc + 10000 }
                    break
                }
            }
        }
    }
    return acc
}

fn double_defer_same_scope_lifo(): i64 {
    var acc: i64 = 1
    defer { acc = acc + 1 }
    defer { acc = acc * 10 }
    return acc
}

var bad = 0
if cascade_return() != 20203 { if bad == 0 { bad = 1 } }
if cascade_break() != 20203 { if bad == 0 { bad = 2 } }
if cascade_continue() != 60605 { if bad == 0 { bad = 3 } }
if double_defer_same_scope_lifo() != 11 { if bad == 0 { bad = 4 } }
exit(bad)
