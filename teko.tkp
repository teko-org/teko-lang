# teko.tkp — the Teko project manifest (B.33). The Teko-source parallel of the
# C bootstrap's CMakeLists.txt: it describes the eventual self-hosted compiler.
# Its format is TOML. The C build ignores it.
#
# Declares the project's CANONICAL ROOT NAME, the artifact, and the source root.
# `teko` is the reserved root — no user project may claim it; the language's own
# project is its sole bearer, and every symbol is addressed from it
# (teko::lexer::Token, teko::text::str_from_utf8, ...).

name = "teko"
source = "src"         # the source root — INVISIBLE in addressing
                       # (teko::lexer::Token, never teko::src::lexer::Token)
version = "0.3.0.31"
suffix = "beta"   # prerelease stage. The 4th field of `version` IS the build number: the integrator bumps it +1 in the PR when merging a code change, and resets it to 0 on a major/minor/patch bump. MINOR bump 0.0.1→0.1.0 (build reset to 0) + alpha→beta marks the memory/unsafe/backend REMODEL turn (docs/design/memory-unsafe-backend-remodel.md).
description = "The Teko programming language compiler - a self-hosting, all-native toolchain."
                       # (C7.1k) embedded in every binary's metadata (the @(#) marker + macOS Info.plist).

[artifact]
kind = "binary"        # the compiler is an executable

[platforms]
# (C7.1k) the OSes this compiler targets — drives the CI build matrix. A single `teko build`
# targets ONE OS (the host, or an [extern] target); this list is the release surface.
targets = ["macos", "linux", "windows"]

[aliases]
# `use`-aliases and dependency aliases live HERE (B.33), never in a .tks.
# (none yet — the seed has no external dependencies.)

[coverage]
# D4 floors: function, line, and branch coverage. Absent key (or no [coverage]) → defaults to 80.
# `teko build` runs the test gate by DEFAULT — these floors bar a failing release.
#
# THE ESCAPE HATCH IS `--no-verify`, AND IT WORKS. `no_verify_of` (project.tks:2882) reads it off
# the args and `compile_project_g` routes to `build_ungated`, emitting straight to codegen with no
# gate at all. The whole self-host chain depends on that: build_with_seed_fallback.sh builds every
# rung with `--no-verify --release`, and a gate running there would re-prove on every generation
# what the test layer already owns.
#
# `--no-test` IS NOT THAT FLAG, and this line used to imply it was the only one worth naming. It is
# accepted on the command line and DISCARDED: its single appearance in the compiler is inside
# `project_arg_of` (project.tks:3011), the scanner that skips flags to find the positional project
# path — so it never reaches any gate decision and changes nothing. Naming it here while saying the
# gate is unconditional read as "there is no way to skip the gate", and that cost a wrong diagnosis
# (2026-07-27: a dry build was reported as running tests) before anyone opened the source. A flag
# that is silently inert deserves to be described as inert, not cited as the reason for a rule.
functions = 50
lines = 50
branches = 49

[tests]
# (0.3.1 C0) The first-class regressor surface: an EXPLICIT, ORDERED list of `.tkr` regressor FILE
# paths (no directory discovery, no glob — owner ruling 2026-07-24). Execution order = list order.
# A listed path that does not resolve to a readable file is a MANIFEST ERROR (M.3), never a silent
# skip. This fires ONLY in the `teko test .` self-test lane — the seed→gen1 `--no-verify` build uses
# `build_ungated` and never runs the regression phase (bootstrap-clean, R0).
regression = ["regressor.tkr","examples/regressions/chunked_crossns/chunked_crossns.tkr","examples/regressions/chunked_crossns_collision/chunked_crossns_collision.tkr","examples/regressions/chunked_grow/chunked_grow.tkr","examples/regressions/const/const.tkr","examples/regressions/crossmodule/crossmodule.tkr","examples/regressions/diagnostics/diagnostics.tkr","examples/regressions/embed_reject/embed_reject.tkr","examples/regressions/global_access/global_access.tkr","examples/regressions/global_reject/global_reject.tkr","examples/regressions/group_bind/group_bind.tkr","examples/regressions/group_bind_reject/group_bind_reject.tkr","examples/regressions/grouped_union/grouped_union.tkr","examples/regressions/iso/iso.tkr","examples/regressions/macro_expand/macro_expand.tkr","examples/regressions/macro_type_splice/macro_type_splice.tkr","examples/regressions/manifest/manifest.tkr","examples/regressions/math_floor_intrinsic/math_floor_intrinsic.tkr","examples/regressions/memcpy_intrinsic/memcpy_intrinsic.tkr","examples/regressions/no_stdint_header/no_stdint_header.tkr","examples/regressions/multi_assign/multi_assign.tkr","examples/regressions/multi_assign_reject/multi_assign_reject.tkr","examples/regressions/operator_overload_compose/operator_overload_compose.tkr","examples/regressions/own_native/own_native.tkr","examples/regressions/recursive_union/recursive_union.tkr","examples/regressions/s16_cond_const/s16_cond_const.tkr","examples/regressions/s16_os_cross/s16_os_cross.tkr","examples/regressions/s17_arch/s17_arch.tkr","examples/regressions/s17_composite/s17_composite.tkr","examples/regressions/s17_if_region/s17_if_region.tkr","examples/regressions/syntax/syntax.tkr","examples/regressions/teko_escape_hatch/teko_escape_hatch.tkr"]
gate = true
targets = ["host"]

[extern]
# (C7.1) foreign-link knobs. The compiler links NOTHING beyond libc: the host surfaces
# (env/io/fs/process) are builtins, and the runtime (teko_rt.c) uses no libm/pthread. So the
# cross knobs (cc / target / sysroot / freestanding) stay unset — host defaults apply.

[extern.libs.macos]
# none — libSystem provides libc + the symbolic backtrace (execinfo).

[extern.libs.linux]
# none — glibc provides libc + backtrace; under musl the backtrace degrades to a one-line notice.

[extern.libs.windows]
kernel32 = []   # FindFirstFileA / FindNextFileA / FindClose — Win32 directory API used by the dirent shim in discover.c; VirtualAlloc / VirtualFree / VirtualProtect / ExitProcess — Win32 memory API for the §16 arena/thread backing store
synchronization = []   # WaitOnAddress / WakeByAddressSingle / WakeByAddressAll — Win32 wait-by-address (futex) API for the §16 sync primitives (MinGW libsynchronization.a → -lsynchronization)
# (rand_s in the ucrt — no import lib — provides the Windows CSPRNG for teko_rt.c's tk_rt_secure_bytes (#194 C6), so no bcrypt link)
