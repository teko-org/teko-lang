// teko_prim.tk -- a PRIMITIVE WITH MEMBERS (docs/specs/datetime.md § 2), the
// mechanism `TimeSpan` brings and `DateTime`, `decimal`, `Guid` and every
// `enum` static are meant to reuse without a line of their own here.
//
// A type registered with `type_new` is a primitive: it has no row in
// teko_struct.tk's type table, so it has no field, no vtable, no constructor
// and no method, and `t.Ticks` reaches `teko: TimeSpan has no members` (P0
// probe, docs/internals/primitives.md). A primitive gets its members from a
// LOWERING TABLE instead of from a vtable: one row per member --
//
//     (type id, member name, kind, parameter type, symbol, result type)
//
// -- registered by the module that owns the primitive (teko_time.tk) and read
// by the four places the question is already asked: `.` at parse time
// (teko_expr.tk's `tk_dot`), `.` at pass time (teko_typeof.tk's `tk_pend_do`,
// the deferred access a parameter's receiver takes), `new Name(args)`
// (teko_expr.tk's `tk_new`) and the type word in expression/statement position
// (this file's own `tk_prim_expr`/`tk_prim_stmt`, registered by the owner
// module through `syntax_expr`/`syntax_stmt` -- the same two registrations a
// class name already gets, teko_access.tk's `tk_type_word`).
//
// A member access becomes an ORDINARY CALL to an ORDINARY FUNCTION with
// surface code in `lib/` (D21: zero new intrinsics):
//
//     t.Days                 ->  tk_ts_days((i64) t)
//     t.Duration()           ->  (TimeSpan) tk_ts_duration((i64) t)
//     TimeSpan.FromHours(2)  ->  (TimeSpan) tk_ts_from_hours((f64) 2)
//     new TimeSpan(n)        ->  (TimeSpan) n
//     a - b                  ->  (TimeSpan) tk_ts_sub((i64) a, (i64) b)
//
// THE TWO CASTS ARE THE SPEC'S OWN (§ 2). Every symbol a row names is written
// over the RAW eight bytes -- `i64` ticks in, `i64` ticks out -- so `lib/time.tk`
// is ordinary teko that never mentions the primitive type and never needs an
// operator of its own; the compiler writes `(i64) t` on the way in and
// `(TimeSpan) r` on the way out. Neither cast is an instruction: both slots are
// eight bytes and `walk_narrow` (mc/src/gen_walk.mc) answers 0 for a width-8
// `TK_SINT`, which the P0 probe measured. The same pair is what keeps every
// existing check honest: the argument teko_rc.tk's own pass sees is an `i64`,
// because it IS an `i64` by the time it reaches the call.
//
// Four properties make it fit the laws this repository holds:
//
//   * it is STATICALLY TYPED -- every row names its result type, so the oracle
//     types `t.Days` as `i64` and `a - b` as `TimeSpan` with no run-time tag;
//   * it adds NO PASS -- the instance side rides teko_typeof.tk's existing
//     deferred-member resolution, the operator side teko_ops.tk's existing pass;
//   * it adds NO INTRINSIC -- every symbol is a teko function with a body;
//   * it adds NO MESSAGE where one exists -- "unknown member of", "is static;
//     reach it through its type", "wrong number of arguments for" are the
//     wordings teko_expr.tk and teko_access.tk already emit for a declared type.

// teko_ops.tk is included AFTER this file (it is the pass that reads the
// operator rows below), so the two helpers this file borrows from it -- the
// spelling of an operator token and the "side is not known" wording -- are
// forward-declared here, the same way teko_typeof.tk forward-declares
// `tk_args`. The in-place replacement hooks.md § pass() demands is
// `tk_node_replace` (teko_struct.tk), which every module already sees.
uptr tk_op_spell(i64 tok);
uptr tk_op_side_msg(uptr side, uptr sp);

#define TK_MAXPRIMT 16                // primitive types carrying a member table (D81: 8 -> 16,
                                       // N6a's `i128` and `u128` took 6 to 8, the old table exactly full)
#define TK_MAXPRIMM 192               // member rows, over every primitive (D79: 160 -> 192,
                                       // C5's nineteen `decimal` rows take 141 to 160,
                                       // which is the old table exactly full;
                                       // D85: still 192, N6b-3's eighteen wide-integer
                                       // member/static rows took 160 to 178)
#define TK_MAXPRIMO 128               // operator rows, over every primitive (D76: 48 -> 64,
                                       // N5's nine `DateTimeOffset` rows took it past 48;
                                       // D77: 64 -> 80, C4's twelve `decimal` rows took 50 to 62;
                                       // D81: 80 -> 128, N6a's twenty-two wide-integer rows took 62 to 84;
                                       // D83: still 128, N6b-1's fourteen wide-integer rows took 84 to 98)
#define TK_MAXPRIMC 4096              // casts over a primitive the COMPILER wrote

// what a row is reached as, and therefore what the site may write after it
#define TK_PMSVAL 0                   // Type.Name           a static value, no ()
#define TK_PMSFUN 1                   // Type.Name(args)     a static call
#define TK_PMPROP 2                   // x.Name              an instance property, no ()
#define TK_PMFUN  3                   // x.Name(args)        an instance method
#define TK_PMCTOR 4                   // new Type(arg)       the value constructor
// ...and the fifth, which is a member the type HAS and this version does not
// teach: a row is what makes the site say so by name instead of reading as
// an unknown member. `Guid.NewGuid` was the last row on this kind, moved off
// it by N9 (D91) exactly as `DateTime.Now`/`UtcNow`/`Today` and
// `DateTimeOffset.Now`/`UtcNow` moved off it by C6 (D90) -- both needed one
// host `extern` teko writes itself, never an `mc` ask. No row uses this kind
// today; the mechanism stays for the next member in the same shape.
#define TK_PMSOON 5                   // Type.Name           named, refused by name

// ---- the primitives themselves ----
i64  pt_ty[TK_MAXPRIMT];
uptr pt_name[TK_MAXPRIMT];
uptr pt_inc[TK_MAXPRIMT];             // the include its lowering symbols live in
// The two CLAUSES the cast refusal is spelled with, one pair per primitive:
// what reads the value out, and what builds one. Each carries its VERB as well
// as its spelling, because the pair is not the same sentence for every type --
// a `TimeSpan` is read by `.Ticks` and built by `new TimeSpan(...)`, while a
// `Guid` is WRITTEN by `.ToString()` and READ back by `Guid.Parse(s)`
// (docs/specs/guid.md § 2, D75). Neither is one word for every primitive,
// because a message naming a member the type does not have would be wrong --
// a `DateOnly` is read by `.DayNumber` and has no `.Ticks` at all (N4a).
uptr pt_read[TK_MAXPRIMT];            // "`.Ticks` reads it"
uptr pt_build[TK_MAXPRIMT];           // "`new TimeSpan(...)` builds it"
// D76: the spelling of the type's own ZERO, for `new T()` on a WIDE type --
// `tk_prim_new`'s empty-argument branch writes `tk_cast(ty, tk_int(0))`, which
// `tw_cast` (teko_wide.tk) `die`s on for any sixteen-byte destination, so a
// wide primitive answers with a NAMED zero instead: `decimal`'s `0m`,
// `Guid.Empty`, `DateTimeOffset.MinValue`. Unused (0) for a primitive `tk_wide_is`
// never answers 1 for -- `new TimeSpan()` still IS the identity cast to zero.
uptr pt_zero[TK_MAXPRIMT];            // "0m" / "Guid.Empty" / "DateTimeOffset.MinValue"
i64  tk_nprimt = 0;

i64  pt_ty_at(i64 i)   { return ld64(pt_ty + i * 8); }
uptr pt_name_at(i64 i) { return ld64(pt_name + i * 8); }
uptr pt_inc_at(i64 i)  { return ld64(pt_inc + i * 8); }
uptr pt_read_at(i64 i) { return ld64(pt_read + i * 8); }
uptr pt_build_at(i64 i) { return ld64(pt_build + i * 8); }
uptr pt_zero_at(i64 i) { return ld64(pt_zero + i * 8); }

// ---- a column that names a type the row cannot see yet ----
// Every column below carries a type ID, written at `teko_init()` time -- and
// one type a row names is declared by the very include its lowering symbols
// live in: `DateTimeKind` is an `enum` inside `lib/time.tk`
// (docs/specs/enum.md § 8, N2c), so its id does not exist until a program
// writes `#include "time.tk"`, long after `tk_time_init()` wrote the rows.
// Such a column carries the NAME instead, encoded as an id BELOW -1
// (`-2 - slot`, so -1 keeps its own meaning of "no type here"), and the id is
// read AT THE SITE, where the enum's own row of teko_struct.tk's type table
// exists. The three accessors below are the only readers, so no caller of
// this file ever sees the encoding.
#define TK_MAXPRIML 4                 // types a row names before they exist

uptr pl_name[TK_MAXPRIML];
i64  tk_npriml = 0;

uptr pl_name_at(i64 i) { return ld64(pl_name + i * 8); }

i64 tk_prim_late(uptr name) {
    i64 i = 0;
    loop {
        if (i >= tk_npriml) break;
        if (str_eq(pl_name_at(i), name)) return 0 - 2 - i;
        i = i + 1;
    }
    if (tk_npriml == TK_MAXPRIML)
        err_at(tk_file, tk_line, "teko: too many late type names over a primitive");
    st64(pl_name + tk_npriml * 8, name);
    tk_npriml = tk_npriml + 1;
    return 0 - 2 - (tk_npriml - 1);
}

// the id a column carries: its own, or the one the named type has NOW. A name
// still undeclared answers -1, which every reader here already takes as
// "nothing known, refuse nothing" -- and a site that needed the type is the
// very site `tk_prim_need_include` refuses for the missing include.
i64 tk_prim_ty(i64 col) {
    if (col >= 0 - 1) return col;
    i64 si = tk_struct_find_exact(pl_name_at(0 - 2 - col));
    if (si < 0) return 0 - 1;
    return sr_ty_at(si);
}

// ---- the member rows ----
// A row's parameter list is a COUNT and a HEAD into the position pool below:
// one column per POSITION, since `new DateTime(ticks, kind)` takes an `i64`
// and a `DateTimeKind` and no single type spells the pair (D41 named this the
// day it would come, and N2c is that day). Every other row this mechanism
// carries still takes its arguments in one type -- `new DateTime(y, m, d)` is
// three integers, `TimeSpan.FromHours(x)` one float -- and `tk_prim_membern`
// writes those positions for it.
//
// Rows of ONE name and DIFFERENT counts are the overload set of that name:
// `new DateTime(ticks)`, `new DateTime(y, m, d)` and `new DateTime(y, m, d, h,
// mi, s)` are three rows, and the site picks by the number of arguments
// written (`tk_prim_pick`).
#define TK_MAXPRIMP 128               // parameter positions, over every row

i64  ppos_ty[TK_MAXPRIMP];
i64  tk_nprimp = 0;

i64  ppos_ty_at(i64 i) { return tk_prim_ty(ld64(ppos_ty + i * 8)); }

i64 tk_prim_pos(i64 ty) {
    if (tk_nprimp == TK_MAXPRIMP)
        err_at(tk_file, tk_line, "teko: too many primitive parameter positions");
    st64(ppos_ty + tk_nprimp * 8, ty);
    tk_nprimp = tk_nprimp + 1;
    return tk_nprimp - 1;
}

i64  pmr_ty[TK_MAXPRIMM];
uptr pmr_name[TK_MAXPRIMM];
i64  pmr_kind[TK_MAXPRIMM];
i64  pmr_np[TK_MAXPRIMM];              // how many arguments the row takes
i64  pmr_pp[TK_MAXPRIMM];              // its FIRST position in the pool, or -1 for none
uptr pmr_sym[TK_MAXPRIMM];             // the lib function the row lowers to
i64  pmr_ret[TK_MAXPRIMM];
i64  tk_nprimm = 0;

i64  pmr_ty_at(i64 i)   { return ld64(pmr_ty + i * 8); }
uptr pmr_name_at(i64 i) { return ld64(pmr_name + i * 8); }
i64  pmr_kind_at(i64 i) { return ld64(pmr_kind + i * 8); }
i64  pmr_np_at(i64 i)   { return ld64(pmr_np + i * 8); }
i64  pmr_pp_at(i64 i)   { return ld64(pmr_pp + i * 8); }
uptr pmr_sym_at(i64 i)  { return ld64(pmr_sym + i * 8); }
i64  pmr_ret_at(i64 i)  { return tk_prim_ty(ld64(pmr_ret + i * 8)); }

// ---- the operator rows ----
i64  po_tok[TK_MAXPRIMO];
i64  po_np[TK_MAXPRIMO];              // 1 unary, 2 binary
i64  po_t0[TK_MAXPRIMO];
i64  po_t1[TK_MAXPRIMO];              // -1 for a unary row
uptr po_sym[TK_MAXPRIMO];
i64  po_ret[TK_MAXPRIMO];
i64  po_swap[TK_MAXPRIMO];            // 1 when the call takes (b, a): `n * t`
i64  tk_nprimo = 0;

i64  po_tok_at(i64 i)  { return ld64(po_tok + i * 8); }
i64  po_np_at(i64 i)   { return ld64(po_np + i * 8); }
i64  po_t0_at(i64 i)   { return ld64(po_t0 + i * 8); }
i64  po_t1_at(i64 i)   { return ld64(po_t1 + i * 8); }
uptr po_sym_at(i64 i)  { return ld64(po_sym + i * 8); }
i64  po_ret_at(i64 i)  { return ld64(po_ret + i * 8); }
i64  po_swap_at(i64 i) { return ld64(po_swap + i * 8); }

// ---- registration, called from the owner module's own `_init()` ----
// `inc` is the include the lowering symbols are written in, named in the
// refusal a program that forgot it gets (§ 9: the include is part of the
// surface).
// `read`/`build` are the two clauses of the cast refusal, spelled exactly as
// it shows them (above). A primitive that teaches neither yet -- `decimal` in
// C3 -- passes 0 for both and gets the shorter wording.
// `zero` is D76's fourth column, `pt_zero` above: the spelling of `new T()`'s
// answer for a WIDE type, unread for one that is not (`tk_wide_is` never
// claims it, so `tk_prim_new` never asks).
void tk_prim_type(i64 ty, uptr name, uptr inc, uptr read, uptr build, uptr zero) {
    if (tk_nprimt == TK_MAXPRIMT) err_at(tk_file, tk_line, "teko: too many primitive types");
    st64(pt_ty + tk_nprimt * 8, ty);
    st64(pt_name + tk_nprimt * 8, name);
    st64(pt_inc + tk_nprimt * 8, inc);
    st64(pt_read + tk_nprimt * 8, read);
    st64(pt_build + tk_nprimt * 8, build);
    st64(pt_zero + tk_nprimt * 8, zero);
    tk_nprimt = tk_nprimt + 1;
}

// `np` arguments whose positions are already in the pool, starting at `pp`.
void tk_prim_memberp(i64 ty, uptr name, i64 kind, i64 np, i64 pp, uptr sym, i64 ret) {
    if (tk_nprimm == TK_MAXPRIMM) err_at(tk_file, tk_line, "teko: too many primitive members");
    st64(pmr_ty + tk_nprimm * 8, ty);
    st64(pmr_name + tk_nprimm * 8, name);
    st64(pmr_kind + tk_nprimm * 8, kind);
    st64(pmr_np + tk_nprimm * 8, np);
    st64(pmr_pp + tk_nprimm * 8, pp);
    st64(pmr_sym + tk_nprimm * 8, sym);
    st64(pmr_ret + tk_nprimm * 8, ret);
    tk_nprimm = tk_nprimm + 1;
}

// `np` arguments, each of type `p0` (-1 and 0 for a row that takes none).
void tk_prim_membern(i64 ty, uptr name, i64 kind, i64 np, i64 p0, uptr sym, i64 ret) {
    i64 pp = 0 - 1;
    i64 i = 0;
    loop {
        if (i >= np) break;
        i64 s = tk_prim_pos(p0);
        if (i == 0) pp = s;
        i = i + 1;
    }
    tk_prim_memberp(ty, name, kind, np, pp, sym, ret);
}

// two arguments that DIFFER in type: `new DateTime(ticks, kind)`, the one C#
// shape the single column could not spell.
void tk_prim_member2(i64 ty, uptr name, i64 kind, i64 t0, i64 t1, uptr sym, i64 ret) {
    i64 pp = tk_prim_pos(t0);
    tk_prim_pos(t1);
    tk_prim_memberp(ty, name, kind, 2, pp, sym, ret);
}

// the shape most rows have: no argument (`p0` exactly -1) or one -- and a
// late type name (`tk_prim_late`, an id below -1) is one argument too.
void tk_prim_member(i64 ty, uptr name, i64 kind, i64 p0, uptr sym, i64 ret) {
    i64 np = 0;
    if (p0 != 0 - 1) np = 1;
    tk_prim_membern(ty, name, kind, np, p0, sym, ret);
}

void tk_prim_op(i64 tok, i64 np, i64 t0, i64 t1, uptr sym, i64 ret, i64 swap) {
    if (tk_nprimo == TK_MAXPRIMO) err_at(tk_file, tk_line, "teko: too many primitive operators");
    st64(po_tok + tk_nprimo * 8, tok);
    st64(po_np + tk_nprimo * 8, np);
    st64(po_t0 + tk_nprimo * 8, t0);
    st64(po_t1 + tk_nprimo * 8, t1);
    st64(po_sym + tk_nprimo * 8, sym);
    st64(po_ret + tk_nprimo * 8, ret);
    st64(po_swap + tk_nprimo * 8, swap);
    tk_nprimo = tk_nprimo + 1;
}

// ---- the lookups ----
// 1 when `ty` is a primitive this project registered members for. Read by
// `tk_check_scalar_compat` (teko_typeof.tk) for the conversion clause and by
// teko_ops.tk for the operator claim, both of which need the QUESTION and not
// the row.
i64 tk_prim_is(i64 ty) {
    i64 i = 0;
    loop {
        if (i >= tk_nprimt) break;
        if (pt_ty_at(i) == ty) return 1;
        i = i + 1;
    }
    return 0;
}

i64 tk_prim_slot(i64 ty) {
    i64 i = 0;
    loop {
        if (i >= tk_nprimt) break;
        if (pt_ty_at(i) == ty) return i;
        i = i + 1;
    }
    return 0 - 1;
}

i64 tk_prim_by_name(uptr nm) {
    i64 i = 0;
    loop {
        if (i >= tk_nprimt) break;
        if (str_eq(pt_name_at(i), nm)) return pt_ty_at(i);
        i = i + 1;
    }
    return 0 - 1;
}

// the FIRST row of a name: whether the type has the member at all, and what
// kind of member it is -- every row of one name shares its kind and its result
// type, and differs only in how many arguments it takes.
i64 tk_prim_find(i64 ty, uptr m) {
    i64 i = 0;
    loop {
        if (i >= tk_nprimm) break;
        if (pmr_ty_at(i) == ty && str_eq(pmr_name_at(i), m)) return i;
        i = i + 1;
    }
    return 0 - 1;
}

// ...and the row of that name the SITE lands on, by the number of arguments it
// wrote. This is the whole of overloading a primitive member has: the counts
// are distinct inside one name, so no two rows ever match one site.
i64 tk_prim_find_na(i64 ty, uptr m, i64 na) {
    i64 i = 0;
    loop {
        if (i >= tk_nprimm) break;
        if (pmr_ty_at(i) == ty && pmr_np_at(i) == na && str_eq(pmr_name_at(i), m)) return i;
        i = i + 1;
    }
    return 0 - 1;
}

i64 tk_prim_pick(i64 ty, uptr m, i64 na, i64 line, uptr fl) {
    i64 ri = tk_prim_find_na(ty, m, na);
    if (ri < 0) err_at(fl, line, tk_join("teko: wrong number of arguments for ", m));
    return ri;
}

// 1 when an operand of type `t` lands on a row column declared `pt`. A column
// naming a PRIMITIVE takes that primitive and nothing else -- which is the
// whole of `docs/specs/datetime.md` § 5 on the operator side. A column naming
// `i64` takes any integer teko calls one (`tk_is_int_ty`, D38's own positive
// list, so `i8`/`i16`/`i32`/`u8`... all reach `t * n`), and one naming a float
// takes a float or an integer, which `tk_num_widen` then converts at the site.
i64 tk_prim_slot_fits(i64 pt, i64 t) {
    if (pt == t) return 1;
    if (t < 0) return 0;
    if (tk_prim_is(pt) || tk_prim_is(t)) return 0;
    if (pt == TY_I64) return tk_is_int_ty(t);
    if (type_kind(pt) == TK_FLOAT) return tk_is_int_ty(t) || type_kind(t) == TK_FLOAT;
    return 0;
}

i64 tk_prim_op_find(i64 tok, i64 np, i64 ta, i64 tb) {
    i64 i = 0;
    loop {
        if (i >= tk_nprimo) break;
        if (po_tok_at(i) == tok && po_np_at(i) == np && tk_prim_slot_fits(po_t0_at(i), ta)) {
            if (np == 1 || tk_prim_slot_fits(po_t1_at(i), tb)) return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// the type a binary over a primitive ANSWERS with, or -1 when no row takes
// those operands. The oracle (`tk_ty_binary`, teko_typeof.tk) asks it because
// the core's own rule -- a binary is typed from its LEFT operand -- is wrong
// for a reversed row: `3 * hour` answers a `TimeSpan`, not an `i64`, and a
// `.Ticks` on it is resolved by the oracle BEFORE teko_ops.tk's pass has
// rewritten the node into the call whose declared return type would say so.
i64 tk_prim_op_ret(i64 tok, i64 ta, i64 tb) {
    i64 ri = tk_prim_op_find(tok, 2, ta, tb);
    if (ri < 0) return 0 - 1;
    return po_ret_at(ri);
}

// ---- the two casts the lowering is written with (§ 2) ----
// ...and the ONE list that tells them from the same two casts written by hand.
// `(i64) dt` and `(DateTime) n` are refused in the surface (§ 3), because the
// raw eight bytes of a date are NOT its ticks -- the `Kind` sits above them --
// so a hand-written cast is the one spelling that answers a wrong number
// instead of refusing. The compiler writes both casts all the time, though, so
// the refusal needs to tell one from the other, and the node itself cannot say:
// `--dump-ast` prints every field a node has, so a mark on the node would move
// the dump of code that did not change. The compiler's own casts are therefore
// remembered by node index, here, and everything else that casts a primitive is
// the source's.
i64  pc_node[TK_MAXPRIMC];
i64  tk_nprimc = 0;

void tk_prim_own_cast(i64 n) {
    if (tk_nprimc == TK_MAXPRIMC) err_at(tk_file, tk_line, "teko: too many casts over a primitive in one unit");
    st64(pc_node + tk_nprimc * 8, n);
    tk_nprimc = tk_nprimc + 1;
}

i64 tk_prim_own_cast_is(i64 n) {
    i64 i = tk_nprimc - 1;
    loop {
        if (i < 0) break;
        if (ld64(pc_node + i * 8) == n) return 1;
        i = i - 1;
    }
    return 0;
}

// A node this project REPLACES IN PLACE keeps the placeholder's index and not
// the built node's (`node_assign`, mc/src/ast.mc: the fields are copied over
// the node the tree already points at), so a cast that travels that road
// arrives under another number. The two passes that replace a lowering's own
// result -- the deferred `.` (teko_typeof.tk) and the operator rewrite
// (teko_ops.tk) -- say so here, and the cast stays the compiler's.
void tk_prim_own_cast_moved(i64 from, i64 to) {
    if (tk_prim_own_cast_is(from)) tk_prim_own_cast(to);
}

// the raw bytes, for a call into `lib/`: `(i64) t`. Not a licence the SURFACE
// has: it is the compiler's own cast, the same way `tk_num_widen` is.
//
// It is not an INSTRUCTION where the primitive is eight bytes wide --
// `walk_narrow` (mc/src/gen_walk.mc) answers 0 for a width-8 `TK_SINT`, which
// the P0 probe measured -- and IS one where it is narrower: a `DateOnly` is
// FOUR bytes (N4a), so this cast is the sign extension of them and
// `tk_prim_ret` below the narrowing store back. Both are what the core already
// writes for an `enum : i32` (`DateTimeKind`), through every slot a value
// travels -- a local, a parameter, a return, a field, a global, an array
// element and a closure capture (D38 sign-extends every narrow indirect load;
// `tests/surface_dateonly.tk` walks that whole set).
i64 tk_prim_raw(i64 e) {
    i64 n = tk_cast(TY_I64, e);
    tk_prim_own_cast(n);
    return n;
}

// ...and the way back, `(TimeSpan) r`, for a row whose result is the primitive
// itself. A row whose result is `i64` or `f64` needs neither: the call's own
// declared return type is what every oracle already reads. The other direction
// -- a cast TO a primitive -- is remembered by `tk_cast` itself (teko_array.tk),
// so every module that writes one is covered by construction.
//
// An ENUM result takes the same cast, and for the same reason: `d.Kind` lowers
// to `tk_dt_kind((i64) d)`, whose declared return type is the enum's UNDERLYING
// integer, and without the cast every oracle would read the site as that
// integer -- `i64 n = d.Kind;` would convert where docs/specs/enum.md § 5
// refuses it. The plain machine cast is what teko_null.tk's own payload read
// already writes for an enum (`tk_nl_payload`), and it is not an instruction:
// the value is the underlying integer at run time, no box and no tag.
i64 tk_prim_ret(i64 ret, i64 call) {
    // D75: no cast can name a sixteen-byte type. The lowering symbol of a wide
    // row DECLARES the wide type itself (`Guid tk_guid_parse(str s)`,
    // lib/guid.tk), so the call's own declared return type is already the
    // answer every oracle reads -- and a cast here would reach `tw_cast`'s own
    // guard (teko_wide.tk) instead of moving sixteen bytes.
    if (tk_wide_is(ret)) return call;
    if (tk_prim_is(ret)) return tk_cast(ret, call);
    if (tk_is_enum(tk_struct_by_ty(ret))) return tk_cast(ret, call);
    return call;
}

// ---- the refusals ----
uptr tk_prim_name(i64 ty) { return type_name(ty); }

void tk_prim_no_member(i64 ty, uptr m, i64 line, uptr fl) {
    err_at2(fl, line, tk_join("teko: unknown member of ", tk_prim_name(ty)), m);
}

void tk_prim_no_static(i64 ty, uptr m, i64 line, uptr fl) {
    err_at2(fl, line, tk_join("teko: unknown static member of ", tk_prim_name(ty)), m);
}

void tk_prim_is_static(i64 ty, uptr m, i64 line, uptr fl) {
    err_at(fl, line, tk_join3("teko: ", tk_join3(tk_prim_name(ty), ".", m),
                              " is static; reach it through its type"));
}

void tk_prim_is_instance(i64 ty, uptr m, i64 line, uptr fl) {
    err_at(fl, line, tk_join3("teko: ", tk_join3(tk_prim_name(ty), ".", m),
                              " is an instance member; reach it through an object"));
}

// a TK_PMSOON row: the type HAS the member, C# spells it, and this version
// does not teach it -- the row is what makes the site say so by name instead
// of reading as a member nobody ever heard of. `Guid.NewGuid` was the last
// row of this kind, moved off it by N9 (D91).
void tk_prim_not_yet(i64 ty, uptr m, i64 line, uptr fl) {
    err_at(fl, line, tk_join3("teko: ", tk_join3(tk_prim_name(ty), ".", m),
                              " is not taught yet"));
}

// a member of a primitive is a value read out of the eight bytes, never a slot:
// there is nothing to assign to
void tk_prim_readonly(i64 ty, uptr m, i64 line, uptr fl) {
    err_at2(fl, line, tk_join3("teko: a member of ", tk_prim_name(ty), " is read-only"), m);
}

// D76: the include COLUMN is bare everywhere (`pt_inc`, every `tk_prim_type`
// call) -- `teko_time.tk` used to bake its own quotes in
// (`tk_time_include() { return "\"time.tk\""; }`) while `teko_guid.tk` passed
// the name bare, so a wide type registered under the first convention and
// read by `teko_wide.tk`'s own quoting (below) would have printed
// `include ""time.tk""`. One quoting point fixes both directions at once:
// every consumer of the column asks THIS for the quoted form, and no column
// carries a quote of its own.
uptr tk_prim_inc_q(uptr inc) { return tk_join3("\"", inc, "\""); }

// § 9: the include is part of the surface. Every row names a symbol that lives
// in the owner module's own include, so a program that named the type without
// it is told which file it forgot instead of reaching the core's own
// `call to unknown function` two phases later.
void tk_prim_need_include_of(uptr word, uptr inc, uptr sym, i64 line, uptr fl) {
    if (decl_find(sym) >= 0) return;
    err_at(fl, line, tk_join3(tk_join3("teko: ", word, " needs #include "),
                              tk_prim_inc_q(inc), " before it is used"));
}

// the include a primitive's lowering symbols live in, by type -- read by
// `tw_ret` (teko_wide.tk) for the return buffer a sixteen-byte value travels
// through, which is declared in that very file (D75). "" for a type no row of
// this table owns, which no caller has: every wide type registers here.
uptr tk_prim_inc_of(i64 ty) {
    i64 i = tk_prim_slot(ty);
    if (i < 0) return "";
    return pt_inc_at(i);
}

void tk_prim_need_include(i64 ty, uptr sym, i64 line, uptr fl) {
    i64 pi = tk_prim_slot(ty);
    tk_prim_need_include_of(tk_prim_name(ty), pt_inc_at(pi), sym, line, fl);
}

// ---- one argument, checked and converted ----
// `atpass` picks the oracle: the parser's own (`tk_pty_of`, teko_struct.tk) at
// a site the parser resolves, and the pass's (`tk_ty_of`, teko_typeof.tk) at a
// deferred one. Both answer -1 for what they cannot see, which
// `tk_check_scalar_compat` reads as "refuse nothing" -- and an argument of the
// wrong type the parser could not see is still caught: by `tk_rc_call_args`
// (teko_rc.tk) against the very declaration this row names when it crosses
// under its own type, and by the deferred check below when the column's own
// conversion is a cast that would hide it from that one.
i64 tk_prim_ty_of(i64 n, i64 atpass) {
    if (atpass) return tk_ty_of(n);
    return tk_pty_of(n);
}

// the value as the lowered call takes it: the raw eight bytes for a primitive
// column, and C# 10.2.3's own widening (`tk_num_widen`, teko_typeof.tk) for an
// integer landing on a float one -- `TimeSpan.FromHours(2)` is `FromHours(2.0)`.
//
// An ENUM column is unwrapped the same way a captured enum is (teko_deleg.tk's
// own `tk_cap_val`): the lowering symbol takes an `i64` --
// `tk_dt_from_ticks_kind(i64, i64)`, lib/time.tk, which never names the enum --
// so the value crosses as its underlying integer, and it is the CHECK above
// (`tk_check_scalar_compat`, docs/specs/enum.md § 5) that already refused
// everything but the enum itself in this position.
i64 tk_prim_conv(i64 pty, i64 e, i64 ety) {
    // D75, the argument half of `tk_prim_ret` above: a wide column takes the
    // VALUE, under its own type, because the lowering symbol declares that type
    // (`i64 tk_guid_cmp(Guid a, Guid b)`) and the sixteen bytes travel by
    // address on every one of the three ABIs (teko_wide.tk's own `tw_args`).
    // `(i64) g` would be `tw_cast` on a sixteen-byte value.
    if (tk_wide_is(pty)) return e;
    if (tk_prim_is(pty)) return tk_prim_raw(e);
    if (tk_is_enum(tk_struct_by_ty(pty))) return tk_cast(TY_I64, e);
    return tk_num_widen(pty, ety, e);
}

// ---- the column whose conversion is a CAST, and the check it cannot skip ----
// `tk_prim_conv` writes a cast for exactly two columns -- a primitive one
// (`(i64) t`) and an enum one (`(i64) k`) -- and that cast is what the lowering
// symbol declares, so the argument reaches `tk_rc_call_args` (teko_rc.tk) as
// the `i64` the declaration asks for and that late check has nothing left to
// say. Every OTHER column crosses under the argument's own type and is judged
// there: `new DateTime(k, DateTimeKind.Utc)` on a `DateTimeKind k` is refused
// today with `teko: a value of type DateTimeKind does not convert to i64`,
// measured, with no line here.
//
// So when the PARSER cannot type the argument (`tk_pty_of` answers -1 for a
// parameter, for an array element, for anything only the pass resolves) and
// the column is one of those two, the check is deferred rather than skipped.
// Without it `new DateTime(1, k)` on an `i64 k` parameter compiled and reached
// the run-time kind guard (`teko: a date kind is out of range`, exit 70) where
// docs/specs/enum.md § 5 refuses it at compile time.
//
// The CONVERSION is not deferred, and needs no deferral: on both cast arms
// `tk_prim_conv` never reads `ety` at all, so the node it wrote at parse time
// is the one it would write knowing the type -- and a check that PASSES proves
// the type was the column's own. Nothing moves in the tree, which is why every
// `--dump-ast` of a program that compiles is byte-identical.
i64 tk_prim_conv_casts(i64 pty) {
    if (pty < 0) return 0;
    if (tk_prim_is(pty)) return 1;
    return tk_is_enum(tk_struct_by_ty(pty));
}

// ---- the OTHER column the parse-time answer cannot settle: the float one ----
// A cast column hides a wrong argument from the late check; a FLOAT column
// does worse, because its conversion is DECIDED by the argument's type
// (`tk_num_widen` widens an integer and leaves everything else alone) -- so an
// answer that is a guess writes the wrong node and then launders it.
// Measured on this branch, with an `i64 pick(i64)` declared ahead of a
// `DateTimeKind pick(i64, i64)`: `TimeSpan.FromHours(pick(1, 2))` read the
// FIRST declaration, wrote `(f64) pick(1, 2)` over a call that returns an
// enum, and `tk_rc_call_args` (teko_rc.tk) then saw an `f64` where the column
// asks for one and had nothing to say. The mirror pair, `f64 pick(i64)` ahead
// of an `i64 pick(i64, i64)`, wrote NO cast over a call that returns an
// integer and fed the raw eight bytes to a float parameter.
//
// So the conversion is deferred with the check: `tk_prim_arg` writes nothing
// for a call on this column and `tk_prim_arg_do` wraps the node once the
// symbol is picked. Only a CALL is deferred here, because it is the only
// argument whose own type a later pass CHANGES: everything else crosses under
// the type it has and `tk_rc_call_args` (teko_rc.tk, the last pass of all)
// both judges it and writes the widening against the very declaration the row
// names -- `TimeSpan.FromHours(x)` on an `i64` parameter is `FromHours((f64) x)`
// with no entry in this table (Copilot on #697, fourth pass).
i64 tk_prim_defers(i64 pty, i64 a) {
    if (tk_prim_conv_casts(pty)) return 1;
    if (nd_kind(a) != N_CALL) return 0;
    if (pty < 0) return 0;
    return type_kind(pty) == TK_FLOAT;
}

#define TK_MAXPARG 128                // such arguments waiting for the pass

i64  pa_node[TK_MAXPARG];             // the argument, under the cast the column wrote
i64  pa_ty[TK_MAXPARG];               // the type its POSITION asks for
i64  pa_line[TK_MAXPARG];
uptr pa_file[TK_MAXPARG];
i64  pa_done[TK_MAXPARG];
i64  tk_nparg = 0;

i64  pa_node_at(i64 i) { return ld64(pa_node + i * 8); }
i64  pa_ty_at(i64 i)   { return ld64(pa_ty + i * 8); }
i64  pa_line_at(i64 i) { return ld64(pa_line + i * 8); }
uptr pa_file_at(i64 i) { return ld64(pa_file + i * 8); }
i64  pa_done_at(i64 i) { return ld64(pa_done + i * 8); }

void tk_prim_arg_defer(i64 pty, i64 a, i64 line, uptr fl) {
    if (tk_nparg == TK_MAXPARG)
        err_at(fl, line, "teko: too many primitive arguments of unknown type");
    st64(pa_node + tk_nparg * 8, a);
    st64(pa_ty + tk_nparg * 8, pty);
    st64(pa_line + tk_nparg * 8, line);
    st64(pa_file + tk_nparg * 8, fl);
    st64(pa_done + tk_nparg * 8, 0);
    tk_nparg = tk_nparg + 1;
}

// ...and an argument NOTHING types, even here: it is not guessed at either.
// The rule is `tk_prim_binary`'s own, one position over -- an operand the
// oracle could not type is refused rather than taken raw, because a cast
// column is exactly where the eight bytes would cross unread. It is what a
// local array's element still is (`a[0]` lowers to `ld64(a + i * 8)` at parse
// time and neither oracle types that call), so `new DateTime(1, a[0])` on an
// `i64 a[2]` is refused here instead of reaching the run-time kind guard.
// ---- the conversion a deferred argument still owes, written IN PLACE ----
// `tk_num_widen` hands its cast BACK, because its callers hold the slot the
// value sits in. This one does not: the argument was spliced into the lowered
// call's own list at parse time and nothing here knows which link it is. So
// the wrap is done the way teko_rc.tk already rewrites a statement -- the node
// keeps its identity and BECOMES the cast, while a fresh node takes over
// everything it was. `nd_next` is the one field that stays behind, because the
// sibling link belongs to the SLOT and not to the value, which is the very
// reason `tk_num_widen` cuts it on the node it wraps.
i64 tk_nd_moved(i64 n) {
    i64 m = tk_nd(nd_kind(n));
    // the type table's own row goes with the value (teko_struct.tk's
    // `tk_xt_move`): what `n` is about to become is not what it was typed as.
    tk_xt_move(n, m);
    set_nd_op(m, nd_op(n));
    set_nd_type(m, nd_type(n));
    set_nd_val(m, nd_val(n));
    set_nd_name(m, nd_name(n));
    set_nd_a(m, nd_a(n));
    set_nd_b(m, nd_b(n));
    set_nd_c(m, nd_c(n));
    set_nd_d(m, nd_d(n));
    set_nd_sect(m, nd_sect(n));
    set_nd_line(m, nd_line(n));
    set_nd_file(m, nd_file(n));
    return m;
}

// the same rule `tk_num_widen` writes (`tk_num_widens`, teko_typeof.tk), asked
// once the type is no longer a guess. Every other column wrote its node at
// parse time and reads nothing here.
//
// D79: the rule is one and the NODE is two. A widening into a float column is
// a cast; a widening into a WIDE one is the CALL the conversion table names
// (`tk_dec_from_i64`), because `MTASK_CAST` on a sixteen-byte value has no
// meaning at all -- `tw_cast` (teko_wide.tk) `die`s on one. Measured on this
// branch with the first row whose ARGUMENT is wide (`decimal.Round(d, n)`,
// C5): every integer argument the PARSER could not type -- a local, a
// parameter, a `u8`, an array element, a call -- reached this function and
// left it as `(decimal) n`, and the build died in codegen with
// `teko: a cast is not defined on a sixteen-byte value yet`. A literal never
// did, because the parser types it and `tk_rc_call_args` (teko_rc.tk) writes
// the conversion against the declaration instead.
//
// `tk_num_widen` already answers both shapes -- it is the one function D77
// gave the wide arm to -- so the node it builds REPLACES this one in place
// (`tk_node_replace`, teko_struct.tk: the argument keeps its identity and its
// sibling link, which is what a node already spliced into a call's list needs).
void tk_prim_arg_widen(i64 pty, i64 n, i64 aty) {
    if (!tk_num_widens(pty, aty)) return;
    i64 inner = tk_nd_moved(n);
    if (tk_wide_is(pty)) {
        tk_node_replace(n, tk_num_widen(pty, aty, inner));
        tk_xt_put(n, tk_struct_by_ty(pty), pty, 0, TK_OWNED);
        return;
    }
    set_nd_kind(n, N_CAST);
    set_nd_op(n, 0);
    set_nd_type(n, pty);
    set_nd_val(n, 0);
    set_nd_name(n, 0);
    set_nd_a(n, inner);
    set_nd_b(n, 0);
    set_nd_c(n, 0);
    set_nd_d(n, 0);
}

void tk_prim_arg_do(i64 i) {
    if (pa_done_at(i)) return;
    st64(pa_done + i * 8, 1);
    i64 n = pa_node_at(i);
    i64 aty = tk_ty_of(n);
    if (aty < 0)
        err_at(pa_file_at(i), pa_line_at(i), "teko: the type of this argument is not known here");
    tk_check_scalar_compat(pa_ty_at(i), aty, n, pa_line_at(i), pa_file_at(i));
    tk_prim_arg_widen(pa_ty_at(i), n, aty);
}

// ---- ONE point of judgement: a walk of its own, at the end of the pick ----
// asked once per node of every body, from `tk_prim_arg_judge` below, and that
// is the only place a deferred argument is ever judged. The point has to
// answer both halves of what the type of an argument depends on, and no
// earlier one does:
//
//   - the SCOPE it was written under, because a name (`k`, a parameter) has
//     no type anywhere else -- so the walk is `tk_ty_pass_walk`'s, which
//     enters each function and pushes its parameters and its locals;
//   - every overload PICK already COMMITTED: since D49 the pass-time oracle
//     asks the overload table for a call's type, but the judgement wants the
//     site rewritten to its final symbol (what `tk_rc_call_args` will check
//     against), so the walk runs after `tk_over_pass`'s own walk has written
//     every pick, whatever depth the call sits at under the argument.
//
// Riding teko_ops.tk's walk was the third pass's answer to the first half and
// missed the second, so the arguments that are CALLS were left to a sweep at
// the end of `tk_over_pass` with NO scope entered -- and that sweep then took
// everything the walk had not reached, which is not only the calls:
// `tk_ops_visit` returns early for an N_BINARY and for an N_UNARY, so
// `new DateTime(1, k | DateTimeKind.Utc)` on a `DateTimeKind k` parameter --
// legal, since a bitwise operator over an enum answers the enum (D39) -- was
// refused with `teko: the type of this argument is not known here`, measured
// on `d8d00572` (Copilot on #697, fifth pass). Moving the hook ahead of those
// two returns would have judged the node before the pick under it; one walk,
// after everything, is the rule that has both halves at once.
void tk_prim_arg_pend(i64 n) {
    i64 i = tk_nparg - 1;
    loop {
        if (i < 0) break;
        if (pa_node_at(i) == n) tk_prim_arg_do(i);
        i = i - 1;
    }
}

// A unit that deferred nothing walks nothing: the table is this module's own
// memory and an empty one has no node to visit. Called at the end of
// `tk_over_pass` (teko_over.tk), and it adds no pass of its own.
//
// A body is where every deferred argument is, and the reason is what a global
// initializer may be: mc requires it to be CONSTANT (`global initializer must
// be constant`), so `DateTime g = new DateTime(1, gk);` never reaches a check
// of this file at all, and the arguments that do survive there are the folded
// ones the parser types by itself -- measured over `1 + 2`, `(i64) 3` and a
// `const` name, none of which defers.
void tk_prim_arg_judge(i64 root) {
    if (tk_nparg == 0) return;
    tk_ty_pass_walk(root, &tk_prim_arg_pend);
}

// A CALL is the one argument whose type is NOT decided here, and the reason
// is the overload pick: this runs at parse time, when the overload table does
// not exist yet (a later declaration in the file may still add a signature),
// so the parser's oracle can only answer `decl_ret(decl_find(name))`, the
// FIRST declaration of a name that may carry several. Since D49 the pass-time
// oracle asks the table instead (teko_typeof.tk), but here the answer would
// still be a guess, and a guess was wrong both ways, measured on this branch: a
// `DateTimeKind pick(i64)` declared ahead of an `i64 pick(i64, i64)` let
// `new DateTime(1, pick(1, 2))` cross under the column's own cast (the
// laundering this table exists to stop), and the same pair in the other order
// refused `new DateTime(1, pick(1, 2))` for a conversion the chosen overload
// never asks for. So NOTHING is decided on a guess -- `cty` is -1 for a call
// and it is what both the check and the conversion are given:
//
//   - on a CAST column and on a FLOAT one the argument is deferred, judged and
//     converted by `tk_prim_arg_judge` once the symbol is written -- where
//     `decl_find` is exact, because the name is unique by then;
//   - on every OTHER column the conversion is the identity whatever the type
//     is, so the argument crosses under its OWN and `tk_rc_call_args`
//     (teko_rc.tk, the last pass of all) is the late check that judges it
//     against the very declaration this row names -- the same division of
//     labour D48 wrote down.
//
// A call on a float column is the one node this moves, and it moves it to
// exactly where the literal already put it: `TimeSpan.FromHours(n)` is still
// `FromHours((f64) n)`, written by `tk_prim_arg_widen` instead of at parse
// time, so every `--dump-ast` that compiled before is byte-identical.
i64 tk_prim_arg(i64 pty, i64 a, i64 atpass, i64 line, uptr fl) {
    i64 aty = tk_prim_ty_of(a, atpass);
    i64 cty = aty;
    if (nd_kind(a) == N_CALL) cty = 0 - 1;       // not decided until the pick
    if (cty < 0 && tk_prim_defers(pty, a)) tk_prim_arg_defer(pty, a, line, fl);
    tk_check_scalar_compat(pty, cty, a, line, fl);
    return tk_prim_conv(pty, a, cty);
}

// the argument list of a row, checked and converted position by position. The
// row was already picked BY the number of arguments (`tk_prim_pick`), so the
// list is exactly as long as the row asks for.
//
// Each argument is a LINK of a sibling list and the conversion may wrap it in
// a cast, so the link is read and cut before the position is converted: a
// wrapped node keeps no `nd_next` of its own (`tk_num_widen`'s own rule), and
// the list is rebuilt in order out of what the conversion hands back.
i64 tk_prim_args(i64 ri, i64 args, i64 atpass, i64 line, uptr fl) {
    i64 pp = pmr_pp_at(ri);
    i64 np = pmr_np_at(ri);
    i64 head = 0;
    i64 a = args;
    i64 i = 0;
    loop {
        if (i >= np) break;
        i64 nx = nd_next(a);
        set_nd_next(a, 0);
        head = list_append(head, tk_prim_arg(ppos_ty_at(pp + i), a, atpass, line, fl));
        a = nx;
        i = i + 1;
    }
    return head;
}

// ---- the emission ----
// `recv` is 0 for a static row and the receiver's node for an instance one; the
// receiver is the first argument of the lowered call, exactly as a method's
// mangled `Owner_method` already takes it.
i64 tk_prim_emit(i64 ri, i64 recv, i64 args, i64 atpass, i64 line, uptr fl) {
    i64 ty = pmr_ty_at(ri);
    uptr sym = pmr_sym_at(ri);
    i64 kind = pmr_kind_at(ri);
    i64 a = tk_prim_args(ri, args, atpass, line, fl);
    tk_line = line;
    tk_file = fl;
    // A row with NO SYMBOL is the identity (§ 2): `new TimeSpan(t)` is
    // `(TimeSpan) t` and `t.Ticks` is `(i64) t`, the same eight bytes under the
    // other type, no call and no instruction. The surface may not write either
    // cast by hand and the compiler writes both, exactly as `tk_num_widen` is
    // the compiler's own cast and not a licence to narrow.
    if (sym == 0) {
        // `tk_cast` remembers a cast TO a primitive by itself; this one goes
        // the other way (`t.Ticks` is `(i64) t`), so it is remembered here --
        // the same node a source may not write (§ 3).
        if (kind == TK_PMCTOR) return tk_cast(pmr_ret_at(ri), a);
        i64 idn = tk_cast(pmr_ret_at(ri), recv);
        tk_prim_own_cast(idn);
        return idn;
    }
    tk_prim_need_include(ty, sym, line, fl);
    i64 list = 0;
    // the receiver, by the same rule `tk_prim_conv` states one function up: a
    // WIDE receiver crosses as itself (`g.ToString()` is `tk_guid_tostring(g)`)
    // and an eight-byte one as its raw bytes (`t.Days` is `tk_ts_days((i64) t)`).
    if (recv != 0) {
        if (tk_wide_is(ty)) list = recv;
        else                list = tk_prim_raw(recv);
    }
    // `a` is already a LIST of converted arguments: appending its head links
    // the whole chain behind the receiver, in the order the source wrote it.
    if (a != 0) {
        if (list == 0) list = a;
        else           list = list_append(list, a);
    }
    tk_line = line;
    tk_file = fl;
    return tk_prim_ret(pmr_ret_at(ri), tk_call(sym, list));
}

// ---- `Type.member`, the type word in expression position ----
// The word is registered with `syntax_expr` by the owner module, which is what
// puts this handler ahead of the core's own "a type word is no expression"
// (parse_primary, mc/src/parse.mc) -- measured by the P0 probe.
// `m` is the member name, ALREADY READ: the split is what lets a module that
// owns a primitive hand-parse one of its statics and leave every other one to
// the table -- `Guid.TryParse(s, out g)` takes an `out <name>` no `pmr_*` row
// can spell (teko_guid.tk, after teko_enum.tk's own `TryParse`, D75).
i64 tk_prim_static_m(i64 ty, uptr m, i64 line, uptr fl) {
    i64 ri = tk_prim_find(ty, m);
    if (ri < 0) tk_prim_no_static(ty, m, line, fl);
    i64 kind = pmr_kind_at(ri);
    if (kind == TK_PMSOON) tk_prim_not_yet(ty, m, line, fl);
    if (kind == TK_PMPROP || kind == TK_PMFUN) tk_prim_is_instance(ty, m, line, fl);
    if (kind == TK_PMCTOR) tk_prim_no_static(ty, m, line, fl);
    i64 args = 0;
    i64 na = 0;
    if (kind == TK_PMSFUN) {
        if (p_id() != K_LPAR)
            err_at2(fl, line, "teko: the member is a method; call it with ()", m);
        args = tk_args(&na);
    }
    else if (p_id() == K_LPAR)
        err_at2(fl, line, "teko: the member is a property; it is not called", m);
    return tk_prim_emit(tk_prim_pick(ty, m, na, line, fl), 0, args, 0, line, fl);
}

i64 tk_prim_static(i64 ty, i64 line, uptr fl) {
    if (!p_accept(tk_dot_tok))
        err_at2(fl, line, "teko: a type name reaches its static members", tk_prim_name(ty));
    return tk_prim_static_m(ty, tk_member_name(), line, fl);   // D68
}

i64 tk_prim_expr() {
    i64 line = p_line();
    uptr fl = p_file();
    i64 ty = tk_prim_by_name(p_name());
    p_next();                                    // the type word
    return tk_prim_static(ty, line, fl);
}

// the same word in STATEMENT position: a declaration is the core's own
// `parse_var`, entered with the type word still unread (the shape
// teko_access.tk's `tk_type_stmt` already has), and a static access is the
// ordinary expression the handler above builds.
i64 tk_prim_stmt() {
    i64 line = p_line();
    uptr fl = p_file();
    if (!tk_dot_follows()) return parse_var(line, fl, tk_prim_by_name(p_name()));
    i64 e = parse_expr(0);
    p_expect(K_SEMI, "expected ; after the static member");
    tk_line = line;
    tk_file = fl;
    return tk_stmt(e);
}

// ---- `new Type(arg)`: C#'s value-type constructor ----
// Reached from teko_expr.tk's `tk_new` with the type word already read and the
// arguments not yet. It allocates nothing: `new TimeSpan(t)` IS `(TimeSpan) t`.
i64 tk_prim_new(i64 ty, i64 line, uptr fl) {
    i64 ri = tk_prim_find(ty, "new");
    i64 na = 0;
    i64 args = 0;
    if (p_id() == K_LPAR) args = tk_args(&na);
    // `new TimeSpan()` is C#'s own parameterless value constructor: the default
    // value of a primitive, which for every one of them is the zero bit pattern
    // (`TimeSpan.Zero`, `DateTime.MinValue`).
    if (na == 0) {
        // D76: NOT for a wide type. `tk_cast(ty, tk_int(0))` below reaches
        // `tw_cast` (teko_wide.tk) at codegen, which `die`s on a sixteen-byte
        // destination -- there is no zero BIT PATTERN this cast could write,
        // because a wide value moves by address and never through a register.
        // Every wide primitive answers with its own NAMED zero instead, read
        // from `pt_zero` (D76's fourth column of `tk_prim_type`), so one guard
        // here serves `decimal`, `Guid` and `DateTimeOffset` at once, and the
        // refusal is a compile-time `teko:` line and not a codegen `die`.
        if (tk_wide_is(ty)) {
            i64 pi = tk_prim_slot(ty);
            err_at(fl, line, tk_join(tk_join3("teko: new ", tk_prim_name(ty), "() is not taught; write "),
                                      pt_zero_at(pi)));
        }
        if (ri < 0) err_at2(fl, line, "teko: this primitive has no constructor", tk_prim_name(ty));
        tk_line = line;
        tk_file = fl;
        return tk_cast(ty, tk_int(0));
    }
    if (ri < 0) err_at2(fl, line, "teko: this primitive has no constructor", tk_prim_name(ty));
    return tk_prim_emit(tk_prim_pick(ty, "new", na, line, fl), 0, args, 0, line, fl);
}

// ---- `x.member`, the instance side, at PARSE time ----
// The form is read from the token stream, exactly as `tk_member_of`
// (teko_expr.tk) reads it for a receiver of class type.
i64 tk_prim_dot(i64 left, i64 ty, uptr m, i64 line, uptr fl) {
    i64 ri = tk_prim_find(ty, m);
    if (ri < 0) tk_prim_no_member(ty, m, line, fl);
    i64 kind = pmr_kind_at(ri);
    if (kind == TK_PMSOON) tk_prim_is_static(ty, m, line, fl);
    if (kind == TK_PMSVAL || kind == TK_PMSFUN) tk_prim_is_static(ty, m, line, fl);
    if (kind == TK_PMCTOR) tk_prim_no_member(ty, m, line, fl);
    i64 args = 0;
    i64 na = 0;
    if (kind == TK_PMFUN) {
        if (p_id() != K_LPAR)
            err_at2(fl, line, "teko: the member is a method; call it with ()", m);
        args = tk_args(&na);
    } else {
        if (p_id() == K_LPAR)
            err_at2(fl, line, "teko: the member is a property; it is not called", m);
        if (p_id() == K_ASSIGN) tk_prim_readonly(ty, m, line, fl);
    }
    return tk_prim_emit(tk_prim_pick(ty, m, na, line, fl), left, args, 0, line, fl);
}

// ---- ...and at PASS time, for a receiver only the oracle could type ----
// The deferred access teko_expr.tk recorded (a parameter, a chain through one)
// carries the form and the arguments the parser already read
// (teko_typeof.tk's `pd_*` tables), so the same emitter answers both sites.
i64 tk_prim_pend(i64 pi, i64 ty, uptr pty, uptr ppure, uptr pown) {
    uptr m = pd_name_at(pi);
    i64 line = pd_line_at(pi);
    uptr fl = pd_file_at(pi);
    i64 form = pd_form_at(pi);
    if (form == TK_PSTORE) tk_prim_readonly(ty, m, line, fl);
    if (form == TK_PIXLOAD || form == TK_PIXSTORE)
        err_at2(fl, line, "teko: the field is not an array", m);
    i64 ri = tk_prim_find(ty, m);
    if (ri < 0) tk_prim_no_member(ty, m, line, fl);
    i64 kind = pmr_kind_at(ri);
    if (kind == TK_PMSOON) tk_prim_is_static(ty, m, line, fl);
    if (kind == TK_PMSVAL || kind == TK_PMSFUN) tk_prim_is_static(ty, m, line, fl);
    if (kind == TK_PMCTOR) tk_prim_no_member(ty, m, line, fl);
    if (kind == TK_PMFUN && form != TK_PCALL)
        err_at2(fl, line, "teko: the member is a method; call it with ()", m);
    if (kind == TK_PMPROP && form == TK_PCALL)
        err_at2(fl, line, "teko: the member is a property; it is not called", m);
    i64 args = 0;
    i64 na = 0;
    if (form == TK_PCALL) {
        args = pd_arg_at(pi);
        na = pd_na_at(pi);
    }
    i64 pick = tk_prim_pick(ty, m, na, line, fl);
    st64(pty, pmr_ret_at(pick));
    st64(ppure, 0);
    st64(pown, TK_OWNED);
    return tk_prim_emit(pick, pd_recv_at(pi), args, 1, line, fl);
}

// ---- the cast written BY HAND (§ 3), read by teko_ops.tk's own pass ----
// A primitive converts to nothing but itself (§ 5), and a cast is the one
// syntax that would say otherwise. `(i64) dt` is not a conversion at all: it
// hands back the raw eight bytes, `Kind` bits included, which for a `Local`
// date is a NEGATIVE number and never the tick count the writer meant --
// exactly the silently wrong result this project refuses to ship. `(DateTime)
// n` is its mirror: an integer that skipped every range check
// `new DateTime(t)` makes.
//
// So both are refused where they are written, and the compiler's own identity
// casts -- which are the same two nodes -- are told apart by the list above.
// The check runs in the OPERATOR pass, which walks every node of every body
// after the oracle has typed them and after every lowering has put its own
// casts in the tree.
//
// ---- ...and the cast that IS a conversion, lowered to a call (D77) ----
// A primitive that CONVERTS -- `decimal`, whose § 6 is four rows of C# §10.3 --
// registers the pair here instead of being refused: `(i64) d` becomes
// `tk_dec_to_i64(d)` and `(decimal) x` becomes `tk_dec_from_f64(x)`. It is a
// CALL and not an instruction because `MTASK_CAST` on a sixteen-byte value has
// no meaning at all (`tw_cast`, teko_wide.tk), and it is a table and not a
// branch on `decimal` because this file names no primitive of its own.
//
// A target this table does not open keeps the refusal below, which is what
// leaves `(str) d` -- `ToString` is C5 -- and every cast over a `Guid` or a
// `DateTimeOffset` exactly as D74/D75/D76 left them.
#define TK_MAXPRIMX 32                // conversion rows, over every primitive (D81: 8 -> 16,
                                       // N6a's eight wide-integer rows took 5 to 13; D84:
                                       // 16 -> 32, N6b-2's eight `f64`/`decimal` rows took
                                       // 13 to 21)

i64  px_to[TK_MAXPRIMX];              // the type the cast NAMES
i64  px_from[TK_MAXPRIMX];            // the type the value has
uptr px_sym[TK_MAXPRIMX];
i64  tk_nprimx = 0;

i64  px_to_at(i64 i)   { return ld64(px_to + i * 8); }
i64  px_from_at(i64 i) { return ld64(px_from + i * 8); }
uptr px_sym_at(i64 i)  { return ld64(px_sym + i * 8); }

void tk_prim_cast_op(i64 to, i64 from, uptr sym) {
    if (tk_nprimx == TK_MAXPRIMX) err_at(tk_file, tk_line, "teko: too many primitive conversions");
    st64(px_to + tk_nprimx * 8, to);
    st64(px_from + tk_nprimx * 8, from);
    st64(px_sym + tk_nprimx * 8, sym);
    tk_nprimx = tk_nprimx + 1;
}

// the row whose two ends take these types, in registration order -- which is
// why an INTEGER row is written before a float one: `tk_prim_slot_fits` lets a
// float slot take an integer (`TimeSpan.FromHours(2)`'s own rule), so the
// integer row has to be the first one asked about.
i64 tk_prim_cast_find(i64 tty, i64 ety) {
    i64 i = 0;
    loop {
        if (i >= tk_nprimx) break;
        if (tk_prim_slot_fits(px_to_at(i), tty) && tk_prim_slot_fits(px_from_at(i), ety)) return i;
        i = i + 1;
    }
    return 0 - 1;
}

// the argument as the lowering symbol declares it. An `f32` source needs the
// widening cast written down -- `tk_num_widen` converts an INTEGER and leaves
// a float alone (teko_typeof.tk), and the raw four bytes of an `f32` in an
// `f64` parameter would be read as a mantissa.
i64 tk_prim_cast_arg(i64 want, i64 e, i64 ety) {
    if (want == ety) return e;
    if (type_kind(want) == TK_FLOAT && type_kind(ety) == TK_FLOAT) return tk_cast(want, e);
    return tk_num_widen(want, ety, e);
}

// 1 when the node was lowered and the refusal below has nothing left to say.
// The two directions are not the same rewrite:
//
//   (decimal) x   the cast NAMES a wide type, so no cast may survive at all
//                 (`tw_cast` dies on one): the node BECOMES the call.
//   (i32) d       the call answers `i64` and the cast the source wrote is what
//                 narrows it, so the call is spliced UNDER the cast and the
//                 cast becomes the compiler's own -- `(i64) d` is then an
//                 identity the machine never emits.
i64 tk_prim_cast_lower(i64 n, i64 tty, i64 ety) {
    i64 xi = tk_prim_cast_find(tty, ety);
    if (xi < 0) return 0;
    i64 line = nd_line(n);
    uptr fl = nd_file(n);
    i64 pty = tty;
    if (!tk_prim_is(pty)) pty = ety;
    uptr sym = px_sym_at(xi);
    tk_prim_need_include(pty, sym, line, fl);
    tk_line = line;
    tk_file = fl;
    i64 a = nd_a(n);
    set_nd_next(a, 0);
    if (tk_wide_is(tty)) {
        i64 call = tk_call(sym, tk_prim_cast_arg(px_from_at(xi), a, ety));
        tk_node_replace(n, call);
        tk_xt_put(n, tk_struct_by_ty(tty), tty, 0, TK_OWNED);
        return 1;
    }
    set_nd_a(n, tk_call(sym, a));
    tk_prim_own_cast(n);
    return 1;
}

// the article the refusals below open with. English takes *an* before a vowel
// SOUND and not before a vowel letter: `an i128`, but `a u128` -- `u128` is
// read "you-128", the same rule that gives *a union* and *a user*. Every
// primitive registered before N6a begins with a consonant, so this answers
// exactly what it always answered for them.
uptr tk_prim_article(uptr nm) {
    i64 c = ld8(nm);
    if (c == 'a' || c == 'e' || c == 'i' || c == 'o') return "teko: an ";
    return "teko: a ";
}

void tk_prim_cast_check(i64 n) {
    i64 tty = nd_type(n);
    i64 ety = tk_ty_of(nd_a(n));
    if (!tk_prim_is(tty) && !tk_prim_is(ety)) return;
    if (tk_prim_own_cast_is(n)) return;
    if (tk_prim_cast_lower(n, tty, ety)) return;
    i64 pty = tty;
    if (!tk_prim_is(pty)) pty = ety;
    uptr nm = tk_prim_name(pty);
    i64 pi = tk_prim_slot(pty);
    uptr rd = pt_read_at(pi);
    // D74: a primitive registered with NO reader and NO constructor -- which is
    // `decimal` in C3 (teko_decimal.tk) -- names neither in its refusal,
    // because a message pointing at a member the type does not have YET would
    // be wrong. The cast itself lands in C4, where it becomes a call
    // (docs/reference/not-yet.md).
    if (rd == 0 && tk_wide_is(pty)) {
        err_at(nd_file(n), nd_line(n), tk_join3(tk_prim_article(nm), nm, " does not cast yet"));
        return;
    }
    err_at(nd_file(n), nd_line(n),
           tk_join(tk_join3(tk_prim_article(nm), nm, " does not cast; "),
                   tk_join3(rd, " and ", pt_build_at(pi))));
}

// ...and the same check over what a BODY walk never reaches. `tk_ty_pass_walk`
// (teko_typeof.tk) walks the inside of functions, because that is where a
// scope exists; a global's own initializer is written outside every one of
// them, and `DateTime g = (DateTime) 5;` would otherwise be the one spelling
// that got through. The walk here is this file's own and looks for nothing but
// a cast: it must not register a scope entry for a global, which is why it does
// not reuse the pass walker.
void tk_prim_cast_walk(i64 n) {
    loop {
        if (n == 0) break;
        if (nd_kind(n) == N_CAST) tk_prim_cast_check(n);
        tk_prim_cast_walk(nd_a(n));
        tk_prim_cast_walk(nd_b(n));
        tk_prim_cast_walk(nd_c(n));
        tk_prim_cast_walk(nd_d(n));
        n = nd_next(n);
    }
}

void tk_prim_cast_globals(i64 root) {
    i64 f = root;
    loop {
        if (f == 0) break;
        if (nd_kind(f) != N_FUNC) {
            tk_prim_cast_walk(nd_a(f));
            tk_prim_cast_walk(nd_b(f));
            tk_prim_cast_walk(nd_c(f));
            tk_prim_cast_walk(nd_d(f));
        }
        f = nd_next(f);
    }
}

// ---- the operators (§ 4), read by teko_ops.tk's own pass ----
// The rule the spec's § 13 states, and the one the P0 probe proved is needed:
// the pass CLAIMS every binary and unary where either operand is a primitive
// and refuses the ones with no row. A `TK_SINT` id the core is willing to add,
// subtract and multiply raw must never reach the machine unclaimed -- measured
// on the probe, `a * b` over two `TimeSpan` values compiled and answered 40.
//
// An operand the oracle could not type at all is not guessed at either: the
// site is refused with the wording every unresolved operand already gets
// (`teko: the type of the left side of \`+\` is not known here`), because a
// primitive operand is exactly where the core's own arithmetic would be wrong.
void tk_prim_op_refuse(i64 tok, i64 line, uptr fl) {
    uptr sp = tk_op_spell(tok);
    if (sp == 0) err_at(fl, line, "teko: this operator cannot be overloaded");
    err_at(fl, line, tk_join3("teko: no operator `", sp, "` takes these operands"));
}

// `n` is the N_BINARY itself: the call replaces it in place (teko_struct.tk's
// own `tk_node_replace`), and the result type is registered so an enclosing
// operator and the reclaim both read it.
void tk_prim_binary(i64 n, i64 ta, i64 tb) {
    i64 tok = nd_op(n);
    i64 line = nd_line(n);
    uptr fl = nd_file(n);
    uptr sp = tk_op_spell(tok);
    if (sp == 0) err_at(fl, line, "teko: this operator cannot be overloaded");
    if (ta < 0) err_at(fl, line, tk_op_side_msg("left", sp));
    if (tb < 0) err_at(fl, line, tk_op_side_msg("right", sp));
    i64 ri = tk_prim_op_find(tok, 2, ta, tb);
    if (ri < 0) tk_prim_op_refuse(tok, line, fl);
    tk_line = line;
    tk_file = fl;
    i64 a = tk_prim_conv(po_t0_at(ri), nd_a(n), ta);
    i64 b = tk_prim_conv(po_t1_at(ri), nd_b(n), tb);
    // an operand was a CHILD and becomes a link of an argument list: whatever
    // `nd_next` it carried belongs to the tree it is leaving
    set_nd_next(a, 0);
    set_nd_next(b, 0);
    uptr sym = po_sym_at(ri);
    i64 owner = ta;
    if (!tk_prim_is(owner)) owner = tb;
    tk_prim_need_include(owner, sym, line, fl);
    tk_line = line;
    tk_file = fl;
    i64 ret = po_ret_at(ri);
    // `n * t` is `tk_ts_mul(t, n)`: the row is keyed by the order the SOURCE
    // wrote the operands in, and `swap` is what the reversed C# declaration
    // (`operator *(double, TimeSpan)`) becomes without a second lib function.
    // The list is built ONCE, in the order the row asks for: `list_append`
    // LINKS the two nodes, so building both orders and keeping the second
    // would leave the first link in place and make each argument the other's
    // `nd_next` -- a cycle every later walk follows forever.
    i64 call = 0;
    if (po_swap_at(ri)) call = tk_call2(sym, b, a);
    else                call = tk_call2(sym, a, b);
    tk_node_replace(n, tk_prim_ret(ret, call));
    tk_xt_put(n, tk_struct_by_ty(ret), ret, 0, TK_OWNED);
}

// ---- unary `+`: the identity, and no row at all (D77, ruling 4) ----
// C# declares `operator +(decimal)` and `operator +(TimeSpan)` and declares no
// such thing on a `DateTime`, a `Guid` or a `DateTimeOffset`, and the question
// the table already answers tells the two groups apart: a primitive that ADDS
// TO ITSELF is a number, and a number's unary `+` is its own operand. A row
// would be worse than useless on a wide type -- it would lower to a call that
// copies sixteen bytes to hand them straight back.
i64 tk_prim_unary_plus(i64 n, i64 ta) {
    if (nd_op(n) != K_ADD) return 0;
    if (tk_prim_op_find(K_ADD, 2, ta, ta) < 0) return 0;
    tk_node_replace(n, nd_a(n));
    tk_xt_put(n, tk_struct_by_ty(ta), ta, 0, TK_OWNED);
    return 1;
}

void tk_prim_unary(i64 n, i64 ta) {
    i64 tok = nd_op(n);
    i64 line = nd_line(n);
    uptr fl = nd_file(n);
    if (tk_prim_unary_plus(n, ta)) return;
    i64 ri = tk_prim_op_find(tok, 1, ta, 0 - 1);
    if (ri < 0) tk_prim_op_refuse(tok, line, fl);
    uptr sym = po_sym_at(ri);
    tk_prim_need_include(ta, sym, line, fl);
    tk_line = line;
    tk_file = fl;
    i64 ret = po_ret_at(ri);
    // D77: the operand travels the SAME road the binary one does
    // (`tk_prim_binary` above). `tk_prim_raw` is `(i64) x`, which is `tw_cast`
    // on a sixteen-byte value and dies there -- `-d` on a `decimal` is the
    // first wide unary this compiler has, and it crosses under its own type
    // because the lowering symbol declares that type (`decimal tk_dec_neg(decimal)`).
    i64 a = tk_prim_conv(po_t0_at(ri), nd_a(n), ta);
    set_nd_next(a, 0);
    tk_node_replace(n, tk_prim_ret(ret, tk_call(sym, a)));
    tk_xt_put(n, tk_struct_by_ty(ret), ret, 0, TK_OWNED);
}
