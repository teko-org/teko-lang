// teko_ref.tk -- K2 (D221/§41): `ref T` and `out T`, C#'s by-reference
// parameter forms, taught as two `type_new` primitives over a side table of
// the POINTEE each declaration's parameter actually carries:
//
//   void bump(ref i64 x) { x = x + 1; }
//   i64 a = 1; bump(ref a); // a is 2
//
//   void split(i64 v, out i64 hi, out i64 lo) { hi = v / 10; lo = v % 10; }
//
// `type_new("ref", 8, 8, TK_INT)` / `type_new("out", ...)` give the two words
// an identity distinct from `uptr` (D221) and reserve them; a `ref T`/`out T`
// PARAMETER is declared with POINTER width (`TY_UPTR`, K2w) -- what it really
// carries is an ADDRESS, and a parameter declared with a POINTEE narrower than
// a word (`u8`, `i32`, `bool`) had that address stored and reloaded at the
// pointee's own width, which truncates it: `bump(ref u8 x)` faulted. The
// POINTEE lives in a side table keyed by the PARAMETER NODE
// (`tk_rp_add`/`tk_rp_kind`/`tk_rp_pointee`), and `tk_param_ty`/
// `tk_decl_param_ty` below are the ONE pair every reader of a parameter's type
// goes through, so the oracle (`tk_ty_scope_params`, teko_typeof.tk), the
// mangling, overload/operator resolution and every argument check keep seeing
// `T`, never the `uptr` the slot is laid out as. A node index is already the
// unique, collision-free identity every other table in this project keys
// structural data by (teko_struct.tk's `xt_*`, teko_typeof.tk's pending
// members), and it sidesteps the ambiguity a bare (name, index) pair would
// have across two overloads that differ only in a parameter's TYPE at the same
// position (`f(ref i64)` next to `f(ref Circle)`).
//
// SITE: `f(ref a)`/`f(out a)` is mandatory, C#-style, through `syntax_expr`
// (`tk_ref_arg`/`tk_out_arg`) firing in `parse_primary`, exactly where a call
// argument lands. The handler returns the ADDRESS: `&a` (mc's own operator,
// M10) for a bare local, `p + offset` for `ref p.x` (the same address
// `teko_expr.tk`'s field store already computes), `base + idx*width` for
// `ref a[i]` (`teko_array.tk`'s own `tk_arr_addr`). Each address is TAGGED
// (`tk_rfarg_tag`/`tk_rfarg_kind`/`tk_rfarg_pointee`), by NODE again, because
// an address is structurally indistinguishable from an ordinary expression
// that happens to add an integer to a pointer -- the tag is what lets the
// call-site check below and the overload matcher (teko_over.tk) tell a
// `ref`/`out` argument apart from a value that merely LOOKS like one. A bare
// local's pointee is not yet knowable at PARSE time (only a class/struct
// local is tracked that early, `teko_struct.tk`'s own `tk_local_find`), so it
// is tagged -1 and resolved lazily, once the oracle's scope IS live, by
// whichever pass actually needs it (teko_over.tk's own `tk_ov_arg_ty`).
//
// DEREF: `tk_ref_pass` runs behind the oracle and ahead of every pass below
// it (teko.tk's own ordering comment) -- a bare read of a `ref`/`out`
// parameter becomes `ldW(x)` (`teko_array.tk`'s own `tk_arr_load`, which
// already picks the right width and sign-extends), and `x = e` becomes
// `stW(x, e)` UNLESS the pointee is a counted type (a class, an interface, a
// delegate): a `ref Circle` is written through the SAME `rt_store`/
// `rt_store_own` a local of class type already uses, just at `x` itself
// instead of `&x` (`x` already IS the caller's slot address) -- the one
// exception `teko_rc.tk`'s `tk_rc_assign` carries, and the only reason a
// parameter of class type is ever reassigned at all. This pass ALSO walks
// every call in the unit (not only inside a function that itself takes a
// `ref`/`out`), because the caller of `bump`/`split` rarely does.
//
// `out`: DPS. A counted `out` parameter is zeroed (`st64(x, 0);`) as the
// body's own first statement, because the frame `parse_var` reserves is not
// zeroed, and the first real write through `rt_store` would otherwise
// `rc_dec` garbage. The cheap half of "the body must assign it" is checked
// (a body that never writes the name at all), never assigned by any PATH is
// a declared debt (`the delivery-4 plan` §41(e)).
//
// MANGLING: `tk_ty_sfx(p)` -- the parameter NODE's own suffix, `ref_i64` or
// `out_Circle` in place of the bare `i64`/`Circle` `type_name` would answer
// -- is the one helper `tk_sig_of` (teko_class.tk) and `tk_ov_sig`
// (teko_over.tk) both call, so `f(i64)` and `f(ref i64)` mangle to distinct
// symbols and a call resolves to the one whose parameter's KIND (this
// module's own `tk_rp_kind`) matches the argument's tag -- `f(ref i64)` and
// `f(out i64)` never coexist: `tk_ov_judge`'s own pairwise scan below refuses
// two declarations whose bare (ref/out-stripped) signature is identical and
// differ only in that kind.

#define TK_RP_NONE 0
#define TK_RP_REF  1
#define TK_RP_OUT  2

#define TK_MAXRP     512               // ref/out parameters declared, over the whole unit
#define TK_MAXRFARG  512               // ref/out arguments written, over the whole unit

i64 tk_ty_ref = 0;
i64 tk_ty_out = 0;
i64 tk_ref_dot = 0;                    // this module's own copy of the `.` token (idempotent intern)
i64 tk_ref_root = 0;                   // the unit, for the same decl-count guard C6 already uses
i64 tk_ref_cur_fn = 0;                 // the N_FUNC this pass is walking right now

i64 tk_default_decl_count(i64 root, uptr name);   // teko_default.tk, included after this file
i64 tk_deleg_is_thunk(i64 f);                     // teko_deleg.tk, included after this file

// D104: the two member gates `tk_member_of` (teko_expr.tk) puts in front of a
// field it is about to read -- both modules are included after this one, and
// `tk_ref_addr` below asks them the same questions in the same order
void tk_check_member(i64 owner, i64 vis, uptr m, i64 line, uptr fl);          // teko_access.tk
void tk_reject_static_member(i64 si, uptr m, i64 line, uptr fl);              // teko_expr.tk

// teko_typeof.tk, included after this file -- but this pass RUNS after that
// one (`teko.tk`: `tk_typeof_pass`, then `tk_ref_pass`), so the oracle's own
// scope stack is exactly the table this walk keeps live and reads a bare name
// in. One oracle for one name (D51, verifier finding).
i64  tk_ty_scope_or_global(uptr name);
i64  tk_ty_scope_index(uptr name);
void tk_ty_scope_var(i64 n);
void tk_ty_scope_params(i64 p);
i64  tk_ty_scope_mark();
void tk_ty_scope_cut(i64 m);

// ---- side table: parameter NODE -> (kind, pointee type) ----
i64 rp_node[TK_MAXRP];
i64 rp_kind[TK_MAXRP];
i64 rp_ty[TK_MAXRP];
i64 rp_seen[TK_MAXRP];                 // the "assigned at least once" watermark, per row
i64 tk_nrp = 0;

i64 rp_node_at(i64 i) { return ld64(rp_node + i * 8); }
i64 rp_kind_at(i64 i) { return ld64(rp_kind + i * 8); }
i64 rp_ty_at(i64 i)   { return ld64(rp_ty + i * 8); }
void set_rp_node_at(i64 i, i64 v) { st64(rp_node + i * 8, v); }
void set_rp_kind_at(i64 i, i64 v) { st64(rp_kind + i * 8, v); }
void set_rp_ty_at(i64 i, i64 v)   { st64(rp_ty + i * 8, v); }

void tk_rp_add(i64 pnode, i64 kind, i64 ty) {
    if (tk_nrp == TK_MAXRP) err_at(tk_file, tk_line, "teko: too many `ref`/`out` parameters in one unit");
    set_rp_node_at(tk_nrp, pnode);
    set_rp_kind_at(tk_nrp, kind);
    set_rp_ty_at(tk_nrp, ty);
    st64(rp_seen + tk_nrp * 8, 0);
    tk_nrp = tk_nrp + 1;
}

i64 tk_rp_row(i64 pnode) {
    i64 i = 0;
    loop {
        if (i >= tk_nrp) break;
        if (rp_node_at(i) == pnode) return i;
        i = i + 1;
    }
    return 0 - 1;
}

i64 tk_rp_kind(i64 pnode) {
    i64 r = tk_rp_row(pnode);
    if (r < 0) return TK_RP_NONE;
    return rp_kind_at(r);
}

i64 tk_rp_pointee(i64 pnode) {
    i64 r = tk_rp_row(pnode);
    if (r < 0) return 0 - 1;
    return rp_ty_at(r);
}

void tk_rp_mark_seen(i64 pnode) {
    i64 r = tk_rp_row(pnode);
    if (r >= 0) st64(rp_seen + r * 8, 1);
}

i64 tk_rp_seen(i64 pnode) {
    i64 r = tk_rp_row(pnode);
    if (r < 0) return 0;
    return ld64(rp_seen + r * 8);
}

// ---- side table: call-argument NODE -> (kind, pointee type) ----
// an address is structurally identical whether it came from `ref`/`out`
// sugar or from an ordinary expression that adds to a pointer -- this is
// what lets the two be told apart at the call site and inside the overload
// matcher, both of which need to know an argument's *intended* kind, not
// merely its shape.
i64 rf_node[TK_MAXRFARG];
i64 rf_kind[TK_MAXRFARG];
i64 rf_ty[TK_MAXRFARG];
i64 tk_nrf = 0;

i64 rf_node_at(i64 i) { return ld64(rf_node + i * 8); }
i64 rf_kind_at(i64 i) { return ld64(rf_kind + i * 8); }
i64 rf_ty_at(i64 i)   { return ld64(rf_ty + i * 8); }
void set_rf_node_at(i64 i, i64 v) { st64(rf_node + i * 8, v); }
void set_rf_kind_at(i64 i, i64 v) { st64(rf_kind + i * 8, v); }
void set_rf_ty_at(i64 i, i64 v)   { st64(rf_ty + i * 8, v); }

void tk_rfarg_tag(i64 n, i64 kind, i64 ty) {
    // the two arguments were the wrong way round -- `err_at(file, line)`, as
    // `tk_rp_add` above already spells it -- so the unit that exhausted this
    // budget read `tk_line` as a file POINTER and died of a segmentation
    // fault instead of the refusal below (Copilot on #712, second pass)
    if (tk_nrf == TK_MAXRFARG) err_at(tk_file, tk_line, "teko: too many `ref`/`out` arguments in one unit");
    set_rf_node_at(tk_nrf, n);
    set_rf_kind_at(tk_nrf, kind);
    set_rf_ty_at(tk_nrf, ty);
    tk_nrf = tk_nrf + 1;
}

i64 tk_rfarg_row(i64 n) {
    i64 i = 0;
    loop {
        if (i >= tk_nrf) break;
        if (rf_node_at(i) == n) return i;
        i = i + 1;
    }
    return 0 - 1;
}

i64 tk_rfarg_kind(i64 n) {
    i64 r = tk_rfarg_row(n);
    if (r < 0) return TK_RP_NONE;
    return rf_kind_at(r);
}

i64 tk_rfarg_pointee(i64 n) {
    i64 r = tk_rfarg_row(n);
    if (r < 0) return 0 - 1;
    return rf_ty_at(r);
}

// the i-th (0-based) parameter NODE of declaration `d`, or -1
i64 tk_decl_param_node(i64 d, i64 i) {
    i64 p = nd_a(d);
    i64 k = 0;
    loop {
        if (p == 0) return 0 - 1;
        if (k == i) return p;
        k = k + 1;
        p = nd_next(p);
    }
    return 0 - 1;
}

// the type a PARAMETER node STANDS for: its own declared type for an ordinary
// parameter, and the POINTEE for a `ref`/`out` one, whose declared type is the
// pointer width the address needs (K2w). Every site that used to read
// `nd_type` off a parameter reads this instead.
i64 tk_param_ty(i64 p) {
    i64 r = tk_rp_row(p);
    if (r < 0) return nd_type(p);
    return rp_ty_at(r);
}

// the same question by INDEX of a declaration, for the sites that ask the
// core's own `decl_param_type` -- which answers the DECLARED type, `uptr` for
// a `ref`/`out` parameter since K2w
i64 tk_decl_param_ty(i64 d, i64 i) {
    i64 p = tk_decl_param_node(d, i);
    if (p < 0) return decl_param_type(d, i);
    return tk_param_ty(p);
}

uptr tk_ref_kindname(i64 kind) {
    if (kind == TK_RP_OUT) return "out";
    return "ref";
}

// the mangling suffix parameter node `p` contributes: `ref_i64`/`out_Circle`
// for a by-reference parameter, its plain type name otherwise -- the ONE
// helper `tk_sig_of` (teko_class.tk) and `tk_ov_sig` (teko_over.tk) both call
uptr tk_ty_sfx(i64 p) {
    i64 rk = tk_rp_kind(p);
    uptr base = tk_ty_mangle_name(tk_param_ty(p));   // K3: `T[]`'s own name is unsafe in a symbol
    if (rk == TK_RP_NONE) return base;
    return tk_join(tk_join(tk_ref_kindname(rk), "_"), base);
}

// `ref`/`out` at the START of a parameter's type, peeked without consuming --
// the same `type_of_token(p_id())` a plain parameter's type is already read
// with (teko_default.tk's own `tk_default_param`)
i64 tk_ref_kind() {
    i64 ty = type_of_token(p_id());
    if (ty == tk_ty_ref) return TK_RP_REF;
    if (ty == tk_ty_out) return TK_RP_OUT;
    return TK_RP_NONE;
}

// the pointee type after `ref`/`out` has already been consumed by the
// caller -- a namespaced short name first (§31 N1), then the core's own
// `type_of_token`, the same two-step `tk_default_param` already reads a
// parameter's type with
i64 tk_ref_param(i64 kind) {
    i64 line = p_line();
    uptr fl = p_file();
    i64 ty = tk_ns_param_ty();
    if (ty >= 0) {
        p_next();
        return ty;
    }
    ty = type_of_token(p_id());
    if (ty == tk_ty_params) err_at(fl, line, "teko: a `params` list is not `ref` or `out`");
    if (ty < 0 || ty == TY_VOID || ty == tk_ty_ref || ty == tk_ty_out)
        err_at(fl, line, tk_join3("teko: expected a type after `", tk_ref_kindname(kind), "`"));
    return p_type();          // K3 (§41): lets a `[]` suffix register through syntax_type
}

// `ref`/`out` take no default: C# does not allow one, and a zeroed `out`
// slot (the DPS prologue below) would make a default silently unreachable
void tk_ref_deny_default(i64 kind, i64 line, uptr fl) {
    if (p_id() == K_ASSIGN)
        err_at(fl, line, tk_join3("teko: a `", tk_ref_kindname(kind), "` parameter has no default"));
}

// `tk_ref_addr` cannot return two values, and the pointee type is only known
// once the operand has been read -- a single out-parameter, `pty`, carries
// it back the same way `st64(pnp, np)` (teko_class.tk's own `tk_params`)
// already hands a count back through a raw pointer
void set_pty(i64 pty, i64 v) { st64(pty, v); }

// `ref a` / `ref p.x` / `ref a[i]` -- the operand after `ref`/`out` at a call
// argument position: the address a bare local's own `&` operator already
// builds (mc core-language.md § Operators), the field-store's own
// `left + offset` (teko_expr.tk's `tk_field_use`), or the local array's own
// `tk_arr_addr` (teko_array.tk) -- never a copy of the value. Answers the
// POINTEE type alongside the address, through `pty`, for the tag below --
// -1 for a bare local (not parse-time-typed; resolved lazily where needed).
i64 tk_ref_addr(i64 line, uptr fl, i64 pty) {
    tk_line = line;
    tk_file = fl;
    if (p_id() != T_IDENT) err_at2(fl, line, "teko: `ref`/`out` requires a variable", p_name());
    uptr name = p_ident();
    if (p_id() == tk_ref_dot) {
        p_next();
        uptr m = tk_member_name();                // D68
        // D104: the INNERMOST binding wins, and it is asked in one place.
        //
        // `tk_slv_find` (teko_struct.tk) is the live-scoped table of EVERY
        // local with its declared type -- an object one is in it as well as
        // in `tk_local_find`'s, registered by the same `tk_on_stmt` -- so its
        // answer IS the innermost local, whatever its type, and
        // `tk_struct_by_ty` turns it into a row or into -1. Reading
        // `tk_local_find` alone could not see a SCALAR local shadowing an
        // object one: `H h = new H(); { i64 h = 0; bump(ref h.n); }` found
        // the outer `H` and added the field offset to the inner `i64` slot,
        // a SIGSEGV at `f81e0217` (Copilot on #770). `this` has a row in
        // `tk_local_find`'s table and none in `tk_slv_find`'s
        // (teko_class.tk's `tk_local_add(tk_this_name(), ci)`), so it keeps
        // the fallback below -- and never reaches here anyway, `this` being
        // no `T_IDENT` for the guard above.
        //
        // Only when NO local of that name is in scope does a PARAMETER
        // answer (`tk_hp_find_any`) -- which is in no scope table at all, and
        // whose declared type the parameter list recorded as it read it. That
        // second question is what makes `ref h.n` / `out h.n` legal on a
        // struct/class parameter, the sibling `tk_hp_find` already answers
        // for a `T[]` parameter at `tk_dot` (teko_expr.tk). A `ref`/`out`
        // parameter keeps the refusal: it has no row in that table, and its
        // slot carries an address rather than the object, so `name + OFF`
        // would not be the field.
        // A FIXED-ARRAY local is in NEITHER table above: `tk_on_stmt` returns
        // before `tk_slv_add` for a declaration with a length, and the array
        // lives in `tk_arr_find`'s own scoped table (teko_array.tk). Asked
        // after `tk_slv_find` and before everything else, it blocks the
        // parameter fallback the way any other local does -- without it an
        // inner `i64 h[2]` shadowing an `H h` PARAMETER built `h + OFF`
        // against the ARRAY's storage (Copilot on #770; `f81e0217` refuses
        // that program). An array is never an object with fields, so there is
        // nothing to answer with, only something to block.
        i64 lty = tk_slv_find(name);
        i64 si;
        if (lty >= 0) si = tk_struct_by_ty(lty);
        else if (tk_arr_find(name) >= 0) si = 0 - 1;
        else {
            si = tk_local_find(name);
            if (si < 0) {
                i64 hty = tk_hp_find_any(name);
                if (hty >= 0) si = tk_struct_by_ty(hty);
            }
        }
        if (si < 0) err_at2(fl, line, "teko: not an object of a known type", name);
        i64 fi = tk_field_find(si, m);
        if (fi < 0) err_at2(fl, line, "teko: unknown member", m);
        // D104: the SAME two gates `tk_member_of` (teko_expr.tk) puts in front
        // of an ordinary field read, in its order. This door had neither, and
        // `name + OFF` is an address a caller then WRITES through, so it was
        // the laxest of the two: `bump(ref h.secret)` wrote a `private` field
        // from outside its type (measured, 42 where the read is refused), and
        // `bump(ref h.tally)` on a STATIC lowered to `h + fd_off` although a
        // static's storage is a symbol of its own and not inside the object at
        // all -- SIGSEGV, measured on `f81e0217` too through a LOCAL receiver.
        // The parameter receiver this decision adds would have inherited both,
        // so the gate goes where BOTH receivers pass (Copilot on #770).
        // ...and each gate is given what `tk_member_of` gives it: the field's
        // OWNER for the visibility question, which is the declaring type's to
        // answer, and the RECEIVER's own row for the static one, so an
        // inherited static names the type the source wrote. `tk_field_find`
        // walks the base chain, so the two differ exactly when it does: with
        // `class D : B` and a static `B.tally`, `ref d.tally` said
        // `B.tally is static` where the ordinary read says `D.tally is static`
        // (measured -- Copilot on #770).
        tk_check_member(tk_field_owner(fi), fd_vis_at(fi), m, line, fl);
        if (fd_sym_at(fi)) tk_reject_static_member(si, m, line, fl);
        set_pty(pty, fd_ty_at(fi));
        return tk_bin(K_ADD, tk_id(name), tk_int(fd_off_at(fi)));
    }
    if (p_id() == K_LBRACK) {
        p_next();
        i64 li = tk_arr_find(name);
        if (li < 0) err_at2(fl, line, "teko: not a local array", name);
        i64 idxRaw = parse_expr(0);
        p_expect(K_RBRACK, "expected ] after the index");
        tk_line = line;
        tk_file = fl;
        i64 idx = tk_arr_bounds(idxRaw, av_nel_at(li), av_name_at(li), line, fl);
        set_pty(pty, av_ty_at(li));
        return tk_arr_addr(tk_id(name), av_ty_at(li), idx);
    }
    set_pty(pty, tk_slv_find(name));              // higiene 2, item 2: a bare local's own declared type
    return tk_addr(name);
}

// `ref a` -- the shared body of the two `syntax_expr` handlers below
i64 tk_ref_expr(i64 kind) {
    i64 line = p_line();
    uptr fl = p_file();
    p_next();
    i64 pty = 0;
    i64 n = tk_ref_addr(line, fl, &pty);
    tk_rfarg_tag(n, kind, pty);
    return n;
}

i64 tk_ref_arg() { return tk_ref_expr(TK_RP_REF); }
i64 tk_out_arg() { return tk_ref_expr(TK_RP_OUT); }

// `ref x;` / `out x;` as a LOCAL DECLARATION: `ref`/`out` name a parameter
// FORM, not a real type a variable may hold -- refused where the core would
// otherwise happily declare an 8-byte scalar named that
i64 tk_ref_on_stmt(i64 n) {
    if (n == 0) return n;
    if (nd_kind(n) != N_VAR) return n;
    if (nd_type(n) == tk_ty_ref || nd_type(n) == tk_ty_out)
        err_at(nd_file(n), nd_line(n), "teko: `ref`/`out` is only valid as a parameter type");
    return n;
}

// ---- the deref pass ----

// the ref/out parameter of `fn` named `name`, or -1 -- shared with
// `teko_rc.tk`'s own `tk_rc_assign`, which asks the SAME question of
// whatever function IT is walking (its own `tk_rc_cur_fn`), for the one
// exception a `ref`/`out` parameter of counted type earns there
i64 tk_rp_named_in(i64 fn, uptr name) {
    i64 p = nd_a(fn);
    loop {
        if (p == 0) break;
        if (str_eq(nd_name(p), name) && tk_rp_kind(p) != TK_RP_NONE) return p;
        p = nd_next(p);
    }
    return 0 - 1;
}

// the ref/out parameter of the CURRENT function named `name`, or -1 -- and
// only where that name still BINDS to it. The table of parameters carries no
// position, so every `x` in the body used to answer with the signature's `x`,
// whatever a block in between had declared: `void f(ref i64 x) { if (c) {
// f64 x = 2.0; bumpf(ref x); } }` was CHECKED against the innermost `x` (the
// `f64` local, `tk_ref_arg_pointee` reading the lexical scope) and then
// REWRITTEN as a repass of the outer `ref i64` parameter, so the callee wrote
// a float through the CALLER's own `i64` slot -- silent memory corruption
// from two oracles disagreeing about one name (D51, tenth pass). One binding
// answers both halves now: the walk's own scope stack, which holds the
// parameters at [0, tk_ref_nparams) and every local above them, so an index at
// or beyond that mark is a declaration shadowing the parameter and the name is
// NOT a repass. A name the stack cannot answer at all (-1: a walk entered
// outside `tk_ref_fn`) keeps the parameter, which is what it always meant --
// and "the scope table ran out" is no longer one of the ways that -1 happens:
// its ceiling is the parser's own now and the overflow is a refusal, where
// past 255 locals the shadow went unrecorded, the CHECK refused a legal call
// and this rewrite was one step from writing a float through the caller's own
// `i64` slot (D51, eleventh pass).
i64 tk_ref_nparams = 0;                // the mark right after this function's parameters

i64 tk_ref_param_named(uptr name) {
    i64 pn = tk_rp_named_in(tk_ref_cur_fn, name);
    if (pn < 0) return 0 - 1;
    if (tk_ty_scope_index(name) >= tk_ref_nparams) return 0 - 1;
    return pn;
}

// The parameter's own name INSIDE the load or the store this pass writes over
// it. Everywhere else `x` means the pointee -- that is what the scope records
// it under (`tk_ty_scope_params`) and what every check reads -- but here it is
// the ADDRESS being handed to `ldW`/`stW`, and nothing said so: `tk_ty_of`
// answered the POINTEE for it, and `tk_rc_call_args` (teko_rc.tk) then judged
// that answer against the intrinsic's own parameter.
//
// Harmless while the load and the store were `ld64`/`st64`, which `decl_find`
// does not know and that check skips; NOT harmless for a WIDE pointee, whose
// indirect access is a declared function of the program's own
// (`tk_dec_ld(ptr p)`, `tk_guid_st(ptr p, Guid g)` -- teko_struct.tk's
// `tk_ldn`/`tk_stn`, D74): `void bump(ref decimal d) { d = 7m; }` was refused
// with `teko: a value of type decimal does not convert to uptr`, on a line no
// source wrote, which is the hole C3 left and D75 closes. The node is tagged
// with what it IS, once, where it is built.
i64 tk_ref_slot_addr(uptr name) {
    i64 a = tk_id(name);
    tk_xt_put(a, 0 - 1, TY_UPTR, 1, TK_BORROWED);
    return a;
}

// `x = e;` on a `ref`/`out` parameter of a SCALAR pointee: `x` already IS the
// caller's slot address, so the store goes straight through it -- a counted
// pointee is left as an ordinary N_ASSIGN, `teko_rc.tk`'s own exception.
//
// The statement's own line and file are put in force first: every node below is
// built through `tk_nd` (teko_struct.tk), which stamps `tk_line`/`tk_file`, and
// what those held here was whatever the last node the PARSER built had left --
// `lib/rt.tk:385` on a refusal about a `ref decimal` parameter, measured (D75).
void tk_ref_rewrite_assign(i64 n, i64 pn) {
    tk_line = nd_line(n);
    tk_file = nd_file(n);
    i64 store = tk_arr_store(tk_param_ty(pn), tk_ref_slot_addr(nd_name(n)), nd_a(n));
    set_nd_kind(n, N_EXPRSTMT);
    set_nd_name(n, 0);
    set_nd_a(n, store);
}

// higiene 3, item A: the type a NAMED `ref`/`out` argument really points at.
// The parse-time tag (`tk_rfarg_pointee`) falls back to `tk_slv_find`, the
// PARSER's own stack of locals still in scope (teko_struct.tk), which records
// a declaration and never a PARAMETER -- so `lvl_c(ref x)` inside
// `lvl_b(ref i64 x)` answers -1, or the type of some unrelated local named `x`
// that happens to be open around the call.
//
// ONE oracle answers it instead, the same one `tk_ty_of` reads: the LEXICAL
// scope live at the site (teko_typeof.tk's own `tk_ty_scope_or_global` --
// this walk keeps that stack live below, exactly as `tk_ty_walk_list` does),
// then a global. Lexically there is no such thing as an ambiguous name: `g`
// at a given point is the innermost `g` visible there, or -- when no block
// open at that point declares one -- the global. The body-wide SCAN this
// function used to take (`tk_ref_scan_local`, and the "two sibling blocks
// declare it under two types" bit it set) was blind to the position of the
// site, so it answered "ambiguous, refuse nothing" where the source is not
// ambiguous at all, while `tk_rc_call_args` -- reading the scope -- answered
// the global and widened an ADDRESS into a float (D51, verifier finding).
// Two oracles, one of them position-blind: the scan is gone.
i64 tk_ref_arg_pointee(i64 a) {
    i64 k = nd_kind(a);
    if (k != N_ADDR && k != N_IDENT) return tk_rfarg_pointee(a);
    uptr name = nd_name(a);
    if (name == 0) return tk_rfarg_pointee(a);
    return tk_ty_scope_or_global(name);
}

uptr tk_pointee_name(i64 ty) {
    i64 si = tk_struct_by_ty(ty);
    if (si >= 0) return sr_name_at(si);
    return type_name(ty);
}

// a `ref`/`out` argument's own POINTEE against the parameter's, IDENTICAL
// only -- C#'s own `ref`/`out` rule, narrower than `tk_row_fits`'s
// derives/implements one (a `ref Square` slot does not widen to hold a
// `ref Circle`, even were one to derive from the other). higiene 3, item A
// extends it from class/struct to EVERY pointee: `ref i64` refuses a
// `ref u8` too, since the callee stores eight bytes through a slot that
// holds one. Type identity alone decides it, so the two aliases of one
// primitive (`bool`/`byte`/`u8`, `char`/`u32`, `str`/`ptr`/`uptr`) are the
// same pointee here, as they are everywhere else. A local, a parameter and a
// global are all named now, by the lexical rule above; what is left unnamed is
// a pointee no scope and no global table holds a row for (-1), and that one is
// silently skipped, the same rule `tk_check_field_store` gives an unknown
// source. It is called from `tk_rc_call_args` (teko_rc.tk) as well, for the
// overloaded name this pass leaves alone.
//
// The rule is stated over the POINTEE TYPE rather than over a parameter NODE,
// because a call through a delegate has no node to read: its signature keeps
// the pointee in a flat column of its own (`dg_pty_at`, teko_deleg.tk), and
// the kind check beside it (`tk_deleg_check_arg_kinds`) was comparing the
// `ref`/`out` TAG alone -- so `delegate void Mut(ref f64 x); Mut m = ...;
// i64 g; m(ref g);` handed an integer's address to a callee that writes a
// double through it, the very mismatch the DIRECT call refuses in the words
// below (D51, twelfth pass). One rule, two spellings of "the parameter".
void tk_ref_check_pointee_ty(i64 pty, i64 a, i64 line, uptr fl) {
    i64 aty = tk_ref_arg_pointee(a);
    if (aty < 0) return;
    if (aty == pty) return;
    i64 ti = tk_struct_by_ty(pty);
    if (ti >= 0 && tk_struct_by_ty(aty) == ti) return;
    tk_reject_compat(tk_pointee_name(aty), tk_pointee_name(pty), line, fl);
}

void tk_ref_check_pointee(i64 pn, i64 a, i64 line, uptr fl) {
    tk_ref_check_pointee_ty(tk_param_ty(pn), a, line, fl);
}

// ONE argument's tag against ONE parameter's kind, in the words the direct
// call has always refused the mismatch with. `i` is the argument's 0-based
// position in the call's OWN list -- the receiver included on a method call,
// so `b.m(ref x)` on a by-value first parameter says "argument 2" whichever
// road carries it, the mangled `Owner_method` a non-virtual call lowers to
// counting the receiver exactly the same way.
//
// The indirect roads had no way to state this rule before D57: a `callp`
// names no symbol, so `tk_ref_check_call` below never reaches one and the tag
// crossed unread. Measured on `d0fbe9a4` and on this branch alike:
// `b.takei(ref x)` handed an ADDRESS to an `i64` parameter (exit 209, the low
// byte of a stack address, where the direct twin refuses) and `b.bump(x)`
// handed a VALUE to a `ref f64` parameter, whose `d = 2.0` then wrote through
// it (SIGSEGV) -- on the vtable road, the itab road and the unqualified form
// of either (Copilot on #707, second pass).
void tk_ref_check_kind(i64 pk, i64 a, i64 i, i64 line, uptr fl) {
    i64 ak = tk_rfarg_kind(a);
    if (pk == ak) return;
    if (pk == TK_RP_NONE)
        err_at(fl, line, tk_join3("teko: argument ", tk_num(i + 1), " is not passed by reference"));
    err_at(fl, line,
           tk_join(tk_join3("teko: argument ", tk_num(i + 1), " needs `"),
                   tk_join(tk_ref_kindname(pk), "` at the call site")));
}

// a call to a name declared exactly ONCE in the unit (teko_default.tk's own
// decl-count guard: an overloaded name is left to teko_over.tk's own
// kind-aware match, run over every declaration together) -- every argument
// whose parameter is `ref`/`out` must carry that same tag, and every other
// argument must carry none
void tk_ref_check_call(i64 n) {
    uptr name = nd_name(n);
    if (tk_default_decl_count(tk_ref_root, name) != 1) return;
    i64 d = decl_find(name);
    if (d < 0) return;
    i64 i = 0;
    i64 a = nd_a(n);
    loop {
        if (a == 0) break;
        i64 pn = tk_decl_param_node(d, i);
        i64 pk = tk_rp_kind(pn);
        tk_ref_check_kind(pk, a, i, nd_line(a), nd_file(a));
        if (pk != TK_RP_NONE) tk_ref_check_pointee(pn, a, nd_line(a), nd_file(a));
        i = i + 1;
        a = nd_next(a);
    }
}

void tk_ref_walk(i64 n) {
    loop {
        if (n == 0) break;
        i64 k = nd_kind(n);
        if (k == N_ASSIGN) {
            i64 pn = tk_ref_param_named(nd_name(n));
            if (pn >= 0) {
                tk_rp_mark_seen(pn);
                tk_ref_walk(nd_a(n));
                if (!tk_is_counted(tk_param_ty(pn))) tk_ref_rewrite_assign(n, pn);
                n = nd_next(n);
                continue;
            }
        } else if (k == N_IDENT) {
            i64 pn = tk_ref_param_named(nd_name(n));
            if (pn >= 0) {
                i64 pty = tk_param_ty(pn);
                tk_line = nd_line(n);
                tk_file = nd_file(n);
                tk_node_replace(n, tk_arr_load(pty, tk_ref_slot_addr(nd_name(n))));
                // the read IS a value of the POINTEE's type, and nothing said
                // so: the node it becomes is a raw `ld64`, which the oracle
                // reads as an intrinsic call it cannot type
                // (`tk_ty_of`, teko_typeof.tk). Harmless while every consumer
                // treated "not known" as "refuse nothing"; not harmless for a
                // PRIMITIVE pointee (docs/specs/datetime.md § 2), where an
                // untyped operand is exactly what teko_ops.tk has to refuse
                // rather than leave to the core's raw arithmetic -- so
                // `t = t + a` inside `f(ref TimeSpan t)` was
                // ``teko: the type of the left side of `+` is not known here``.
                // Registered here, where the pointee is in hand, for every
                // pointee type alike: a load is pure and borrowed, the same
                // two answers a field load registers (teko_expr.tk).
                tk_xt_put(n, tk_struct_by_ty(pty), pty, 1, TK_BORROWED);
                n = nd_next(n);
                continue;
            }
        } else if (k == N_CALL) {
            tk_ref_check_call(n);
        } else if (k == N_ADDR) {
            // K2b bug 2: `ref x`/`out x` where `x` is ITSELF a `ref`/`out`
            // parameter of the function being walked -- `&x` (parse time's
            // own guess, tk_ref_addr) is the CALLEE's own slot, which dies on
            // return; `x`'s VALUE already IS the caller's slot address, so
            // that is what a repassed argument has to carry instead. An `out`
            // repassed this way is handed to a callee that must itself write
            // it, so it counts as assigned here too.
            if (tk_rfarg_kind(n) != TK_RP_NONE) {
                i64 pn = tk_ref_param_named(nd_name(n));
                if (pn >= 0) {
                    tk_rp_mark_seen(pn);
                    tk_node_replace(n, tk_id(nd_name(n)));
                }
            }
        }
        // the LEXICAL scope, kept exactly as `tk_ty_walk_list` (teko_typeof.tk)
        // keeps it: a block pushes a mark and cuts back to it at its `}`, and a
        // local joins the scope only after the statement that declares it has
        // been walked, so its own initializer still reads the outer name. That
        // stack is what `tk_ref_arg_pointee` answers a `ref x` from -- the same
        // table, at the same point, that `tk_ty_of` answers the very same node
        // from downstream.
        if (k == N_BLOCK) {
            i64 mark = tk_ty_scope_mark();
            tk_ref_walk(nd_a(n));
            tk_ty_scope_cut(mark);
        } else {
            tk_ref_walk(nd_a(n));
            tk_ref_walk(nd_b(n));
            tk_ref_walk(nd_c(n));
            tk_ref_walk(nd_d(n));
            tk_ty_scope_var(n);
        }
        n = nd_next(n);
    }
}

// 1 when `f` declares at least one `ref`/`out` parameter
i64 tk_ref_fn_has_refout(i64 f) {
    i64 p = nd_a(f);
    loop {
        if (p == 0) break;
        if (tk_rp_kind(p) != TK_RP_NONE) return 1;
        p = nd_next(p);
    }
    return 0;
}

void tk_ref_check_out_assigned(i64 f) {
    i64 p = nd_a(f);
    loop {
        if (p == 0) break;
        if (tk_rp_kind(p) == TK_RP_OUT && !tk_rp_seen(p))
            err_at(nd_file(f), nd_line(f), tk_join3("teko: the `out` parameter ", nd_name(p), " is never assigned"));
        p = nd_next(p);
    }
}

// `rt_store(x, 0);` ahead of the body's own first statement, for every
// COUNTED `out` parameter -- `x` already IS the caller's own slot address
// (K2b bug 1b): whatever the caller passed in it (a live reference from an
// earlier call, on a second `make(out x)`) is released through the SAME
// old-value `rc_dec` any other counted store runs, instead of the raw
// `st64` this pass used to overwrite it with, which stomped the caller's
// slot without ever releasing what was there
void tk_ref_out_prologue(i64 f) {
    i64 pre = 0;
    i64 p = nd_a(f);
    loop {
        if (p == 0) break;
        if (tk_rp_kind(p) == TK_RP_OUT && tk_is_counted(tk_param_ty(p)))
            pre = list_append(pre, tk_stmt(tk_call2("rt_store", tk_id(nd_name(p)), tk_int(0))));
        p = nd_next(p);
    }
    if (pre == 0) return;
    i64 blk = nd_b(f);
    set_nd_a(blk, list_append(pre, nd_a(blk)));
}

// every function is walked, not only one that itself takes a `ref`/`out`:
// the CALLER of `bump`/`split` rarely does, and its own call sites are what
// `tk_ref_check_call` above has to see
void tk_ref_fn(i64 f) {
    tk_ref_cur_fn = f;
    // the parameters open the scope -- `tk_ty_scope_params` records a
    // `ref`/`out` one under its POINTEE (`tk_param_ty`), which is what a
    // repassed `ref x` points at
    tk_ty_scope_cut(0);
    tk_ty_scope_params(nd_a(f));
    tk_ref_nparams = tk_ty_scope_mark();          // above this mark, a local shadows
    tk_ref_walk(nd_b(f));
    tk_ty_scope_cut(0);
    if (tk_ref_fn_has_refout(f)) {
        tk_ref_check_out_assigned(f);
        tk_ref_out_prologue(f);
    }
    tk_ref_cur_fn = 0;
}

// Every function but ONE: a delegate thunk (`tk_deleg_is_thunk`,
// teko_deleg.tk) is the COMPILER's own forwarder, and this pass has nothing
// to do inside it. Its parameters carry no row of the table above -- the walk
// rewrites nothing there -- and the single call in its body forwards each
// `ref`/`out` parameter as the ADDRESS its `uptr` slot already holds, over a
// target `tk_deleg_check_sig` has proved identical to the delegate parameter
// by parameter: correct by construction, so `tk_ref_check_call` has no
// question left to ask and the answer it used to get was ``argument 1 needs
// `ref` at the call site`` on the compiler's own code (D63).
//
// Saying so HERE, once, is what keeps a thunk out of the `rf_*` budget as
// well: tagging the forwarded arguments instead spent one row of TK_MAXRFARG
// per forwarded `ref`/`out` parameter, against the same table every argument
// the SOURCE writes draws on, so a unit of 30 delegate wrappers of 8 `ref`
// parameters each lost 240 of its 512 rows to code no one wrote (Copilot on
// #712, second pass).
i64 tk_ref_pass(i64 root) {
    if (tk_nrp == 0 && tk_nrf == 0) return root;   // no `ref`/`out` parameter AND no `ref`/`out` argument
    tk_ref_root = root;
    i64 f = root;
    loop {
        if (f == 0) break;
        if (nd_kind(f) == N_FUNC && !tk_deleg_is_thunk(f)) tk_ref_fn(f);
        f = nd_next(f);
    }
    return root;
}

void tk_ref_init() {
    tk_ty_ref = type_new("ref", 8, 8, TK_INT);
    tk_ty_out = type_new("out", 8, 8, TK_INT);
    tk_ref_dot = word_add(".");
}
