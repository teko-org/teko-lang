// teko_params.tk -- `params T[]`, C#'s own variadic: a MODIFIER read before
// the type at a free function's parameter position, and one AST pass that
// builds the array at every call site.
//
//   i64 total(params i64[] xs) { ... xs.Length ... xs[i] ... }
//
//   total(a, b)  ->  total(tkarr_put_i64(tkarr_put_i64(
//                             tkarr_new_i64(2), 24, a), 32, b))
//   total()      ->  total(tkarr_new_i64(0))
//   total(xs)    ->  total(xs)          the NORMAL form: already a `T[]`
//
// THE PARAMETER IS AN ORDINARY `T[]`. `params` stops being the parameter's
// type and becomes the modifier `ref`/`out` already are, read by
// `tk_pm_before_type` at the position `syntax_param` gives it
// (teko_default.tk's `tk_default_param`, the one registration). What follows
// it has to be a `T[]`, and the parameter has to be the last one; the node is
// MARKED here, keyed by node, and `tk_hp_add` (teko_struct.tk) records the row
// exactly as it does for any other `T[]` parameter -- so `xs[i]`, `xs[i] = e`,
// `xs.Length`, `foreach (T v in xs)`, passing it on and returning it all
// resolve at parse time, through the heap-array machinery, with nothing here
// to teach them.
//
// THE CALL SITE is a chain, because a store is a statement and a construction
// has to be one EXPRESSION: `tkarr_new_T(n)` allocates and each
// `tkarr_put_T(a, off, v)` (teko_heaparr.tk, generated per ELEMENT type) hands
// the array to the next. The offset is the site's own constant,
// `TK_HAOBJSIZE + k * width`, and the element is DECLARED at its own type in
// the generated store, which is what carries a float: `f64` is written with
// `stf64` and travels in the register file it belongs to.
//
// OWNERSHIP is one reference for the whole chain -- the count `tkarr_new_T`
// was born with. The allocator's node is registered OWNED, so the reclaim
// (teko_rc.tk) parks it once and the statement's own sweep releases the array
// and, through `tkarr_release_T`, every counted element in it. Every `put`
// node above it is registered BORROWED: each is a call to a function whose
// declared return type is counted, so left alone each would be parked again
// and the sweep would release the same array once per link.
//
// BORROWED IS NOT PURE. A `put` writes a slot and takes a reference for a
// counted element, so re-evaluating one is not free and nothing may duplicate
// it; the two answers are separate columns of `tk_xt` for exactly that reason
// (teko_struct.tk, TK_OWNED/TK_BORROWED beside `xt_pure`).
//
// WHERE THE PASS RUNS. Behind the oracle, `ref`, the delegates and the
// operators, because those are what give an argument its type: a delegate call
// is only a typed `callp` once teko_deleg.tk has run, and an overloaded
// operator is only a call once teko_ops.tk has. Ahead of the defaults and the
// overloads, which census by ARITY -- the call has to already carry its single
// argument -- and ahead of the reclaim, which is what parks the array.
//
// A NAME WITH MORE THAN ONE SIGNATURE is the one thing this pass does not
// decide (C3). `f(i64)` beside `f(params i64[])` is C#'s own pair, and which
// of them `f(1)` means is a question about all the signatures at once. Such a
// row is marked shared (`tk_pm_scan_shared`) and its call sites are left as
// written; teko_over.tk's fifth round chooses the candidate and calls
// `tk_pm_expand_call` back here to build exactly the same chain.
//
// The walk is POST-ORDER, so `total(total(1, 2), 3)` packs the inner call
// first, and every argument is cut off its sibling list before it becomes an
// argument of a `put`: a node lives in ONE list.

#define TK_MAXPM 64                   // parameters declared `params`, over one unit
#define TK_MAXPMD 64                  // declarations that carry one

i64 pm_node[TK_MAXPM];                // the N_PARAM node the modifier marked
i64 pm_ty[TK_MAXPM];                  // its `T[]` row type
i64 pm_seen[TK_MAXPM];                // 1 once a declaration of the unit claimed it
i64 tk_npm = 0;

uptr pmd_name[TK_MAXPMD];             // the declaration's name, as it stands at pass time
i64  pmd_fixed[TK_MAXPMD];            // parameters that come before the list
i64  pmd_ty[TK_MAXPMD];               // the `T[]` row the list is
i64  pmd_node[TK_MAXPMD];             // the declaration the three above came from
i64  pmd_over[TK_MAXPMD];             // 1 when the name carries a second signature (C3)
i64  tk_npmd = 0;

#define TK_MAXPMP 16                  // parameters of the declaration the walk is inside

uptr pmp_name[TK_MAXPMP];             // its parameter names, for the normal-form test
i64  pmp_ty[TK_MAXPMP];               // and their declared types
i64  tk_npmp = 0;

i64 tk_pm_open = 0;                   // a `params` was read in the declaration being parsed
i64 tk_pm_hit = 0 - 1;                // the mark row `tk_pm_pos` last landed on

i64  pm_node_at(i64 i) { return ld64(pm_node + i * 8); }
i64  pm_ty_at(i64 i)   { return ld64(pm_ty + i * 8); }
i64  pm_seen_at(i64 i) { return ld64(pm_seen + i * 8); }
void set_pm_node_at(i64 i, i64 v) { st64(pm_node + i * 8, v); }
void set_pm_ty_at(i64 i, i64 v)   { st64(pm_ty + i * 8, v); }
void set_pm_seen_at(i64 i, i64 v) { st64(pm_seen + i * 8, v); }

uptr pmp_name_at(i64 i) { return ld64(pmp_name + i * 8); }
i64  pmp_ty_at(i64 i)   { return ld64(pmp_ty + i * 8); }
void set_pmp_name_at(i64 i, uptr v) { st64(pmp_name + i * 8, v); }
void set_pmp_ty_at(i64 i, i64 v)    { st64(pmp_ty + i * 8, v); }

uptr pmd_name_at(i64 i)  { return ld64(pmd_name + i * 8); }
i64  pmd_fixed_at(i64 i) { return ld64(pmd_fixed + i * 8); }
i64  pmd_ty_at(i64 i)    { return ld64(pmd_ty + i * 8); }
i64  pmd_node_at(i64 i)  { return ld64(pmd_node + i * 8); }
i64  pmd_over_at(i64 i)  { return ld64(pmd_over + i * 8); }
void set_pmd_name_at(i64 i, uptr v)  { st64(pmd_name + i * 8, v); }
void set_pmd_fixed_at(i64 i, i64 v)  { st64(pmd_fixed + i * 8, v); }
void set_pmd_ty_at(i64 i, i64 v)     { st64(pmd_ty + i * 8, v); }
void set_pmd_node_at(i64 i, i64 v)   { st64(pmd_node + i * 8, v); }
void set_pmd_over_at(i64 i, i64 v)   { st64(pmd_over + i * 8, v); }

// xs[i] -- the `[` the core's Pratt grammar does not have. `[` is punctuation
// the lexer already knows, and `ops_init()` does not touch it, so unlike an
// infix over a CORE operator this handler really is reached (a `syntax_infix`
// on `+` is silently dead: parse_unit calls ops_init after user_init, and
// infix_set clears the handler column). The node is an N_INDEX the core defines
// but never builds and never lowers, so an index no branch here resolved and
// no pass rewrote is refused by `tk_pm_check_index` below instead of reaching
// a lowering that has nothing to do with it.
//
i64 tk_bracket(i64 left) {
    i64 base = tk_unary_base(left);
    if (base != left) {
        i64 saved = tk_bracket_no_write;
        tk_bracket_no_write = 1;
        i64 inner = tk_bracket(base);
        tk_bracket_no_write = saved;
        return tk_unary_rewrap(left, inner);
    }
    i64 x = tk_ax_find(left);                    // an ARRAY FIELD, whose length is known
    if (x >= 0) return tk_array_index(left, x);  // here: teko_struct.tk lowers it now
    if (nd_kind(left) == N_IDENT) {
        i64 li = tk_arr_find(nd_name(left));      // a LOCAL array (teko_array.tk), known too
        if (li >= 0) return tk_arr_index_of(left, av_ty_at(li), av_nel_at(li), av_name_at(li));
        i64 pty = tk_hp_find(nd_name(left));      // a `T[]` PARAMETER (K3): known at parse time too
        if (pty >= 0) return tk_ha_index(left, tk_struct_by_ty(pty));
    }
    i64 hi = tk_struct_of_expr(left);             // a `T[]` of heap (K3): a local, a field, a call
    if (tk_is_ha(hi)) return tk_ha_index(left, hi);
    i64 line = p_line();
    uptr fl = p_file();
    i64 idx = parse_expr(0);
    p_expect(K_RBRACK, "expected ] after the index");
    if (!tk_bracket_no_write && nd_kind(left) == N_IDENT && tk_arr_write_follows())
        return tk_arr_defer_write(left, idx, line, fl);   // maybe a GLOBAL array; the pass decides
    i64 n = node_new(N_INDEX, line, fl);
    set_nd_a(n, left);
    set_nd_b(n, idx);
    set_nd_type(n, TY_I64);
    return n;
}

// ---- the modifier, at a free function's parameter position ----

// `params` peeked where a parameter's type is about to be read, not consumed:
// the word keeps the type identity `type_new` gave it (teko_type.tk), which is
// what lets `tk_pm_check_stray` go on refusing it everywhere else
i64 tk_pm_ahead() { return type_of_token(p_id()) == tk_ty_params; }

void tk_pm_reset() { tk_pm_open = 0; }

// called before the type of EVERY parameter is read, which is what lets the
// position be checked at all: a parameter after the list, or a second list, is
// refused where it is written. Answers 1 when this parameter is the list.
i64 tk_pm_before_type() {
    if (tk_pm_open)
        err_at(p_file(), p_line(), "teko: `params` must be the last parameter, and there is only one");
    if (!tk_pm_ahead()) return 0;
    p_next();
    return 1;
}

void tk_pm_mark(i64 p, i64 ty) {
    if (tk_npm == TK_MAXPM) err_at(p_file(), p_line(), "teko: too many `params` lists in one unit");
    set_pm_node_at(tk_npm, p);
    set_pm_ty_at(tk_npm, ty);
    set_pm_seen_at(tk_npm, 0);
    tk_npm = tk_npm + 1;
}

// the type after the modifier, and the marking. `T[]` or nothing: the message
// shows the spelling the surface wants rather than leaving the core to refuse
// a word it has no opinion about.
void tk_pm_after_type(i64 pnode, i64 ty) {
    if (!tk_is_ha(tk_struct_by_ty(ty)))
        err_at(p_file(), p_line(), "teko: `params` names an array type: write `params T[] xs`");
    if (p_id() == K_ASSIGN)
        err_at(p_file(), p_line(), "teko: a `params` list has no default");
    tk_pm_mark(pnode, ty);
    tk_pm_open = 1;
}

// the type word `params` still standing where a type was expected -- the old
// spelling `params xs`, or `params i64 xs`. Reported with the right spelling
// rather than the core's own "expected a type".
void tk_pm_reject_bare() {
    err_at(p_file(), p_line(), "teko: `params` names an array type: write `params T[] xs`");
}

// ---- what the pass refuses over the whole node array ----

// `params` names a parameter modifier, not a type: a local, a global, a field
// or a cast that spells it is refused where it is written
void tk_pm_check_stray(i64 n) {
    if (nd_type(n) != tk_ty_params) return;
    err_at(nd_file(n), nd_line(n), "teko: `params` declares a parameter list, nothing else");
}

// an index no branch of `tk_bracket` resolved at parse time and no pass
// rewrote -- an inline array field reached through a parameter is the shape
// that gets here. The core defines N_INDEX and never lowers it, so it is
// refused rather than dropped.
void tk_pm_check_index(i64 n) {
    if (nd_kind(n) != N_INDEX) return;
    i64 base = nd_a(n);
    if (nd_kind(base) == N_IDENT)
        err_at2(nd_file(n), nd_line(n), "teko: `[` needs an array", nd_name(base));
    err_at(nd_file(n), nd_line(n), "teko: `[` needs an array");
}

// ---- the declarations that carry a list ----
i64 tk_pm_marked(i64 p) {
    i64 i = 0;
    loop {
        if (i >= tk_npm) break;
        if (pm_node_at(i) == p) return i;
        i = i + 1;
    }
    return 0 - 1;
}

i64 tk_pm_find(uptr name) {
    i64 i = 0;
    loop {
        if (i >= tk_npmd) break;
        if (str_eq(pmd_name_at(i), name)) return i;
        i = i + 1;
    }
    return 0 - 1;
}

void tk_pm_add(uptr name, i64 fixed, i64 ty, i64 d) {
    if (tk_npmd == TK_MAXPMD)
        err_at(tk_file, tk_line, "teko: too many `params` declarations in one unit");
    set_pmd_name_at(tk_npmd, name);
    set_pmd_fixed_at(tk_npmd, fixed);
    set_pmd_ty_at(tk_npmd, ty);
    set_pmd_node_at(tk_npmd, d);
    set_pmd_over_at(tk_npmd, 0);
    tk_npmd = tk_npmd + 1;
}

// the marked parameter of `d`, as its POSITION, or -1. The rows are derived
// here rather than at parse time because a declaration's own name may still
// move afterwards -- a namespaced free function is mangled by `tk_ns_pass`,
// which runs well ahead of this one.
i64 tk_pm_pos(i64 d) {
    tk_pm_hit = 0 - 1;
    i64 i = 0;
    i64 p = nd_a(d);
    loop {
        if (p == 0) break;
        i64 m = tk_pm_marked(p);
        if (m >= 0) {
            set_pm_seen_at(m, 1);
            tk_pm_hit = m;
            return i;
        }
        i = i + 1;
        p = nd_next(p);
    }
    return 0 - 1;
}

// the `params` list of `d`: its POSITION through `pk`, and the `T[]` row type
// as the answer -- -1, and `pk` -1, for a declaration that carries none. The
// one call teko_over.tk's fifth round needs to ask about a candidate.
i64 tk_pm_list_of(i64 d, uptr pk) {
    i64 k = tk_pm_pos(d);
    st64(pk, k);
    if (k < 0) return 0 - 1;
    return pm_ty_at(tk_pm_hit);
}

void tk_pm_collect(i64 root) {
    i64 n = root;
    loop {
        if (n == 0) break;
        if (decl_valid(n)) {
            i64 k = tk_pm_pos(n);
            if (k >= 0) {
                if (nd_kind(n) == N_EXTERN)
                    err_at2(nd_file(n), nd_line(n), "teko: an `extern` symbol takes no `params` list", nd_name(n));
                if (tk_pm_find(nd_name(n)) < 0)
                    tk_pm_add(nd_name(n), k, pm_ty_at(tk_pm_hit), n);
            }
        }
        n = nd_next(n);
    }
}

// 1 when two declarations take the same parameters -- the same types in the
// same order, each with the same `ref`/`out` kind, which is exactly what
// `tk_ov_sig` (teko_over.tk) mangles a symbol out of. A prototype and its own
// definition answer 1, whether or not both spell the modifier; two
// declarations that differ anywhere answer 0 and are two signatures.
i64 tk_pm_same_shape(i64 d1, i64 d2) {
    i64 p1 = nd_a(d1);
    i64 p2 = nd_a(d2);
    loop {
        if (p1 == 0 || p2 == 0) break;
        if (tk_param_ty(p1) != tk_param_ty(p2)) return 0;
        if (tk_rp_kind(p1) != tk_rp_kind(p2)) return 0;
        p1 = nd_next(p1);
        p2 = nd_next(p2);
    }
    return p1 == 0 && p2 == 0;
}

// C3: a name that carries a list may carry other signatures too. Which
// candidate a call means is a question about ALL of them at once, and the
// round that answers it is teko_over.tk's fifth, behind this pass -- so the
// row is MARKED here and every call site of it is left exactly as written.
// The expansion happens there instead, against the candidate the arguments
// chose (`tk_pm_expand_call` below).
void tk_pm_scan_shared(i64 root) {
    i64 n = root;
    loop {
        if (n == 0) break;
        if (decl_valid(n)) {
            i64 r = tk_pm_find(nd_name(n));
            if (r >= 0 && n != pmd_node_at(r) && !tk_pm_same_shape(pmd_node_at(r), n))
                set_pmd_over_at(r, 1);
        }
        n = nd_next(n);
    }
}

// a marked parameter no declaration of the unit claimed: a delegate's own
// list, or a lambda's -- both read by the core's `parse_params`, both reaching
// the same `syntax_param` handler, and neither a free function
void tk_pm_check_orphans() {
    i64 i = 0;
    loop {
        if (i >= tk_npm) break;
        if (!pm_seen_at(i))
            err_at(nd_file(pm_node_at(i)), nd_line(pm_node_at(i)),
                   "teko: `params` is taught on a free function only");
        i = i + 1;
    }
}

// ---- the call site ----

// the parameters of the declaration the walk is inside. A PARAMETER is the one
// name `tk_pty_of` cannot answer for -- teko_struct.tk's own table of locals
// never sees one -- and it is exactly the name a `params` list is passed on
// under, so the normal form has to be able to recognise it.
void tk_pm_params_of(i64 f) {
    tk_npmp = 0;
    i64 p = nd_a(f);
    loop {
        if (p == 0) break;
        if (tk_npmp == TK_MAXPMP)
            err_at2(nd_file(f), nd_line(f), "teko: too many parameters in one declaration", nd_name(f));
        set_pmp_name_at(tk_npmp, nd_name(p));
        set_pmp_ty_at(tk_npmp, tk_param_ty(p));
        tk_npmp = tk_npmp + 1;
        p = nd_next(p);
    }
}

i64 tk_pm_param_ty(uptr name) {
    i64 i = tk_npmp - 1;
    loop {
        if (i < 0) break;
        if (str_eq(pmp_name_at(i), name)) return pmp_ty_at(i);
        i = i - 1;
    }
    return 0 - 1;
}

// the type an argument shows the pass by itself: a literal carries its own
// (`1.5` is an N_INT of type f64, lib/float.mc's fl_lit), a cast the type it
// names, and anything else answers through `tk_pty_of` (teko_struct.tk) -- a
// tagged node, which by now includes every delegate call the delegate pass
// rewrote, a bare local, and a call whose callee the unit declares. -1 is
// "not known here", and nothing is refused on it.
//
// A bare NAME is the one that cannot go through `tk_pty_of` here. This is a
// PASS: every scope of the unit closed while it was still parsing, so the
// parser's own in-scope lookup has nothing left to answer with, and the
// append-only rows are what the name is read from instead
// (`tk_slv_find_unit`, teko_struct.tk's own header on the two questions).
i64 tk_pm_arg_ty(i64 a) {
    i64 k = nd_kind(a);
    if (k == N_INT)  return nd_type(a);
    if (k == N_CAST) return nd_type(a);
    if (k == N_IDENT) {
        i64 pt = tk_pm_param_ty(nd_name(a));
        if (pt >= 0) return pt;
        pt = tk_xt_ty(a);                        // a node the parse already tagged
        if (pt >= 0) return pt;
        pt = tk_slv_find_unit(nd_name(a));
        if (pt >= 0) return pt;
        return tk_ty_global_ha(nd_name(a));      // G1: a global `T[]` of heap
    }
    return tk_pty_of(a);
}

// the type of the argument at position `i`: the one the caller already has,
// when it brought its own array (teko_over.tk computed every argument's type
// to choose the candidate, under a scope this module's own tables know
// nothing about), and the tree's own answer otherwise.
i64 tk_pm_argty_at(i64 a, i64 i, uptr tys) {
    if (tys == 0) return tk_pm_arg_ty(a);
    return ld64(tys + i * 8);
}

// one element against the declared element type, as a VERDICT: identity, or
// -- for an element type that names a row -- the derives/implements rule
// every other slot of this compiler already takes (`tk_row_fits`). A type
// nothing here knows fits, since nothing is refused on it. An `f64` never
// lands in an `i64[]` -- C# narrows nothing without a cast written down -- and
// an integer LITERAL carries no type of its own and lands, at `loose`, on any
// integer of the core, and without it only on `i64`: the same tie-break
// teko_over.tk's own rounds take, and what tells `params i64[]` from
// `params u8[]` at a site that wrote a bare `1`.
//
// An INTEGER in a `params f64[]` converts, C# §12.6.4 over §10.2.3: a list is
// applicable in its expanded form when every element of the tail converts
// implicitly to the element type, and an integer converts to a double. It is
// asked at `loose` only, which is what keeps the tie-break the log already
// took: the strict stage runs first, `f(1)` fits `params i64[]` there and
// never reaches this arm, while `f(1, 1.5)` fails every strict candidate and
// lands on `params f64[]` at the loose stage with the `1` converted.
i64 tk_pm_elem_fits(i64 ety, i64 a, i64 aty, i64 loose) {
    if (aty < 0) return 1;
    if (aty == ety) return 1;
    i64 ti = tk_struct_by_ty(ety);
    if (ti >= 0) {
        // Q1a (docs/specs/nullable.md, rule 1): `null` fits an element
        // declared `T?` and no other -- `params Cell?[]` takes it, `params
        // Cell[]` does not, and an enum never did (D39).
        if (tk_is_null_lit(a)) return tk_is_nl(ti);
        // Q1b: an element declared `T?` over a VALUE takes what `T` itself
        // takes -- `total(1, 2)` on a `params i64?[]` -- so the question is
        // asked again about the payload, which is where the literal's own
        // tie-break lives.
        if (tk_is_nl(ti) && tk_nl_boxes(nl_of_at(ti)))
            return tk_pm_elem_fits(nl_of_at(ti), a, aty, loose);
        return tk_row_fits(ti, tk_struct_by_ty(aty));
    }
    // `aty` names a row too (an enum member, D39 -- no plain integer or float
    // ever does) and `ety` does not: the value is typed, not the untyped
    // literal the arms below assume, and a typed value converts to nothing
    // but its own type -- already refused above since `aty == ety` failed.
    if (tk_struct_by_ty(aty) >= 0) return 0;
    if (loose && type_kind(ety) == TK_FLOAT && tk_is_int_ty(aty)) return 1;
    if (nd_kind(a) != N_INT) return 0;
    if (type_kind(aty) == TK_FLOAT || type_kind(ety) == TK_FLOAT) return 0;
    if (loose) return 1;
    return ety == TY_I64;
}

// the same rule, reported: the element the chain is about to store, in the
// wording a mismatched argument gets anywhere else. `aty` is the type the
// caller already has for the argument.
void tk_pm_check_elem(i64 ety, i64 a, i64 aty, i64 line, uptr fl) {
    if (tk_pm_elem_fits(ety, a, aty, 1)) return;
    if (tk_struct_by_ty(ety) >= 0) {
        tk_check_compat(ety, aty, a, line, fl);
        return;
    }
    tk_reject_compat(type_name(aty), type_name(ety), line, fl);
}

// every argument from position `k` on, against the element type of the list
// `ty` -- the verdict teko_over.tk's fifth round asks of a candidate, with
// nothing reported. `tys` is that pass's own array of argument types.
i64 tk_pm_tail_fits(i64 ty, i64 args, i64 k, uptr tys, i64 loose) {
    i64 ety = ha_ety_at(tk_struct_by_ty(ty));
    i64 a = args;
    i64 i = 0;
    loop {
        if (a == 0) break;
        if (i >= k && !tk_pm_elem_fits(ety, a, ld64(tys + i * 8), loose)) return 0;
        i = i + 1;
        a = nd_next(a);
    }
    return 1;
}

// how many arguments are left once the fixed ones have been walked past
i64 tk_pm_count(i64 tail) {
    i64 v = 0;
    i64 t = tail;
    loop {
        if (t == 0) break;
        v = v + 1;
        t = nd_next(t);
    }
    return v;
}

// the chain itself: the allocator, then one `put` per argument. The allocator
// is the one node registered OWNED -- the whole chain carries its single
// reference -- and every link above it is registered BORROWED, so the reclaim
// parks the array exactly once. Borrowed is the ownership answer and nothing
// else: a `put` is a STORE, so it is not pure and nothing may re-evaluate it.
i64 tk_pm_pack(i64 si, i64 ty, i64 ety, i64 tail, i64 v, i64 first, uptr tys, i64 line, uptr fl) {
    tk_ha_ensure_put(si);
    i64 pack = tk_call(tk_ha_allocname(ety), tk_int(v));
    tk_xt_add(pack, si, 0, TK_OWNED);
    uptr put = tk_ha_putname(ety);
    i64 w = type_width(ety);
    i64 t = tail;
    i64 k = 0;
    loop {
        if (t == 0) break;
        i64 nxt = nd_next(t);
        set_nd_next(t, 0);
        i64 tty = tk_pm_argty_at(t, first + k, tys);
        tk_pm_check_elem(ety, t, tty, line, fl);
        t = tk_num_widen(ety, tty, t);            // an integer in a `params f64[]`
        t = tk_nl_wrap(ety, tty, t);              // ...and a box in a `params i64?[]`
        tk_line = line;
        tk_file = fl;
        pack = tk_call(put, list_append(list_append(pack, tk_int(TK_HAOBJSIZE + k * w)), t));
        tk_xt_put(pack, si, ty, 0, TK_BORROWED);
        k = k + 1;
        t = nxt;
    }
    return pack;
}

// `total(a, b)` -> `total(<the chain>)`. The first `k` arguments keep their
// place; the tail is cut off the list and becomes the array of the list `ty`.
// A tail that is already a single `T[]` of the row passes straight through,
// without a copy -- C#'s own normal form.
void tk_pm_lower_at(i64 n, i64 k, i64 ty, uptr tys) {
    i64 si = tk_struct_by_ty(ty);
    i64 ety = ha_ety_at(si);
    i64 args = nd_a(n);
    i64 prev = 0;
    i64 tail = args;
    i64 i = 0;
    loop {
        if (i >= k) break;
        if (tail == 0) err_at2(nd_file(n), nd_line(n), "teko: too few arguments", nd_name(n));
        prev = tail;
        tail = nd_next(tail);
        i = i + 1;
    }
    if (tail != 0 && nd_next(tail) == 0 && tk_pm_argty_at(tail, k, tys) == ty) return;
    i64 line = nd_line(n);
    uptr fl = nd_file(n);
    i64 v = tk_pm_count(tail);
    tk_line = line;
    tk_file = fl;
    i64 pack = tk_pm_pack(si, ty, ety, tail, v, k, tys, line, fl);
    if (prev) set_nd_next(prev, 0);
    if (!prev) args = 0;
    set_nd_a(n, list_append(args, pack));
}

// a call of a name this unit declares ONCE: the row says where the list
// starts and what it is. A name that carries a second signature is left to
// teko_over.tk, which is the only pass that can tell which of them the site
// means (`tk_pm_scan_shared` above).
void tk_pm_lower_call(i64 n) {
    i64 r = tk_pm_find(nd_name(n));
    if (r < 0) return;
    if (pmd_over_at(r)) return;
    tk_pm_lower_at(n, pmd_fixed_at(r), pmd_ty_at(r), 0);
}

// C3: the same expansion, at a call teko_over.tk's fifth round has just
// resolved to the candidate `d` -- the list is `d`'s own, not a row keyed by
// name, because the name has more than one. Nothing else differs: the chain,
// its ownership and the element check are the ones above.
void tk_pm_expand_call(i64 n, i64 d, uptr tys) {
    i64 k = 0;
    i64 ty = tk_pm_list_of(d, &k);
    tk_pm_lower_at(n, k, ty, tys);
}

// ---- the walk ----
// Children first, then the node: an argument that is itself a `params` call is
// packed before the call that carries it packs it.
void tk_pm_walk(i64 n) {
    loop {
        if (n == 0) break;
        tk_pm_walk(nd_a(n));
        tk_pm_walk(nd_b(n));
        tk_pm_walk(nd_c(n));
        tk_pm_walk(nd_d(n));
        if (nd_kind(n) == N_CALL) tk_pm_lower_call(n);
        n = nd_next(n);
    }
}

// every declaration the source wrote. What `tk_ha_ensure_put` appends while
// the walk runs -- the allocator, the release and the store of a row -- sits
// past `last` and holds no call of a name this pass knows.
void tk_pm_walk_unit(i64 root, i64 last) {
    i64 f = root;
    loop {
        if (f == 0) break;
        if (f < last && decl_valid(f)) {
            tk_pm_params_of(f);
            tk_pm_walk(nd_b(f));
        }
        f = nd_next(f);
    }
}

// The pass. The two checks read the tree as the source wrote it; then the
// declarations that carry a list are collected and every call site that names
// one builds its array. A program with no `params` in it leaves with the tree
// exactly as it was, which is what the no-op proof of a taught construct means.
i64 tk_params_pass(i64 root) {
    i64 last = nnodes;
    i64 n = 1;
    loop {
        if (n >= last) break;
        tk_pm_check_stray(n);
        tk_pm_check_index(n);
        n = n + 1;
    }
    if (tk_npm == 0) return root;
    tk_pm_collect(root);
    tk_pm_scan_shared(root);
    tk_pm_check_orphans();
    tk_pm_walk_unit(root, last);
    return root;
}
